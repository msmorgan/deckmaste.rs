/target/
/data/
/.workspaces/
/.superpowers/
/docs/memory
/docs/evidence
/plugins/*/
!/plugins/builtin/
!/plugins/canon/
!/plugins/testing/
!/plugins/demo/
!/CLAUDE.md
# The Claude Code RON-LSP plugin is checked in; re-include it despite the
# machine-global `.claude/*` ignore. Everything else under .claude/skills/
# stays ignored (personal, machine-local skills).
!/.claude/skills/
/.claude/skills/*
!/.claude/skills/ron-lsp/
# The pre-cutover guard hook is checked in: the tracked .claude/settings.json
# wires it as a PreToolUse command, so a checkout without it would point at a
# missing script.
!/.claude/hooks/
# Claude Code's scheduled-wakeup lock is session state, whatever the global ignore says.
/.claude/scheduled_tasks.lock
# Scratch left by the retired v2 Lean emitters remains untracked.
/lean/Generated/
/lean/Generated.lean
/lean/GeneratedDefinitions/
/lean/GeneratedDefinitions.lean
# Scratch left by the retired v2 macro alignment command.
/lean/GeneratedMacroAlignment.lean
