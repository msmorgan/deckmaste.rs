/-- `events/dies.ron` -/
semantic_macro dies (subject : Semantics.NounPhrase) : Semantics.GameEvent :=
  (Semantics.GameEvent.zoneChange subject (some (Semantics.EventSource.zones [(Semantics.ZoneExpr.zone Semantics.Zone.battlefield Semantics.ZoneScope.bare)])) (some (Semantics.ZoneExpr.zone Semantics.Zone.graveyard Semantics.ZoneScope.bare)) Semantics.ObservationPoint.before)

/-- `events/discards.ron` -/
semantic_macro discards (player : Semantics.NounPhrase) (card : Semantics.NounPhrase) : Semantics.GameEvent :=
