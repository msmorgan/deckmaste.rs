  (Semantics.Conferral.property (Semantics.StaticSpec.ptModification Semantics.NounPhrase.this power toughness))

/-- `conferrals/castableFrom.ron` -/
semantic_macro castableFrom (zone : Semantics.ZoneExpr) (timing : Semantics.Timing) : Semantics.Conferral :=
  (Semantics.Conferral.property (Semantics.StaticSpec.deonticRule Semantics.NounPhrase.you Semantics.Compulsion.permit [(Semantics.Deed.action "cast")] Semantics.Role.agent none (Semantics.DeonticPatient.counterpart Semantics.NounPhrase.this) none (Semantics.DeonticRider.play (some zone) none (some timing) false Semantics.PlayPayment.itsOwnCost) none))

/-- `conferrals/combatant.ron` -/
semantic_macro combatant : Semantics.Conferral :=
