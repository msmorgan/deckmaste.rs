semantic_macro creatureTokenOf (power : Semantics.Amount) (toughness : Semantics.Amount) (colors : (List Semantics.Color)) (subtypes : (List Semantics.Subtype)) (abilities : (List Semantics.Ability) := []) : Semantics.CharacteristicBundle :=
