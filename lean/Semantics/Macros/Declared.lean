semantic_macro deontic (subject : Semantics.NounPhrase) (compulsion : Semantics.Compulsion) (deeds : (List Semantics.Deed)) (role : Semantics.Role) (patient : Semantics.DeonticPatient) : Semantics.StaticSpec :=
  (Semantics.StaticSpec.deonticRule subject compulsion deeds role none patient none Semantics.DeonticRider.noRider none)

/-- `instructions/discardThenForEachNonland.ron` -/
semantic_macro discardThenForEachNonland (discarded : Semantics.NounPhrase) (step : Semantics.Instruction) : Semantics.Instruction :=
  (Semantics.Instruction.sequentially [(Semantics.Instruction.enact (Semantics.Deed.action "discard") (Semantics.Instruction.ownScope 0 (Semantics.Instruction.move (Semantics.NounPhrase.inCaller 0 (Semantics.NounPhrase.firstMention "discardThenForEachNonland.discarded" discarded)) (Semantics.ZoneExpr.zone Semantics.Zone.hand (Semantics.ZoneScope.possessedBy Semantics.NounPhrase.actor)) (Semantics.ZoneExpr.zone Semantics.Zone.graveyard Semantics.ZoneScope.bare) []))), (Semantics.Instruction.doForEach (Semantics.NounPhrase.someOf Semantics.SliceCount.whole (some (Semantics.Predicate.not (Semantics.Predicate.hasType Semantics.CardType.land))) (Semantics.NounPhrase.laterMention "discardThenForEachNonland.discarded" discarded)) step)])

