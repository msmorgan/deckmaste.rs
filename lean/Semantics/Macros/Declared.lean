semantic_macro Instruction.bracketed (instruction : Semantics.Instruction) : Semantics.Instruction :=
  (Semantics.Instruction.bracketed instruction)

/-- `instructions/canBeTargetedAsThough.ron` -/
semantic_macro canBeTargetedAsThough (what : Semantics.NounPhrase) (by_ : Semantics.NounPhrase) (p : Semantics.Predicate) : Semantics.StaticSpec :=
  (Semantics.StaticSpec.deonticRule what Semantics.Compulsion.permit [(Semantics.Deed.core Semantics.CoreDeed.target)] Semantics.Role.patient none (Semantics.DeonticPatient.targetedBy by_) (some (Semantics.AsThough.of p)) Semantics.DeonticRider.noRider none)

/-- `instructions/canDoAsThough.ron` -/
semantic_macro canDoAsThough (n : Semantics.NounPhrase) (deed : Semantics.Deed) (p : Semantics.Predicate) : Semantics.StaticSpec :=
  (Semantics.StaticSpec.deonticRule n Semantics.Compulsion.permit [deed] Semantics.Role.agent none Semantics.DeonticPatient.noPatient (some (Semantics.AsThough.of p)) Semantics.DeonticRider.noRider none)

/-- `instructions/cantBeTargetedBy.ron` -/
semantic_macro cantBeTargetedBy (what : Semantics.NounPhrase) (by_ : Semantics.NounPhrase) : Semantics.StaticSpec :=
  (Semantics.StaticSpec.deonticRule what Semantics.Compulsion.forbid [(Semantics.Deed.core Semantics.CoreDeed.target)] Semantics.Role.patient none (Semantics.DeonticPatient.targetedBy by_) none Semantics.DeonticRider.noRider none)

/-- `instructions/cantDoTo.ron` -/
semantic_macro cantDoTo (deed : Semantics.Deed) (who : Semantics.NounPhrase) (what : Semantics.NounPhrase) : Semantics.StaticSpec :=
  (Semantics.StaticSpec.deonticRule who Semantics.Compulsion.forbid [deed] Semantics.Role.agent none (Semantics.DeonticPatient.counterpart what) none Semantics.DeonticRider.noRider none)

/-- `instructions/cantMoreThan.ron` -/
semantic_macro cantMoreThan (player : Semantics.NounPhrase) (deed : Semantics.Deed) (bound : Nat) (p : Semantics.Predicate) : Semantics.StaticSpec :=
  (Semantics.StaticSpec.deonticRule player Semantics.Compulsion.forbid [deed] Semantics.Role.agent (some (Semantics.CountBound.moreThan (Semantics.Amount.lit bound))) (Semantics.DeonticPatient.counterpart (Semantics.NounPhrase.described Semantics.DetPhrase.all p)) none Semantics.DeonticRider.noRider none)

/-- `instructions/castWithoutPaying.ron` -/
semantic_macro castWithoutPaying (subject : Semantics.NounPhrase) (resulting : (Option Semantics.Predicate) := none) : Semantics.Instruction :=
  (Semantics.Instruction.enact (Semantics.Deed.action "cast") (Semantics.Instruction.procedure Semantics.Procedure.cast subject Semantics.PlayPayment.withoutPaying resulting))

/-- `instructions/changeLife.ron` -/
semantic_macro changeLife (delta : (Semantics.Delta Semantics.Amount)) : Semantics.Instruction :=
  (Semantics.Instruction.changeLife delta)

/-- `instructions/choose.ron` -/
semantic_macro choose (subject : Semantics.NounPhrase) (disclosure : Semantics.Disclosure := Semantics.Disclosure.openly) : Semantics.Instruction :=
  (Semantics.Instruction.choose none subject disclosure none)

/-- `instructions/chooseNewTargets.ron` -/
semantic_macro chooseNewTargets (subject : Semantics.NounPhrase) : Semantics.Instruction :=
  (Semantics.Instruction.chooseNewTargets subject)

