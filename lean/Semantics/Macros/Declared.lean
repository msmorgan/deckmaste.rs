semantic_macro doForEachKind (axis : Semantics.KindAxis) (sort : Semantics.QualitySort) (body : Semantics.Instruction) (domain : (Option Semantics.NounPhrase) := none) : Semantics.Instruction :=
  (Semantics.Instruction.doForEachKind axis domain sort body)

/-- `instructions/doIf.ron` -/
semantic_macro doIf (condition : Semantics.Condition) (instruction : Semantics.Instruction) (otherwise : (Option Semantics.Instruction) := none) : Semantics.Instruction :=
