// "any target" [CR#115.4]: a creature, player, planeswalker or battle. A
// disjunction over kinds, so the phrase denotes either sort.
(
    name: "anyTarget",
    kinds: [NounPhrase],
    params: [],
    body: Described(
        determiner: Target(quantity: Range(low: 1, high: 1)),
        predicate: Or(disjuncts: [
            HasType(type: Creature),
            HasType(type: Planeswalker),
            HasType(type: Battle),
            AnyPlayer,
        ]),
    ),
)
