// "any target" [CR#115.4]: a creature, player, planeswalker or battle. A
// disjunction over kinds, so the phrase denotes either sort.
(
    name: "anyTarget",
    kinds: [NounPhrase],
    params: [],
    body: Described(
        determiner: Target(Range(low: 1, high: 1)),
        predicate: Or([
            HasType(Creature),
            HasType(Planeswalker),
            HasType(Battle),
            AnyPlayer,
        ]),
    ),
)
