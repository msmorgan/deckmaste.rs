// A probe for the actor handoff, quoting no real card: "{T}: This creature
// endures 1." The rules instruct the permanent itself to endure, so the card
// hands the action to it, and endure's body hands the choice and the token to
// the enduring permanent's controller [CR#701.63a].
SingleFaced(face: (
    characteristics: (
        name: "Endure Handoff Probe",
        cost: [1, White],
        types: [Creature],
        subtypes: [spirit],
        power: 1,
        toughness: 1,
        text: [
            activated(
                cost: tapSymbol,
                instruction: act(asType(type: Creature, subject: this, subtype: None), endure(1)),
            ),
        ],
    ),
))
