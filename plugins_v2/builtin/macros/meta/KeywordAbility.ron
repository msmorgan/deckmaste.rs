// `kinds` names the family first and the semantic kind second: `KeywordAbility`
// is the declaration's identity, `Ability` the position its body occupies, so
// a keyword ability resolves where a card writes an ability.
//
// A declaration file writes its keyword's definition as the list of abilities
// alone (`body`, omitted when empty). The body here is the record of what the
// file wrote, and `deckmaste_semantics_v2::keywords` builds the keyword's
// `Keyword(keyword: <label>, params: <arguments>, body: <abilities>)` term
// from it: the label is the declaration's name, and the arguments forward the
// declared parameters in order unless the file writes `keyword_params`.
//
// `spelling` is the card-usage template. A declaration that writes none is
// deliberately unparseable: bare `gift`, which only its spelled variants
// invoke. A variant writes `label`, the keyword whose label it carries, and
// its body is that keyword invoked once (`giftACard`: `label: gift`, `body:
// [gift(draw(1))]`); the declaration's term is that invocation, labelled as
// the keyword it names, never a keyword of its own. A general form writes
// `label` and its own definition instead (`devourQuality`: `label: devour`),
// and its term is that keyword's, carrying its own arguments (ruling
// 2026-10-10).
(
    name: "KeywordAbility",
    kinds: [Macro],
    params: {
        "name": String,
        "params": Elidable(Any),
        "spelling": Elidable(String),
        "grammar": Elidable(Any),
        "keyword_syntax": Elidable(Any),
        "keyword_params": Elidable(Any),
        "label": Elidable(Any),
        "body": Default(Any, []),
    },
    body: (
        name: Param(name),
        kinds: [KeywordAbility, Ability],
        params: Param(params),
        metadata: (
            spelling: Param(spelling),
            grammar: Param(grammar),
            keyword_syntax: Param(keyword_syntax),
        ),
        body: (keyword_params: Param(keyword_params), label: Param(label), abilities: Param(body)),
    ),
)
