(
    name: "Subtype",
    kinds: [Macro],
    params: {
        "category": Any,
        "name": String,
        "params": Elidable(Any),
        "spelling": String,
        "grammar": Elidable(Any),
        "rules": Default(Any, []),
    },
    body: (
        name: Param(name),
        kinds: [Subtype],
        params: Param(params),
        metadata: (
            category: Param(category),
            spelling: Param(spelling),
            grammar: Param(grammar),
            type_word: (noun_modifier: true, negative_prefix_join: Hyphenated),
            noun_class: (
                locative_temporal_license: ObjectAttachmentLicensed,
                relationality: QualifiedRelational,
            ),
        ),
        body: Subtype(subtype: Of(host: Param(category), label: Param(spelling)), rules: Param(rules)),
    ),
)
