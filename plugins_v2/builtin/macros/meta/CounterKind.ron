// A counter declaration [CR#122.1]. Its body is the `Counter` definition the
// meta-macro builds from the declaration's own parts: the kind is the
// declaration's NAME, verbatim (`p1p1Counter`), so the author never writes it
// and nothing in a declaration refers to the counter it declares; `holder` is
// what the counter is placed on (an object unless the declaration says a
// player [CR#122.1]), and `confers` is what ONE counter of the kind
// confers, which the model applies once per counter held (the conferral
// helpers in `conferrals/` write the usual ones).
(
    name: "CounterKind",
    kinds: [Macro],
    params: {
        "name": String,
        "params": Elidable(Any),
        "spelling": String,
        "grammar": Elidable(Any),
        "compound_stem": Default(Any, Word),
        "compound_onset": Elidable(Any),
        "holder": Default(Any, Object),
        "confers": Default(Any, []),
    },
    body: (
        name: Param(name),
        kinds: [CounterKind],
        params: Param(params),
        metadata: (
            spelling: Param(spelling),
            grammar: Param(grammar),
            compound_noun: (
                head: "lexeme:CommonNoun/Counter",
                stem: Param(spelling),
                stem_structure: Param(compound_stem),
                stem_onset: Param(compound_onset),
            ),
            noun_class: (
                locative_temporal_license: OnLicensed,
                relationality: NonRelational,
            ),
        ),
        body: Counter(kind: Named(name: Param(name)), holder: Param(holder), confers: Param(confers)),
    ),
)
