// The spell half of the `Subtype` family: instants and sorceries share their
// spell types [CR#205.3k], so a spell subtype names no host card type and its
// definition node is `Spell(label:)` rather than `Of(host:, label:)`. A meta
// body has no conditional form, so the two spellings are two metas; this one
// writes the category itself, since `Spell` is the only one it can carry.
(
    name: "SpellSubtype",
    kinds: [Macro],
    params: {
        "name": String,
        "params": Elidable(Any),
        "spelling": String,
        "grammar": Elidable(Any),
        "rules": Default(Any, []),
    },
    body: (
        name: Param(name),
        kinds: [Subtype],
        params: Param(params),
        metadata: (
            category: Spell,
            spelling: Param(spelling),
            grammar: Param(grammar),
            noun_class: (
                locative_temporal_license: ObjectAttachmentLicensed,
                relationality: QualifiedRelational,
            ),
        ),
        body: Subtype(subtype: Spell(label: Param(spelling)), rules: Param(rules)),
    ),
)
