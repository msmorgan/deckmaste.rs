// `ZoneExpr.Zone` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "zone",
    kinds: [ZoneExpr],
    params: {"zone": Any, "scope": Any},
    body: Zone(zone: Param(zone), scope: Param(scope)),
)
