// `Condition.AnyResultIs` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "anyResultIs",
    kinds: [Condition],
    params: {"comparator": Comparator, "bound": Amount},
    body: AnyResultIs(comparator: Param(comparator), bound: Param(bound)),
)
