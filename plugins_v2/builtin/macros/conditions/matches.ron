// `Condition.Matches` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "matches",
    kinds: [Condition],
    params: {"subject": Subject, "predicate": Quality},
    body: Matches(subject: Param(subject), predicate: Param(predicate)),
)
