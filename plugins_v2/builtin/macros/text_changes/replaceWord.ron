// "Replace all instances of one <sort> word with another", the kind one of
// <sorts>: a color word or a land type word, used as one [CR#612.2]. An
// absent word is one the performer chooses as the effect applies, so "one
// color word with another or one basic land type with another" is
// `replaceWord([Color, Subtype(host: Land)])`.
(
    name: "replaceWord",
    kinds: [TextChange],
    params: {"sorts": Any, "from": Default(Any, None), "to": Default(Any, None)},
    body: ReplaceWord(Param(sorts), Param(from), Param(to)),
)
