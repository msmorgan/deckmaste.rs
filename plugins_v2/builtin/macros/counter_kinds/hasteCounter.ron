// A haste counter ([CR#122.1b]): its bearer gains haste at layer 6
// ([CR#613.1f]) — the FlyingCounter pattern with a different keyword.
CounterKind(
    name: "hasteCounter",
    params: [],
    spelling: "haste",
    grammar: FixedTerm(surface: "haste"),
    body: Counter(
        name: "HasteCounter",
        confers: [
            Continuous(This, GainAbility(Keyword(haste))),
        ],
    ),
)
