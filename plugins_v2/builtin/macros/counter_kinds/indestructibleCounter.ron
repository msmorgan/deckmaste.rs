    body: Counter(
        kind: Keyword(keyword: "Indestructible"),
        holder: Object,
        confers: [
            Property(spec: AbilityGrant(
                subject: This,
                ability: Keyword(keyword: "Indestructible", params: [], body: []),
            )),
        ],
    ),
