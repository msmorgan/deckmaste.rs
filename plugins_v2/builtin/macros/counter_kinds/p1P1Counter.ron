// The +1/+1 counter ([CR#122.1a]): each one adds 1 to power and 1 to
// toughness in layer 7c ([CR#613.4c]). Confers the boost DIRECTLY (a
// continuous effect, the ability-free `Property` flavor) — not an ability that
// grants a boost — scaled by how many of these counters the object holds.
// Inherently strip-immune: a creature whose abilities are all removed still
// gets the bonus.
CounterKind(
    name: "p1P1Counter",
    params: [],
    spelling: "+1/+1",
    body: Counter(
        kind: Boost(power: Up(amount: 1), toughness: Up(amount: 1)),
        holder: Object,
        confers: [
            Property(spec: Modification(
                subject: This,
                stat: Power,
                delta: Up(amount: StatOf(
                    axis: Counter(kind: Boost(power: Up(amount: 1), toughness: Up(amount: 1))),
                    subject: This,
                )),
            )),
            Property(spec: Modification(
                subject: This,
                stat: Toughness,
                delta: Up(amount: StatOf(
                    axis: Counter(kind: Boost(power: Up(amount: 1), toughness: Up(amount: 1))),
                    subject: This,
                )),
            )),
        ],
    ),
)
