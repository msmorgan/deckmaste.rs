// `Amount.DistinctCount` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "distinctCount",
    kinds: [Amount],
    params: {"axis": Any, "domain": Subject},
    body: DistinctCount(axis: Param(axis), domain: Param(domain)),
)
