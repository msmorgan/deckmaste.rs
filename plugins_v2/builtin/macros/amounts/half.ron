// `Amount.Half` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "half",
    kinds: [Amount],
    params: {"rounding": Any, "amount": Amount},
    body: Half(rounding: Param(rounding), amount: Param(amount)),
)
