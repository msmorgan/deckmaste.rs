// `NounPhrase.EachOf` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "eachOf",
    kinds: [NounPhrase],
    params: {"group": Subject},
    body: EachOf(group: Param(group)),
)
