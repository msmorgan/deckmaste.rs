// `Window.Parameter` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "parameter",
    kinds: [Window],
    params: {"scope": Nat, "index": Nat},
    body: Parameter(scope: Param(scope), index: Param(index)),
)
