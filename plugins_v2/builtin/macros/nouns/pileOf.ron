// `NounPhrase.PileOf` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "pileOf",
    kinds: [NounPhrase],
    params: {"count": Any, "by": Default(Any, None)},
    body: PileOf(count: Param(count), by: Param(by)),
)
