// `NounPhrase.And` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "and",
    kinds: [NounPhrase],
    params: {"phrases": Default(Any, [])},
    body: And(phrases: Param(phrases)),
)
