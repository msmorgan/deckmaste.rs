// `NounPhrase.Designated` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "designated",
    kinds: [NounPhrase],
    params: {"designation": Any, "whose": Subject},
    body: Designated(designation: Param(designation), whose: Param(whose)),
)
