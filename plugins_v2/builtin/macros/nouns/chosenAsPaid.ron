// "the player chosen as <subject>'s <label> cost was paid", read back by the
// linked ability [CR#607.2d,702.174a]
(
    name: "chosenAsPaid",
    kinds: [NounPhrase],
    params: {"label": KeywordLabel, "subject": NounPhrase},
    body: Paid(ChosenPlayer(ByKeyword(Param(label))), Param(subject)),
)
