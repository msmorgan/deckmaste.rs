// `NounPhrase.AsMarker` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "asMarker",
    kinds: [NounPhrase],
    params: {"marker": Any, "subject": Subject},
    body: AsMarker(marker: Param(marker), subject: Param(subject)),
)
