// `NounPhrase.AsType` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "asType",
    kinds: [NounPhrase],
    params: {"type": Any, "subject": Subject, "subtype": Default(Any, None)},
    body: AsType(r#type: Param(type), subject: Param(subject), subtype: Param(subtype)),
)
