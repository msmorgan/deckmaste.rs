// `NounPhrase.AttachHost` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "attachHost",
    kinds: [NounPhrase],
    params: {"word": Any, "head": NounWord},
    body: AttachHost(word: Param(word), head: Param(head)),
)
