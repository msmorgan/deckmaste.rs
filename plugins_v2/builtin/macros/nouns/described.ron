// `NounPhrase.Described` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "described",
    kinds: [NounPhrase],
    params: {"determiner": Any, "predicate": Quality},
    body: Described(determiner: Param(determiner), predicate: Param(predicate)),
)
