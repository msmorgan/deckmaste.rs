// `NounPhrase.ResolvedPermanent` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "resolvedPermanent",
    kinds: [NounPhrase],
    params: {"spell": Subject},
    body: ResolvedPermanent(spell: Param(spell)),
)
