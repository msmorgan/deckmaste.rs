// `NounPhrase.LibrarySlice` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "librarySlice",
    kinds: [NounPhrase],
    params: {"end": Any, "amount": Amount, "whose": Subject},
    body: LibrarySlice(end: Param(end), amount: Param(amount), whose: Param(whose)),
)
