// "[Player] reveals [cards]" [CR#701.20a]: show them to all players for as long
// as the effect needs. Revealing moves nothing [CR#701.20b]. Lean
// `revealCards`, which carries no deed tag of its own.
KeywordAction(
    name: "Reveal",
    params: [Subject, Subject],
    spelling: "reveal",
    grammar: Verb(
        bare: "reveal",
        frame_set: Transitive,
    ),
    body: Expose(verb: Reveal, exposed: Cards(cards: Param(0)), agent: Param(1)),
)
