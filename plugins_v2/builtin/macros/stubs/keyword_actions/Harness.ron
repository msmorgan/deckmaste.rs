// "Harness [this permanent]" [CR#701.64a] = "If this permanent isn't harnessed,
// it becomes harnessed." Harnessed is a marker designation with no rules
// meaning of its own [CR#701.64b].
KeywordAction(
    name: "Harness",
    params: [Subject],
    spelling: "harness",
    grammar: Verb(
        bare: "harness",
        // No Oracle or Comprehensive Rules occurrence of "harnesses" was found in the 2026-08-18 morphology audit.
        third_person: Unavailable,
        frame_set: Transitive,
    ),
    body: Enact(
        verb: Action(label: "Harness"),
        instruction: DoIf(
        condition: Not(condition: Matches(
            subject: Param(0),
            predicate: HasDesignation(designation: "harnessed", holder: None),
        )),
        instruction: GainDesignation(
            subject: Param(0),
            designation: "harnessed",
            duration: None,
        ),
        otherwise: None,
    ),
        agent: None,
    ),
)
