// "Recruit" [CR#701.70a] = "Draw a card, then discard a card. If you discarded a
// nonland card this way, create a 1/1 white Human Soldier creature token."
KeywordAction(
    name: "Recruit",
    params: [Subject],
    spelling: "recruit",
    grammar: Verb(
        bare: "recruit",
        // No Oracle or Comprehensive Rules occurrence of "recruits" was found in the 2026-08-18 morphology audit.
        third_person: Unavailable,
        frame_set: Intransitive,
    ),
    body: Enact(
        verb: Action(label: "Recruit"),
        instruction: Sequentially(steps: [
        Draw(amount: Lit(value: 1), agent: Param(0)),
        Enact(
            verb: Action(label: "Discard"),
            instruction: Move(
                subject: Described(
                    determiner: A(mode: Unmarked),
                    predicate: And(conjuncts: [
                        IsCard,
                        InZone(zone: Zone(zone: Hand, scope: PossessedBy(possessor: Param(0)))),
                    ]),
                ),
                to: Zone(zone: Graveyard, scope: Bare),
                riders: [],
            ),
            agent: Param(0),
        ),
        DoIf(
            condition: Not(condition: Matches(
                subject: Pro(reach: Verbed(verb: Action(label: "Discard"), word: Card, marking: ThisWay), plurality: One, window: Whole),
                predicate: HasType(type: Land),
            )),
            instruction: CreateObject(
                count: Lit(value: 1),
                spec: Token(
                    spec: Written(characteristics: (characteristics: (
                        colors: [White],
                        types: [Creature],
                        subtypes: [Of(host: Creature, label: "Human"), Of(host: Creature, label: "Soldier")],
                        power: Lit(value: 1),
                        toughness: Lit(value: 1),
                    ))),
                    riders: [],
                ),
                agent: Param(0),
            ),
            otherwise: None,
        ),
    ]),
        agent: None,
    ),
)
