KeywordAbility(
    name: "Boast",
    params: [Ability],
    spelling: "boast",
    grammar: FixedKeyword(
        surface: "boast",
    ),
    // STOP. "Boast — [Cost]: [Effect]" means "[Cost]: [Effect]. Activate only if
    // this creature attacked this turn and only once each turn." [CR#702.142a]
    // `KeywordParam` has no `Ability` variant, so the declaration's `Ability`
    // argument cannot be carried in `params`, and the definition wraps that
    // argument's cost and effect in new `guard` and `limit` riders, which requires
    // reading them out of it.
    body: Keyword(keyword: "Boast", params: [], body: []),
)
