KeywordAbility(
    name: "Solved",
    params: [Ability],
    spelling: "solved",
    grammar: FixedKeyword(
        surface: "solved",
    ),
    // STOP. "Solved — [Ability text]" qualifies the ability written after the keyword:
    // a static one gains "as long as this Case is solved", a triggered one "this
    // ability triggers only if this Case is solved", an activated one "activate only
    // if this Case is solved" [CR#702.169b..702.169d]. `KeywordParam` has no `Ability`
    // variant to forward the declaration's argument with, and nothing lets a
    // definition qualify the ability printed after it (the causes Boast and Backup
    // share).
    body: Keyword(keyword: "Solved", params: [], body: []),
)
