KeywordAbility(
    name: "Afterlife",
    params: [Amount],
    spelling: "afterlife",
    grammar: FixedKeyword(
        surface: "afterlife",
    ),
    // "Afterlife N" means "When this permanent is put into a graveyard from the
    // battlefield, create N 1/1 white and black Spirit creature tokens with
    // flying." [CR#702.135a]
    body: Keyword(
        keyword: "Afterlife",
        params: [Number(amount: Param(0))],
        body: [
            Triggered(
                event: ZoneChange(
                    subject: AsMarker(marker: Permanent, subject: This),
                    from: Zones(zones: [Zone(zone: Battlefield, scope: Bare)]),
                    to: Zone(zone: Graveyard, scope: Bare),
                    observation: Before,
                ),
                alternatives: [],
                r#while: None,
                joins: [],
                timing: None,
                limit: None,
                intervening: None,
                instruction: CreateObject(
                    count: Param(0),
                    spec: Token(
                        spec: Written(
                            characteristics: (
                                characteristics: (
                                    colors: [White, Black],
                                    types: [Creature],
                                    subtypes: [Of(host: Creature, label: "Spirit")],
                                    text: [Flying],
                                    power: Lit(value: 1),
                                    toughness: Lit(value: 1),
                                ),
                            ),
                        ),
                        riders: [],
                    ),
                    agent: You,
                ),
            ),
        ],
    ),
)
