KeywordAbility(
    name: "Landwalk",
    params: [Quality],
    spelling: "landwalk",
    grammar: FixedKeyword(
        surface: "landwalk",
        bound_suffix: (surface: "walk"),
    ),
    // "A creature with landwalk can't be blocked as long as the defending player
    // controls at least one land with the specified land type." [CR#702.14c]
    body: Keyword(
        keyword: "Landwalk",
        params: [Quality(predicate: Param(0))],
        body: [
            Static(
                spec: Conditional(
                    spec: DeonticRule(
                        subject: AsType(type: Creature, subject: This, subtype: None),
                        compulsion: Forbid,
                        deeds: [Core(deed: Block)],
                        role: Patient,
                        bound: None,
                        patient: NoPatient,
                        as_though: None,
                        rider: NoRider,
                    ),
                    condition: Exists(
                        subject: Described(
                            determiner: Bare,
                            predicate: And(
                                conjuncts: [
                                    HasType(type: Land),
                                    Param(0),
                                    HasPossessor(
                                        axis: Controller,
                                        possessor: CombatPlayer(role: Defending),
                                    ),
                                ],
                            ),
                        ),
                    ),
                    marking: AsLongAs,
                ),
            ),
        ],
    ),
)
