KeywordAbility(
    name: "Riot",
    params: [],
    spelling: "riot",
    grammar: FixedKeyword(
        surface: "riot",
    ),
    // STOP. "Riot" means "You MAY have this permanent enter with an additional +1/+1
    // counter on it. If you don't, it gains haste." [CR#702.136a] No entry rider is
    // optional: `StaticSpec::EntryRider` takes a `TokenRider` and only
    // `TokenRider::AsCopyOf` carries an `optional` flag, so `WithCounters` cannot be
    // offered; `StaticSpec::Choice` makes an entry choice of a quality or a player
    // only, and there is nothing for the "if you don't" branch to read (the cause
    // Tribute and Unleash share).
    body: Keyword(keyword: "Riot", params: [], body: []),
)
