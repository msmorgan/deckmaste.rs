    // it would leave the battlefield, exile it instead of putting it anywhere else.
    // Activate only as a sorcery." [CR#702.84a]
    body: Keyword(
        keyword: "Unearth",
        params: [Cost(cost: Param(0))],
        body: [
            Activated(
                cost: Param(0),
                instruction: Sequentially(
                    steps: [
                        Enact(
                            verb: Core(deed: Return),
                            instruction: Move(
                                subject: This,
                                to: Zone(zone: Battlefield, scope: Bare),
                                riders: [],
                            ),
                            agent: You,
                        ),
                        Establish(
                            spec: AbilityGrant(
                                subject: AsMarker(marker: Permanent, subject: This),
                                ability: Haste,
                            ),
                            duration: None,
                        ),
                        Delay(
                            event: BeginningOf(
                                quantifier: The,
                                part: EndStep,
                                whose: NoPossessor,
                            ),
                            alternatives: [],
                            duration: None,
                            body: Enact(
                                verb: Action(label: "Exile"),
                                instruction: Move(
                                    subject: AsMarker(marker: Permanent, subject: This),
                                    to: Zone(zone: Exile, scope: Bare),
                                    riders: [],
                                ),
                                agent: You,
                            ),
                        ),
                        Establish(
                            spec: Replacement(
                                event: ZoneChange(
                                    subject: AsMarker(marker: Permanent, subject: This),
                                    from: Zones(zones: [Zone(zone: Battlefield, scope: Bare)]),
                                    to: None,
                                    observation: Before,
                                ),
                                alternatives: [],
                                timing: None,
                                replacement: Enact(
                                    verb: Action(label: "Exile"),
                                    instruction: Move(
                                        subject: AsMarker(marker: Permanent, subject: This),
                                        to: Zone(zone: Exile, scope: Bare),
                                        riders: [],
                                    ),
                                    agent: None,
                                ),
                                r#use: Repeatedly,
                                limit: None,
                            ),
                            duration: None,
                        ),
                    ],
                ),
                timing: AsSorcery,
