KeywordAbility(
    name: "Paradigm",
    params: [],
    spelling: "paradigm",
    grammar: FixedKeyword(
        surface: "paradigm",
    ),
    // STOP. "Paradigm represents two SPELL abilities, one of which creates a delayed
    // triggered ability." [CR#702.192a] `Ability.category` is `none` for
