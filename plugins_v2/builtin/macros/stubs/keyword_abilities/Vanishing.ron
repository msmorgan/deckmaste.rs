KeywordAbility(
    name: "Vanishing",
    params: [Amount],
    spelling: "vanishing",
    grammar: FixedKeyword(
        surface: "vanishing",
    ),
    // "Vanishing N" means "This permanent enters with N time counters on it," "At the
    // beginning of your upkeep, if this permanent has a time counter on it, remove a
    // time counter from it," and "When the last time counter is removed from this
    // permanent, sacrifice it." [CR#702.63a]
    body: Keyword(
        keyword: "Vanishing",
        params: [Number(amount: Param(0))],
        body: [
            Static(
                spec: EntryRider(
                    subject: AsMarker(marker: Permanent, subject: This),
                    rider: WithCounters(
                        amount: Param(0),
                        kind: Printed(kind: Named(label: "Time")),
                        mark: Fresh,
                    ),
                ),
            ),
            Triggered(
                event: BeginningOf(quantifier: The, part: Upkeep, whose: ByPlayer(player: You)),
                alternatives: [],
                r#while: None,
                joins: [],
                timing: None,
                limit: None,
                intervening: Matches(
                    subject: AsMarker(marker: Permanent, subject: This),
                    predicate: HasCounters(kind: Named(label: "Time")),
                ),
                instruction: RemoveCounters(
                    quantity: Range(low: 1, high: 1),
                    kind: Printed(kind: Named(label: "Time")),
                    from: AsMarker(marker: Permanent, subject: This),
                ),
            ),
            Triggered(
                event: CounterEvent(
                    r#move: Removed,
                    kind: Named(label: "Time"),
                    subject: AsMarker(marker: Permanent, subject: This),
                    batch: Emptying,
                    by: None,
                    by_effect: false,
                ),
                alternatives: [],
                r#while: None,
                joins: [],
                timing: None,
                limit: None,
                intervening: None,
                instruction: Enact(
                    verb: Action(label: "Sacrifice"),
                    instruction: Move(
                        subject: AsMarker(marker: Permanent, subject: This),
                        to: Zone(zone: Graveyard, scope: Bare),
                        riders: [],
                    ),
                    agent: You,
                ),
            ),
        ],
    ),
)
