KeywordAbility(
    name: "ForMirrodin",
    params: [],
    spelling: "for Mirrodin!",
    grammar: FixedKeyword(
        surface: "for Mirrodin!",
    ),
    // "For Mirrodin!" means "When this Equipment enters, create a 2/2 red Rebel
    // creature token, then attach this Equipment to it." [CR#702.163a]
    body: Keyword(
        keyword: "ForMirrodin",
        params: [],
        body: [
            Triggered(
                event: ZoneChange(
                    subject: AsType(
                        type: Artifact,
                        subject: This,
                        subtype: Of(host: Artifact, label: "Equipment"),
                    ),
                    from: None,
                    to: Zone(zone: Battlefield, scope: Bare),
                    observation: After,
                ),
                alternatives: [],
                r#while: None,
                joins: [],
                timing: None,
                limit: None,
                intervening: None,
                instruction: Sequentially(
                    steps: [
                        CreateObject(
                            count: Lit(value: 1),
                            spec: Token(
                                spec: Written(
                                    characteristics: (
                                        characteristics: (
                                            colors: [Red],
                                            types: [Creature],
                                            subtypes: [Of(host: Creature, label: "Rebel")],
                                            power: Lit(value: 2),
                                            toughness: Lit(value: 2),
                                        ),
                                    ),
                                ),
                                riders: [],
                            ),
                            agent: You,
                        ),
                        Enact(
                            verb: Action(label: "Attach"),
                            instruction: Attachment(
                                r#move: Attached,
                                subject: This,
                                host: Pro(reach: TokenBorn, plurality: One, window: Whole),
                            ),
                            agent: None,
                        ),
                    ],
                ),
            ),
        ],
    ),
)
