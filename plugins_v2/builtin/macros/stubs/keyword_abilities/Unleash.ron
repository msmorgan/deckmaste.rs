KeywordAbility(
    name: "Unleash",
    params: [],
    spelling: "unleash",
    grammar: FixedKeyword(
        surface: "unleash",
    ),
    // STOP. "Unleash" means "You MAY have this permanent enter with an additional +1/+1
    // counter on it" and "This permanent can't block as long as it has a +1/+1 counter
    // on it." [CR#702.98a] The second half writes as a conditional `DeonticRule` over
    // `Core(Block)`, but no entry rider is optional: `StaticSpec::EntryRider` takes a
    // `TokenRider` and only `TokenRider::AsCopyOf` carries an `optional` flag (the
    // cause Riot and Tribute share), so the first half cannot be written and a body
    // carrying only the second would be a wrong analysis.
    body: Keyword(keyword: "Unleash", params: [], body: []),
)
