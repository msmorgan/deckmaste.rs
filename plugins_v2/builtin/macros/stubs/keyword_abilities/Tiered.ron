KeywordAbility(
    name: "Tiered",
    params: [],
    spelling: "tiered",
    grammar: FixedKeyword(
        surface: "tiered",
    ),
    // STOP. "Tiered" means "Choose one. As an additional cost to cast this spell, pay
    // the cost associated with that mode." [CR#702.183a] `Instruction::ChooseModes`
    // carries the mode quantity and each mode's cost on the spell's own clause; no
    // constructor lets a separate ability set that quantity or charge for the mode
    // chosen there (the cause Entwine, Escalate and Spree share). The keyword's
    // registry row already carries `wants_modes`, which is how the workbench reads
    // this pairing.
    body: Keyword(keyword: "Tiered", params: [], body: []),
)
