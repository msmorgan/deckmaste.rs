KeywordAbility(
    name: "Impending",
    params: [Amount, Cost],
    spelling: "impending",
    grammar: FixedKeyword(
        surface: "impending",
    ),
    // "Impending N—[cost]" means "You may choose to pay [cost] rather than pay this
    // spell's mana cost," "If you chose to pay this permanent's impending cost, it
    // enters with N time counters on it," "As long as this permanent's impending cost
    // was paid and it has a time counter on it, it's not a creature," and "At the
    // beginning of your end step, if this permanent's impending cost was paid and it
    // has a time counter on it, remove a time counter from it." [CR#702.176a]
    body: Keyword(
        keyword: "Impending",
        params: [Number(amount: Param(0)), Cost(cost: Param(1))],
        body: [
            Static(
                spec: DeonticRule(
                    subject: You,
                    compulsion: Permit,
                    deeds: [Action(label: "Cast")],
                    role: Agent,
                    bound: None,
                    patient: Counterpart(patient: This),
                    as_though: None,
                    rider: Play(
                        from: None,
                        limit: None,
                        timing: None,
                        exclusive: false,
                        payment: PayingInstead(cost: Param(1)),
                    ),
                ),
            ),
            Static(
                spec: Conditional(
                    spec: EntryRider(
                        subject: AsMarker(marker: Permanent, subject: This),
                        rider: WithCounters(
                            amount: Param(0),
                            kind: Printed(kind: Named(label: "Time")),
                            mark: Fresh,
                        ),
                    ),
                    condition: CompareAmt(
                        subject: Paid(
                            facet: Readback(which: ByKeyword(keyword: "Impending"), lookback: None),
                            subject: AsMarker(marker: Permanent, subject: This),
                        ),
                        comparator: AtLeast,
                        bound: Lit(value: 1),
                    ),
                    marking: AsLongAs,
                ),
            ),
            Static(
                spec: Conditional(
                    spec: CharacteristicChange(
                        subject: AsMarker(marker: Permanent, subject: This),
                        edits: [TypeLine(op: Loses, changes: (types: [Creature]))],
                    ),
                    condition: And(
                        conjuncts: [
                            CompareAmt(
                        subject: Paid(
                            facet: Readback(which: ByKeyword(keyword: "Impending"), lookback: None),
                            subject: AsMarker(marker: Permanent, subject: This),
                        ),
                        comparator: AtLeast,
                        bound: Lit(value: 1),
                    ),
                            Matches(
                                subject: AsMarker(marker: Permanent, subject: This),
                                predicate: HasCounters(kind: Named(label: "Time")),
                            ),
                        ],
                    ),
                    marking: AsLongAs,
                ),
            ),
            Triggered(
                event: BeginningOf(quantifier: The, part: EndStep, whose: ByPlayer(player: You)),
                alternatives: [],
                r#while: None,
                joins: [],
                timing: None,
                limit: None,
                intervening: And(
                    conjuncts: [
                        CompareAmt(
                        subject: Paid(
                            facet: Readback(which: ByKeyword(keyword: "Impending"), lookback: None),
                            subject: AsMarker(marker: Permanent, subject: This),
                        ),
                        comparator: AtLeast,
                        bound: Lit(value: 1),
                    ),
                        Matches(
                            subject: AsMarker(marker: Permanent, subject: This),
                            predicate: HasCounters(kind: Named(label: "Time")),
                        ),
                    ],
                ),
                instruction: RemoveCounters(
                    amount: Lit(value: 1),
                    kind: Printed(kind: Named(label: "Time")),
                    from: AsMarker(marker: Permanent, subject: This),
                ),
            ),
        ],
    ),
)
