// REPRODUCED (semantics-v2-subtype-rules, ruling 2026-10-10). The Land twin of
// Equipment: the [CR#301.6] host rule is "this Fortification may be attached to
// a land" over the attach deed's host role [CR#701.3a], and the [CR#704.5n]
// state-based action reads as Equipment's does.
//
// The v1 core type-rule record this declaration carried until
// `plugins-v2-subtypes-macro-only`, preserved verbatim so nothing is lost:
//
//     body: Subtype(
//         name: "Fortification",
//         types: [Artifact],
//         confers: [
//             Static(May(attach(what: Ref(This), to: Type(Land)))),
//         ],
//     ),
//
// Fortification ([CR#301.6]) — the Land twin of the Equipment host rule
// ([CR#301.5]), and a quality of the object in the same way ([CR#113.12]), so
// it is conferred ability-free.
Subtype(
    category: Artifact,
    name: "fortification",
    spelling: "Fortification",
    grammar: Noun(singular: "Fortification"),
    params: [],
    rules: [
        Property(mayBeAttachedTo(thisFortification, allOf(land))),
        StateBased(
            not(matches(thisFortification, attachment(Attachment))),
            attachment(Unattached, thisFortification),
        ),
    ],
)
