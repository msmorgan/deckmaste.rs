// "Clash" [CR#701.30a]: the player reveals the top card of their library and
// may then put that card on the bottom of their library. "Clash with an
// opponent" [CR#701.30b] is a separate printed shape and a separate macro. The
// library the card goes back to is its own owner's, derived rather than written
// [CR#400.3].
KeywordAction(
    name: "clash",
    params: [Subject],
    spelling: "clash",
    grammar: Verb(
        bare: "clash",
        third_person: "clashes",
        frame_set: Custom(
            frames: [[], [Lex("Preposition", "With"), ObjectNounPhrase]],
        ),
    ),
    body: Enact(
        verb: Action("Clash"),
        instruction: Sequentially([
        Expose(
            verb: Reveal,
            exposed: Cards(LibrarySlice(end: Top, amount: 1, whose: Param(0))),
            agent: Param(0),
        ),
        WithContinuation(
            policy: Optional(Param(0)),
            body: Move(
                subject: Pro(reach: Word(Card), plurality: One, window: Whole),
                to: Library(
                    place: OneEnd(Bottom),
                    order: None,
                    offset: None,
                    scope: Bare,
                ),
                riders: [],
            ),
            if_did: None,
            if_not: None,
        ),
    ]),
        agent: Param(0),
    ),
)
