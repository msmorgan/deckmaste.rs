// "<voters> vote for <ballot>" [CR#701.38a]. Lean `vote`; its basis
// constructor already is the act, so no `Enact` deed wrapper. `first` stays
// `None` — this declaration is the plain `vote`, not `voteStartingWith`. The
// voter is the actor.
KeywordAction(
    name: "vote",
    params: [Disclosure, Ballot],
    spelling: "vote",
    grammar: Verb(
        bare: "vote",
        frame_set: Custom(
            frames: [
                [],
                [ObjectNounPhrase],
                [Lex("Preposition", "For"), ObjectNounPhrase],
            ],
        ),
    ),
    deed: None,
    body: Vote(None, Param(0), Param(1), actor),
)
