// "Recruit" [CR#701.70a] = "Draw a card, then discard a card. If you discarded a
// nonland card this way, create a 1/1 white Human Soldier creature token."
KeywordAction(
    name: "recruit",
    params: [Subject],
    spelling: "recruit",
    grammar: Verb(
        bare: "recruit",
        // No Oracle or Comprehensive Rules occurrence of "recruits" was found in the 2026-08-18 morphology audit.
        third_person: Unavailable,
        frame_set: Intransitive,
    ),
    body: Enact(
        verb: Action("Recruit"),
        instruction: Sequentially([
        Draw(amount: 1, agent: Param(0)),
        Enact(
            verb: Action("Discard"),
            instruction: Move(
                subject: Described(
                    determiner: A(Unmarked),
                    predicate: And([
                        IsCard,
                        InZone(Zone(zone: Hand, scope: PossessedBy(Param(0)))),
                    ]),
                ),
                to: Zone(zone: Graveyard, scope: Bare),
                riders: [],
            ),
            agent: Param(0),
        ),
        DoIf(
            condition: Not(Matches(
                subject: Pro(reach: Verbed(verb: Action("Discard"), word: Card, marking: ThisWay), plurality: One, window: Whole),
                predicate: HasType(Land),
            )),
            instruction: CreateObject(
                count: 1,
                spec: Token(
                    spec: Written((characteristics: (
                        colors: [White],
                        types: [Creature],
                        subtypes: [Of(host: Creature, label: "Human"), Of(host: Creature, label: "Soldier")],
                        power: 1,
                        toughness: 1,
                    ))),
                    riders: [],
                ),
                agent: Param(0),
            ),
            otherwise: None,
        ),
    ]),
        agent: None,
    ),
)
