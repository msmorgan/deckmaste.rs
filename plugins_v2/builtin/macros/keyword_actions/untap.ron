// "Untap [permanent]" [CR#701.26b]: rotate it back to upright from sideways.
// Only a tapped permanent can be untapped. Lean `untap`.
KeywordAction(
    name: "untap",
    params: [Subject],
    spelling: "untap",
    grammar: Verb(
        bare: "untap",
        participle: Unavailable,
        frame_set: Custom(frames: [[], [ObjectNounPhrase]]),
    ),
    body: Enact(
        verb: Action("Untap"),
        instruction: SetStatus(status: Untapped, subject: Param(0)),
        agent: None,
    ),
)
