// "<agent> creates N <token>" [CR#701.7a]: the creating spell or ability
// defines the token's characteristics [CR#111.3,111.4]. Lean `create`, with
// the token argument typed `TokenSpec` rather than Lean's own
// `CharacteristicBundle` (the raw instruction's `spec` field wants the
// wider type; a caller writes `Written(characteristics: (...))`).
KeywordAction(
    name: "create",
    params: [Amount, TokenSpec, Subject],
    spelling: "create",
    grammar: Verb(
        bare: "create",
        frame_set: Transitive,
    ),
    body: CreateObject(
        count: Param(0),
        spec: Token(spec: Param(1), riders: []),
        agent: Param(2),
    ),
)
