// "meld <subject> into <name>" [CR#701.42a]: combine two specific permanents
// you control into a single melded permanent. Lean `meldInto`. A player melds
// [CR#701.42c], so the wrapper records the actor.
KeywordAction(
    name: "meld",
    params: [Subject, String],
    spelling: "meld <Param(0)> into <Param(1)>",
    grammar: Verb(
        bare: "meld",
        frame_set: Transitive,
    ),
    body: Move(Param(0), wherever, battlefield, [EntersMelded(Param(1))]),
)
