// "Harness [this permanent]" [CR#701.64a] = "If this permanent isn't harnessed,
// it becomes harnessed." Harnessed is a marker designation with no rules
// meaning of its own [CR#701.64b].
// It is an instruction about "this permanent", not one to a permanent: the
// ability's controller follows it [CR#608.2c], as a player is instructed to
// "monstrosity X" [CR#701.37c].
KeywordAction(
    name: "harness",
    params: [Subject],
    spelling: "harness <Param(0)>",
    grammar: Verb(
        bare: "harness",
        // No Oracle or Comprehensive Rules occurrence of "harnesses" was found in the 2026-08-18 morphology audit.
        third_person: Unavailable,
        frame_set: Transitive,
    ),
    body: doIf(
        not(matches(Param(0), hasDesignation(harnessed))),
        gainDesignation(Param(0), harnessed),
    ),
)
