// "Populate" [CR#701.36a] = "Choose a creature token you control and create a
// token that's a copy of that creature token." Controlling no creature token
// creates nothing [CR#701.36b]; that is the choice failing, not a branch.
KeywordAction(
    name: "populate",
    params: [],
    spelling: "populate",
    grammar: Verb(
        bare: "populate",
        // No Oracle or Comprehensive Rules occurrence of "populates" was found in the 2026-08-18 morphology audit.
        third_person: Unavailable,
        frame_set: Intransitive,
    ),
    body: Enact(
        verb: Action("Populate"),
        instruction: Sequentially([
        Choose(
            first: None,
            chosen: Described(
                determiner: A(Unmarked),
                predicate: And([
                    IsToken,
                    HasType(Creature),
                    InZone(Zone(zone: Battlefield, scope: Bare)),
                    HasPossessor(axis: Controller, possessor: You),
                ]),
            ),
            disclosure: Openly,
            when: None,
            agent: You,
        ),
        CreateObject(
            count: 1,
            spec: Token(
                spec: CopyOf(
                    source: Pro(reach: Word(Token), plurality: One, window: Whole),
                    exceptions: [],
                ),
                riders: [],
            ),
            agent: You,
        ),
    ]),
        agent: None,
    ),
)
