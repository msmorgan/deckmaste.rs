// "Proliferate" [CR#701.34a]: choose any number of permanents and/or players
// that have a counter, then give each one additional counter of each kind that
// permanent or player already has. Lean `proliferate`.
KeywordAction(
    name: "proliferate",
    params: [],
    spelling: "proliferate",
    grammar: Verb(
        bare: "proliferate",
        frame_set: Intransitive,
    ),
    body: Enact(
        verb: Action("Proliferate"),
        instruction: Sequentially([
        Choose(
            first: None,
            chosen: Described(
                determiner: Count(quantity: Range(low: None, high: None), mode: None),
                predicate: Or([
                    And([
                        InZone(Zone(zone: Battlefield, scope: Bare)),
                        HasCounters(None),
                    ]),
                    Compare(axes: [AnyCounter(Player)], comparator: AtLeast, bound: 1),
                ]),
            ),
            disclosure: Openly,
            when: None,
            agent: None,
        ),
        PutCounters(
            amount: 1,
            kind: Own,
            on: EachOf(Pro(reach: Word(Join), plurality: Many, window: Whole)),
        ),
    ]),
        agent: None,
    ),
)
