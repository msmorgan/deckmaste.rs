// "Blight N" [CR#701.68a] = put N -1/-1 counters on a creature you control. The
// chosen creature is the "blighted creature" [CR#701.68c].
KeywordAction(
    name: "blight",
    params: [Amount],
    spelling: "blight",
    grammar: Verb(
        bare: "blight",
        frame_set: MeasureComplement,
    ),
    body: Enact(
        verb: Action("Blight"),
        instruction: PutCounters(
        amount: Param(0),
        kind: Printed(Boost(power: Down(1), toughness: Down(1))),
        on: Described(
            determiner: A(Unmarked),
            predicate: And([
                HasType(Creature),
                HasPossessor(axis: Controller, possessor: You),
            ]),
        ),
    ),
        agent: You,
    ),
)
