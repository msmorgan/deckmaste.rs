// "Blight N" [CR#701.68a] = put N -1/-1 counters on a creature you control. The
// chosen creature is the "blighted creature" [CR#701.68c]. "You" is the
// actor, whoever blights.
KeywordAction(
    name: "blight",
    params: [Amount],
    spelling: "blight",
    grammar: Verb(
        bare: "blight",
        frame_set: MeasureComplement,
    ),
    body: putCounters(Param(0), m1m1Counter, a(and([creature, actorControls]))),
)
