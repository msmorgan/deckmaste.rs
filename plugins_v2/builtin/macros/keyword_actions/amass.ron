// "Amass <subtype> N" with its reminder text [CR#701.47a]: "If you don't
// control an Army, create a 0/0 black <subtype> Army creature token. Choose
// an Army you control. Put N +1/+1 counters on it. It's a <subtype> in
// addition to its other types." Lean `amass`, with the amassed subtype
// typed `Subtype` rather than Lean's own `String` (it is spliced into a
// `Vec<Subtype>` position twice, which no `String` value can fill).
KeywordAction(
    name: "amass",
    params: [Subtype, Amount],
    spelling: "amass",
    grammar: Verb(
        bare: "amass",
        third_person: "amasses",
        frame_set: Custom(frames: [[ObjectNounPhrase, Amount]]),
    ),
    body: sequentially([
        // "If you don't control an Army, create a 0/0 black <subtype> Army
        // creature token."
        doIf(
            not(exists(armyYouControl)),
            createToken(you, creatureToken(0, 0, [Black], [Param(0), army])),
        ),
        // "Choose an Army you control."
        choose(a(armyYouControl)),
        // "Put N +1/+1 counters on it."
        putCounters(Param(1), p1p1Counter, that(Creature)),
        // "It's a <subtype> in addition to its other types."
        doIf(
            not(matches(it, hasSubtype(Param(0)))),
            establish(addSubtype(it, Param(0))),
        ),
    ]),
)
