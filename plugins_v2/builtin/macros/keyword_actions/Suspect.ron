// "Suspect [creature]" [CR#701.60a]: it becomes suspected until it leaves the
// battlefield or an effect ends the designation. Menace and "can't block" are
// the designation's own consequences [CR#701.60c], not this clause's.
KeywordAction(
    name: "Suspect",
    params: [Subject, Subject],
    spelling: "suspect",
    grammar: Verb(
        bare: "suspect",
        // No Oracle or Comprehensive Rules occurrence of "suspects" was found in the 2026-08-18 morphology audit.
        third_person: Unavailable,
        frame_set: Transitive,
    ),
    body: Enact(
        verb: Action(label: "Suspect"),
        instruction: GainDesignation(
        subject: Param(0),
        designation: "suspected",
        duration: None,
    ),
        agent: Param(1),
    ),
)
