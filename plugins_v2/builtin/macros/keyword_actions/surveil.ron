// "Surveil N" [CR#701.25a]: look at the top N cards of your library, then put
// any number of them into your graveyard and the rest on top of your library
// in any order. "Your" is the actor's; the slice is read back as scry's is
// (`lookAndSortSlice`).
KeywordAction(
    name: "surveil",
    params: [Amount],
    spelling: "surveil",
    grammar: Verb(
        bare: "surveil",
        frame_set: MeasureComplement,
    ),
    body: lookAndSortSlice(librarySlice(Top, Param(0), actor), graveyard),
)
