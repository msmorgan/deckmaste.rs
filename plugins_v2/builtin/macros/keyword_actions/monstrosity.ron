// "Monstrosity N" [CR#701.37a] = "If this permanent isn't monstrous, put N
// +1/+1 counters on it and it becomes monstrous." Monstrous is a marker
// designation [CR#701.37b]. Lean `makeMonstrous`, with the deed tag its own
// bench spelling leaves off.
KeywordAction(
    name: "monstrosity",
    params: [Amount],
    spelling: "monstrosity",
    grammar: Verb(
        bare: "monstrosity",
        // No Oracle or Comprehensive Rules third-person-singular present inflectional form of "monstrosity" was found in the 2026-08-18 morphology audit.
        third_person: Unavailable,
        frame_set: MeasureComplement,
    ),
    body: Enact(
        verb: Action("Monstrosity"),
        instruction: DoIf(
        condition: Not(Matches(
            subject: AsMarker(marker: Permanent, subject: This),
            predicate: HasDesignation(designation: "monstrous", holder: None),
        )),
        instruction: Sequentially([
            PutCounters(
                amount: Param(0),
                kind: Printed(Boost(power: Up(1), toughness: Up(1))),
                on: AsMarker(marker: Permanent, subject: This),
            ),
            GainDesignation(
                subject: AsMarker(marker: Permanent, subject: This),
                designation: "monstrous",
                duration: None,
            ),
        ]),
        otherwise: None,
    ),
        agent: None,
    ),
)
