// "Counter [spell or ability]" [CR#701.6a]: cancel it, removing it from the
// stack; a countered spell is put into its owner's graveyard. One labeled
// stack-to-graveyard move — Lean `Primitives.Instruction.counterSpell`.
KeywordAction(
    name: "Counter",
    params: [Subject],
    spelling: "counter",
    grammar: Verb(
        bare: "counter",
        frame_set: Transitive,
    ),
    body: Enact(
        verb: Action(label: "Counter"),
        instruction: Move(subject: Param(0), to: Zone(zone: Graveyard, scope: Bare), riders: []),
        agent: None,
    ),
)
