// "Transform [permanent]" [CR#701.27a]: turn it over so that its other face is
// up. Only a permanent represented by a double-faced token or card can
// transform [CR#701.27a,701.27c]. Lean `transform`.
KeywordAction(
    name: "transform",
    params: [Subject],
    spelling: "transform",
    grammar: Verb(
        bare: "transform",
        frame_set: Transitive,
    ),
    body: Enact(
        verb: Action("Transform"),
        instruction: TurnOver(Param(0)),
        agent: None,
    ),
)
