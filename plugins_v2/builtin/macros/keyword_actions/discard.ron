// "[Player] discards [cards]" [CR#701.9a]: move them from that player's hand to
// that player's graveyard. Lean `discard`; the agent is the discarding player,
// written explicitly.
KeywordAction(
    name: "discard",
    params: [Subject, Subject],
    spelling: "discard",
    grammar: Verb(
        bare: "discard",
        frame_set: Transitive,
    ),
    agent: Param(1),
    body: move(Param(0), graveyard, hand),
)
