// "Airbend [objects]" [CR#701.65a]: the actor exiles them, and for as
// long as each exiled card remains exiled its owner may cast it by paying {2}
// rather than its mana cost. The permission is a continuous deontic clause
// scoped to the exile, read back off the airbending stamp.
KeywordAction(
    name: "airbend",
    params: [Subject],
    spelling: "airbend",
    grammar: Verb(
        bare: "airbend",
        frame_set: Transitive,
    ),
    body: sequentially([
        move(Param(0), wherever, exileZone),
        establish(
            mayPlayDeed(
                Action("Cast"),
                ownerOf(themVerbed(Action("Airbend"))),
                themVerbed(Action("Airbend")),
                Play(exileZone, None, None, false, PayingInstead(mana([2]))),
            ),
            forAsLongAs(matches(themVerbed(Action("Airbend")), inZone(exileZone))),
        ),
    ]),
)
