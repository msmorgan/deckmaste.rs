// "Airbend [objects]" [CR#701.65a]: the actor exiles them, and for as
// long as each exiled card remains exiled its owner may cast it by paying {2}
// rather than its mana cost. The body's own exile moves them, and each later
// mention reads back by Binding Identity the objects that exile moved (§12.2,
// first mention binds), with the phrase's own number: "it" for one object,
// "them" for several. The permission is handed to their owner and lasts while
// they stay exiled.
KeywordAction(
    name: "airbend",
    params: [Subject],
    spelling: "airbend <Param(0)>",
    grammar: Verb(
        bare: "airbend",
        frame_set: Transitive,
    ),
    body: sequentially([
        exile(Param(0)),
        act(
            // STOP: one performer for the whole group. The per-card spelling,
            // `doForEach(allFromAmong(card, Param(0)), act(ownerOf(it), …))`,
            // waits on `lean-drt-anaphora-refactor`: for one object each "it"
            // ties between the loop's card and the exiled object.
            ownerOf(Param(0)),
            establish(
                mayCastFrom(Param(0), exileZone, PayingInstead(mana([2]))),
                forAsLongAs(matches(Param(0), inZone(exileZone))),
            ),
        ),
    ]),
)
