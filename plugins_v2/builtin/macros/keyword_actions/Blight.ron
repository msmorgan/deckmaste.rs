// "Blight N" [CR#701.68a] = put N -1/-1 counters on a creature you control. The
// chosen creature is the "blighted creature" [CR#701.68c].
KeywordAction(
    name: "Blight",
    params: [Amount],
    spelling: "blight",
    grammar: Verb(
        bare: "blight",
        frame_set: MeasureComplement,
    ),
    body: Enact(
        verb: Action(label: "Blight"),
        instruction: PutCounters(
        amount: Param(0),
        kind: Printed(kind: Boost(power: Down(amount: 1), toughness: Down(amount: 1))),
        on: Described(
            determiner: A(mode: Unmarked),
            predicate: And(conjuncts: [
                HasType(type: Creature),
                HasPossessor(axis: Controller, possessor: You),
            ]),
        ),
    ),
        agent: You,
    ),
)
