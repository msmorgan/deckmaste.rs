// "Behold a [quality]" [CR#701.4a] = "Reveal a [quality] card from your hand or
// choose a [quality] permanent you control on the battlefield." The disjunction
// is the beholding player's choice, so it is a one-of-two mode choice.
KeywordAction(
    name: "behold",
    params: [Quality],
    spelling: "behold",
    grammar: Verb(
        bare: "behold",
        // No Oracle or Comprehensive Rules occurrence of "beholds" was found in the 2026-08-18 morphology audit.
        third_person: Unavailable,
        frame_set: Transitive,
    ),
    agent: you,
    body: chooseOne(
        reveal(a(and([isCard, Param(0), inZone(handOf(you))])), you),
        choose(subject: a(and([Param(0), permanent, youControl])), agent: you),
    ),
)
