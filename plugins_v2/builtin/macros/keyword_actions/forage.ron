// "Forage" [CR#701.61a] = "Exile three cards from your graveyard or sacrifice a
// Food." The disjunction is the foraging player's choice.
KeywordAction(
    name: "forage",
    params: [Subject],
    spelling: "forage",
    grammar: Verb(
        bare: "forage",
        // No Oracle or Comprehensive Rules occurrence of "forages" was found in the 2026-08-18 morphology audit.
        third_person: Unavailable,
        frame_set: Intransitive,
    ),
    body: Enact(
        verb: Action("Forage"),
        instruction: ChooseModes(
        quantity: Range(low: 1, high: 1),
        modes: [
            (None, Enact(
                verb: Action("Exile"),
                instruction: Move(
                    subject: Described(
                        determiner: Count(quantity: Range(low: 3, high: 3), mode: None),
                        predicate: And([
                            IsCard,
                            InZone(Zone(zone: Graveyard, scope: PossessedBy(Param(0)))),
                        ]),
                    ),
                    to: Zone(zone: Exile, scope: Bare),
                    riders: [],
                ),
                agent: Param(0),
            )),
            (None, Enact(
                verb: Action("Sacrifice"),
                instruction: Move(
                    subject: Described(
                        determiner: A(Unmarked),
                        predicate: And([
                            HasSubtype(Of(host: Artifact, label: "Food")),
                            InZone(Zone(zone: Battlefield, scope: Bare)),
                            HasPossessor(axis: Controller, possessor: Param(0)),
                        ]),
                    ),
                    to: Zone(zone: Graveyard, scope: Bare),
                    riders: [],
                ),
                agent: Param(0),
            )),
        ],
    ),
        agent: Param(0),
    ),
)
