// "Forage" [CR#701.61a] = "Exile three cards from your graveyard or sacrifice a
// Food." The disjunction is the foraging player's choice. "You" is the actor,
// whoever forages.
KeywordAction(
    name: "forage",
    params: [],
    spelling: "forage",
    grammar: Verb(
        bare: "forage",
        // No Oracle or Comprehensive Rules occurrence of "forages" was found in the 2026-08-18 morphology audit.
        third_person: Unavailable,
        frame_set: Intransitive,
    ),
    body: chooseOne(
        exileBy(
            actor,
            counted(exactly(3), cardIn(graveyardOf(actor))),
            graveyardOf(actor),
        ),
        sacrifice(a(and([hasSubtype(food), permanent, controlledBy(actor)]))),
    ),
)
