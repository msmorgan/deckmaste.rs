// "Investigate" [CR#701.16a] = "Create a Clue token." The Clue is the
// predefined colorless Clue artifact token with "{2}, Sacrifice this token:
// Draw a card" [CR#111.10f], written out here because the token's
// characteristics are the definition, not a lookup.
KeywordAction(
    name: "investigate",
    params: [Subject],
    spelling: "investigate",
    grammar: Verb(
        bare: "investigate",
        frame_set: Intransitive,
    ),
    body: Enact(
        verb: Action("Investigate"),
        instruction: CreateObject(
        count: 1,
        spec: Token(
            spec: Written((characteristics: (
                types: [Artifact],
                subtypes: [Of(host: Artifact, label: "Clue")],
                text: [Activated(
                    cost: Compound([
                        Mana([2]),
                        Perform(Enact(
                            verb: Action("Sacrifice"),
                            instruction: Move(subject: This, to: Zone(zone: Graveyard, scope: Bare), riders: []),
                            agent: You,
                        )),
                    ]),
                    instruction: Draw(amount: 1, agent: You),
                    timing: None,
                    limit: None,
                    guard: None,
                    activator: None,
                )],
            ))),
            riders: [],
        ),
        agent: Param(0),
    ),
        agent: Param(0),
    ),
)
