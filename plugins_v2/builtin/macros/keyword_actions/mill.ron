// "[Player] mills N cards" [CR#701.17a]: that player puts that many cards from
// the top of their library into their graveyard. Lean `mill`. The clamp to
// library size [CR#701.17b] is the rules', not the clause's.
KeywordAction(
    name: "mill",
    params: [Amount, Subject, Subject],
    spelling: "mill",
    grammar: Verb(
        bare: "mill",
        frame_set: Transitive,
    ),
    agent: Param(2),
    body: move(librarySlice(Top, Param(0), Param(1)), library, graveyard),
)
