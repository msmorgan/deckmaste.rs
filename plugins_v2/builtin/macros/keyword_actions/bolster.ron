// "Bolster N" [CR#701.39a] = "Choose a creature you control with the least
// toughness or tied for least toughness among creatures you control. Put N
// +1/+1 counters on that creature." The tie is the superlative's own: a
// least-toughness reading admits every creature that reaches the minimum.
KeywordAction(
    name: "bolster",
    params: [Amount],
    spelling: "bolster",
    grammar: Verb(
        bare: "bolster",
        // No Oracle or Comprehensive Rules occurrence of "bolsters" was found in the 2026-08-18 morphology audit.
        third_person: Unavailable,
        frame_set: MeasureComplement,
    ),
    body: Enact(
        verb: Action(label: "Bolster"),
        instruction: Sequentially(steps: [
        Choose(
            first: None,
            chosen: Described(
                determiner: A(mode: Unmarked),
                predicate: And(conjuncts: [
                    HasType(type: Creature),
                    HasPossessor(axis: Controller, possessor: You),
                    Superlative(
                        op: Min,
                        axis: Stat(stat: Toughness),
                        domain: And(conjuncts: [
                            HasType(type: Creature),
                            HasPossessor(axis: Controller, possessor: You),
                        ]),
                    ),
                ]),
            ),
            disclosure: Openly,
            when: None,
            agent: You,
        ),
        PutCounters(
            amount: Param(0),
            kind: Printed(kind: Boost(power: Up(amount: 1), toughness: Up(amount: 1))),
            on: Pro(reach: Word(word: Type(type: Creature)), plurality: One, window: Whole),
        ),
    ]),
        agent: None,
    ),
)
