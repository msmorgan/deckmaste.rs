// "<agent> searches <scope> for <predicate>" [CR#701.23a]. The raw
// `Instruction::search` constructor already is the act, so no `Enact` deed
// wrapper; `scope` is a `SearchScope` and the count a `Quantity`.
KeywordAction(
    name: "search",
    params: [SearchScope, Quantity, Quality, Subject],
    spelling: "search",
    grammar: Verb(
        bare: "search",
        third_person: "searches",
        preterite: "searched",
        frame_set: Custom(
            frames: [
                [ObjectNounPhrase],
                [Lex("Preposition", "For"), ObjectNounPhrase],
                [ObjectNounPhrase, Lex("Preposition", "For"), ObjectNounPhrase],
            ],
        ),
    ),
    deed: None,
    body: Search(Param(0), Param(1), Param(2), Param(3)),
)
