// "Tap [permanent]" [CR#701.26a]: turn it sideways from an upright position.
// Only an untapped permanent can be tapped [CR#701.26a]. Lean `tap`.
KeywordAction(
    name: "tap",
    params: [Subject],
    spelling: "tap",
    grammar: Verb(
        bare: "tap",
        participle: "tapped",
        frame_set: Transitive,
    ),
    body: Enact(
        verb: Action("Tap"),
        instruction: SetStatus(status: Tapped, subject: Param(0)),
        agent: None,
    ),
)
