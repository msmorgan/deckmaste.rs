// "Goad [creature]" [CR#701.15a]: until the next turn of the controller of the
// goading spell or ability, that creature is goaded. Goaded is a designation
// [CR#701.15b] whose combat requirements are the designation's, not this
// clause's.
KeywordAction(
    name: "goad",
    params: [Subject],
    spelling: "goad",
    grammar: Verb(
        bare: "goad",
        // No Oracle or Comprehensive Rules occurrence of "goads" was found in the 2026-08-18 morphology audit.
        third_person: Unavailable,
        frame_set: Transitive,
    ),
    body: Enact(
        verb: Action("Goad"),
        instruction: GainDesignation(
        subject: Param(0),
        designation: "goaded",
        duration: Until(StartOf(part: Turn, whose: PossessorOf(axis: Controller, subject: This))),
    ),
        agent: None,
    ),
)
