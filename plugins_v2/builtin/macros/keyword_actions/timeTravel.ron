// "Time travel" [CR#701.56a]: choose any number of permanents you control with
// one or more time counters on them and/or suspended cards you own in exile
// with one or more time counters on them, and for each put a time counter on it
// or remove one from it. A suspended card is read as its state — a card in
// exile that has suspend and a time counter [CR#702.62b] — owned by the actor.
// "You" is the actor, whoever time travels.
KeywordAction(
    name: "timeTravel",
    params: [],
    spelling: "time travel",
    grammar: Verb(
        bare: "time travel",
        // No Oracle or Comprehensive Rules occurrence of "time travels" was found in the 2026-08-18 morphology audit.
        third_person: Unavailable,
        frame_set: Intransitive,
    ),
    body: sequentially([
        choose(
            counted(
                anyNumber,
                or([
                    and([permanent, actorControls, hasCounters(timeCounter)]),
                    and([
                        card,
                        inZone(exileZone),
                        ownedBy(actor),
                        hasKeyword(The(suspend)),
                        hasCounters(timeCounter),
                    ]),
                ]),
            ),
        ),
        doForEach(
            them,
            chooseOne(putCounters(1, timeCounter, it), removeCounters(exactly(1), timeCounter, it)),
        ),
    ]),
)
