// `Quantity.Range` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "range",
    kinds: [Quantity],
    params: {"low": Default(Any, None), "high": Default(Any, None)},
    body: Range(low: Param(low), high: Param(high)),
)
