// `Ability.Spell` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "spell",
    kinds: [Ability],
    params: {"timing": Default(Any, None), "instruction": Instruction},
    body: Spell(timing: Param(timing), instruction: Param(instruction)),
)
