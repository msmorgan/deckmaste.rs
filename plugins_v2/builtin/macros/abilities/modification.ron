// `StaticSpec.Modification` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "modification",
    kinds: [StaticSpec],
    params: {"subject": Subject, "stat": Stat, "delta": Delta},
    body: Modification(subject: Param(subject), stat: Param(stat), delta: Param(delta)),
)
