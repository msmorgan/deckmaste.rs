// "<player> may cast this card [from <from>] [if the resulting spell is <resulting>]
// by paying <cost> rather than its mana cost"
(
    name: "mayCastFor",
    kinds: [StaticSpec],
    params: {"player": NounPhrase, "cost": Cost, "from": Default(Any, None), "resulting": Default(Any, None)},
    body: DeonticRule(Param(player), Permit, [cast], Agent, None, Counterpart(This), None, Play(Param(from), None, None, false, PayingInstead(Param(cost)), Param(resulting)), None),
)
