// `Ability.ItalicHead` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "italicHead",
    kinds: [Ability],
    params: {"word": Any, "ability": Ability},
    body: ItalicHead(word: Param(word), ability: Param(ability)),
)
