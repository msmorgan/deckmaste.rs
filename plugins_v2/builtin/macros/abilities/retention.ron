// `StaticSpec.Retention` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "retention",
    kinds: [StaticSpec],
    params: {"spec": StaticSpec, "subject": Subject},
    body: Retention(spec: Param(spec), subject: Param(subject)),
)
