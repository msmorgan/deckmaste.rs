// `StaticSpec.Conditional` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "conditional",
    kinds: [StaticSpec],
    params: {"spec": StaticSpec, "condition": Condition, "marking": Any},
    body: Conditional(spec: Param(spec), condition: Param(condition), marking: Param(marking)),
)
