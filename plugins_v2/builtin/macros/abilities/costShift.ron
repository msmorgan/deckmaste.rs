// `StaticSpec.CostShift` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "costShift",
    kinds: [StaticSpec],
    params: {"subject": Subject, "shift": Any},
    body: CostShift(subject: Param(subject), shift: Param(shift)),
)
