// `StaticSpec.LetterDefinition` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "letterDefinition",
    kinds: [StaticSpec],
    params: {"letter": Any, "amount": Amount},
    body: LetterDefinition(letter: Param(letter), amount: Param(amount)),
)
