// `StaticSpec.AbilityGrantFrom` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "abilityGrantFrom",
    kinds: [StaticSpec],
    params: {"subject": Subject, "classes": Default(Any, []), "source": Subject, "except": Default(Any, None)},
    body: AbilityGrantFrom(subject: Param(subject), classes: Param(classes), source: Param(source), except: Param(except)),
)
