// `StaticSpec.RevealedAsCast` under Lean's own name for it: as its owner casts
// <spell>, they may reveal this card from their hand [CR#601.2b]; if they do,
// <grants> applies to that spell (splice [CR#702.47a]).
(
    name: "revealedAsCast",
    kinds: [StaticSpec],
    params: {"spell": NounPhrase, "grants": StaticSpec},
    body: RevealedAsCast(spell: Param(spell), grants: Param(grants)),
)
