// "<subject> enters with N fewer <kind> counters on it"
(
    name: "EntersWithFewerCounters",
    kinds: [StaticSpec],
    params: {"subject": NounPhrase, "amount": Amount, "kind": CounterKind},
    body: EntryRider(Param(subject), WithCounters(Param(amount), Printed(kind: Param(kind)), Fewer)),
)
