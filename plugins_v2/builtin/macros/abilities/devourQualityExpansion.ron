// Devour [quality] N's definition, an Off-Stack Static: "As this object
// enters, you may sacrifice any number of [quality] permanents. This permanent
// enters with N +1/+1 counters on it for each permanent sacrificed this way."
// [CR#702.82c] Bare devour N is this over creatures [CR#702.82a], and writes
// it as `flying` writes `flyingExpansion`. "Devour [quality] N" has no keyword
// declaration of its own yet (`semantics-v2-devour-quality-keyword`). "It devoured"
// [CR#702.82b] reads the sacrificed objects back as a Linked Facet
// (`linkedObjects`), on the card that reads it.
(
    name: "devourQualityExpansion",
    kinds: [Ability],
    params: {"quality": Predicate, "amount": Amount},
    body: static(
        asEvent(
            enters(thisPermanent),
            sequentially([
                may(sacrifice(counted(anyNumber, and([Param(quality), permanent])))),
                establish(
                    entersWithCounters(
                        thisPermanent,
                        times(Param(amount), numberOf(theVerbed(sacrifice, Many))),
                        p1p1Counter,
                    ),
                ),
            ]),
        ),
    ),
)
