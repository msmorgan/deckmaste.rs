// `StaticSpec.Choice` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "choice",
    kinds: [StaticSpec],
    params: {"occasion": Any, "subject": Subject, "sort": Any, "domain": Default(Any, None), "disclosure": Disclosure},
    body: Choice(occasion: Param(occasion), subject: Param(subject), sort: Param(sort), domain: Param(domain), disclosure: Param(disclosure)),
)
