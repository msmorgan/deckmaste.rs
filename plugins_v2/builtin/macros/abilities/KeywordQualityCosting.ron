// "<keyword> <quality> <cost>", e.g. "plainscycling {2}" [CR#702.29e]
(
    name: "KeywordQualityCosting",
    kinds: [Ability],
    params: {"label": KeywordLabel, "quality": Predicate, "cost": Cost},
    body: Keyword(Param(label), [Quality(predicate: Param(quality)), Cost(cost: Param(cost))], []),
)
