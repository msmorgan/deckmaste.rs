// `Timing.BeforePart` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "beforePart",
    kinds: [Timing],
    params: {"part": TurnPart, "whose": Default(Any, None)},
    body: BeforePart(part: Param(part), whose: Param(whose)),
)
