// `StaticSpec.AddedCost` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "addedCost",
    kinds: [StaticSpec],
    params: {"cost": Cost, "offered": Any},
    body: AddedCost(cost: Param(cost), offered: Param(offered)),
)
