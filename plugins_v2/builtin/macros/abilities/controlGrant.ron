// `StaticSpec.ControlGrant` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "controlGrant",
    kinds: [StaticSpec],
    params: {"player": Subject, "subject": Subject},
    body: ControlGrant(player: Param(player), subject: Param(subject)),
)
