// `TokenSpec.CopyOf` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "copyOf",
    kinds: [TokenSpec],
    params: {"source": Subject, "exceptions": Default(Any, [])},
    body: CopyOf(source: Param(source), exceptions: Param(exceptions)),
)
