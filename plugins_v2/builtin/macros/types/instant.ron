// Instant ([CR#300.1]) — its owner may cast an instant card from their hand
// any time they have priority ([CR#304.1,117.1a]). Being castable is a quality
// of the object, not an ability of it ([CR#113.12]), so the cast permission is
// conferred ability-free.
Type(
    name: "instant",
    spelling: "instant",
    grammar: Noun(singular: "instant"),
    params: [],
    body: CardType(
        card_type: Instant,
        permanent_type: false,
        confers: [Property(spec: mayPlayDeed(cast, You, This, Play(yourHand, None, asInstant, false, ItsOwnCost)))],
    ),
)
