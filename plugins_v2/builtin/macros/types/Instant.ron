// Instant ([CR#300.1]) — being castable at instant speed ([CR#601.2,304.1])
// is a quality of the object, not an ability of it ([CR#113.12]), so the
// default-deny cast permission is conferred ability-free.
Type(
    name: "Instant",
    spelling: "instant",
    grammar: Noun(singular: "instant"),
    params: [],
    body: TypeDef(
        name: "Instant",
        permanent_type: false,
        confers: [
            Static(May(Cast(what: Ref(This), window: InstantSpeed))),
        ],
    ),
)
