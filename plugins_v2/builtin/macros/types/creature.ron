// Creature ([CR#300.1]) — a permanent with this type is a Combatant: the
// creature-like combat rules apply to it ([CR#120.3e,302.6,508.1a,509.1a]).
// The role is a quality of the object, not an ability of it ([CR#113.12]), so
// it is conferred ability-free.
Type(
    name: "creature",
    spelling: "creature",
    grammar: Noun(singular: "creature"),
    params: [],
    body: CardType(
        card_type: Creature,
        permanent_type: true,
        confers: [combatant],
    ),
)
