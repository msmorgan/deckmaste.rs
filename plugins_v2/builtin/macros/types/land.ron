// Land ([CR#300.1]) — its owner may play a land card from their hand during
// their main phase while the stack is empty ([CR#305.1]). Being playable is a
// quality of the object, not an ability of it ([CR#113.12]), so the play
// permission is conferred ability-free.
Type(
    name: "land",
    spelling: "land",
    grammar: Noun(singular: "land"),
    params: [],
    body: CardType(
        card_type: Land,
        permanent_type: true,
        confers: [playableFrom(yourHand, asSorcery)],
    ),
)
