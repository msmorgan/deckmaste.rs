KeywordAbility(
    name: "mentor",
    params: [],
    spelling: "mentor",
    grammar: FixedKeyword(
        surface: "mentor",
    ),
    // "Mentor" means "Whenever this creature attacks, put a +1/+1 counter on target
    // attacking creature with power less than this creature's power."
    // [CR#702.134a]
    body: [
        triggered(
            attacks(thisCreature),
            putCounters(
                1,
                p1p1Counter,
                target(
                    and([creature, attacking, compare([Stat(Power)], Less, powerOf(thisCreature))]),
                ),
            ),
        ),
    ],
)
