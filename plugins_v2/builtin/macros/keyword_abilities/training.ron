KeywordAbility(
    name: "training",
    params: [],
    spelling: "training",
    grammar: FixedKeyword(
        surface: "training",
    ),
    // "Training" means "Whenever this creature and at least one other creature with
    // power greater than this creature's power attack, put a +1/+1 counter on this
    // creature." [CR#702.149a]
    body: [
        triggered(
            attacks(
                and([
                    thisCreature,
                    counted(
                        atLeast(1),
                        and([
                            creature,
                            otherThan(thisCreature),
                            compare(Greater, powerOf(thisCreature), [Stat(Power)]),
                        ]),
                    ),
                ]),
            ),
            putCounters(1, p1p1Counter, thisCreature),
        ),
    ],
)
