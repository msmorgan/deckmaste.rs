KeywordAbility(
    name: "sunburst",
    params: [],
    spelling: "sunburst",
    grammar: FixedKeyword(
        surface: "sunburst",
    ),
    // "Sunburst" means "If this object is entering as a creature, ignoring any
    // type-changing effects that would affect it, it enters with a +1/+1 counter on it
    // for each color of mana spent to cast it. Otherwise, it enters with a charge
    // counter on it for each color of mana spent to cast it." [CR#702.44a]
    body: [
        static(
            onlyWhile(
                entersWithCounters(thisPermanent, colorsSpentToCast(thisSpell), p1p1Counter),
                matches(thisPermanent, creature),
            ),
        ),
        static(
            onlyWhile(
                entersWithCounters(thisPermanent, colorsSpentToCast(thisSpell), chargeCounter),
                not(matches(thisPermanent, creature)),
            ),
        ),
    ],
)
