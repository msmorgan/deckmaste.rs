KeywordAbility(
    name: "exalted",
    params: [],
    spelling: "exalted",
    grammar: FixedKeyword(
        surface: "exalted",
    ),
    // "Exalted" means "Whenever a creature you control attacks alone, that creature
    // gets +1/+1 until end of turn." [CR#702.83a] "Attacks alone" is the
    // intervening-if: exactly one creature is attacking [CR#702.83b,506.5].
    body: [
        triggeredIf(
            attacks(a(creatureYouControl)),
            compareAmt(countOf(and([creature, attacking])), Eq, 1),
            getsBoth(that(Creature), up(1), untilEndOfTurn),
        ),
    ],
)
