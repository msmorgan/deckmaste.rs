KeywordAbility(
    name: "exalted",
    params: [],
    spelling: "exalted",
    grammar: FixedKeyword(
        surface: "exalted",
    ),
    // "Exalted" means "Whenever a creature you control attacks alone, that creature
    // gets +1/+1 until end of turn." [CR#702.83a] "Attacks alone" is the
    // intervening-if: exactly one creature is attacking [CR#702.83b,506.5].
    body: Keyword(
        keyword: "Exalted",
        params: [],
        body: [
            Triggered(
                event: Combat(
                    relation: AttackerOf,
                    subject: Described(
                        determiner: A(Unmarked),
                        predicate: And(
                            conjuncts: [
                                HasType(Creature),
                                HasPossessor(axis: Controller, possessor: You),
                            ],
                        ),
                    ),
                    counterpart: None,
                ),
                alternatives: [],
                r#while: None,
                joins: [],
                timing: None,
                limit: None,
                intervening: CompareAmt(
                    subject: CountOf(
                        group: Described(
                            determiner: Bare,
                            predicate: And(
                                conjuncts: [
                                    HasType(Creature),
                                    InCombat(relation: AttackerOf, counterpart: None),
                                ],
                            ),
                        ),
                    ),
                    comparator: Eq,
                    bound: 1,
                ),
                instruction: Establish(
                    spec: Conjunction(
                        subject: None,
                        parts: [
                            Modification(
                                subject: Pro(
                                    reach: Word(Type(Creature)),
                                    plurality: One,
                                    window: Whole,
                                ),
                                stat: Power,
                                delta: Up(1),
                            ),
                            Modification(
                                subject: Pro(
                                    reach: Word(Type(Creature)),
                                    plurality: One,
                                    window: Whole,
                                ),
                                stat: Toughness,
                                delta: Up(1),
                            ),
                        ],
                    ),
                    duration: Until(EndOf(part: Turn, whose: None)),
                ),
            ),
        ],
    ),
)
