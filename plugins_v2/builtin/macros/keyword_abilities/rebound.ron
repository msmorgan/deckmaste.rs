KeywordAbility(
    name: "rebound",
    params: [],
    spelling: "rebound",
    grammar: FixedKeyword(
        surface: "rebound",
    ),
    // STOP. "Rebound" means "If this spell was cast from your hand, instead of putting
    // it into your graveyard as it resolves, exile it and, AT THE BEGINNING OF YOUR
    // NEXT UPKEEP, you may cast this card from exile without paying its mana cost."
    // [CR#702.88a] It is one static ability that creates a delayed triggered ability;
    // no `StaticSpec` creates one, and `Instruction::Delay` is an instruction that no
    // static clause carries outside a `Replacement`'s own replacement (the cause
    // Blitz and Dash share).
    body: Keyword(keyword: "Rebound", params: [], body: []),
)
