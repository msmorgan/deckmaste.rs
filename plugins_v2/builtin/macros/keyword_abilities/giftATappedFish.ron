KeywordAbility(
    name: "giftATappedFish",
    params: [],
    spelling: "gift a tapped Fish",
    grammar: FixedKeyword(
        surface: "gift a tapped Fish",
    ),
    // "Gift a tapped Fish" means the effect is "The chosen player creates a
    // tapped 1/1 blue Fish creature token." [CR#702.174f] It is gift itself,
    // labelled gift.
    label: gift,
    body: [
        gift(
            createObject(
                1,
                Token(
                    spec: written(creatureToken(1, 1, [Blue], [fish])),
                    riders: [EntersAs(Tapped)],
                ),
            ),
        ),
    ],
)
