KeywordAbility(
    name: "undaunted",
    params: [],
    spelling: "undaunted",
    grammar: FixedKeyword(
        surface: "undaunted",
    ),
    // "Undaunted" means "This spell costs {1} less to cast for each opponent you have."
    // [CR#702.125a]
    body: Keyword(
        keyword: "Undaunted",
        params: [],
        body: [
            Static(
                spec: CostShift(
                    subject: AsMarker(marker: Spell, subject: This),
                    shift: Less(
                        amount: Arith(
                            op: Times,
                            left: 1,
                            right: CountOf(
                                group: Described(determiner: Bare, predicate: Opponent),
                            ),
                        ),
                        floor: None,
                    ),
                ),
            ),
        ],
    ),
)
