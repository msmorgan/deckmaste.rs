KeywordAbility(
    name: "equip",
    params: [Cost],
    spelling: "equip",
    grammar: FixedKeyword(
        surface: "equip",
        participial_adjective: (bare_singular_use: true, surface: "equipped",),
    ),
    // "Equip [cost]" means "[Cost]: Attach this permanent to target creature you
    // control. Activate only as a sorcery." [CR#702.6a]
    body: [
        activated(Param(0), attach(thisPermanent, target(creatureYouControl)), asSorcery),
    ],
)
