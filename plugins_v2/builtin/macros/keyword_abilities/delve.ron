KeywordAbility(
    name: "delve",
    params: [],
    spelling: "delve",
    grammar: FixedKeyword(
        surface: "delve",
    ),
    // "Delve" means "For each generic mana in this spell's total cost, you may
    // exile a card from your graveyard rather than pay that mana." [CR#702.66a]
    // It is neither an additional nor an alternative cost [CR#702.66b].
    body: [
        static(
            paySubstitute(
                thisSpell,
                substitute(exile(a(cardIn(graveyardOf(you)))), [generic]),
            ),
        ),
    ],
)
