KeywordAbility(
    name: "tiered",
    params: [],
    spelling: "tiered",
    grammar: FixedKeyword(
        surface: "tiered",
    ),
    // "Tiered" means "Choose one. As an additional cost to cast this spell, pay
    // the cost associated with that mode." [CR#702.183a] The modes carry their
    // own costs [CR#700.2h]; the keyword sets how many are chosen.
    body: [static(modeChoice(setQuantity(exactly(1))))],
)
