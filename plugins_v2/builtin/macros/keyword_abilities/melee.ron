KeywordAbility(
    name: "melee",
    params: [],
    spelling: "melee",
    grammar: FixedKeyword(
        surface: "melee",
    ),
    // "Melee" means "Whenever this creature attacks, it gets +1/+1 until end of turn
    // for each opponent you attacked with a creature this combat." [CR#702.121a]
    body: [
        triggered(
            attacks(thisCreature),
            getsBoth(
                thisCreature,
                up(
                    times(
                        1,
                        eventCount(
                            attacksWith(you, gap(Player), a(creature)),
                            bare(opponent),
                            ThisCombat,
                        ),
                    ),
                ),
                untilEndOfTurn,
            ),
        ),
    ],
)
