KeywordAbility(
    name: "partner",
    params: [],
    spelling: "partner",
    grammar: FixedKeyword(
        surface: "partner",
    ),
    // STOP. "Partner" means "You may designate two legendary cards as your commander
    // rather than one if each of them has partner." [CR#702.124h] Partner abilities
    // "modify the rules for deck construction in the Commander variant and function
    // before the game begins" [CR#702.124a]; nothing in the grammar designates a
    // commander or speaks about the period before the game. `DeckCondition`
    // describes a deck's cards, not who commands it, and there is no predicate for a
    // commander (the second half of the cause Freerunning carries).
    body: Keyword(keyword: "Partner", params: [], body: []),
)
