KeywordAbility(
    name: "nightbound",
    params: [],
    spelling: "nightbound",
    grammar: FixedKeyword(
        surface: "nightbound",
    ),
    // "Nightbound" means "As it becomes day, if this permanent is back face up,
    // transform it" and "This permanent can't transform except due to its
    // nightbound ability." [CR#702.145e] Daybound's second and third abilities over
    // the other face; see `daybound.ron`.
    body: [
        static(
            asEvent(
                gameBecomes(day),
                doIf(matches(thisPermanent, currentFace(Back)), transform(thisPermanent)),
            ),
        ),
        static(cantExcept(transform, thisPermanent, ByKeyword(nightbound))),
    ],
)
