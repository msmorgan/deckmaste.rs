KeywordAbility(
    name: "offering",
    params: [Quality],
    spelling: "offering",
    grammar: FixedKeyword(
        surface: "offering",
    ),
    // STOP. "[Quality] offering" means "As an additional cost to cast this spell, you
    // may sacrifice a [quality] permanent. If you chose to pay the additional cost,
    // this spell's total cost is REDUCED BY THE SACRIFICED PERMANENT'S MANA COST, and
    // you may cast this spell any time you could cast an instant." [CR#702.48a]
    // Nothing links the reduction back to the permanent the first clause's cost
    // sacrificed — `Predicate::ExiledWith` is the only linked-reference predicate and
    // a `Reach::Stamped` pronoun cannot read out of a sibling clause's cost (the
    // cause Emerge and Harmonize share).
    body: Keyword(
        keyword: "Offering",
        params: [Quality(Param(0))],
        body: [],
    ),
)
