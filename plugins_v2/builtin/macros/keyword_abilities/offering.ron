KeywordAbility(
    name: "offering",
    params: [Quality],
    spelling: "<Param(0)> offering",
    keyword_syntax: (payload_order: BeforeHead),
    grammar: FixedKeyword(
        surface: "offering",
    ),
    // STOP (waits on: a paid-cost facet naming the object a cost acted on).
    // "[Quality] offering" means "As an additional cost to cast this
    // spell, you may sacrifice a [quality] permanent. If you chose to pay the additional
    // cost, this spell's total cost is reduced by the sacrificed permanent's mana cost, and
    // you may cast this spell any time you could cast an instant." [CR#702.48a] The
    // reduction must name the permanent the cost sacrificed, and no `PaidFacet` names the
    // object a paid cost acted on (the cause Emerge and Harmonize share).
)
