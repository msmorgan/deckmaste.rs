KeywordAbility(
    name: "outlast",
    params: [Cost],
    spelling: "outlast",
    grammar: FixedKeyword(
        surface: "outlast",
    ),
    // "Outlast [cost]" means "[Cost], {T}: Put a +1/+1 counter on this creature.
    // Activate only as a sorcery." [CR#702.107a]
    body: [
        activated(
            compound([Param(0), tapSymbol]),
            putCounters(1, p1p1Counter, thisCreature),
            asSorcery,
        ),
    ],
)
