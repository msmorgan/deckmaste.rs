KeywordAbility(
    name: "devour",
    params: [Amount],
    spelling: "devour <Param(0)>",
    grammar: FixedKeyword(
        surface: "devour",
        verb: (bare: "devour", frames: [Predicate([ObjectNounPhrase])]),
    ),
    // "Devour N" means "As this object enters, you may sacrifice any number of
    // creatures. This permanent enters with N +1/+1 counters on it for each creature
    // sacrificed this way." [CR#702.82a] It is devour [quality] N over creatures
    // [CR#702.82c], so the body is that general form (`devourQuality`), as
    // connive's is `conniveN(1)`. "It devoured" [CR#702.82b] is
    // `linkedObjects(ByKeyword(devour), OfAbility(devour), …)` (Skullmulcher).
    body: [devourQuality(creature, Param(0))],
)
