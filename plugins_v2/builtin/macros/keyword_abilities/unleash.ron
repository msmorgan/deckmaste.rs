KeywordAbility(
    name: "unleash",
    params: [],
    spelling: "unleash",
    grammar: FixedKeyword(
        surface: "unleash",
    ),
    // "Unleash" means "You may have this permanent enter with an additional +1/+1
    // counter on it" and "This permanent can't block as long as it has a +1/+1
    // counter on it." [CR#702.98a] The first is an Off-Stack Static as it enters.
    body: [
        static(
            asEvent(
                enters(thisPermanent),
                may(establish(entersWithAdditionalCounters(thisPermanent, 1, p1p1Counter))),
            ),
        ),
        static(
            onlyWhile(
                deonticRule(thisPermanent, Forbid, [Block], Agent, NoPatient, NoRider),
                matches(thisPermanent, hasCounters(p1p1Counter)),
            ),
        ),
    ],
)
