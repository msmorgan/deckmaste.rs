KeywordAbility(
    name: "eternalize",
    params: [Cost],
    spelling: "eternalize",
    grammar: FixedKeyword(
        surface: "eternalize",
    ),
    // "Eternalize [cost]" means "[Cost], Exile this card from your graveyard: Create
    // a token that's a copy of this card, except it's black, it's 4/4, it has no mana
    // cost, and it's a Zombie in addition to its other types. Activate only as a
    // sorcery." [CR#702.129a]
    body: Keyword(
        keyword: "Eternalize",
        params: [Cost(cost: Param(0))],
        body: [
            Activated(
                cost: Compound(
                    costs: [
                        Param(0),
                        Perform(
                            instruction: Enact(
                                verb: Action(label: "Exile"),
                                instruction: Move(
                                    subject: This,
                                    to: Zone(zone: Exile, scope: Bare),
                                    riders: [],
                                ),
                                agent: You,
                            ),
                        ),
                    ],
                ),
                instruction: CreateObject(
                    count: 1,
                    spec: Token(
                        spec: CopyOf(
                            source: This,
                            exceptions: [
                                Edits(
                                    edits: [
                                        Colors(op: Sets, colors: r#Some(colors: [Black])),
                                        Stat(op: Sets, axis: Power, amount: 4),
                                        Stat(op: Sets, axis: Toughness, amount: 4),
                                        ManaCost(cost: None),
                                        TypeLine(
                                            op: Adds,
                                            changes: (subtypes: [Of(host: Creature, label: "Zombie")]),
                                        ),
                                    ],
                                ),
                            ],
                        ),
                        riders: [],
                    ),
                    agent: You,
                ),
                timing: AsSorcery,
                limit: None,
                guard: None,
                activator: None,
            ),
        ],
    ),
)
