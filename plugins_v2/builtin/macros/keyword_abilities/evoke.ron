KeywordAbility(
    name: "evoke",
    params: [Cost],
    spelling: "evoke",
    grammar: FixedKeyword(
        surface: "evoke",
    ),
    // "Evoke [cost]" means "You may cast this card by paying [cost] rather than paying
    // its mana cost" and "When this permanent enters, if its evoke cost was paid, its
    // controller sacrifices it." [CR#702.74a]
    body: [
        static(mayCastFor(you, Param(0))),
        triggeredIf(
            enters(thisPermanent),
            keywordCostPaid("Evoke", thisPermanent),
            act(controllerOf(thisPermanent), sacrifice(thisPermanent)),
        ),
    ],
)
