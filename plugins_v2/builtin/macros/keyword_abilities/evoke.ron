KeywordAbility(
    name: "evoke",
    params: [Cost],
    spelling: "evoke",
    grammar: FixedKeyword(
        surface: "evoke",
    ),
    // "Evoke [cost]" means "You may cast this card by paying [cost] rather than paying
    // its mana cost" and "When this permanent enters, if its evoke cost was paid, its
    // controller sacrifices it." [CR#702.74a]
    body: Keyword(
        keyword: "Evoke",
        params: [Cost(cost: Param(0))],
        body: [
            Static(
                spec: DeonticRule(
                    subject: You,
                    compulsion: Permit,
                    deeds: [Action(label: "Cast")],
                    role: Agent,
                    bound: None,
                    patient: Counterpart(patient: This),
                    as_though: None,
                    rider: Play(
                        from: None,
                        limit: None,
                        timing: None,
                        exclusive: false,
                        payment: PayingInstead(cost: Param(0)),
                    ),
                ),
            ),
            Triggered(
                event: ZoneChange(
                    subject: AsMarker(marker: Permanent, subject: This),
                    from: None,
                    to: Zone(zone: Battlefield, scope: Bare),
                    observation: After,
                ),
                alternatives: [],
                r#while: None,
                joins: [],
                timing: None,
                limit: None,
                intervening: CompareAmt(
                    subject: Paid(
                        facet: Readback(which: ByKeyword(keyword: "Evoke"), lookback: None),
                        subject: AsMarker(marker: Permanent, subject: This),
                    ),
                    comparator: AtLeast,
                    bound: 1,
                ),
                instruction: Enact(
                    verb: Action(label: "Sacrifice"),
                    instruction: Move(
                        subject: AsMarker(marker: Permanent, subject: This),
                        to: Zone(zone: Graveyard, scope: Bare),
                        riders: [],
                    ),
                    agent: PossessorOf(
                        axis: Controller,
                        subject: AsMarker(marker: Permanent, subject: This),
                    ),
                ),
            ),
        ],
    ),
)
