KeywordAbility(
    name: "splice",
    params: [Quality, Cost],
    spelling: "splice onto <Param(0)> <Param(1)>",
    grammar: FixedKeyword(
        surface: "splice",
        parameter: Quality(preposition: ("Preposition", "Onto")),
    ),
    // "Splice onto [quality] [cost]" means "You may reveal this card from your
    // hand as you cast a [quality] spell. If you do, that spell gains the text
    // of this card's rules text and you pay [cost] as an additional cost to
    // cast that spell." [CR#702.47a] The reveal is a step of casting that spell
    // [CR#601.2b], which it does not replace; the cards spliced onto one spell are
    // revealed at once, and their text follows the main spell's in the order chosen
    // [CR#702.47b,702.47c,612.10].
    body: [
        static(
            revealedAsCast(
                a(and([spell, Param(0)])),
                conjunction(None, [
                    addedCost(Param(1), false),
                    textChange(that(Spell), appendTextOf(this)),
                ]),
            ),
        ),
    ],
)
