KeywordAbility(
    name: "splice",
    params: [Quality, Cost],
    spelling: "splice onto <Param(0)> <Param(1)>",
    grammar: FixedKeyword(
        surface: "splice",
        parameter: Quality(preposition: ("Preposition", "Onto")),
    ),
    // "Splice onto [quality] [cost]" means "You may reveal this card from your
    // hand as you cast a [quality] spell. If you do, that spell gains the text
    // of this card's rules text and you pay [cost] as an additional cost to
    // cast that spell." [CR#702.47a] The gained text is a Text Change that
    // follows the spell's own [CR#702.47c,612.10]. "As you cast" is written as
    // the replacement of the cast that Deadpool's "as this enters" is.
    body: [
        static(
            replacement(
                casts(you, a(and([spell, Param(0)]))),
                may(
                    revealCards(this),
                    establish(
                        conjunction(None, [
                            addedCost(Param(1), false),
                            textChange(that(Spell), appendTextOf(this)),
                        ]),
                    ),
                ),
                Repeatedly,
            ),
        ),
    ],
)
