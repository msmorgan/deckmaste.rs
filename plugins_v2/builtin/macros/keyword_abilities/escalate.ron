KeywordAbility(
    name: "escalate",
    params: [Cost],
    spelling: "escalate <Param(0)>",
    grammar: FixedKeyword(
        surface: "escalate",
    ),
    // "Escalate [cost]" means "For each mode you choose beyond the first as you
    // cast this spell, you pay an additional [cost]" [CR#702.120a]. A Mode
    // Change over the spell's own `chooseModes`; the number of payments reads
    // `timesPaid(ByKeyword(escalate), …)`.
    body: [static(modeChoice(extraModesCost(Param(0))))],
)
