KeywordAbility(
    name: "escalate",
    params: [Cost],
    spelling: "escalate <Param(0)>",
    grammar: FixedKeyword(
        surface: "escalate",
    ),
    // STOP (waits on: a static that sets or charges for a modal spell's mode choice).
    // "Escalate [cost]" means "For each mode you choose beyond the
    // first as you cast this spell, you pay an additional [cost]" [CR#702.120a].
    // `addedCost` now takes a `PayTimes` (`Once`, `AnyNumberOfTimes`, `UpTo`), but escalate's
    // count is fixed by the modes chosen on the spell's own `ChooseModes`, which no
    // `PayTimes` or `Amount` reads.
)
