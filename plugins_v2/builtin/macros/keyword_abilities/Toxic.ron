KeywordAbility(
    name: "Toxic",
    params: [Amount],
    spelling: "toxic",
    grammar: FixedKeyword(
        surface: "toxic",
    ),
    // STOP. "Toxic is a static ability… written 'toxic N'" [CR#702.164a] and the entry
    // quotes no expansion: it states that combat damage dealt to a player by a creature
    // with toxic causes that creature's controller to give the player poison counters
    // equal to its total toxic value, IN ADDITION TO THE DAMAGE'S OTHER RESULTS
    // [CR#702.164c,120.3]. That is a substitution on the RESULT of damage, which this
    // plugin models in its `rules/damage` table (`DamageResultRule`);
    // `StaticSpec::DamageRule` only prevents, redirects or scales (the cause Infect
    // carries). Poisonous, which the CR does spell out as a triggered ability
    // [CR#702.70a], is written; toxic is not that shape.
    body: Keyword(keyword: "Toxic", params: [Number(amount: Param(0))], body: []),
)
