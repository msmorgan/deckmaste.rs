    body: Keyword(
        keyword: "Ingest",
        params: [],
        body: [
            Triggered(
                event: Damage(
                    kind: CombatOnly,
                    source: AsType(type: Creature, subject: This, subtype: None),
                    patient: Described(determiner: A(Unmarked), predicate: AnyPlayer),
                ),
                alternatives: [],
                r#while: None,
                joins: [],
                timing: None,
                limit: None,
                intervening: None,
                instruction: Enact(
                    verb: Action("Exile"),
                    instruction: Move(
                        subject: LibrarySlice(
                            end: Top,
                            amount: 1,
                            whose: Pro(reach: Word(Player), plurality: One, window: Whole),
                        ),
                        to: Zone(zone: Exile, scope: Bare),
                        riders: [],
                    ),
                    agent: Pro(reach: Word(Player), plurality: One, window: Whole),
                ),
            ),
        ],
    ),
)
