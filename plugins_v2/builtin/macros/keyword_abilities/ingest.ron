KeywordAbility(
    name: "ingest",
    params: [],
    spelling: "ingest",
    grammar: FixedKeyword(
        surface: "ingest",
    ),
    // "Ingest" means "Whenever this creature deals combat damage to a player, that
    // player exiles the top card of their library." [CR#702.115a]
    body: [
        triggered(
            dealsCombatDamage(thisCreature, a(anyPlayer)),
            exileBy(they, librarySlice(Top, 1, they)),
        ),
    ],
)
