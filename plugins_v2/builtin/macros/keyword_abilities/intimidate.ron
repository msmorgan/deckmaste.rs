KeywordAbility(
    name: "intimidate",
    params: [],
    spelling: "intimidate",
    grammar: FixedKeyword(
        surface: "intimidate",
    ),
    // "A creature with intimidate can't be blocked except by artifact creatures
    // and/or creatures that share a color with it." [CR#702.13b] Written as the
    // negated predicate fear uses until `semantics-v2-off-stack-statics` gives
    // the deontic rule its `except` slot.
    body: [
        static(cantBeBlockedBy(thisCreature, and([creature, not(or([artifact, shares(Color, Share, thisCreature)]))]))),
    ],
)
