KeywordAbility(
    name: "intimidate",
    params: [],
    spelling: "intimidate",
    grammar: FixedKeyword(
        surface: "intimidate",
    ),
    // "A creature with intimidate can't be blocked except by artifact creatures
    // and/or creatures that share a color with it." [CR#702.13b] The exempt
    // blockers are the prohibition's Deontic Exception, as fear's are.
    body: [
        static(cantBeBlockedExceptBy(thisCreature, and([creature, or([artifact, shares(Color, Share, thisCreature)])]))),
    ],
)
