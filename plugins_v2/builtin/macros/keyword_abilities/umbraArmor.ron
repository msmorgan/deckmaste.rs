KeywordAbility(
    name: "umbraArmor",
    params: [],
    spelling: "umbra armor",
    grammar: FixedKeyword(
        surface: "umbra armor",
    ),
    // "Umbra armor" means "If enchanted permanent would be destroyed, instead remove
    // all damage marked on it and destroy this Aura." [CR#702.89a]
    body: [
        static(
            insteadOf(
                verbedEvent(verb: Action("Destroy"), patient: attachHost(Enchanted, Permanent)),
                sequentially([clearDamage(attachHost(Enchanted, Permanent)), destroy(thisAura)]),
            ),
        ),
    ],
)
