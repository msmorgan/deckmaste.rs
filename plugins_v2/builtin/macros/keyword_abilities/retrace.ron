KeywordAbility(
    name: "retrace",
    params: [],
    spelling: "retrace",
    grammar: FixedKeyword(
        surface: "retrace",
    ),
    // "Retrace" means "You may cast this card from your graveyard by discarding a land
    // card as an additional cost to cast it." [CR#702.81a] The additional cost rides
    // on the permitted cast itself, as `Cost::ItsManaCost` alongside the discard.
    body: [
        static(
            mayCastFor(
                you,
                compound([
                    itsManaCost,
                    perform(discard(a(and([isCard, land, inZone(yourHand)])))),
                ]),
                graveyardOf(you),
            ),
        ),
    ],
)
