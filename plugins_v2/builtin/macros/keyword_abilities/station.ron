KeywordAbility(
    name: "station",
    params: [],
    spelling: "station",
    grammar: FixedKeyword(
        surface: "station",
    ),
    // "Station" means "Tap another untapped creature you control: Put a number of
    // charge counters on this permanent equal to the tapped creature's power.
    // Activate only as a sorcery." [CR#702.184a]
    body: [
        activated(
            perform(
                enact(
                    Action("Tap"),
                    setStatus(
                        Tapped,
                        a(and([creature, otherThan(thisPermanent), untapped, youControl])),
                    ),
                ),
            ),
            putCounters(
                powerOf(theVerbed(Action("Tap"), Creature, Attributive, One)),
                chargeCounter,
                thisPermanent,
            ),
            asSorcery,
        ),
    ],
)
