                                determiner: A(Unmarked),
                                predicate: And(
                                    conjuncts: [
                                        IsCard,
                                        HasSubtype(
                                            subtype: Of(host: Enchantment, label: "Aura"),
                                        ),
                                        InZone(
                                            zone: Zone(
                                                zone: Hand,
                                                scope: PossessedBy(You),
                                            ),
                                        ),
                                    ],
                                ),
                            ),
                        ),
                    ),
                    if_did: None,
                    if_not: None,
                ),
                timing: None,
                limit: None,
                guard: None,
                activator: None,
            ),
        ],
