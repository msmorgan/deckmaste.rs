KeywordAbility(
    name: "auraSwap",
    params: [Cost],
    spelling: "aura swap",
    grammar: FixedKeyword(
        surface: "aura swap",
    ),
    // "Aura swap [cost]" means "[Cost]: You may exchange this permanent with an
    // Aura card in your hand." [CR#702.65a]
    body: [
        activated(
            Param(0),
            may(
                Exchange(
                    CardsAcross(
                        thisPermanent,
                        a(and([isCard, hasSubtype(aura), inZone(yourHand)])),
                    ),
                ),
            ),
        ),
    ],
)
