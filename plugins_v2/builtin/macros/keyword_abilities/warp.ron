KeywordAbility(
    name: "warp",
    params: [Cost],
    spelling: "warp <Param(0)>",
    grammar: FixedKeyword(
        surface: "warp",
        participial_adjective: (),
    ),
    // "Warp [cost]" means "You may cast this card from your hand by paying [cost]
    // rather than its mana cost" and "If this spell's warp cost was paid, exile the
    // permanent this spell becomes at the beginning of the next end step. Its owner
    // may cast this card after the current turn has ended for as long as it remains
    // exiled." [CR#702.185a] The second creates its delayed trigger as the
    // permanent is put onto the battlefield as the spell resolves
    // [CR#608.3g,603.7d], as blitz's is: an Off-Stack Static on that entry,
    // guarded by the warp cost having been paid, naming the permanent directly.
    // "After the current turn has ended" is `onALaterTurn`, read as the delayed
    // trigger resolves, and "as long as it remains exiled" is the permission's
    // zone.
    body: [
        static(mayCastFor(you, Param(0), yourHand)),
        static(
            asEvent(
                enters(thisPermanent, Zones([stack])),
                doIf(
                    keywordCostPaid(warp, thisPermanent),
                    atNext(
                        EndStep,
                        sequentially([
                            exile(thisPermanent),
                            establish(
                                mayPlayDeed(cast, ownerOf(it), it, Play(exileZone, None, None, false, ItsOwnCost, None)),
                                onALaterTurn,
                            ),
                        ]),
                    ),
                ),
            ),
        ),
    ],
)
