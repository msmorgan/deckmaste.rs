KeywordAbility(
    name: "warp",
    params: [Cost],
    spelling: "warp <Param(0)>",
    grammar: FixedKeyword(
        surface: "warp",
    ),
    // "Warp [cost]" means "You may cast this card from your hand by paying [cost]
    // rather than its mana cost" and "If this spell's warp cost was paid, exile the
    // permanent this spell becomes at the beginning of the next end step. Its owner
    // may cast this card after the current turn has ended for as long as it remains
    // exiled." [CR#702.185a] The second is an Off-Stack Static on paying the cost
    // that creates a delayed trigger over the spell's successor (`becomes`)
    // [CR#603.7g]; "after the current turn has ended" is `onALaterTurn`, read as
    // the delayed trigger resolves, and "as long as it remains exiled" is the
    // permission's zone.
    body: [
        static(mayCastFor(you, Param(0), yourHand)),
        static(
            asEvent(
                paysCost(Paid, thisSpell, warp, you),
                atNext(
                    EndStep,
                    sequentially([
                        exile(becomes(thisSpell)),
                        establish(
                            mayPlayDeed(cast, ownerOf(it), it, Play(exileZone, None, None, false, ItsOwnCost)),
                            onALaterTurn,
                        ),
                    ]),
                ),
            ),
        ),
    ],
)
