KeywordAbility(
    name: "infinity",
    params: [Ability],
    spelling: "∞ — <Param(0)>",
    keyword_syntax: (head_separator: SpacedDash),
    grammar: FixedKeyword(
        surface: "∞",
        onset: Vowel,
    ),
    // "∞ — [Ability]" means "As long as this permanent is harnessed, it has
    // [ability]." [CR#702.186b]
    body: [
        static(
            onlyWhile(
                abilityGrant(thisPermanent, Param(0)),
                matches(thisPermanent, hasDesignation(harnessed)),
            ),
        ),
    ],
)
