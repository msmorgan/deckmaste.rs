KeywordAbility(
    name: "rampage",
    params: [Amount],
    spelling: "rampage",
    grammar: FixedKeyword(
        surface: "rampage",
    ),
    // "Rampage N" means "Whenever this creature becomes blocked, it gets +N/+N until
    // end of turn for each creature blocking it beyond the first." [CR#702.23a]
    body: [
        triggered(
            becomesBlocked(thisCreature),
            gets(
                thisCreature,
                up(
                    times(
                        Param(0),
                        minus(countOf(and([creature, inCombat(BlockerOf, thisCreature)])), 1),
                    ),
                ),
                up(
                    times(
                        Param(0),
                        minus(countOf(and([creature, inCombat(BlockerOf, thisCreature)])), 1),
                    ),
                ),
                untilEndOfTurn,
            ),
        ),
    ],
)
