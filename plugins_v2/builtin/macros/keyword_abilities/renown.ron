KeywordAbility(
    name: "renown",
    params: [Amount],
    spelling: "renown",
    grammar: FixedKeyword(
        surface: "renown",
    ),
    // "Renown N" means "When this creature deals combat damage to a player, if it isn't
    // renowned, put N +1/+1 counters on it and it becomes renowned." [CR#702.112a]
    // `lean/Semantics/Macros.lean`'s `renownExpansion` is the reference.
    body: [
        triggeredIf(
            dealsCombatDamage(thisCreature, a(anyPlayer)),
            not(matches(thisCreature, hasDesignation(Named(name: "renowned")))),
            sequentially([
                putCounters(Param(0), p1p1Counter, thisCreature),
                gainDesignation(thisCreature, Named(name: "renowned")),
            ]),
        ),
    ],
)
