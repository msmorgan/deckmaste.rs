KeywordAbility(
    name: "renown",
    params: [Amount],
    spelling: "renown",
    grammar: FixedKeyword(
        surface: "renown",
    ),
    // "Renown N" means "When this creature deals combat damage to a player, if it isn't
    // renowned, put N +1/+1 counters on it and it becomes renowned." [CR#702.112a]
    // `lean/Semantics/Macros.lean`'s `renownExpansion` is the reference.
    body: Keyword(
        keyword: "Renown",
        params: [Number(amount: Param(0))],
        body: [
            Triggered(
                event: Damage(
                    kind: CombatOnly,
                    source: AsType(type: Creature, subject: This, subtype: None),
                    patient: Described(determiner: A(mode: Unmarked), predicate: AnyPlayer),
                ),
                alternatives: [],
                r#while: None,
                joins: [],
                timing: None,
                limit: None,
                intervening: Not(
                    condition: Matches(
                        subject: AsType(type: Creature, subject: This, subtype: None),
                        predicate: HasDesignation(designation: "renowned", holder: None),
                    ),
                ),
                instruction: Sequentially(
                    steps: [
                        PutCounters(
                            amount: Param(0),
                            kind: Printed(kind: Boost(power: Up(amount: 1), toughness: Up(amount: 1))),
                            on: AsType(type: Creature, subject: This, subtype: None),
                        ),
                        GainDesignation(
                            subject: AsType(type: Creature, subject: This, subtype: None),
                            designation: "renowned",
                            duration: None,
                        ),
                    ],
                ),
            ),
        ],
    ),
)
