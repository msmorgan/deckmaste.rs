KeywordAbility(
    name: "indestructible",
    params: [],
    spelling: "indestructible",
    grammar: FixedKeyword(
        surface: "indestructible",
    ),
    // "A permanent with indestructible can't be destroyed." [CR#702.12b] What is
    // destroyed is a permanent [CR#701.8a], so the rule names this permanent in the
    // deed's patient role.
    body: [
        static(objectCant(destroy, thisPermanent)),
    ],
)
