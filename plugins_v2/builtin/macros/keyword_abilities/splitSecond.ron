KeywordAbility(
    name: "splitSecond",
    params: [],
    spelling: "split second",
    grammar: FixedKeyword(
        surface: "split second",
    ),
    // "Split second" means "As long as this spell is on the stack, players can't cast
    // other spells or activate abilities that aren't mana abilities." [CR#702.61a]
    // One prohibition over two deeds, each with its own patient, is
    // `DeonticPatient::CounterpartsAt`.
    body: Keyword(
        keyword: "SplitSecond",
        params: [],
        body: [
            Static(
                spec: Conditional(
                    spec: DeonticRule(
                        subject: Described(determiner: All, predicate: AnyPlayer),
                        compulsion: Forbid,
                        deeds: [Action(label: "Cast"), Action(label: "Activate")],
                        role: Agent,
                        bound: None,
                        patient: CounterpartsAt(
                            complements: [
                                (
                                    deed: Action(label: "Cast"),
                                    counterpart: Described(
                                        determiner: All,
                                        predicate: And(
                                            conjuncts: [
                                                InZone(zone: Zone(zone: Stack, scope: Bare)),
                                                Not(predicate: AbilityHead(class: AnyOnStack)),
                                                OtherThan(
                                                    anchor: AsMarker(
                                                        marker: Spell,
                                                        subject: This,
                                                    ),
                                                ),
                                            ],
                                        ),
                                    ),
                                ),
                                (
                                    deed: Action(label: "Activate"),
                                    counterpart: Described(
                                        determiner: All,
                                        predicate: And(
                                            conjuncts: [
                                                AbilityHead(class: AnyActivated),
                                                Not(predicate: IsManaAbility),
                                            ],
                                        ),
                                    ),
                                ),
                            ],
                        ),
                        as_though: None,
                        rider: NoRider,
                    ),
                    condition: Matches(
                        subject: AsMarker(marker: Spell, subject: This),
                        predicate: InZone(zone: Zone(zone: Stack, scope: Bare)),
                    ),
                    marking: AsLongAs,
                ),
            ),
        ],
    ),
)
