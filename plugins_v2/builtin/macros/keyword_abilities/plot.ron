KeywordAbility(
    name: "plot",
    params: [Cost],
    spelling: "plot <Param(0)>",
    grammar: FixedKeyword(
        surface: "plot",
    ),
    // "Plot [cost]" means "Any time you have priority during your main phase while the
    // stack is empty, you may exile this card from your hand and pay [cost]. It becomes a
    // plotted card." [CR#702.170a] Exiling it is a special action [CR#702.170b,116.2k];
    // its owner may cast it from exile without paying its mana cost during their main
    // phase while the stack is empty on any later turn [CR#702.170d]. The "plotted"
    // designation itself is not written: nothing in the registry reads it yet.
    body: [
        static(
            specialAction(
                asSorcery,
                Param(0),
                sequentially([
                    exile(this),
                    establish(
                        mayPlayDeed(cast, you, it, Play(exileZone, None, asSorcery, false, WithoutPaying)),
                        onALaterTurn,
                    ),
                ]),
            ),
        ),
    ],
)
