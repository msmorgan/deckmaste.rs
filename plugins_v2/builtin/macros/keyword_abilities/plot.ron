KeywordAbility(
    name: "plot",
    params: [Cost],
    spelling: "plot <Param(0)>",
    grammar: FixedKeyword(
        surface: "plot",
        participial_adjective: (surface: "plotted"),
    ),
    // "Plot [cost]" means "Any time you have priority during your main phase while the
    // stack is empty, you may exile this card from your hand and pay [cost]. It becomes a
    // plotted card." [CR#702.170a] Exiling it is a special action [CR#702.170b,116.2k]
    // that names the hand, so the ability functions only there [CR#113.6m]; its becoming
    // plotted is a separate event. The right to cast it is not plot's text: it is a rule
    // for every plotted card, with or without plot [CR#702.170d].
    body: [
        static(
            specialAction(
                asSorcery,
                Param(0),
                sequentially([
                    exileFrom(this, yourHand),
                    gainDesignation(it, plotted),
                ]),
            ),
        ),
    ],
)
