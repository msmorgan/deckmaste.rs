KeywordAbility(
    name: "plot",
    params: [Cost],
    spelling: "plot",
    grammar: FixedKeyword(
        surface: "plot",
    ),
    // STOP. "Plot [cost]" means "Any time you have priority during your main phase
    // while the stack is empty, you may exile this card from your hand and pay
    // [cost]. It becomes a plotted card." [CR#702.170a] Exiling a card this way is a
    // SPECIAL ACTION [CR#702.170b]; no instruction or static performs one (the cause
    // Companion and Foretell share), and nothing names a plotted card.
    body: Keyword(keyword: "Plot", params: [Cost(cost: Param(0))], body: []),
)
