KeywordAbility(
    name: "saddle",
    params: [Amount],
    spelling: "saddle <Param(0)>",
    grammar: FixedKeyword(
        surface: "saddle",
    ),
    // "Saddle N" means "Tap any number of other untapped creatures you control with
    // total power N or greater: This permanent becomes saddled until end of turn.
    // Activate only as a sorcery." [CR#702.171a] Saddled lasts until end of turn by
    // its own definition [CR#702.171b].
    body: [
        activated(
            perform(
                tap(
                    withTotal(
                        Stat(Power),
                        AtLeast,
                        Param(0),
                        allOf(and([untapped, otherCreatureYouControl(thisPermanent)])),
                    ),
                ),
            ),
            gainDesignation(thisPermanent, saddled, untilEndOfTurn),
            asSorcery,
        ),
    ],
)
