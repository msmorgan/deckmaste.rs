KeywordAbility(
    name: "escape",
    params: [Cost],
    spelling: "escape",
    grammar: FixedKeyword(
        surface: "escape",
    ),
    // "Escape [cost]" means "You may cast this card from your graveyard by paying
    // [cost] rather than paying its mana cost." [CR#702.138a]
    body: [
        static(mayCastFor(you, Param(0), graveyardOf(you))),
    ],
)
