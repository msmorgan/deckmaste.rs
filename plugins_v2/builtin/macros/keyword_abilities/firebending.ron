KeywordAbility(
    name: "firebending",
    params: [Amount],
    spelling: "firebending",
    grammar: FixedKeyword(
        surface: "firebending",
    ),
    // "Firebending N" means "Whenever this creature attacks, add N {R}. Until end of
    // combat, you don't lose this mana as steps and phases end." [CR#702.189a]
    body: [
        triggered(
            attacks(thisCreature),
            sequentially([
                addMana(Param(0), Runs([[Red]])),
                establish(manaRetention(you, ThisMana), untilEndOfCombat),
            ]),
        ),
    ],
)
