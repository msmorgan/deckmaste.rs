KeywordAbility(
    name: "poisonous",
    params: [Amount],
    spelling: "poisonous",
    grammar: FixedKeyword(
        surface: "poisonous",
    ),
    // "Poisonous N" means "Whenever this creature deals combat damage to a player,
    // that player gets N poison counters." [CR#702.70a]
    body: Keyword(
        keyword: "Poisonous",
        params: [Number(Param(0))],
        body: [
            Triggered(
                event: Damage(
                    kind: CombatOnly,
                    source: AsType(type: Creature, subject: This, subtype: None),
                    patient: Described(determiner: A(Unmarked), predicate: AnyPlayer),
                ),
                alternatives: [],
                r#while: None,
                joins: [],
                timing: None,
                limit: None,
                intervening: None,
                instruction: PutCounters(
                    amount: Param(0),
                    kind: Printed(Named("Poison")),
                    on: Pro(reach: Word(Player), plurality: One, window: Whole),
                ),
            ),
        ],
    ),
)
