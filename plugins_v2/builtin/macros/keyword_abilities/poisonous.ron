KeywordAbility(
    name: "poisonous",
    params: [Amount],
    spelling: "poisonous",
    grammar: FixedKeyword(
        surface: "poisonous",
    ),
    // "Poisonous N" means "Whenever this creature deals combat damage to a player,
    // that player gets N poison counters." [CR#702.70a]
    body: [
        triggered(
            dealsCombatDamage(thisCreature, a(anyPlayer)),
            putCounters(Param(0), poison, they),
        ),
    ],
)
