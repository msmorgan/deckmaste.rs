KeywordAbility(
    name: "improvise",
    params: [],
    spelling: "improvise",
    grammar: FixedKeyword(
        surface: "improvise",
    ),
    // "Improvise" means "For each generic mana in this spell's total cost, you may
    // tap an untapped artifact you control rather than pay that mana."
    // [CR#702.126a] It is neither an additional nor an alternative cost
    // [CR#702.126b].
    body: [
        static(
            paySubstitute(
                thisSpell,
                substitute(tap(a(and([untapped, artifact, youControl]))), [generic]),
            ),
        ),
    ],
)
