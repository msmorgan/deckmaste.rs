KeywordAbility(
    name: "spectacle",
    params: [Cost],
    spelling: "spectacle",
    grammar: FixedKeyword(
        surface: "spectacle",
    ),
    // "Spectacle [cost]" means "You may pay [cost] rather than pay this spell's mana
    // cost if an opponent lost life this turn." [CR#702.137a]
    body: [
        static(
            onlyWhile(
                mayCastFor(you, Param(0)),
                happened(lifeChanges(gap(Player), Down), anOpponent, ThisTurn),
            ),
        ),
    ],
)
