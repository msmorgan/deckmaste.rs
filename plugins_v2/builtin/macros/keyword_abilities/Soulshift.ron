KeywordAbility(
    name: "Soulshift",
    params: [Amount],
    spelling: "soulshift",
    grammar: FixedKeyword(
        surface: "soulshift",
    ),
    // "Soulshift N" means "When this permanent is put into a graveyard from the
    // battlefield, you may return target Spirit card with mana value N or less from
    // your graveyard to your hand." [CR#702.46a]
    body: Keyword(
        keyword: "Soulshift",
        params: [Number(amount: Param(0))],
        body: [
            Triggered(
                event: ZoneChange(
                    subject: AsMarker(marker: Permanent, subject: This),
                    from: Zones(zones: [Zone(zone: Battlefield, scope: Bare)]),
                    to: Zone(zone: Graveyard, scope: Bare),
                    observation: Before,
                ),
                alternatives: [],
                r#while: None,
                joins: [],
                timing: None,
                limit: None,
                intervening: None,
                instruction: WithContinuation(
                    policy: Optional(agent: You),
                    body: Enact(
                        verb: Core(deed: Return),
                        instruction: Move(
                            subject: Described(
                                determiner: Target(quantity: Range(low: 1, high: 1)),
                                predicate: And(
                                    conjuncts: [
                                        IsCard,
                                        HasSubtype(subtype: Of(host: Creature, label: "Spirit")),
                                        Compare(
                                            axes: [Stat(stat: ManaValue)],
                                            comparator: AtMost,
                                            bound: Param(0),
                                        ),
                                        InZone(
                                            zone: Zone(
                                                zone: Graveyard,
                                                scope: PossessedBy(possessor: You),
                                            ),
                                        ),
                                    ],
                                ),
                            ),
                            to: Zone(zone: Hand, scope: Bare),
                            riders: [],
                        ),
                        agent: You,
                    ),
                    if_did: None,
                    if_not: None,
                ),
            ),
        ],
    ),
)
