KeywordAbility(
    name: "replicate",
    params: [Cost],
    spelling: "replicate <Param(0)>",
    grammar: FixedKeyword(
        surface: "replicate",
    ),
    // "Replicate [cost]" means "As an additional cost to cast this spell, you
    // may pay [cost] any number of times" and "When you cast this spell, if a
    // replicate cost was paid for it, copy it for each time its replicate cost
    // was paid. If the spell has any targets, you may choose new targets for
    // any of the copies." [CR#702.56a] The cost carries its repetition, as
    // squad's does, and `timesPaid` counts its payments.
    // The target guard is not written: writing "if the spell has any targets"
    // would need a new constructor, and the guard is inert, since a player who
    // may choose new targets may leave every one unchanged [CR#707.10c]
    // (`semantics-v2.md` §7, ruling 2026-10-09).
    body: [
        static(addedCost(Param(0), true, AnyNumberOfTimes)),
        triggeredIf(
            casts(you, thisSpell),
            keywordCostPaid(replicate, thisSpell),
            sequentially([
                copySpell(thisSpell, timesPaid(ByKeyword(replicate), thisSpell)),
                may(chooseNewTargets(those(Copy))),
            ]),
        ),
    ],
)
