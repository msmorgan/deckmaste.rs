KeywordAbility(
    name: "prowess",
    params: [],
    spelling: "prowess",
    grammar: FixedKeyword(
        surface: "prowess",
    ),
    // "Prowess" means "Whenever you cast a noncreature spell, this creature gets
    // +1/+1 until end of turn." [CR#702.108a]
    body: [
        triggered(
            casts(you, a(and([inZone(stack), not(creature)]))),
            getsBoth(thisCreature, up(1), untilEndOfTurn),
        ),
    ],
)
