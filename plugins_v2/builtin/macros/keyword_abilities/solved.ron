KeywordAbility(
    name: "solved",
    params: [Ability],
    spelling: "solved — <Param(0)>",
    keyword_syntax: (head_separator: SpacedDash),
    grammar: FixedKeyword(
        surface: "solved",
    ),
    // "Solved — [Ability text]" is a static, triggered or activated ability
    // [CR#702.169a], restricted by the one guard: "as long as this Case is
    // solved" for a static ability, "this ability triggers only if this Case
    // is solved" for a triggered one, "activate only if this Case is solved"
    // for an activated one [CR#702.169b..702.169d].
    body: [qualified(ability: Param(0), guard: matches(thisCase, hasDesignation(solved)))],
)
