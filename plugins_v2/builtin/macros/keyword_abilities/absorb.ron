KeywordAbility(
    name: "absorb",
    params: [Amount],
    spelling: "absorb",
    grammar: FixedKeyword(
        surface: "absorb",
    ),
    // "Absorb N" means "If a source would deal damage to this creature, prevent
    // N of that damage." [CR#702.64a] The prevention cut is `PreventCut::Some`,
    // written `r#Some` because RON's implicit-some extension claims the bare
    // spelling for `Option`.
    body: Keyword(
        keyword: "Absorb",
        params: [Number(Param(0))],
        body: [
            Static(
                spec: DamageRule(
                    kind: Any,
                    source: Unattributed,
                    scope: ToRecipient(
                        recipient: AsType(type: Creature, subject: This, subtype: None),
                    ),
                    op: Prevent(cut: r#Some(Param(0)), also: None),
                    r#use: Repeatedly,
                ),
            ),
        ],
    ),
)
