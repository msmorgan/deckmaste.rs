KeywordAbility(
    name: "riot",
    params: [],
    spelling: "riot",
    grammar: FixedKeyword(
        surface: "riot",
    ),
    // "Riot" means "You may have this permanent enter with an additional +1/+1
    // counter on it. If you don't, it gains haste." [CR#702.136a] An Off-Stack
    // Static as it enters, over the existing entry rider.
    body: [
        static(
            asEvent(
                enters(thisPermanent),
                mayOrElse(
                    establish(entersWithAdditionalCounters(thisPermanent, 1, p1p1Counter)),
                    gain(thisPermanent, haste),
                ),
            ),
        ),
    ],
)
