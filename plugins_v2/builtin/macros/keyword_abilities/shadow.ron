KeywordAbility(
    name: "shadow",
    params: [],
    spelling: "shadow",
    grammar: FixedKeyword(
        surface: "shadow",
    ),
    // "A creature with shadow can't be blocked by creatures without shadow, and a
    // creature without shadow can't be blocked by creatures with shadow."
    // [CR#702.28b]
    body: [
        static(cantBeBlockedBy(thisCreature, and([creature, not(hasKeyword(The(shadow)))]))),
        static(
            cantBeBlockedBy(
                allOf(and([creature, not(hasKeyword(The(shadow)))])),
                and([creature, hasKeyword(The(shadow))]),
            ),
        ),
    ],
)
