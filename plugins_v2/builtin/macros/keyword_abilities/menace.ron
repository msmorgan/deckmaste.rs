KeywordAbility(
    name: "menace",
    params: [],
    spelling: "menace",
    grammar: FixedKeyword(
        surface: "menace",
    ),
    // "A creature with menace can't be blocked except by two or more creatures."
    // [CR#702.111b] The exception is a cardinality bound, not a description of the
    // blockers.
    body: Keyword(
        keyword: "Menace",
        params: [],
        body: [
            Static(
                spec: DeonticRule(
                    subject: AsType(type: Creature, subject: This, subtype: None),
                    compulsion: Forbid,
                    deeds: [Core(Block)],
                    role: Patient,
                    bound: MoreThan(1),
                    patient: Counterpart(
                        patient: Described(determiner: All, predicate: HasType(Creature)),
                    ),
                    as_though: None,
                    rider: NoRider,
                ),
            ),
        ],
    ),
)
