KeywordAbility(
    name: "menace",
    params: [],
    spelling: "menace",
    grammar: FixedKeyword(
        surface: "menace",
    ),
    // "A creature with menace can't be blocked except by two or more creatures."
    // [CR#702.111b] The exception is a cardinality bound, not a description of the
    // blockers.
    body: [
        static(
            deonticRule(thisCreature, Forbid, [Block], Patient, Counterpart(allOf(creature)), NoRider, MoreThan(1)),
        ),
    ],
)
