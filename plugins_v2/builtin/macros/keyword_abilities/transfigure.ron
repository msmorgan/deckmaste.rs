KeywordAbility(
    name: "transfigure",
    params: [Cost],
    spelling: "transfigure",
    grammar: FixedKeyword(
        surface: "transfigure",
    ),
    // "Transfigure [cost]" means "[Cost], Sacrifice this permanent: Search your library
    // for a creature card with the same mana value as this permanent and put it onto
    // the battlefield. Then shuffle your library. Activate only as a sorcery."
    // [CR#702.71a]
    body: [
        activated(
            compound([Param(0), perform(sacrifice(thisPermanent))]),
            sequentially([
                searchLibraryFor(
                    exactly(1),
                    and([
                        isCard,
                        creature,
                        compare([Stat(ManaValue)], Eq, statOf(Stat(ManaValue), thisPermanent)),
                    ]),
                ),
                putOntoBattlefield(Pro(Bare, One, top(1))),
                shuffle,
            ]),
            asSorcery,
        ),
    ],
)
