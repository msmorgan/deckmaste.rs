KeywordAbility(
    name: "transfigure",
    params: [Cost],
    spelling: "transfigure",
    grammar: FixedKeyword(
        surface: "transfigure",
    ),
    // "Transfigure [cost]" means "[Cost], Sacrifice this permanent: Search your library
    // for a creature card with the same mana value as this permanent and put it onto
    // the battlefield. Then shuffle your library. Activate only as a sorcery."
    // [CR#702.71a]
    body: Keyword(
        keyword: "Transfigure",
        params: [Cost(cost: Param(0))],
        body: [
            Activated(
                cost: Compound(
                    costs: [
                        Param(0),
                        Perform(
                            instruction: Enact(
                                verb: Action(label: "Sacrifice"),
                                instruction: Move(
                                    subject: AsMarker(marker: Permanent, subject: This),
                                    to: Zone(zone: Graveyard, scope: Bare),
                                    riders: [],
                                ),
                                agent: You,
                            ),
                        ),
                    ],
                ),
                instruction: Sequentially(
                    steps: [
                        Search(
                            scope: OneZone(
                                zone: Zone(zone: Library, scope: PossessedBy(possessor: You)),
                            ),
                            quantity: Range(low: 1, high: 1),
                            predicate: And(
                                conjuncts: [
                                    IsCard,
                                    HasType(type: Creature),
                                    Compare(
                                        axes: [Stat(stat: ManaValue)],
                                        comparator: Eq,
                                        bound: StatOf(
                                            axis: Stat(stat: ManaValue),
                                            subject: AsMarker(marker: Permanent, subject: This),
                                        ),
                                    ),
                                ],
                            ),
                            agent: You,
                        ),
                        Move(
                            subject: Pro(reach: Bare, plurality: One, window: Top(depth: 1)),
                            to: Zone(zone: Battlefield, scope: Bare),
                            riders: [],
                        ),
                        Shuffle(agent: You),
                    ],
                ),
                timing: AsSorcery,
                limit: None,
                guard: None,
                activator: None,
            ),
        ],
    ),
)
