KeywordAbility(
    name: "disguise",
    params: [Cost],
    spelling: "disguise <Param(0)>",
    grammar: FixedKeyword(
        surface: "disguise",
    ),
    // "Disguise [cost]" means "You may cast this card as a 2/2 face-down creature with
    // ward {2}, no name, no subtypes, and no mana cost by paying {3} rather than paying
    // its mana cost." [CR#702.168a] Turning it face up for its disguise cost is a special
    // action [CR#702.168d,116.2b].
    body: [
        static(
            mayPlayDeed(
                cast,
                you,
                this,
                Play(None, None, None, false, FaceDown(faceDownWardedCreature, mana([3]))),
            ),
        ),
        static(specialAction(None, Param(0), setStatus(FaceUp, this))),
    ],
)
