KeywordAbility(
    name: "Indestructible",
    params: [],
    spelling: "indestructible",
    grammar: FixedKeyword(
        surface: "indestructible",
    ),
    // STOP. "A permanent with indestructible can't be destroyed." [CR#702.12b]
    // The clause is a deontic rule over the `Destroy` deed in the patient role,
    // and the deed's `patientRole` fact is `fieldObject` — `bare := false` with
    // an empty type list — so `deedFits` refuses every noun phrase in that role
    // and no subject can be written. Fixing that is a change to the deed's role
    // columns, which this ticket's overlay authority does not cover.
    body: Keyword(keyword: "Indestructible", params: [], body: []),
)
