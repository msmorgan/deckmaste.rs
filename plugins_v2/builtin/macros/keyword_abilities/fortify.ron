KeywordAbility(
    name: "fortify",
    params: [Cost],
    spelling: "fortify",
    grammar: FixedKeyword(
        surface: "fortify",
        participial_adjective: (surface: "fortified",),
    ),
    // "Fortify [cost]" means "[Cost]: Attach this Fortification to target land you
    // control. Activate only as a sorcery." [CR#702.67a]
    body: [
        activated(Param(0), attach(thisPermanent, target(and([land, youControl]))), asSorcery),
    ],
)
