KeywordAbility(
    name: "forecast",
    params: [Ability],
    spelling: "forecast — <Param(0)>",
    keyword_syntax: (head_separator: SpacedDash),
    grammar: FixedKeyword(
        surface: "forecast",
    ),
    // "Forecast — [Activated ability]": an activated ability that can be
    // activated only from its owner's hand, only during that player's upkeep
    // and only once each turn [CR#702.57a,702.57b]. Revealing the card as it
    // is activated, and keeping it revealed until it leaves the hand or a
    // step other than upkeep begins, is the engine's activation procedure; no
    // qualifier writes it.
    body: [
        qualified(
            ability: Param(0),
            timing: duringPart(upkeep, ownerOf(this)),
            limit: oncePerTurn,
            from: Hand,
        ),
    ],
)
