KeywordAbility(
    name: "forecast",
    params: [Ability],
    spelling: "forecast — <Param(0)>",
    keyword_syntax: (head_separator: SpacedDash),
    grammar: FixedKeyword(
        surface: "forecast",
    ),
    // STOP (waits on: the ability printed with the keyword).
    // "Forecast — [Activated ability]" qualifies the activated ability written
    // after it: it may be activated only from its owner's hand, only during their
    // upkeep, only once each turn, and reveals the card [CR#702.57a,702.57b]. The
    // qualifiers are now writable (`duringPart(upkeep, you)`, `oncePerTurn`), but
    // `KeywordParam` has no `Ability` variant and nothing lets a definition qualify
    // the ability printed after the keyword (the cause Boast and Exhaust share).
)
