KeywordAbility(
    name: "recover",
    params: [Cost],
    spelling: "recover",
    grammar: FixedKeyword(
        surface: "recover",
    ),
    // "Recover [cost]" means "When a creature is put into your graveyard from the
    // battlefield, you may pay [cost]. If you do, return this card from your graveyard
    // to your hand. Otherwise, exile this card." [CR#702.59a]
    body: [
        triggered(
            zoneChange(a(creature), Zones([battlefield]), graveyardOf(you), Before),
            may(
                you,
                pay(Param(0), Once, you),
                returnToHand(you, this, graveyardOf(you)),
                exileBy(you, this),
            ),
        ),
    ],
)
