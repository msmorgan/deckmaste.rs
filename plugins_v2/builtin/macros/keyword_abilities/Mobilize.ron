KeywordAbility(
    name: "Mobilize",
    params: [Amount],
    spelling: "mobilize",
    grammar: FixedKeyword(
        surface: "mobilize",
    ),
    // "Mobilize N" means "Whenever this creature attacks, create N 1/1 red Warrior
    // creature tokens. Those tokens enter tapped and attacking. Sacrifice them at
    // the beginning of the next end step." [CR#702.181a]
    body: Keyword(
        keyword: "Mobilize",
        params: [Number(amount: Param(0))],
        body: [
            Triggered(
                event: Combat(
                    relation: AttackerOf,
                    subject: AsType(type: Creature, subject: This, subtype: None),
                    counterpart: None,
                ),
                alternatives: [],
                r#while: None,
                joins: [],
                timing: None,
                limit: None,
                intervening: None,
                instruction: Sequentially(
                    steps: [
                        CreateObject(
                            count: Param(0),
                            spec: Token(
                                spec: Written(
                                    characteristics: (
                                        characteristics: (
                                            colors: [Red],
                                            types: [Creature],
                                            subtypes: [Of(host: Creature, label: "Warrior")],
                                            power: Lit(value: 1),
                                            toughness: Lit(value: 1),
                                        ),
                                    ),
                                ),
                                riders: [
                                    EntersAs(status: Tapped),
                                    EntersAttacking(defender: None),
                                ],
                            ),
                            agent: You,
                        ),
                        Delay(
                            event: BeginningOf(
                                quantifier: The,
                                part: EndStep,
                                whose: NoPossessor,
                            ),
                            alternatives: [],
                            duration: None,
                            body: Enact(
                                verb: Action(label: "Sacrifice"),
                                instruction: Move(
                                    subject: Pro(
                                        reach: TokenBorn,
                                        plurality: Many,
                                        window: Whole,
                                    ),
                                    to: Zone(zone: Graveyard, scope: Bare),
                                    riders: [],
                                ),
                                agent: You,
                            ),
                        ),
                    ],
                ),
            ),
        ],
    ),
)
