KeywordAbility(
    name: "myriad",
    params: [],
    spelling: "myriad",
    grammar: FixedKeyword(
        surface: "myriad",
    ),
    // "Myriad" means "Whenever this creature attacks, for each opponent other than
    // defending player, you may create a token that's a copy of this creature that's
    // tapped and attacking that player or a planeswalker they control. If one or more
    // tokens are created this way, exile the tokens at end of combat." [CR#702.116a]
    body: Keyword(
        keyword: "Myriad",
        params: [],
        body: [
            Triggered(
                event: Combat(
                    relation: AttackerOf,
                    subject: AsType(type: Creature, subject: This, subtype: None),
                    counterpart: None,
                ),
                alternatives: [],
                r#while: None,
                joins: [],
                timing: None,
                limit: None,
                intervening: None,
                instruction: Sequentially(
                    steps: [
                        DoForEach(
                            group: Described(
                                determiner: Each,
                                predicate: And(
                                    conjuncts: [
                                        Opponent,
                                        OtherThan(anchor: CombatPlayer(role: Defending)),
                                    ],
                                ),
                            ),
                            body: WithContinuation(
                                policy: Optional(agent: You),
                                body: CreateObject(
                                    count: Lit(value: 1),
                                    spec: Token(
                                        spec: CopyOf(
                                            source: AsType(
                                                type: Creature,
                                                subject: This,
                                                subtype: None,
                                            ),
                                            exceptions: [],
                                        ),
                                        riders: [
                                            EntersAs(status: Tapped),
                                            EntersAttacking(
                                                defender: Or(
                                                    phrases: [
                                                        Pro(
                                                            reach: Word(word: Player),
                                                            plurality: One,
                                                            window: Whole,
                                                        ),
                                                        Described(
                                                            determiner: A(mode: Unmarked),
                                                            predicate: And(
                                                                conjuncts: [
                                                                    HasType(type: Planeswalker),
                                                                    HasPossessor(
                                                                        axis: Controller,
                                                                        possessor: Pro(
                                                                            reach: Word(
                                                                                word: Player,
                                                                            ),
                                                                            plurality: One,
                                                                            window: Whole,
                                                                        ),
                                                                    ),
                                                                ],
                                                            ),
                                                        ),
                                                    ],
                                                ),
                                            ),
                                        ],
                                    ),
                                    agent: You,
                                ),
                                if_did: None,
                                if_not: None,
                            ),
                        ),
                        DoIf(
                            condition: CompareAmt(
                                subject: CountOf(
                                    group: Pro(
                                        reach: TokenBorn,
                                        plurality: Many,
                                        window: Whole,
                                    ),
                                ),
                                comparator: AtLeast,
                                bound: Lit(value: 1),
                            ),
                            instruction: Delay(
                                event: BeginningOf(
                                    quantifier: The,
                                    part: EndOfCombat,
                                    whose: NoPossessor,
                                ),
                                alternatives: [],
                                duration: None,
                                body: Enact(
                                    verb: Action(label: "Exile"),
                                    instruction: Move(
                                        subject: Pro(
                                            reach: TokenBorn,
                                            plurality: Many,
                                            window: Whole,
                                        ),
                                        to: Zone(zone: Exile, scope: Bare),
                                        riders: [],
                                    ),
                                    agent: You,
                                ),
                            ),
                            otherwise: None,
                        ),
                    ],
                ),
            ),
        ],
    ),
)
