KeywordAbility(
    name: "myriad",
    params: [],
    spelling: "myriad",
    grammar: FixedKeyword(
        surface: "myriad",
    ),
    // "Myriad" means "Whenever this creature attacks, for each opponent other than
    // defending player, you may create a token that's a copy of this creature that's
    // tapped and attacking that player or a planeswalker they control. If one or more
    // tokens are created this way, exile the tokens at end of combat." [CR#702.116a]
    body: [
        triggered(
            attacks(thisCreature),
            sequentially([
                doForEach(
                    each(and([opponent, otherThan(defendingPlayer)])),
                    may(
                        createObject(
                            1,
                            Token(
                                copyOf(thisCreature),
                                [
                                    EntersAs(Tapped),
                                    EntersAttacking(
                                        or([they, a(and([planeswalker, controlledBy(they)]))]),
                                    ),
                                ],
                            ),
                        ),
                    ),
                ),
                doIf(
                    compareAmt(numberOf(themAsTokens), AtLeast, 1),
                    atNext(EndOfCombat, exile(themAsTokens)),
                ),
            ]),
        ),
    ],
)
