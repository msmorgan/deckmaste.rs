KeywordAbility(
    name: "madness",
    params: [Cost],
    spelling: "madness",
    grammar: FixedKeyword(
        surface: "madness",
    ),
    // "Madness [cost]" means "If a player would discard this card, that player
    // discards it, but exiles it instead of putting it into their graveyard" and
    // "When this card is exiled this way, its owner may cast it by paying [cost]
    // rather than paying its mana cost. If that player doesn't, they put this card
    // into their graveyard." [CR#702.35a]
    body: [
        static(
            insteadOf(
                verbedEvent(a(anyPlayer), Action("Discard"), this),
                enact(Action("Discard"), move(this, hand, exileZone)),
            ),
        ),
        triggered(
            // "this way": the exile the replacement above performed.
            causes(
                Event(verbedEvent(verb: Action("Discard"), patient: this)),
                zoneChange(this, Zones([hand]), exileZone, After),
            ),
            may(
                agent: ownerOf(this),
                body: establish(mayCastFor(ownerOf(this), Param(0), exileZone)),
                if_not: move(this, wherever, graveyard),
            ),
        ),
    ],
)
