KeywordAbility(
    name: "madness",
    params: [Cost],
    spelling: "madness",
    grammar: FixedKeyword(
        surface: "madness",
    ),
    // "Madness [cost]" means "If a player would discard this card, that player
    // discards it, but exiles it instead of putting it into their graveyard" and
    // "When this card is exiled this way, its owner may cast it by paying [cost]
    // rather than paying its mana cost. If that player doesn't, they put this card
    // into their graveyard." [CR#702.35a]
    body: Keyword(
        keyword: "Madness",
        params: [Cost(cost: Param(0))],
        body: [
            Static(
                spec: Replacement(
                    event: VerbedEvent(
                        agent: Described(determiner: A(mode: Unmarked), predicate: AnyPlayer),
                        verb: Action(label: "Discard"),
                        patient: This,
                        becomes: None,
                        locus: None,
                    ),
                    alternatives: [],
                    timing: None,
                    replacement: Enact(
                        verb: Action(label: "Discard"),
                        instruction: Move(
                            subject: This,
                            to: Zone(zone: Exile, scope: Bare),
                            riders: [],
                        ),
                        agent: Pro(reach: Word(word: Player), plurality: One, window: Whole),
                    ),
                    r#use: Repeatedly,
                    limit: None,
                ),
            ),
            Triggered(
                // "this way": the exile the replacement above performed.
                event: Causes(
                    cause: Event(
                        event: VerbedEvent(
                            agent: None,
                            verb: Action(label: "Discard"),
                            patient: This,
                            becomes: None,
                            locus: None,
                        ),
                    ),
                    event: ZoneChange(
                        subject: This,
                        from: Zones(zones: [Zone(zone: Hand, scope: Bare)]),
                        to: Zone(zone: Exile, scope: Bare),
                        observation: After,
                    ),
                ),
                alternatives: [],
                r#while: None,
                joins: [],
                timing: None,
                limit: None,
                intervening: None,
                instruction: WithContinuation(
                    policy: Optional(agent: PossessorOf(axis: Owner, subject: This)),
                    body: Establish(
                        spec: DeonticRule(
                            subject: PossessorOf(axis: Owner, subject: This),
                            compulsion: Permit,
                            deeds: [Action(label: "Cast")],
                            role: Agent,
                            bound: None,
                            patient: Counterpart(patient: This),
                            as_though: None,
                            rider: Play(
                                from: Zone(zone: Exile, scope: Bare),
                                limit: None,
                                timing: None,
                                exclusive: false,
                                payment: PayingInstead(cost: Param(0)),
                            ),
                        ),
                        duration: None,
                    ),
                    if_did: None,
                    if_not: Move(
                        subject: This,
                        to: Zone(zone: Graveyard, scope: Bare),
                        riders: [],
                    ),
                ),
            ),
        ],
    ),
)
