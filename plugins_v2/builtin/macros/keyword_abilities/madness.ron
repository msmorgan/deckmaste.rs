KeywordAbility(
    name: "madness",
    params: [Cost],
    spelling: "madness <Param(0)>",
    grammar: FixedKeyword(
        surface: "madness",
    ),
    // "Madness [cost]" means "If a player would discard this card, that player
    // discards it, but exiles it instead of putting it into their graveyard" and
    // "When this card is exiled this way, its owner may cast it by paying [cost]
    // rather than paying its mana cost. If that player doesn't, they put this card
    // into their graveyard." [CR#702.35a]
    body: [
        static(
            insteadOf(
                discards(a(anyPlayer), this),
                enact(discard, move(this, hand, exileZone)),
            ),
        ),
        triggered(
            // "this way": the exile the replacement above performed.
            causes(
                Event(verbedEvent(discard, this)),
                zoneChange(this, After, Zones([hand]), exileZone),
            ),
            act(
                ownerOf(this),
                // One-shot: the owner casts it now, during the trigger's
                // resolution, or puts it into their graveyard [CR#702.35a];
                // not a lasting permission.
                mayOrElse(
                    enact(cast, procedure(Cast, this, PayingInstead(Param(0)))),
                    move(this, wherever, graveyard),
                ),
            ),
        ),
    ],
)
