KeywordAbility(
    name: "mayhem",
    params: [Cost],
    spelling: "mayhem",
    grammar: FixedKeyword(
        surface: "mayhem",
    ),
    // "Mayhem [cost]" means "As long as you discarded this card this turn, you may
    // cast it from your graveyard by paying [cost] rather than paying its mana
    // cost." [CR#702.187b]
    body: [
        static(
            onlyWhile(
                mayCastFor(you, Param(0), graveyardOf(you)),
                happened(discards(gap(Player), this), you, ThisTurn),
            ),
        ),
    ],
)
