KeywordAbility(
    name: "giftAFood",
    params: [],
    spelling: "gift a Food",
    grammar: FixedKeyword(
        surface: "gift a Food",
    ),
    // "Gift a Food" means the effect is "The chosen player creates a Food
    // token." [CR#702.174d] A Food token is a colorless Food artifact token with
    // "{2}, {T}, Sacrifice this token: You gain 3 life." [CR#111.10b] It is gift
    // itself, labelled gift.
    label: gift,
    body: [
        gift(
            createToken((
                characteristics: (
                    types: [Artifact],
                    subtypes: [food],
                    text: [
                        activated(
                            cost: compound([mana([2]), tapSymbol, perform(sacrifice(thisArtifact))]),
                            instruction: gainLife(3),
                        ),
                    ],
                ),
            )),
        ),
    ],
)
