KeywordAbility(
    name: "undying",
    params: [],
    spelling: "undying",
    grammar: FixedKeyword(
        surface: "undying",
    ),
    // "Undying" means "When this permanent is put into a graveyard from the
    // battlefield, if it had no +1/+1 counters on it, return it to the battlefield
    // under its owner's control with a +1/+1 counter on it." [CR#702.93a]
    body: [
        triggeredIf(
            dies(thisPermanent),
            not(matches(thisPermanent, hasCounters(p1p1Counter))),
            returnToBattlefield(
                thisPermanent,
                [Under(ownerOf(thisPermanent)), WithCounters(1, p1p1Counter, Fresh)],
            ),
        ),
    ],
)
