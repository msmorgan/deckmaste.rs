KeywordAbility(
    name: "teamwork",
    params: [Amount],
    spelling: "teamwork <Param(0)>",
    grammar: FixedKeyword(
        surface: "teamwork",
    ),
    // "Teamwork N" means "As an additional cost to cast this spell, you may tap any
    // number of creatures you control with total power N or more." [CR#702.194a]
    // "Cast using teamwork" reads the paid cost back [CR#702.194b].
    body: [
        static(
            addedCost(
                perform(tap(withTotal(Stat(Power), AtLeast, Param(0), allOf(creatureYouControl)))),
                true,
            ),
        ),
    ],
)
