KeywordAbility(
    name: "hexproof",
    params: [],
    spelling: "hexproof",
    grammar: FixedKeyword(
        surface: "hexproof",
    ),
    // "Hexproof" on a permanent means "This permanent can't be the target of spells
    // or abilities your opponents control." [CR#702.11b] The player form
    // [CR#702.11c] is what a grant to a player reads.
    body: [
        static(
            cantBeTargetedBy(
                thisPermanent,
                allOf(and([inZone(stack), controlledBy(playerGroup(YourOpponents))])),
            ),
        ),
    ],
)
