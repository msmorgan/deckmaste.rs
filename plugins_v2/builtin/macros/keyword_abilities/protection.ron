KeywordAbility(
    name: "protection",
    params: [Quality],
    spelling: "protection from <Param(0):plural>",
    grammar: FixedKeyword(
        surface: "protection",
        parameter: Quality(preposition: ("Preposition", "From")),
    ),
    // STOP (waits on: a deontic slot for an attachment's host).
    // "Protection from [quality]" [CR#702.16a] is four
    // consequences, and three write and check: can't be targeted by spells with the quality
    // or abilities from a source with it [CR#702.16b] (`cantBeTargetedBy`), damage from such
    // sources prevented [CR#702.16e] (`damageRule`), and can't be blocked by such creatures
    // [CR#702.16f] (`cantBeBlockedBy`). The fourth, "can't be enchanted by Auras … equipped
    // by Equipment … or fortified by Fortifications that have the stated quality"
    // [CR#702.16c,702.16d], forbids attaching such objects TO this permanent. The `attach`
    // deed's row has no patient role, and `DeonticPatient`'s counterpart is the deed's other
    // role (the attaching player), so no slot names the attachment's host. A body carrying
    // only three of the four would be a wrong analysis, so none is written.
)
