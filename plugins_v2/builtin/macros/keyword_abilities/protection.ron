KeywordAbility(
    name: "protection",
    params: [Quality],
    spelling: "protection from <Param(0):plural>",
    grammar: FixedKeyword(
        surface: "protection",
        parameter: Quality(preposition: ("Preposition", "From")),
    ),
    // "Protection from [quality]" [CR#702.16a] is five consequences, one row
    // each:
    // - can't be targeted by spells with the quality or by abilities from a
    //   source with it [CR#702.16b];
    // - can't be enchanted by Auras that have the quality [CR#702.16c];
    // - can't be equipped by Equipment or fortified by Fortifications that have
    //   the quality [CR#702.16d];
    // - damage that would be dealt to it by sources with the quality is
    //   prevented [CR#702.16e];
    // - while attacking, it can't be blocked by creatures with the quality
    //   [CR#702.16f].
    // The attach rows forbid the attach deed from the attachment's side, this
    // permanent in its host role. That an Aura, Equipment or Fortification
    // already attached falls off is the subtypes' own state-based rows over the
    // engine's attach-permission model [CR#704.5m,704.5n], not written here.
    body: [
        static(
            cantBeTargetedBy(
                thisPermanent,
                allOf(or([and([spell, Param(0)]), abilityOf(allOf(and([source, Param(0)])))])),
            ),
        ),
        static(cantBeAttachedTo(allOf(and([hasSubtype(aura), Param(0)])), thisPermanent)),
        static(
            cantBeAttachedTo(
                allOf(and([or([hasSubtype(equipment), hasSubtype(fortification)]), Param(0)])),
                thisPermanent,
            ),
        ),
        static(
            damageRule(
                Any,
                DealtBy(allOf(and([source, Param(0)]))),
                ToRecipient(thisPermanent),
                Prevent(All, None),
                Repeatedly,
            ),
        ),
        static(cantBeBlockedBy(thisCreature, and([creature, Param(0)]))),
    ],
)
