KeywordAbility(
    name: "bloodthirst",
    params: [Amount],
    spelling: "bloodthirst",
    grammar: FixedKeyword(
        surface: "bloodthirst",
    ),
    // "Bloodthirst N" means "If an opponent was dealt damage this turn, this
    // permanent enters with N +1/+1 counters on it." [CR#702.54a]
    body: [
        static(
            onlyWhile(
                entersWithCounters(thisPermanent, Param(0), p1p1Counter),
                happened(damage(Any, gap(Player)), anOpponent, ThisTurn),
            ),
        ),
    ],
)
