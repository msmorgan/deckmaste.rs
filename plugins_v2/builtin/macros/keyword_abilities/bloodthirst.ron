KeywordAbility(
    name: "bloodthirst",
    params: [Amount],
    spelling: "bloodthirst",
    grammar: FixedKeyword(
        surface: "bloodthirst",
    ),
    // "Bloodthirst N" means "If an opponent was dealt damage this turn, this
    // permanent enters with N +1/+1 counters on it." [CR#702.54a]
    body: Keyword(
        keyword: "Bloodthirst",
        params: [Number(Param(0))],
        body: [
            Static(
                spec: Conditional(
                    spec: EntryRider(
                        subject: AsMarker(marker: Permanent, subject: This),
                        rider: WithCounters(
                            amount: Param(0),
                            kind: Printed(
                                kind: Boost(power: Up(1), toughness: Up(1)),
                            ),
                            mark: Fresh,
                        ),
                    ),
                    condition: Happened(
                        subject: Described(determiner: A(Unmarked), predicate: Opponent),
                        lookback: Mk(
                            event: Damage(kind: Any, source: None, patient: Gap(Player)),
                            lookback: ThisTurn,
                        ),
                    ),
                    marking: AsLongAs,
                ),
            ),
        ],
    ),
)
