KeywordAbility(
    name: "landwalk",
    params: [Quality],
    spelling: "landwalk",
    grammar: FixedKeyword(
        surface: "landwalk",
        bound_suffix: (surface: "walk"),
    ),
    // "A creature with landwalk can't be blocked as long as the defending player
    // controls at least one land with the specified land type." [CR#702.14c]
    body: [
        static(
            onlyWhile(
                objectCant(Block, thisCreature),
                exists(and([land, Param(0), controlledBy(defendingPlayer)])),
            ),
        ),
    ],
)
