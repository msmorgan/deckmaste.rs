KeywordAbility(
    name: "devoid",
    params: [],
    spelling: "devoid",
    grammar: FixedKeyword(
        surface: "devoid",
    ),
    // "Devoid" means "This object is colorless." [CR#702.114a] A
    // characteristic-defining ability, so it is static [CR#604.3].
    body: [
        static(characteristicChange(this, [Colors(Sets, Some([]))])),
    ],
)
