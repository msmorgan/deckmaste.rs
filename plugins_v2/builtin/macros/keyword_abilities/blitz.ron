KeywordAbility(
    name: "blitz",
    params: [Cost],
    spelling: "blitz <Param(0)>",
    grammar: FixedKeyword(
        surface: "blitz",
    ),
    // "Blitz [cost]" means "You may cast this card by paying [cost] rather than
    // its mana cost," "If this spell's blitz cost was paid, sacrifice the permanent
    // this spell becomes at the beginning of the next end step," and "As long as
    // this permanent's blitz cost was paid, it has haste and 'When this permanent
    // is put into a graveyard from the battlefield, draw a card.'" [CR#702.152a]
    // The second is an Off-Stack Static on paying the cost that creates a delayed
    // trigger over the spell's successor (`becomes`) [CR#603.7g].
    body: [
        static(mayCastFor(you, Param(0))),
        static(
            asEvent(
                paysCost(Paid, thisSpell, blitz, you),
                atNext(EndStep, sacrifice(becomes(thisSpell))),
            ),
        ),
        static(onlyWhile(abilityGrant(thisPermanent, haste), keywordCostPaid(blitz, thisPermanent))),
        static(
            onlyWhile(
                abilityGrant(thisPermanent, triggered(dies(thisPermanent), draw(1))),
                keywordCostPaid(blitz, thisPermanent),
            ),
        ),
    ],
)
