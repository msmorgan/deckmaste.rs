KeywordAbility(
    name: "blitz",
    params: [Cost],
    spelling: "blitz",
    grammar: FixedKeyword(
        surface: "blitz",
    ),
    // STOP. Blitz's second ability is "If this spell's blitz cost was paid,
    // sacrifice the permanent this spell becomes at the beginning of the next end
    // step" [CR#702.152a] — a static that creates a delayed triggered ability. No
    // `StaticSpec` creates one; `Instruction::Delay` is an instruction and no
    // static clause carries an instruction outside `Replacement`.
    body: Keyword(keyword: "Blitz", params: [Cost(cost: Param(0))], body: []),
)
