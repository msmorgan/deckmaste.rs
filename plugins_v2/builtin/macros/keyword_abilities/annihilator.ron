KeywordAbility(
    name: "annihilator",
    params: [Amount],
    spelling: "annihilator",
    grammar: FixedKeyword(
        surface: "annihilator",
    ),
    // "Annihilator N" means "Whenever this creature attacks, defending player
    // sacrifices N permanents." [CR#702.86a]
    body: [
        triggered(
            attacks(thisCreature),
            sacrifice(counted(exactlyOf(Param(0)), permanent), defendingPlayer),
        ),
    ],
)
