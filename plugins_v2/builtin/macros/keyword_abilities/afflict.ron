KeywordAbility(
    name: "afflict",
    params: [Amount],
    spelling: "afflict",
    grammar: FixedKeyword(
        surface: "afflict",
    ),
    // "Afflict N" means "Whenever this creature becomes blocked, defending player
    // loses N life." [CR#702.130a]
    body: [
        triggered(becomesBlocked(thisCreature), loseLife(Param(0), defendingPlayer)),
    ],
)
