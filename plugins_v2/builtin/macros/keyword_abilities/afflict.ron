KeywordAbility(
    name: "afflict",
    params: [Amount],
    spelling: "afflict",
    grammar: FixedKeyword(
        surface: "afflict",
    ),
    // "Afflict N" means "Whenever this creature becomes blocked, defending player
    // loses N life." [CR#702.130a]
    body: Keyword(
        keyword: "Afflict",
        params: [Number(Param(0))],
        body: [
            Triggered(
                event: Combat(
                    relation: BlockedBy,
                    subject: AsType(type: Creature, subject: This, subtype: None),
                    counterpart: None,
                ),
                alternatives: [],
                r#while: None,
                joins: [],
                timing: None,
                limit: None,
                intervening: None,
                instruction: ChangeLife(
                    delta: Down(Param(0)),
                    agent: CombatPlayer(Defending),
                ),
            ),
        ],
    ),
)
