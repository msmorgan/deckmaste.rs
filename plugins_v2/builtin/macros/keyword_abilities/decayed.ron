KeywordAbility(
    name: "decayed",
    params: [],
    spelling: "decayed",
    grammar: FixedKeyword(
        surface: "decayed",
    ),
    // "Decayed" means "This creature can't block" and "When this creature attacks,
    // sacrifice it at end of combat." [CR#702.147a]
    body: [
        static(playerCant(Block, thisCreature)),
        triggered(attacks(thisCreature), atNext(EndOfCombat, sacrifice(thisPermanent))),
    ],
)
