KeywordAbility(
    name: "gift",
    params: [Instruction],
    grammar: FixedKeyword(
        surface: "gift",
    ),
    // Gift is two abilities. The first is always "As an additional cost to cast
    // this spell, you may choose an opponent." The second is "When this permanent
    // enters, if its gift cost was paid, [effect]" on a permanent and "If this
    // spell's gift cost was paid, [effect]" on an instant or sorcery spell, the
    // effect performed by the chosen player [CR#702.174a,702.174b]. The second
    // reads the opponent back through the paid cost it was chosen as, as the
    // rules link them [CR#607.2d,607.2i]; each half is guarded by the card's
    // class (`semantics-v2.md` §7, ruling 2026-10-06). The permanent half's guard
    // reads the object's types (`permanentType`), not `permanentCard`, so it
    // holds of a token that has gift as well [CR#110.4].
    //
    // No spelling: "Gift a [something]" defines its effect by the [something]
    // [CR#702.174d..702.174i], so bare gift is unparseable and is invoked by its
    // six spelled variants. It is what "the gift was promised" names
    // [CR#702.174k].
    body: [
        static(addedCost(perform(choose(a(opponent))), true)),
        triggeredIf(
            event: enters(thisPermanent),
            condition: matches(this, permanentType),
            instruction: doIf(
                keywordCostPaid(gift, this),
                act(chosenAsPaid(gift, this), Param(0)),
            ),
        ),
        spell(
            doIf(
                matches(this, instantOrSorcery),
                doIf(
                    keywordCostPaid(gift, this),
                    act(chosenAsPaid(gift, this), Param(0)),
                ),
            ),
        ),
    ],
)
