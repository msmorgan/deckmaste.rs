                instruction: WithContinuation(
                    policy: Optional(agent: You),
                    body: Establish(
                        spec: DeonticRule(
                            subject: Described(
                                determiner: Target(quantity: Range(low: 1, high: 1)),
                                predicate: And(
                                    conjuncts: [
