KeywordAbility(
    name: "hideaway",
    params: [Amount],
    spelling: "hideaway <Param(0)>",
    grammar: FixedKeyword(
        surface: "hideaway",
    ),
    // "Hideaway N" means "When this permanent enters, look at the top N cards of your
    // library. Exile one of them face down and put the rest on the bottom of your library
    // in a random order. The exiled card gains 'The player who controls the permanent
    // that exiled this card may look at this card in the exile zone.'" [CR#702.75a] The
    // look right is `visibility` while the card stays exiled, granted twice: to the
    // player who looked at the card and exiled it face down, who may keep looking at it
    // [CR#406.3], and to whoever controls the permanent now, since a resolved effect
    // that changes no characteristics or control can reach a player it did not reach
    // when it began [CR#702.75a,611.2c].
    body: [
        triggered(
            enters(thisPermanent),
            sequentially([
                lookAt(slice(Top, Param(0), library(you))),
                exileFaceDown(someOf(exactly(1), them)),
                move(theRest(Object), wherever, onBottom, [Placement(InOrder(RandomOrder))]),
                establish(
                    conjunction(parts: [
                        visibility(LookAt, you, Objects(theVerbed(exile, One, Card))),
                        visibility(LookAt, controllerOf(thisPermanent), Objects(theVerbed(exile, One, Card))),
                    ]),
                    forAsLongAs(matches(theVerbed(exile, One, Card), inZone(exileZone))),
                ),
            ]),
        ),
    ],
)
