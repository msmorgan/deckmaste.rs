KeywordAbility(
    name: "frenzy",
    params: [Amount],
    spelling: "frenzy",
    grammar: FixedKeyword(
        surface: "frenzy",
    ),
    // STOP. "Frenzy N" means "Whenever this creature attacks and isn't blocked, it gets
    // +N/+0 until end of turn" [CR#702.68a]. `CombatRelation` names attacking, being
    // blocked and blocking, but no relation and no `GameEvent` says "attacks and isn't
    // blocked", which fires in the declare blockers step, not at declare attackers;
    // an intervening-if on the attack event would be a different ability.
    body: Keyword(keyword: "Frenzy", params: [Number(amount: Param(0))], body: []),
)
