KeywordAbility(
    name: "dash",
    params: [Cost],
    spelling: "dash <Param(0)>",
    grammar: FixedKeyword(
        surface: "dash",
    ),
    // "Dash [cost]" means "You may cast this card by paying [cost] rather than its
    // mana cost," "If this spell's dash cost was paid, return the permanent this
    // spell becomes to its owner's hand at the beginning of the next end step,"
    // and "As long as this permanent's dash cost was paid, it has haste."
    // [CR#702.109a] The second creates its delayed trigger as the permanent is
    // put onto the battlefield as the spell resolves [CR#608.3g,603.7d], as
    // blitz's is: an Off-Stack Static on that entry, guarded by the dash cost
    // having been paid, naming the permanent directly.
    body: [
        static(mayCastFor(you, Param(0))),
        static(
            asEvent(
                enters(thisPermanent, Zones([stack])),
                doIf(
                    keywordCostPaid(dash, thisPermanent),
                    atNext(EndStep, returnToHand(thisPermanent)),
                ),
            ),
        ),
        static(onlyWhile(abilityGrant(thisPermanent, haste), keywordCostPaid(dash, thisPermanent))),
    ],
)
