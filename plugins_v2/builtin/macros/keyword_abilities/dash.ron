KeywordAbility(
    name: "dash",
    params: [Cost],
    spelling: "dash <Param(0)>",
    grammar: FixedKeyword(
        surface: "dash",
    ),
    // "Dash [cost]" means "You may cast this card by paying [cost] rather than its
    // mana cost," "If this spell's dash cost was paid, return the permanent this
    // spell becomes to its owner's hand at the beginning of the next end step,"
    // and "As long as this permanent's dash cost was paid, it has haste."
    // [CR#702.109a] The second is an Off-Stack Static on paying the cost that
    // creates a delayed trigger over the spell's successor (`becomes`), whose
    // source is this object [CR#603.7g].
    body: [
        static(mayCastFor(you, Param(0))),
        static(
            asEvent(
                paysCost(Paid, thisSpell, dash, you),
                atNext(EndStep, returnToHand(becomes(thisSpell))),
            ),
        ),
        static(onlyWhile(abilityGrant(thisPermanent, haste), keywordCostPaid(dash, thisPermanent))),
    ],
)
