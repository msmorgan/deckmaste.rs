KeywordAbility(
    name: "storm",
    params: [],
    spelling: "storm",
    grammar: FixedKeyword(
        surface: "storm",
    ),
    // "Storm" means "When you cast this spell, copy it for each other spell that was cast
    // before it this turn. You may choose new targets for the copies." [CR#702.40a]
    // `lean/Semantics/Macros.lean`'s `stormExpansion` is the reference.
    body: [
        triggered(
            casts(you, thisSpell),
            sequentially([
                copySpell(
                    you,
                    thisSpell,
                    eventCount(casts(gap(Player), a(anotherSpell)), a(anyPlayer), EarlierThisTurn),
                ),
                may(you, chooseNewTargets(those(Copy))),
            ]),
        ),
    ],
)
