KeywordAbility(
    name: "sneak",
    params: [Cost],
    spelling: "sneak <Param(0)>",
    grammar: FixedKeyword(
        surface: "sneak",
    ),
    // "Sneak [cost]" means "Any time you could cast an instant during your declare
    // blockers step, you may cast this spell by paying [cost] and returning an
    // unblocked creature you control to its owner's hand rather than paying this
    // spell's mana cost." [CR#702.190a] A permanent spell whose sneak cost was
    // paid enters tapped and attacking what the returned creature was attacking
    // [CR#702.190b].
    body: [
        static(
            mayPlayDeed(
                cast,
                you,
                this,
                Play(
                    None,
                    None,
                    and([asInstant, duringPart(declareBlockersStep, you)]),
                    false,
                    PayingInstead(compound([
                        Param(0),
                        perform(returnToHand(a(and([creature, unblocked, youControl])))),
                    ])),
                    None,
                ),
            ),
        ),
        static(onlyWhile(entersTapped(thisPermanent), keywordCostPaid(sneak, thisPermanent))),
        static(onlyWhile(
            entersAttacking(
                thisPermanent,
                the(and([
                    or([anyPlayer, planeswalker, hasType(Battle)]),
                    inCombat(AttackedBy, linkedObject(TheAlternative, Return, thisPermanent)),
                ])),
            ),
            keywordCostPaid(sneak, thisPermanent),
        )),
    ],
)
