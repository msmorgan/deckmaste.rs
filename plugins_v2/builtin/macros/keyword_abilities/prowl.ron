KeywordAbility(
    name: "prowl",
    params: [Cost],
    spelling: "prowl",
    grammar: FixedKeyword(
        surface: "prowl",
    ),
    // STOP. "Prowl [cost]" means "You may pay [cost] rather than pay this spell's mana
    // cost if a player was dealt combat damage this turn by a source that, at the time
    // it dealt that damage, was under your control and HAD ANY OF THIS SPELL'S CREATURE
    // TYPES." [CR#702.76a] No `Predicate` reads "shares a creature type with
    // <subject>"; the sharing comparison over a subtype axis has no constructor (the
    // cause Amplify carries).
    body: Keyword(keyword: "Prowl", params: [Cost(Param(0))], body: []),
)
