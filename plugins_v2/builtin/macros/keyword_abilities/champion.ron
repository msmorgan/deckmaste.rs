KeywordAbility(
    name: "champion",
    params: [Predicate],
    spelling: "champion <Param(0)>",
    grammar: FixedKeyword(
        surface: "champion",
        parameter: Subject(indefinite_article: true),
    ),
    // "Champion an [object]" means "When this permanent enters, sacrifice it
    // unless you exile another [object] you control" and "When this permanent
    // leaves the battlefield, return the exiled card to the battlefield under its
    // owner's control" [CR#702.72a]. The printed argument is a description, a
    // `Predicate` (Lean `KeywordParam.subject`), so the definition weaves it into
    // the larger description "another [object] you control". "The exiled card"
    // reads the first ability, the one that exiled it, a Link Source named by its
    // deed; the two abilities are linked [CR#607.2a,607.2k,702.72b].
    body: [
        triggered(
            enters(thisPermanent),
            doUnless(
                sacrifice(thisPermanent),
                perform(exile(a(and([Param(0), youControl, otherThan(thisPermanent)])))),
            ),
        ),
        triggered(
            leavesZone(thisPermanent, battlefield),
            returnToBattlefield(
                linkedObject(ByDeed(exile), exile, this),
                [Under(ownerOf(that(Card)))],
            ),
        ),
    ],
)
