KeywordAbility(
    name: "scavenge",
    params: [Cost],
    spelling: "scavenge",
    grammar: FixedKeyword(
        surface: "scavenge",
    ),
    // "Scavenge [cost]" means "[Cost], Exile this card from your graveyard: Put a
    // number of +1/+1 counters equal to the power of the card you exiled on target
    // creature. Activate only as a sorcery." [CR#702.97a]
    body: [
        activated(
            compound([Param(0), perform(exileBy(you, this, graveyardOf(you)))]),
            putCounters(
                powerOf(theVerbed(Action("Exile"), Card, Attributive, One)),
                p1p1Counter,
                target(creature),
            ),
            asSorcery,
        ),
    ],
)
