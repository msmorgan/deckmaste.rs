                                verb: Action("Exile"),
                                word: Card,
                                marking: Attributive,
                            ),
                            plurality: One,
                            window: Whole,
                        ),
                    ),
                    kind: Printed(Boost(power: Up(1), toughness: Up(1))),
                    on: Described(
                        determiner: Target(Range(low: 1, high: 1)),
                        predicate: HasType(Creature),
                    ),
                ),
                timing: AsSorcery,
                limit: None,
                guard: None,
                activator: None,
            ),
        ],
    ),
)
