    body: Keyword(
        keyword: "Scavenge",
        params: [Cost(Param(0))],
        body: [
            Activated(
                cost: Compound(
                    costs: [
                        Param(0),
                        Perform(
                            instruction: Enact(
                                verb: Action("Exile"),
                                instruction: Move(
                                    subject: This,
                                    to: Zone(zone: Exile, scope: Bare),
                                    riders: [],
                                ),
                                agent: You,
                            ),
                        ),
                    ],
                ),
                instruction: PutCounters(
                    amount: StatOf(
                        axis: Stat(Power),
                        subject: Pro(
