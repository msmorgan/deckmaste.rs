KeywordAbility(
    name: "forMirrodin",
    params: [],
    spelling: "for Mirrodin!",
    grammar: FixedKeyword(
        surface: "for Mirrodin!",
    ),
    // "For Mirrodin!" means "When this Equipment enters, create a 2/2 red Rebel
    // creature token, then attach this Equipment to it." [CR#702.163a]
    body: [
        triggered(
            enters(thisEquipment),
            sequentially([
                createToken(you, creatureToken(2, 2, [Red], [rebel])),
                // "this Equipment": a bare `This` has no zone, and an
                // attachment's subject must be on the battlefield.
                attach(thisEquipment, itAsToken),
            ]),
        ),
    ],
)
