KeywordAbility(
    name: "morph",
    params: [Cost],
    spelling: "morph <Param(0)>",
    grammar: FixedKeyword(
        surface: "morph",
    ),
    // "Morph [cost]" means "You may cast this card as a 2/2 face-down creature with no
    // text, no name, no subtypes, and no mana cost by paying {3} rather than paying its
    // mana cost." [CR#702.37a] Turning it face up for its morph cost is a special
    // action any time you have priority [CR#702.37e,116.2b]; its copiable values revert
    // [CR#708.8].
    body: [
        static(
            mayPlayDeed(
                cast,
                you,
                this,
                Play(None, None, None, false, FaceDown(faceDownCreature, mana([3]))),
            ),
        ),
        static(specialAction(None, Param(0), setStatus(FaceUp, this))),
    ],
)
