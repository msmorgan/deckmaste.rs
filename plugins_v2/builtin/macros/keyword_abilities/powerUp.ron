KeywordAbility(
    name: "powerUp",
    params: [Ability],
    spelling: "power-up — <Param(0)>",
    keyword_syntax: (head_separator: SpacedDash),
    grammar: FixedKeyword(
        surface: "power-up",
    ),
    // "Power-up — [Cost]: [Effect]" means "[Cost]: [Effect]. If this
    // permanent entered this turn, this ability's cost is reduced by this
    // permanent's mana cost. Activate this ability only once." [CR#702.193a]
    // The reduction is symbol by symbol, any excess reducing generic mana
    // [CR#702.193b,118.7].
    body: [
        qualified(ability: Param(0), limit: oncePerObject),
        static(
            onlyWhile(
                reducedBySymbols(thisAbility, manaCostOf(thisPermanent)),
                matches(thisPermanent, happenedTo(enters(relative(Object)), soFarThisTurn)),
            ),
        ),
    ],
)
