KeywordAbility(
    name: "ward",
    params: [Cost],
    spelling: "ward",
    grammar: FixedKeyword(
        surface: "ward",
    ),
    // "Ward [cost]" means "Whenever this permanent becomes the target of a spell or
    // ability an opponent controls, counter that spell or ability unless that player
    // pays [cost]." [CR#702.21a]
    body: Keyword(
        keyword: "Ward",
        params: [Cost(cost: Param(0))],
        body: [
            Triggered(
                event: BecomesTarget(
                    subject: AsMarker(marker: Permanent, subject: This),
                    by: Described(
                        determiner: A(mode: Unmarked),
                        predicate: And(
                            conjuncts: [
                                InZone(zone: Zone(zone: Stack, scope: Bare)),
                                HasPossessor(
                                    axis: Controller,
                                    possessor: PlayerGroup(group: YourOpponents),
                                ),
                            ],
                        ),
                    ),
                ),
                alternatives: [],
                r#while: None,
                joins: [],
                timing: None,
                limit: None,
                intervening: None,
                instruction: WithContinuation(
                    policy: Optional(
                        agent: PossessorOf(
                            axis: Controller,
                            subject: Pro(
                                reach: Word(word: Stack),
                                plurality: One,
                                window: Whole,
                            ),
                        ),
                    ),
                    body: Pay(
                        cost: Param(0),
                        times: Once,
                        agent: PossessorOf(
                            axis: Controller,
                            subject: Pro(
                                reach: Word(word: Stack),
                                plurality: One,
                                window: Whole,
                            ),
                        ),
                    ),
                    if_did: None,
                    if_not: Enact(
                        verb: Action(label: "Counter"),
                        instruction: Move(
                            subject: Pro(
                                reach: Word(word: Stack),
                                plurality: One,
                                window: Whole,
                            ),
                            to: Zone(zone: Graveyard, scope: Bare),
                            riders: [],
                        ),
                        agent: None,
                    ),
                ),
            ),
        ],
    ),
)
