KeywordAbility(
    name: "Infinity",
    params: [Ability],
    spelling: "∞",
    grammar: FixedKeyword(
        surface: "∞",
        onset: Vowel,
    ),
    // STOP. "∞ — [Ability]" means "As long as this permanent is harnessed, it has
    // [ability]" [CR#702.186b]. The declaration's argument is an `Ability`, and
