KeywordAbility(
    name: "overload",
    params: [Cost],
    spelling: "overload <Param(0)>",
    grammar: FixedKeyword(
        surface: "overload",
    ),
    // "Overload [cost]" means "You may choose to pay [cost] rather than pay
    // this spell's mana cost" and "If you chose to pay this spell's overload
    // cost, change its text by replacing all instances of the word 'target'
    // with the word 'each.'" [CR#702.96a] The second is a Text Change
    // [CR#702.96c,612.1].
    body: [
        static(mayCastFor(you, Param(0))),
        static(onlyWhile(textChange(thisSpell, targetToEach), keywordCostPaid(overload, thisSpell))),
    ],
)
