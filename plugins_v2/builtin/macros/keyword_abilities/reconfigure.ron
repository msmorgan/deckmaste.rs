KeywordAbility(
    name: "reconfigure",
    params: [Cost],
    spelling: "reconfigure",
    grammar: FixedKeyword(
        surface: "reconfigure",
    ),
    // "Reconfigure [cost]" means "[Cost]: Attach this permanent to another target
    // creature you control. Activate only as a sorcery" and "[Cost]: Unattach this
    // permanent. Activate only if this permanent is attached to a creature and only
    // as a sorcery." [CR#702.151a]
    body: [
        activated(
            Param(0),
            attach(thisPermanent, target(and([creature, otherThan(thisPermanent), youControl]))),
            asSorcery,
        ),
        activated(
            Param(0),
            enact(Action("Attach"), attachment(Unattached, thisPermanent)),
            asSorcery,
            matches(thisPermanent, attachment(Attachment, a(creature))),
        ),
    ],
)
