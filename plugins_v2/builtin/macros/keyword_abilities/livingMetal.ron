KeywordAbility(
    name: "livingMetal",
    params: [],
    spelling: "living metal",
    grammar: FixedKeyword(
        surface: "living metal",
    ),
    // "Living metal" means "During your turn, this permanent is an artifact creature in
    // addition to its other types." [CR#702.161a]
    body: Keyword(
        keyword: "LivingMetal",
        params: [],
        body: [
            Static(
                spec: Conditional(
                    spec: CharacteristicChange(
                        subject: AsMarker(marker: Permanent, subject: This),
                        edits: [TypeLine(op: Adds, changes: (types: [Artifact, Creature]))],
                    ),
                    condition: DuringPart(part: Turn, whose: You),
                    marking: AsLongAs,
                ),
            ),
        ],
    ),
)
