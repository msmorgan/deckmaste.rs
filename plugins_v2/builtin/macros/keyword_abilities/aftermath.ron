KeywordAbility(
    name: "aftermath",
    params: [],
    spelling: "aftermath",
    grammar: FixedKeyword(
        surface: "aftermath",
    ),
    // "Aftermath" means "You may cast this half of this split card from your
    // graveyard," "This half of this split card can't be cast from any zone other
    // than a graveyard," and "If this spell was cast from a graveyard, exile it
    // instead of putting it anywhere else any time it would leave the stack."
    // [CR#702.127a] The permission names its caster's own graveyard ("your" is the
    // would-be caster [CR#109.5]); the restriction is a separate rule over any
    // graveyard, so another player's permission to cast it from its owner's graveyard
    // still reaches this half (Cut // Ribbons ruling, 2017-04-18): it can't be cast
    // as long as it is in a zone other than a graveyard.
    body: [
        static(mayCastFrom(this, graveyardOf(you))),
        static(onlyWhile(cantDoTo(cast, actor, this), not(matches(this, inZone(graveyard))))),
        static(
            onlyWhile(
                insteadOf(leavesZone(thisSpell, stack), exile(thisSpell)),
                matches(thisSpell, castFrom(graveyard)),
            ),
        ),
    ],
)
