KeywordAbility(
    name: "exhaust",
    params: [Ability],
    spelling: "exhaust",
    grammar: FixedKeyword(
        surface: "exhaust",
    ),
    // STOP. "Exhaust — [Cost]: [Effect]" adds "Activate only once" to the activated
    // ability that FOLLOWS the keyword [CR#702.177a]. A keyword definition is a list
    // of abilities of its own; nothing lets one qualify the ability printed after
    // it (the cause Backup and Cleave share).
    body: Keyword(keyword: "Exhaust", params: [], body: []),
)
