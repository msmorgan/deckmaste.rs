KeywordAbility(
    name: "exhaust",
    params: [Ability],
    spelling: "exhaust — <Param(0)>",
    keyword_syntax: (head_separator: SpacedDash),
    grammar: FixedKeyword(
        surface: "exhaust",
    ),
    // "Exhaust — [Cost]: [Effect]" means "[Cost]: [Effect]. Activate only
    // once." [CR#702.177a] The limit lasts as long as the object does
    // [CR#602.5b].
    body: [qualified(ability: Param(0), limit: oncePerObject)],
)
