KeywordAbility(
    name: "exhaust",
    params: [Ability],
    spelling: "exhaust — <Param(0)>",
    keyword_syntax: (head_separator: SpacedDash),
    grammar: FixedKeyword(
        surface: "exhaust",
    ),
    // STOP (waits on: `semantics-v2-ability-qualifiers`).
    // "Exhaust — [Cost]: [Effect]" adds "Activate only once" to the activated
    // ability that FOLLOWS the keyword [CR#702.177a]. A keyword definition is a list
    // of abilities of its own; nothing lets one qualify the ability printed after
    // it (the cause Backup and Cleave share).
)
