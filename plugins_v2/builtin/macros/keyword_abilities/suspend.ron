KeywordAbility(
    name: "suspend",
    params: [Amount, Cost],
    spelling: "suspend <Param(0)>—<Param(1)>",
    keyword_syntax: (parameter_separator: Dash),
    grammar: FixedKeyword(
        surface: "suspend",
        participial_adjective: (),
    ),
    // STOP (waits on: a "could begin to cast" condition and a "suspended" predicate).
    // Suspend's first ability is a special action, writable as
    // `specialAction(<when>, Param(1), exile(this) with Param(0) time counters)` with
    // the counters a `Placement(WithCounters(…))` [CR#702.62a,116.2f], but its `when`
    // is "if you could begin to cast this card by putting it onto the stack from your
    // hand": a counterfactual over the casting procedure, which no `Timing` or
    // `Condition` reads (the temporal suite's `onlyIf` takes a condition, and none
    // says "could begin to cast"). Its second and third abilities (upkeep counter
    // removal, the last-counter trigger) read "if this card is suspended", which
    // nothing names either, and a definition cannot depend on a half that is not
    // written.
)
