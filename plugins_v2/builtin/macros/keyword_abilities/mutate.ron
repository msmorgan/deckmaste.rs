KeywordAbility(
    name: "mutate",
    params: [Cost],
    spelling: "mutate <Param(0)>",
    grammar: FixedKeyword(
        surface: "mutate",
    ),
    // "Mutate [cost]" means "You may pay [cost] rather than pay this spell's
    // mana cost. If you do, it becomes a mutating creature spell and targets a
    // non-Human creature with the same owner as this spell." [CR#702.140a]
    // The target is the one the spell gains with its alternative cost
    // (`addsTarget`), read back as the `objects` Linked Facet of that cost's
    // targeting. As it resolves with a legal target it merges with that
    // creature instead of entering, on top or under as its controller
    // chooses [CR#702.140c,730.2].
    body: [
        static(mayCastFor(you, Param(0))),
        static(addsTarget(thisSpell, and([creature, not(hasSubtype(human)), ownedBy(ownerOf(thisSpell))]))),
        static(
            onlyWhile(
                insteadOf(
                    enters(thisSpell),
                    chooseOne(
                        merge(thisSpell, linkedObject(TheAlternative, Target, thisSpell), Top),
                        merge(thisSpell, linkedObject(TheAlternative, Target, thisSpell), Bottom),
                    ),
                ),
                keywordCostPaid(mutate, thisSpell),
            ),
        ),
    ],
)
