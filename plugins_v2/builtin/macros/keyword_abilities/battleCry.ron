KeywordAbility(
    name: "battleCry",
    params: [],
    spelling: "battle cry",
    grammar: FixedKeyword(
        surface: "battle cry",
    ),
    // "Battle cry" means "Whenever this creature attacks, each other attacking
    // creature gets +1/+0 until end of turn." [CR#702.91a]
    body: [
        triggered(
            attacks(thisCreature),
            establish(
                modification(
                    each(and([creature, attacking, otherThan(thisCreature)])),
                    Power,
                    up(1),
                ),
                untilEndOfTurn,
            ),
        ),
    ],
)
