KeywordAbility(
    name: "bushido",
    params: [Amount],
    spelling: "bushido",
    grammar: FixedKeyword(
        surface: "bushido",
    ),
    // "Bushido N" means "Whenever this creature blocks or becomes blocked, it gets
    // +N/+N until end of turn." [CR#702.45a]
    body: [
        triggeredOr(
            blocks(thisCreature),
            [becomesBlocked(thisCreature)],
            gets(thisCreature, up(Param(0)), up(Param(0)), untilEndOfTurn),
        ),
    ],
)
