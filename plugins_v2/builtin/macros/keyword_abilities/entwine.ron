KeywordAbility(
    name: "entwine",
    params: [Cost],
    spelling: "entwine <Param(0)>",
    grammar: FixedKeyword(
        surface: "entwine",
    ),
    // "Entwine [cost]" means "You may choose all modes of this spell instead of
    // just the number specified. If you do, you pay an additional [cost]."
    // [CR#702.42a] A Mode Change over the spell's own `chooseModes`.
    body: [static(modeChoice(allInstead(Some(Param(0)), None)))],
)
