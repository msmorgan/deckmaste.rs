KeywordAbility(
    name: "dredge",
    params: [Amount],
    spelling: "dredge",
    grammar: FixedKeyword(
        surface: "dredge",
    ),
    // "Dredge N" means "As long as you have at least N cards in your library, if you
    // would draw a card, you may instead mill N cards and return this card from your
    // graveyard to your hand." [CR#702.52a]
    body: [
        static(
            onlyWhile(
                insteadOf(
                    draws(you),
                    may(
                        you,
                        sequentially([
                            mill(Param(0), you, you),
                            returnToHand(you, this, graveyardOf(you)),
                        ]),
                    ),
                ),
                compareAmt(countOf(cardIn(yourLibrary)), AtLeast, Param(0)),
            ),
        ),
    ],
)
