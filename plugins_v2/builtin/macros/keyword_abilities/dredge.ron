KeywordAbility(
    name: "dredge",
    params: [Amount],
    spelling: "dredge",
    grammar: FixedKeyword(
        surface: "dredge",
    ),
    // "Dredge N" means "As long as you have at least N cards in your library, if you
    // would draw a card, you may instead mill N cards and return this card from your
    // graveyard to your hand." [CR#702.52a]
    body: Keyword(
        keyword: "Dredge",
        params: [Number(amount: Param(0))],
        body: [
            Static(
                spec: Conditional(
                    spec: Replacement(
                        event: Draws(player: You),
                        alternatives: [],
                        timing: None,
                        replacement: WithContinuation(
                            policy: Optional(agent: You),
                            body: Sequentially(
                                steps: [
                                    Enact(
                                        verb: Action(label: "Mill"),
                                        instruction: Move(
                                            subject: LibrarySlice(
                                                end: Top,
                                                amount: Param(0),
                                                whose: You,
                                            ),
                                            to: Zone(zone: Graveyard, scope: Bare),
                                            riders: [],
                                        ),
                                        agent: You,
                                    ),
                                    Enact(
                                        verb: Core(deed: Return),
                                        instruction: Move(
                                            subject: This,
                                            to: Zone(zone: Hand, scope: Bare),
                                            riders: [],
                                        ),
                                        agent: You,
                                    ),
                                ],
                            ),
                            if_did: None,
                            if_not: None,
                        ),
                        r#use: Repeatedly,
                        limit: None,
                    ),
                    condition: CompareAmt(
                        subject: CountOf(
                            group: Described(
                                determiner: Bare,
                                predicate: And(
                                    conjuncts: [
                                        IsCard,
                                        InZone(
                                            zone: Zone(
                                                zone: Library,
                                                scope: PossessedBy(possessor: You),
                                            ),
                                        ),
                                    ],
                                ),
                            ),
                        ),
                        comparator: AtLeast,
                        bound: Param(0),
                    ),
                    marking: AsLongAs,
                ),
            ),
        ],
    ),
)
