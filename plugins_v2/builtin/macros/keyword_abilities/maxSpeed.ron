KeywordAbility(
    name: "maxSpeed",
    params: [Ability],
    spelling: "max speed — <Param(0)>",
    keyword_syntax: (head_separator: SpacedDash),
    grammar: FixedKeyword(
        surface: "max speed",
    ),
    // "Max speed — [Ability]" means "As long as your speed is 4, this object
    // has '[Ability].'" [CR#702.178a] Speed is a player's
    // [CR#702.179a]; the engine keeps it (`engine-speed`).
    body: [static(onlyWhile(abilityGrant(this, Param(0)), compareAmt(speedOf(you), Eq, 4)))],
)
