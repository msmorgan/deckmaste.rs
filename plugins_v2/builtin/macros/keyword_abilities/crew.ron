KeywordAbility(
    name: "crew",
    params: [Amount],
    spelling: "crew <Param(0)>",
    grammar: FixedKeyword(
        surface: "crew",
    ),
    // "Crew N" means "Tap any number of other untapped creatures you control with
    // total power N or greater: This permanent becomes an artifact creature until
    // end of turn." [CR#702.122a]
    body: [
        activated(
            perform(
                tap(
                    withTotal(
                        Stat(Power),
                        AtLeast,
                        Param(0),
                        allOf(and([untapped, otherCreatureYouControl(thisPermanent)])),
                    ),
                ),
            ),
            establish(
                characteristicChange(thisPermanent, [TypeLine(Adds, (types: [Artifact, Creature]))]),
                untilEndOfTurn,
            ),
        ),
    ],
)
