KeywordAbility(
    name: "disturb",
    params: [Cost],
    spelling: "disturb",
    grammar: FixedKeyword(
        surface: "disturb",
    ),
    // STOP. "Disturb [cost]" means "You may cast this card TRANSFORMED from your
    // graveyard by paying [cost] rather than its mana cost" [CR#702.146a].
    // `DeonticRider::Play` has no clause for casting a card transformed.
    body: Keyword(keyword: "Disturb", params: [Cost(cost: Param(0))], body: []),
)
