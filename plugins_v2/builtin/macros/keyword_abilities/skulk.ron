KeywordAbility(
    name: "skulk",
    params: [],
    spelling: "skulk",
    grammar: FixedKeyword(
        surface: "skulk",
    ),
    // "A creature with skulk can't be blocked by creatures with greater power."
    // [CR#702.118b]
    body: Keyword(
        keyword: "Skulk",
        params: [],
        body: [
            Static(
                spec: DeonticRule(
                    subject: AsType(type: Creature, subject: This, subtype: None),
                    compulsion: Forbid,
                    deeds: [Core(deed: Block)],
                    role: Patient,
                    bound: None,
                    patient: Counterpart(
                        patient: Described(
                            determiner: All,
                            predicate: And(
                                conjuncts: [
                                    HasType(type: Creature),
                                    Compare(
                                        axes: [Stat(stat: Power)],
                                        comparator: Greater,
                                        bound: StatOf(
                                            axis: Stat(stat: Power),
                                            subject: AsType(
                                                type: Creature,
                                                subject: This,
                                                subtype: None,
                                            ),
                                        ),
                                    ),
                                ],
                            ),
                        ),
                    ),
                    as_though: None,
                    rider: NoRider,
                ),
            ),
        ],
    ),
)
