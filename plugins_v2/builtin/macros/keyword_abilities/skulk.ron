KeywordAbility(
    name: "skulk",
    params: [],
    spelling: "skulk",
    grammar: FixedKeyword(
        surface: "skulk",
    ),
    // "A creature with skulk can't be blocked by creatures with greater power."
    // [CR#702.118b]
    body: [
        static(
            cantBeBlockedBy(
                thisCreature,
                and([creature, compare([Stat(Power)], Greater, powerOf(thisCreature))]),
            ),
        ),
    ],
)
