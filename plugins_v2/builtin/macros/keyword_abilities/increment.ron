KeywordAbility(
    name: "increment",
    params: [],
    spelling: "increment",
    grammar: FixedKeyword(
        surface: "increment",
    ),
    // "Increment" means "Whenever you cast a spell, if this permanent is a creature and
    // the amount of mana spent to cast that spell is greater than this creature's power
    // or this creature's toughness, put a +1/+1 counter on this creature."
    // [CR#702.191a]
    body: [
        triggeredIf(
            casts(you, a(spell)),
            and([
                matches(thisPermanent, creature),
                or([
                    compareAmt(manaValueSpentToCast(that(Spell)), Greater, powerOf(thisCreature)),
                    compareAmt(
                        manaValueSpentToCast(that(Spell)),
                        Greater,
                        toughnessOf(thisCreature),
                    ),
                ]),
            ]),
            putCounters(1, p1p1Counter, thisCreature),
        ),
    ],
)
