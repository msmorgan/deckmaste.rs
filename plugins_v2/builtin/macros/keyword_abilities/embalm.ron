KeywordAbility(
    name: "embalm",
    params: [Cost],
    spelling: "embalm",
    grammar: FixedKeyword(
        surface: "embalm",
    ),
    // "Embalm [cost]" means "[Cost], Exile this card from your graveyard: Create a
    // token that's a copy of this card, except it's white, it has no mana cost, and
    // it's a Zombie in addition to its other types. Activate only as a sorcery."
    // [CR#702.128a]
    body: [
        activated(
            compound([Param(0), perform(exileFrom(this, graveyardOf(you)))]),
            create(
                1,
                copyOf(
                    this,
                    [
                        Edits([
                            Colors(Sets, Some([White])),
                            ManaCost(None),
                            TypeLine(Adds, (subtypes: [zombie])),
                        ]),
                    ],
                ),
            ),
            asSorcery,
        ),
    ],
)
