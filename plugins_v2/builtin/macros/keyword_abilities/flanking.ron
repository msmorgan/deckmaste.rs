KeywordAbility(
    name: "flanking",
    params: [],
    spelling: "flanking",
    grammar: FixedKeyword(
        surface: "flanking",
    ),
    // "Flanking" means "Whenever this creature becomes blocked by a creature without
    // flanking, the blocking creature gets -1/-1 until end of turn."
    // [CR#702.25a]
    // "The blocking creature" is the participant the trigger bound, so it reads as a
    // pronoun: `the` needs a uniquifying predicate and `blockerOf` is not one.
    body: Keyword(
        keyword: "Flanking",
        params: [],
        body: [
            Triggered(
                event: Combat(
                    relation: BlockedBy,
                    subject: AsType(type: Creature, subject: This, subtype: None),
                    counterpart: Described(
                        determiner: A(mode: Unmarked),
                        predicate: And(
                            conjuncts: [
                                HasType(type: Creature),
                                Not(predicate: HasKeyword(keyword: The(keyword: "Flanking"))),
                            ],
                        ),
                    ),
                ),
                alternatives: [],
                r#while: None,
                joins: [],
                timing: None,
                limit: None,
                intervening: None,
                instruction: Establish(
                    spec: Conjunction(
                        subject: None,
                        parts: [
                            Modification(
                                subject: Pro(
                                    reach: Word(word: Type(type: Creature)),
                                    plurality: One,
                                    window: Whole,
                                ),
                                stat: Power,
                                delta: Down(amount: Lit(value: 1)),
                            ),
                            Modification(
                                subject: Pro(
                                    reach: Word(word: Type(type: Creature)),
                                    plurality: One,
                                    window: Whole,
                                ),
                                stat: Toughness,
                                delta: Down(amount: Lit(value: 1)),
                            ),
                        ],
                    ),
                    duration: Until(end: EndOf(part: Turn, whose: None)),
                ),
            ),
        ],
    ),
)
