KeywordAbility(
    name: "cycling",
    params: [Cost],
    spelling: "cycling <Param(0)>",
    grammar: FixedKeyword(
        surface: "cycling",
    ),
    // "Cycling [cost]" means "[Cost], Discard this card: Draw a card."
    // [CR#702.29a]
    body: [
        activated(compound([Param(0), perform(discard(this))]), draw(1)),
    ],
)
