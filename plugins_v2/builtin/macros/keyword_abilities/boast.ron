KeywordAbility(
    name: "boast",
    params: [Ability],
    spelling: "boast — <Param(0)>",
    keyword_syntax: (head_separator: SpacedDash),
    grammar: FixedKeyword(
        surface: "boast",
    ),
    // "Boast — [Cost]: [Effect]" means "[Cost]: [Effect]. Activate only if
    // this creature attacked this turn and only once each turn." [CR#702.142a]
    body: [
        qualified(
            ability: Param(0),
            limit: oncePerTurn,
            guard: matches(thisCreature, happenedTo(attacks(relative(Object)), soFarThisTurn)),
        ),
    ],
)
