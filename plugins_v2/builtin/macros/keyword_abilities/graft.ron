KeywordAbility(
    name: "graft",
    params: [Amount],
    spelling: "graft",
    grammar: FixedKeyword(
        surface: "graft",
    ),
    // "Graft N" means "This permanent enters with N +1/+1 counters on it" and
    // "Whenever another creature enters, if this permanent has a +1/+1 counter on it,
    // you may move a +1/+1 counter from this permanent onto that creature."
    // [CR#702.58a]
    body: [
        static(entersWithCounters(thisPermanent, Param(0), p1p1Counter)),
        triggeredIf(
            enters(a(otherCreature(thisPermanent))),
            matches(thisPermanent, hasCounters(p1p1Counter)),
            may(you, moveCounters(1, p1p1Counter, thisPermanent, that(Creature))),
        ),
    ],
)
