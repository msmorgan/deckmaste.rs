KeywordAbility(
    name: "spree",
    params: [],
    spelling: "spree",
    grammar: FixedKeyword(
        surface: "spree",
    ),
    // "Spree" means "Choose one or more modes. As an additional cost to cast
    // this spell, pay the costs associated with those modes." [CR#702.172a]
    // The modes carry their own costs [CR#700.2h]; the keyword sets how many
    // are chosen.
    body: [static(modeChoice(setQuantity(atLeast(1))))],
)
