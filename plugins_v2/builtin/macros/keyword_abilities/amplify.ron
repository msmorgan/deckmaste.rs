KeywordAbility(
    name: "amplify",
    params: [Amount],
    spelling: "amplify <Param(0)>",
    grammar: FixedKeyword(
        surface: "amplify",
    ),
    // "Amplify N" means "As this object enters, reveal any number of cards from
    // your hand that share a creature type with it. This permanent enters with N
    // +1/+1 counters on it for each card revealed this way. You can't reveal this
    // card or any other cards that are entering the battlefield at the same time
    // as this card." [CR#702.38a] An Off-Stack Static as it enters, over the
    // existing entry rider; the revealed cards are read back as "them", since the
    // reveal deed stamps no patient for `theVerbed`. The last sentence is the
    // reveal's own domain: the cards revealed are in your hand, so neither this
    // card nor one entering with it is among them.
    body: [
        static(
            asEvent(
                enters(thisPermanent),
                sequentially([
                    revealCards(counted(anyNumber, and([cardIn(yourHand), shares(Subtype(Creature), Share, thisPermanent)]))),
                    establish(entersWithCounters(thisPermanent, times(Param(0), numberOf(them)), p1p1Counter)),
                ]),
            ),
        ),
    ],
)
