KeywordAbility(
    name: "levelUp",
    params: [Cost],
    spelling: "level up",
    grammar: FixedKeyword(
        surface: "level up",
        block_label: (surface: "LEVEL"),
    ),
    // "Level up [cost]" means "[Cost]: Put a level counter on this permanent. Activate
    // only as a sorcery." [CR#702.87a]
    body: [
        activated(Param(0), putCounters(1, levelCounter, thisPermanent), asSorcery),
    ],
)
