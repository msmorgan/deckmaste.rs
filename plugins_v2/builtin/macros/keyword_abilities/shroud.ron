KeywordAbility(
    name: "shroud",
    params: [],
    spelling: "shroud",
    grammar: FixedKeyword(
        surface: "shroud",
    ),
    // "Shroud" means "This permanent or player can't be the target of spells or
    // abilities." [CR#702.18a] The body is written over its holder (`this`), a
    // permanent or a player granted it.
    body: [
        static(objectCant(Target, this)),
    ],
)
