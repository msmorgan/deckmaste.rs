KeywordAbility(
    name: "transmute",
    params: [Cost],
    spelling: "transmute",
    grammar: FixedKeyword(
        surface: "transmute",
    ),
    // "Transmute [cost]" means "[Cost], Discard this card: Search your library for a
    // card with the same mana value as the discarded card, reveal that card, and put
    // it into your hand. Then shuffle your library. Activate only as a sorcery."
    // [CR#702.53a]
    body: [
        activated(
            compound([Param(0), perform(discard(this))]),
            sequentially([
                searchLibraryFor(
                    exactly(1),
                    and([
                        card,
                        compare(
                            Eq,
                            statOf(
                                Stat(ManaValue),
                                theVerbed(discard, One, Card),
                            ),
                            [Stat(ManaValue)],
                        ),
                    ]),
                ),
                reveal(theVerbed(search, One)),
                move(theVerbed(search, One), wherever, hand),
                shuffle,
            ]),
            asSorcery,
        ),
    ],
)
