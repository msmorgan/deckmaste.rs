KeywordAbility(
    name: "transmute",
    params: [Cost],
    spelling: "transmute",
    grammar: FixedKeyword(
        surface: "transmute",
    ),
    // "Transmute [cost]" means "[Cost], Discard this card: Search your library for a
    // card with the same mana value as the discarded card, reveal that card, and put
    // it into your hand. Then shuffle your library. Activate only as a sorcery."
    // [CR#702.53a]
    body: [
        activated(
            compound([Param(0), perform(discard(this))]),
            sequentially([
                searchLibraryFor(
                    exactly(1),
                    and([
                        isCard,
                        compare(
                            [Stat(ManaValue)],
                            Eq,
                            statOf(
                                Stat(ManaValue),
                                theVerbed(Action("Discard"), Card, Attributive, One),
                            ),
                        ),
                    ]),
                ),
                reveal(Pro(Bare, One, top(1)), you),
                move(Pro(Bare, One, top(1)), wherever, hand),
                shuffle(you),
            ]),
            asSorcery,
        ),
    ],
)
