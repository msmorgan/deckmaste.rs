KeywordAbility(
    name: "foretell",
    params: [Cost],
    spelling: "foretell <Param(0)>",
    grammar: FixedKeyword(
        surface: "foretell",
    ),
    // Foretell [cost]: "Any time a player has priority during their turn, that player
    // may pay {2} and exile a card with foretell from their hand face down. That player
    // may look at that card as long as it remains in exile. They may cast that card after
    // the current turn has ended by paying any foretell cost it has rather than paying
    // that spell's mana cost." [CR#702.143a] The exile is a special action
    // [CR#702.143b,116.2h] that names the hand, so the ability functions only there
    // [CR#113.6m]; after it the card is a new object, read back as `it` (§7, ruling
    // 2026-10-08). It then becomes a foretold card [CR#702.143c,702.143d], an event
    // distinct from the special action, and both permissions are keyed on that state:
    // the look right is `visibility` [CR#406.3].
    body: [
        static(
            specialAction(
                duringPart(Turn, you),
                mana([2]),
                sequentially([
                    exileFaceDownFrom(this, yourHand),
                    gainDesignation(it, foretold),
                    establish(visibility(LookAt, you, Objects(it)), forAsLongAs(matches(it, hasDesignation(foretold)))),
                    establish(
                        onlyWhile(
                            mayPlayDeed(cast, you, it, Play(exileZone, None, None, false, PayingInstead(Param(0)), None)),
                            matches(it, hasDesignation(foretold)),
                        ),
                        onALaterTurn,
                    ),
                ]),
            ),
        ),
    ],
)
