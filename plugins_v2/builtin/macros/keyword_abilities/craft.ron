KeywordAbility(
    name: "craft",
    params: [Cost],
    spelling: "craft <Param(0)>",
    grammar: FixedKeyword(
        surface: "craft",
    ),
    // STOP (waits on: a second parameter for craft's materials).
    // "Craft with [materials] [cost]" [CR#702.167a] takes the materials
    // description as a second argument; the declaration's signature is `[Cost]`
    // alone, so the exile cost over "permanents you control and/or cards in your
    // graveyard" has no parameter to read.
)
