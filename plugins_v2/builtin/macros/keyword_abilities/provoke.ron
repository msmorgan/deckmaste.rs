KeywordAbility(
    name: "provoke",
    params: [],
    spelling: "provoke",
    grammar: FixedKeyword(
        surface: "provoke",
    ),
    // "Provoke" means "Whenever this creature attacks, you may choose to have target
    // creature defending player controls block this creature this combat if able. If
    // you do, untap that creature." [CR#702.39a]
    body: [
        triggered(
            attacks(thisCreature),
            may(
                you,
                establish(
                    deontic(
                        target(and([creature, controlledBy(defendingPlayer)])),
                        Require,
                        [Block],
                        Agent,
                        Counterpart(thisCreature),
                    ),
                    untilEndOfCombat,
                ),
                untap(that(Creature)),
            ),
        ),
    ],
)
