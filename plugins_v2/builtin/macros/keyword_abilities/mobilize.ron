KeywordAbility(
    name: "mobilize",
    params: [Amount],
    spelling: "mobilize",
    grammar: FixedKeyword(
        surface: "mobilize",
    ),
    // "Mobilize N" means "Whenever this creature attacks, create N 1/1 red Warrior
    // creature tokens. Those tokens enter tapped and attacking. Sacrifice them at
    // the beginning of the next end step." [CR#702.181a]
    body: [
        triggered(
            attacks(thisCreature),
            sequentially([
                createTappedAttacking(you, Param(0), creatureToken(1, 1, [Red], [warrior])),
                atNext(EndStep, sacrifice(themAsTokens, you)),
            ]),
        ),
    ],
)
