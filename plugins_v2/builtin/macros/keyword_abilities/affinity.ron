KeywordAbility(
    name: "affinity",
    params: [Quality],
    spelling: "affinity",
    grammar: FixedKeyword(
        surface: "affinity",
        parameter: Quality(
            preposition: ("Preposition", "For"),
            nominal_number: Plural,
        ),
    ),
    // "Affinity for [text]" means "This spell costs {1} less to cast for each
    // [text] you control." [CR#702.41a]
    body: [
        static(costShift(thisSpell, Less(forEach(1, and([Param(0), youControl])), None))),
    ],
)
