KeywordAbility(
    name: "extort",
    params: [],
    spelling: "extort",
    grammar: FixedKeyword(
        surface: "extort",
    ),
    // Extort is a triggered ability. “Extort” means “Whenever you cast a
    // spell, you may pay {W/B}. If you do, each opponent loses 1 life and you
    // gain life equal to the total life lost this way.” [CR#702.101a]
    body: [
        triggered(
            casts(you, a(spell)),
            may(
                pay(mana([Hybrid(White, Black)]), Once),
                // The loss is handed to each opponent; the handoff publishes
                // the life lost as one total, which `thatMuch` reads.
                sequentially([act(each(opponent), loseLife(1)), gainLife(thatMuch)]),
            ),
        ),
    ],
)
