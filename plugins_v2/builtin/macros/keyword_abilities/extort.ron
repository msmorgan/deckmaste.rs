KeywordAbility(
    name: "extort",
    params: [],
    spelling: "extort",
    grammar: FixedKeyword(
        surface: "extort",
    ),
    // "Extort" means "Whenever you cast a spell, you may pay {W/B}. If you do, each
    // opponent loses 1 life and you gain life equal to the total life lost this way."
    // [CR#702.101a]
    body: [
        triggered(
            casts(you, a(spell)),
            may(
                you,
                pay(mana([Hybrid(White, Black)]), Once, you),
                // The opponents' loss is written with its group performer
                // rather than handed off: `act(each(opponent), loseLife(1))`
                // leaves "the total life lost this way" no outcome in scope
                // (Lean refusal `quantOutcomeInScope 0`).
                sequentially([changeLife(down(1), each(opponent)), gainLife(thatMuch)]),
            ),
        ),
    ],
)
