KeywordAbility(
    name: "surge",
    params: [Cost],
    spelling: "surge",
    grammar: FixedKeyword(
        surface: "surge",
    ),
    // "Surge [cost]" means "You may pay [cost] rather than pay this spell's mana cost
    // as you cast this spell if you or one of your teammates has cast another spell
    // this turn." [CR#702.117a] "You or one of your teammates" is the group
    // `PlayerGroupWord::YourTeam` names.
    body: [
        static(
            onlyWhile(
                mayCastFor(you, Param(0)),
                happened(casts(gap(Player), a(anotherSpell)), playerGroup(YourTeam), ThisTurn),
            ),
        ),
    ],
)
