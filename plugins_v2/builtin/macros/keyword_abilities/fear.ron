KeywordAbility(
    name: "fear",
    params: [],
    spelling: "fear",
    grammar: FixedKeyword(
        surface: "fear",
    ),
    // "A creature with fear can't be blocked except by artifact creatures and/or
    // black creatures." [CR#702.36b] The exempt blockers are the prohibition's
    // Deontic Exception.
    body: [
        static(cantBeBlockedExceptBy(thisCreature, and([creature, or([artifact, colorIs(Black)])]))),
    ],
)
