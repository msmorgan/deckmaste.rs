KeywordAbility(
    name: "horsemanship",
    params: [],
    spelling: "horsemanship",
    grammar: FixedKeyword(
        surface: "horsemanship",
    ),
    // "A creature with horsemanship can't be blocked by creatures without
    // horsemanship." [CR#702.31b]
    body: [
        static(cantBeBlockedBy(thisCreature, and([creature, not(hasKeyword(The("Horsemanship")))]))),
    ],
)
