KeywordAbility(
    name: "persist",
    params: [],
    spelling: "persist",
    grammar: FixedKeyword(
        surface: "persist",
    ),
    // "Persist" means "When this permanent is put into a graveyard from the
    // battlefield, if it had no -1/-1 counters on it, return it to the battlefield
    // under its owner's control with a -1/-1 counter on it." [CR#702.79a]
    body: Keyword(
        keyword: "Persist",
        params: [],
        body: [
            Triggered(
                event: ZoneChange(
                    subject: AsMarker(marker: Permanent, subject: This),
                    from: Zones([Zone(zone: Battlefield, scope: Bare)]),
                    to: Zone(zone: Graveyard, scope: Bare),
                    observation: Before,
                ),
                alternatives: [],
                r#while: None,
                joins: [],
                timing: None,
                limit: None,
                intervening: Not(
                    condition: Matches(
                        subject: AsMarker(marker: Permanent, subject: This),
                        predicate: HasCounters(
                            kind: Boost(power: Down(1), toughness: Down(1)),
                        ),
                    ),
                ),
                instruction: Enact(
                    verb: Core(Return),
                    instruction: Move(
                        subject: AsMarker(marker: Permanent, subject: This),
                        to: Zone(zone: Battlefield, scope: Bare),
                        riders: [
                            Under(
                                controller: PossessorOf(
                                    axis: Owner,
                                    subject: AsMarker(marker: Permanent, subject: This),
                                ),
                            ),
                            WithCounters(
                                amount: 1,
                                kind: Printed(
                                    kind: Boost(
                                        power: Down(1),
                                        toughness: Down(1),
                                    ),
                                ),
                                mark: Fresh,
                            ),
                        ],
                    ),
                    agent: None,
                ),
            ),
        ],
    ),
)
