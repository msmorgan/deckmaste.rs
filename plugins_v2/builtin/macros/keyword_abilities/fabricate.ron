KeywordAbility(
    name: "fabricate",
    params: [Amount],
    spelling: "fabricate",
    grammar: FixedKeyword(
        surface: "fabricate",
    ),
    // "Fabricate N" means "When this permanent enters, you may put N +1/+1 counters on
    // it. If you don't, create N 1/1 colorless Servo artifact creature tokens."
    // [CR#702.123a]
    body: [
        triggered(
            enters(thisPermanent),
            mayOrElse(
                putCounters(Param(0), p1p1Counter, thisPermanent),
                createToken(artifactCreatureToken(1, 1, [], [servo]), Param(0)),
            ),
        ),
    ],
)
