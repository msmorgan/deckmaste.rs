        keyword: "Fabricate",
        params: [Number(amount: Param(0))],
        body: [
            Triggered(
                event: ZoneChange(
                    subject: AsMarker(marker: Permanent, subject: This),
                    from: None,
                    to: Zone(zone: Battlefield, scope: Bare),
                    observation: After,
                ),
                alternatives: [],
                r#while: None,
                joins: [],
                timing: None,
                limit: None,
                intervening: None,
                instruction: WithContinuation(
                    policy: Optional(agent: You),
                    body: PutCounters(
                        amount: Param(0),
                        kind: Printed(kind: Boost(power: Up(amount: 1), toughness: Up(amount: 1))),
                        on: AsMarker(marker: Permanent, subject: This),
                    ),
                    if_did: None,
                    if_not: CreateObject(
