KeywordAbility(
    name: "fading",
    params: [Amount],
    spelling: "fading",
    grammar: FixedKeyword(
        surface: "fading",
    ),
    // "Fading N" means "This permanent enters with N fade counters on it" and "At the
    // beginning of your upkeep, remove a fade counter from this permanent. If you
    // can't, sacrifice the permanent." [CR#702.32a]
    body: Keyword(
        keyword: "Fading",
        params: [Number(Param(0))],
        body: [
            Static(
                spec: EntryRider(
                    subject: AsMarker(marker: Permanent, subject: This),
                    rider: WithCounters(
                        amount: Param(0),
                        kind: Printed(Named("Fade")),
                        mark: Fresh,
                    ),
                ),
            ),
            Triggered(
                event: BeginningOf(quantifier: The, part: Upkeep, whose: ByPlayer(You)),
                alternatives: [],
                r#while: None,
                joins: [],
                timing: None,
                limit: None,
                intervening: None,
                instruction: WithContinuation(
                    policy: Required,
                    body: RemoveCounters(
                        quantity: Range(low: 1, high: 1),
                        kind: Printed(Named("Fade")),
                        from: AsMarker(marker: Permanent, subject: This),
                    ),
                    if_did: None,
                    if_not: Enact(
                        verb: Action("Sacrifice"),
                        instruction: Move(
                            subject: AsMarker(marker: Permanent, subject: This),
                            to: Zone(zone: Graveyard, scope: Bare),
                            riders: [],
                        ),
                        agent: You,
                    ),
                ),
            ),
        ],
    ),
)
