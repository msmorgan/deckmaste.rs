KeywordAbility(
    name: "fading",
    params: [Amount],
    spelling: "fading",
    grammar: FixedKeyword(
        surface: "fading",
    ),
    // "Fading N" means "This permanent enters with N fade counters on it" and "At the
    // beginning of your upkeep, remove a fade counter from this permanent. If you
    // can't, sacrifice the permanent." [CR#702.32a]
    body: [
        static(entersWithCounters(thisPermanent, Param(0), fadeCounter)),
        triggered(
            beginningOfYour(Upkeep),
            doIfDone(
                body: removeCounters(exactly(1), fadeCounter, thisPermanent),
                if_not: sacrifice(thisPermanent),
            ),
        ),
    ],
)
