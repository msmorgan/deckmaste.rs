KeywordAbility(
    name: "tribute",
    params: [Amount],
    spelling: "tribute <Param(0)>",
    grammar: FixedKeyword(
        surface: "tribute",
    ),
    // "Tribute N" means "As this creature enters, choose an opponent. That player
    // may put an additional N +1/+1 counters on it as it enters." [CR#702.104a] An
    // Off-Stack Static as it enters, the chosen opponent deciding the entry rider.
    // "Tribute wasn't paid" [CR#702.104b] is `not(choiceWasTaken(ByKeyword(tribute),
    // …))` (Snake of the Golden Grove).
    body: [
        static(
            asEvent(
                enters(thisCreature),
                sequentially([
                    choose(anOpponent),
                    act(
                        the(chosenPlayer),
                        may(establish(entersWithAdditionalCounters(thisCreature, Param(0), p1p1Counter))),
                    ),
                ]),
            ),
        ),
    ],
)
