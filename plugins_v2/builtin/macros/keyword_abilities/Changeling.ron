KeywordAbility(
    name: "Changeling",
    params: [],
    spelling: "changeling",
    grammar: FixedKeyword(
        surface: "changeling",
    ),
    // "Changeling" means "This object is every creature type." [CR#702.73a] A
    // characteristic-defining ability, so it is static [CR#604.3].
    body: Keyword(
        keyword: "Changeling",
        params: [],
        body: [
            Static(
                spec: CharacteristicChange(
                    subject: AsType(type: Creature, subject: This, subtype: None),
                    edits: [EveryTypeOf(op: Adds, space: Creature)],
                ),
            ),
        ],
    ),
)
