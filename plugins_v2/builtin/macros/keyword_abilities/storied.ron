KeywordAbility(
    name: "storied",
    params: [],
    spelling: "storied",
    grammar: FixedKeyword(
        surface: "storied",
    ),
    // "Storied" means "Any time you control three or more permanents that are
    // artifacts, Sagas, and/or legendary and you don't have an enduring story, you
    // have an enduring story for the rest of the game." [CR#702.195a] An Off-Stack
    // Static whose instruction never uses the stack, the shape of ascend's.
    body: [
        static(
            whileHolds(
                and([
                    compareAmt(
                        countOf(
                            and([
                                permanent,
                                youControl,
                                or([artifact, hasSubtype(enchantmentType("Saga")), hasSupertype(Legendary)]),
                            ]),
                        ),
                        AtLeast,
                        3,
                    ),
                    not(matches(you, hasDesignation(enduringStory))),
                ]),
                gainDesignation(you, enduringStory, restOfGame),
            ),
        ),
    ],
)
