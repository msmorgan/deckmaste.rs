// `Predicate.HasPossessor` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "hasPossessor",
    kinds: [Predicate],
    params: {"axis": Any, "possessor": Subject},
    body: HasPossessor(axis: Param(axis), possessor: Param(possessor)),
)
