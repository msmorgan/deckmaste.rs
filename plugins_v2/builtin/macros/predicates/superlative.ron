// `Predicate.Superlative` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "superlative",
    kinds: [Predicate],
    params: {"op": AggregateOp, "axis": ProjAxis, "domain": Quality},
    body: Superlative(op: Param(op), axis: Param(axis), domain: Param(domain)),
)
