// "permanent card": a card that could be put onto the battlefield, one with an artifact,
// battle, creature, enchantment, land, or planeswalker type [CR#110.4a]; a reading of the card's
// types, wherever it is.
(
    name: "permanentCard",
    kinds: [Predicate],
    params: [],
    body: And(conjuncts: [IsCard, Or(disjuncts: [HasType(r#type: Artifact), HasType(r#type: Battle), HasType(r#type: Creature), HasType(r#type: Enchantment), HasType(r#type: Land), HasType(r#type: Planeswalker)])]),
)
