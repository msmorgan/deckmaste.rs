// `Predicate.AbilityOf` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "abilityOf",
    kinds: [Predicate],
    params: {"source": Subject},
    body: AbilityOf(Param(source)),
)
