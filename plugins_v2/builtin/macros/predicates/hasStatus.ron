// `Predicate.HasStatus` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "hasStatus",
    kinds: [Predicate],
    params: {"status": Any},
    body: HasStatus(status: Param(status)),
)
