// `Predicate.CounterKindOn` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "counterKindOn",
    kinds: [Predicate],
    params: {"subject": Subject},
    body: CounterKindOn(subject: Param(subject)),
)
