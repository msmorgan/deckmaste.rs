// An outlaw: an Assassin, Mercenary, Pirate, Rogue, or Warlock [CR#700.12].
(
    name: "outlaw",
    kinds: [Predicate],
    params: [],
    body: Or([HasSubtype(creatureType(label: "Assassin")), HasSubtype(creatureType(label: "Mercenary")), HasSubtype(creatureType(label: "Pirate")), HasSubtype(creatureType(label: "Rogue")), HasSubtype(creatureType(label: "Warlock"))]),
)
