// `Predicate.ColorIs` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "colorIs",
    kinds: [Predicate],
    params: {"color": Color},
    body: ColorIs(color: Param(color)),
)
