// `Predicate.AbilityHead` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "abilityHead",
    kinds: [Predicate],
    params: {"class": Any},
    body: AbilityHead(class: Param(class)),
)
