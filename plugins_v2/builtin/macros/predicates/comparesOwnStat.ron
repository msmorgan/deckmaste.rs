// "a <dom> with <stat> <r> <bound>": the stat of `member`, the member itself
// (`ownMember`) unless written.
(
    name: "comparesOwnStat",
    kinds: [Predicate],
    params: {
        "stat": Stat,
        "domain": Predicate,
        "comparator": Comparator,
        "bound": Amount,
        "member": Default(NounPhrase, ownMember),
    },
    body: CompareOver(Param(domain), StatOf(Stat(Param(stat)), Param(member)), Param(comparator), Param(bound)),
)
