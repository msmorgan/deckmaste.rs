// `Predicate.Attachment` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "attachment",
    kinds: [Predicate],
    params: {"side": Any, "word": Default(Any, None), "counterpart": Default(Any, None)},
    body: Attachment(side: Param(side), word: Param(word), counterpart: Param(counterpart)),
)
