// `Predicate.OfYourChoice` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "ofYourChoice",
    kinds: [Predicate],
    params: {"sort": QualitySort, "domain": Default(Any, None)},
    body: OfYourChoice(sort: Param(sort), domain: Param(domain)),
)
