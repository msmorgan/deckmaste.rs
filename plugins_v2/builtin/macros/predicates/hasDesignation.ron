// `Predicate.HasDesignation` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "hasDesignation",
    kinds: [Predicate],
    params: {"designation": Any, "holder": Default(Any, None)},
    body: HasDesignation(designation: Param(designation), holder: Param(holder)),
)
