// `Predicate.CompareOver` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "compareOver",
    kinds: [Predicate],
    params: {"domain": Quality, "measure": Amount, "comparator": Comparator, "bound": Amount},
    body: CompareOver(domain: Param(domain), measure: Param(measure), comparator: Param(comparator), bound: Param(bound)),
)
