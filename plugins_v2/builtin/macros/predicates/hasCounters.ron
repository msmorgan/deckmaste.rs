// `Predicate.HasCounters` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "hasCounters",
    kinds: [Predicate],
    params: {"kind": Default(Any, None)},
    body: HasCounters(Param(kind)),
)
