// `Predicate.ChoseExtreme` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "choseExtreme",
    kinds: [Predicate],
    params: {"op": AggregateOp},
    body: ChoseExtreme(Param(op)),
)
