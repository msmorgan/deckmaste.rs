// `Predicate.Targets` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "targets",
    kinds: [Predicate],
    params: {"subject": Subject, "extent": Any},
    body: Targets(subject: Param(subject), extent: Param(extent)),
)
