// `Predicate.ColorCount` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "colorCount",
    kinds: [Predicate],
    params: {"comparator": Comparator, "count": Nat},
    body: ColorCount(comparator: Param(comparator), count: Param(count)),
)
