// `Instruction.SetStatus` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "setStatus",
    kinds: [Instruction],
    params: {"status": Any, "subject": Subject},
    body: SetStatus(status: Param(status), subject: Param(subject)),
)
