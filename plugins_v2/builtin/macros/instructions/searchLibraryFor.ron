// "Search your library for <quantity> <p>"
(
    name: "searchLibraryFor",
    kinds: [Instruction],
    params: {"quantity": Quantity, "p": Predicate, "agent": Default(NounPhrase, You)},
    body: Search(scope: OneZone(zone: yourLibrary), quantity: Param(quantity), predicate: Param(p), agent: Param(agent)),
)
