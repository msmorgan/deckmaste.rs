// A token's characteristics from the parts a creature token names, [with <abilities>].
(
    name: "creatureTokenOf",
    kinds: [CharacteristicBundle],
    params: {"power": Amount, "toughness": Amount, "colors": Colors, "subtypes": Subtypes, "abilities": Default(Abilities, [])},
    body: (characteristics: (colors: Param(colors), types: [Creature], subtypes: Param(subtypes), power: Param(power), toughness: Param(toughness), text: Param(abilities))),
)
