// `Instruction.TriggerReflexively` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "triggerReflexively",
    kinds: [Instruction],
    params: {"body": Instruction, "trigger": Instruction},
    body: TriggerReflexively(body: Param(body), trigger: Param(trigger)),
)
