// "<who> may spend mana as though it were mana of <as> [to <purpose>]"
(
    name: "maySpendAsThough",
    kinds: [StaticSpec],
    params: {"who": NounPhrase, "what": ColorOrColorless, "as_": ManaMatch, "purpose": SpendPurpose},
    body: DeonticRule(Param(who), Permit, [Core(Spend)], Agent, None, NoPatient, Mana(Param(what), Param(as_), Param(purpose)), NoRider),
)
