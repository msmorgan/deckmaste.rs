// `Instruction.Combat` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "combat",
    kinds: [Instruction],
    params: {"subject": Subject, "update": Any},
    body: Combat(subject: Param(subject), update: Param(update)),
)
