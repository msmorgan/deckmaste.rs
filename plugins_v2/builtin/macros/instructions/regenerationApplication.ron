// The replacement's application, rather than installation of a new shield
// [CR#701.19b,701.19c]. The subject is mentioned six times: the loader binds it
// at its first mention, the damage removal, and reads it back by identity in
// the other five (`deckmaste_semantics_v2::mentions`), so a targeted subject is
// targeted once.
(
    name: "regenerationApplication",
    kinds: [Instruction],
    params: {"subject": NounPhrase},
    body: Enact(verb: Action("Regenerate"), instruction: Sequentially([ClearDamage(Param(subject)), Act(PossessorOf(Controller, Param(subject)), Enact(Action("Tap"), SetStatus(Tapped, Param(subject)))), DoIf(Or([Matches(Param(subject), InCombat(AttackerOf, None)), Matches(Param(subject), InCombat(BlockerOf, None))]), Combat(Param(subject), Participation(OutsideCombat)), None)])),
)
