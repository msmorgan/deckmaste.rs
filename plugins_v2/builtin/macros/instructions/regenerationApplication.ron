// The replacement's application, rather than installation of a new shield
// [CR#701.19b,701.19c].
(
    name: "regenerationApplication",
    kinds: [Instruction],
    params: {"subject": NounPhrase},
    body: Enact(verb: Action("Regenerate"), instruction: Sequentially([ClearDamage(Param(subject)), Enact(Action("Tap"), SetStatus(Tapped, Param(subject)), PossessorOf(Controller, Param(subject))), DoIf(Or([Matches(Param(subject), InCombat(AttackerOf, None)), Matches(Param(subject), InCombat(BlockerOf, None))]), Combat(Param(subject), Participation(OutsideCombat)), None)]), agent: None),
)
