// `Instruction.DealDamage` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "dealDamage",
    kinds: [Instruction],
    params: {"source": Subject, "amount": Amount, "recipient": Subject},
    body: DealDamage(source: Param(source), amount: Param(amount), recipient: Param(recipient)),
)
