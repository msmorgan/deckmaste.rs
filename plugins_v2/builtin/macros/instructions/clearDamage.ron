// `Instruction.ClearDamage` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "clearDamage",
    kinds: [Instruction],
    params: {"subject": Subject},
    body: ClearDamage(Param(subject)),
)
