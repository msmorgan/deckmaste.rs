// `Instruction.Distribute` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "distribute",
    kinds: [Instruction],
    params: {"verb": Any, "amount": Amount, "among": Subject},
    body: Distribute(verb: Param(verb), amount: Param(amount), among: Param(among)),
)
