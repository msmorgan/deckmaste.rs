// `Instruction.Replace` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "replace",
    kinds: [Instruction],
    params: {"replaced": Instruction, "replacement": Instruction},
    body: Replace(replaced: Param(replaced), replacement: Param(replacement)),
)
