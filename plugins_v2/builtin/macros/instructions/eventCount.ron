// The number of occurrences of a historical event involving the subject.
(
    name: "eventCount",
    kinds: [Amount],
    params: {"event": GameEvent, "who": NounPhrase, "within": Duration, "timing": Default(Any, None)},
    body: EventTally(Count, Param(who), Mk(Param(event), Param(within), Param(timing))),
)
