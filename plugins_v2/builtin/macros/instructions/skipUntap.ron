// `Instruction.SkipUntap` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "skipUntap",
    kinds: [Instruction],
    params: {"subject": Subject, "steps": Amount},
    body: SkipUntap(subject: Param(subject), steps: Param(steps)),
)
