// `Instruction.AddTurnPart` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1). The performer is the actor: an added turn
// is the actor's [CR#500.7], and an added phase or step is added to the current
// turn [CR#500.8,500.9] (ADR 7, ruling 2026-10-06).
(
    name: "addTurnPart",
    kinds: [Instruction],
    params: {"part": TurnPart, "count": Amount, "anchor": Default(Any, None), "followed_by": Default(Any, None)},
    body: AddTurnPart(part: Param(part), anchor: Param(anchor), count: Param(count), followed_by: Param(followed_by)),
)
