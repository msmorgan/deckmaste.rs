// `Instruction.Enact` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "enact",
    kinds: [Instruction],
    params: {"verb": Deed, "instruction": Instruction, "agent": Default(Any, None)},
    body: Enact(verb: Param(verb), instruction: Param(instruction), agent: Param(agent)),
)
