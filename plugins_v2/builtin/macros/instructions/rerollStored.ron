// `Instruction.RerollStored` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "rerollStored",
    kinds: [Instruction],
    params: {"quantity": Quantity, "whose": Subject, "agent": Subject},
    body: RerollStored(quantity: Param(quantity), whose: Param(whose), agent: Param(agent)),
)
