// `Instruction.DoAndForbid` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "doAndForbid",
    kinds: [Instruction],
    params: {"instruction": Instruction, "deed": Deed, "subject": Subject},
    body: DoAndForbid(instruction: Param(instruction), deed: Param(deed), subject: Param(subject)),
)
