// `Instruction.CopyTargets` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "copyTargets",
    kinds: [Instruction],
    params: {"copy": Subject, "original": Subject},
    body: CopyTargets(copy: Param(copy), original: Param(original)),
)
