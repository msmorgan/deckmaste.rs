// `Instruction.Establish` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "establish",
    kinds: [Instruction],
    params: {"spec": StaticSpec, "duration": Default(Any, None)},
    body: Establish(spec: Param(spec), duration: Param(duration)),
)
