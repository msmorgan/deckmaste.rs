// `Instruction.HoldUntil` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "holdUntil",
    kinds: [Instruction],
    params: {"instruction": Instruction, "event": GameEvent},
    body: HoldUntil(instruction: Param(instruction), event: Param(event)),
)
