// "<what> can be the target of <by> as though it didn't have <p>"
(
    name: "canBeTargetedAsThough",
    kinds: [StaticSpec],
    params: {"what": NounPhrase, "by": NounPhrase, "p": Predicate},
    body: DeonticRule(Param(what), Permit, [Core(Target)], Patient, None, TargetedBy(Param(by)), Of(Param(p)), NoRider),
)
