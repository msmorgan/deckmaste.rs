// "Prevent all <kind> damage that would be dealt <scope> [duration]."
(
    name: "preventAll",
    kinds: [Instruction],
    params: {"kind": DamageKind, "scope": DamageScope, "duration": Duration},
    body: Establish(DamageRule(Param(kind), Unattributed, Param(scope), Prevent(All, None), Repeatedly), Param(duration)),
)
