// "<player> can't <deed> more than N <p>"
(
    name: "cantMoreThan",
    kinds: [StaticSpec],
    params: {"player": NounPhrase, "deed": Deed, "bound": Nat, "p": Predicate},
    body: DeonticRule(Param(player), Forbid, [Param(deed)], Agent, MoreThan(Lit(Param(bound))), Counterpart(allOf(p: Param(p))), None, NoRider),
)
