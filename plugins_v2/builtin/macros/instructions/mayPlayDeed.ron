// "<player> may <deed> <what> [as though …] [rider]"
(
    name: "mayPlayDeed",
    kinds: [StaticSpec],
    params: {"deed": Deed, "player": NounPhrase, "what": NounPhrase, "asThough": AsThough, "rider": DeonticRider},
    body: DeonticRule(Param(player), Permit, [Param(deed)], Agent, None, Counterpart(patient: Param(what)), Param(asThough), Param(rider)),
)
