// "<who> searches their library for a <p>"
(
    name: "searchTheirLibraryFor",
    kinds: [Instruction],
    params: {"p": Predicate, "agent": Default(NounPhrase, You)},
    body: Search(scope: OneZone(zone: libraryOf(player: they)), quantity: exactly(n: 1), predicate: Param(p), agent: Param(agent)),
)
