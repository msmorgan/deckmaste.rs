// `Instruction.SeparateIntoPiles` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1). The performer is the actor: the alias
// takes no performer (ADR 7, ruling 2026-10-05).
(
    name: "separateIntoPiles",
    kinds: [Instruction],
    params: {"group": Subject, "piles": Nat, "faces": Default(Any, [])},
    body: SeparateIntoPiles(group: Param(group), piles: Param(piles), faces: Param(faces)),
)
