// `Instruction.ChooseModes` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "chooseModes",
    kinds: [Instruction],
    params: {"quantity": Quantity, "modes": Default(Any, [])},
    body: ChooseModes(quantity: Param(quantity), modes: Param(modes)),
)
