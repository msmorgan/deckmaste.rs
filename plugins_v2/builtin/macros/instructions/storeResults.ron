// `Instruction.StoreResults` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "storeResults",
    kinds: [Instruction],
    params: {"on": Subject},
    body: StoreResults(on: Param(on)),
)
