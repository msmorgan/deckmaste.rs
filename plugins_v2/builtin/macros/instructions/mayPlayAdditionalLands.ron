// "<player> may play N additional lands"
(
    name: "mayPlayAdditionalLands",
    kinds: [StaticSpec],
    params: {"player": NounPhrase, "quantity": Quantity},
    body: DeonticRule(Param(player), Permit, [Action("Play")], Agent, Additional(Param(quantity)), Counterpart(allOf(p: land)), None, NoRider),
)
