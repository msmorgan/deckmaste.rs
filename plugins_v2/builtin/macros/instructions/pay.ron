// `Instruction.Pay` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "pay",
    kinds: [Instruction],
    params: {"cost": Cost, "times": Any, "agent": Subject},
    body: Pay(cost: Param(cost), times: Param(times), agent: Param(agent)),
)
