// "Starting with <first>, <voters> vote for <ballot>"
(
    name: "voteStartingWith",
    kinds: [Instruction],
    params: {"first": NounPhrase, "disclosure": Disclosure, "ballot": Ballot, "agent": Default(NounPhrase, You)},
    body: Vote(first: Param(first), disclosure: Param(disclosure), ballot: Param(ballot), agent: Param(agent)),
)
