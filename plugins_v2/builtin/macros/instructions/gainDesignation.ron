// `Instruction.GainDesignation` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "gainDesignation",
    kinds: [Instruction],
    params: {"subject": Subject, "designation": Any, "duration": Default(Any, None)},
    body: GainDesignation(subject: Param(subject), designation: Param(designation), duration: Param(duration)),
)
