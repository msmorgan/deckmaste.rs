// `Instruction.InsertPart` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "insertPart",
    kinds: [Instruction],
    params: {"part": TurnPart, "count": Amount, "anchor": Default(Any, None), "followed_by": Default(Any, None)},
    body: InsertPart(part: Param(part), anchor: Param(anchor), count: Param(count), followed_by: Param(followed_by)),
)
