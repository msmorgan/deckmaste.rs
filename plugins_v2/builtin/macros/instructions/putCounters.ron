// `Instruction.PutCounters` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "putCounters",
    kinds: [Instruction],
    params: {"amount": Amount, "kind": CounterKindSource, "on": Subject},
    body: PutCounters(amount: Param(amount), kind: Param(kind), on: Param(on)),
)
