// `Instruction.CreateObject` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "createObject",
    kinds: [Instruction],
    params: {"count": Amount, "spec": Any, "agent": Subject},
    body: CreateObject(count: Param(count), spec: Param(spec), agent: Param(agent)),
)
