// "Exchange the text boxes of <left> and <right>" [CR#701.12h]: a Text Change
// that lasts indefinitely, after which each permanent's rules text is the
// other's previous rules text [CR#612.5].
(
    name: "exchangeTextBoxes",
    kinds: [Instruction],
    params: {"left": NounPhrase, "right": NounPhrase},
    body: Establish(TextChange(Param(left), ExchangeWith(Param(right))), None),
)
