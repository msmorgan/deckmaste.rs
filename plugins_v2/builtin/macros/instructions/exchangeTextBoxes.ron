// "Exchange the text boxes of <left> and <right>" [CR#701.12h]: a
// text-changing effect, after which each permanent's rules text is the
// other's previous rules text. All or nothing, like every exchange
// [CR#701.12a].
(
    name: "exchangeTextBoxes",
    kinds: [Instruction],
    params: {"left": NounPhrase, "right": NounPhrase},
    body: Exchange(TextBoxes(Param(left), Param(right))),
)
