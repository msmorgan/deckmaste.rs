// `Instruction.DoForEach` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "doForEach",
    kinds: [Instruction],
    params: {"group": Subject, "body": Instruction},
    body: DoForEach(group: Param(group), body: Param(body)),
)
