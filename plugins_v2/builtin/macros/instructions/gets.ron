// "<subject> gets <power>/<toughness> [<duration>]": one change to both stats,
// the subject written once [CR#613.4c].
(
    name: "gets",
    kinds: [Instruction],
    params: {"subject": NounPhrase, "power": Delta, "toughness": Delta, "duration": Default(Any, None)},
    body: Establish(PtModification(Param(subject), Param(power), Param(toughness)), Param(duration)),
)
