// "meld <subject> into <name>"
(
    name: "meldInto",
    kinds: [Instruction],
    params: {"subject": NounPhrase, "into": String, "agent": Default(Any, None)},
    body: Enact(verb: Action("Meld"), instruction: Move(Param(subject), battlefield, [EntersMelded(Param(into))]), agent: Param(agent)),
)
