// "search <whose>'s graveyard, hand, and library for <q> <p>"
(
    name: "SearchZonesOf",
    kinds: [Instruction],
    params: {"whose": NounPhrase, "quantity": Quantity, "p": Predicate, "agent": Default(NounPhrase, You)},
    body: Search(scope: SomeZones(Param(whose), [Graveyard, Hand, Library]), quantity: Param(quantity), predicate: Param(p), agent: Param(agent)),
)
