// `Instruction.DoForEachKind` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "doForEachKind",
    kinds: [Instruction],
    params: {"axis": Any, "sort": QualitySort, "body": Instruction, "domain": Default(Any, None)},
    body: DoForEachKind(axis: Param(axis), domain: Param(domain), sort: Param(sort), body: Param(body)),
)
