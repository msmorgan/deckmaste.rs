// "return <subject> to the battlefield [<riders>]"
(
    name: "returnToBattlefield",
    kinds: [Instruction],
    params: {"subject": NounPhrase, "riders": Default(TokenRiders, []), "agent": Default(Any, None)},
    body: returnTo(subject: Param(subject), destination: battlefield, riders: Param(riders), agent: Param(agent)),
)
