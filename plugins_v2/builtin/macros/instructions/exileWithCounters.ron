// "exile <subject> with N <kind> counters on it"
(
    name: "exileWithCounters",
    kinds: [Instruction],
    params: {"subject": NounPhrase, "amount": Amount, "kind": CounterKind, "agent": Default(Any, None)},
    body: Enact(verb: Action("Exile"), instruction: Move(Param(subject), exileZone, [WithCounters(Param(amount), Printed(Param(kind)), Fresh)]), agent: Param(agent)),
)
