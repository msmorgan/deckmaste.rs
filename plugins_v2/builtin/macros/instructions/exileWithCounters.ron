// "exile <subject> with N <kind> counters on it"
(
    name: "exileWithCounters",
    kinds: [Instruction],
    params: {"subject": NounPhrase, "amount": Amount, "kind": CounterKind},
    body: Enact(verb: exile, instruction: Move(Param(subject), wherever, exileZone, [Placement(WithCounters(Param(amount), Printed(Param(kind)), Fresh))])),
)
