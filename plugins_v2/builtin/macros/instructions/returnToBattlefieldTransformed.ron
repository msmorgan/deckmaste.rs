// "return <subject> to the battlefield transformed under <controller>'s control"
(
    name: "returnToBattlefieldTransformed",
    kinds: [Instruction],
    params: {"subject": NounPhrase, "controller": NounPhrase},
    body: returnTo(subject: Param(subject), destination: battlefield, riders: [EntersTransformed, Under(controller: Param(controller))]),
)
