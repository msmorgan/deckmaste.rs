// `Instruction.Conclude` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "conclude",
    kinds: [Instruction],
    params: {"verb": Any, "agent": Subject},
    body: Conclude(verb: Param(verb), agent: Param(agent)),
)
