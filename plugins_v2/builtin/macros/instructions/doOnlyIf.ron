// `Instruction.DoOnlyIf` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "doOnlyIf",
    kinds: [Instruction],
    params: {"instruction": Instruction, "condition": Condition, "otherwise": Default(Any, None)},
    body: DoOnlyIf(instruction: Param(instruction), condition: Param(condition), otherwise: Param(otherwise)),
)
