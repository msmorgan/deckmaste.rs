// "put <subject> from <from> into <to>": the untagged move, which is no
// destruction and no keyword action of its own [CR#701.8b]. `from` is the
// origin the text states ("from your graveyard"), or `wherever` when it states
// none. `riders` say how the moved objects arrive, of the kind the destination
// allows: a placement ("in a random order", "second from the top", "face
// down") anywhere but the battlefield, written `Placement(…)`, and a bare entry
// rider ("tapped") onto the battlefield.
(
    name: "move",
    kinds: [Instruction],
    params: {"subject": NounPhrase, "from": ZoneExpr, "to": ZoneExpr, "riders": Default(MoveRiders, [])},
    body: Move(Param(subject), Param(from), Param(to), Param(riders)),
)
