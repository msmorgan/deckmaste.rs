// `Instruction.Copy` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "copy",
    kinds: [Instruction],
    params: {"sort": Any, "subject": Subject, "times": Amount, "exceptions": Default(Any, []), "agent": Subject},
    body: Copy(sort: Param(sort), subject: Param(subject), times: Param(times), exceptions: Param(exceptions), agent: Param(agent)),
)
