// "<subject> can block an additional creature each combat"
(
    name: "mayBlockAdditional",
    kinds: [StaticSpec],
    params: {"subject": NounPhrase, "quantity": Quantity},
    body: DeonticRule(Param(subject), Permit, [Core(Block)], Agent, Additional(Param(quantity)), Counterpart(allOf(p: creature)), None, NoRider),
)
