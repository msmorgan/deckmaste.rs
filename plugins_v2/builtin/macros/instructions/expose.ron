// `Instruction.Expose` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "expose",
    kinds: [Instruction],
    params: {"verb": Any, "exposed": Any, "agent": Subject},
    body: Expose(verb: Param(verb), exposed: Param(exposed), agent: Param(agent)),
)
