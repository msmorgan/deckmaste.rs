// `GameEvent.RollsDice` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "rollsDice",
    kinds: [GameEvent],
    params: {"player": Subject, "batch": Any, "sides": Default(Any, None), "watch": Any},
    body: RollsDice(player: Param(player), batch: Param(batch), sides: Param(sides), watch: Param(watch)),
)
