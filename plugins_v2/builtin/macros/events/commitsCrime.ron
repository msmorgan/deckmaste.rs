// `GameEvent.CommitsCrime` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "commitsCrime",
    kinds: [GameEvent],
    params: {"player": Subject},
    body: CommitsCrime(player: Param(player)),
)
