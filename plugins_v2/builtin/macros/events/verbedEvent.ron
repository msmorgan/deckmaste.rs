// `GameEvent.VerbedEvent` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "verbedEvent",
    kinds: [GameEvent],
    params: {"agent": Default(Any, None), "verb": Deed, "patient": Default(Any, None), "becomes": Default(Any, None), "locus": Default(Any, None)},
    body: VerbedEvent(agent: Param(agent), verb: Param(verb), patient: Param(patient), becomes: Param(becomes), locus: Param(locus)),
)
