// `GameEvent.NthOccurrence` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "nthOccurrence",
    kinds: [GameEvent],
    params: {"ordinal": Ordinal, "per": Default(Any, None), "event": GameEvent},
    body: NthOccurrence(ordinal: Param(ordinal), per: Param(per), event: Param(event)),
)
