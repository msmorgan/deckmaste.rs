// `GameEvent.Damage` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "damage",
    kinds: [GameEvent],
    params: {"kind": DamageKind, "patient": Default(Any, None), "source": Default(Any, None)},
    body: Damage(kind: Param(kind), source: Param(source), patient: Param(patient)),
)
