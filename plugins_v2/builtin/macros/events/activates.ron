// `GameEvent.Activates` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "activates",
    kinds: [GameEvent],
    params: {"player": Subject, "ability": Subject},
    body: Activates(player: Param(player), ability: Param(ability)),
)
