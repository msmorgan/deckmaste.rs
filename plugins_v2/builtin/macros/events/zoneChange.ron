// `GameEvent.ZoneChange` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "zoneChange",
    kinds: [GameEvent],
    params: {"subject": Subject, "from": Default(Any, None), "to": Default(Any, None), "observation": Any},
    body: ZoneChange(subject: Param(subject), r#from: Param(from), to: Param(to), observation: Param(observation)),
)
