// `GameEvent.BeginningOf` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "beginningOf",
    kinds: [GameEvent],
    params: {"part": TurnPart, "whose": Any, "which": Any},
    body: BeginningOf(part: Param(part), whose: Param(whose), which: Param(which)),
)
