// `GameEvent.StatBecomes` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "statBecomes",
    kinds: [GameEvent],
    params: {"subject": Subject, "stat": Stat, "value": Amount},
    body: StatBecomes(subject: Param(subject), stat: Param(stat), value: Param(value)),
)
