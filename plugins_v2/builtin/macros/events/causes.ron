// `GameEvent.Causes` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "causes",
    kinds: [GameEvent],
    params: {"cause": Any, "event": GameEvent},
    body: Causes(cause: Param(cause), event: Param(event)),
)
