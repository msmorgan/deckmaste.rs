// `GameEvent.BecomesTarget` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "becomesTarget",
    kinds: [GameEvent],
    params: {"subject": Subject, "by": Subject},
    body: BecomesTarget(subject: Param(subject), by: Param(by)),
)
