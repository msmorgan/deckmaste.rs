// `GameEvent.StateHolds` under Lean's own name for it: the alias
// `declare_semantic_primitives` generates, so a card writes a macro where the
// basis has a constructor (ADR 12.1).
(
    name: "stateHolds",
    kinds: [GameEvent],
    params: {"condition": Condition},
    body: StateHolds(condition: Param(condition)),
)
