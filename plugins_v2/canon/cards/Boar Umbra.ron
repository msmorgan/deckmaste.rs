// "Enchant creature / Enchanted creature gets +3/+3. / Umbra armor" [CR#702.89a]
SingleFaced((
    characteristics: (
        name: "Boar Umbra",
        cost: [
            2,
            Green,
        ],
        types: [Enchantment],
        subtypes: [Of(host: Enchantment, label: "Aura")],
        text: [
            keywordSubject(label: "Enchant", subject: hasType(type: Creature)),
            static(
                spec: conjunction(
                    subject: None,
                    parts: [
                        modification(
                            subject: attachHost(word: Enchanted, head: Type(Creature)),
                            stat: Power,
                            delta: up(amount: 3),
                        ),
                        modification(
                            subject: attachHost(word: Enchanted, head: Type(Creature)),
                            stat: Toughness,
                            delta: up(amount: 3),
                        ),
                    ],
                ),
            ),
            umbraArmor,
        ],
    ),
))
