// "As an additional cost to cast this spell, sacrifice a creature. Draw two
// cards." The sacrifice is performed as a cost [CR#701.21a,601.2f].
SingleFaced(face: (
    characteristics: (
        name: "Village Rites",
        cost: [Simple(symbol: Specific(color: Of(color: Black)))],
        types: [Instant],
        text: [
            static(spec: addedCost(
                cost: perform(instruction: sacrifice(
                    described(
                        determiner: A(mode: Unmarked),
                        predicate: and(conjuncts: [
                            hasType(type: Creature),
                            inZone(zone: zone(zone: Battlefield, scope: Bare)),
                            hasPossessor(axis: Controller, possessor: you),
                        ]),
                    ),
                    you,
                )),
                offered: false,
            )),
            spell(
                timing: None,
                instruction: draw(amount: Lit(value: 2), agent: you),
            ),
        ],
    ),
))
