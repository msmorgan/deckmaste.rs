// "As an additional cost to cast this spell, sacrifice a creature. Draw two
// cards." The sacrifice is performed as a cost [CR#701.21a,601.2f].
SingleFaced(face: (
    characteristics: (
        name: "Village Rites",
        cost: [Black],
        types: [Instant],
        text: [
            static(addedCost(
                cost: perform(sacrifice(
                    described(
                        determiner: A(Unmarked),
                        predicate: and([
                            hasType(Creature),
                            inZone(zone(zone: Battlefield, scope: Bare)),
                            hasPossessor(axis: Controller, possessor: you),
                        ]),
                    ),
                    you,
                )),
                offered: false,
            )),
            spell(
                timing: None,
                instruction: draw(amount: 2, agent: you),
            ),
        ],
    ),
))
