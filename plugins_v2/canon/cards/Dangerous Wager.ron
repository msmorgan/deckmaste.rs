// "Discard your hand, then draw two cards." Your hand is every card in it, so
// the discarded phrase is the whole-hand description [CR#701.9a].
SingleFaced(face: (
    characteristics: (
        name: "Dangerous Wager",
        cost: [
            Simple(symbol: Generic(amount: 1)),
            Simple(symbol: Specific(color: Of(color: Red))),
        ],
        types: [Instant],
        text: [
            Spell(
                timing: None,
                instruction: Sequentially(steps: [
                    Discard(
                        Described(
                            determiner: All,
                            predicate: And(conjuncts: [
                                IsCard,
                                InZone(zone: Zone(zone: Hand, scope: PossessedBy(possessor: You))),
                            ]),
                        ),
                        You,
                    ),
                    Draw(amount: Lit(value: 2), agent: You),
                ]),
            ),
        ],
    ),
))
