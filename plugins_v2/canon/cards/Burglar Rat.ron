// "When this creature enters, each opponent discards a card." Each opponent
// performs the discard through a handoff, choosing a card from their own hand
// [CR#701.9a,701.9b]; that the discards happen together [CR#101.4] is
// lowering's concern.
SingleFaced(face: (
    characteristics: (
        name: "Burglar Rat",
        cost: [1, Black],
        types: [Creature],
        subtypes: [rat],
        text: [
            triggered(
                event: enters(asType(type: Creature, subject: this, subtype: None)),
                instruction: act(each(opponent), discard(a(cardIn(hand)))),
            ),
        ],
        power: 1,
        toughness: 1,
    ),
))
