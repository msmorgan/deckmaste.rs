// "Bargain / This spell costs {1} less to cast if it's bargained. / Counter target
// spell." [CR#702.166a,702.166b,701.6a]
SingleFaced(face: (
    characteristics: (
        name: "Ice Out",
        cost: [
            1,
            Blue,
            Blue,
        ],
        types: [Instant],
        text: [
            bargain,
            static(
                spec: conditional(
                    spec: costShift(
                        subject: this,
                        shift: Less(amount: 1, floor: None),
                    ),
                    condition: compareAmt(
                        subject: paid(
                            facet: Readback(which: ByKeyword("Bargain"), lookback: None),
                            subject: asMarker(marker: Spell, subject: this),
                        ),
                        comparator: AtLeast,
                        bound: 1,
                    ),
                    marking: AsLongAs,
                ),
            ),
            spell(
                timing: None,
                instruction: counter(described(
                    determiner: Target(range(low: 1, high: 1)),
                    predicate: and(conjuncts: [
                        inZone(zone: zone(zone: Stack, scope: Bare)),
                        not(predicate: abilityHead(class: AnyOnStack)),
                    ]),
                )),
            ),
        ],
    ),
))
