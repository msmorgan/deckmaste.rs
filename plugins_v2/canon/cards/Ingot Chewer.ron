// "When this creature enters, destroy target artifact. / Evoke {R}" [CR#702.74a]
SingleFaced(face: (
    characteristics: (
        name: "Ingot Chewer",
        cost: [
            4,
            Red,
        ],
        types: [Creature],
        subtypes: [elemental],
        power: 3,
        toughness: 3,
        text: [
            triggered(event: zoneChange(asType(type: Creature, subject: this, subtype: None), After, None, zone(zone: Battlefield, scope: Bare)), instruction: destroy(described( determiner: Target(range(low: 1, high: 1)), predicate: hasType(Artifact), ))),
            evoke(mana([Red])),
        ],
    ),
))
