// "Farm // Market", the aftermath split [CR#702.127a,709.4]. Farm: "Destroy target
// attacking or blocking creature." Market: "Aftermath / Draw two cards, then
// discard two cards."
Split(
    left: (
        characteristics: (
            name: "Farm",
            cost: [
                2,
                White,
            ],
            types: [Instant],
            text: [
                spell(
                    timing: None,
                    instruction: destroy(described(
                        determiner: Target(range(low: 1, high: 1)),
                        predicate: and([
                            hasType(Creature),
                            or([
                                inCombat(relation: AttackerOf, counterpart: None),
                                inCombat(relation: BlockerOf, counterpart: None),
                            ]),
                        ]),
                    )),
                ),
            ],
        ),
    ),
    right: (
        characteristics: (
            name: "Market",
            cost: [
                2,
                Blue,
            ],
            types: [Sorcery],
            text: [
                aftermath,
                spell(
                    timing: None,
                    instruction: sequentially([
                        draw(amount: 2, agent: you),
                        discard(
                            described(
                                determiner: Count(quantity: range(low: 2, high: 2), mode: None),
                                predicate: and([
                                    isCard,
                                    inZone(zone(zone: Hand, scope: PossessedBy(you))),
                                ]),
                            ),
                            you,
                        ),
                    ]),
                ),
            ],
        ),
    ),
)
