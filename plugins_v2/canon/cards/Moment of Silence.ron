// "Target player skips their next combat phase this turn." [CR#500.11]
SingleFaced(face: (
    characteristics: (
        name: "Moment of Silence",
        cost: [White],
        types: [Instant],
        text: [
            spell(
                timing: None,
                instruction: skipPart(
                    part: combatPhase,
                    count: 1,
                    agent: described(
                        determiner: Target(range(low: 1, high: 1)),
                        predicate: anyPlayer,
                    ),
                ),
            ),
        ],
    ),
))
