// "Goad all creatures you don't control." [CR#701.15a]
SingleFaced(face: (
    characteristics: (
        name: "Disrupt Decorum",
        cost: [
            2,
            Red,
            Red,
        ],
        types: [Sorcery],
        text: [
            spell(
                timing: None,
                instruction: goad(described(
                    determiner: All,
                    predicate: and([
                        hasType(Creature),
                        not(hasPossessor(axis: Controller, possessor: you)),
                    ]),
                )),
            ),
        ],
    ),
))
