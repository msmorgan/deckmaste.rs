// "At the beginning of combat on your turn, if you both own and control this
// creature and a creature named Midnight Scavengers, exile them, then meld
// them into Chittering Host." [CR#701.42a]
SingleFaced(face: (
    characteristics: (
        name: "Graf Rats",
        cost: [1, Black],
        types: [Creature],
        subtypes: [rat],
        power: 2,
        toughness: 1,
        text: [
            triggeredIf(event: beginningOf(quantifier: The, part: Combat, whose: ByPlayer(you)), condition: and([
                    matches(
                        subject: asType(type: Creature, subject: this, subtype: None),
                        predicate: and([
                            hasPossessor(axis: Owner, possessor: you),
                            hasPossessor(axis: Controller, possessor: you),
                        ]),
                    ),
                    exists(described(
                        determiner: Bare,
                        predicate: and([
                            hasType(Creature),
                            named(Printed("Midnight Scavengers")),
                            hasPossessor(axis: Owner, possessor: you),
                            hasPossessor(axis: Controller, possessor: you),
                        ]),
                    )),
                ]), instruction: sequentially([
                    exile(described(
                        determiner: All,
                        predicate: and([
                            hasType(Creature),
                            hasPossessor(axis: Controller, possessor: you),
                            or([
                                named(Printed("Graf Rats")),
                                named(Printed("Midnight Scavengers")),
                            ]),
                        ]),
                    )),
                    meld(
                        themVerbed(Action("Exile")),
                        "Chittering Host",
                    ),
                ])),
        ],
    ),
))
