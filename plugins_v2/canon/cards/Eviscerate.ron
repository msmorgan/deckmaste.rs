// "Destroy target creature." The bare-imperative destroy: the effect performs
// it, so the deed names no agent [CR#701.8a].
SingleFaced(face: (
    characteristics: (
        name: "Eviscerate",
        cost: [
            3,
            Black,
        ],
        types: [Sorcery],
        text: [
            spell(
                timing: None,
                instruction: destroy(described(
                    determiner: Target(range(low: 1, high: 1)),
                    predicate: hasType(Creature),
                )),
            ),
        ],
    ),
))
