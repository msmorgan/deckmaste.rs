// "Destroy target creature." The bare-imperative destroy [CR#701.8a]: the
// deed records the actor, the spell's controller, as its performer.
SingleFaced(face: (
    characteristics: (
        name: "Eviscerate",
        cost: [
            3,
            Black,
        ],
        types: [Sorcery],
        text: [
            spell(
                destroy(described(
                    determiner: Target(range(low: 1, high: 1)),
                    predicate: hasType(Creature),
                )),
            ),
        ],
    ),
))
