// "Threshold — This creature has flying as long as there are seven or more
// cards in your graveyard."
//
// `Threshold(<ability>)` is the ability word's own declaration invoked at this
// `Ability` position; it expands to the `ItalicHead` its body builds.
//
// (Substituted for Adamant: every real Adamant card's condition is "N mana
// of the SAME color spent to cast", which needs a `PaidFacet` this crate
// does not yet model — `words.rs`'s `PaidFacet` has `ColorsSpent`, the
// count of distinct colors, and `ManaValueSpent`, but no per-color amount.
// Never approximated; Threshold is a same-family, precedented substitute —
// see `lean/Semantics/Cards/Static.lean`'s `nimbleMongoose`.)
SingleFaced(face: (
    characteristics: (
        name: "Mystic Visionary",
        cost: [Simple(symbol: Generic(amount: 1)), Simple(symbol: Specific(color: Of(color: White)))],
        types: [Creature],
        subtypes: [Of(host: Creature, label: "Human"), Of(host: Creature, label: "Nomad"), Of(host: Creature, label: "Mystic")],
        text: [
            Threshold(
                Static(
                    spec: Conditional(
                        spec: AbilityGrant(
                            subject: AsType(type: Creature, subject: This, subtype: None),
                            ability: Keyword(keyword: "Flying", params: [], body: None),
                        ),
                        condition: CompareAmt(
                            subject: CountOf(group: Described(
                                determiner: Bare,
                                predicate: InZone(zone: Zone(zone: Graveyard, scope: PossessedBy(possessor: You))),
                            )),
                            comparator: AtLeast,
                            bound: Lit(value: 7),
                        ),
                        marking: AsLongAs,
                    ),
                )
            ),
        ],
        power: Lit(value: 2),
        toughness: Lit(value: 1),
    ),
))
