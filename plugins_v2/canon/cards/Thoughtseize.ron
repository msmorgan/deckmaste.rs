// "Target player reveals their hand. You choose a nonland card from it. That
// player discards that card. You lose 2 life." The target player reveals and
// discards, each through a handoff; you choose, and the discard moves the
// card that was chosen [CR#701.9b].
SingleFaced(face: (
    characteristics: (
        name: "Thoughtseize",
        cost: [Black],
        types: [Sorcery],
        text: [
            spell(
                timing: None,
                instruction: sequentially([
                    act(target(anyPlayer), revealHand),
                    choose(actor, a(and([not(land), cardIn(handOf(they))]))),
                    act(they, discard(that(Card))),
                    loseLife(2),
                ]),
            ),
        ],
    ),
))
