    characteristics: (
        name: "Grim Harvest",
        cost: [
            1,
            Black,
        ],
        types: [Instant],
        text: [
            spell(
                timing: None,
                instruction: enact(
                    verb: Core(Return),
                    instruction: move(subject: described( determiner: Target(range(low: 1, high: 1)), predicate: and( [ card, hasType(Creature), inZone( zone( zone: Graveyard, scope: PossessedBy(you), ), ), ], ), ), from: zone(zone: Graveyard, scope: PossessedBy(you)), to: zone(zone: Hand, scope: Bare)),
                ),
            ),
