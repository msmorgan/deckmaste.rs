// "Return target creature card from your graveyard to your hand. / Recover {2}{B}"
// [CR#702.59a]
SingleFaced(face: (
    characteristics: (
        name: "Grim Harvest",
        cost: [
            Simple(symbol: Generic(amount: 1)),
            Simple(symbol: Specific(color: Of(color: Black))),
        ],
        types: [Instant],
        text: [
            Spell(
                timing: None,
                instruction: Enact(
                    verb: Core(deed: Return),
                    instruction: Move(
                        subject: Described(
                            determiner: Target(quantity: Range(low: 1, high: 1)),
                            predicate: And(
                                conjuncts: [
                                    IsCard,
                                    HasType(type: Creature),
                                    InZone(
                                        zone: Zone(
                                            zone: Graveyard,
                                            scope: PossessedBy(possessor: You),
                                        ),
                                    ),
                                ],
                            ),
                        ),
                        to: Zone(zone: Hand, scope: Bare),
                        riders: [],
                    ),
                    agent: None,
                ),
            ),
            recover(Mana(cost: [
                Simple(symbol: Generic(amount: 2)),
                Simple(symbol: Specific(color: Of(color: Black))),
            ])),
        ],
    ),
))
