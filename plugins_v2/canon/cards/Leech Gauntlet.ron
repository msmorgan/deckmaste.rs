// "Lifelink / Equipped creature has lifelink. / Reconfigure {4}" [CR#702.151a]
SingleFaced((
    characteristics: (
        name: "Leech Gauntlet",
        cost: [
            1,
            Black,
        ],
        types: [Artifact, Creature],
        subtypes: [
            Of(host: Artifact, label: "Equipment"),
            Of(host: Creature, label: "Leech"),
        ],
        power: 2,
        toughness: 2,
        text: [
            lifelink,
            static(
                spec: abilityGrant(
                    subject: attachHost(word: Equipped, head: Type(Creature)),
                    ability: lifelink,
                ),
            ),
            reconfigure(mana(cost: [4])),
        ],
    ),
))
