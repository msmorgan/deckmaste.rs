// "At the beginning of combat on your turn, put a +1/+1 counter on target
// creature you control." — the beginning of combat step is the combat phase's
// own first step [CR#506.1], and the header's possessor is the player whose
// turn part it is.
SingleFaced(face: (
    characteristics: (
        name: "Luminarch Aspirant",
        cost: [
            Simple(symbol: Generic(amount: 1)),
            Simple(symbol: Specific(color: Of(color: White))),
        ],
        types: [Creature],
        subtypes: [
            Of(host: Creature, label: "Human"),
            Of(host: Creature, label: "Cleric"),
        ],
        power: Lit(value: 1),
        toughness: Lit(value: 1),
        text: [
            triggered(event: beginningOf( quantifier: The, part: beginningOfCombatStep, whose: ByPlayer(player: you), ), instruction: putCounters( amount: Lit(value: 1), kind: Printed(kind: Boost(power: up(amount: 1), toughness: up(amount: 1))), on: described( determiner: Target(quantity: range(low: 1, high: 1)), predicate: and(conjuncts: [ hasType(type: Creature), hasPossessor(axis: Controller, possessor: you), ]), ), )),
        ],
    ),
))
