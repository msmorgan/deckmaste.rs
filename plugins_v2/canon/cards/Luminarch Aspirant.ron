// "At the beginning of combat on your turn, put a +1/+1 counter on target
// creature you control." — the beginning of combat step is the combat phase's
// own first step [CR#506.1], and the header's possessor is the player whose
// turn part it is.
SingleFaced(face: (
    characteristics: (
        name: "Luminarch Aspirant",
        cost: [
            1,
            White,
        ],
        types: [Creature],
        subtypes: [
            Of(host: Creature, label: "Human"),
            Of(host: Creature, label: "Cleric"),
        ],
        power: 1,
        toughness: 1,
        text: [
            triggered(event: beginningOf( quantifier: The, part: beginningOfCombatStep, whose: ByPlayer(you), ), instruction: putCounters( amount: 1, kind: Printed(Boost(power: up(1), toughness: up(1))), on: described( determiner: Target(range(low: 1, high: 1)), predicate: and([ hasType(Creature), hasPossessor(axis: Controller, possessor: you), ]), ), )),
        ],
    ),
))
