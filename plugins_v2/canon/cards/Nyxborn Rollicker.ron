    characteristics: (
        name: "Nyxborn Rollicker",
        cost: [Red],
        types: [Enchantment, Creature],
        subtypes: [Of(host: Creature, label: "Satyr")],
        power: 1,
        toughness: 1,
        text: [
            bestow(mana(cost: [
                1,
