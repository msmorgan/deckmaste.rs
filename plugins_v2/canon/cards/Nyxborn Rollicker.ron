        cost: [Simple(symbol: Specific(color: Of(color: Red)))],
        types: [Enchantment, Creature],
        subtypes: [Of(host: Creature, label: "Satyr")],
        power: Lit(value: 1),
        toughness: Lit(value: 1),
        text: [
            bestow(mana(cost: [
