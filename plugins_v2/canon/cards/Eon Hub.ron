// "Players skip their upkeep steps." — a continuous rule exempting every
// player from the untap/upkeep pair's second step [CR#500.1].
SingleFaced((
    characteristics: (
        name: "Eon Hub",
        cost: [5],
        types: [Artifact],
        text: [
            static(
                spec: partSkip(
                    player: described(
                        determiner: Each,
                        predicate: anyPlayer,
                    ),
                    part: upkeepStep,
                ),
            ),
        ],
    ),
))
