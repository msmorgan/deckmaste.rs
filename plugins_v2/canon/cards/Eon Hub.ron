// "Players skip their upkeep steps." — a continuous rule exempting every
// player from the untap/upkeep pair's second step [CR#500.1].
SingleFaced(face: (
    characteristics: (
        name: "Eon Hub",
        cost: [Simple(symbol: Generic(amount: 5))],
        types: [Artifact],
        text: [
            Static(
                spec: PartSkip(
                    player: Described(
                        determiner: Each,
                        predicate: AnyPlayer,
                    ),
                    part: UpkeepStep,
                ),
            ),
        ],
    ),
))
