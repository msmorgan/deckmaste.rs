// own definition [CR#702.9b].
SingleFaced(face: (
    characteristics: (
        name: "Wind Drake",
        cost: [
            Simple(symbol: Generic(amount: 2)),
            Simple(symbol: Specific(color: Of(color: Blue))),
        ],
        types: [Creature],
        subtypes: [Of(host: Creature, label: "Drake")],
        power: Lit(value: 2),
        toughness: Lit(value: 2),
        text: [flying],
    ),
))
