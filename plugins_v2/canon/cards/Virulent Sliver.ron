// "All Sliver creatures have poisonous 1." [CR#702.70a]
SingleFaced(face: (
    characteristics: (
        name: "Virulent Sliver",
        cost: [Simple(symbol: Specific(color: Of(color: Green)))],
        types: [Creature],
        subtypes: [Of(host: Creature, label: "Sliver")],
        power: Lit(value: 1),
        toughness: Lit(value: 1),
        text: [
            static(
                spec: abilityGrant(
                    subject: described(
                        determiner: All,
                        predicate: and(
                            conjuncts: [
                                hasSubtype(subtype: Of(host: Creature, label: "Sliver")),
                                hasType(type: Creature),
                            ],
                        ),
                    ),
                    ability: poisonous(Lit(value: 1)),
                ),
            ),
        ],
    ),
))
