// "All Sliver creatures have poisonous 1." [CR#702.70a]
SingleFaced(face: (
    characteristics: (
        name: "Virulent Sliver",
        cost: [Green],
        types: [Creature],
        subtypes: [sliver],
        power: 1,
        toughness: 1,
        text: [
            static(
                abilityGrant(
                    subject: described(
                        determiner: All,
                        predicate: and(
                            [
                                hasSubtype(sliver),
                                hasType(Creature),
                            ],
                        ),
                    ),
                    ability: poisonous(1),
                ),
            ),
        ],
    ),
))
