// "All Sliver creatures have poisonous 1." [CR#702.70a]
SingleFaced((
    characteristics: (
        name: "Virulent Sliver",
        cost: [Green],
        types: [Creature],
        subtypes: [Of(host: Creature, label: "Sliver")],
        power: 1,
        toughness: 1,
        text: [
            static(
                spec: abilityGrant(
                    subject: described(
                        determiner: All,
                        predicate: and(
                            conjuncts: [
                                hasSubtype(subtype: Of(host: Creature, label: "Sliver")),
                                hasType(type: Creature),
                            ],
                        ),
                    ),
                    ability: poisonous(1),
                ),
            ),
        ],
    ),
))
