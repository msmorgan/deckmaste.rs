// "Gravestorm / Target player draws a card and loses 1 life." [CR#702.69a]
SingleFaced(face: (
    characteristics: (
        name: "Ominous Harvest",
        cost: [
            Simple(symbol: Generic(amount: 2)),
            Simple(symbol: Specific(color: Of(color: Black))),
        ],
        types: [Sorcery],
        text: [
            gravestorm,
            spell(
                timing: None,
                instruction: sequentially(steps: [
                    draw(amount: Lit(value: 1), agent: described( determiner: Target(quantity: range(low: 1, high: 1)), predicate: anyPlayer, )),
                    changeLife(
                        delta: down(amount: Lit(value: 1)),
                        agent: they,
                    ),
                ]),
            ),
        ],
    ),
))
