// "Gravestorm / Target player draws a card and loses 1 life." [CR#702.69a]
SingleFaced(face: (
    characteristics: (
        name: "Ominous Harvest",
        cost: [
            2,
            Black,
        ],
        types: [Sorcery],
        text: [
            gravestorm,
            spell(
                sequentially([
                    act(described( determiner: Target(range(low: 1, high: 1)), predicate: anyPlayer, ), draw(1)),
                    act(they, loseLife(1)),
                ]),
            ),
        ],
    ),
))
