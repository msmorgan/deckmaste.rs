// "{1}{B}, {T}: Exile two target cards from an opponent's graveyard. This
// creature explores." [CR#701.13a,701.44a]
SingleFaced(face: (
    characteristics: (
        name: "Deadeye Tracker",
        cost: [
            1,
            Black,
        ],
        types: [Creature],
        subtypes: [
            human,
            pirate,
        ],
        power: 1,
        toughness: 1,
        text: [
            activated(cost: compound([ mana([ 1, Black, ]), tapSymbol, ]), instruction: sequentially([ exile(described( determiner: Target(range(low: 2, high: 2)), predicate: and([ isCard, inZone(zone(zone: Graveyard, scope: PossessedBy(described(determiner: A(Unmarked), predicate: opponent)))), ]), )), explore(asType(type: Creature, subject: this, subtype: None)), ])),
        ],
    ),
))
