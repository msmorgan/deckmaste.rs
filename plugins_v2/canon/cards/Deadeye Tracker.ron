    characteristics: (
        name: "Deadeye Tracker",
        cost: [
            Simple(symbol: Generic(amount: 1)),
            Simple(symbol: Specific(color: Of(color: Black))),
        ],
        types: [Creature],
        subtypes: [
            Of(host: Creature, label: "Human"),
            Of(host: Creature, label: "Pirate"),
        ],
        power: Lit(value: 1),
        toughness: Lit(value: 1),
        text: [
            activated(cost: compound(costs: [ mana(cost: [ Simple(symbol: Generic(amount: 1)), Simple(symbol: Specific(color: Of(color: Black))), ]), tapSymbol, ]), instruction: sequentially(steps: [ exile(described( determiner: Target(quantity: range(low: 2, high: 2)), predicate: and(conjuncts: [ isCard, inZone(zone: zone(zone: Graveyard, scope: PossessedBy( possessor: described(determiner: A(mode: Unmarked), predicate: opponent), ))), ]), )), explore(asType(type: Creature, subject: this, subtype: None)), ])),
