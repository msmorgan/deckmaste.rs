// "Enchant creature / Enchanted creature has flying. / Aura swap {2}{U}"
// [CR#702.5a,702.9b,702.65a]
SingleFaced((
    characteristics: (
        name: "Arcanum Wings",
        cost: [
            1,
            Blue,
        ],
        types: [Enchantment],
        subtypes: [Of(host: Enchantment, label: "Aura")],
        text: [
            keywordSubject(label: "Enchant", subject: hasType(type: Creature)),
            static(
                spec: abilityGrant(
                    subject: attachHost(word: Enchanted, head: Type(Creature)),
                    ability: flying,
                ),
            ),
            auraSwap(mana(cost: [
                2,
                Blue,
            ])),
        ],
    ),
))
