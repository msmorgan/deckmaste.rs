// "Enchant creature / Enchanted creature has flying. / Aura swap {2}{U}"
// [CR#702.5a,702.9b,702.65a]
SingleFaced(face: (
    characteristics: (
        name: "Arcanum Wings",
        cost: [
            1,
            Blue,
        ],
        types: [Enchantment],
        subtypes: [aura],
        text: [
            keywordSubject(label: "Enchant", subject: hasType(Creature)),
            static(
                abilityGrant(
                    subject: attachHost(word: Enchanted, head: Type(Creature)),
                    ability: flying,
                ),
            ),
            auraSwap(mana([
                2,
                Blue,
            ])),
        ],
    ),
))
