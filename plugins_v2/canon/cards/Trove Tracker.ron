// "When this creature dies, draw a card. / Encore {5}{U}{U}" [CR#702.141a]
SingleFaced(face: (
    characteristics: (
        name: "Trove Tracker",
        cost: [
            2,
            Blue,
        ],
        types: [Creature],
        subtypes: [Of(host: Creature, label: "Human"), Of(host: Creature, label: "Pirate")],
        power: 2,
        toughness: 2,
        text: [
            triggered(event: zoneChange( subject: asType(type: Creature, subject: this, subtype: None), from: Zones([zone(zone: Battlefield, scope: Bare)]), to: zone(zone: Graveyard, scope: Bare), observation: Before, ), instruction: draw(amount: 1, agent: you)),
            encore(mana([
                5,
                Blue,
                Blue,
            ])),
        ],
    ),
))
