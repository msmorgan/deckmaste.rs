// "Scry 1. Draw a card." [CR#701.22a]: scry 1 reads its one looked-at card
// back as "that card".
SingleFaced(face: (
    characteristics: (
        name: "Opt",
        cost: [Blue],
        types: [Instant],
        text: [
            spell(
                sequentially([scry(1), draw(1)]),
            ),
        ],
    ),
))
