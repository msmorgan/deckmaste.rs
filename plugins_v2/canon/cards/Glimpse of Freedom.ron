// "Draw a card. / Escape—{2}{U}, Exile five other cards from your graveyard."
// [CR#702.138a]
SingleFaced(face: (
    characteristics: (
        name: "Glimpse of Freedom",
        cost: [
            1,
            Blue,
        ],
        types: [Instant],
        text: [
            spell(timing: None, instruction: draw(amount: 1, agent: you)),
            escape(compound(costs: [
                mana(cost: [
                    2,
                    Blue,
                ]),
                perform(instruction: enact(
                    verb: Action("Exile"),
                    instruction: move(subject: described( determiner: Count(quantity: range(low: 5, high: 5), mode: None), predicate: and(conjuncts: [ isCard, inZone(zone: zone(zone: Graveyard, scope: PossessedBy(you))), otherThan(anchor: this), ]), ), destination: zone(zone: Exile, scope: Bare)),
                    agent: you,
                )),
            ])),
        ],
    ),
))
