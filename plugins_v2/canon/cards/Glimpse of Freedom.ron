// "Draw a card. / Escape—{2}{U}, Exile five other cards from your graveyard."
// [CR#702.138a]
SingleFaced(face: (
    characteristics: (
        name: "Glimpse of Freedom",
        cost: [
            1,
            Blue,
        ],
        types: [Instant],
        text: [
            spell(timing: None, instruction: draw(amount: 1, agent: you)),
            escape(compound([
                mana([
                    2,
                    Blue,
                ]),
                perform(enact(
                    verb: Action("Exile"),
                    instruction: move(subject: described( determiner: Count(quantity: range(low: 5, high: 5), mode: None), predicate: and([ isCard, inZone(zone(zone: Graveyard, scope: PossessedBy(you))), otherThan(this), ]), ), destination: zone(zone: Exile, scope: Bare)),
                    agent: you,
                )),
            ])),
        ],
    ),
))
