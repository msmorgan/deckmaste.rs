// "Choose three. You may choose the same mode more than once. • Fiery
// Confluence deals 1 damage to each creature. • Fiery Confluence deals 2
// damage to each opponent. • Destroy target artifact." [CR#700.2d]
SingleFaced(face: (
    characteristics: (
        name: "Fiery Confluence",
        cost: [2, Red, Red],
        types: [Sorcery],
        text: [
            spell(chooseModes(exactly(3), [
                (None, None, dealDamage(this, 1, each(creature))),
                (None, None, dealDamage(this, 2, each(opponent))),
                (None, None, destroy(target(artifact))),
            ])),
            static(modeChoice(repeatable)),
        ],
    ),
))
