// "Landfall — Whenever a land you control enters, you gain 1 life."
//
// `Landfall(<ability>)` is the ability word's own declaration invoked at this
// `Ability` position: the meta names `Ability` as the semantic kind beside the
// `AbilityWord` family, so the declaration registers there and expands to the
// `ItalicHead` its body builds.
SingleFaced(face: (
    characteristics: (
        name: "Eumidian Terrabotanist",
        cost: [Simple(symbol: Generic(amount: 1)), Simple(symbol: Specific(color: Of(color: Green)))],
        types: [Creature],
        subtypes: [Of(host: Creature, label: "Insect"), Of(host: Creature, label: "Druid")],
        text: [
            landfall(
                Triggered(
                    event: ZoneChange(
                        subject: Described(
                            determiner: A(mode: Unmarked),
                            predicate: And(conjuncts: [
                                HasType(type: Land),
                                HasPossessor(axis: Controller, possessor: You),
                            ]),
                        ),
                        to: Zone(zone: Battlefield, scope: Bare),
                        observation: After,
                    ),
                    alternatives: [],
                    joins: [],
                    instruction: ChangeLife(delta: Up(amount: Lit(value: 1)), agent: You),
                )
            ),
        ],
        power: Lit(value: 2),
        toughness: Lit(value: 3),
    ),
))
