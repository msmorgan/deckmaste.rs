// "Living weapon / Equipped creature gets +1/+1. / Equip {2}" [CR#702.92a,702.6a]
SingleFaced(face: (
    characteristics: (
        name: "Flayer Husk",
        cost: [1],
        types: [Artifact],
        subtypes: [Of(host: Artifact, label: "Equipment")],
        text: [
            livingWeapon,
            static(
                spec: conjunction(
                    subject: None,
                    parts: [
                        modification(
                            subject: attachHost(word: Equipped, head: Type(Creature)),
                            stat: Power,
                            delta: up(amount: 1),
                        ),
                        modification(
                            subject: attachHost(word: Equipped, head: Type(Creature)),
                            stat: Toughness,
                            delta: up(amount: 1),
                        ),
                    ],
                ),
            ),
            equip(mana(cost: [2])),
        ],
    ),
))
