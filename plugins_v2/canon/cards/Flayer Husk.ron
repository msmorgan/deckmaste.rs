// "Living weapon / Equipped creature gets +1/+1. / Equip {2}" [CR#702.92a,702.6a]
SingleFaced(face: (
    characteristics: (
        name: "Flayer Husk",
        cost: [1],
        types: [Artifact],
        subtypes: [equipment],
        text: [
            livingWeapon,
            static(
                conjunction(
                    subject: None,
                    parts: [
                        modification(
                            subject: attachHost(word: Equipped, head: Type(Creature)),
                            stat: Power,
                            delta: up(1),
                        ),
                        modification(
                            subject: attachHost(word: Equipped, head: Type(Creature)),
                            stat: Toughness,
                            delta: up(1),
                        ),
                    ],
                ),
            ),
            equip(mana([2])),
        ],
    ),
))
