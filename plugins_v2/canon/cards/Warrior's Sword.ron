// "Job select / Equipped creature gets +3/+2 and is a Warrior in addition to its
// other types. / Equip {5}" [CR#702.182a,702.6a]
SingleFaced(face: (
    characteristics: (
        name: "Warrior's Sword",
        cost: [
            3,
            Red,
        ],
        types: [Artifact],
        subtypes: [Of(host: Artifact, label: "Equipment")],
        text: [
            jobSelect,
            static(
                conjunction(
                    subject: None,
                    parts: [
                        modification(
                            subject: attachHost(word: Equipped, head: Type(Creature)),
                            stat: Power,
                            delta: up(3),
                        ),
                        modification(
                            subject: attachHost(word: Equipped, head: Type(Creature)),
                            stat: Toughness,
                            delta: up(2),
                        ),
                        characteristicChange(
                            subject: attachHost(word: Equipped, head: Type(Creature)),
                            edits: [
                                TypeLine(
                                    op: Adds,
                                    changes: (subtypes: [Of(host: Creature, label: "Warrior")]),
                                ),
                            ],
                        ),
                    ],
                ),
            ),
            equip(mana([5])),
        ],
    ),
))
