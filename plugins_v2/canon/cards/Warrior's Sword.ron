// "Job select / Equipped creature gets +3/+2 and is a Warrior in addition to its
// other types. / Equip {5}" [CR#702.182a,702.6a]
SingleFaced(face: (
    characteristics: (
        name: "Warrior's Sword",
        cost: [
            Simple(symbol: Generic(amount: 3)),
            Simple(symbol: Specific(color: Of(color: Red))),
        ],
        types: [Artifact],
        subtypes: [Of(host: Artifact, label: "Equipment")],
        text: [
            jobSelect,
            static(
                spec: conjunction(
                    subject: None,
                    parts: [
                        modification(
                            subject: attachHost(word: Equipped, head: Type(type: Creature)),
                            stat: Power,
                            delta: up(amount: Lit(value: 3)),
                        ),
                        modification(
                            subject: attachHost(word: Equipped, head: Type(type: Creature)),
                            stat: Toughness,
                            delta: up(amount: Lit(value: 2)),
                        ),
                        characteristicChange(
                            subject: attachHost(word: Equipped, head: Type(type: Creature)),
                            edits: [
                                TypeLine(
                                    op: Adds,
                                    changes: (subtypes: [Of(host: Creature, label: "Warrior")]),
                                ),
                            ],
                        ),
                    ],
                ),
            ),
            equip(mana(cost: [Simple(symbol: Generic(amount: 5))])),
        ],
    ),
))
