// "Demonstrate / Mill five cards, then return a creature card from your graveyard
// to the battlefield." [CR#702.144a,701.17a]
SingleFaced(face: (
    characteristics: (
        name: "Incarnation Technique",
        cost: [
            Simple(symbol: Generic(amount: 4)),
            Simple(symbol: Specific(color: Of(color: Black))),
        ],
        types: [Sorcery],
        text: [
            Demonstrate,
            Spell(
                timing: None,
                instruction: Sequentially(steps: [
                    Mill(Lit(value: 5), You, You),
                    Enact(
                        verb: Core(deed: Return),
                        instruction: Move(
                            subject: Described(
                                determiner: A(mode: Unmarked),
                                predicate: And(
                                    conjuncts: [
                                        HasType(type: Creature),
                                        InZone(
                                            zone: Zone(
                                                zone: Graveyard,
                                                scope: PossessedBy(possessor: You),
                                            ),
                                        ),
                                    ],
                                ),
                            ),
                            to: Zone(zone: Battlefield, scope: Bare),
                            riders: [],
                        ),
                        agent: You,
                    ),
                ]),
            ),
        ],
    ),
))
