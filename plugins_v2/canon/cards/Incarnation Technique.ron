// "Demonstrate / Mill five cards, then return a creature card from your graveyard
// to the battlefield." [CR#702.144a,701.17a]
SingleFaced(face: (
    characteristics: (
        name: "Incarnation Technique",
        cost: [
            4,
            Black,
        ],
        types: [Sorcery],
        text: [
            demonstrate,
            spell(
                timing: None,
                instruction: sequentially(steps: [
                    mill(5, you, you),
                    enact(
                        verb: Core(Return),
                        instruction: move(subject: described( determiner: A(Unmarked), predicate: and( conjuncts: [ hasType(type: Creature), inZone( zone: zone( zone: Graveyard, scope: PossessedBy(you), ), ), ], ), ), destination: zone(zone: Battlefield, scope: Bare)),
                        agent: you,
                    ),
                ]),
            ),
        ],
    ),
))
