// "All Sliver creatures have absorb 1." [CR#702.64a]
SingleFaced(face: (
    characteristics: (
        name: "Lymph Sliver",
        cost: [
            4,
            White,
        ],
        types: [Creature],
        subtypes: [Of(host: Creature, label: "Sliver")],
        power: 3,
        toughness: 3,
        text: [
            static(
                spec: abilityGrant(
                    subject: described(
                        determiner: All,
                        predicate: and(
                            conjuncts: [
                                hasSubtype(subtype: Of(host: Creature, label: "Sliver")),
                                hasType(type: Creature),
                            ],
                        ),
                    ),
                    ability: absorb(1),
                ),
            ),
        ],
    ),
))
