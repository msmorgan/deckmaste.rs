// "All Sliver creatures have absorb 1." [CR#702.64a]
SingleFaced(face: (
    characteristics: (
        name: "Lymph Sliver",
        cost: [
            Simple(symbol: Generic(amount: 4)),
            Simple(symbol: Specific(color: Of(color: White))),
        ],
        types: [Creature],
        subtypes: [Of(host: Creature, label: "Sliver")],
        power: Lit(value: 3),
        toughness: Lit(value: 3),
        text: [
            static(
                spec: abilityGrant(
                    subject: described(
                        determiner: All,
                        predicate: and(
                            conjuncts: [
                                hasSubtype(subtype: Of(host: Creature, label: "Sliver")),
                                hasType(type: Creature),
                            ],
                        ),
                    ),
                    ability: absorb(Lit(value: 1)),
                ),
            ),
        ],
    ),
))
