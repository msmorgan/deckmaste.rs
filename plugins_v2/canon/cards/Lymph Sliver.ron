// "All Sliver creatures have absorb 1." [CR#702.64a]
SingleFaced(face: (
    characteristics: (
        name: "Lymph Sliver",
        cost: [
            4,
            White,
        ],
        types: [Creature],
        subtypes: [sliver],
        power: 3,
        toughness: 3,
        text: [
            static(
                abilityGrant(
                    subject: described(
                        determiner: All,
                        predicate: and(
                            [
                                hasSubtype(sliver),
                                hasType(Creature),
                            ],
                        ),
                    ),
                    ability: absorb(1),
                ),
            ),
        ],
    ),
))
