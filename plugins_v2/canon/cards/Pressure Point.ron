// "Tap target creature. Draw a card." [CR#701.26a]
SingleFaced(face: (
    characteristics: (
        name: "Pressure Point",
        cost: [
            Simple(symbol: Generic(amount: 1)),
            Simple(symbol: Specific(color: Of(color: White))),
        ],
        types: [Instant],
        text: [
            spell(
                timing: None,
                instruction: sequentially(steps: [
                    tap(described(
                        determiner: Target(quantity: range(low: 1, high: 1)),
                        predicate: hasType(type: Creature),
                    )),
                    draw(amount: Lit(value: 1), agent: you),
                ]),
            ),
        ],
    ),
))
