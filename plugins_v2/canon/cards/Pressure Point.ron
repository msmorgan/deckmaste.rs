// "Tap target creature. Draw a card." [CR#701.26a]
SingleFaced((
    characteristics: (
        name: "Pressure Point",
        cost: [
            1,
            White,
        ],
        types: [Instant],
        text: [
            spell(
                timing: None,
                instruction: sequentially(steps: [
                    tap(described(
                        determiner: Target(range(low: 1, high: 1)),
                        predicate: hasType(type: Creature),
                    )),
                    draw(amount: 1, agent: you),
                ]),
            ),
        ],
    ),
))
