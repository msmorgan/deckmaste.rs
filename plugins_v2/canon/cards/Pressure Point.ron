// "Tap target creature. Draw a card." [CR#701.26a]
SingleFaced(face: (
    characteristics: (
        name: "Pressure Point",
        cost: [
            1,
            White,
        ],
        types: [Instant],
        text: [
            spell(
                timing: None,
                instruction: sequentially([
                    tap(described(
                        determiner: Target(range(low: 1, high: 1)),
                        predicate: hasType(Creature),
                    )),
                    draw(amount: 1, agent: you),
                ]),
            ),
        ],
    ),
))
