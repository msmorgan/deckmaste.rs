// "Detain target creature an opponent controls. Draw a card." [CR#701.35a]
SingleFaced(face: (
    characteristics: (
        name: "Inaction Injunction",
        cost: [
            1,
            Blue,
        ],
        types: [Sorcery],
        text: [
            spell(
                timing: None,
                instruction: sequentially([
                    detain(described(
                        determiner: Target(range(low: 1, high: 1)),
                        predicate: and([
                            hasType(Creature),
                            hasPossessor(
                                axis: Controller,
                                possessor: described(determiner: A(Unmarked), predicate: opponent),
                            ),
                        ]),
                    )),
                    draw(amount: 1, agent: you),
                ]),
            ),
        ],
    ),
))
