SingleFaced(face: (
    characteristics: (
        name: "Sylvok Battle-Chair",
        cost: [
            Simple(symbol: Generic(amount: 4)),
            Simple(symbol: Specific(color: Of(color: Green))),
            Simple(symbol: Specific(color: Of(color: Green))),
        ],
        types: [Artifact],
        subtypes: [Of(host: Artifact, label: "Equipment")],
        text: [
            forMirrodin,
            static(
                spec: conjunction(
                    subject: None,
                    parts: [
                        modification(
                            subject: attachHost(word: Equipped, head: Type(type: Creature)),
