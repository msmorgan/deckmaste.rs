// "For Mirrodin! / Equipped creature gets +4/+4 and has trample. / Equip {5}{G}{G}"
// [CR#702.163a,702.19a,702.6a]
SingleFaced(face: (
    characteristics: (
        name: "Sylvok Battle-Chair",
        cost: [
            4,
            Green,
            Green,
        ],
        types: [Artifact],
        subtypes: [equipment],
        text: [
            forMirrodin,
            static(
                conjunction(
                    subject: None,
                    parts: [
                        modification(
                            subject: attachHost(word: Equipped, head: Type(Creature)),
                            stat: Power,
                            delta: up(4),
                        ),
                        modification(
                            subject: attachHost(word: Equipped, head: Type(Creature)),
                            stat: Toughness,
                            delta: up(4),
                        ),
                        abilityGrant(
                            subject: attachHost(word: Equipped, head: Type(Creature)),
                            ability: trample,
                        ),
                    ],
                ),
            ),
            equip(mana([
                5,
                Green,
                Green,
            ])),
        ],
    ),
))
