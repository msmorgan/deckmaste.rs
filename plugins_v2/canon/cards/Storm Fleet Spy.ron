// "Raid — When this creature enters, if you attacked this turn, draw a
// card."
//
// `Raid(<ability>)` is the ability word's own declaration invoked at this
// `Ability` position; it expands to the `ItalicHead` its body builds.
SingleFaced(face: (
    characteristics: (
        name: "Storm Fleet Spy",
        cost: [Simple(symbol: Generic(amount: 2)), Simple(symbol: Specific(color: Of(color: Blue)))],
        types: [Creature],
        subtypes: [Of(host: Creature, label: "Human"), Of(host: Creature, label: "Pirate")],
        text: [
            Raid(
                Triggered(
                    event: ZoneChange(
                        subject: AsType(type: Creature, subject: This, subtype: None),
                        to: Zone(zone: Battlefield, scope: Bare),
                        observation: After,
                    ),
                    alternatives: [],
                    joins: [],
                    intervening: Happened(
                        subject: You,
                        lookback: Mk(
                            event: Combat(relation: AttackerOf, subject: Gap(kind: Player), counterpart: None),
                            lookback: ThisTurn,
                        ),
                    ),
                    instruction: Draw(amount: Lit(value: 1), agent: You),
                )
            ),
        ],
        power: Lit(value: 2),
        toughness: Lit(value: 2),
    ),
))
