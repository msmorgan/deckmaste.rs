        name: "Thraben Inspector",
        cost: [White],
        types: [Creature],
        subtypes: [
            human,
            soldier,
        ],
        power: 1,
        toughness: 2,
        text: [
            triggered(event: zoneChange(asType(type: Creature, subject: this, subtype: None), After, None, zone(zone: Battlefield, scope: Bare)), instruction: investigate),
