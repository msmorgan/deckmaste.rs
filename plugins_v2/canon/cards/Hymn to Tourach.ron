// "Target player discards two cards at random." The target player discards
// through a handoff, from their own hand [CR#701.9a]; the random selection is
// marked on the indefinite [CR#701.9b].
SingleFaced(face: (
    characteristics: (
        name: "Hymn to Tourach",
        cost: [Black, Black],
        types: [Sorcery],
        text: [
            spell(
                timing: None,
                instruction: act(target(anyPlayer), discard(random(exactly(2), isCard))),
            ),
        ],
    ),
))
