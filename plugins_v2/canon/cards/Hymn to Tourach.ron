// "Target player discards two cards at random." The random selection is
// marked on the indefinite [CR#701.9b]; the hand names the player once.
SingleFaced(face: (
    characteristics: (
        name: "Hymn to Tourach",
        cost: [Black, Black],
        types: [Sorcery],
        text: [
            spell(
                timing: None,
                instruction: discard(
                    random(exactly(2), cardIn(handOf(target(anyPlayer)))),
                ),
            ),
        ],
    ),
))
