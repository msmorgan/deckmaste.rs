// "Spectacle {1}{B} / Return up to two target creature cards from your graveyard to
// your hand." [CR#702.137a]
SingleFaced(face: (
    characteristics: (
        name: "Dead Revels",
        cost: [
            3,
            Black,
        ],
        types: [Sorcery],
        text: [
            spectacle(mana(cost: [
                1,
                Black,
            ])),
            spell(
                timing: None,
                instruction: enact(
                    verb: Core(Return),
                    instruction: move(subject: described( determiner: Target(range(low: 0, high: 2)), predicate: and( conjuncts: [ isCard, hasType(type: Creature), inZone( zone: zone( zone: Graveyard, scope: PossessedBy(you), ), ), ], ), ), destination: zone(zone: Hand, scope: Bare)),
                    agent: None,
                ),
            ),
        ],
    ),
))
