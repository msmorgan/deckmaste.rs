// "Enchant creature / Enchanted creature gets +10/+10 and has trample and
// annihilator 2." [CR#702.5a,702.19a,702.86a]
SingleFaced(face: (
    characteristics: (
        name: "Eldrazi Conscription",
        cost: [Simple(symbol: Generic(amount: 8))],
        types: [Kindred, Enchantment],
        subtypes: [
            Of(host: Creature, label: "Eldrazi"),
            Of(host: Enchantment, label: "Aura"),
        ],
        text: [
            keywordSubject(label: "Enchant", subject: hasType(type: Creature)),
            static(
                spec: conjunction(
                    subject: None,
                    parts: [
                        modification(
                            subject: attachHost(word: Enchanted, head: Type(type: Creature)),
                            stat: Power,
                            delta: up(amount: Lit(value: 10)),
                        ),
                        modification(
                            subject: attachHost(word: Enchanted, head: Type(type: Creature)),
                            stat: Toughness,
                            delta: up(amount: Lit(value: 10)),
                        ),
                        abilityGrant(
                            subject: attachHost(word: Enchanted, head: Type(type: Creature)),
                            ability: trample,
                        ),
                        abilityGrant(
                            subject: attachHost(word: Enchanted, head: Type(type: Creature)),
                            ability: annihilator(Lit(value: 2)),
                        ),
                    ],
                ),
            ),
        ],
    ),
))
