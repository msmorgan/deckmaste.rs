// "Enchant creature / Enchanted creature gets +10/+10 and has trample and
// annihilator 2." [CR#702.5a,702.19a,702.86a]
SingleFaced(face: (
    characteristics: (
        name: "Eldrazi Conscription",
        cost: [8],
        types: [Kindred, Enchantment],
        subtypes: [
            eldrazi,
            aura,
        ],
        text: [
            keywordSubject(label: "Enchant", subject: hasType(Creature)),
            static(
                conjunction(
                    subject: None,
                    parts: [
                        modification(
                            subject: attachHost(word: Enchanted, head: Type(Creature)),
                            stat: Power,
                            delta: up(10),
                        ),
                        modification(
                            subject: attachHost(word: Enchanted, head: Type(Creature)),
                            stat: Toughness,
                            delta: up(10),
                        ),
                        abilityGrant(
                            subject: attachHost(word: Enchanted, head: Type(Creature)),
                            ability: trample,
                        ),
                        abilityGrant(
                            subject: attachHost(word: Enchanted, head: Type(Creature)),
                            ability: annihilator(2),
                        ),
                    ],
                ),
            ),
        ],
    ),
))
