// "Casualty 2 / Light 'Em Up deals 2 damage to target creature or
// planeswalker." [CR#702.153a]
SingleFaced(face: (
    characteristics: (
        name: "Light 'Em Up",
        cost: [
            1,
            Red,
        ],
        types: [Sorcery],
        text: [
            casualty(2),
            spell(dealDamage(this, 2, target(or([creature, planeswalker])))),
        ],
    ),
))
