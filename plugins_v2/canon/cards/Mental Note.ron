// "Mill two cards. Draw a card." The bare imperative mills your own library
// [CR#701.17a], so both the miller and the library's owner are you.
SingleFaced(face: (
    characteristics: (
        name: "Mental Note",
        cost: [Simple(symbol: Specific(color: Of(color: Blue)))],
        types: [Instant],
        text: [
            Spell(
                timing: None,
                instruction: Sequentially(steps: [
                    Mill(Lit(value: 2), You, You),
                    Draw(amount: Lit(value: 1), agent: You),
                ]),
            ),
        ],
    ),
))
