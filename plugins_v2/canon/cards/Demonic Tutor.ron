// "Search your library for a card, put that card into your hand, then
// shuffle." [CR#701.23a]: the raw `Instruction::search` constructor already
// carries the whole procedure.
SingleFaced(face: (
    characteristics: (
        name: "Demonic Tutor",
        cost: [
            Simple(symbol: Generic(amount: 1)),
            Simple(symbol: Specific(color: Of(color: Black))),
        ],
        types: [Sorcery],
        text: [
            Spell(
                timing: None,
                instruction: Search(
                    scope: OneZone(zone: Zone(zone: Library, scope: PossessedBy(possessor: You))),
                    quantity: Range(low: 1, high: 1),
                    predicate: And(conjuncts: []),
                    agent: You,
                ),
            ),
        ],
    ),
))
