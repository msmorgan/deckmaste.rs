// "Search your library for a card, put that card into your hand, then
// shuffle." [CR#701.23a]: the raw `Instruction::search` constructor already
// carries the whole procedure.
SingleFaced(face: (
    characteristics: (
        name: "Demonic Tutor",
        cost: [
            1,
            Black,
        ],
        types: [Sorcery],
        text: [
            spell(
                timing: None,
                instruction: search(OneZone(zone(zone: Library, scope: PossessedBy(you))), range(low: 1, high: 1), and([]), you),
            ),
        ],
    ),
))
