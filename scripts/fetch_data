#!/usr/bin/env fish

source (status dirname)/lib/setup.fish
or return

argparse m/minimal c/cr -- $argv; or return

# --minimal: download only what `cargo xtask generate plugins/wizards` and the
# English catalog loader need.
# Without the flag: also download the reference files used by local audits.
# --cr: include the plain-text Comprehensive Rules with a minimal download.
set -q _flag_minimal; and set -g _minimal
set -q _flag_cr; and set -g _include_cr

function fetch_mtgjson
    if not set -q _minimal
        set wanted \
            Meta.json \
            CompiledList.json \
            EnumValues.json \
            Keywords.json \
            CardTypes.json \
            SetList.json \
            AllPrintings.json \
            AllSetFiles.tar \
            AllPrintings.sqlite
        mtgjson download $wanted
    end
end

function fetch_rules
    # The generator needs keywords.json; cr.txt/cr.json are reference inputs for
    # citation and catalog audits, which the first-run demo can skip.
    set wanted cr/keywords:keywords.json
    if not set -q _minimal
        set -a wanted \
            file/cr:cr.txt \
            cr:cr.json
    else if set -q _include_cr
        set -a wanted file/cr:cr.txt
    end
    academyruins download $wanted
end

function fetch_scryfall_catalogs
    # flavor-words is the one catalog the English loader reads straight from the
    # Scryfall dump rather than from a generated CR-derived file, so it belongs
    # to the minimal set even though the rest of the Scryfall-only catalogs do
    # not.
    set wanted_catalogs \
        artifact-types battle-types creature-types enchantment-types \
        land-types planeswalker-types spell-types flavor-words
    if not set -q _minimal
        set -a wanted_catalogs \
            card-names artist-names word-bank supertypes card-types \
            powers toughnesses loyalties keyword-abilities keyword-actions \
            ability-words watermarks
    end

    set wanted_files_map
    for catalog in $wanted_catalogs
        set -a wanted_files_map catalog/$catalog:$catalog.json
    end
    scryfall download $wanted_files_map
end

scryfall oracle-cards
or return
fetch_mtgjson
or return
fetch_rules
or return
fetch_scryfall_catalogs
