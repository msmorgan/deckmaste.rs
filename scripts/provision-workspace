#!/usr/bin/env fish
# jj-workflow provision hook: populate a new workspace's gitignored shared dirs.
# Run by `kata claim/start` after `jj workspace add`, with the new workspace dir
# as $argv[1]; for a hand-built workspace, run it yourself from `default`:
#   scripts/provision-workspace .workspaces/NAME
#
# What it does: `data` is symlinked back to `default`. Each dir present under
# `default/docs/` but absent from the new tracked workspace is symlinked too,
# sharing ignored local dirs such as `docs/superpowers` and `docs/memory` while
# leaving tracked documentation alone. `plugins/wizards` is generated as a real
# dir, never a symlink (deckmaste_plugin's suite loads it, and a symlink would
# make generate write into the main checkout). `default`'s `target/` is
# CoW-reflinked as a best-effort build-cache pre-warm, then every tracked file
# whose bytes match `default`'s copy gets `default`'s mtime, so only crates
# whose sources truly differ rebuild. `lean/.lake` is reflinked the same way
# (only as fresh as `default`'s last `lake build`). Verify with a real `jj st`
# (not `--ignore-working-copy`): it must report no changes.

set ws_dir $argv[1]
if test -z "$ws_dir"; or not test -d "$ws_dir"
    echo >&2 "$(status filename): usage: provision-workspace WS_DIR"
    exit 2
end

# The coordinator's dir name is not fixed — resolve it via jj, never ../default.
set default_dir (jj -R "$ws_dir" workspace root --name default)
or begin
    echo >&2 "$(status filename): could not resolve the default workspace root."
    exit 1
end
# Absolute from here on: the script changes directory below.
set ws_dir (path resolve "$ws_dir")
# cwd-independent from here: cargo xtask needs the workspace root.
cd "$default_dir"
or exit 1

# Phase timing: one stderr line per phase, so a slow provision names its cause.
function phase_done --argument-names name start
    set -l ms (math --scale=0 "($(date +%s%N) - $start) / 1000000")
    echo >&2 "provision-workspace: $name "(math --scale=1 "$ms / 1000")"s"
end

# Link the ignored data dir into the workspace instead of re-downloading it.
set t (date +%s%N)
ln -sfn "$default_dir/data" "$ws_dir/data"

# If the user has any globally-ignored directories under docs (like the default
# superpowers config does) we link those too.
and begin
    set -l failures
    for docs_subdir in (path basename "$default_dir/docs"/*/)
        if not test -e "$ws_dir/docs/$docs_subdir"
            ln -sfn "$default_dir/docs/$docs_subdir" "$ws_dir/docs/$docs_subdir"
            or set -a failures "$docs_subdir"
        end
    end
    not set -q failures[1]
end
and phase_done symlinks $t

# Re-generate cards from Oracle text. Run default's built xtask binary directly
# (it is what the `cargo xtask` alias runs): `cargo xtask` takes cargo's build
# lock on default's target/, so any other cargo build in default stalls
# provisioning, and with it every other session's kata claim (.jj/kata.lock).
# Fall back to cargo only when the binary is missing. A stale binary only
# matters when the generator itself changed, and a ticket changing the
# generator rebuilds before it provisions.
and set t (date +%s%N)
and begin
    if test -x "$default_dir/target/debug/cargo-xtask"
        "$default_dir/target/debug/cargo-xtask" generate "$ws_dir/plugins/wizards"
    else
        cargo xtask generate "$ws_dir/plugins/wizards"
    end
end
and phase_done "wizards generate" $t

or begin
    echo >&2 "$(status filename): $ws_dir's jj structure is set, but shared-dir provisioning failed — check symlinks and run 'cargo xtask generate $ws_dir/plugins/wizards' by hand."
    exit 1
end

# Pre-warm the build cache (best-effort): CoW-reflink default's target/ into the
# new workspace. Cargo's unit metadata hashes are path-independent, so every
# unit — registry/git deps and workspace crates alike — keeps its hash in the
# new workspace. What would still force workspace crates to rebuild is mtimes:
# the jj checkout stamps every tracked file with the checkout time, newer than
# the reflinked fingerprints. The mtime sync below fixes that. Skip
# incremental/: rustc keys incremental state on the session's working
# directory, so it won't apply at a fresh path and only bloats the copy.
# --reflink=auto is instant and ~zero-space on btrfs (falls back to a plain copy
# elsewhere); /target/ is gitignored so jj won't snapshot it. A miss here just
# means a cold first build.
#
# lean/.lake is seeded the same way (best-effort CoW reflink, plain-copy fallback,
# never a symlink: lake writes into it). Without it a fresh workspace's first Lean
# build is cold (~7 minutes against ~2 s warm). Skipped if default has none.
set -l target_warm 0
if test -d "$default_dir/target"
    set t (date +%s%N)
    if cp --reflink=auto -a "$default_dir/target" "$ws_dir/target"
        rm -rf "$ws_dir/target"/{debug,release}/incremental
        set target_warm 1
        phase_done "target reflink" $t
    else
        echo >&2 "$(status filename): target/ pre-warm into $ws_dir failed — first build there starts cold (harmless)."
    end
end

# Invalidate the units that baked another checkout's path (only after a
# successful target pre-warm). `env!("CARGO_MANIFEST_DIR")` and `env!("OUT_DIR")`
# compile an absolute path into the binary — xtask and over a hundred test and
# library files do this to find the repo root. rustc records each read in the
# unit's deps/*.d file (`# env-dep:CARGO_MANIFEST_DIR=...`), but cargo drops the
# variables it sets itself from its own fingerprint dep-info, so a reflinked unit
# whose sources match stays fresh and keeps running against `default` (or
# whichever workspace last built it). Delete the fingerprint dir of every unit
# whose recorded env-dep names a path under the coordinator checkout but outside
# this workspace; cargo rebuilds exactly those and their dependents, and the
# rest of the warm cache survives. The fingerprint dir shares the unit's
# metadata hash with its deps/NAME-HASH.d file.
if test $target_warm -eq 1
    set t (date +%s%N)
    set -l stale (sh -c '
        grep -l -F "=$1" "$2"/target/*/deps/*.d "$2"/target/*/*/deps/*.d 2>/dev/null |
        while IFS= read -r d; do
            awk -v D="$1" -v W="$2" "
                /^# env-dep:/ {
                    v = substr(\$0, index(\$0, \"=\") + 1)
                    if ((v == D || index(v, D \"/\") == 1) && !(v == W || index(v, W \"/\") == 1)) found = 1
                }
                END { exit !found }" "$d" || continue
            hash=${d##*-}; hash=${hash%.d}
            for fp in "${d%/deps/*}"/.fingerprint/*-"$hash"; do
                [ -d "$fp" ] || continue
                rm -rf "$fp" || exit 1
                echo "$fp"
            done
        done' sh "$default_dir" "$ws_dir")
    or echo >&2 "$(status filename): baked-path invalidation in $ws_dir failed — run 'cargo clean -p xtask' (and any crate whose tests read the wrong checkout) by hand."
    echo >&2 "provision-workspace: baked-path invalidation: "(count $stale)" units"
    phase_done "baked-path invalidation" $t
end

# Sync mtimes (best-effort, only after a successful target pre-warm): give
# every tracked file whose bytes equal default's copy default's mtime, so cargo
# sees exactly the files that truly differ as changed and rebuilds only the
# crates that own them. Symlinked and missing paths are skipped. jj tracks
# content, not mtimes, so this leaves the working copy clean. A failure here
# only costs the cold rebuild the sync would have avoided.
if test $target_warm -eq 1
    set t (date +%s%N)
    set -l results (sh -c '
        cd "$1" && jj --no-pager --ignore-working-copy file list | xargs -d "\n" -r -P "$(nproc)" -n 256 sh -c '"'"'
            d=$1; shift
            for f; do
                if [ -f "$f" ] && [ ! -L "$f" ] && [ -f "$d/$f" ] && [ ! -L "$d/$f" ] \
                    && cmp -s "$d/$f" "$f" && touch -r "$d/$f" "$f"; then
                    echo S
                else
                    echo D
                fi
            done'"'"' sh "$2"' sh "$ws_dir" "$default_dir" 2>/dev/null)
    if set -q results[1]
        set -l synced (string match -- S $results | count)
        set -l differing (string match -- D $results | count)
        echo >&2 "provision-workspace: mtime sync: $synced synced, $differing differing"
        phase_done "mtime sync" $t
    else
        echo >&2 "$(status filename): mtime sync into $ws_dir failed — workspace crates rebuild cold (harmless)."
    end
end

if test -d "$default_dir/lean/.lake"
    set t (date +%s%N)
    if cp --reflink=auto -a "$default_dir/lean/.lake" "$ws_dir/lean/.lake"
        phase_done "lean/.lake reflink" $t
    else
        rm -rf "$ws_dir/lean/.lake"
        echo >&2 "$(status filename): lean/.lake seed into $ws_dir failed — first Lean build there starts cold (harmless)."
    end
end
exit 0
