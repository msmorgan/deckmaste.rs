// The Oracle English grammar data file. It names Categories, features,
// Schemas and core closed-class lexemes only: every other word, and every
// Subcategorization Frame, comes from the lexical environment it is bound to.
(
    root: "Document",
    features: {
        // A keyword mention may omit parameters; a Keyword Line supplies them.
        "KeywordForm": ["Bare", "Parametric"],
        // The kind of a keyword form's final Keyword Parameter, from its
        // catalog parameter frame; `SetOff` kinds follow an em dash. A set-off
        // cost ends in a period of its own, and an associated instruction may
        // follow it on the line; a set-off ability runs to the end of the
        // line (style guide §3 "Periods", §14 "Keyword abilities").
        "FinalParameter": ["Cost", "SetOffCost", "SetOffAbility"],
        "Number": ["Singular", "Plural"],
        // The Number of a noun's *of* oblique, or of a determinative's
        // Complement (*all but one*, *more than one*).
        "ObliqueNumber": ["Singular", "Plural"],
        // An adjective's inflectional grade, or the comparison a non-scalar
        // comparative governor marks: equality with *as* (*same*), or
        // inequality with *than* (*different*, *other*; CGEL, Ch. 13 §1.1,
        // p. 1100).
        "Grade": ["Plain", "Comparative", "Superlative", "Equative", "NonScalarInequality"],
        // Internal numeral–noun agreement survives external group respecification.
        "QuantityNumber": ["Singular", "Plural"],
        // The Number each conjunct of an *and*-coordination of nominals has,
        // which a determiner selects; the coordination itself is plural.
        "ConjunctNumber": ["Singular", "Plural"],
        // The Number of the first conjunct of an *and*-coordination of Noun
        // Phrases, which an existential *be* before it may agree with by
        // proximity (CGEL, Ch. 4 §3.2.2, p. 242, n. 21).
        "FirstConjunctNumber": ["Singular", "Plural"],
        // Oracle text has no first person.
        "Person": ["Second", "Third"],
        "VerbForm": ["Plain", "Finite", "GerundParticiple", "PastParticiple"],
        // A to-infinitival Clause is marked by its subordinator; a relative
        // clause by *that* or a relative phrase. `To` has one source, the
        // ToInfinitival Production, and is the whole class: only a clause
        // whose VP carries the subordinator *to* (CGEL, Ch. 2 §14, pp. 64–65)
        // is a ToInf Complement (InfinitivalComplement), takes a phrasal
        // adverb before it (ModifiedInfinitival), or follows *whether*
        // (ClosedInfinitivalInterrogative).
        "ClauseMarking": ["Unmarked", "To", "Relative"],
        "Voice": ["Active", "Passive"],
        // A verb whose Adjectival Passive is a declared Adjective (*tapped*);
        // privative: any other verb leaves it unvalued.
        "AdjectivalPassive": ["Lexical"],
        // Auxiliary verbs (CGEL's NICE verbs); privative: a lexical verb
        // leaves it unvalued.
        "VerbKind": ["Auxiliary"],
        // An auxiliary's form is Affirmative or Negative (*can*, *can't*); a
        // premodifier prefixed by *non-* is Negative
        // (`docs/oracle-style-guide.md` §7, Negation with non-), and any other
        // premodifier leaves it unvalued. An asyndetic chain of premodifiers
        // holds only Negative ones (§6, Determiners and modifier order).
        "Polarity": ["Affirmative", "Negative"],
        // The Slot Kind of a Preposition Phrase's Complement. `MeasureNP` has
        // one preposition holder, *of* (*your choice of 5/1 or 1/5*), and
        // `QuotedAbility` one, *with* (*a token with "This token can't
        // block."*): each is a Complement that is no ordinary Noun Phrase.
        // A bare slash measure occurs only where a head selects one (project
        // term Measure Noun Phrase; *get* selects it as its Object by frame),
        // and a quoted ability is the granted ability of [CR#113.1a],
        // which only a Nominal-hosted *with* takes, beside *has* and *gain*.
        "ComplementKind": ["NP", "MeasureNP", "PP", "AdjP", "AdvP", "Nominal", "Amount", "FiniteClause", "ExpandableClause", "SetOffClause", "VerblessClause", "AbsoluteClause", "ToInf", "Gerund", "BareInf", "KeywordPhrase", "QuotedAbility", "Mention", "Cost", "Intransitive", "AmountOrNP"],
        // The Slot Kind of a determinative's Preposition Phrase's Complement.
        "ObliqueKind": ["NP", "MeasureNP", "PP", "AdjP", "AdvP", "Nominal", "Amount", "FiniteClause", "ExpandableClause", "SetOffClause", "VerblessClause", "AbsoluteClause", "ToInf", "Gerund", "BareInf", "KeywordPhrase", "QuotedAbility", "Mention", "Cost", "Intransitive", "AmountOrNP"],
        // `Quantity` has one holder, *number*: the number-transparent
        // quantificational noun (*any number of target creatures*; CGEL,
        // Ch. 5 §3.3, pp. 349–351) that TransparentQuantity, TargetedQuantity
        // and FreeChoiceQuantity read; no other Oracle noun takes its
        // Number from its *of* oblique.
        // `Serial` has one holder, *time*, and that is the whole class: a
        // bounding frequency Noun Phrase has *times* as its head (*three
        // times*; CGEL, Ch. 8 §9, p. 715), and so does a cardinal multiplier
        // (*three times X*; Ch. 5 §12, p. 434).
        "NounDistribution": ["Ordinary", "Quantity", "DirectMeasure", "HeadOnly", "Serial"],
        // A fused-head quantity (*choose one*, *one or more*) is a Quantity.
        // `Manner` has one holder, *way*, the only Oracle noun that is a
        // Manner Adjunct without a governing preposition (*do it this way*;
        // CGEL, Ch. 8 §2.1, p. 671); MannerAdjunct reads it.
        "NounKind": ["Ordinary", "Temporal", "Manner", "Numeric", "Quantity"],
        // A noun whose values are cited names, the variable of a specifying
        // copular clause (*the new creature type can't be Wall*; CGEL, Ch. 4
        // §5.5, pp. 266-269): *type*. Carried by the Noun Phrase it heads.
        "Variable": ["Cited"],
        // The NounKind of a head's *of* oblique.
        "ObliqueNounKind": ["Ordinary", "Temporal", "Manner", "Numeric", "Quantity"],
        "Determination": ["Bare", "Overt"],
        // The Determination of a determinative's Complement (*than one*).
        "ObliqueDetermination": ["Bare", "Overt"],
        // The DeterminativeDistribution of a determinative's Complement's
        // Noun Phrase (*all but [the highest roll]*).
        "ObliqueDistribution": ["Dependent", "Independent", "Numerical", "IndefiniteArticle", "Distributive", "Deictic", "SingularOrQuantified", "FreeChoice", "Multiplier", "Targeting"],
        "AdjectivePosition": ["Attributive", "Predicative"],
        "Sign": ["Negative", "Zero", "Positive"],
        // `Existential` has one holder, dummy *there*, the subject of an
        // existential clause (CGEL, Ch. 16 §6.2, p. 1394); the Existential
        // Production reads it, and the Pronoun Production excludes it.
        "PronounKind": ["Personal", "Existential", "Relative"],
        // `FreeChoice` has one holder, *any*, and that is the whole class, as
        // `Serial` is *time*. Determined and DeterminedModifiedQuantity
        // exclude it, two admission gates (`docs/decisions/english-v4.md`
        // §4.5): Determined's routes *any* to FreeChoiceDetermined,
        // TransparentQuantity and TemporalQuantity, which carry number
        // transparency (CGEL, Ch. 5 §3.3, pp. 349–351: never *any number of
        // target creatures becomes*); and with
        // DeterminedModifiedQuantity's, neither Production builds a second
        // tree of an analysis FreeChoiceDetermined or AgreeingModifiedQuantity
        // builds (`docs/decisions/english-lexical-analysis.md` §2).
        // `IndefiniteArticle` (*a*) and `SingularOrQuantified` (*another*) each
        // have one holder, and each is the whole of its class. *A* alone
        // selects a singular head (CGEL, Ch. 5 §3.4, p. 353, set (a) [67]);
        // *another* is the one word that also selects a quantified plural
        // (*another three bodies*; set (c) [69–70]), where *a* does so only
        // with *further* or *additional*, read by DeterminedModifiedQuantity.
        // The two also part in temporal location: *another day*, never *a
        // day* (Ch. 8 §6.3, p. 698), an admission gate on TemporalLocation
        // (`docs/decisions/english-v4.md` §4.5).
        // `Targeting` has one holder, the Targeting Marker *target* (project
        // term, `docs/contexts/oracle-english/CONTEXT.md`): a determinative
        // that only determines a nominal, so it is kept apart from
        // `Dependent`, which FusedDegreeDeterminer and DegreePartitive
        // require, and it never fuses or partitions (not *choose target*,
        // *target of those*). TargetedNounPhrase and BareTargetingMarker
        // carry it.
        "DeterminativeDistribution": ["Dependent", "Independent", "Numerical", "IndefiniteArticle", "Distributive", "Deictic", "SingularOrQuantified", "FreeChoice", "Multiplier", "Targeting"],
        "Case": ["Plain", "Nominative", "Accusative", "Genitive"],
        "Countability": ["Count", "Mass"],
        // `Linking` is the position of a connective that marks a Linked
        // Coordination, initial in its Linked Conjunct (CGEL, Ch. 15 §2.10,
        // pp. 1319–1320).
        // `Multiplying` is the position of a multiplier of a quantity (*twice
        // the damage*), which is also a frequency adverb at the end of a Verb
        // Phrase (*draw a card twice*): it modifies a Noun Phrase or a
        // measure only, never a Preposition Phrase or a temporal Noun Phrase,
        // where it would build a second tree for the frequency adverb's
        // Adjunct (`english-lexical-analysis.md` §2, frequency interval).
        "AdjunctPosition": ["Front", "Central", "End", "Phrasal", "Multiplying", "Bounding", "Linking"],
        // A Clause whose front position holds a dependent set off by a comma
        // (*If you do, ...*, *Once each turn, ...*). Front dependents that
        // share one comma are siblings in one Production (*Then if ...*,
        // *Once during each of your turns, ...*), so a front Adverb Phrase
        // without a comma never also precedes such a Clause: one tree per
        // analysis (`english-lexical-analysis.md` §2). A Clause coordination
        // takes it from its first conjunct, where its front position is:
        // front dependents sharing one comma are siblings whether they scope
        // over the first conjunct or the whole (*Once each turn, C1, and
        // C2*), never split between the two.
        "FrontPosition": ["Occupied"],
        // A Verb Phrase that begins with a central Adjunct (*also gains
        // trample*). A bare imperative has no Subject, so its front and
        // central positions coincide: an adverb before it is its Clause's
        // front Adjunct (*Also draw a card*, *Then [draw a card and discard
        // a card]*), as a chain of bare imperatives is coordinated Clauses,
        // and never also a central Adjunct of its Verb Phrase: one tree per
        // analysis (`english-lexical-analysis.md` §2).
        "CentralPosition": ["Occupied"],
        // A Conjunct of a Word-Part Coordination: a Compound Noun's first
        // base alone, sharing the head word of the last Conjunct, the
        // `Whole` Compound Noun (CGEL, Ch. 15 §3.1(g), p. 1325).
        "CompoundPart": ["Base", "Whole"],
        "Inflection": ["Invariant", "IndependentGenitive", "Singular", "Plural", "Plain", "Present", "Preterite", "Irrealis", "GerundParticiple", "PastParticiple"],
    },
    categories: {
        "Document": (),
        "Paragraphs": (),
        "ModalHeader": (),
        "ModalAbility": (),
        "SymbolCosts": (),
        "ActivationCost": (),
        "NonManaCost": (),
        "Mode": (),
        "ModeEffect": (),
        "Effect": (),
        "Pawprints": (),
        "TypeModifier": (),
        "Modes": (),
        "Ability": (),
        "TypeLine": (),
        "CardTypes": (),
        "Subtypes": (),
        "KeywordList": (),
        "Quality": (),
        "Name": (),
        "Condition": (),
        "Measure": (),
        "Symbols": (),
        // An Arabic numeral named as a noun, without the numeral's Number.
        "NumeralName": (),
        // A bracketed loyalty symbol: a cost, or a counted noun (*an
        // additional [+1]*).
        "LoyaltySymbol": (),
        "Header": (),
        "RowHeader": (),
        "Chapters": (),
        "IndexedNominal": (features: ["Number"]),
        "NominalModifier": (),
        "ChoiceQuantity": (features: ["Number"]),
        "Sentence": (),
        "Sentences": (),
        // A Clause's Inflection is its finite verb's: an independent clause
        // excludes the irrealis *were* (CGEL, Ch. 3 §1.5, pp. 85–88).
        "Clause": (features: ["VerbForm", "ClauseMarking", "Inflection", "FrontPosition"], gap: true),
        // A subject relative agrees with its antecedent in number; an
        // adverbial relative modifies a temporal nominal.
        "RelativeClause": (features: ["Number", "NounKind", "ClauseMarking"]),
        // A finite clause whose Subject is its Gap (CGEL, Ch. 12 §3.3(a), p. 1044).
        "SubjectGapClause": (category: Some("Clause"), features: ["Number", "Person", "VerbForm", "Inflection"], gap: true),
        // A finite clause with an extracted Adjunct.
        "AdjunctGapClause": (category: Some("Clause"), features: ["VerbForm"], gap: true),
        // A finite clause that opens with its Subject, as a bare relative's
        // does: no preposed adjunct comes before it (CGEL, Ch. 12 §3.5.5,
        // p. 1055). An admission gate (ADR english-v4.md §4.5): "Bare
        // relatives always have the subject in initial position", so the
        // Category restates the Clause Productions that open with the Subject
        // and omits those that front an adjunct.
        "SubjectInitialClause": (category: Some("Clause"), features: ["VerbForm", "Inflection"], gap: true),
        // A coordination of bare adverbial relatives' Clauses.
        "SubjectInitialCoordination": (category: Some("Clause"), features: ["VerbForm", "Inflection"], gap: true),
        // A participle premodifying a nominal (*attacking creature*).
        "Participle": (category: Some("VerbPhrase"), features: ["Inflection", "Polarity"]),
        "VerbPhrase": (features: ["Number", "Person", "VerbForm", "Voice", "VerbKind", "Inflection", "AdjectivalPassive", "CentralPosition"], gap: true),
        // The Linked Conjunct of a Linked Coordination: a Clause or Verb
        // Phrase marked by its initial linking connective, its Adjunct
        // (*Draw a card, [then discard a card]*; *Each player discards a
        // card, [then draws a card]*; CGEL, Ch. 15 §2.10, pp. 1319–1320).
        "LinkedClause": (category: Some("Clause"), features: ["VerbForm", "ClauseMarking", "Inflection", "FrontPosition"], gap: true),
        "LinkedVerbPhrase": (category: Some("VerbPhrase"), features: ["Number", "Person", "VerbForm", "Voice", "VerbKind", "Inflection", "AdjectivalPassive", "CentralPosition"], gap: true),
        // Existential *there* and the predicate it is subject of (CGEL, Ch. 16
        // §6.1, p. 1391).
        "DummyPronoun": (category: Some("NounPhrase"), features: ["Number", "Person"]),
        "ExistentialPredicate": (category: Some("VerbPhrase"), features: ["Number", "Person", "VerbForm", "Inflection", "ComplementKind"]),
        "FusedNounPhrase": (category: Some("NounPhrase"), features: ["Number", "Person", "Case", "Determination", "NounKind", "Countability", "DeterminativeDistribution"]),
        // A symbol sequence as a Noun Phrase, which a Preposition Phrase may
        // postmodify (*{X} in its mana cost*).
        "SymbolHead": (category: Some("NounPhrase"), features: ["Number", "Person", "Case", "Determination", "NounKind", "Countability"]),
        // A determinative or a quantity with its partitive oblique, which a
        // Preposition Phrase may postmodify (*one of them of their choice*)
        // and a relative clause may postmodify (*each of those cards that has
        // suspend*). A fused partitive carries its determinative's
        // distribution: *each of X* has the same distributive head as *each
        // X* (CGEL, Ch. 5 §9.1, p. 411).
        "PartitiveHead": (category: Some("NounPhrase"), features: ["Number", "Person", "Case", "Determination", "NounKind", "Countability", "DeterminativeDistribution"]),
        // A slash measure as a Noun Phrase (*gets +2/+2*), taken only where a
        // head selects one, or beside keyword phrases naming counter kinds
        // (MeasureObjectConjunct): never a general Object or bare singular
        // term.
        "MeasureNounPhrase": (category: Some("NounPhrase")),
        // A compound locative determinative, which a Preposition Phrase may
        // postmodify (*anywhere else*).
        "LocativeHead": (category: Some("NounPhrase"), features: ["Number", "Person", "Case", "Determination", "NounKind", "Countability"]),
        // A Noun Phrase's DeterminativeDistribution is its determiner's: an
        // *and*-coordination of distributive ones is singular (*each dog and
        // each cat has*; CGEL, Ch. 5 §18.4, p. 508).
        // A noun's Amount Complement is a Nominal dependent, so a slash
        // Measure is shared only by coordinated Nominals (*base power and
        // toughness 4/4*): a Noun Phrase never passes up a Measure Gap.
        "NounPhrase": (features: ["Variable", "Number", "Person", "Case", "Determination", "NounKind", "Countability", "DeterminativeDistribution", "FirstConjunctNumber"], gap: true, closed_gaps: ["Measure"]),
        // A temporal Noun Phrase Adjunct: of location (*this turn*; CGEL, Ch. 8
        // §6.3, p. 698) or of frequency (*three times*; Ch. 8 §9, pp. 713–716).
        "TemporalNounPhrase": (category: Some("NounPhrase"), features: ["Number", "Person", "Case", "Determination", "NounKind", "Countability"]),
        "ComplementNounPhrase": (category: Some("NounPhrase"), features: ["Number", "Person", "Case", "Determination", "NounKind", "Countability", "DeterminativeDistribution"], gap: true),
        // A nominal's ComplementKind and ObliqueNumber are its head noun's
        // Complement's.
        "Nominal": (features: ["Variable", "Number", "Countability", "NounKind", "Determination", "NounDistribution", "ComplementKind", "ObliqueNumber", "ObliqueNounKind", "ConjunctNumber", "CompoundPart"], gap: true),
        "QuantifiedNominal": (category: Some("Nominal"), features: ["QuantityNumber", "NounKind", "Determination", "NounDistribution"]),
        "ModifiedQuantifiedNominal": (category: Some("Nominal"), features: ["QuantityNumber", "NounKind", "Determination", "NounDistribution"]),
        // A temporal nominal bounded by a relative clause (*next time you cast a
        // spell*). An admission gate (`docs/decisions/english-v4.md` §4.5),
        // a formation rule: a Noun Phrase is a temporal Adjunct only
        // in restricted forms (CGEL, Ch. 8 §6.3, p. 698), and a temporal
        // nominal in one takes a *when*-less adverbial relative clause, then at
        // most a temporal bound, and no other postmodifier (*the next time
        // [event] this turn*, `docs/oracle-style-guide.md` §11, Continuous and
        // bounded durations). RelativeTime and RelativeTimePostmodifier
        // restate NominalPostmodifier and TemporalPostmodifier for that reason.
        "RelativeTemporalNominal": (category: Some("Nominal"), features: ["Number", "Countability", "NounKind", "Determination", "NounDistribution"]),
        "BareNominal": (category: Some("Nominal"), features: ["Variable", "Number", "Countability", "NounKind", "Determination", "NounDistribution", "ComplementKind", "ObliqueNumber", "ObliqueKind", "ObliqueNounKind", "CompoundPart"], gap: true),
        "NounPremodifier": (category: Some("Nominal"), features: ["Polarity"]),
        // A Word-Part Coordination of Compound Nouns that share their head
        // word (*a +1/+1, first strike, or vigilance counter*), and each of
        // its Conjuncts: a first base alone, or, last, the whole Compound
        // Noun, which never splits (`english-lexical-analysis.md` §2).
        "CompoundCoordination": (category: Some("Nominal"), features: ["Number", "Countability", "NounKind", "NounDistribution"]),
        "CompoundConjunct": (category: Some("Nominal"), features: ["Number", "Countability", "NounKind", "NounDistribution", "CompoundPart"]),
        // A conjunct of a coordination of noun premodifiers: a noun premodifier,
        // with an adjective or negative noun premodifier of its own
        // (*Knight, Aura, Equipment, or [legendary artifact] card*;
        // *artifact or [non-Aura enchantment] card*; OSG §7).
        "NounPremodifierConjunct": (category: Some("Nominal")),
        "PrepositionalNominal": (category: Some("Nominal"), features: ["Number", "Countability", "NounDistribution"]),
        // A Number-transparent quantity's plural oblique whose determiner is
        // the Targeting Marker alone (*any number of target creatures*), and
        // the Noun Phrase in it.
        "TargetedOblique": (category: Some("PrepositionPhrase"), features: ["Number", "NounKind"]),
        "TargetedNounPhrase": (category: Some("NounPhrase"), features: ["Number", "NounKind", "Countability"]),
        "BareNominalComplement": (category: Some("Nominal")),
        // A genitive's possessor: a Noun Phrase that ends in its head. An
        // admission gate (`docs/decisions/english-v4.md` §4.5), a
        // register formation rule: English has the phrasal genitive (*the King
        // of England's daughter*; CGEL, Ch. 5 §16.6, p. 479), but Oracle never
        // postmodifies a possessor, and fronts the player noun instead "to
        // avoid a dangling possessive" (`docs/oracle-style-guide.md` §6,
        // Controller and owner). Its Productions restate the Noun Phrase ones
        // over BareNominal, which takes no postmodifier.
        "Possessor": (category: Some("NounPhrase"), features: ["Number", "Person", "Case"]),
        // A single genitive over coordinated nominals (*target artifact or
        // creature's owner*; CGEL, Ch. 15 §3.4, p. 1331).
        "PossessorNominals": (category: Some("Nominal"), features: ["Number", "Countability", "NounKind"]),
        // A direct multiple genitive over nominals (*that creature's or
        // spell's controller*; CGEL, Ch. 15 §3.4, p. 1331), and each genitive.
        "GenitiveNominal": (category: Some("Nominal"), features: ["Number", "Countability", "NounKind"]),
        "GenitiveNominals": (category: Some("Nominal"), features: ["Number", "Countability", "NounKind"]),
        "NumericalDeterminer": (category: Some("DeterminerPhrase"), features: ["Number", "Countability"]),
        // An ordinal's position from an end (*third from the top*), which
        // describes where a card is put, never a nominal.
        "PositionPhrase": (category: Some("AdjectivePhrase")),
        // A determinative that can head a fused Noun Phrase alone (*choose
        // one*, *choose both*), and a coordination of such (*one or more*).
        "FusableDeterminer": (category: Some("DeterminerPhrase"), features: ["Number", "Countability", "NounKind"]),
        "FusedQuantity": (category: Some("DeterminerPhrase"), features: ["Number", "Countability"]),
        // A determinative's Complement has a Number of its own (*all but
        // one*; CGEL, Ch. 5 §7.3, p. 375).
        "DeterminerPhrase": (features: ["Number", "Countability", "DeterminativeDistribution", "NounKind", "ComplementKind", "ObliqueNumber", "ObliqueKind", "ObliqueDetermination", "ObliqueDistribution"]),
        // A determiner ending in the Targeting Marker, without the Number
        // the Marker has on its own, which an outer determiner or an
        // adjective gives it instead (*two target creatures*, *other target
        // creatures*).
        "TargetingMarker": (category: Some("DeterminerPhrase"), features: ["Countability", "DeterminativeDistribution", "NounKind", "ComplementKind", "ObliqueNumber", "ObliqueKind", "ObliqueDetermination"]),
        // A Preposition Phrase's Number and Determination are its Complement's
        // (*up to two*, a determiner; *of them*, a partitive oblique).
        "PrepositionPhrase": (features: ["ComplementKind", "Number", "Determination", "Case", "NounKind", "Countability", "DeterminativeDistribution"], gap: true),
        // An Adjectival Passive is Passive; it is a predicative Complement
        // only, never a depictive Adjunct or a premodifier.
        "AdjectivePhrase": (features: ["Determination", "AdjectivePosition", "Voice", "ComplementKind", "Grade", "Polarity"], gap: true),
        "AdverbPhrase": (features: ["AdjunctPosition"]),
        // The predicative Complement function; its head bears it too.
        "Predicative": (function: true),
        // A depictive Adjunct of unlike categories coordinated (*onto the
        // battlefield tapped and attacking*; CGEL, Ch. 15 §3.2, pp. 1326–1329), and each of
        // its conjuncts, by the kind of phrase that fills it.
        "Depictive": (category: Some("Predicative"), function: true, features: ["ComplementKind"]),
        "DepictiveCoordination": (category: Some("Predicative"), function: true, features: ["ComplementKind"]),
        // A predicate Adjunct of unlike categories coordinated (*only during
        // your turn and only once each turn*), and each of its conjuncts.
        "PredicateAdjunct": (function: true, features: ["ComplementKind"]),
        // A clause fragment of Predicate Adjuncts that *but* or *and* adds to
        // a whole Clause, and the fragment focused by *only* or *not* that
        // qualifies it (*but only during their turn before the end step*;
        // CGEL, Ch. 15 §4.5, pp. 1347–1348).
        // Complement Clusters, sequences of a verb's Complements, each with
        // an optional Adjunct after them, coordinated after the shared verb
        // (*put [one of them into your hand] and [the rest into your
        // graveyard]*; *has [lifelink if you control a Cleric], [deathtouch
        // if you control a Rogue], and [flying if you control a Wizard]*):
        // right nonce-constituent coordination (CGEL, Ch. 15 §4.3,
        // pp. 1341–1343), whose coordination bears no function (p. 1343).
        "ComplementCluster": (),
        "ClusterCoordination": (category: Some("ComplementCluster")),
        // A keyword's parameters without the keyword: a later Cluster's
        // remnant, the keyword elided as the initial Cluster's Object head
        // (*gain protection from white if ..., [from blue] if ...*; CGEL,
        // Ch. 15 §4.3, p. 1343, note 65: *We'll be in Paris for a week and
        // Bonn for three days*, *in* elided).
        "ParameterRemnant": (),
        "ClauseFragment": (),
        "QualifyingFragment": (),
        // Coordinates joined by *but* that contrast as positive and negative,
        // *not* modifying the second (*life equal to the damage dealt, but
        // not more life than ...*; *from your graveyard, but not from
        // anywhere else*; CGEL, Ch. 15 §2.6, p. 1313, [60iia]: *They had
        // invited [Jill but not her husband]*), and each coordinate.
        "ContrastConjunct": (category: Some("NounPhrase"), function: true, features: ["Polarity"]),
        "ContrastCoordination": (category: Some("NounPhrase"), function: true, features: ["Polarity"]),
        "ContrastPrepositionConjunct": (category: Some("PrepositionPhrase"), function: true, features: ["ComplementKind", "Number", "Determination", "Case", "NounKind", "Countability", "DeterminativeDistribution", "Polarity"]),
        "ContrastPrepositionCoordination": (category: Some("PrepositionPhrase"), function: true, features: ["ComplementKind", "Number", "Determination", "Case", "NounKind", "Countability", "DeterminativeDistribution", "Polarity"]),
        // Premodifiers of unlike categories coordinated, with a coordinator or
        // asyndetically (*noncreature, nonland card*; *nonartifact, nonblack
        // creature*), and each premodifier in the chain.
        "Attributes": (function: true, features: ["ComplementKind"]),
        // An Object of unlike categories coordinated (*has base power and
        // toughness 5/5 and vigilance*), and each of its conjuncts.
        "ObjectConjunct": (category: Some("NounPhrase"), function: true, features: ["ComplementKind"]),
        "ObjectCoordination": (category: Some("NounPhrase"), function: true, features: ["ComplementKind"]),
        // Postmodifiers of unlike categories coordinated (*the player with the
        // most life or tied for most life*), and each of them.
        // An Amount and a Noun Phrase coordinated (*equal to [2] or [the
        // greatest power among Dinosaurs you control]*), where a head selects
        // both (CGEL, Ch. 15 §3.1, p. 1323, rule [1]), and each of its
        // conjuncts.
        "AmountOrNounConjunct": (category: Some("NounPhrase"), function: true, features: ["ComplementKind"]),
        "AmountOrNounPhrase": (category: Some("NounPhrase"), function: true, features: ["ComplementKind"]),
        "PostmodifierConjunct": (category: Some("Postmodifier"), function: true, features: ["ComplementKind"]),
        "PostmodifierCoordination": (category: Some("Postmodifier"), function: true, features: ["ComplementKind"]),
        "Attribute": (category: Some("Attributes"), function: true, features: ["ComplementKind", "Polarity"]),
        // An asyndetic chain of premodifiers. An admission gate
        // (`docs/decisions/english-v4.md` §4.5), a register formation
        // rule: Oracle sets off with commas only independent *non-*
        // premodifiers of one head (`docs/oracle-style-guide.md` §6,
        // Determiners and modifier order), so the chain never holds an
        // uncoordinated attribute that is not `Polarity: Negative`.
        "AttributeChain": (category: Some("Attributes"), function: true, features: ["ComplementKind"]),
        "AdjunctCoordination": (category: Some("PredicateAdjunct"), function: true, features: ["ComplementKind"]),
        // An adverbial Complement: an Adverb Phrase or a Noun Phrase of
        // frequency (*more than twice*, *more than three times*).
        "Adverbial": (function: true),
        // The Adjunct function before a selected Complement or shifted Object.
        "Interleaved": (function: true),
        // The Adjunct function before only the Internalised Complement of a
        // passive, a non-core Complement (CGEL, Ch. 4 §3.2.1, p. 241).
        "InternalisedInterleaved": (function: true),
        // A relative clause before the Complement its noun selects, which is
        // postposed past it: post-head order in a Nominal is labile (CGEL,
        // Ch. 5 §15, p. 454 [12]–[13]: *the rumour [which was published in
        // 'The Times'] [that income tax would be cut]*; *Equip abilities
        // [you activate] [of other Equipment]*).
        "InterleavedModifier": (function: true, features: ["Number", "NounKind"]),
        // The Modifier function of an Object, postposed after the selected
        // Complements that follow it (CGEL, Ch. 12 §4, p. 1066), with the
        // Case its Object agrees in.
        "PostposedModifier": (function: true, features: ["Case"]),
        // The Modifier function after a nominal head: a relative clause or a
        // participial clause.
        "Postmodifier": (function: true, features: ["Number", "NounKind"]),
        // A relative phrase with genitive *whose* (CGEL, Ch. 12 §3.2.5, p. 1043).
        "RelativeNounPhrase": (category: Some("NounPhrase"), features: ["Number"]),
        // A preposition and its relative pronoun, fronted (*for which*).
        "RelativePrepositionPhrase": (category: Some("PrepositionPhrase")),
        "KeywordPhrase": (features: ["KeywordForm", "FinalParameter"]),
        "KeywordLineItem": (features: ["KeywordForm", "FinalParameter"]),
        "KeywordParameters": (features: ["KeywordForm", "FinalParameter"]),
        "BoundKeyword": (features: ["KeywordForm", "FinalParameter"]),
        // An Amount's QuantityNumber agrees with a counted noun (*two cards*);
        // as a Noun Phrase it is singular (*X can't be 0*).
        "Amount": (features: ["QuantityNumber", "Sign", "ComplementKind"]),
        "SignedAmount": (),
        "Cost": (),
        "FiniteClause": (category: Some("Clause")),
        "ExpandableClause": (category: Some("Clause")),
        // A content-specifying Supplement set off by a dash as a head's
        // Complement (SetOffComplementClause).
        "SetOffClause": (category: Some("Clause")),
        "VerblessClause": (category: Some("Clause")),
        "AbsoluteClause": (category: Some("Clause")),
        // Subjectless non-finite complements: a to-infinitival is a Clause,
        // a bare infinitival or gerund-participial its Verb Phrase.
        // A non-finite Complement never passes up a predicative Gap (*can't
        // be __*); one is shared only inside it (*can't be and become
        // legendary*).
        "ToInf": (category: Some("Clause"), gap: true, closed_gaps: ["Pred"]),
        // Its object Gap is filled by the Subject of the verb selecting it.
        "HollowInf": (category: Some("Clause")),
        "BareInf": (category: Some("VerbPhrase"), features: ["Number", "Person", "VerbForm", "Voice"], gap: true, closed_gaps: ["Pred"]),
        // An auxiliary's participial Complement (*have been __*).
        "AuxiliaryComplement": (category: Some("VerbPhrase"), function: true, features: ["VerbForm", "Voice", "VerbKind"], gap: true, closed_gaps: ["Pred"]),
        "Gerund": (category: Some("VerbPhrase"), features: ["Number", "Person", "VerbForm", "Voice"], gap: true),
        // A gerund-participial Clause with its Subject, which Oracle uses as
        // a Subject only (CGEL, Ch. 14 §2.1, p. 1188).
        "GerundClause": (category: Some("Clause")),
        "QuotedAbility": (),
        // A word cited rather than used: a metalinguistic Noun Phrase (CGEL,
        // Ch. 5 §8.2, p. 401), as *left or right* in *choose left or right*
        // and *Wall* in *other than Wall*. It fills only a slot a head's
        // frame selects, never an ordinary Noun Phrase's.
        "Mention": (),
        "MentionModifier": (),
        "QuotedCost": (),
        // An interrogative content clause (CGEL, Ch. 11 §5.1, pp. 972–973).
        "InterrogativeClause": (category: Some("Clause")),
        // An interrogative phrase with *which* (*which creatures*).
        "InterrogativePhrase": (category: Some("NounPhrase"), features: ["Number", "Person"]),
    },
    closed_words: {
        "By": "prep:by",
        "Up": "prep:up",
        "Of": "prep:of",
        "Than": "prep:than",
        "From": "prep:from",
        // The locative prepositions of *be* and temporal *after*: an
        // existential's extension (CGEL, Ch. 16 §6.2.1, p. 1394).
        "In": "prep:in",
        "On": "prep:on",
        "Among": "prep:among",
        "Under": "prep:under",
        "Outside": "prep:outside",
        "After": "prep:after",
        "As": "prep:as",
        "DegreeAs": "adv:as",
        "Plus": "prep:plus",
        "Minus": "prep:minus",
        "The": "det:the",
        "Genitive": "clitic:genitive",
        "That": "det:that",
        "ContentMarker": "sub:that",
        "Any": "det:any",
        "Or": "coord:or",
        "And": "coord:and",
        "AndOr": "coord:and/or",
        "Nor": "coord:nor",
        "But": "coord:but",
        "Not": "adv:not",
        "Those": "det:those",
        "Both": "det:both",
        "Either": "det:either",
        "Neither": "det:neither",
        "To": "sub:to",
        "Each": "det:each",
        "All": "det:all.count",
        "Whichever": "det:whichever",
        "Which": "det:which",
        "Whether": "sub:whether",
        // Interrogative *how* (CGEL, Ch. 10 §7, p. 902).
        "How": "adv:how",
        "Target": "det:target",
        "Most": "det:most",
        "No": "det:no",
        "Anywhere": "det:anywhere",
    },
    lexical_classes: {
        "Predeterminer": ["det:all.count", "det:all.mass", "det:both"],
        "DegreeQuantifier": ["det:many", "det:much"],
        "Coordinator": ["coord:and", "coord:or", "coord:and/or", "coord:nor"],
        "Disjunctive": ["coord:or", "coord:and/or", "coord:nor"],
        "Alternative": ["coord:or", "coord:nor"],
        // The coordinators that attach a new element to a whole Clause
        // (CGEL, Ch. 15 §4.5, p. 1347: "*But* is the most common coordinator
        // in this construction; *and* is also possible, but *or* is not").
        "AddingCoordinator": ["coord:and", "coord:but"],
        // The focusing adverbs of a qualifying added element (CGEL, Ch. 15
        // §4.5, p. 1347: "*only* is not omissible, though *not* could take
        // its place").
        "FocusingAdverb": ["adv:only", "adv:not"],
        // *Be* and its contracted and negative forms.
        "BeVerb": ["verb:be", "verb:'re", "verb:aren't"],
        // Perfect *have* and its contracted and negative forms.
        "HaveVerb": ["verb:have", "verb:'ve", "verb:haven't"],
        // Auxiliaries stranded before the ellipsis site of their Complement
        // (CGEL, Ch. 17 §7.1, pp. 1519–1523), by the form of the verb that
        // heads the omitted Complement: a modal's is plain (its
        // `Catenative(BareInf)` frame), perfect *have*'s a past participle
        // (Perfect) and *be*'s a gerund-participle or a past participle
        // (Progressive, Passive). *Do* has its intransitive pro-form frame;
        // a reduced clitic never stands in this stressed position (Ch. 18
        // §6.1, p. 1614).
        "StrandableModal": ["verb:can", "verb:can't", "verb:may", "verb:must", "verb:will"],
        "StrandableHave": ["verb:have", "verb:haven't"],
        "StrandableBe": ["verb:be", "verb:aren't"],
        // Comparative determinatives: they select a *than* Complement (*more
        // than one*; CGEL, Ch. 13 §2.1, p. 1104), and a measure phrase
        // modifies them (*{1} less*).
        "ComparativeQuantifier": ["det:more.count", "det:more.mass", "det:less", "det:fewer"],
        // Determinatives that head a partitive with an *of* oblique in fused
        // determiner-head function (*some of them*, *each of those
        // creatures*; CGEL, Ch. 5 §9.3, pp. 408–410). *Any* and a quantity
        // (*one of them*, *that many of those tokens*) have Productions of
        // their own.
        "PartitiveQuantifier": ["det:all.count", "det:all.mass", "det:another", "det:both", "det:each", "det:either", "det:fewer", "det:less", "det:many", "det:more.count", "det:more.mass", "det:most", "det:much", "det:neither", "det:none", "det:some"],
        // The universal quantifiers that float as a quantificational
        // Adjunct after a plural Subject or an auxiliary (*the girls each
        // enjoyed it*, *we both enjoyed it*, *you will each qualify*; CGEL,
        // Ch. 5 §9.3, p. 413; §10.1.1, p. 428). *All* floats after a
        // personal pronoun only, in FloatedAll.
        "FloatingQuantifier": ["det:each", "det:both"],
        "SuperlativeQuantifier": ["det:most", "det:least", "det:fewest"],
        // The superlative determinative that is no degree word, so that it
        // fuses with its head with the article unexpressed (*tied for
        // fewest*; CGEL, Ch. 13 §6.3.4, pp. 1168-1169). *Most* and *least*
        // also modify an adjective (*most common*), and fused so they would
        // leave it a depictive Adjunct of the clause.
        "CountSuperlativeQuantifier": ["det:fewest"],
        // Determinatives that stand alone as a fused determiner-head (CGEL,
        // Ch. 5 §9.1, p. 410): *both*, *none*, and *another* opposed to *one*
        // (*replacing all instances of one color word with another*; p. 391).
        // *Each* fuses with the head in an implicit partitive, its set
        // recovered from an antecedent (*one or more creatures enter, each
        // enters with ...*; Ch. 5 §9.3, p. 413), as *both* and *either* do;
        // in Oracle only as a Subject (NonNumericComplement,
        // NominalPredicative).
        "FusedQuantifier": ["det:another", "det:both", "det:each", "det:more.count", "det:everything", "det:this", "det:none"],
        // *Either* and *neither* choose from a set in an implicit partitive
        // (*If a player does either*; p. 413, [11ii]: *there wasn't time to
        // watch either (of them)*). Unlike fused *each*, whose set is the
        // antecedent's members acting severally, the Noun Phrase they make is
        // an ordinary singular one, so it is a Complement as well as a Subject.
        "FusedChoice": ["det:either", "det:neither"],
        // Subordinator *that* and the relative pronouns (CGEL, Ch. 12 §3.5).
        "RelativeMarker": ["sub:that", "pronoun:which", "pronoun:who"],
    },
    // `FusedHeadAdjective` has one member, *other*, the one Oracle adjective
    // that heads a Noun Phrase with ordinary determination (*the other*,
    // *each other*; CGEL, Ch. 5 §9.1, p. 410, modifier-head).
    // `DefiniteFusedHeadAdjective` has *same*, whose anaphoric fused NP
    // takes the definite article (Ch. 5 §9.3, p. 416; Ch. 17, p. 1545).
    // `RangeMarker`
    // has one member, `LEVEL`, the marker of a level symbol [CR#711.2a], and
    // `Pawprint` one, `{P}` [CR#107.18]; each is a CR-enumerated symbol read
    // by its header and mode Productions (RangeHeader, SinglePawprint).
    typed_classes: ["CopularVerb", "FusedHeadAdjective", "DefiniteFusedHeadAdjective", "PhrasalAdverb", "MultiplyingAdverb", "BoundingAdverb", "FrontAdverb", "CentralAdverb", "EndAdverb", "LinkingAdverb", "CardType", "Supertype", "Subtype", "ParameterizedKeyword", "AbilityWord", "AnchorWord", "BracedSymbol", "Variable", "RangeMarker", "Pawprint", "SharedHeadCompound"],
    slot_categories: {
        TypeModifier: "TypeModifier",
        NonManaCost: "NonManaCost",
        Quality: "Quality", Name: "Name", Ability: "Ability", Condition: "Condition", Measure: "Measure",
        NP: "ComplementNounPhrase",
        PP: "PrepositionPhrase",
        Pred: "Predicative",
        AdjP: "AdjectivePhrase",
        AdvP: "Adverbial",
        LocativeNP: "LocativeHead",
        MeasureNP: "MeasureNounPhrase",
        KeywordPhrase: "KeywordPhrase",
        Nominal: "BareNominalComplement",
        Amount: "Amount",
        AmountOrNP: "AmountOrNounPhrase",
        // A Cost slot is a mana cost: a keyword's cost after a space or after
        // its amount and em dash (*Equip {2}*, *Suspend 4—{1}{U}*), and a
        // keyword action's (*waterbend {3}*). A verbal or composite keyword
        // cost follows an em dash in the NonManaCost slot and ends in its own
        // period (style guide §3 "Em dashes", "Periods"), so no clause is ever
        // a keyword's Cost (*Equip abilities you activate cost {2} less*).
        Cost: "SymbolCosts",
        FiniteClause: "FiniteClause",
        ExpandableClause: "ExpandableClause",
        SetOffClause: "SetOffClause",
        VerblessClause: "VerblessClause",
        AbsoluteClause: "AbsoluteClause",
        InterrogativeClause: "InterrogativeClause",
        ToInf: "ToInf",
        HollowToInf: "HollowInf",
        BareInf: "BareInf",
        Gerund: "Gerund",
        QuotedAbility: "QuotedAbility",
        Mention: "Mention",
    },
    // A Noun Phrase Complement of a verb, preposition or other head is never
    // nominative.
    slot_equations: {
        NP: [Exclude("slot.Case", "Nominative")],
        // A *with* or *without* phrase with an Absolute Clause is an Adjunct
        // or a Modifier, never a selected Complement (CGEL, Ch. 14 §10(a),
        // p. 1267).
        PP: [Exclude("slot.ComplementKind", "AbsoluteClause")],
    },
    // A distributive adjunct, whose Complement has a Distributive
    // determinative (*for each …*), anchors to the outermost eligible clause,
    // as a comma-set Supplement does (`docs/decisions/english-v4.md` §4.3,
    // AttachmentClass).
    high_attachment: [("PrepositionPhrase", "DeterminativeDistribution", "Distributive")],
    productions: [
        (name: "TextMode", lhs: "Document", rhs: [Cat("head", "Mode")]),
        (name: "TextModalHeader", lhs: "Document", rhs: [Cat("head", "ModalHeader")]),
        (name: "ModalAbility", lhs: "ModalAbility", rhs: [Cat("header", "ModalHeader"), Mark('\n', Bound), Cat("modes", "Modes")]),
        (name: "ModalTextAbility", lhs: "Ability", rhs: [Cat("head", "ModalAbility")]),
        (name: "ModalEffect", lhs: "Effect", rhs: [Cat("head", "ModalAbility")]),
        (name: "ActivatedModalHeader", lhs: "Document", rhs: [Cat("cost", "ActivationCost"), Punct(':'), Cat("head", "ModalHeader")]),
        (name: "ActivationPayment", lhs: "ActivationCost", rhs: [Cat("head", "Cost")]),
        (name: "SingleMode", lhs: "Modes", rhs: [Cat("head", "Mode")]),
        (name: "ModeSequence", lhs: "Modes", rhs: [Cat("first", "Mode"), Mark('\n', Bound), Cat("rest", "Modes")]),
        (name: "AbilityParagraph", lhs: "Paragraphs", rhs: [Cat("head", "Ability")]),
        (name: "HeaderParagraph", lhs: "Paragraphs", rhs: [Cat("head", "Header")]),
        (name: "AbilityParagraphSequence", lhs: "Paragraphs", rhs: [Cat("first", "Ability"), Mark('\n', Bound), Cat("rest", "Paragraphs")]),
        (name: "HeaderParagraphSequence", lhs: "Paragraphs", rhs: [Cat("first", "Header"), Mark('\n', Bound), Cat("rest", "Paragraphs")]),

        (name: "CardTypeModifier", lhs: "TypeModifier", rhs: [Class("head", "CardType")], equations: [Require("head.Number", "Singular")]),
        (name: "SupertypeModifier", lhs: "TypeModifier", rhs: [Class("head", "Supertype")]),
        (name: "NegativeTypeModifier", lhs: "TypeModifier", rhs: [Lex("prefix", Affix), Cat("head", "TypeModifier")]),
        (name: "IndexedCostHeader", lhs: "Header", rhs: [Cat("cost", "Cost"), Punct(':'), Cat("head", "IndexedNominal")], equations: [Require("head.Number", "Singular")]),
        // An em-dash ability runs to the end of its keyword line, so a
        // keyword with one never premodifies a nominal in a sentence (style
        // guide §14 "Keyword abilities"). A keyword that ends in its Cost
        // premodifies only as a Keyword Mention, without that Cost (*a
        // disturb cost*, *the flashback cost*).
        (name: "KeywordPremodifier", lhs: "BareNominal", rhs: [Cat("modifier", "KeywordPhrase"), Cat("head", "BareNominal")], equations: [Exclude("modifier.FinalParameter", "SetOffAbility"), Exclude("modifier.FinalParameter", "Cost")]),
        // Quotation marks around a term that mentions literal wording: a
        // keyword premodifier (*all "bands with other" abilities*) and the
        // singular nominal that names one term (*the "legend rule"*,
        // [CR#704.5j]), written without a period of its own (style guide §3,
        // Quotation marks and apostrophes; CGEL, Ch. 20 §6, pp. 1753–1755).
        // A quoted plural is a granted ability's (*have "bands with other
        // legendary creatures."*), never a term's.
        (name: "QuotedKeywordPremodifier", lhs: "BareNominal", rhs: [Quoted("modifier", "KeywordPhrase"), Cat("head", "BareNominal")], equations: [Exclude("modifier.FinalParameter", "SetOffAbility"), Exclude("modifier.FinalParameter", "Cost")]),
        (name: "QuotedNominal", lhs: "BareNominal", rhs: [Quoted("head", "BareNominal")], equations: [Require("head.Number", "Singular")]),
        // A quoted imperative names the cost it states (*cost an additional
        // "Sacrifice a land" to activate*; [CR#118.8]): the clause is
        // mentioned, not used, as the quoted term of QuotedNominal is (CGEL,
        // Ch. 5 §8.2, p. 401; Ch. 20 §6, p. 1753), and has no period of its
        // own (style guide §3, Quotation marks and apostrophes). It is a
        // singular count noun that a modifier premodifies, never a Conjunct
        // of its own: any other quoted clause is a granted ability's
        // (QuotedAbility).
        (name: "QuotedCost", lhs: "QuotedCost", rhs: [Quoted("head", "Clause")], equations: [Carry("head.VerbForm", "Plain")]),
        (name: "QuotedCostPremodifier", lhs: "BareNominal", rhs: [Cat("modifier", "AdjectivePhrase"), Cat("head", "QuotedCost")],
            equations: [Require("modifier.ComplementKind", "Intransitive"), Exclude("modifier.AdjectivePosition", "Predicative"), Agree("modifier.Determination", "$.Determination"), Require("$.Determination", "Overt"), Require("$.Number", "Singular"), Require("$.Countability", "Count"), Require("$.NounKind", "Ordinary"), Require("$.NounDistribution", "Ordinary")]),

        (name: "TextSymbols", lhs: "Document", rhs: [Cat("head", "Symbols")]),
        // A symbol sequence is also a noun under a determiner (*each {B} in a
        // cost*, *an additional {G}*, *six {E}*, *that much {R}*).
        (name: "SymbolNominal", lhs: "BareNominal", rhs: [Cat("head", "Symbols")], equations: [Require("$.Determination", "Overt"), Require("$.NounKind", "Ordinary"), Require("$.NounDistribution", "Ordinary")]),
        // An Arabic numeral is a singular count noun under a determiner (*a
        // natural 20*; CGEL, Ch. 5 §7.1, p. 386).
        (name: "ArabicNumeralName", lhs: "NumeralName", rhs: [Numeral("head", Arabic(false))]),
        // A numeral named as a noun or a comparative adjective with that
        // numeral its understood standard, as ComparativeBoundedAmount is
        // for an Amount (*whenever you roll a 4 or higher*).
        (name: "ComparativeBoundedNumeralName", lhs: "NumeralName", rhs: [Numeral("first", Arabic(false)), Word("coordinator", "Or"), Cat("last", "AdjectivePhrase")],
            equations: [Require("last.Grade", "Comparative"), Require("last.ComplementKind", "Intransitive")]),
        (name: "NumeralNominal", lhs: "BareNominal", rhs: [Cat("head", "NumeralName")], equations: [Require("$.Determination", "Overt"), Require("$.Number", "Singular"), Require("$.Countability", "Count"), Require("$.NounKind", "Ordinary"), Require("$.NounDistribution", "Ordinary")]),
        (name: "GroupedNumericAmount", lhs: "Amount", rhs: [Numeral("head", Arabic(true))], equations: [Agree("$.QuantityNumber", "head.Number")]),
        // A multiplying or bounding adverb modifies a quantity (*up to
        // twice X target cards*).
        (name: "AdverbModifiedAmount", lhs: "Amount", rhs: [Cat("modifier", "AdverbPhrase"), Cat("head", "Amount")], equations: [Exclude("modifier.AdjunctPosition", "Central"), Exclude("modifier.AdjunctPosition", "End"), Exclude("modifier.AdjunctPosition", "Linking")]),
        (name: "UnsignedMeasureAmount", lhs: "SignedAmount", rhs: [Cat("head", "Amount")], equations: [Exclude("head.Sign", "Negative")]),
        (name: "PositiveMeasureAmount", lhs: "SignedAmount", rhs: [Mark('+', Prefix), Cat("head", "Amount")], equations: []),
        (name: "NegativeMeasureAmount", lhs: "SignedAmount", rhs: [Mark('-', Prefix), Cat("head", "Amount")], equations: []),

        (name: "BoundKeywordItem", lhs: "KeywordParameters", rhs: [Cat("head", "BoundKeyword")]),
        // A comparative bound on a number is no Noun Phrase: predicated, it
        // is the comparative adjective's (*Its power is less than 3*).
        (name: "NumericNounPhrase", lhs: "NounPhrase", rhs: [Cat("head", "Amount")], equations: [Exclude("head.ComplementKind", "PP"), Require("$.NounKind", "Numeric"), Require("$.Number", "Singular"), Require("$.Determination", "Bare"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        // Fused *each*, an implicit partitive, is a Subject only (*each
        // enters with ...*): a Complement is the explicit partitive *each of
        // them* (`docs/oracle-style-guide.md` §6, Target: "Put a +1/+1
        // counter on each of up to two target creatures"), so an *of* phrase
        // after a fused *each* is always its partitive oblique.
        (name: "NonNumericComplement", lhs: "ComplementNounPhrase", rhs: [Cat("head", "NounPhrase")], equations: [Exclude("head.NounKind", "Numeric"), Exclude("head.Case", "Nominative"), Exclude("head.Case", "Genitive"), ExcludeTogether([("head.DeterminativeDistribution", "Distributive"), ("head.NounKind", "Quantity")])], transparent: ["head"]),
        (name: "NumeralNominalPhrase", lhs: "FusedNounPhrase", rhs: [Cat("head", "ChoiceQuantity")], equations: [Require("$.NounKind", "Quantity"), Require("$.Determination", "Bare"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        (name: "CardinalChoice", lhs: "ChoiceQuantity", rhs: [Numeral("head", Cardinal)]),
        // Plural demonstrative *those* as a fused determiner-head,
        // interpreted anaphorically or with a relative clause that sets its
        // set (*except those that share a creature type with ...*; CGEL,
        // Ch. 5 §9.2, p. 414, [14i]: *Those who break the rules*; "*Those* is
        // used in the same way" as fused-head *these*).
        (name: "FusedDemonstrative", lhs: "FusedNounPhrase", rhs: [Word("head", "Those")], equations: [Require("$.NounKind", "Ordinary"), Require("$.Determination", "Overt"), Require("$.Number", "Plural"), Require("$.Countability", "Count"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        (name: "FusedQuantifierNominalPhrase", lhs: "NounPhrase", rhs: [Class("head", "FusedQuantifier")], equations: [Require("$.NounKind", "Quantity"), Require("$.Determination", "Bare"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        (name: "FusedChoiceNominalPhrase", lhs: "FusedNounPhrase", rhs: [Class("head", "FusedChoice")], equations: [Require("$.NounKind", "Ordinary"), Require("$.Determination", "Overt"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        (name: "CardinalDeterminer", lhs: "NumericalDeterminer", rhs: [Numeral("head", Cardinal)], equations: [Require("$.Countability", "Count")]),
        (name: "VariableDeterminer", lhs: "NumericalDeterminer", rhs: [Class("head", "Variable")], equations: [Require("$.Countability", "Count")]),
        (name: "ArabicDeterminer", lhs: "NumericalDeterminer", rhs: [Numeral("head", Arabic(false))], equations: [Require("$.Countability", "Count")]),
        (name: "GroupedArabicDeterminer", lhs: "NumericalDeterminer", rhs: [Numeral("head", Arabic(true))], equations: [Require("$.Countability", "Count")]),
        (name: "NegativeAdjective", lhs: "AdjectivePhrase", rhs: [Lex("prefix", Affix), Cat("head", "AdjectivePhrase")], equations: [Require("$.Polarity", "Negative")]),
        // A modal header labelled by an ability word, as a unit of its own.
        (name: "LabelledModalHeader", lhs: "Document", rhs: [Class("label", "AbilityWord"), Mark('—', Free), Cat("head", "ModalHeader")]),
        // The same with a flavor word, which the card's own text introduces
        // (*Trick Arrows — Whenever ..., choose one —*); as FlavorLabelledAbility,
        // its dash belongs to the word.
        (name: "FlavorLabelledModalHeader", lhs: "Document", rhs: [Lex("label", FlavorWord), Cat("head", "ModalHeader")]),
        (name: "ChapterModalHeader", lhs: "Document", rhs: [Cat("chapters", "Chapters"), Mark('—', Free), Cat("head", "ModalHeader")]),

        (name: "CompleteKeywordPhrase", lhs: "KeywordPhrase", rhs: [Cat("head", "KeywordParameters")]),
        (name: "CompleteKeywordItem", lhs: "KeywordLineItem", rhs: [Cat("head", "KeywordParameters")]),
        (name: "BareKeywordMention", lhs: "KeywordPhrase", rhs: [Class("head", "ParameterizedKeyword")]),
        // A granted ability quoted whole (*has "{T}: Add {G}."*; [CR#113.1a]):
        // the text of an Ability set in quotation marks, with its final
        // period inside the closing mark (style guide §3, Periods; Quotation
        // marks and apostrophes; §12, Granting and removing abilities; CGEL,
        // Ch. 20 §6, pp. 1753–1755).
        (name: "QuotedAbility", lhs: "QuotedAbility", rhs: [Quoted("head", "Ability")]),
        (name: "TextAbility", lhs: "Document", rhs: [Cat("head", "Ability")]),
        (name: "TextTypeLine", lhs: "Document", rhs: [Cat("head", "TypeLine")]),
        (name: "TextHeader", lhs: "Document", rhs: [Cat("head", "Header")]),
        (name: "HeaderSequence", lhs: "Document", rhs: [Cat("first", "Header"), Mark('\n', Bound), Cat("rest", "Paragraphs")]),
        (name: "TextSequence", lhs: "Document", rhs: [Cat("first", "Ability"), Mark('\n', Bound), Cat("rest", "Paragraphs")]),
        (name: "SentenceAbility", lhs: "Ability", rhs: [Cat("head", "Sentences")]),
        (name: "KeywordAbilityList", lhs: "Ability", rhs: [Cat("head", "KeywordList")]),
        (name: "SingleKeyword", lhs: "KeywordList", rhs: [Cat("head", "KeywordLineItem")]),
        (name: "CommaKeywords", lhs: "KeywordList", rhs: [Cat("first", "KeywordLineItem"), Punct(','), Cat("rest", "KeywordList")]),
        (name: "TypesOnly", lhs: "TypeLine", rhs: [Cat("head", "CardTypes")]),
        (name: "TypesWithSubtypes", lhs: "TypeLine", rhs: [Cat("head", "CardTypes"), Mark('—', Free), Cat("subtypes", "Subtypes")]),
        (name: "SupertypePrefix", lhs: "TypeLine", rhs: [Class("modifier", "Supertype"), Cat("head", "TypeLine")]),
        (name: "SingleCardType", lhs: "CardTypes", rhs: [Class("head", "CardType")], equations: [Require("head.Number", "Singular")]),
        (name: "MultipleCardTypes", lhs: "CardTypes", rhs: [Class("first", "CardType"), Cat("rest", "CardTypes")], equations: [Require("first.Number", "Singular")]),
        (name: "SingleSubtype", lhs: "Subtypes", rhs: [Class("head", "Subtype")], equations: [Require("head.Number", "Singular")]),
        (name: "MultipleSubtypes", lhs: "Subtypes", rhs: [Class("first", "Subtype"), Cat("rest", "Subtypes")], equations: [Require("first.Number", "Singular")]),
        (name: "NumericAmount", lhs: "Amount", rhs: [Numeral("head", Arabic(false))], equations: [Agree("$.QuantityNumber", "head.Number")]),
        (name: "VariableAmount", lhs: "Amount", rhs: [Class("head", "Variable")], equations: [Agree("$.QuantityNumber", "head.Number")]),
        (name: "SingleSymbol", lhs: "Symbols", rhs: [Class("head", "BracedSymbol")]),
        (name: "SymbolSequence", lhs: "Symbols", rhs: [Class("first", "BracedSymbol"), Attached("rest", "Symbols", Suffix)]),
        (name: "SymbolCost", lhs: "Cost", rhs: [Cat("head", "SymbolCosts")]),
        (name: "SingleSymbolCost", lhs: "SymbolCosts", rhs: [Cat("head", "Symbols")]),
        (name: "CostSequence", lhs: "SymbolCosts", rhs: [Cat("first", "Symbols"), Punct(','), Cat("rest", "SymbolCosts")]),
        (name: "NegativeLoyaltySymbolCost", lhs: "ActivationCost", rhs: [Mark('−', Prefix), Cat("amount", "Amount")], equations: []),
        (name: "PositiveLoyaltySymbolCost", lhs: "ActivationCost", rhs: [Mark('+', Prefix), Cat("amount", "Amount")], equations: []),
        (name: "ZeroLoyaltySymbolCost", lhs: "ActivationCost", rhs: [Cat("amount", "Amount")], equations: []),
        (name: "LoyaltySymbol", lhs: "LoyaltySymbol", rhs: [Mark('[', Prefix), Cat("amount", "Amount"), Punct(']')]),
        (name: "UnicodeNegativeLoyaltySymbol", lhs: "LoyaltySymbol", rhs: [Mark('[', Prefix), Mark('−', Bound), Cat("amount", "Amount"), Punct(']')]),
        (name: "PositiveLoyaltySymbol", lhs: "LoyaltySymbol", rhs: [Mark('[', Prefix), Mark('+', Bound), Cat("amount", "Amount"), Punct(']')]),
        (name: "LoyaltyCost", lhs: "ActivationCost", rhs: [Cat("head", "LoyaltySymbol")]),
        (name: "LoyaltyNominal", lhs: "BareNominal", rhs: [Cat("head", "LoyaltySymbol")], equations: [Require("$.Determination", "Overt"), Require("$.Number", "Singular"), Require("$.Countability", "Count"), Require("$.NounKind", "Ordinary"), Require("$.NounDistribution", "Ordinary")]),
        (name: "VerbalCost", lhs: "NonManaCost", rhs: [Cat("head", "VerbPhrase")], equations: [Require("head.VerbForm", "Plain")]),
        (name: "CompositeNonManaCost", lhs: "NonManaCost", rhs: [Cat("first", "Symbols"), Punct(','), Cat("rest", "NonManaCost")]),
        (name: "NonManaCost", lhs: "Cost", rhs: [Cat("head", "NonManaCost")]),
        (name: "ActivatedAbility", lhs: "Ability", rhs: [Cat("cost", "ActivationCost"), Punct(':'), Cat("effect", "Effect")]),
        (name: "LabelledAbility", lhs: "Ability", rhs: [Class("label", "AbilityWord"), Mark('—', Free), Cat("head", "Ability")]),
        // An ability headed by an Anchor Word, on its own paragraph after the
        // ability that offers the choice [CR#607.2m]: *• Khans — ...*. The
        // bullet belongs to this construction: each such ability is "marked
        // with an anchor word and preceded by a bullet point" [CR#614.12c].
        // It is an ability, never a mode: no instruction to choose a number
        // of options precedes it [CR#700.2] (style guide "Anchor words": "The
        // bulleted abilities are not modes").
        (name: "AnchoredAbility", lhs: "Ability", rhs: [Mark('•', Free), Class("label", "AnchorWord"), Mark('—', Free), Cat("head", "Ability")]),
        (name: "FlavorLabelledAbility", lhs: "Ability", rhs: [Lex("label", FlavorWord), Cat("head", "Ability")]),
        (name: "NominalMode", lhs: "Mode", rhs: [Mark('•', Free), Cat("head", "Nominal"), Punct('.')], equations: []),
        (name: "NounPhraseMode", lhs: "Mode", rhs: [Mark('•', Free), Cat("head", "NounPhrase"), Punct('.')]),
        // A keyword whose em-dash cost ends in its own period, then that
        // keyword's associated instruction (style guide §3 "Periods": *Equip—
        // Sacrifice another nonland permanent. Activate only once each turn.*).
        // No other keyword form is followed by a sentence on its line (§8
        // "Keyword abilities on a shared line").
        (name: "KeywordFollowedBySentences", lhs: "Ability", rhs: [Cat("first", "KeywordLineItem"), Cat("rest", "Sentences")], equations: [Carry("first.FinalParameter", "SetOffCost")]),
        (name: "NamePremodifier", lhs: "BareNominal", rhs: [Cat("modifier", "Name"), Cat("head", "BareNominal")]),
        (name: "ModeBullet", lhs: "Mode", rhs: [Mark('•', Free), Cat("head", "Ability")]),
        (name: "PlusCostedMode", lhs: "Mode", rhs: [Mark('+', Free), Cat("cost", "Cost"), Mark('—', Free), Cat("head", "ModeEffect")]),
        (name: "LabelledCostedMode", lhs: "Mode", rhs: [Mark('•', Free), Lex("label", FlavorWord), Cat("cost", "Cost"), Mark('—', Free), Cat("head", "ModeEffect")]),
        (name: "PawprintMode", lhs: "Mode", rhs: [Cat("quantity", "Pawprints"), Mark('—', Free), Cat("head", "ModeEffect")]),
        (name: "SinglePawprint", lhs: "Pawprints", rhs: [Class("head", "Pawprint")]),
        (name: "PawprintSequence", lhs: "Pawprints", rhs: [Class("first", "Pawprint"), Attached("rest", "Pawprints", Suffix)]),
        (name: "SingleSentence", lhs: "Sentences", rhs: [Cat("head", "Sentence")]),
        (name: "SentenceSequence", lhs: "Sentences", rhs: [Cat("first", "Sentence"), Cat("rest", "Sentences")]),
        (name: "SentenceEffect", lhs: "Effect", rhs: [Cat("head", "Sentences")]),
        (name: "ModeInstruction", lhs: "ModeEffect", rhs: [Cat("head", "Effect")]),
        (name: "ModeMeasure", lhs: "ModeEffect", rhs: [Cat("head", "Measure"), Punct('.')]),
        // A singular nominal that is not already a bare Noun Phrase (a count
        // noun's: *legendary creature*); mass nominals are Qualities through
        // their Noun Phrase.
        (name: "SingularNominalQuality", lhs: "Quality", rhs: [Cat("head", "Nominal")], equations: [Require("head.Number", "Singular"), Carry("head.Countability", "Count"), Exclude("head.NounDistribution", "HeadOnly")]),
        (name: "NominalPhraseQuality", lhs: "Quality", rhs: [Cat("head", "NounPhrase")]),
        // An adjective is a Quality only as a fused head (*protection from
        // multicolored*). A fused head is the marked construction: where a
        // noun heads the same Quality, as a colour word's conversion does
        // (*protection from red*; CGEL, Ch. 19 §3.3, p. 1642; Ch. 5 §9.3,
        // p. 417), the adjective ranks behind it.
        (name: "AdjectivalQuality", lhs: "Quality", rhs: [Cat("head", "AdjectivePhrase")], cost: 1),
        // Another card's full name costs one more than the face's own name,
        // so the face's own Shortened Name [CR#201.5c] ranks first where the
        // two are spelled alike (*Nicol Bolas* on Nicol Bolas, the Ravager).
        // Both stay Readings: full names are in scope everywhere
        // (english-lexical-analysis.md §1).
        (name: "NamedParameter", lhs: "Name", rhs: [Lex("head", Catalog)], scoped: ["head"]),
        (name: "SlashMeasure", lhs: "Measure", rhs: [Cat("first", "SignedAmount"), Mark('/', Bound), Cat("second", "SignedAmount")]),
        (name: "MeasureHeader", lhs: "Header", rhs: [Cat("head", "Measure")]),
        (name: "RangeHeader", lhs: "Header", rhs: [Class("marker", "RangeMarker"), Cat("lower", "Amount"), Mark('-', Bound), Cat("upper", "Amount")], equations: []),
        (name: "OpenRangeHeader", lhs: "Header", rhs: [Class("marker", "RangeMarker"), Cat("lower", "Amount"), Punct('+')], equations: []),
        (name: "SingleChapter", lhs: "Chapters", rhs: [Numeral("head", Roman)]),
        (name: "ChapterSequence", lhs: "Chapters", rhs: [Numeral("first", Roman), Punct(','), Cat("rest", "Chapters")]),
        (name: "ChapterAbility", lhs: "Ability", rhs: [Cat("chapters", "Chapters"), Mark('—', Free), Cat("head", "Ability")]),
        // An imperative or declarative Clause, with any preposed adjunct
        // (*When this creature enters, choose one —*).
        (name: "ChoiceHeader", lhs: "ModalHeader", rhs: [Cat("head", "Clause"), Mark('—', Free)], equations: [Exclude("head.Inflection", "Irrealis")]),
        // A reflexive trigger [CR#603.12] begins a new sentence after the
        // instruction it depends on, and a modal header can be one (*You may pay
        // {E}{E}. When you do, choose one —*; `docs/oracle-style-guide.md`
        // §8, Delayed and reflexive triggers; §10, Modal choices). Right
        // recursion gives a sentence sequence one grouping, as
        // SentenceSequence does.
        (name: "SentencePrefixedModalHeader", lhs: "ModalHeader", rhs: [Cat("first", "Sentence"), Cat("head", "ModalHeader")]),

        // Sentences: a bare imperative or a declarative clause.
        // An adverb before a bare imperative is its Clause's front Adjunct,
        // never a central one of its Verb Phrase (CentralPosition).
        (name: "Imperative", lhs: "Clause", rhs: [Cat("head", "VerbPhrase")], uncoordinated: ["head"],
            equations: [Require("head.VerbForm", "Plain"), Require("$.ClauseMarking", "Unmarked"), Exclude("head.CentralPosition", "Occupied")]),
        (name: "Declarative", lhs: "Sentence", rhs: [Cat("clause", "Clause"), Punct('.')], equations: [Require("clause.ClauseMarking", "Unmarked"), Exclude("clause.Inflection", "Irrealis")]),
        // Restated as RelativeSubjectPredicate (a SubjectInitialClause, for
        // bare relatives); a change to one must be made to the other.
        (name: "SubjectPredicate", lhs: "Clause",
            rhs: [Cat("subject", "NounPhrase"), Free("head", "VerbPhrase")],
            equations: [
                Agree("subject.Number", "head.Number"),
                Agree("subject.Person", "head.Person"),
                Require("head.VerbForm", "Finite"),
                Exclude("subject.Case", "Accusative"),
                Exclude("subject.Case", "Genitive"),
                Require("$.ClauseMarking", "Unmarked"),
            ],
            transparent: ["head"]),
        // A specifying copular clause names the value of the variable its
        // Subject's head noun denotes: *type* has cited names as values (*the
        // new creature type can't be Wall*; CGEL, Ch. 4 §5.5, pp. 266-269),
        // so only a Subject headed by such a noun takes a subtype name as
        // the value, never a Noun Phrase after any copular verb.
        (name: "SpecifyingClause", lhs: "Clause", rhs: [Cat("subject", "NounPhrase"), Class("head", "BeVerb"), Class("value", "Subtype")],
            equations: [
                Carry("subject.Variable", "Cited"),
                Require("value.Number", "Singular"),
                Agree("subject.Number", "head.Number"),
                Agree("subject.Person", "head.Person"),
                Require("head.VerbForm", "Finite"),
                Exclude("subject.Case", "Accusative"),
                Exclude("subject.Case", "Genitive"),
                Require("$.ClauseMarking", "Unmarked"),
            ]),
        (name: "SpecifyingModalClause", lhs: "Clause", rhs: [Cat("subject", "NounPhrase"), Class("head", "StrandableModal"), Class("be", "BeVerb"), Class("value", "Subtype")],
            equations: [
                Carry("subject.Variable", "Cited"),
                Require("value.Number", "Singular"),
                Require("head.VerbForm", "Finite"),
                Require("be.VerbForm", "Plain"),
                Agree("subject.Number", "head.Number"),
                Agree("subject.Person", "head.Person"),
                Exclude("subject.Case", "Accusative"),
                Exclude("subject.Case", "Genitive"),
                Require("$.ClauseMarking", "Unmarked"),
            ]),
        // A bound auxiliary clitic (*'s*, *'re*, *'ve*, *'m*) has a
        // nominative pronoun host (*it's*, *you're*, *they've*).
        // Restated as RelativeCliticSubjectPredicate; a change to one must be
        // made to the other.
        (name: "CliticSubjectPredicate", lhs: "Clause",
            rhs: [Cat("subject", "NounPhrase"), Attached("head", "VerbPhrase", Suffix)],
            equations: [
                Agree("subject.Number", "head.Number"),
                Agree("subject.Person", "head.Person"),
                Require("head.VerbForm", "Finite"),
                Require("subject.Case", "Nominative"),
                Require("$.ClauseMarking", "Unmarked"),
            ],
            transparent: ["head"]),

        // A gerund-participial Clause as Subject (*turning a face-down permanent
        // face up causes ...*; CGEL, Ch. 14 §7.1(c), p. 1254).
        (name: "GerundSubject", lhs: "Clause", rhs: [Cat("subject", "Gerund"), Cat("head", "VerbPhrase")],
            equations: [Require("head.VerbForm", "Finite"), Require("head.Number", "Singular"), Require("head.Person", "Third"), Require("$.ClauseMarking", "Unmarked")],
            transparent: ["head"]),

        // A gerund-participial clause with its Subject (*a creature you
        // control attacking causes ...*; CGEL, Ch. 14 §2.1, p. 1188).
        (name: "SubjectGerund", lhs: "GerundClause", rhs: [Cat("subject", "NounPhrase"), Cat("head", "VerbPhrase")],
            equations: [Require("head.VerbForm", "GerundParticiple"), Exclude("subject.Case", "Nominative"), Exclude("subject.Case", "Genitive")], cost: 2),
        (name: "GerundClauseSubject", lhs: "Clause", rhs: [Cat("subject", "GerundClause"), Cat("head", "VerbPhrase")],
            equations: [Require("head.VerbForm", "Finite"), Require("head.Number", "Singular"), Require("head.Person", "Third"), Require("$.ClauseMarking", "Unmarked")],
            transparent: ["head"]),

        // An existential clause: dummy *there*, the copula agreeing with the
        // displaced subject, and an optional locative or temporal extension,
        // a Complement of *be* as in its non-existential counterpart (CGEL,
        // Ch. 16 §6.2.1, p. 1394: *There's one copy on the table*, *One copy
        // is on the table*). A Preposition Phrase it could head right after the
        // displaced subject is that Complement, never an Adjunct nor the
        // displaced subject's postmodifier, so a PP Adjunct follows only a
        // complemented predicate.
        (name: "Existential", lhs: "Clause", rhs: [Cat("subject", "DummyPronoun"), Cat("head", "ExistentialPredicate")],
            equations: [Agree("subject.Number", "head.Number"), Agree("subject.Person", "head.Person"),
                Require("head.VerbForm", "Finite"), Require("$.ClauseMarking", "Unmarked")]),
        (name: "ExistentialThere", lhs: "DummyPronoun", rhs: [Lex("head", Pronoun)],
            equations: [Require("head.PronounKind", "Existential")]),
        (name: "ExistentialBe", lhs: "ExistentialPredicate", rhs: [Class("head", "BeVerb"), Cat("displaced_subject", "NounPhrase")],
            equations: [Agree("$.Number", "displaced_subject.Number"), Exclude("displaced_subject.Case", "Accusative"), Require("$.ComplementKind", "NP")], unextended: ["displaced_subject"]),
        (name: "LocatedExistentialBe", lhs: "ExistentialPredicate", rhs: [Class("head", "BeVerb"), Cat("displaced_subject", "NounPhrase"), Selected("complement", "PrepositionPhrase", ["In", "On", "Among", "Under", "Outside", "After"])],
            equations: [Agree("$.Number", "displaced_subject.Number"), Exclude("displaced_subject.Case", "Accusative"), Require("$.ComplementKind", "PP")], unextended: ["displaced_subject"]),
        // Before an *and*-coordination of Noun Phrases, existential *be* may
        // agree by proximity with a singular first conjunct (*There was a
        // bottle of wine and several glasses on the table*; CGEL, Ch. 4
        // §3.2.2, p. 242, n. 21), as well as with the plural coordination.
        (name: "ProximateExistentialBe", lhs: "ExistentialPredicate", rhs: [Class("head", "BeVerb"), Cat("displaced_subject", "NounPhrase")],
            equations: [Require("$.Number", "Singular"), Require("displaced_subject.Number", "Plural"), Carry("displaced_subject.FirstConjunctNumber", "Singular"), Exclude("displaced_subject.Case", "Accusative"), Require("$.ComplementKind", "NP")], unextended: ["displaced_subject"]),
        (name: "LocatedProximateExistentialBe", lhs: "ExistentialPredicate", rhs: [Class("head", "BeVerb"), Cat("displaced_subject", "NounPhrase"), Selected("complement", "PrepositionPhrase", ["In", "On", "Among", "Under", "Outside", "After"])],
            equations: [Require("$.Number", "Singular"), Require("displaced_subject.Number", "Plural"), Carry("displaced_subject.FirstConjunctNumber", "Singular"), Exclude("displaced_subject.Case", "Accusative"), Require("$.ComplementKind", "PP")], unextended: ["displaced_subject"]),

        (name: "EndAdverb", lhs: "AdverbPhrase", rhs: [Class("head", "EndAdverb")],
            equations: [Require("$.AdjunctPosition", "End")]),
        (name: "CentralAdverb", lhs: "AdverbPhrase", rhs: [Class("head", "CentralAdverb")],
            equations: [Require("$.AdjunctPosition", "Central")]),
        (name: "FrontAdverb", lhs: "AdverbPhrase", rhs: [Class("head", "FrontAdverb")],
            equations: [Require("$.AdjunctPosition", "Front")]),
        (name: "LinkingAdverb", lhs: "AdverbPhrase", rhs: [Class("head", "LinkingAdverb")],
            equations: [Require("$.AdjunctPosition", "Linking")]),
        // A Linked Conjunct: its linking connective is its Adjunct, never a
        // Coordinator, whether it is the sole link (*Draw a card, then
        // discard a card*) or follows one (*and then discard a card*, a front
        // Adjunct). It may scope over a coordination by a Coordinator (*then
        // [shuffle and put that card on top]*; CGEL, Ch. 15 §2.10, pp.
        // 1319–1320; `docs/oracle-style-guide.md` §3, Commas and the serial
        // comma; §10, Sequence).
        (name: "LinkedClause", lhs: "LinkedClause", rhs: [Cat("adjunct", "AdverbPhrase"), Cat("head", "Clause")],
            equations: [Require("adjunct.AdjunctPosition", "Linking")], transparent: ["head"]),
        (name: "LinkedVerbPhrase", lhs: "LinkedVerbPhrase", rhs: [Cat("adjunct", "AdverbPhrase"), Cat("head", "VerbPhrase")],
            equations: [Require("adjunct.AdjunctPosition", "Linking")], transparent: ["head"]),
        // A front adverbial set off by a comma (*Once each turn, ...*).
        (name: "FrontAdverbial", lhs: "Clause", rhs: [Cat("adjunct", "AdverbPhrase"), Punct(','), Cat("head", "Clause")],
            equations: [Require("adjunct.AdjunctPosition", "Front"), Require("$.FrontPosition", "Occupied")], transparent: ["head"], cost: 2),
        // A comma-set passive participial Supplement (*there is an additional
        // combat phase after this phase, followed by an additional main
        // phase*; CGEL, Ch. 14 §9.1, p. 1265; Ch. 15 §5.1, p. 1350). It
        // supplements one conjunct, never a whole coordination (*X is …,
        // rounded down, and Y is …, rounded up*). Like the engine's comma-set
        // post-adjuncts, it is outside any relative clause (CGEL, Ch. 12 §4,
        // p. 1058), so its head Clause passes up no Gap.
        (name: "ParticipialSupplement", lhs: "Clause", rhs: [Cat("head", "Clause"), Punct(','), Cat("supplement", "VerbPhrase")],
            equations: [Require("supplement.VerbForm", "PastParticiple"), Require("supplement.Voice", "Passive")], uncoordinated: ["head"], heavy: ["supplement"], cost: 3),
        // A gerund-participial Supplement likewise, its missing Subject
        // controlled by the anchor clause's (*Restart the game, leaving in
        // exile all non-Aura permanent cards exiled with Karn*; CGEL, Ch. 14
        // §9, pp. 1265–1266).
        (name: "GerundParticipialSupplement", lhs: "Clause", rhs: [Cat("head", "Clause"), Punct(','), Cat("supplement", "VerbPhrase")],
            equations: [Require("supplement.VerbForm", "GerundParticiple")], uncoordinated: ["head"], heavy: ["supplement"], cost: 3),
        // A trailing NP Supplement is outside the integrated Clause: its
        // anchor remains an Object or another constituent, rather than
        // becoming a larger NP with the description (CGEL, Ch. 15 §§5.1,
        // 5.2(b), pp. 1350–1351, 1357–1358). Oracle uses this for a named
        // token's description (OSG §12, Tokens). The Supplement is a full
        // Noun Phrase, retaining its own postmodifiers.
        (name: "NounPhraseSupplement", lhs: "Clause", rhs: [Cat("head", "Clause"), Punct(','), Cat("supplement", "NounPhrase")]),
        // End-attachment coordination by addition of a new element, in its
        // qualifying use: *but* or *and* adds to the whole main Clause before
        // it a clause fragment that weakens it, focused by *only* or *not*,
        // which is not omissible there (*Any player may activate this
        // ability but only during their turn*; *Only your opponents may
        // activate this ability and only as a sorcery*; CGEL, Ch. 15 §4.5,
        // pp. 1346–1347, [33iii]: *I'll drive you there, but only if you pay
        // for the petrol*; *but not if you criticise my driving*). The
        // fragment is of Adjuncts the Clause's predicate could take
        // (p. 1347). As a main Clause's, it ends its Sentence; Oracle sets it
        // off with no comma. It is a new element: a Clause ending in a
        // Predicate Adjunct of a kind the fragment could coordinate with has
        // the fragment as that Adjunct's coordinate, a basic coordination
        // (§4.5, p. 1346, [29]; *Activate [only as a sorcery and only once
        // each turn]*; `docs/oracle-style-guide.md` §8, Activation
        // instructions).
        (name: "AddedElement", lhs: "Sentence", rhs: [Cat("clause", "Clause"), Class("coordinator", "AddingCoordinator"), Cat("fragment", "QualifyingFragment"), Punct('.')],
            equations: [Require("clause.ClauseMarking", "Unmarked"), Exclude("clause.Inflection", "Irrealis")],
            unadjoined: [("clause", ["PrepositionPhrase", "AdjectivePhrase", "TemporalNounPhrase", "AdverbPhrase", "AdjunctCoordination"])], cost: 2),
        // A non-initial coordinate may open, after its coordinator, with a
        // fronted Adjunct delimited on both sides (*except it's legendary
        // ... and, if it's a creature, it enters with ...*): heavy
        // punctuation marks the Adjunct's left boundary after the
        // coordinator, where light punctuation leaves it unmarked (CGEL,
        // Ch. 20 §3.2.5, p. 1745, note 13; *But if that's not convenient,
        // ...*).
        (name: "DelimitedFrontConjunct", lhs: "Clause", rhs: [Cat("first", "Clause"), Class("coordinator", "Coordinator"), Punct(','), Cat("last", "Clause")],
            equations: [Require("last.FrontPosition", "Occupied"), Agree("$.VerbForm", "first.VerbForm"), Agree("$.VerbForm", "last.VerbForm"), Agree("$.ClauseMarking", "first.ClauseMarking"), Agree("$.ClauseMarking", "last.ClauseMarking"), Agree("$.FrontPosition", "first.FrontPosition")], cost: 2),
        (name: "QualifyingFragment", lhs: "QualifyingFragment", rhs: [Class("modifier", "FocusingAdverb"), Cat("head", "ClauseFragment")], cost: 0),
        (name: "AdjunctFragment", lhs: "ClauseFragment", rhs: [Cat("head", "PredicateAdjunct")], cost: 0),
        (name: "ExtendedFragment", lhs: "ClauseFragment", rhs: [Cat("head", "ClauseFragment"), Cat("adjunct", "PredicateAdjunct")], cost: 1),
        // A temporal Noun Phrase after a final Adverb Phrase is a second
        // Adjunct of the Verb Phrase (TemporalAdjunct: *[[activate only
        // once] each turn]*), never also the adverb's interval
        // (FrequencyInterval), which it is where no Verb Phrase follows
        // (*Once each turn, ...*): the two sites differ in no meaning (CGEL,
        // Ch. 8 §9, p. 715: *each year is probably a separate adjunct rather
        // than a postmodifier*).
        (name: "EndAdverbial", lhs: "VerbPhrase", rhs: [Cat("head", "VerbPhrase"), Cat("adjunct", "AdverbPhrase")],
            equations: [Require("adjunct.AdjunctPosition", "End")], transparent: ["head"], unadjoined: [("adjunct", ["TemporalNounPhrase"])]),
        (name: "CentralAdverbial", lhs: "VerbPhrase", rhs: [Cat("adjunct", "AdverbPhrase"), Cat("head", "VerbPhrase")],
            equations: [Require("adjunct.AdjunctPosition", "Central"), Require("$.CentralPosition", "Occupied")], transparent: ["head"]),

        // Auxiliaries take a verb phrase complement through which a Gap passes.
        (name: "AuxiliaryParticiple", lhs: "AuxiliaryComplement", rhs: [Cat("head", "VerbPhrase")], transparent: ["head"]),
        // A finite auxiliary stranded before the ellipsis site of its
        // Complement heads its Verb Phrase alone (CGEL, Ch. 17 §7.1,
        // p. 1519: *If you can't, ...*, *each opponent who can't*). Only a
        // coordinator, punctuation or the head it is a dependent of follows
        // the site: a dependent right after it would be the Complement, and
        // Oracle retains no dependent in the reduced Verb Phrase (p. 1520).
        // Nor does a head or coordinator whose lexical head is spelled like
        // a verb in the omitted Complement's form: it would be that
        // Complement (*less than this creature's power can't [block it]*,
        // *cards that weren't [cast this way]*), while *each opponent who
        // can't [discards a card]* keeps its ellipsis.
        (name: "StrandedModal", lhs: "VerbPhrase", rhs: [Class("head", "StrandableModal")],
            equations: [Require("head.VerbForm", "Finite"), Require("$.Voice", "Active")], elliptical: Some([Plain])),
        (name: "StrandedPerfect", lhs: "VerbPhrase", rhs: [Class("head", "StrandableHave")],
            equations: [Require("head.VerbForm", "Finite"), Require("$.Voice", "Active")], elliptical: Some([PastParticiple])),
        (name: "StrandedBe", lhs: "VerbPhrase", rhs: [Class("head", "StrandableBe")],
            equations: [Require("head.VerbForm", "Finite"), Require("$.Voice", "Active")], elliptical: Some([GerundParticiple, PastParticiple])),
        (name: "Progressive", lhs: "VerbPhrase", rhs: [Class("head", "BeVerb"), Cat("complement", "AuxiliaryComplement")],
            equations: [Require("complement.VerbForm", "GerundParticiple"), Agree("$.Voice", "complement.Voice")],
            transparent: ["complement"]),
        // The perfect takes an active participle phrase or a passive one
        // headed by *been*.
        (name: "Perfect", lhs: "VerbPhrase", rhs: [Class("head", "HaveVerb"), Cat("complement", "AuxiliaryComplement")],
            equations: [Require("complement.VerbForm", "PastParticiple"), Carry("complement.Voice", "Active"),
                Require("$.Voice", "Active")],
            transparent: ["complement"]),
        (name: "PassivePerfect", lhs: "VerbPhrase", rhs: [Class("head", "HaveVerb"), Cat("complement", "AuxiliaryComplement")],
            equations: [Require("complement.VerbForm", "PastParticiple"), Require("complement.Voice", "Passive"),
                Carry("complement.VerbKind", "Auxiliary"), Require("$.Voice", "Passive")],
            transparent: ["complement"]),
        // The passive auxiliary takes a lexical verb's passive participle phrase.
        (name: "Passive", lhs: "VerbPhrase", rhs: [Class("head", "BeVerb"), Cat("complement", "AuxiliaryComplement")],
            equations: [Require("complement.VerbForm", "PastParticiple"), Require("complement.Voice", "Passive"),
                Exclude("complement.VerbKind", "Auxiliary"), Require("$.Voice", "Passive")],
            transparent: ["complement"]),

        // Non-finite complements.
        (name: "ToInfinitival", lhs: "Clause", rhs: [Word("marker", "To"), Cat("head", "VerbPhrase")],
            equations: [Require("head.VerbForm", "Plain"), Require("$.ClauseMarking", "To")], transparent: ["head"]),
        (name: "ModifiedInfinitival", lhs: "Clause", rhs: [Cat("adjunct", "AdverbPhrase"), Cat("head", "Clause")],
            equations: [Require("adjunct.AdjunctPosition", "Phrasal"), Require("head.ClauseMarking", "To")], transparent: ["head"]),
        (name: "InfinitivalComplement", lhs: "ToInf", rhs: [Cat("head", "Clause")],
            equations: [Require("head.ClauseMarking", "To")], transparent: ["head"]),
        (name: "BareInfinitival", lhs: "BareInf", rhs: [Cat("head", "VerbPhrase")],
            equations: [Require("head.VerbForm", "Plain")], transparent: ["head"]),
        (name: "GerundParticipial", lhs: "Gerund", rhs: [Cat("head", "VerbPhrase")],
            equations: [Require("head.VerbForm", "GerundParticiple")], transparent: ["head"]),
        // A hollow *to*-infinitival (*this spell costs {1} to cast*; CGEL,
        // Ch. 14 §6.3(c), p. 1250).
        (name: "HollowInfinitival", lhs: "HollowInf", rhs: [Word("marker", "To"), Cat("head", "VerbPhrase")],
            equations: [Require("head.VerbForm", "Plain"), Require("head.Gap", "NP")]),
        // A purpose adjunct whose object Gap a relative clause binds (*the
        // first spell that mana from a Treasure was spent to cast*).
        (name: "GappedPurpose", lhs: "VerbPhrase", rhs: [Cat("head", "VerbPhrase"), Cat("adjunct", "ToInf")],
            equations: [Require("adjunct.Gap", "NP")], transparent: ["adjunct"]),
        // A central adverb before a copular verb's predicative Complement
        // (*is no longer snow*, *become no longer suspected*).
        (name: "PostCopularAdverbial", lhs: "VerbPhrase", rhs: [Class("head", "CopularVerb"), Cat("adjunct", "AdverbPhrase"), Cat("predicative_complement", "Predicative")],
            equations: [Require("adjunct.AdjunctPosition", "Central")]),

        (name: "MeasurePremodifier", lhs: "BareNominal", rhs: [Cat("modifier", "Measure"), Cat("head", "BareNominal")]),
        // *its {1}{G} kicker*.
        // *five {P} worth of modes*.
        (name: "PawprintPremodifier", lhs: "BareNominal", rhs: [Cat("modifier", "Pawprints"), Cat("head", "BareNominal")]),
        (name: "SymbolPremodifier", lhs: "BareNominal", rhs: [Cat("modifier", "Symbols"), Cat("head", "BareNominal")]),
        // A slash measure is a noun only under a determiner (*an additional
        // +2/+2*, *a 3/3*); bare, it is a selected Measure Noun Phrase.
        // It is a fused first base (*a 3/3* [creature]), and so never a
        // non-final Conjunct of a Nominal Coordination: before a coordinated
        // Compound Noun it is a Word-Part Coordination's base (*a +2/+0,
        // +1/+1, or +0/+2 counter*), one tree per analysis
        // (`english-lexical-analysis.md` §2).
        (name: "MeasureNominal", lhs: "BareNominal", rhs: [Cat("head", "Measure")], equations: [Require("$.CompoundPart", "Base"), Require("$.Determination", "Overt"), Require("$.Number", "Singular"), Require("$.Countability", "Count"), Require("$.NounKind", "Ordinary"), Require("$.NounDistribution", "Ordinary")]),
        (name: "MeasureNounPhrase", lhs: "MeasureNounPhrase", rhs: [Cat("head", "Measure")]),
        // A Word-Part Coordination of Compound Nouns: the first bases of the
        // earlier ones are coordinated with the last whole, which supplies
        // their shared head word (CGEL, Ch. 15 §3.1(g), p. 1325: *Sydney- or
        // Melbourne-based companies*). A counter's first base is its name
        // [CR#122.1]: a keyword for a keyword counter, a slash measure for a
        // +X/+Y counter [CR#122.1a,122.1b] (`docs/oracle-style-guide.md`
        // §12, Counters: "A keyword counter takes the lowercased keyword as
        // its modifier"). `SharedHeadCompound` holds the Compound Nouns whose
        // first base names their kind: the counters.
        (name: "WordPartCoordination", lhs: "BareNominal", rhs: [Cat("head", "CompoundCoordination")]),
        (name: "KeywordBase", lhs: "CompoundConjunct", rhs: [Cat("modifier", "KeywordPhrase")],
            equations: [Require("$.CompoundPart", "Base"), Exclude("modifier.FinalParameter", "SetOffAbility"), Exclude("modifier.FinalParameter", "Cost")]),
        (name: "MeasureBase", lhs: "CompoundConjunct", rhs: [Cat("modifier", "Measure")], equations: [Require("$.CompoundPart", "Base")]),
        (name: "WholeCompound", lhs: "CompoundConjunct", rhs: [Class("head", "SharedHeadCompound")], equations: [Require("$.CompoundPart", "Whole")]),
        // A multiplied measure (*gets twice -X/-X*).
        (name: "AdverbModifiedMeasure", lhs: "MeasureNounPhrase", rhs: [Cat("modifier", "AdverbPhrase"), Cat("head", "MeasureNounPhrase")], equations: [Require("modifier.AdjunctPosition", "Phrasal")]),
        (name: "AdverbMultipliedMeasure", lhs: "MeasureNounPhrase", rhs: [Cat("modifier", "AdverbPhrase"), Cat("head", "MeasureNounPhrase")], equations: [Require("modifier.AdjunctPosition", "Multiplying")]),
        // A creature's size as a predicative Complement (*except it's 4/3*,
        // *base power and toughness become 4/2*).
        (name: "MeasurePredicative", lhs: "Predicative", rhs: [Cat("head", "MeasureNounPhrase")]),
        // A bare ordinal is attributive (*the second spell*).
        (name: "OrdinalAdjective", lhs: "AdjectivePhrase", rhs: [Numeral("head", Ordinal)], equations: [Require("$.AdjectivePosition", "Attributive"), Require("$.Determination", "Overt")]),
        // An ordinal's position from an end (*third from the top*).
        (name: "OrdinalFromEnd", lhs: "PositionPhrase", rhs: [Numeral("head", Ordinal), Selected("complement", "PrepositionPhrase", ["From"])], equations: []),
        (name: "PositionDepictive", lhs: "VerbPhrase", rhs: [Cat("head", "VerbPhrase"), Cat("adjunct", "PositionPhrase")], transparent: ["head"], cost: 2),
        (name: "PositionAdjunct", lhs: "PredicateAdjunct", rhs: [Cat("filler", "PositionPhrase")], equations: [Require("$.ComplementKind", "AdjP")]),
        (name: "InterleavedRelative", lhs: "InterleavedModifier", rhs: [Cat("head", "RelativeClause")], cost: 0),
        (name: "InterleavedPreposition", lhs: "Interleaved", rhs: [Cat("head", "PrepositionPhrase")], cost: 0),
        (name: "InterleavedTemporal", lhs: "Interleaved", rhs: [Cat("head", "TemporalNounPhrase")], cost: 0),
        // A manner Noun Phrase, as MannerAdjunct, before the Internalised
        // Complement (*weren't chosen this way by any player*), never before a
        // core Complement: Oracle sets *this way* right after the verb it
        // restricts (`docs/oracle-style-guide.md` §5, This way, that much, and
        // linked events: *cards exiled this way*), never between an Object
        // and a goal.
        (name: "InterleavedManner", lhs: "InternalisedInterleaved", rhs: [Cat("head", "NounPhrase")], equations: [Carry("head.NounKind", "Manner")], cost: 0),
        // An end adverb before a later selected Complement (*divided evenly
        // among*, *dealt to you so far this turn by artifacts*), or a
        // comma-set passive participial Supplement there (*divided evenly,
        // rounded down, among*; *deals half X damage, rounded down, to any
        // target*).
        (name: "InterleavedAdverb", lhs: "Interleaved", rhs: [Cat("head", "AdverbPhrase")], equations: [Require("head.AdjunctPosition", "End")], cost: 0),
        (name: "InterleavedSupplement", lhs: "Interleaved", rhs: [Punct(','), Cat("supplement", "VerbPhrase"), Punct(',')],
            equations: [Require("supplement.VerbForm", "PastParticiple"), Require("supplement.Voice", "Passive")], heavy: ["supplement"], cost: 3),
        (name: "InterleavedDepictive", lhs: "Interleaved", rhs: [Cat("head", "AdjectivePhrase")], equations: [Require("head.ComplementKind", "Intransitive"), Exclude("head.Voice", "Passive"), Exclude("head.AdjectivePosition", "Attributive")], cost: 0),
        // Coordinated depictives interleave too (*onto the battlefield tapped
        // and attacking and the rest on the bottom*).
        (name: "InterleavedCoordinatedDepictive", lhs: "Interleaved", rhs: [Cat("head", "DepictiveCoordination")], cost: 0),
        (name: "AdjectivalDepictive", lhs: "Depictive", rhs: [Cat("filler", "AdjectivePhrase")], equations: [Exclude("filler.Voice", "Passive"), Exclude("filler.AdjectivePosition", "Attributive"), Require("$.ComplementKind", "AdjP")]),
        (name: "GerundDepictive", lhs: "Depictive", rhs: [Cat("filler", "Gerund")], equations: [Require("$.ComplementKind", "Gerund")]),
        // Unlike categories coordinated as a predicative Complement too
        // (*a token that's tapped and attacking*).
        (name: "CoordinatedPredicative", lhs: "Predicative", rhs: [Cat("head", "DepictiveCoordination")]),
        (name: "CoordinatedDepictive", lhs: "VerbPhrase", rhs: [Cat("head", "VerbPhrase"), Cat("adjunct", "DepictiveCoordination")], equations: [Exclude("head.VerbKind", "Auxiliary")], transparent: ["head"], cost: 2),
        (name: "PrepositionalAdjunct", lhs: "PredicateAdjunct", rhs: [Hosted("filler", "PrepositionPhrase", Predicate)], equations: [Require("$.ComplementKind", "PP")]),
        (name: "DepictiveAdjunct", lhs: "PredicateAdjunct", rhs: [Cat("filler", "AdjectivePhrase")], equations: [Exclude("filler.Voice", "Passive"), Exclude("filler.Grade", "Comparative"), Exclude("filler.AdjectivePosition", "Attributive"), Require("$.ComplementKind", "AdjP")]),
        // A temporal Noun Phrase Adjunct as an unlike conjunct (*flip a coin
        // [that many times] or [until you lose a flip]*; CGEL, Ch. 15 §3.2,
        // pp. 1326–1329).
        // A trailing Preposition Phrase Adjunct of a coordination of
        // clauses, which scopes over every conjunct, beside the site in its
        // last one (*[put a counter on target creature, and that creature
        // gains flying] until end of turn*; CGEL, Ch. 15 §1.3.4,
        // pp. 1285–1286). A chain of bare imperatives shares one here too
        // (*[untap target creature and gain control of it] until end of
        // turn*), never as its Verb Phrase coordination's: the Imperative
        // heads no coordination, nor one a post-verbal Adjunct follows
        // (`english-lexical-analysis.md` §2).
        (name: "CoordinatedClauseAdjunct", lhs: "Clause", rhs: [Cat("head", "Clause"), Hosted("adjunct", "PrepositionPhrase", Predicate)], coordinated: ["head"], cost: 1),
        (name: "TemporalNounAdjunct", lhs: "PredicateAdjunct", rhs: [Cat("filler", "TemporalNounPhrase")], equations: [Require("$.ComplementKind", "NP")]),
        (name: "AdverbialAdjunct", lhs: "PredicateAdjunct", rhs: [Cat("filler", "AdverbPhrase")], equations: [Require("filler.AdjunctPosition", "End"), Require("$.ComplementKind", "AdvP")]),
        (name: "CoordinatedAdjunct", lhs: "VerbPhrase", rhs: [Cat("head", "VerbPhrase"), Cat("adjunct", "AdjunctCoordination")], transparent: ["head"], cost: 2),
        (name: "DepictiveAdjective", lhs: "VerbPhrase", rhs: [Cat("head", "VerbPhrase"), Cat("adjunct", "AdjectivePhrase")], equations: [Exclude("adjunct.Voice", "Passive"), Exclude("adjunct.Grade", "Comparative"), Exclude("adjunct.AdjectivePosition", "Attributive")], transparent: ["head"], cost: 2),

        (name: "PhrasalAdverb", lhs: "AdverbPhrase", rhs: [Class("head", "PhrasalAdverb")], equations: [Require("$.AdjunctPosition", "Phrasal")]),
        (name: "MultiplyingAdverb", lhs: "AdverbPhrase", rhs: [Class("head", "MultiplyingAdverb")], equations: [Require("$.AdjunctPosition", "Multiplying")]),
        (name: "BoundingAdverb", lhs: "AdverbPhrase", rhs: [Class("head", "BoundingAdverb")], equations: [Require("$.AdjunctPosition", "Bounding")]),
        (name: "DegreeDeterminer", lhs: "DeterminerPhrase", rhs: [Word("modifier", "That"), Class("head", "DegreeQuantifier")], equations: [Require("$.ComplementKind", "Intransitive")]),
        // Scalar equality: *as much / as many* (CGEL, Ch. 13 §§4.1.2,
        // 4.3, pp. 1126, 1130). The secondary term may be implicit (§1.2,
        // p. 1102). DegreePartitive supplies its partitive oblique; the
        // existing NP multipliers can modify the resulting phrase (§4.4.1,
        // p. 1131; Ch. 5 §12(c), p. 434). Degree *as* modifies the
        // determinative, never an arbitrary Noun Phrase.
        (name: "EquativeDeterminer", lhs: "DeterminerPhrase", rhs: [Word("modifier", "DegreeAs"), Class("head", "DegreeQuantifier")], equations: [Require("$.ComplementKind", "Intransitive")]),
        // A modified degree determinative as a fused head (*that many*, *the
        // most*); a coordination fuses only as a FusedQuantity, whose conjuncts
        // can each head alone. Like a fused cardinal, it is a count quantity
        // (*tied for the most*), never a fused *that much*.
        (name: "FusedDegreeDeterminer", lhs: "FusedNounPhrase", rhs: [Cat("head", "DeterminerPhrase")], uncoordinated: ["head"], equations: [Require("head.ComplementKind", "Intransitive"), Require("head.DeterminativeDistribution", "Dependent"), Agree("$.Countability", "head.Countability"), Require("$.Countability", "Count"), Require("$.NounKind", "Quantity"), Require("$.Determination", "Bare"), Require("$.Case", "Plain"), Require("$.Person", "Third")], heavy: ["head"]),
        // A coordination of fusable determinatives as a fused head (*choose
        // one or more*, *if X is 5 or more*).
        // A spelled cardinal is a quantity (*one or more*); an Arabic numeral
        // or variable names a number, so it is Numeric (*X is 5 or more*).
        (name: "FusableCardinal", lhs: "FusableDeterminer", rhs: [Cat("head", "ChoiceQuantity")], equations: [Require("$.Countability", "Count"), Require("$.NounKind", "Quantity")]),
        (name: "FusableAmount", lhs: "FusableDeterminer", rhs: [Cat("head", "Amount")], equations: [Agree("$.Number", "head.QuantityNumber"), Require("$.Countability", "Count"), Require("$.NounKind", "Numeric")]),
        (name: "FusableQuantifier", lhs: "FusableDeterminer", rhs: [Class("head", "FusedQuantifier")]),
        (name: "FusableChoice", lhs: "FusableDeterminer", rhs: [Class("head", "FusedChoice")]),
        (name: "FusedQuantityCoordination", lhs: "FusedNounPhrase", rhs: [Cat("head", "FusedQuantity")], equations: [Require("$.NounKind", "Quantity"), Require("$.Determination", "Bare"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        // A focusing or multiplying adverb modifies a Noun Phrase (*only one
        // target*, *twice X life*); a bounding one, its quantity (*at least
        // one creature*).
        // A focusing modifier precedes a determined NP (*exactly those
        // colors*; CGEL, Ch. 6 §7.3.1, p. 587). With numerical determination
        // the existing AdverbModifiedDeterminerPhrase hosts it instead.
        (name: "BoundingNounPhrase", lhs: "NounPhrase", rhs: [Cat("modifier", "AdverbPhrase"), Cat("determiner", "DeterminerPhrase"), Cat("head", "Nominal")],
            equations: [Require("modifier.AdjunctPosition", "Bounding"), Exclude("determiner.DeterminativeDistribution", "Numerical"), Exclude("determiner.DeterminativeDistribution", "Independent"), Exclude("determiner.DeterminativeDistribution", "FreeChoice"), Exclude("determiner.ComplementKind", "PP"), Agree("$.DeterminativeDistribution", "determiner.DeterminativeDistribution"), Agree("determiner.Countability", "head.Countability"), Agree("determiner.Number", "head.Number"), Require("$.Determination", "Overt"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        (name: "AdverbModifiedNounPhrase", lhs: "NounPhrase", rhs: [Cat("modifier", "AdverbPhrase"), Cat("head", "NounPhrase")], equations: [Require("modifier.AdjunctPosition", "Phrasal")]),
        (name: "AdverbMultipliedNounPhrase", lhs: "NounPhrase", rhs: [Cat("modifier", "AdverbPhrase"), Cat("head", "NounPhrase")], equations: [Require("modifier.AdjunctPosition", "Multiplying")]),
        // *Both* floats after a plural Object, ahead of the Complement that
        // follows it (*put two cards from your hand both on top of your
        // library*; CGEL, Ch. 5 §9.2(c), p. 413 and §10.1.1, pp. 427–428,
        // which describe it after a Subject or auxiliary and, after a
        // pronoun Object, as part of the pronoun: *invited us both*). A
        // Subject keeps FloatedEach.
        (name: "FloatedObjectBoth", lhs: "ComplementNounPhrase", rhs: [Cat("head", "NounPhrase"), Word("adjunct", "Both")], equations: [Require("head.Number", "Plural"), Exclude("head.NounKind", "Numeric"), Exclude("head.Case", "Nominative"), Exclude("head.Case", "Genitive")], uncoordinated: ["head"]),
        (name: "AdverbModifiedPrepositionPhrase", lhs: "PrepositionPhrase", rhs: [Cat("modifier", "AdverbPhrase"), Cat("head", "PrepositionPhrase")], equations: [Require("modifier.AdjunctPosition", "Phrasal")]),
        (name: "AdverbModifiedDeterminerPhrase", lhs: "DeterminerPhrase", rhs: [Cat("modifier", "AdverbPhrase"), Cat("head", "DeterminerPhrase")], equations: [Require("modifier.AdjunctPosition", "Bounding"), Require("head.DeterminativeDistribution", "Numerical")]),
        // A focused predicative adjective (*attack only alone*).
        (name: "AdverbModifiedAdjectivePhrase", lhs: "AdjectivePhrase", rhs: [Cat("modifier", "AdverbPhrase"), Cat("head", "AdjectivePhrase")], equations: [Require("modifier.AdjunctPosition", "Phrasal"), Require("$.AdjectivePosition", "Predicative")]),
        // A phrasal adverb modifies a single adverb, inside any frequency
        // interval (*[so far] this turn*, *[only once] each turn*).
        (name: "AdverbModifiedAdverbPhrase", lhs: "AdverbPhrase", rhs: [Cat("modifier", "AdverbPhrase"), Cat("head", "AdverbPhrase")], equations: [Require("modifier.AdjunctPosition", "Phrasal")], light: ["head"]),
        (name: "PredeterminerCount", lhs: "NounPhrase", rhs: [Class("determiner", "Predeterminer"), Cat("head", "NounPhrase")], equations: [Require("head.Determination", "Overt"), Require("head.Number", "Plural"), Agree("determiner.Number", "head.Number"), Agree("determiner.Countability", "head.Countability")]),
        (name: "PredeterminerMass", lhs: "NounPhrase", rhs: [Class("determiner", "Predeterminer"), Cat("head", "NounPhrase")], equations: [Require("head.Determination", "Overt"), Require("head.Countability", "Mass"), Require("head.Number", "Singular"), Agree("determiner.Number", "head.Number"), Agree("determiner.Countability", "head.Countability")]),
        // *All* before a fused cardinal, the head of its Noun Phrase unexpressed
        // (*if you've done all four*; CGEL, Ch. 5 §12, p. 434: before a cardinal
        // *all* is the determiner and the numeral an internal modifier, which
        // fuses with the omitted head, §9.3(a), pp. 415-416): it counts the
        // members of a set, as *all of them* does.
        (name: "AllFusedCardinal", lhs: "NounPhrase", rhs: [Word("determiner", "All"), Cat("head", "ChoiceQuantity")],
            equations: [Require("head.Number", "Plural"), Require("$.Number", "Plural"), Require("$.Countability", "Count"), Require("$.NounKind", "Ordinary"), Require("$.Determination", "Overt"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        (name: "SingularQuantifier", lhs: "DeterminerPhrase", rhs: [Word("head", "Any"), Numeral("modifier", Cardinal)], equations: [Require("modifier.Number", "Singular"), Require("$.Number", "Singular"), Require("$.ComplementKind", "Intransitive")]),
        // A temporal Noun Phrase Adjunct: a period noun with a deictic or
        // distributive determinative (*this turn*, *each combat*), never with
        // an article or genitive (*the turn*), and without postmodifiers;
        // serial *time* with any determinative (*any time*, *an additional
        // time*, *three times*); or a temporal nominal bounded by a relative
        // clause (*the next time you cast a spell*; CGEL, Ch. 8 §6.3, p. 698).
        (name: "TemporalLocation", lhs: "TemporalNounPhrase", rhs: [Cat("determiner", "DeterminerPhrase"), Cat("head", "BareNominal")],
            equations: [Require("head.NounKind", "Temporal"), Exclude("head.NounDistribution", "Serial"), Exclude("determiner.DeterminativeDistribution", "Dependent"), Exclude("determiner.DeterminativeDistribution", "Numerical"), Exclude("determiner.DeterminativeDistribution", "IndefiniteArticle"), Agree("determiner.Countability", "head.Countability"), Agree("determiner.Number", "head.Number"), Require("$.Determination", "Overt"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        (name: "SerialTemporal", lhs: "TemporalNounPhrase", rhs: [Cat("determiner", "DeterminerPhrase"), Cat("head", "BareNominal")],
            equations: [Require("head.NounDistribution", "Serial"), Agree("determiner.Countability", "head.Countability"), Agree("determiner.Number", "head.Number"), Require("$.Determination", "Overt"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        // A comparative quantity of serial *times* with its *than* Complement
        // after the head, as in ComparativeCountDetermined, is a frequency
        // Adjunct (CGEL, Ch. 13 §2.1, p. 1104; Ch. 8 §9, p. 715), with or
        // without a determinative modifying the comparative (*Activate no
        // more times each turn than the number of snow Swamps you control*;
        // Ch. 13 §4.4, p. 1126).
        (name: "ComparativeFrequency", lhs: "TemporalNounPhrase", rhs: [Class("determiner", "ComparativeQuantifier"), Cat("head", "Nominal"), Selected("complement", "PrepositionPhrase", ["Than"])],
            equations: [Require("head.NounDistribution", "Serial"), Require("head.Number", "Plural"), Agree("determiner.Number", "head.Number"), Agree("determiner.Countability", "head.Countability"), Require("$.Determination", "Overt"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        (name: "ModifiedComparativeFrequency", lhs: "TemporalNounPhrase", rhs: [Lex("modifier", Determinative), Class("determiner", "ComparativeQuantifier"), Cat("head", "Nominal"), Selected("complement", "PrepositionPhrase", ["Than"])],
            equations: [Require("head.NounDistribution", "Serial"), Require("head.Number", "Plural"), Agree("determiner.Number", "head.Number"), Agree("determiner.Countability", "head.Countability"), Require("$.Determination", "Overt"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        // An equative quantity of serial *times* with its *as* Complement
        // after the head, as the comparative's *than* one is (*as many times
        // as you choose*; CGEL, Ch. 13 §1.3, pp. 1103–1104 and §2, p. 1106),
        // a frequency Adjunct (Ch. 8 §9, p. 715).
        (name: "EquativeFrequency", lhs: "TemporalNounPhrase", rhs: [Word("modifier", "DegreeAs"), Class("determiner", "DegreeQuantifier"), Cat("head", "Nominal"), Selected("complement", "PrepositionPhrase", ["As"])],
            equations: [Require("complement.ComplementKind", "FiniteClause"), Require("head.NounDistribution", "Serial"), Require("head.Number", "Plural"), Agree("determiner.Number", "head.Number"), Agree("determiner.Countability", "head.Countability"), Require("$.Determination", "Overt"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        // A maximum quantity of serial *times* (*pay {G} up to three times*),
        // the Preposition Phrase in Determiner function, as in
        // MaximumDetermination (CGEL, Ch. 5 §7.1, p. 357; Ch. 8 §9, p. 715).
        (name: "MaximumSerialTemporal", lhs: "TemporalNounPhrase", rhs: [Selected("determiner", "PrepositionPhrase", ["Up"]), Cat("head", "BareNominal")],
            equations: [Require("head.NounDistribution", "Serial"), Require("determiner.Determination", "Bare"), Agree("determiner.Number", "head.Number"), Require("$.Determination", "Overt"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        // A focused temporal adjunct (*only any time they could cast a sorcery*).
        (name: "AdverbModifiedTemporal", lhs: "TemporalNounPhrase", rhs: [Cat("modifier", "AdverbPhrase"), Cat("head", "TemporalNounPhrase")], equations: [Require("modifier.AdjunctPosition", "Phrasal")]),
        (name: "RelativeTemporalLocation", lhs: "TemporalNounPhrase", rhs: [Cat("determiner", "DeterminerPhrase"), Cat("head", "RelativeTemporalNominal")],
            equations: [Agree("determiner.Countability", "head.Countability"), Agree("determiner.Number", "head.Number"), Require("$.Determination", "Overt"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        (name: "RelativeTime", lhs: "RelativeTemporalNominal", rhs: [Cat("head", "Nominal"), Cat("modifier", "RelativeClause")],
            equations: [Require("head.NounKind", "Temporal"), Agree("head.Number", "modifier.Number"), Agree("head.NounKind", "modifier.NounKind")]),
        (name: "RelativeTimePostmodifier", lhs: "RelativeTemporalNominal", rhs: [Cat("head", "RelativeTemporalNominal"), Cat("modifier", "TemporalNounPhrase")], cost: 2),
        // A preposed frequency adverb and its interval, set off by a comma
        // (*Twice this turn, ...*; CGEL, Ch. 8 §9, p. 715), as the fronted
        // *Once each turn, ...* is (FrequencyInterval). *Twice* is no Front
        // adverb, which would admit *Twice that many counters are put ...*
        // without the comma.
        (name: "PreposedFrequency", lhs: "Clause", rhs: [Cat("adverb", "AdverbPhrase"), Cat("adjunct", "TemporalNounPhrase"), Punct(','), Cat("head", "Clause")], equations: [Require("adverb.AdjunctPosition", "Multiplying"), Require("$.FrontPosition", "Occupied")], transparent: ["head"]),
        // A preposed temporal Noun Phrase (*This turn, ...*; *The next time ..., ...*).
        (name: "PreposedTemporalAdjunct", lhs: "Clause", rhs: [Cat("adjunct", "TemporalNounPhrase"), Punct(','), Cat("head", "Clause")], equations: [Require("$.FrontPosition", "Occupied")], transparent: ["head"]),
        // A preposed Preposition Phrase and temporal Noun Phrase set off by
        // one comma (*For one spell this turn, ...*). The Preposition Phrase
        // has a Noun Phrase Complement: a Clause Complement runs to the comma
        // and keeps the temporal inside it (*When you next cast a spell this
        // turn, ...*; oracle-style-guide checklist item 4; [CR#603.1]). A
        // temporal that can belong inside the Preposition Phrase, as a
        // trigger's or header's bound (*At the beginning of each combat this
        // turn, ...*; oracle-style-guide §8, Triggered abilities;
        // [CR#603.1,603.7]) or a relative clause's (*For each creature that
        // entered this turn, ...*), ranks first there: the second of two
        // preposed dependents violates an Attachment Class
        // (`docs/decisions/english-v4.md` §4.3).
        (name: "PreposedPrepositionAndTemporal", lhs: "Clause", rhs: [Hosted("adjunct", "PrepositionPhrase", Predicate), Cat("adjunct", "TemporalNounPhrase"), Punct(','), Cat("head", "Clause")], equations: [Require("adjunct.ComplementKind", "NP"), Require("$.FrontPosition", "Occupied")], transparent: ["head"], cost: 2),
        // Two preposed Preposition Phrases set off by one comma, a delayed
        // trigger's timing and its duration (*At the beginning of each of
        // your upkeeps for the rest of the game, ...*; oracle-style-guide §8,
        // Delayed and reflexive triggers, and §11, Continuous and bounded
        // durations; [CR#603.7]). Both have a Noun Phrase Complement: a
        // Clause Complement keeps what follows it inside it (*If tapped for
        // mana, ...*; *As many times as you choose, ...*). A phrase that can
        // belong inside the first ranks first there, as in the fixed phrase
        // *at the beginning of combat on your turn* (oracle-style-guide §11,
        // Turn-structure names): the second of two preposed dependents
        // violates an Attachment Class (`docs/decisions/english-v4.md` §4.3).
        (name: "PreposedPrepositionPair", lhs: "Clause", rhs: [Hosted("adjunct", "PrepositionPhrase", Predicate), Hosted("adjunct", "PrepositionPhrase", Predicate), Punct(','), Cat("head", "Clause")], equations: [Require("adjunct.ComplementKind", "NP"), Require("$.FrontPosition", "Occupied")], transparent: ["head"], cost: 2),
        // *the first time each turn*: a temporal Noun Phrase modifies a
        // temporal nominal.
        (name: "TemporalPostmodifier", lhs: "Nominal", rhs: [Cat("head", "Nominal"), Cat("modifier", "TemporalNounPhrase")],
            equations: [Require("head.NounKind", "Temporal")], cost: 2),
        (name: "TemporalAdjunct", lhs: "VerbPhrase", rhs: [Cat("head", "VerbPhrase"), Cat("adjunct", "TemporalNounPhrase")], transparent: ["head"], cost: 2),
        (name: "MannerAdjunct", lhs: "VerbPhrase", rhs: [Cat("head", "VerbPhrase"), Cat("adjunct", "NounPhrase")], equations: [Carry("adjunct.NounKind", "Manner")], transparent: ["head"], cost: 2),
        (name: "FrequencyInterval", lhs: "AdverbPhrase", rhs: [Cat("head", "AdverbPhrase"), Cat("adjunct", "TemporalNounPhrase")], equations: [Exclude("head.AdjunctPosition", "Central"), Exclude("head.AdjunctPosition", "Phrasal"), Exclude("head.AdjunctPosition", "Multiplying"), Exclude("head.AdjunctPosition", "Linking")]),
        (name: "NumericCountPremodifier", lhs: "QuantifiedNominal", rhs: [Cat("modifier", "Amount"), Cat("head", "BareNominal")], equations: [Agree("$.QuantityNumber", "head.Number"), Require("head.Countability", "Count"), Agree("modifier.QuantityNumber", "head.Number")]),
        (name: "NumericMassPremodifier", lhs: "QuantifiedNominal", rhs: [Cat("modifier", "Amount"), Cat("head", "BareNominal")], equations: [Agree("$.QuantityNumber", "head.Number"), Require("head.Countability", "Mass"), Require("head.NounDistribution", "DirectMeasure")]),
        (name: "CardinalCountPremodifier", lhs: "QuantifiedNominal", rhs: [Numeral("modifier", Cardinal), Cat("head", "BareNominal")], equations: [Agree("$.QuantityNumber", "head.Number"), Require("head.Countability", "Count"), Agree("modifier.Number", "head.Number")]),
        (name: "CardinalMassPremodifier", lhs: "QuantifiedNominal", rhs: [Numeral("modifier", Cardinal), Cat("head", "BareNominal")], equations: [Agree("$.QuantityNumber", "head.Number"), Require("head.Countability", "Mass"), Require("head.NounDistribution", "DirectMeasure")]),
        (name: "ModifiedQuantity", lhs: "ModifiedQuantifiedNominal", rhs: [Cat("modifier", "AdjectivePhrase"), Cat("head", "QuantifiedNominal")], equations: []),
        (name: "DeterminedQuantity", lhs: "NounPhrase", rhs: [Cat("determiner", "DeterminerPhrase"), Cat("head", "QuantifiedNominal")], equations: [Agree("determiner.Number", "head.QuantityNumber"), Agree("$.Number", "head.QuantityNumber"), Require("determiner.Countability", "Count"), Require("$.Countability", "Count"), Require("$.Case", "Plain"), Require("$.Person", "Third"), Require("$.Determination", "Overt")]),
        (name: "SingularOrQuantifiedDetermination", lhs: "NounPhrase", rhs: [Cat("determiner", "DeterminerPhrase"), Cat("head", "QuantifiedNominal")], equations: [Require("determiner.DeterminativeDistribution", "SingularOrQuantified"), Agree("$.Number", "head.QuantityNumber"), Require("determiner.Countability", "Count"), Require("$.Countability", "Count"), Require("$.Case", "Plain"), Require("$.Person", "Third"), Require("$.Determination", "Overt")]),
        (name: "DistributiveQuantity", lhs: "NounPhrase", rhs: [Cat("determiner", "DeterminerPhrase"), Cat("head", "QuantifiedNominal")], equations: [Agree("$.DeterminativeDistribution", "determiner.DeterminativeDistribution"), Require("determiner.DeterminativeDistribution", "Distributive"), Agree("$.Number", "determiner.Number"), Require("determiner.Countability", "Count"), Require("$.Countability", "Count"), Require("$.Case", "Plain"), Require("$.Person", "Third"), Require("$.Determination", "Overt")]),
        // A singular determinative over a quantified plural, which *a* selects
        // only with *further* or *additional* (*an additional two creatures*;
        // CGEL, Ch. 5 §3.4, p. 353, [69–70]). A determiner agreeing with its
        // quantity is AgreeingModifiedQuantity's.
        (name: "DeterminedModifiedQuantity", lhs: "NounPhrase", rhs: [Cat("determiner", "DeterminerPhrase"), Cat("head", "ModifiedQuantifiedNominal")], equations: [Exclude("determiner.DeterminativeDistribution", "Dependent"), Exclude("determiner.DeterminativeDistribution", "FreeChoice"), Exclude("determiner.DeterminativeDistribution", "Distributive"), Require("head.QuantityNumber", "Plural"), Agree("$.Number", "head.QuantityNumber"), Require("determiner.Countability", "Count"), Require("$.Countability", "Count"), Require("$.Case", "Plain"), Require("$.Person", "Third"), Require("$.Determination", "Overt")]),
        (name: "AgreeingModifiedQuantity", lhs: "NounPhrase", rhs: [Cat("determiner", "DeterminerPhrase"), Cat("head", "ModifiedQuantifiedNominal")], equations: [Agree("determiner.Number", "head.QuantityNumber"), Exclude("determiner.DeterminativeDistribution", "Distributive"), Agree("$.Number", "head.QuantityNumber"), Require("determiner.Countability", "Count"), Require("$.Countability", "Count"), Require("$.Case", "Plain"), Require("$.Person", "Third"), Require("$.Determination", "Overt")]),
        (name: "DistributiveModifiedQuantity", lhs: "NounPhrase", rhs: [Cat("determiner", "DeterminerPhrase"), Cat("head", "ModifiedQuantifiedNominal")], equations: [Agree("$.DeterminativeDistribution", "determiner.DeterminativeDistribution"), Require("determiner.DeterminativeDistribution", "Distributive"), Agree("$.Number", "determiner.Number"), Require("determiner.Countability", "Count"), Require("$.Countability", "Count"), Require("$.Case", "Plain"), Require("$.Person", "Third"), Require("$.Determination", "Overt")]),
        // A maximum quantity: a Preposition Phrase in Determiner function (*up
        // to two target creatures*; CGEL, Ch. 5 §7.1, p. 357), or the fused
        // head of its Noun Phrase (*choose up to one*). Its Complement is a
        // bare quantity, never a determined Noun Phrase.
        (name: "MaximumDetermination", lhs: "NounPhrase", rhs: [Selected("determiner", "PrepositionPhrase", ["Up"]), Cat("head", "Nominal")],
            equations: [Require("determiner.Determination", "Bare"), Agree("determiner.Number", "head.Number"), Require("head.Countability", "Count"), Require("$.Determination", "Overt"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        // A maximum measure of a mass noun (*up to five {P} worth of modes*;
        // [CR#700.2i]).
        (name: "MaximumMeasuredMass", lhs: "NounPhrase", rhs: [Selected("determiner", "PrepositionPhrase", ["Up"]), Cat("head", "Nominal")],
            equations: [Exclude("determiner.Countability", "Count"), Require("head.Countability", "Mass"), Require("head.Number", "Singular"), Require("$.Determination", "Overt"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        (name: "FusedMaximum", lhs: "NounPhrase", rhs: [Selected("head", "PrepositionPhrase", ["Up"])],
            equations: [Require("head.ComplementKind", "PP"), Require("$.NounKind", "Quantity"), Require("$.Countability", "Count"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        // A comparative determinative fused head modified by a measure phrase
        // (*costs {1} less to cast*; CGEL, Ch. 13 §4.4, pp. 1125–1126).
        (name: "MeasuredComparativeHead", lhs: "NounPhrase", rhs: [Cat("modifier", "NounPhrase"), Class("head", "ComparativeQuantifier")],
            equations: [Carry("modifier.Case", "Plain"), Exclude("modifier.Countability", "Count"), Require("$.NounKind", "Ordinary"), Require("$.Number", "Singular"), Require("$.Determination", "Bare"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        // Partitive Noun Phrases: a determinative fused head and its *of*
        // oblique, its sibling (CGEL, Ch. 5 §9.3, pp. 408–410). The Noun
        // Phrase takes its Number from the oblique, a distributive head's
        // singular from the head, and *any* may be singular with a plural
        // oblique (*if any of those cards shares a card type*).
        (name: "Partitive", lhs: "PartitiveHead", rhs: [Class("head", "PartitiveQuantifier"), Selected("complement", "PrepositionPhrase", ["Of"])],
            equations: [Exclude("head.DeterminativeDistribution", "Distributive"), Agree("$.Number", "complement.Number"), Require("$.NounKind", "Ordinary"), Require("$.Determination", "Overt"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        (name: "DistributivePartitive", lhs: "PartitiveHead", rhs: [Class("head", "PartitiveQuantifier"), Selected("complement", "PrepositionPhrase", ["Of"])],
            equations: [Require("complement.Number", "Plural"), Exclude("head.DeterminativeDistribution", "Dependent"), Exclude("head.DeterminativeDistribution", "Independent"), Require("$.NounKind", "Ordinary"), Require("$.Determination", "Overt"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        // Distributive *each* with a plural oblique takes plural agreement
        // by synesis (*Each of X target creatures you control connive*;
        // CGEL, Ch. 5 §18.2, p. 504); its Number is the oblique's, not the
        // singular quantifier's.
        (name: "SynesisDistributivePartitive", lhs: "PartitiveHead", rhs: [Word("quantifier", "Each"), Selected("complement", "PrepositionPhrase", ["Of"])],
            equations: [Require("complement.Number", "Plural"), Carry("complement.Case", "Plain"), Require("$.Number", "Plural"), Require("$.NounKind", "Ordinary"), Require("$.Determination", "Overt"), Require("$.Case", "Nominative"), Require("$.Person", "Third")], cost: 3),
        // *Any* with a plural oblique leaves the Noun Phrase's Number open.
        (name: "AnyPartitive", lhs: "PartitiveHead", rhs: [Word("head", "Any"), Selected("complement", "PrepositionPhrase", ["Of"])],
            equations: [Require("complement.Number", "Plural"), Require("$.NounKind", "Ordinary"), Require("$.Determination", "Overt"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        (name: "AnyMassPartitive", lhs: "PartitiveHead", rhs: [Word("head", "Any"), Selected("complement", "PrepositionPhrase", ["Of"])],
            equations: [Require("complement.Number", "Singular"), Require("$.Number", "Singular"), Require("$.NounKind", "Ordinary"), Require("$.Determination", "Overt"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        // A quantity with a partitive oblique (*up to two of them*, *that many
        // of those tokens*, *1 of that damage*).
        (name: "MaximumPartitive", lhs: "PartitiveHead", rhs: [Selected("head", "PrepositionPhrase", ["Up"]), Selected("complement", "PrepositionPhrase", ["Of"])],
            equations: [Require("$.NounKind", "Quantity"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        (name: "QuantityPartitive", lhs: "PartitiveHead", rhs: [Cat("head", "DeterminerPhrase"), Selected("complement", "PrepositionPhrase", ["Of"])],
            equations: [Require("head.DeterminativeDistribution", "Numerical"),
                Require("$.NounKind", "Ordinary"), Require("$.Determination", "Overt"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        // A determinative with its own Complement heads a partitive: an
        // exceptive one (*all but one of them*, *all but 1 of that damage*;
        // CGEL, Ch. 5 §7.3, p. 375) or a comparative one with a bare standard
        // (*more than one of the same mana symbol*; Ch. 5 §11(d), p. 432), a
        // count one over a count oblique, a non-count one over a non-count
        // oblique. The Noun Phrase has the determiner's Number: the
        // exceptive's own, the comparative's standard's.
        // A quantity with *each* as its oblique, the implicit partitive's set
        // recovered from the context (*create one of each*; CGEL, Ch. 5 §9.3,
        // p. 413): fused *each* is no Complement elsewhere (NonNumericComplement),
        // and a Preposition Phrase would let *of* take it before a second
        // *of* Phrase (*the beginning of each of your main phases*). It is a
        // fused Noun Phrase at once, so that no Preposition Phrase after it
        // modifies it (*one of each of those kinds of counters* is the
        // partitive of a partitive).
        (name: "QuantityPartitiveOfEach", lhs: "FusedNounPhrase", rhs: [Cat("head", "DeterminerPhrase"), Word("preposition", "Of"), Word("oblique", "Each")], unshared: ["DeterminativeDistribution"],
            equations: [Require("head.DeterminativeDistribution", "Numerical"), Require("$.DeterminativeDistribution", "Distributive"),
                Require("$.NounKind", "Ordinary"), Require("$.Determination", "Overt"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        (name: "ComplementedPartitive", lhs: "PartitiveHead", rhs: [Cat("head", "DeterminerPhrase"), Selected("complement", "PrepositionPhrase", ["Of"])],
            equations: [Require("head.ComplementKind", "PP"), Carry("head.Countability", "Count"), Agree("head.Countability", "complement.Countability"), Require("$.NounKind", "Ordinary"), Require("$.Determination", "Overt"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        (name: "ComplementedMassPartitive", lhs: "PartitiveHead", rhs: [Cat("head", "DeterminerPhrase"), Selected("complement", "PrepositionPhrase", ["Of"])],
            equations: [Require("head.ComplementKind", "PP"), Carry("head.Countability", "Mass"), Carry("complement.Countability", "Mass"), Require("$.NounKind", "Ordinary"), Require("$.Determination", "Overt"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        // A modified degree determinative (*that many of those tokens*); a
        // bare one is a Partitive Quantifier.
        (name: "DegreePartitive", lhs: "PartitiveHead", rhs: [Cat("head", "DeterminerPhrase"), Selected("complement", "PrepositionPhrase", ["Of"])],
            equations: [Require("head.ComplementKind", "Intransitive"), Require("head.DeterminativeDistribution", "Dependent"), Agree("head.Countability", "complement.Countability"),
                Require("$.NounKind", "Ordinary"), Require("$.Determination", "Overt"), Require("$.Case", "Plain"), Require("$.Person", "Third")], heavy: ["head"]),
        (name: "PostpositiveAdjective", lhs: "Nominal", rhs: [Cat("head", "Nominal"), Cat("modifier", "AdjectivePhrase")],
            equations: [Require("modifier.ComplementKind", "PP"), Exclude("modifier.Voice", "Passive")], heavy: ["modifier"]),
        // An AdjP with its own post-head dependent follows the nominal
        // (CGEL, Ch. 5 §14.2, p. 445): *creatures able to block it*.
        (name: "PostpositiveInfinitivalAdjective", lhs: "Nominal", rhs: [Cat("head", "Nominal"), Cat("modifier", "AdjectivePhrase")],
            equations: [Require("modifier.ComplementKind", "ToInf"), Exclude("modifier.AdjectivePosition", "Attributive"), Exclude("modifier.Voice", "Passive")], heavy: ["modifier"]),
        // A number or a comparative adjective with that number its
        // understood standard (*power 3 or greater*, *X is 2 or less*,
        // *five or greater*).
        (name: "ComparativeBoundedAlternative", lhs: "AdjectivePhrase", rhs: [Cat("first", "DeterminerPhrase"), Word("coordinator", "Or"), Cat("last", "AdjectivePhrase")],
            equations: [Require("first.DeterminativeDistribution", "Numerical"), Agree("$.Grade", "last.Grade"), Agree("$.AdjectivePosition", "last.AdjectivePosition"), Agree("$.Voice", "last.Voice"), Require("$.ComplementKind", "Amount")]),
        // A postpositive comparative quantity (*for each card fewer than
        // three in their hand*).
        // The same alternative as the value of a noun that takes an Amount
        // (*power 3 or less*, *mana value X or greater*): the noun's frame,
        // not a postmodifier, licenses it.
        (name: "ComparativeBoundedAmount", lhs: "Amount", rhs: [Cat("first", "Amount"), Word("coordinator", "Or"), Cat("last", "AdjectivePhrase")],
            equations: [Agree("$.QuantityNumber", "first.QuantityNumber")]),
        // A scalar comparative bound on a number as an Amount: the endpoint
        // of a scalar change, like the number it bounds (*reduce it to less
        // than 1* beside *reduce it to 1*, *reduced to 0 or less*; CGEL, Ch. 8
        // §5.2, pp. 691–692; the comparative and its *than* Complement, Ch. 13
        // §2.1, p. 1104).
        (name: "ComparativeAmount", lhs: "Amount", rhs: [Class("quantifier", "ComparativeQuantifier"), Selected("complement", "PrepositionPhrase", ["Than"])],
            equations: [Require("quantifier.Countability", "Mass"), Require("complement.NounKind", "Numeric"), Require("$.ComplementKind", "PP")]),
        (name: "PostpositiveComparative", lhs: "Nominal", rhs: [Cat("head", "Nominal"), Cat("modifier", "DeterminerPhrase")],
            equations: [Require("head.Number", "Singular"), Require("modifier.ComplementKind", "PP"), Require("modifier.Countability", "Count"), Exclude("modifier.ObliqueKind", "AdvP")], heavy: ["modifier"], cost: 2),
        (name: "PostpositiveLocativeAdjective", lhs: "LocativeHead", rhs: [Cat("head", "LocativeHead"), Cat("modifier", "AdjectivePhrase")],
            equations: [], heavy: ["modifier"]),
        // A comparative adjective modified by a measure phrase (*2 greater*;
        // CGEL, Ch. 13 §4.4, pp. 1125–1126).
        (name: "MeasuredComparative", lhs: "AdjectivePhrase", rhs: [Cat("modifier", "NounPhrase"), Cat("head", "AdjectivePhrase")],
            equations: [Require("head.Grade", "Comparative"), Require("head.ComplementKind", "Intransitive"), Require("modifier.Determination", "Bare"), Carry("modifier.Case", "Plain")]),
        // The same with the comparative's *than* Complement, its measure a
        // number (*at least 10 greater than your starting life total*); a
        // property noun before a comparative is its postpositive adjective's
        // head (*mana value less than or equal to …*).
        (name: "MeasuredStandardComparative", lhs: "AdjectivePhrase", rhs: [Cat("modifier", "NounPhrase"), Cat("head", "AdjectivePhrase")],
            equations: [Require("head.Grade", "Comparative"), Require("head.ComplementKind", "PP"), Carry("modifier.NounKind", "Numeric"), Carry("modifier.Case", "Plain")]),
        // A superlative quantifier under the definite article (*the most
        // creatures*, *the least life*; CGEL, Ch. 5 §6.1, p. 393), with a
        // plural count or a mass head.
        (name: "SuperlativeCountDeterminer", lhs: "DeterminerPhrase", rhs: [Word("marker", "The"), Class("head", "SuperlativeQuantifier")],
            equations: [Require("$.Number", "Plural"), Require("$.Countability", "Count"), Require("$.ComplementKind", "Intransitive")]),
        (name: "SuperlativeMassDeterminer", lhs: "DeterminerPhrase", rhs: [Word("marker", "The"), Class("head", "SuperlativeQuantifier")],
            equations: [Require("$.Number", "Singular"), Require("$.Countability", "Mass"), Require("$.ComplementKind", "Intransitive")]),
        // A comparative determinative with its *than* Complement after the
        // head (*more lands than you*, *less life than an opponent*; CGEL,
        // Ch. 13 §2.1, p. 1104), of a plural count or a mass head.
        (name: "ComparativeCountDetermined", lhs: "NounPhrase", rhs: [Class("determiner", "ComparativeQuantifier"), Cat("head", "Nominal"), Selected("complement", "PrepositionPhrase", ["Than"])],
            equations: [Require("head.Number", "Plural"), Require("head.Countability", "Count"), Agree("determiner.Number", "head.Number"), Agree("determiner.Countability", "head.Countability"), Require("$.Determination", "Overt"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        (name: "ComparativeMassDetermined", lhs: "NounPhrase", rhs: [Class("determiner", "ComparativeQuantifier"), Cat("head", "Nominal"), Selected("complement", "PrepositionPhrase", ["Than"])],
            equations: [Require("head.Number", "Singular"), Require("head.Countability", "Mass"), Agree("determiner.Number", "head.Number"), Agree("determiner.Countability", "head.Countability"), Require("$.Determination", "Overt"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        // A comparative determinative and its *than* Complement, siblings in
        // a Determinative Phrase (*more than one*, *fewer than six*; CGEL,
        // Ch. 13 §2.1, p. 1104). Its standard is a bare quantity, and the
        // phrase has the standard's Number (*more than one creature*, *more
        // than two lands*; Ch. 5 §11(d), p. 432), so the comparative is
        // `quantifier`, not `head`, which would give it the comparative's own
        // Number. A determined standard follows the head instead (*more lands
        // than you*); a bounding frequency is a degree Adjunct's
        // (ComparativeAdverb).
        (name: "ComparativeDeterminer", lhs: "DeterminerPhrase", rhs: [Class("quantifier", "ComparativeQuantifier"), Selected("complement", "PrepositionPhrase", ["Than"])],
            equations: [Require("complement.Determination", "Bare"), Exclude("complement.ComplementKind", "AdvP"), Agree("$.Number", "complement.Number"), Agree("$.Countability", "quantifier.Countability"), Agree("$.DeterminativeDistribution", "quantifier.DeterminativeDistribution"), Require("$.ComplementKind", "PP"), Agree("$.ObliqueNumber", "complement.Number"), Agree("$.ObliqueKind", "complement.ComplementKind"), Agree("$.ObliqueDetermination", "complement.Determination")]),
        // The same with a determinative modifying the comparative (*no more
        // than one*, *many more than two*; CGEL, Ch. 13 §4.4, p. 1126).
        (name: "ModifiedComparativeDeterminer", lhs: "DeterminerPhrase", rhs: [Lex("modifier", Determinative), Class("quantifier", "ComparativeQuantifier"), Selected("complement", "PrepositionPhrase", ["Than"])],
            equations: [Require("complement.Determination", "Bare"), Exclude("complement.ComplementKind", "AdvP"), Agree("$.Number", "complement.Number"), Agree("$.Countability", "quantifier.Countability"), Agree("$.DeterminativeDistribution", "quantifier.DeterminativeDistribution"), Require("$.ComplementKind", "PP"), Agree("$.ObliqueNumber", "complement.Number"), Agree("$.ObliqueKind", "complement.ComplementKind"), Agree("$.ObliqueDetermination", "complement.Determination")]),
        // The same without the *than* Complement, the standard being the
        // nominal it determines (*no more scream counters*, *no fewer
        // cards*; CGEL, Ch. 13 §4.4, p. 1126), as a measure phrase does in
        // MeasuredComparativeDeterminer.
        (name: "DegreeModifiedComparativeDeterminer", lhs: "DeterminerPhrase", rhs: [Word("modifier", "No"), Class("quantifier", "ComparativeQuantifier")],
            equations: [Agree("$.Number", "quantifier.Number"), Agree("$.Countability", "quantifier.Countability"), Agree("$.DeterminativeDistribution", "quantifier.DeterminativeDistribution"), Require("$.ComplementKind", "Intransitive")]),
        // Arithmetic: *plus* and *minus* head Preposition Phrases modifying a
        // quantity (*2 plus the number of ...*, *X plus 3 life*, *that many plus
        // one*).
        (name: "AmountArithmetic", lhs: "Amount", rhs: [Cat("head", "Amount"), Selected("modifier", "PrepositionPhrase", ["Plus", "Minus"])],
            equations: [Require("modifier.ComplementKind", "Amount")]),
        // *X minus one*: a bare quantity operand.
        (name: "AmountQuantityArithmetic", lhs: "Amount", rhs: [Cat("head", "Amount"), Selected("modifier", "PrepositionPhrase", ["Plus", "Minus"])],
            equations: [Require("modifier.ComplementKind", "NP"), Require("modifier.Determination", "Bare")]),
        // *X minus one 2/2 ... tokens*: an arithmetic determiner.
        (name: "ArithmeticDeterminer", lhs: "NumericalDeterminer", rhs: [Cat("head", "NumericalDeterminer"), Selected("modifier", "PrepositionPhrase", ["Plus", "Minus"])],
            equations: [Require("modifier.ComplementKind", "NP"), Require("modifier.Determination", "Bare"), Exclude("modifier.Case", "Genitive")]),
        // *three times X*: a multiplied amount, or determiner (*three times X
        // cards*).
        (name: "MultipliedDeterminer", lhs: "NumericalDeterminer", rhs: [Numeral("factor", Cardinal), Cat("multiplier", "BareNominal"), Cat("head", "NumericalDeterminer")],
            equations: [Require("multiplier.NounDistribution", "Serial"), Require("multiplier.Number", "Plural")]),
        // *three times this creature's power*.
        (name: "MultipliedNounPhrase", lhs: "NounPhrase", rhs: [Numeral("factor", Cardinal), Cat("multiplier", "BareNominal"), Cat("head", "NounPhrase")],
            equations: [Require("multiplier.NounDistribution", "Serial"), Require("multiplier.Number", "Plural"), Require("head.Determination", "Overt")]),
        (name: "MultipliedAmount", lhs: "Amount", rhs: [Numeral("factor", Cardinal), Cat("multiplier", "BareNominal"), Cat("head", "Amount")],
            equations: [Require("multiplier.Number", "Plural")]),
        (name: "NumericArithmetic", lhs: "NounPhrase", rhs: [Cat("head", "Amount"), Selected("modifier", "PrepositionPhrase", ["Plus", "Minus"])],
            equations: [Require("modifier.ComplementKind", "NP"), Require("modifier.Determination", "Overt"), Require("$.NounKind", "Ordinary"), Require("$.Number", "Singular"), Require("$.Determination", "Bare"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        (name: "NounPhraseArithmetic", lhs: "NounPhrase", rhs: [Cat("head", "NounPhrase"), Selected("modifier", "PrepositionPhrase", ["Plus", "Minus"])],
            equations: [Exclude("head.NounKind", "Numeric"), Carry("head.Case", "Plain")]),
        // A frequency Noun Phrase admits the same arithmetic as an object
        // Noun Phrase, adding or taking away a number of occurrences (*that
        // many times plus an additional time*; CGEL, Ch. 7 §5.1(a), p. 635;
        // Ch. 8 §9, pp. 713–716).
        (name: "TemporalArithmetic", lhs: "TemporalNounPhrase", rhs: [Cat("head", "TemporalNounPhrase"), Selected("modifier", "PrepositionPhrase", ["Plus", "Minus"])],
            equations: [Require("modifier.NounKind", "Temporal")]),
        // The same on a frequency adverb (*copy that spell once plus an
        // additional time for each opponent*), which counts occasions as a
        // frequency Noun Phrase does (CGEL, Ch. 8 §9, p. 715).
        (name: "FrequencyAdverbArithmetic", lhs: "AdverbPhrase", rhs: [Cat("head", "AdverbPhrase"), Selected("modifier", "PrepositionPhrase", ["Plus", "Minus"])],
            equations: [Require("head.AdjunctPosition", "End"), Require("modifier.NounKind", "Temporal")]),
        // Its operand is no distributive phrase (*that many plus one of each of
        // those kinds*: *one of each* is the partitive's, and *of those kinds*
        // its oblique).
        (name: "DegreeArithmetic", lhs: "DeterminerPhrase", rhs: [Cat("head", "DeterminerPhrase"), Selected("modifier", "PrepositionPhrase", ["Plus", "Minus"])],
            equations: [Require("head.ComplementKind", "Intransitive"), Exclude("modifier.DeterminativeDistribution", "Distributive")], heavy: ["head"]),
        // A fraction or multiplier before a determined Noun Phrase (*half their
        // life*, *double that damage*).
        (name: "MultiplierPredetermination", lhs: "NounPhrase", rhs: [Cat("determiner", "DeterminerPhrase"), Cat("head", "NounPhrase")],
            equations: [Require("determiner.DeterminativeDistribution", "Multiplier"), Require("head.Determination", "Overt")]),
        (name: "AdverbAdverbial", lhs: "Adverbial", rhs: [Cat("head", "AdverbPhrase")], equations: [Require("head.AdjunctPosition", "End")]),
        (name: "FrequencyAdverbial", lhs: "Adverbial", rhs: [Cat("head", "TemporalNounPhrase")]),
        // A comparative determinative and its *than* Complement, siblings in
        // a degree Adjunct (*choose the same mode more than once*; CGEL, Ch.
        // 13 §4.4), with or without a determinative modifying the
        // comparative (*activate no more than twice*). Its standard is a
        // bounding frequency (*once*, *twice*), which counts occasions (CGEL,
        // Ch. 8 §9, p. 715), so *more* is count *many*'s comparative (Ch. 13
        // §4.1, p. 1123).
        (name: "ComparativeAdverb", lhs: "AdverbPhrase", rhs: [Class("head", "ComparativeQuantifier"), Selected("complement", "PrepositionPhrase", ["Than"])],
            equations: [Require("complement.ComplementKind", "AdvP"), Require("head.Countability", "Count"), Require("$.AdjunctPosition", "End")]),
        (name: "ModifiedComparativeAdverb", lhs: "AdverbPhrase", rhs: [Lex("modifier", Determinative), Class("head", "ComparativeQuantifier"), Selected("complement", "PrepositionPhrase", ["Than"])],
            equations: [Require("complement.ComplementKind", "AdvP"), Require("head.Countability", "Count"), Require("$.AdjunctPosition", "End")]),
        // A comparative adjective premodifier with its *than* Complement after
        // the head, an indirect Complement (*greater power than this
        // creature*; CGEL, Ch. 13 §2.1, p. 1104; Ch. 5 §16.1, p. 445).
        (name: "ComparativeIndirectComplement", lhs: "Nominal", rhs: [Cat("modifier", "AdjectivePhrase"), Cat("head", "Nominal"), Selected("complement", "PrepositionPhrase", ["Than"])],
            equations: [Require("modifier.Grade", "Comparative"), Exclude("modifier.AdjectivePosition", "Predicative"), Agree("modifier.Determination", "$.Determination")]),
        // A non-scalar comparative governor of inequality takes its *than*
        // Complement after the head too, in the Type I attributive
        // construction (*a different sort of experience than live music*,
        // *some other means of restricting imports than tariffs*; CGEL, Ch.
        // 13 §5.4, pp. 1143–1145).
        (name: "NonScalarIndirectComplement", lhs: "Nominal", rhs: [Cat("modifier", "AdjectivePhrase"), Cat("head", "Nominal"), Selected("complement", "PrepositionPhrase", ["Than"])],
            equations: [Carry("modifier.Grade", "NonScalarInequality"), Exclude("modifier.AdjectivePosition", "Predicative"), Agree("modifier.Determination", "$.Determination")]),
        (name: "EquativeIndirectComplement", lhs: "Nominal", rhs: [Cat("modifier", "AdjectivePhrase"), Cat("head", "Nominal"), Selected("complement", "PrepositionPhrase", ["As"])],
            equations: [Require("modifier.Grade", "Equative"), Require("complement.ComplementKind", "NP"), Agree("modifier.Determination", "$.Determination")]),
        // An analytic superlative (*your most recent turn*, *most recently
        // cast*; CGEL, Ch. 13 §4.3, p. 1122): a plain adjective heads a
        // superlative phrase.
        (name: "DegreeModifiedAdjective", lhs: "AdjectivePhrase", rhs: [Word("modifier", "Most"), Cat("head", "AdjectivePhrase")], unshared: ["Grade"],
            equations: [Require("$.AdjectivePosition", "Attributive"), Require("head.Grade", "Plain"), Require("$.Grade", "Superlative")]),
        (name: "DegreeModifiedAdverb", lhs: "AdverbPhrase", rhs: [Word("modifier", "Most"), Cat("head", "AdverbPhrase")],
            equations: [Require("head.AdjunctPosition", "Central")]),
        // A comparative determinative and its *than* Complement as a fused
        // head (*by more than {5}*, *more than two*), with a bare standard;
        // scalar *less than* is the adjective's. The Noun Phrase has its
        // standard's Number, not the quantifier's (*more* is plural).
        // *All* with an exception Preposition Phrase as a fused determiner-head
        // whose standard is a determined Noun Phrase (*ignore all but the
        // highest roll*; CGEL, Ch. 5 §11(f), p. 433): a definite one, since a
        // quantity there determines with *all but* (*all but one +1/+1
        // counter*, *[all but one] of them*). It counts the members of
        // a set (*All but a few helicopters*), so count *all*: the Noun
        // Phrase has its plural, not the exception's Number. A bare quantity
        // in the exception is ComparativeFusedHead's (*all but one*).
        (name: "ExceptiveFusedHead", lhs: "NounPhrase", rhs: [Cat("quantifier", "DeterminerPhrase")],
            equations: [Require("quantifier.ComplementKind", "PP"), Require("quantifier.ObliqueKind", "NP"), Require("quantifier.ObliqueDetermination", "Overt"), Carry("quantifier.ObliqueDistribution", "Dependent"), Carry("quantifier.Countability", "Count"), Agree("$.Number", "quantifier.Number"), Require("$.Countability", "Count"), Require("$.NounKind", "Ordinary"), Require("$.Determination", "Overt"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        (name: "ComparativeFusedHead", lhs: "NounPhrase", rhs: [Cat("quantifier", "DeterminerPhrase")],
            equations: [Require("quantifier.ComplementKind", "PP"), Exclude("quantifier.ObliqueKind", "AdvP"), Exclude("quantifier.ObliqueKind", "FiniteClause"), Require("quantifier.ObliqueDetermination", "Bare"), Exclude("quantifier.Countability", "Mass"), Agree("$.Number", "quantifier.ObliqueNumber"), Agree("$.Countability", "quantifier.Countability"), Require("$.NounKind", "Ordinary"), Require("$.Determination", "Overt"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        // A comparative determinative fused head whose standard a dependent
        // determinative determines (*can't be more than the total number of
        // ...*; CGEL, Ch. 13 §4.5(a), p. 1132): *more* is the head and its
        // *than* phrase its Complement. A quantified standard is not one: *more
        // than two* determines *lands* and *more than one* heads a partitive
        // (Ch. 5 §11(d), p. 432). Predicative *less than* is the adjective's
        // (Ch. 13 §4.1.1, p. 1126).
        (name: "ComparativeDeterminedStandard", lhs: "NounPhrase", rhs: [Class("quantifier", "ComparativeQuantifier"), Selected("complement", "PrepositionPhrase", ["Than"])],
            equations: [Require("complement.ComplementKind", "NP"), Require("complement.Determination", "Overt"), Carry("complement.DeterminativeDistribution", "Dependent"), Exclude("quantifier.Countability", "Mass"), Agree("$.Countability", "quantifier.Countability"), Agree("$.Number", "complement.Number"), Require("$.NounKind", "Ordinary"), Require("$.Determination", "Overt"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        // A fraction with its partitive oblique (*a third of their life*).
        (name: "FractionPartitive", lhs: "PartitiveHead", rhs: [Cat("determiner", "DeterminerPhrase"), Numeral("head", Ordinal), Selected("complement", "PrepositionPhrase", ["Of"])],
            equations: [Require("$.Number", "Singular"), Require("$.NounKind", "Ordinary"), Require("$.Determination", "Overt"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        // A measure phrase on a comparative determinative with its *than*
        // Complement (*at least 7 life more than your starting life total*;
        // *at least four more creatures than you*). The measure phrase is
        // quantified by a numeral (CGEL, Ch. 6 §3.2, pp. 549–550): in *target
        // creature with power less than this creature's power*, *power* has a
        // postpositive comparative.
        (name: "MeasuredComparativeStandard", lhs: "NounPhrase", rhs: [Cat("modifier", "NounPhrase"), Class("head", "ComparativeQuantifier"), Selected("complement", "PrepositionPhrase", ["Than"])],
            equations: [Carry("modifier.Case", "Plain"), Carry("modifier.DeterminativeDistribution", "Numerical"), Exclude("complement.ComplementKind", "AdvP"), Require("$.NounKind", "Ordinary"), Require("$.Number", "Singular"), Require("$.Determination", "Bare"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        (name: "MeasuredComparativeDetermined", lhs: "NounPhrase", rhs: [Cat("modifier", "DeterminerPhrase"), Class("determiner", "ComparativeQuantifier"), Cat("head", "Nominal"), Selected("complement", "PrepositionPhrase", ["Than"])],
            equations: [Require("modifier.DeterminativeDistribution", "Numerical"), Require("head.Number", "Plural"), Require("head.Countability", "Count"), Agree("determiner.Countability", "head.Countability"), Require("$.Determination", "Overt"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        // A measured comparative determinative takes the measure's Number
        // (*one more spell*, *one fewer revival counter*).
        (name: "MeasuredComparativeDeterminer", lhs: "DeterminerPhrase", rhs: [Cat("modifier", "DeterminerPhrase"), Class("quantifier", "ComparativeQuantifier")],
            equations: [Require("modifier.DeterminativeDistribution", "Numerical"), Agree("$.Number", "modifier.Number"), Require("$.Countability", "Count"), Agree("quantifier.Countability", "$.Countability"), Require("$.DeterminativeDistribution", "Numerical"), Require("$.ComplementKind", "Intransitive")]),
        // Floated *each* before a predicative adjective (*are each equal to
        // ...*, *power and toughness each equal to ...*; CGEL, Ch. 5 §10.1.1,
        // p. 428).
        (name: "FloatedEachAdjective", lhs: "AdjectivePhrase", rhs: [Word("adjunct", "Each"), Cat("head", "AdjectivePhrase")], equations: [Require("head.ComplementKind", "PP")]),
        // Floated *each* before a Preposition Phrase postmodifying a plural
        // nominal, which it quantifies distributively (*creature cards each
        // with mana value 3 or less*), as before a postpositive adjective
        // above (CGEL, Ch. 5 §9.3, p. 413; §10.1.1, p. 428).
        (name: "FloatedEachPostmodifier", lhs: "Nominal", rhs: [Cat("head", "Nominal"), Word("adjunct", "Each"), Hosted("modifier", "PrepositionPhrase", Nominal)],
            equations: [Require("head.Number", "Plural")], heavy: ["modifier"], cost: 1),
        // A floating quantifier after an auxiliary (*any number of target players may
        // each search ...*; CGEL, Ch. 5 §10.1.1, p. 428).
        (name: "AuxiliaryFloatedEach", lhs: "VerbPhrase", rhs: [Class("adjunct", "FloatingQuantifier"), Cat("head", "VerbPhrase")],
            equations: [Require("head.VerbForm", "Plain")], transparent: ["head"], cost: 2),
        // Two front dependents before one comma (*Then if ...*, *Once during
        // each of your turns, ...*); the adverb is an Adjunct of the Clause,
        // not a modifier of the Preposition Phrase (OSG §10, Sequence;
        // §11, This, next, and each).
        (name: "PreposedAdverbAndPreposition", lhs: "Clause", rhs: [Cat("adjunct", "AdverbPhrase"), Hosted("adjunct", "PrepositionPhrase", Predicate), Punct(','), Cat("head", "Clause")],
            equations: [Require("adjunct.AdjunctPosition", "Front"), Require("$.FrontPosition", "Occupied")], transparent: ["head"], cost: 2),
        // A verbal cost with a passive participial Supplement (*Pay half your
        // life, rounded up:*).
        (name: "SupplementedVerbalCost", lhs: "NonManaCost", rhs: [Cat("head", "VerbPhrase"), Punct(','), Cat("supplement", "VerbPhrase")],
            equations: [Require("head.VerbForm", "Plain"), Require("supplement.VerbForm", "PastParticiple"), Require("supplement.Voice", "Passive")], heavy: ["supplement"], cost: 3),
        (name: "NominalInstruction", lhs: "Sentence", rhs: [Cat("head", "IndexedNominal"), Punct('.')]),
        // *When this Class becomes level 2*.
        (name: "IndexedNounPhrase", lhs: "NounPhrase", rhs: [Cat("head", "IndexedNominal")], equations: [Require("head.Number", "Singular"), Require("$.NounKind", "Ordinary"), Require("$.Determination", "Bare"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        // The count-noun pro-form *one* (*this one*, *a different one of
        // those creatures*, *the first one they draw*; CGEL, Ch. 5 §7.1,
        // pp. 386–388; Ch. 17 §5.1, p. 1511).
        (name: "CardinalNominal", lhs: "BareNominal", rhs: [Numeral("head", Cardinal)],
            equations: [Require("$.Determination", "Overt"), Require("$.Number", "Singular"), Require("$.Countability", "Count"), Require("$.NounKind", "Ordinary"), Require("$.NounDistribution", "Ordinary")]),
        // *for each target beyond the first*.
        (name: "FusedOrdinalHead", lhs: "NounPhrase", rhs: [Cat("determiner", "DeterminerPhrase"), Numeral("head", Ordinal)], equations: [Require("determiner.Countability", "Count"), Require("determiner.Number", "Singular"), Require("$.Number", "Singular"), Require("$.Case", "Plain"), Require("$.NounKind", "Ordinary"), Require("$.Countability", "Count"), Require("$.Determination", "Overt"), Require("$.Person", "Third")]),
        (name: "FusedAdjectiveHead", lhs: "NounPhrase", rhs: [Cat("determiner", "DeterminerPhrase"), Class("head", "FusedHeadAdjective")], equations: [Require("$.Case", "Plain"), Require("$.Person", "Third"), Require("$.Determination", "Overt"), Require("$.Countability", "Count"), Agree("determiner.Countability", "$.Countability"), Require("$.NounKind", "Ordinary")]),
        // Abstract anaphoric NP *the same*, including *do the same for ...*
        // (CGEL, Ch. 17, p. 1545). Its head remains an adjective.
        (name: "DefiniteFusedAdjectiveHead", lhs: "NounPhrase", rhs: [Word("determiner", "The"), Class("head", "DefiniteFusedHeadAdjective")], equations: [Require("$.Case", "Plain"), Require("$.Person", "Third"), Require("$.Determination", "Overt"), Require("$.Countability", "Count"), Require("$.NounKind", "Ordinary")]),
        (name: "SingleRowHeader", lhs: "RowHeader", rhs: [Cat("head", "Amount")], equations: []),
        (name: "OpenRowHeader", lhs: "RowHeader", rhs: [Cat("head", "Amount"), Punct('+')], equations: []),
        (name: "UnicodeRangeRowHeader", lhs: "RowHeader", rhs: [Cat("lower", "Amount"), Mark('—', Bound), Cat("upper", "Amount")], equations: []),
        (name: "TableRow", lhs: "Ability", rhs: [Cat("header", "RowHeader"), Mark('|', Free), Cat("head", "Ability")]),
        (name: "SequentialVerbalCosts", lhs: "NonManaCost", rhs: [Cat("first", "VerbPhrase"), Punct(','), Cat("rest", "Cost")], equations: [Require("first.VerbForm", "Plain")]),
        (name: "DeclarativeCost", lhs: "NonManaCost", rhs: [Cat("head", "Clause")], equations: [Require("head.VerbForm", "Finite"), Exclude("head.Inflection", "Irrealis")]),
        (name: "ClauseCondition", lhs: "Condition", rhs: [Cat("head", "Clause")]),
        (name: "KeywordInstruction", lhs: "Sentence", rhs: [Cat("head", "KeywordLineItem"), Punct('.')], equations: [Require("head.KeywordForm", "Parametric")]),
        // A floating quantifier quantifies a plural Subject (*they each*,
        // *this creature and target creature both*), or a second-person one:
        // *you* is singular in Oracle, but its verb forms are those of plural
        // *you* (CGEL, Ch. 5 §10.1.1, p. 428 [7ii]: *You each qualify for a
        // prize*; *You each lose life*).
        // Restated as RelativeFloatedEach; a change to one must be made to the
        // other.
        (name: "FloatedEach", lhs: "Clause", rhs: [Cat("subject", "NounPhrase"), Class("adjunct", "FloatingQuantifier"), Cat("head", "VerbPhrase")], equations: [ExcludeTogether([("subject.Number", "Singular"), ("subject.Person", "Third")]), Exclude("subject.Case", "Accusative"), Agree("subject.Number", "head.Number"), Agree("subject.Person", "head.Person"), Require("head.VerbForm", "Finite"), Require("$.ClauseMarking", "Unmarked")], transparent: ["head"]),
        // Floated *all* after a personal pronoun Subject (*they all share a
        // color*; CGEL, Ch. 5 §10.1.1, p. 428).
        // Restated as RelativeFloatedAll; a change to one must be made to the
        // other.
        (name: "FloatedAll", lhs: "Clause", rhs: [Cat("subject", "NounPhrase"), Word("adjunct", "All"), Cat("head", "VerbPhrase")], equations: [Require("subject.Number", "Plural"), Require("subject.Case", "Nominative"), Agree("subject.Number", "head.Number"), Agree("subject.Person", "head.Person"), Require("head.VerbForm", "Finite"), Require("$.ClauseMarking", "Unmarked")], transparent: ["head"]),
        (name: "NumericalDetermination", lhs: "DeterminerPhrase", rhs: [Cat("head", "NumericalDeterminer")], equations: [Require("$.DeterminativeDistribution", "Numerical"), Require("$.ComplementKind", "Intransitive")]),
        (name: "MeasuredMass", lhs: "NounPhrase", rhs: [Cat("determiner", "DeterminerPhrase"), Cat("head", "Nominal")], equations: [Require("determiner.DeterminativeDistribution", "Numerical"), Agree("$.DeterminativeDistribution", "determiner.DeterminativeDistribution"), Require("head.NounDistribution", "DirectMeasure"), Require("head.Countability", "Mass"), Require("head.Number", "Singular"), Require("$.Case", "Plain"), Require("$.Determination", "Overt"), Require("$.Person", "Third")]),
        // A measure noun counted unit by unit (*for each mana spent*).
        (name: "DistributiveMeasure", lhs: "NounPhrase", rhs: [Cat("determiner", "DeterminerPhrase"), Cat("head", "Nominal")], equations: [Agree("$.DeterminativeDistribution", "determiner.DeterminativeDistribution"), Require("determiner.DeterminativeDistribution", "Distributive"), Require("head.NounDistribution", "DirectMeasure"), Require("head.Countability", "Mass"), Require("head.Number", "Singular"), Agree("determiner.NounKind", "head.NounKind"), Require("$.Case", "Plain"), Require("$.Person", "Third"), Require("$.Determination", "Overt")]),
        (name: "FusedPhrase", lhs: "NounPhrase", rhs: [Cat("head", "FusedNounPhrase")]),
        (name: "LocativeFusedHead", lhs: "FusedNounPhrase", rhs: [Cat("head", "LocativeHead")]),
        (name: "PartitiveFusedHead", lhs: "FusedNounPhrase", rhs: [Cat("head", "PartitiveHead")]),
        (name: "FusedLocative", lhs: "LocativeHead", rhs: [Word("head", "Anywhere")], equations: [Require("$.NounKind", "Ordinary"), Require("$.Determination", "Bare"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        // A cited noun, alone or prefixed by *non-* (*choose land or
        // nonland*; CGEL, Ch. 5 §8.2, p. 401): bare and singular, whatever its
        // countability, since it names the word, not what the word denotes.
        (name: "WordMention", lhs: "Mention", rhs: [FreeLex("head", Noun)], equations: [Require("head.Inflection", "Singular")]),
        (name: "NegativeMention", lhs: "Mention", rhs: [Lex("prefix", Affix), Cat("head", "Mention")], uncoordinated: ["head"], light: ["head"]),
        // A cited noun premodified by an attributive adjective or by a
        // cited word with *non-* is a composite nominal (*choose white
        // Citizen*, *non-Aura enchantment*; CGEL, Ch. 5 §14.4, pp. 448-450).
        // Only those modify: a cited noun before a cited noun (*choose
        // target creature*) is an ordinary Noun Phrase. The head is one word,
        // so that a longer term is left-branching, one tree.
        (name: "CompoundMention", lhs: "Mention", rhs: [Cat("modifier", "MentionModifier"), Cat("head", "Mention")], uncoordinated: ["head"], light: ["head"]),
        (name: "AdjectiveMentionModifier", lhs: "MentionModifier", rhs: [Cat("head", "AdjectivePhrase")], light: ["head"],
            equations: [Require("head.ComplementKind", "Intransitive"), Exclude("head.AdjectivePosition", "Predicative")]),
        (name: "NegativeMentionModifier", lhs: "MentionModifier", rhs: [Lex("prefix", Affix), Cat("head", "Mention")], uncoordinated: ["head"], light: ["head"]),
        // A count noun prefixed by *non-* heads a nominal, naming what is not
        // of its kind (*four or more nonlands*; CGEL, Ch. 19 §5.5.1, p. 1689:
        // *non-member*, *non-resident*): one noun, never a compound under the
        // prefix.
        (name: "PrefixedNoun", lhs: "BareNominal", rhs: [Lex("prefix", Affix), Cat("head", "BareNominal")], equations: [Carry("head.Countability", "Count")], light: ["head"]),
        (name: "AttributiveNoun", lhs: "NounPremodifier", rhs: [FreeLex("head", Noun)], equations: [Require("head.Inflection", "Singular"), Exclude("head.NounDistribution", "HeadOnly")]),
        (name: "PrefixedNounPremodifier", lhs: "NounPremodifier", rhs: [Lex("prefix", Affix), Cat("head", "NounPremodifier")], equations: [Require("$.Polarity", "Negative")]),
        // An attributive participle expands only by an adverb before it (*a
        // poorly drafted report*, *each differently named dungeon*; CGEL, Ch.
        // 14 §1.1, p. 1175, [9]): a manner adverb, which a clause has in end
        // position.
        (name: "AdverbModifiedParticiple", lhs: "Participle", rhs: [Cat("modifier", "AdverbPhrase"), Cat("head", "Participle")], equations: [Require("modifier.AdjunctPosition", "End")], cost: 0),
        // A participle premodifier prefixed by *non-* (*nonattacking*).
        (name: "PrefixedParticiple", lhs: "Participle", rhs: [Lex("prefix", Affix), Cat("head", "Participle")], equations: [Require("$.Polarity", "Negative")], cost: 0),
        (name: "NounConjunct", lhs: "NounPremodifierConjunct", rhs: [Cat("head", "NounPremodifier")], cost: 0),
        // A noun premodifier sits inside determinative and adjectival ones,
        // never outside them or on a determined symbol (*amount {G}*).
        (name: "NounAttribute", lhs: "Attribute", rhs: [Cat("filler", "NounPremodifier")], equations: [Require("$.ComplementKind", "Nominal"), Agree("$.Polarity", "filler.Polarity")]),
        // A gerund-participle in a coordination of premodifiers. As in a
        // Depictive, it is an unlike conjunct of an adjective (*tapped and
        // attacking token*, *attacking, blocking, or tapped creature*).
        (name: "ParticipialAttribute", lhs: "Attribute", rhs: [Cat("filler", "Participle")], equations: [Require("filler.Inflection", "GerundParticiple"), Require("$.ComplementKind", "Gerund"), Agree("$.Polarity", "filler.Polarity")]),
        (name: "AdjectivalAttribute", lhs: "Attribute", rhs: [Cat("filler", "AdjectivePhrase")], equations: [Require("filler.ComplementKind", "Intransitive"), Exclude("filler.AdjectivePosition", "Predicative"), Require("$.ComplementKind", "AdjP"), Agree("$.Polarity", "filler.Polarity")]),
        // Oracle sets off with commas only independent negative modifiers of
        // one head (`docs/oracle-style-guide.md` §6, Determiners and modifier
        // order): each premodifier of an asyndetic chain is a *non-* one,
        // `Polarity: Negative`, which the chain requires it to carry. A
        // comma before a bare premodifier is a serial coordination's (§3,
        // Commas and the serial comma): *a Swamp, Mountain, black permanent,
        // or red permanent*, *a Bat, Bird, Mouse, or Rabbit card*.
        (name: "AsyndeticAttributes", lhs: "Attributes", rhs: [Cat("first", "Attribute"), Punct(','), Cat("rest", "AttributeChain")], equations: [Carry("first.Polarity", "Negative")]),
        (name: "AttributeSequence", lhs: "AttributeChain", rhs: [Cat("first", "Attribute"), Punct(','), Cat("rest", "AttributeChain")], equations: [Carry("first.Polarity", "Negative")]),
        (name: "FinalAttribute", lhs: "AttributeChain", rhs: [Cat("last", "Attribute")], equations: [Carry("last.Polarity", "Negative")]),
        (name: "AttributedNominal", lhs: "BareNominal", rhs: [Cat("modifier", "Attributes"), Cat("head", "BareNominal")], equations: []),
        (name: "NominalPremodifier", lhs: "BareNominal", rhs: [Cat("modifier", "NounPremodifier"), Cat("head", "BareNominal")], transparent: ["head"], equations: [Exclude("head.Determination", "Overt")]),
        (name: "QuantifiedNominalPremodifier", lhs: "QuantifiedNominal", rhs: [Cat("modifier", "NounPremodifier"), Cat("head", "QuantifiedNominal")]),
        (name: "BarePrepositionalNominal", lhs: "BareNominalComplement", rhs: [Cat("head", "PrepositionalNominal")], equations: [Require("head.Number", "Singular"), Require("head.Countability", "Count")]),
        // A superlative confers definiteness on its nominal, so the article
        // may go unexpressed without a change of meaning (CGEL, Ch. 13
        // §6.3.4, pp. 1168–1169), here in a bare nominal Complement: *tied
        // for lowest life total*.
        (name: "SuperlativeBareNominal", lhs: "BareNominalComplement", rhs: [Cat("modifier", "AdjectivePhrase"), Cat("head", "BareNominal")], equations: [Require("modifier.Grade", "Superlative"), Require("modifier.ComplementKind", "Intransitive"), Exclude("modifier.AdjectivePosition", "Predicative"), Require("head.Number", "Singular"), Require("head.Countability", "Count")]),
        // A superlative also fuses with the head it would modify (CGEL, Ch. 5
        // §9.3(b), p. 416), its article unexpressed as above: *tied for
        // greatest*, *tied for most common*.
        // A superlative determinative fuses the same way, its article
        // unexpressed: *tied for fewest*.
        (name: "SuperlativeQuantifierFusedHead", lhs: "BareNominalComplement", rhs: [Class("head", "CountSuperlativeQuantifier")]),
        (name: "SuperlativeFusedHead", lhs: "BareNominalComplement", rhs: [Cat("modifier", "AdjectivePhrase")], equations: [Carry("modifier.Grade", "Superlative"), Require("modifier.ComplementKind", "Intransitive"), Exclude("modifier.AdjectivePosition", "Predicative")]),
        // Noun phrases.
        (name: "BareMass", lhs: "NounPhrase", rhs: [Cat("head", "Nominal")],
            equations: [Require("$.Determination", "Bare"), Require("$.Case", "Plain"), Require("head.Countability", "Mass"), Require("head.Number", "Singular"), Require("$.Person", "Third")],
            transparent: ["head"]),
        (name: "SymbolFusedHead", lhs: "FusedNounPhrase", rhs: [Cat("head", "SymbolHead")]),
        (name: "SymbolNominalPhrase", lhs: "SymbolHead", rhs: [Cat("head", "Symbols")], equations: [Require("$.NounKind", "Ordinary"), Require("$.Determination", "Bare"), Require("$.Case", "Plain"), Require("$.Number", "Singular"), Require("$.Person", "Third")]),
        (name: "ProperName", lhs: "NounPhrase", rhs: [Cat("head", "Name")],
            equations: [Require("$.NounKind", "Ordinary"), Require("$.Countability", "Count"), Require("$.Determination", "Bare"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        (name: "Determined", lhs: "NounPhrase", rhs: [Cat("determiner", "DeterminerPhrase"), Cat("head", "Nominal")],
            equations: [Agree("$.DeterminativeDistribution", "determiner.DeterminativeDistribution"), Require("$.Determination", "Overt"), Require("$.Case", "Plain"), Require("$.Person", "Third"), Exclude("determiner.DeterminativeDistribution", "Independent"), Exclude("determiner.DeterminativeDistribution", "FreeChoice"), Exclude("determiner.ComplementKind", "PP"), Agree("determiner.Countability", "head.Countability"), Agree("determiner.Number", "head.Number")]),
        // A distributive determiner over an *and*-coordination of singular
        // nominals makes a singular Noun Phrase (*each creature and
        // planeswalker you control gets ...*; CGEL, Ch. 5 §18.4, p. 508).
        // The nominal child is named `nominal`, not `head`, to keep it out of
        // implicit head agreement: the Noun Phrase takes Number from its
        // distributive determiner (singular), while the *and*-coordination
        // it determines is plural, and Countability, Determination and
        // NounKind are set here, not copied from the coordination. It
        // forgoes the head lexeme in Readings and the head line (CGEL, Ch. 5
        // §18.4, p. 508).
        (name: "DistributiveCoordinationDetermined", lhs: "NounPhrase", rhs: [Cat("determiner", "DeterminerPhrase"), Cat("nominal", "Nominal")],
            equations: [Agree("$.DeterminativeDistribution", "determiner.DeterminativeDistribution"), Require("determiner.DeterminativeDistribution", "Distributive"), Carry("nominal.ConjunctNumber", "Singular"), Require("nominal.Number", "Plural"), Agree("$.Number", "determiner.Number"),
                Agree("determiner.Countability", "nominal.Countability"), Agree("$.NounKind", "nominal.NounKind"), Agree("$.Countability", "nominal.Countability"),
                Require("$.Determination", "Overt"), Require("$.Case", "Plain"), Require("$.Person", "Third")], transparent: ["nominal"]),
        // A singular determiner over an *and*-coordination of singular
        // nominals makes a singular Noun Phrase of joint reference: one
        // entity that each conjunct describes (*our chef and chauffeur has*;
        // *a red, white and blue flag*; *is also a Cleric, Rogue, Warrior,
        // and Wizard*; CGEL, Ch. 5 §18.4, pp. 507–508, [26]–[27]). As in
        // DistributiveCoordinationDetermined, the nominal child is
        // `nominal`, not `head`: the Noun Phrase is singular while the
        // coordination it determines is plural. A distributive determiner
        // is that Production's.
        (name: "JointCoordinationDetermined", lhs: "NounPhrase", rhs: [Cat("determiner", "DeterminerPhrase"), Cat("nominal", "Nominal")],
            equations: [Agree("$.DeterminativeDistribution", "determiner.DeterminativeDistribution"), Carry("determiner.Number", "Singular"), Exclude("determiner.DeterminativeDistribution", "Distributive"), Exclude("determiner.DeterminativeDistribution", "Independent"), Exclude("determiner.DeterminativeDistribution", "FreeChoice"), Exclude("determiner.ComplementKind", "PP"), Carry("nominal.ConjunctNumber", "Singular"), Require("nominal.Number", "Plural"), Require("$.Number", "Singular"),
                Agree("determiner.Countability", "nominal.Countability"), Agree("$.NounKind", "nominal.NounKind"), Agree("$.Countability", "nominal.Countability"),
                Require("$.Determination", "Overt"), Require("$.Case", "Plain"), Require("$.Person", "Third")], transparent: ["nominal"]),
        // A comparative or exceptive quantity determines a count head that
        // agrees with its Complement (*more than one creature*, *all but one
        // +1/+1 counter*), or a mass head of the determinative's Countability
        // (*less than three mana*, *all but 1 life*). A singular noun both
        // count and mass carries no Countability of its own, so it is not a
        // mass head here. In a determiner the standard is a bare quantity
        // (*than* + numeral): a determined standard comes after the head
        // instead (CGEL, Ch. 5 §11(d), p. 432), so *more than the total*
        // determines nothing.
        (name: "ComparativeQuantityCountDetermined", lhs: "NounPhrase", rhs: [Cat("determiner", "DeterminerPhrase"), Cat("head", "Nominal")],
            equations: [Require("determiner.ComplementKind", "PP"), Require("determiner.ObliqueDetermination", "Bare"), Require("head.Countability", "Count"), Agree("determiner.ObliqueNumber", "head.Number"), Agree("determiner.Countability", "head.Countability"), Require("$.Determination", "Overt"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        (name: "ComparativeQuantityMassDetermined", lhs: "NounPhrase", rhs: [Cat("determiner", "DeterminerPhrase"), Cat("head", "Nominal")],
            equations: [Require("determiner.ComplementKind", "PP"), Exclude("determiner.ObliqueKind", "FiniteClause"), Require("determiner.ObliqueDetermination", "Bare"), Carry("head.Countability", "Mass"), Require("head.Number", "Singular"), Agree("determiner.Countability", "head.Countability"), Require("$.Determination", "Overt"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        // Free-choice *any* determines a nominal, but a quantificational noun
        // only without its oblique: with one, the Noun Phrase takes the
        // oblique's Number (*any number of target creatures become ...*).
        (name: "FreeChoiceDetermined", lhs: "NounPhrase", rhs: [Cat("determiner", "DeterminerPhrase"), Cat("head", "Nominal")],
            equations: [Require("determiner.DeterminativeDistribution", "FreeChoice"), Exclude("head.NounDistribution", "Quantity"), Require("$.Determination", "Overt"), Require("$.Case", "Plain"), Require("$.Person", "Third"), Agree("determiner.Countability", "head.Countability"), Agree("determiner.Number", "head.Number")]),
        (name: "FreeChoiceQuantity", lhs: "NounPhrase", rhs: [Cat("determiner", "DeterminerPhrase"), Cat("head", "Nominal")],
            equations: [Require("determiner.DeterminativeDistribution", "FreeChoice"), Require("head.NounDistribution", "Quantity"), Require("head.ComplementKind", "Intransitive"), Require("$.Determination", "Overt"), Require("$.Case", "Plain"), Require("$.Person", "Third"), Agree("determiner.Countability", "head.Countability"), Agree("determiner.Number", "head.Number")]),
        // The nominal child is named `quantity`, not `head`, to keep it out of
        // implicit head agreement: Number and NounKind come from the
        // quantity's oblique (`ObliqueNumber`, `ObliqueNounKind`), not from
        // the quantificational noun itself (CGEL, Ch. 5 §3.3, pp. 349-351). It
        // forgoes the head lexeme in Readings and the head line.
        (name: "TransparentQuantity", lhs: "NounPhrase", rhs: [Cat("determiner", "DeterminerPhrase"), Cat("quantity", "Nominal")],
            equations: [Require("determiner.DeterminativeDistribution", "FreeChoice"), Require("quantity.NounDistribution", "Quantity"), Require("quantity.ComplementKind", "PP"), Require("quantity.ObliqueNumber", "Plural"), Agree("$.Number", "quantity.ObliqueNumber"), Agree("$.NounKind", "quantity.ObliqueNounKind"), Require("$.Determination", "Overt"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        // A Number-transparent quantificational noun gives the Targeting
        // Marker alone in its oblique the oblique's plural (*any number of
        // target creatures*; CGEL, Ch. 5 §3.3, pp. 349–351): the quantity,
        // not the Marker, counts the targets, as an outer determiner does.
        (name: "TargetedQuantity", lhs: "BareNominal", rhs: [FreeLex("head", Noun), Cat("complement", "TargetedOblique")],
            equations: [Require("head.NounDistribution", "Quantity"), Require("$.ComplementKind", "PP"), Require("$.ObliqueKind", "NP"), Agree("$.ObliqueNumber", "complement.Number"), Agree("$.ObliqueNounKind", "complement.NounKind")]),
        (name: "TargetedOblique", lhs: "TargetedOblique", rhs: [Word("head", "Of"), Cat("complement", "TargetedNounPhrase")],
            equations: [Agree("$.Number", "complement.Number"), Agree("$.NounKind", "complement.NounKind")]),
        (name: "TargetedNounPhrase", lhs: "TargetedNounPhrase", rhs: [Cat("determiner", "DeterminerPhrase"), Cat("head", "Nominal")],
            equations: [Carry("determiner.DeterminativeDistribution", "Targeting"), Carry("determiner.Number", "Singular"), Require("head.Number", "Plural"), Require("head.Determination", "Overt"), Agree("determiner.Countability", "head.Countability")]),
        // A free-choice quantity of serial *times* is a frequency Adjunct
        // (*pay {1}{G} any number of times*). As TransparentQuantity, the
        // nominal child is `quantity`, not `head`: Number comes from the
        // oblique, and NounKind is `Temporal` from the oblique, so the
        // head lexeme and the head line are forgone.
        (name: "TemporalQuantity", lhs: "TemporalNounPhrase", rhs: [Cat("determiner", "DeterminerPhrase"), Cat("quantity", "Nominal")],
            equations: [Require("determiner.DeterminativeDistribution", "FreeChoice"), Require("quantity.ComplementKind", "PP"), Require("quantity.ObliqueNumber", "Plural"), Carry("quantity.ObliqueNounKind", "Temporal"), Agree("$.Number", "quantity.ObliqueNumber"), Require("$.NounKind", "Temporal"), Require("$.Determination", "Overt"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        // Bounding frequency also uses a quantified *number of times*,
        // including its postmodifiers (CGEL, Ch. 8 §9, p. 715 n. 19).
        (name: "DeterminedTemporalQuantity", lhs: "TemporalNounPhrase", rhs: [Cat("determiner", "DeterminerPhrase"), Cat("quantity", "Nominal")],
            equations: [Exclude("determiner.DeterminativeDistribution", "FreeChoice"), Require("quantity.NounDistribution", "Quantity"), Require("quantity.ComplementKind", "PP"), Require("quantity.ObliqueNumber", "Plural"), Carry("quantity.ObliqueNounKind", "Temporal"), Agree("determiner.Number", "quantity.Number"), Agree("$.Number", "quantity.ObliqueNumber"), Require("$.NounKind", "Temporal"), Require("$.Determination", "Overt"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        // Ordinary bare plurals have plural count heads, not just the plural
        // Number of a coordination of singular count nominals. A shared
        // determiner belongs outside that coordination and cannot be left
        // behind when its tail becomes a Supplement (CGEL, Ch. 5 §8.5,
        // pp. 409–410; Ch. 15 §3.1, p. 1323; OSG §7, Plurals and agreement).
        // Mass-noun coordinations remain bare; exceptional bare singular
        // expressions are separately licensed, not ordinary bare plurals.
        (name: "BarePlural", lhs: "NounPhrase", rhs: [Cat("head", "Nominal")],
            equations: [Require("$.Determination", "Bare"), Require("$.Case", "Plain"), Require("head.Number", "Plural"), Require("$.Person", "Third"), ExcludeTogether([("head.Countability", "Count"), ("head.ConjunctNumber", "Singular")])]),
        (name: "Pronoun", lhs: "NounPhrase", rhs: [Lex("head", Pronoun)],
            equations: [Require("$.NounKind", "Ordinary"), Require("$.Determination", "Bare"), Exclude("head.Case", "Genitive"), Exclude("head.PronounKind", "Existential"), Exclude("head.PronounKind", "Relative"), Require("head.Inflection", "Invariant")]),
        (name: "IndependentGenitive", lhs: "NounPhrase", rhs: [Lex("pronoun", Pronoun)],
            equations: [Require("$.NounKind", "Ordinary"), Require("$.Determination", "Bare"), Require("$.Case", "Plain"), Require("pronoun.Inflection", "IndependentGenitive"), Require("$.Person", "Third")]),
        (name: "PossessiveDeterminer", lhs: "DeterminerPhrase", rhs: [Lex("possessor", Pronoun)],
            equations: [Require("$.DeterminativeDistribution", "Dependent"), Require("$.ComplementKind", "Intransitive"), Carry("possessor.Case", "Genitive"), Require("possessor.Inflection", "Invariant"), Exclude("possessor.PronounKind", "Relative")]),
        (name: "GenitivePossessor", lhs: "NounPhrase", rhs: [Cat("possessor", "Possessor"), Word("marker", "Genitive")],
            equations: [Require("$.Determination", "Bare"), Require("$.Case", "Genitive"), Carry("possessor.Case", "Plain"), Agree("$.Number", "possessor.Number"), Agree("$.Person", "possessor.Person")]),
        // A genitive in a fused subject-determiner-head is a whole Noun
        // Phrase whose head is understood from an antecedent (*power less
        // than Mirko's*; CGEL, Ch. 5 §16.3, pp. 467–468). Where a nominal
        // right after it can be its head, that Reading ranks first (CGEL,
        // Ch. 17 §6.1, pp. 1516–1517): *during [its controller's next untap
        // step]*.
        (name: "FusedSubjectDeterminerHead", lhs: "NounPhrase", rhs: [Cat("possessor", "Possessor"), Word("marker", "Genitive")],
            equations: [Require("$.NounKind", "Ordinary"), Require("$.Determination", "Overt"), Require("$.Case", "Plain"), Carry("possessor.Case", "Plain"), Require("$.Person", "Third")]),
        (name: "GenitiveDetermined", lhs: "NounPhrase", rhs: [Cat("determiner", "NounPhrase"), Cat("head", "Nominal")],
            equations: [Require("$.Determination", "Overt"), Require("$.Case", "Plain"), Carry("determiner.Case", "Genitive"), Require("$.Person", "Third")]),
        // *its controller's next two untap steps*.
        (name: "GenitiveModifiedQuantity", lhs: "NounPhrase", rhs: [Cat("determiner", "NounPhrase"), Cat("head", "ModifiedQuantifiedNominal")],
            equations: [Carry("determiner.Case", "Genitive"), Agree("$.Number", "head.QuantityNumber"), Require("$.Countability", "Count"), Require("$.Determination", "Overt"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        // A property noun's comparative bound is the postpositive
        // comparative adjective's (*mana value less than X*), never its
        // Amount Complement.
        (name: "Unmodified", lhs: "Nominal", rhs: [Cat("head", "BareNominal")], equations: [Agree("$.ConjunctNumber", "$.Number"), ExcludeTogether([("head.ComplementKind", "Amount"), ("head.ObliqueKind", "PP")])], transparent: ["head"]),
        // The Targeting Marker is a determiner on its own (*target creature*),
        // singular as the lexicon gives it; after an adjective (*other target
        // creatures*, *second target*); or the last word of a determiner with
        // an outer one, which marks it and gives it its Number (*two target
        // creatures*, *each other target creature*, *up to one target
        // artifact or creature you control*). The nominal it determines takes
        // every modifier below it (CGEL, Ch. 5, pp. 330–332).
        (name: "BareTargetingMarker", lhs: "TargetingMarker", rhs: [Cat("head", "DeterminerPhrase")],
            equations: [Carry("head.DeterminativeDistribution", "Targeting")]),
        (name: "ModifiedTargetingMarker", lhs: "DeterminerPhrase", rhs: [Cat("modifier", "AdjectivePhrase"), Cat("head", "TargetingMarker")],
            equations: [Require("$.ComplementKind", "Intransitive"), Require("modifier.ComplementKind", "Intransitive"), Exclude("modifier.AdjectivePosition", "Predicative")]),
        (name: "MarkedDeterminer", lhs: "DeterminerPhrase", rhs: [Cat("determiner", "DeterminerPhrase"), Cat("head", "TargetingMarker")],
            equations: [Exclude("determiner.ComplementKind", "PP"), Agree("$.Number", "determiner.Number")]),
        (name: "MarkedMaximum", lhs: "DeterminerPhrase", rhs: [Selected("determiner", "PrepositionPhrase", ["Up"]), Cat("head", "TargetingMarker")], uncoordinated: ["determiner"],
            equations: [Require("determiner.Determination", "Bare"), Agree("$.Number", "determiner.Number")]),
        // An adjective that needs an overt determiner, as an ordinal does,
        // passes that need to its nominal (*the only creature you control*,
        // *the first creature*).
        (name: "Premodifier", lhs: "BareNominal", rhs: [Cat("modifier", "AdjectivePhrase"), Cat("head", "BareNominal")], transparent: ["head"], equations: [Require("modifier.ComplementKind", "Intransitive"), Agree("modifier.Determination", "$.Determination"), Exclude("modifier.AdjectivePosition", "Predicative")]),
        // An attributive adjective before an *and*-coordination of singular
        // nominals may modify the whole coordination (*long [poems and
        // essays]*; CGEL, Ch. 15 §1.3.4, pp. 1285–1286, [32b]), as well as its
        // first conjunct: *[total [power and toughness 5 or less]]*. A
        // nominal's Complement is inside its premodifiers, so a shared Amount
        // is too.
        (name: "CoordinationPremodifier", lhs: "Nominal", rhs: [Cat("modifier", "AdjectivePhrase"), Cat("head", "Nominal")],
            equations: [Require("modifier.ComplementKind", "Intransitive"), Agree("modifier.Determination", "$.Determination"), Exclude("modifier.AdjectivePosition", "Predicative"), Require("head.Number", "Plural"), Carry("head.ConjunctNumber", "Singular")]),
        (name: "DeterminedPossessor", lhs: "Possessor", rhs: [Cat("determiner", "DeterminerPhrase"), Cat("head", "BareNominal")],
            equations: [Require("$.Case", "Plain"), Require("$.Person", "Third"), Agree("determiner.Countability", "head.Countability"), Agree("determiner.Number", "head.Number")]),
        (name: "CoordinatedPossessor", lhs: "Possessor", rhs: [Cat("determiner", "DeterminerPhrase"), Cat("head", "PossessorNominals")],
            equations: [Require("$.Case", "Plain"), Require("$.Person", "Third"), Agree("determiner.Countability", "head.Countability"), Agree("determiner.Number", "head.Number")]),
        (name: "GenitiveConjunct", lhs: "GenitiveNominal", rhs: [Cat("head", "BareNominal"), Word("marker", "Genitive")]),
        (name: "MultipleGenitive", lhs: "NounPhrase", rhs: [Cat("determiner", "DeterminerPhrase"), Cat("head", "GenitiveNominals")],
            equations: [Require("$.Determination", "Bare"), Require("$.Case", "Genitive"), Require("$.Person", "Third"), Agree("determiner.Countability", "head.Countability"), Agree("determiner.Number", "head.Number")]),
        (name: "GenitiveDeterminedPossessor", lhs: "Possessor", rhs: [Cat("determiner", "NounPhrase"), Cat("head", "BareNominal")], equations: [Carry("determiner.Case", "Genitive"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        // *up to one target player's life total*.
        (name: "MaximumPossessor", lhs: "Possessor", rhs: [Selected("determiner", "PrepositionPhrase", ["Up"]), Cat("head", "BareNominal")],
            equations: [Require("determiner.Determination", "Bare"), Agree("determiner.Number", "head.Number"), Require("head.Countability", "Count"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        (name: "PluralPossessor", lhs: "Possessor", rhs: [Cat("head", "BareNominal")],
            equations: [Require("$.Case", "Plain"), Require("head.Number", "Plural"), Require("$.Person", "Third")]),
        (name: "ProperPossessor", lhs: "Possessor", rhs: [Cat("head", "Name")], equations: [Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        // A postmodifier agrees with each conjunct of an *and*-coordinated
        // nominal: under distributive *each* it is singular (*each creature and
        // planeswalker that is tapped*; CGEL, Ch. 5 §18.4, p. 508).
        (name: "NominalPostmodifier", lhs: "Nominal", rhs: [Cat("head", "Nominal"), Cat("modifier", "Postmodifier")],
            equations: [Agree("head.ConjunctNumber", "modifier.Number"), Agree("head.NounKind", "modifier.NounKind")]),
        // A Postmodifier follows a quantity's premodifiers (*the next 3 damage
        // that would be dealt*).
        (name: "QuantifiedPostmodifier", lhs: "ModifiedQuantifiedNominal", rhs: [Cat("head", "QuantifiedNominal"), Cat("modifier", "Postmodifier")],
            equations: [Agree("head.QuantityNumber", "modifier.Number"), Agree("head.NounKind", "modifier.NounKind")]),
        (name: "ModifiedQuantifiedPostmodifier", lhs: "ModifiedQuantifiedNominal", rhs: [Cat("head", "ModifiedQuantifiedNominal"), Cat("modifier", "Postmodifier")],
            equations: [Agree("head.QuantityNumber", "modifier.Number"), Agree("head.NounKind", "modifier.NounKind")]),
        // In Oracle English only a marked relative follows a fused head (*one
        // that hasn't been chosen*).
        (name: "FusedPostmodifier", lhs: "FusedNounPhrase", rhs: [Cat("head", "FusedNounPhrase"), Cat("modifier", "RelativeClause")],
            equations: [Require("modifier.ClauseMarking", "Relative"), Agree("head.Number", "modifier.Number")]),
        // A subjectless participial clause can modify a partitive fused head
        // too (*one of them chosen at random*; CGEL, Ch. 5 §9.1, p. 411;
        // Ch. 14 §9, pp. 1264–1265; OSG §5, This way).
        (name: "FusedParticipialPostmodifier", lhs: "FusedNounPhrase", rhs: [Cat("head", "FusedNounPhrase"), Cat("modifier", "VerbPhrase")],
            equations: [Require("modifier.VerbForm", "PastParticiple"), Require("modifier.Voice", "Passive"), Exclude("modifier.VerbKind", "Auxiliary")], heavy: ["modifier"], cost: 1),
        (name: "PrepositionalConjunct", lhs: "PostmodifierConjunct", rhs: [Hosted("filler", "PrepositionPhrase", Nominal)], equations: [Require("$.ComplementKind", "PP")]),
        (name: "NominalObjectConjunct", lhs: "ObjectConjunct", rhs: [Cat("filler", "ComplementNounPhrase")], equations: [Require("$.ComplementKind", "NP")]),
        (name: "KeywordObjectConjunct", lhs: "ObjectConjunct", rhs: [Cat("filler", "KeywordPhrase")], equations: [Require("$.ComplementKind", "KeywordPhrase")]),
        // A slash measure names a +X/+Y counter's kind as a keyword names a
        // keyword counter's [CR#122.1a,122.1b], beside keywords (*a kind of
        // counter ... from among flying, first strike, ..., and +1/+1*).
        (name: "MeasureObjectConjunct", lhs: "ObjectConjunct", rhs: [Cat("filler", "MeasureNounPhrase")], equations: [Require("$.ComplementKind", "MeasureNP")]),
        // A quoted ability beside a keyword (*has reach and "…"*).
        (name: "QuotedObjectConjunct", lhs: "ObjectConjunct", rhs: [Cat("filler", "QuotedAbility")], equations: [Require("$.ComplementKind", "QuotedAbility")]),
        (name: "AmountConjunct", lhs: "AmountOrNounConjunct", rhs: [Cat("filler", "Amount")], equations: [Require("$.ComplementKind", "Amount")]),
        (name: "NounPhraseConjunct", lhs: "AmountOrNounConjunct", rhs: [Cat("filler", "ComplementNounPhrase")], equations: [Require("$.ComplementKind", "NP")]),
        (name: "CoordinatedObject", lhs: "ComplementNounPhrase", rhs: [Cat("filler", "ObjectCoordination")]),
        (name: "AffirmativeConjunct", lhs: "ContrastConjunct", rhs: [Cat("filler", "ComplementNounPhrase")], equations: [Require("$.Polarity", "Affirmative")]),
        (name: "NegatedConjunct", lhs: "ContrastConjunct", rhs: [Word("modifier", "Not"), Cat("filler", "ComplementNounPhrase")], equations: [Require("$.Polarity", "Negative")]),
        (name: "ContrastedComplement", lhs: "ComplementNounPhrase", rhs: [Cat("filler", "ContrastCoordination")]),
        (name: "AffirmativePrepositionConjunct", lhs: "ContrastPrepositionConjunct", rhs: [Cat("head", "PrepositionPhrase")], equations: [Require("$.Polarity", "Affirmative")]),
        (name: "NegatedPrepositionConjunct", lhs: "ContrastPrepositionConjunct", rhs: [Word("modifier", "Not"), Cat("head", "PrepositionPhrase")], equations: [Require("$.Polarity", "Negative")]),
        (name: "ContrastedPrepositionPhrase", lhs: "PrepositionPhrase", rhs: [Cat("head", "ContrastPrepositionCoordination")]),
        (name: "AdjectivalConjunct", lhs: "PostmodifierConjunct", rhs: [Cat("filler", "AdjectivePhrase")], equations: [Exclude("filler.Voice", "Passive"), Require("$.ComplementKind", "AdjP")], heavy: ["filler"]),
        // A past-participial conjunct is a lexical passive participle clause
        // (CGEL, Ch. 14 §9, p. 1264), as the single participial postmodifier
        // is, never one headed by an auxiliary (*been* + participle): in a
        // passive the auxiliary takes the participle (Ch. 16 §10.1.1,
        // p. 1427).
        (name: "PastParticipialConjunct", lhs: "PostmodifierConjunct", rhs: [Cat("filler", "VerbPhrase")], equations: [Require("filler.VerbForm", "PastParticiple"), Require("filler.Voice", "Passive"), Exclude("filler.VerbKind", "Auxiliary"), Require("$.ComplementKind", "Gerund")], heavy: ["filler"]),
        (name: "GerundParticipialConjunct", lhs: "PostmodifierConjunct", rhs: [Cat("filler", "VerbPhrase")], equations: [Require("filler.VerbForm", "GerundParticiple"), Require("$.ComplementKind", "Gerund")], heavy: ["filler"]),
        (name: "CoordinatedPostmodifier", lhs: "Nominal", rhs: [Cat("head", "Nominal"), Cat("modifier", "PostmodifierCoordination")], cost: 1),
        (name: "RelativePostmodifier", lhs: "Postmodifier", rhs: [Cat("head", "RelativeClause")]),
        // A participial clause with dependents (*each creature tapped this
        // way*, *a card exiled with ...*). A single postpositive participle
        // ranks behind it (CGEL, Ch. 5 §14.2, p. 445), and is never one whose
        // Adjectival Passive is a declared Adjective: bare *tapped* is that
        // Adjective. A past-participial postmodifier is a bare passive, with
        // neither *be* nor *get*, so the auxiliary *been* never heads one
        // (CGEL, Ch. 14 §9, pp. 1264–1265; Ch. 16 §10.1.1, pp. 1429–1430).
        (name: "ParticipialPostmodifier", lhs: "Postmodifier", rhs: [Cat("head", "VerbPhrase")],
            equations: [Require("head.VerbForm", "PastParticiple"), Require("head.Voice", "Passive"), Exclude("head.VerbKind", "Auxiliary")], heavy: ["head"], cost: 1),
        (name: "GerundParticipialPostmodifier", lhs: "Postmodifier", rhs: [Cat("head", "VerbPhrase")],
            equations: [Require("head.VerbForm", "GerundParticiple")], heavy: ["head"], cost: 1),
        // A single participle postmodifies the bare nominal, outside its
        // premodifiers and inside any relative clause (*creatures entering*,
        // *a creature dying*). A past participle here is a bare passive too,
        // never the auxiliary *been* (CGEL, Ch. 14 §9, pp. 1264–1265).
        (name: "SingleParticipialPostmodifier", lhs: "Nominal", rhs: [Cat("head", "BareNominal"), Cat("modifier", "VerbPhrase")],
            equations: [Agree("$.ConjunctNumber", "$.Number"), Require("modifier.VerbForm", "PastParticiple"), Require("modifier.Voice", "Passive"), Exclude("modifier.AdjectivalPassive", "Lexical"), Exclude("modifier.VerbKind", "Auxiliary")], light: ["modifier"], cost: 3),
        (name: "SingleGerundParticipialPostmodifier", lhs: "Nominal", rhs: [Cat("head", "BareNominal"), Cat("modifier", "VerbPhrase")],
            equations: [Agree("$.ConjunctNumber", "$.Number"), Require("modifier.VerbForm", "GerundParticiple")], light: ["modifier"], cost: 3),
        // Relative clauses (CGEL, Ch. 12 §3). A bare relative is a finite
        // clause with an object Gap; *that* or a relative pronoun may also
        // introduce a subject Gap, which agrees with the antecedent.
        (name: "BareRelative", lhs: "RelativeClause", rhs: [Cat("clause", "SubjectInitialClause")],
            equations: [Require("$.ClauseMarking", "Unmarked"), Require("clause.Gap", "NP"), Require("clause.VerbForm", "Finite")]),
        // A bare relative whose Gap is a subjective predicative (*the
        // permanent it becomes*, *a color the other isn't*, *the number of
        // colors that spell is*; CGEL, Ch. 12 §3.3(c), p. 1045; §3.5.4(g),
        // p. 1054), of an ordinary head.
        (name: "BarePredicativeRelative", lhs: "RelativeClause", rhs: [Cat("clause", "SubjectInitialClause")],
            equations: [Require("$.ClauseMarking", "Unmarked"), Require("$.NounKind", "Ordinary"), Require("clause.Gap", "Pred"), Require("clause.VerbForm", "Finite")], cost: 3),
        // A bare relative's Clause is a Subject and its Predicate, as a
        // declarative's that can pass up a Gap (*SubjectPredicate*,
        // *CliticSubjectPredicate*, *FloatedEach*, *FloatedAll*), never one
        // with a preposed adjunct: "Bare relatives always have the subject in
        // initial position" (CGEL, Ch. 12 §3.5.5, p. 1055).
        // Each of the four Productions below restates its Clause twin and
        // differs from it only in having no `$.ClauseMarking` equation, so a
        // change to a twin must be made to its restatement, and conversely:
        // RelativeSubjectPredicate / SubjectPredicate, RelativeCliticSubjectPredicate
        // / CliticSubjectPredicate, RelativeFloatedEach / FloatedEach,
        // RelativeFloatedAll / FloatedAll. (SubjectInitialCoordination
        // coordinates SubjectInitialClauses: two bare relatives under one
        // head, as in Serum Powder's *Any time you could mulligan and this
        // card is in your hand*.)
        (name: "RelativeSubjectPredicate", lhs: "SubjectInitialClause", rhs: [Cat("subject", "NounPhrase"), Free("head", "VerbPhrase")],
            equations: [Agree("subject.Number", "head.Number"), Agree("subject.Person", "head.Person"), Require("head.VerbForm", "Finite"), Exclude("subject.Case", "Accusative"), Exclude("subject.Case", "Genitive")],
            transparent: ["head"]),
        (name: "RelativeCliticSubjectPredicate", lhs: "SubjectInitialClause", rhs: [Cat("subject", "NounPhrase"), Attached("head", "VerbPhrase", Suffix)],
            equations: [Agree("subject.Number", "head.Number"), Agree("subject.Person", "head.Person"), Require("head.VerbForm", "Finite"), Require("subject.Case", "Nominative")],
            transparent: ["head"]),
        (name: "RelativeFloatedEach", lhs: "SubjectInitialClause", rhs: [Cat("subject", "NounPhrase"), Class("adjunct", "FloatingQuantifier"), Cat("head", "VerbPhrase")],
            equations: [ExcludeTogether([("subject.Number", "Singular"), ("subject.Person", "Third")]), Exclude("subject.Case", "Accusative"), Agree("subject.Number", "head.Number"), Agree("subject.Person", "head.Person"), Require("head.VerbForm", "Finite")], transparent: ["head"]),
        (name: "RelativeFloatedAll", lhs: "SubjectInitialClause", rhs: [Cat("subject", "NounPhrase"), Word("adjunct", "All"), Cat("head", "VerbPhrase")],
            equations: [Require("subject.Number", "Plural"), Require("subject.Case", "Nominative"), Agree("subject.Number", "head.Number"), Agree("subject.Person", "head.Person"), Require("head.VerbForm", "Finite")], transparent: ["head"]),
        (name: "MarkedRelative", lhs: "RelativeClause", rhs: [Class("marker", "RelativeMarker"), Cat("clause", "Clause")],
            equations: [Require("$.ClauseMarking", "Relative"), Require("clause.Gap", "NP"), Require("clause.VerbForm", "Finite"), Exclude("marker.Case", "Nominative"), Exclude("marker.Case", "Genitive")]),
        (name: "SubjectRelative", lhs: "RelativeClause", rhs: [Class("marker", "RelativeMarker"), Cat("clause", "SubjectGapClause")],
            equations: [Require("$.ClauseMarking", "Relative"), Require("clause.Gap", "NP"), Agree("$.Number", "clause.Number"), Agree("marker.Number", "clause.Number"), Exclude("marker.Case", "Accusative"), Exclude("marker.Case", "Genitive")]),
        (name: "SubjectGap", lhs: "SubjectGapClause", rhs: [Cat("head", "VerbPhrase")],
            equations: [Require("head.VerbForm", "Finite"), Require("head.Person", "Third"), Exclude("head.Inflection", "Irrealis"), Require("$.Gap", "NP")]),
        // The plural Requirement already keeps out the irrealis *were*, which
        // is third person singular only (CGEL, Ch. 3 §1.5, pp. 85–88), so this
        // needs no Exclude of SubjectGap's.
        (name: "FloatedEachSubjectGap", lhs: "SubjectGapClause", rhs: [Class("adjunct", "FloatingQuantifier"), Cat("head", "VerbPhrase")],
            equations: [Require("head.VerbForm", "Finite"), Require("head.Number", "Plural"), Require("head.Person", "Third"), Require("$.Gap", "NP")]),
        // *whose*: the relative phrase is the Subject or fills an object Gap.
        (name: "GenitiveRelativePhrase", lhs: "RelativeNounPhrase", rhs: [Lex("determiner", Pronoun), Cat("head", "Nominal")],
            equations: [Require("determiner.PronounKind", "Relative"), Carry("determiner.Case", "Genitive")]),
        (name: "GenitiveSubjectRelative", lhs: "RelativeClause", rhs: [Cat("marker", "RelativeNounPhrase"), Cat("clause", "SubjectGapClause")],
            equations: [Require("$.ClauseMarking", "Relative"), Require("clause.Gap", "NP"), Agree("marker.Number", "clause.Number")]),
        (name: "GenitiveRelative", lhs: "RelativeClause", rhs: [Cat("marker", "RelativeNounPhrase"), Cat("clause", "Clause")],
            equations: [Require("$.ClauseMarking", "Relative"), Require("clause.Gap", "NP"), Require("clause.VerbForm", "Finite")]),
        (name: "GenitivePredicativeRelative", lhs: "RelativeClause", rhs: [Cat("marker", "RelativeNounPhrase"), Cat("clause", "Clause")],
            equations: [Require("$.ClauseMarking", "Relative"), Require("clause.Gap", "Pred"), Require("clause.VerbForm", "Finite")]),
        // A relative phrase may be a Preposition Phrase fronted with its
        // relative pronoun (*for which*; CGEL, Ch. 12 §3.2.1, p. 1040).
        (name: "PrepositionRelativePhrase", lhs: "RelativePrepositionPhrase", rhs: [Lex("head", Preposition), Lex("complement", Pronoun)],
            equations: [Require("complement.PronounKind", "Relative"), Exclude("complement.Case", "Nominative"), Exclude("complement.Case", "Genitive")]),
        (name: "PrepositionalRelative", lhs: "RelativeClause", rhs: [Cat("marker", "RelativePrepositionPhrase"), Cat("clause", "AdjunctGapClause")],
            equations: [Require("$.ClauseMarking", "Relative"), Require("clause.Gap", "Adjunct")]),
        // A fused relative is a Noun Phrase (CGEL, Ch. 12 §6, p. 1068).
        (name: "FusedSubjectRelative", lhs: "NounPhrase", rhs: [Word("head", "Whichever"), Cat("clause", "SubjectGapClause")],
            equations: [Require("clause.Gap", "NP"), Require("$.NounKind", "Ordinary"), Require("$.Determination", "Bare"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        (name: "FusedRelative", lhs: "NounPhrase", rhs: [Word("head", "Whichever"), Cat("clause", "Clause")],
            equations: [Require("clause.Gap", "NP"), Require("clause.VerbForm", "Finite"), Require("$.NounKind", "Ordinary"), Require("$.Determination", "Bare"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        // An adverbial relative: its Gap is a temporal Adjunct (*the next time
        // you cast a spell*; CGEL, Ch. 12 §3.3(e), p. 1045).
        // It is bare, so its Clause too opens with its Subject: *the first
        // time [each turn, those coins come up heads]* is no adverbial
        // relative.
        (name: "AdverbialRelative", lhs: "RelativeClause", rhs: [Cat("clause", "SubjectInitialClause")],
            equations: [Require("$.ClauseMarking", "Unmarked"), Require("clause.Gap", "Adjunct"), Require("$.NounKind", "Temporal")]),
        (name: "CoordinatedAdverbialRelative", lhs: "RelativeClause", rhs: [Cat("clause", "SubjectInitialCoordination")],
            equations: [Require("$.ClauseMarking", "Unmarked"), Require("clause.Gap", "Adjunct"), Require("$.NounKind", "Temporal")]),
        // Restates AdjunctGap over SubjectInitialClause; a change to one must
        // be made to the other.
        (name: "RelativeAdjunctGap", lhs: "SubjectInitialClause", rhs: [Cat("head", "SubjectInitialClause")],
            equations: [Require("$.Gap", "Adjunct")]),
        // Restated as RelativeAdjunctGap; a change to one must be made to the
        // other.
        (name: "AdjunctGap", lhs: "AdjunctGapClause", rhs: [Cat("head", "Clause")],
            equations: [Require("head.VerbForm", "Finite"), Require("$.Gap", "Adjunct")]),
        // A marked relative clause postposed past a predicate adjunct, at the
        // end of the clause containing its Antecedent, the Object that fills
        // the head's Gap (*Choose a card at random that was exiled with ...*;
        // CGEL, Ch. 12 §4, p. 1066). It ranks behind the relative clause in
        // place.
        (name: "PostposedRelative", lhs: "VerbPhrase", rhs: [Cat("head", "VerbPhrase"), Cat("object", "ComplementNounPhrase"), Hosted("adjunct", "PrepositionPhrase", Predicate), Cat("modifier", "RelativeClause")],
            equations: [Require("head.Gap", "NP"), Require("modifier.ClauseMarking", "Relative"), Agree("object.Number", "modifier.Number")], cost: 5),
        // A bare relative postposes only past an adjectival Complement (*at
        // random*), which has no noun of its own to modify in place.
        (name: "PostposedBareRelative", lhs: "VerbPhrase", rhs: [Cat("head", "VerbPhrase"), Cat("object", "ComplementNounPhrase"), Hosted("adjunct", "PrepositionPhrase", Predicate), Cat("modifier", "RelativeClause")],
            equations: [Require("head.Gap", "NP"), Require("adjunct.ComplementKind", "AdjP"), Require("modifier.ClauseMarking", "Unmarked"), Agree("object.Number", "modifier.Number")], heavy: ["modifier"], cost: 2),
        // Postposing separates an Object from its participial postmodifier
        // by a manner PP (*a card at random exiled with ...*; OSG §10,
        // Ordinary choices; CGEL, Ch. 14 §9, pp. 1264–1265; Ch. 16 §4,
        // pp. 1382–1384). The modifier is a bare passive, not an auxiliary.
        (name: "PostposedParticipialModifier", lhs: "VerbPhrase", rhs: [Cat("head", "VerbPhrase"), Cat("object", "ComplementNounPhrase"), Hosted("adjunct", "PrepositionPhrase", Predicate), Cat("modifier", "VerbPhrase")],
            equations: [Require("head.Gap", "NP"), Require("adjunct.ComplementKind", "AdjP"), Require("modifier.VerbForm", "PastParticiple"), Require("modifier.Voice", "Passive"), Exclude("modifier.VerbKind", "Auxiliary")], heavy: ["modifier"], cost: 2),
        // A postpositive equative Adjective Phrase with its own Complement,
        // the amount of the Object, postposed out of it past the verb's
        // selected Complements (*deals damage to any target equal to …*,
        // *put a number of counters on it equal to …*; CGEL, Ch. 5 §14.2,
        // p. 445; Ch. 12 §4, p. 1066). Oracle gives an Object's amount with
        // *equal to* in place or postposed (`docs/oracle-style-guide.md`
        // §12, "Damage"). Its Object is in plain case, as a
        // Nominal is: a personal pronoun takes no such Modifier. It ranks
        // behind the Adjective Phrase in place.
        (name: "PostposedAdjective", lhs: "PostposedModifier", rhs: [Cat("head", "AdjectivePhrase")],
            equations: [Require("head.ComplementKind", "PP"), Carry("head.Grade", "Equative"), Exclude("head.Voice", "Passive"), Require("$.Case", "Plain")], heavy: ["head"], cost: 5),

        // Clause Complements of a Preposition (CGEL, Ch. 7 §1, pp. 599–600):
        // a finite Clause (*when this creature enters*), or a reducible
        // verbless Clause without its Subject (*if able*; Ch. 14 §10(b), p. 1267).
        // A sole connective links instructions and main clauses, never
        // subordinate ones (CGEL, Ch. 15 §2.10, p. 1320; `docs/oracle-style-
        // guide.md` §10, Sequence: "`Then` orders instructions"): *until
        // [they exile a nonland card], then you may cast it*, never *until
        // [they exile a nonland card, then you may cast it]*.
        (name: "FiniteComplementClause", lhs: "FiniteClause", rhs: [Cat("head", "Clause")],
            equations: [Require("head.VerbForm", "Finite")], unlinked: ["head"]),
        // Expandable declarative content clauses permit *that*; their lexical
        // governors select this Category instead of the non-expandable one
        // (CGEL, Ch. 11 §4.8, p. 971; OSG §12, Copies).
        (name: "UnmarkedExpandableClause", lhs: "ExpandableClause", rhs: [Cat("head", "FiniteClause")]),
        (name: "MarkedExpandableClause", lhs: "ExpandableClause", rhs: [Word("marker", "ContentMarker"), Cat("head", "FiniteClause")]),
        // A Clause, or a coordination of Clauses, set off by a dash, giving
        // the content of the Object before it, as a content-specifying
        // Supplement does (*Kate's proposal – to dismiss the manager –*;
        // CGEL, Ch. 14 §9, p. 1266; Ch. 15 §5.1, pp. 1350–1351), where a
        // head's frame selects one: the options of a villainous choice
        // [CR#701.55a], each capitalized after the dash
        // (`docs/oracle-style-guide.md` §14, Keyword actions in sentences).
        // The sentence end absorbs its closing dash, so nothing but the
        // period follows it (CGEL, Ch. 20 §5, p. 1751).
        (name: "SetOffComplementClause", lhs: "SetOffClause", rhs: [Mark('—', Free), Cat("head", "Clause")],
            equations: [Require("head.ClauseMarking", "Unmarked"), Exclude("head.Inflection", "Irrealis")], unclosed: true),
        (name: "VerblessComplementClause", lhs: "VerblessClause", rhs: [Cat("head", "Predicative")]),
        // A passive participle with a Preposition Phrase Adjunct is verbal
        // (*if tapped for mana*), where the bare participle is the Adjectival
        // Passive that AdjectivalPredicative reads (*if tapped*, *if
        // sacrificed*): each string has one tree. A verbless clause takes no
        // such Adjunct of its own, for *unless you control another Ally* in
        // *attacks each combat if able unless ...* belongs to the clause
        // outside *if able* (CGEL, Ch. 14 §10(b), p. 1267; the verb's Adjunct,
        // Ch. 8 §20.1, pp. 779-781).
        (name: "ParticipialVerblessClause", lhs: "VerblessClause", rhs: [Cat("head", "VerbPhrase"), Cat("adjunct", "PrepositionPhrase")],
            equations: [Require("head.VerbForm", "PastParticiple"), Require("head.Voice", "Passive"), Exclude("head.VerbKind", "Auxiliary")], cost: 1),
        // The Absolute Clause Complement of *with* and *without*: a Subject
        // and a past-participial predicate (*with your hand revealed*; CGEL,
        // Ch. 14 §8.3, p. 1262, and §10(a), p. 1267). Its Subject is never
        // nominative (*with them tapped*).
        (name: "PastParticipialAbsolute", lhs: "AbsoluteClause", rhs: [Cat("subject", "ComplementNounPhrase"), Cat("head", "VerbPhrase")],
            equations: [Require("head.VerbForm", "PastParticiple"), Require("head.Voice", "Passive"), Exclude("head.VerbKind", "Auxiliary")]),

        // Interrogative content clauses: closed (*whether ...*), with an
        // interrogative phrase as Subject (*which creatures attack*) or filling
        // a Gap (*which number you chose*), or with an interrogative adverb
        // (*how each player votes*; CGEL, Ch. 11 §5.1, pp. 972–973).
        (name: "ClosedInterrogative", lhs: "InterrogativeClause", rhs: [Word("marker", "Whether"), Cat("clause", "Clause")],
            equations: [Require("clause.VerbForm", "Finite")]),
        (name: "ClosedInfinitivalInterrogative", lhs: "InterrogativeClause", rhs: [Word("marker", "Whether"), Cat("clause", "Clause")],
            equations: [Require("clause.ClauseMarking", "To")]),
        (name: "InterrogativeDeterminer", lhs: "InterrogativePhrase", rhs: [Word("determiner", "Which"), Cat("head", "Nominal")],
            equations: [Require("$.Person", "Third")]),
        // *How many* / *how much* determine an interrogative phrase as
        // *which* does (*note how many cards you've drafted*).
        (name: "DegreeInterrogativeDeterminer", lhs: "InterrogativePhrase", rhs: [Word("degree", "How"), Class("determiner", "DegreeQuantifier"), Cat("head", "Nominal")],
            equations: [Agree("determiner.Number", "head.Number"), Agree("determiner.Countability", "head.Countability"), Require("$.Person", "Third")]),
        (name: "SubjectInterrogative", lhs: "InterrogativeClause", rhs: [Cat("subject", "InterrogativePhrase"), Cat("head", "VerbPhrase")],
            equations: [Agree("subject.Number", "head.Number"), Agree("subject.Person", "head.Person"), Require("head.VerbForm", "Finite")]),
        (name: "GapInterrogative", lhs: "InterrogativeClause", rhs: [Cat("marker", "InterrogativePhrase"), Cat("clause", "Clause")],
            equations: [Require("clause.Gap", "NP"), Require("clause.VerbForm", "Finite")]),
        (name: "AdverbialInterrogative", lhs: "InterrogativeClause", rhs: [Word("marker", "How"), Cat("clause", "AdjunctGapClause")],
            equations: [Require("clause.Gap", "Adjunct")]),

        // Fused distributive *each* is an implicit partitive (CGEL, Ch. 5
        // §9.3, p. 413) that quantifies the members of a set (Ch. 5 §5,
        // p. 358): it is never a predicative Complement, and *are each equal
        // to 2* has floated *each* (Ch. 5 §10.1.1, p. 428), never *are
        // [each]*.
        (name: "NominalPredicative", lhs: "Predicative", rhs: [Cat("head", "NounPhrase")], equations: [Exclude("head.Case", "Genitive"), ExcludeTogether([("head.DeterminativeDistribution", "Distributive"), ("head.NounKind", "Quantity")])]),
        // A predicative Preposition Phrase could also modify a nominal.
        (name: "PrepositionalPredicative", lhs: "Predicative", rhs: [Hosted("head", "PrepositionPhrase", Nominal)]),
        (name: "AdjectivalPredicative", lhs: "Predicative", rhs: [Cat("head", "AdjectivePhrase")], equations: [Exclude("head.AdjectivePosition", "Attributive")]),

    ],
    schemas: [
        // Central Preposition Phrase adjuncts in a bare infinitival (*may
        // instead draw a card*; CGEL, Ch. 8 §20.1, pp. 779–781). Imperative
        // front position is supplied by the Clause adjunct schema.
        Adjunct(host: "BareInf", adjunct: "PrepositionPhrase", side: Before, host_kind: Predicate, cost: 1, equations: [Require("adjunct.ComplementKind", "Intransitive")]),
        // Finite and participial central position; plain-form imperative
        // front position remains the Clause schema's (same reference).
        Adjunct(host: "VerbPhrase", adjunct: "PrepositionPhrase", side: Before, host_kind: Predicate, cost: 1, equations: [Require("adjunct.ComplementKind", "Intransitive"), Exclude("head.VerbForm", "Plain")]),
        // A past participle spelled like a declared Adjective (*tapped*) has
        // that Adjective as its Adjectival Passive, which premodifies in its
        // place.
        Premodification(head: Verb, modifier: "Participle", host: "BareNominal", forms: [GerundParticiple, PastParticiple],
            equations: [(PastParticiple, [Exclude("head.AdjectivalPassive", "Lexical")])]),
        Parameters(head: Noun, phrase: "IndexedNominal"),
        Parameters(head: Keyword, phrase: "KeywordParameters", binding: Some(Free), coordinators: Some("Coordinator"), remnant: Some("ParameterRemnant")),
        Parameters(head: Keyword, phrase: "BoundKeyword", binding: Some(Suffix)),
        // The Internalised Complement is *by* plus a Noun Phrase, the
        // active's Subject (CGEL, Ch. 16 §10.1.1, p. 1428). An amount, a
        // fused-head quantity or a symbol after *by* is also an extent, which
        // *reduce* and *increase* select (*reduced by {2}*, *increased by
        // two*; Ch. 8 §5.2, p. 692): both Readings are well-formed, and
        // semantics rejects the agent one by type (`docs/decisions/english-v4.md`
        // §4.4, principle 1). A *by* gerund is a means Adjunct (p. 1428).
        // Voice is a verb's: another head's phrase takes its Voice from the
        // head (a declared Adjectival Passive). A passive is headed by a past
        // participle. An auxiliary verb derives no
        // prepositional passive and no Adjectival Passive, nor does a verb
        // whose Adjectival Passive is a declared Adjective (*tapped*), which
        // stands in its place; an Adjectival Passive is predicative.
        Valence(head: Verb, phrase: "VerbPhrase",
            active: [Require("$.Voice", "Active")],
            passive: Some("By"),
            verbal_passive: [Require("$.Voice", "Passive"), Require("$.VerbForm", "PastParticiple")],
            prepositional_passive: [Require("$.Voice", "Passive"), Require("$.VerbForm", "PastParticiple"), Exclude("head.VerbKind", "Auxiliary")],
            internalised: [Require("internalised.ComplementKind", "NP")],
            adjectival: Some("AdjectivePhrase"),
            adjectival_passive: [Require("head.VerbForm", "PastParticiple"), Require("$.AdjectivePosition", "Predicative"), Require("$.Voice", "Passive"), Exclude("head.AdjectivalPassive", "Lexical"), Exclude("head.VerbKind", "Auxiliary")],
            interleaved: Some("Interleaved"), interleaved_internalised: Some("InternalisedInterleaved"), heavy_shift: true, postposed: Some("PostposedModifier"),
            clusters: Some((cluster: "ComplementCluster", coordination: "ClusterCoordination", adjunct: Some("PredicateAdjunct"), remnants: [(KeywordPhrase, "ParameterRemnant")]))),
        // A non-verbal phrase names its first Complement's Slot Kind, or
        // `Intransitive` without one.
        Valence(head: Preposition, phrase: "PrepositionPhrase", complement_kind: Some("ComplementKind"), agree: [("Number", "Number"), ("Number", "QuantityNumber"), ("Determination", "Determination"), ("Case", "Case"), ("NounKind", "NounKind"), ("Countability", "Countability"), ("DeterminativeDistribution", "DeterminativeDistribution")]),
        Valence(head: Noun, phrase: "BareNominal", complement_kind: Some("ComplementKind"), interleaved: Some("InterleavedModifier"), agree: [("ObliqueNumber", "Number"), ("ObliqueKind", "ComplementKind"), ("ObliqueNounKind", "NounKind")]),
        // A bare noun in a fossilised Preposition Phrase keeps the Complement
        // it selects (*until end of turn*, *on top of*, *in excess of*; CGEL,
        // Ch. 7 §3.1, pp. 618–620): a relational noun without it is no bare
        // count nominal (*the amount of [excess] damage dealt*).
        Valence(head: Noun, phrase: "PrepositionalNominal", obligatory: true),
        Valence(head: Adjective, phrase: "AdjectivePhrase", complement_kind: Some("ComplementKind")),
        Valence(head: Determinative, phrase: "DeterminerPhrase", complement_kind: Some("ComplementKind"), agree: [("ObliqueNumber", "Number"), ("ObliqueKind", "ComplementKind"), ("ObliqueDetermination", "Determination"), ("ObliqueDistribution", "DeterminativeDistribution")]),
        // A carrier noun distributes over a coordination of noun premodifiers
        // (`docs/oracle-style-guide.md` §7, Card types are common nouns and
        // attributive modifiers), and a later conjunct may carry its own
        // negative premodifier (§7, Negation with non-): *artifact or non-Aura
        // enchantment card* is an artifact card or a non-Aura enchantment
        // card. A preposed dependent at the start of the first conjunct
        // scopes over the whole coordination instead (*non-Lesson [instant and
        // sorcery] card*; `english-lexical-analysis.md` §2).
        Adjunct(host: "NounPremodifierConjunct", adjunct: "NounPremodifier", side: Before, host_kind: Nominal, cost: 1, equations: [Carry("modifier.Polarity", "Negative")]),
        // An attributive adjective can modify a noun premodifier within a
        // conjunct under a shared carrier noun (*Knight, Aura, Equipment, or
        // [legendary artifact] card*; `docs/oracle-style-guide.md` §7, Card
        // types are common nouns and attributive modifiers; Supertypes are
        // lowercase modifiers). As with AdjectivalAttribute, it is an
        // attributive adjective without a post-head Complement.
        Adjunct(host: "NounPremodifierConjunct", adjunct: "AdjectivePhrase", side: Before, host_kind: Nominal, cost: 1,
            equations: [Require("modifier.ComplementKind", "Intransitive"), Exclude("modifier.AdjectivePosition", "Predicative")]),
        // A complement costs nothing. A Preposition Phrase Adjunct costs the
        // same whether it postmodifies a Nominal or modifies a Predicate: the
        // Ranking Key's Right Association, not a Production Cost, prefers one
        // host to another (`docs/decisions/english-v4.md` §4.3).
        Adjunct(host: "QuantifiedNominal", adjunct: "PrepositionPhrase", side: After, host_kind: Nominal, cost: 1),
        Adjunct(host: "LocativeHead", adjunct: "PrepositionPhrase", side: After, host_kind: Nominal, cost: 1),
        Adjunct(host: "PartitiveHead", adjunct: "PrepositionPhrase", side: After, host_kind: Nominal, cost: 1),
        Adjunct(host: "SymbolHead", adjunct: "PrepositionPhrase", side: After, host_kind: Nominal, cost: 1),
        Adjunct(host: "Nominal", adjunct: "PrepositionPhrase", side: After, host_kind: Nominal, cost: 1),
        Adjunct(host: "VerbPhrase", adjunct: "PrepositionPhrase", side: After, host_kind: Predicate, cost: 1),
        Adjunct(host: "ExistentialPredicate", adjunct: "PrepositionPhrase", side: After, host_kind: Predicate, cost: 1, equations: [Exclude("head.ComplementKind", "NP")]),
        Adjunct(host: "Clause", adjunct: "PrepositionPhrase", side: Before, host_kind: Predicate, delimiter: Some(','), cost: 1, equations: [Require("$.FrontPosition", "Occupied")]),
        // A front Adverb Phrase without a comma (*Then draw a card*, *Then
        // that player shuffles*): connective *then* is an ordering connective
        // (CGEL, Ch. 8 §19, p. 778 [9ii]; `docs/oracle-style-guide.md`
        // checklist 10 and §10, Sequence). Before a front dependent set off
        // by a comma it shares that comma, in FrontAdverbial
        // (*Once each turn, ...*) or PreposedAdverbAndPreposition (*Then if
        // ...*), never also here (FrontPosition).
        Adjunct(host: "Clause", adjunct: "AdverbPhrase", side: Before, host_kind: Predicate, cost: 2, equations: [Require("adjunct.AdjunctPosition", "Front"), Exclude("head.FrontPosition", "Occupied")]),
        // An intransitive Preposition Phrase preposed without a comma, before
        // an imperative or before a declarative's Subject (*The next time you
        // would draw a card this turn, instead put ...*; *If this spell was
        // kicked, instead that creature gets ...*), where Oracle moves
        // *instead* from the end of a long or coordinated replacement
        // (`docs/oracle-style-guide.md` §13, Would and instead). Like a
        // comma-fronted dependent it attaches outermost, outside a comma-set
        // post-dependent (`english-lexical-analysis.md` §2).
        Adjunct(host: "Clause", adjunct: "PrepositionPhrase", side: Before, host_kind: Predicate, cost: 1, equations: [Require("adjunct.ComplementKind", "Intransitive")]),
        // A comma-set post-adjunct (*, except it has flying*, *, unless ...*)
        // or Supplement (*, where X is its power*) is anchored to a finite
        // Clause, never to a Verb Phrase, a *to*-infinitival or a relative's
        // Clause, whose Gap it closes (CGEL, Ch. 15 §5.1, p. 1351; Ch. 12 §4,
        // p. 1058; `docs/oracle-style-guide.md` §3, Commas and the serial
        // comma; §12, Copies).
        Adjunct(host: "Clause", adjunct: "PrepositionPhrase", side: After, host_kind: Predicate, delimiter: Some(','), cost: 1, equations: [Require("head.ClauseMarking", "Unmarked")]),
        Adjunct(host: "Clause", adjunct: "PrepositionPhrase", side: After, host_kind: Supplement, delimiter: Some(','), cost: 2, equations: [Require("head.ClauseMarking", "Unmarked")]),
        // A comma-set Supplement to a keyword line's item or an indexed
        // instruction. A Supplement anchors to a Clause or line (Oracle
        // English glossary, "Host Category"), never to a Keyword Phrase in a
        // sentence, which takes only its catalog-declared parameters
        // (english-v4.md §4.2).
        Adjunct(host: "KeywordLineItem", adjunct: "PrepositionPhrase", side: After, host_kind: Supplement, delimiter: Some(','), cost: 2),
        Adjunct(host: "IndexedNominal", adjunct: "PrepositionPhrase", side: After, host_kind: Supplement, delimiter: Some(','), cost: 2),
        // A preposed gerund-participial adjunct (*Starting with you, ...*).
        Adjunct(host: "Clause", adjunct: "Gerund", side: Before, host_kind: Predicate, delimiter: Some(','), cost: 2, equations: [Require("$.FrontPosition", "Occupied")]),
        // A depictive gerund-participial adjunct (*put it onto the battlefield
        // attacking*), of a lexical verb: after an auxiliary, a
        // gerund-participial is the progressive's (*the player it is
        // attacking*).
        Adjunct(host: "VerbPhrase", adjunct: "Gerund", side: After, host_kind: Predicate, cost: 2, equations: [Exclude("head.VerbKind", "Auxiliary")]),
        // A purpose *to*-infinitival, unless the head's frame selects one.
        Adjunct(host: "VerbPhrase", adjunct: "ToInf", side: After, host_kind: Predicate, cost: 2),
        // Coordinated Verb Phrases share Voice and VerbKind, so an auxiliary
        // that selects them sees a value (*it has attacked or blocked* is no
        // passive perfect).
        // A coordination begins where its first conjunct does
        // (CentralPosition).
        Coordination(category: "VerbPhrase", coordinators: "Coordinator", unshared: ["Inflection", "AdjectivalPassive", "CentralPosition"], equations: [Agree("$.CentralPosition", "first.CentralPosition")]),
        // An active and a passive Verb Phrase coordinate too (*enters
        // or is put into a graveyard*), leaving Voice and VerbKind unvalued;
        // past participles do not, since a participle's Voice is what selects
        // it (*attacked or blocked by this creature* is passive throughout).
        Coordination(category: "VerbPhrase", coordinators: "Coordinator", unshared: ["VerbKind", "Voice", "Inflection", "AdjectivalPassive", "CentralPosition"], equations: [Agree("$.CentralPosition", "first.CentralPosition"), Exclude("first.VerbForm", "PastParticiple")], unlike: Some("Voice"), serial: Some(true)),
        // A gerund-participle and then a past participle (*blocking or
        // blocked by this creature*).
        Coordination(category: "VerbPhrase", coordinators: "Coordinator", unshared: ["Inflection", "AdjectivalPassive", "VerbForm", "CentralPosition"], equations: [Agree("$.CentralPosition", "first.CentralPosition"), Require("first.VerbForm", "GerundParticiple"), Require("last.VerbForm", "PastParticiple"), Require("$.VerbForm", "PastParticiple")], proximate: ["VerbKind", "Voice"]),
        // Contrastive *but* joins predicates (*you control but don't own*).
        Coordination(category: "VerbPhrase", coordinators: "But", unshared: ["Inflection", "AdjectivalPassive", "CentralPosition"], equations: [Agree("$.CentralPosition", "first.CentralPosition")]),
        // A Linked Coordination of Verb Phrases sharing a Subject or modal
        // (*Each player discards a card, then draws a card*; *may search
        // ..., put ..., then shuffle*), set off by the comma before its
        // connective (`docs/oracle-style-guide.md` §3, Commas and the serial
        // comma: "before `then` within a sequence"), which older Oracle text
        // omits in a binary one (*puts that land onto the battlefield then
        // sacrifices a land*). Its Conjuncts may each begin with the
        // connective (*loses ..., then discards ..., then sacrifices ...*).
        Coordination(category: "VerbPhrase", link: Some("LinkedVerbPhrase"), unshared: ["Inflection", "AdjectivalPassive", "CentralPosition"], equations: [Agree("$.CentralPosition", "first.CentralPosition")], delimiter: Some(',')),
        Coordination(category: "KeywordPhrase", coordinators: "Coordinator", unshared: ["KeywordForm", "FinalParameter"]),
        // *"A" and "B"*; *"A," "B," and "C."*
        Coordination(category: "QuotedAbility", coordinators: "Coordinator"),
        // *left or right*; *artifact, creature, or land*.
        Coordination(category: "Mention", coordinators: "Coordinator"),
        Coordination(category: "Clause", coordinators: "Coordinator", unshared: ["Inflection", "FrontPosition"], equations: [Agree("$.FrontPosition", "first.FrontPosition")], delimiter: Some(',')),
        // Clauses of mixed moods (CGEL, Ch. 15 §3.5, pp. 1332–1333): an
        // imperative and then a declarative (*tap that creature and it
        // doesn't untap ...*), with either mood between in a serial one (*gain
        // control of that permanent, it loses all abilities, and it can't
        // attack or block*). After an initial declarative, a subjectless
        // conjunct is a Verb Phrase with its Subject ellipted, no imperative
        // (*you gain 4 life, draw four cards, ..., and he deals ...*;
        // coordination at unlike levels, §3.6, pp. 1335–1336, [31iii]).
        Coordination(category: "Clause", coordinators: "Coordinator", unshared: ["Inflection", "VerbForm", "FrontPosition"], equations: [Agree("$.FrontPosition", "first.FrontPosition"), Require("initial.VerbForm", "Plain"), Require("last.VerbForm", "Finite"), Require("$.VerbForm", "Plain")], unlike: Some("VerbForm"), serial: Some(true), delimiter: Some(',')),
        // A declarative and then an imperative, set off by the comma (*it
        // doesn't untap ..., and at the beginning of each of your draw steps,
        // put ...*).
        Coordination(category: "Clause", coordinators: "Coordinator", unshared: ["Inflection", "VerbForm", "FrontPosition"], equations: [Agree("$.FrontPosition", "first.FrontPosition"), Require("first.VerbForm", "Finite"), Require("last.VerbForm", "Plain"), Require("$.VerbForm", "Plain")], delimiter: Some(','), delimited: true, serial: Some(false)),
        // The comma between coordinated main clauses may be omitted (CGEL,
        // Ch. 20 §3.2.1, p. 1739), as older Oracle text omits it before an
        // imperative that opens with a fronted dependent, which no Verb
        // Phrase coordinate could hold (*that creature can't be regenerated
        // this turn and if it would die this turn, exile it instead*).
        Coordination(category: "Clause", coordinators: "Coordinator", unshared: ["Inflection", "VerbForm", "FrontPosition"], equations: [Agree("$.FrontPosition", "first.FrontPosition"), Require("first.VerbForm", "Finite"), Require("last.VerbForm", "Plain"), Carry("last.FrontPosition", "Occupied"), Require("$.VerbForm", "Plain")], serial: Some(false)),
        // *But* coordinates clauses of like or mixed moods as the Coordinator
        // does, a binary coordination (*Discard it, but you may put it on top
        // of your library*; CGEL, Ch. 15 §3.5, pp. 1332–1333).
        Coordination(category: "Clause", coordinators: "But", unshared: ["Inflection", "FrontPosition"], equations: [Agree("$.FrontPosition", "first.FrontPosition")], delimiter: Some(','), serial: Some(false)),
        Coordination(category: "Clause", coordinators: "But", unshared: ["Inflection", "VerbForm", "FrontPosition"], equations: [Agree("$.FrontPosition", "first.FrontPosition"), Require("first.VerbForm", "Plain"), Require("last.VerbForm", "Finite"), Require("$.VerbForm", "Plain")], unlike: Some("VerbForm"), delimiter: Some(','), serial: Some(false)),
        Coordination(category: "Clause", coordinators: "But", unshared: ["Inflection", "VerbForm", "FrontPosition"], equations: [Agree("$.FrontPosition", "first.FrontPosition"), Require("first.VerbForm", "Finite"), Require("last.VerbForm", "Plain"), Require("$.VerbForm", "Plain")], unlike: Some("VerbForm"), delimiter: Some(','), serial: Some(false)),
        // Linked Coordinations of Clauses, imperative or declarative, of
        // like or mixed moods as the Coordinator's are (*Draw a card, then
        // discard a card*; *Tap it, then you may sacrifice an artifact*;
        // *Search ..., put it into your hand, then shuffle*), set off by the
        // comma before the connective (`docs/oracle-style-guide.md` §3,
        // Commas and the serial comma; §10, Sequence), which older Oracle
        // text omits in a binary one. A stranded auxiliary never precedes a
        // comma-less link whose verb could be its Complement (*You may then
        // have ...*; StrandedModal).
        Coordination(category: "Clause", link: Some("LinkedClause"), unshared: ["Inflection", "FrontPosition"], equations: [Agree("$.FrontPosition", "first.FrontPosition")], delimiter: Some(',')),
        // Mixed moods end in a declarative link as they do with a
        // Coordinator (*reveal cards ... until ..., Kaboom! deals damage ...,
        // then you put the revealed cards ...*).
        Coordination(category: "Clause", link: Some("LinkedClause"), unshared: ["Inflection", "VerbForm", "FrontPosition"], equations: [Agree("$.FrontPosition", "first.FrontPosition"), Require("initial.VerbForm", "Plain"), Require("last.VerbForm", "Finite"), Require("$.VerbForm", "Plain")], unlike: Some("VerbForm"), serial: Some(true), delimiter: Some(',')),
        Coordination(category: "Clause", link: Some("LinkedClause"), unshared: ["Inflection", "VerbForm", "FrontPosition"], equations: [Agree("$.FrontPosition", "first.FrontPosition"), Require("first.VerbForm", "Finite"), Require("last.VerbForm", "Plain"), Require("$.VerbForm", "Plain")], delimiter: Some(','), delimited: true, serial: Some(false)),
        // Conjuncts may differ in Case (*them and all other creatures*); the
        // coordination takes its last conjunct's.
        // Every conjunct but the last shares its Determination, and the
        // coordination is determined only when the last is too: *all
        // artifacts and enchantments* has no predeterminer over coordinated
        // bare Noun Phrases. Its Countability is its last conjunct's.
        // After a determined Noun Phrase, a bare mass one is no conjunct: the
        // determiner scopes over the coordinated nominal (*its power and
        // toughness*, *that's red or green*).
        // An *and*-coordination of Noun Phrases or nominals is plural; an
        // *or*-coordination has its conjuncts' Number (CGEL, Ch. 5 §18.4,
        // pp. 507–509).
        Coordination(category: "NounPhrase", coordinators: "And", unshared: ["Number", "Person", "DeterminativeDistribution", "FirstConjunctNumber"], resolve: [("Determination", "Bare")], equations: [ExcludeTogether([("first.Determination", "Overt"), ("last.Determination", "Bare"), ("last.Countability", "Mass")]), Require("$.Number", "Plural"), Require("$.Person", "Third"), Agree("$.FirstConjunctNumber", "first.Number"), Exclude("first.NounKind", "Quantity"), Exclude("first.DeterminativeDistribution", "Distributive")], proximate: ["Case", "NounKind", "Countability"]),
        Coordination(category: "NounPhrase", coordinators: "And", unshared: ["Number", "Person", "FirstConjunctNumber"], resolve: [("Determination", "Bare")], equations: [Require("$.Number", "Singular"), Require("$.Person", "Third"), Carry("first.DeterminativeDistribution", "Distributive"), Carry("last.DeterminativeDistribution", "Distributive")], proximate: ["Case", "NounKind", "Countability"]),
        // *And/or* means "and or or" (CGEL, Ch. 15 §3.3(a), p. 1329): plural
        // with a plural last conjunct, of either Number with a singular one
        // (*you and/or at least one permanent you control becomes*).
        Coordination(category: "NounPhrase", coordinators: "AndOr", unshared: ["Number", "DeterminativeDistribution", "FirstConjunctNumber"], resolve: [("Determination", "Bare")], equations: [ExcludeTogether([("first.Determination", "Overt"), ("last.Determination", "Bare"), ("last.Countability", "Mass")]), Require("last.Number", "Plural"), Require("$.Number", "Plural")], proximate: ["Person", "Case", "NounKind", "Countability"]),
        Coordination(category: "NounPhrase", coordinators: "AndOr", unshared: ["Number", "DeterminativeDistribution", "FirstConjunctNumber"], resolve: [("Determination", "Bare")], equations: [ExcludeTogether([("first.Determination", "Overt"), ("last.Determination", "Bare"), ("last.Countability", "Mass")]), Require("last.Number", "Singular")], proximate: ["Person", "Case", "NounKind", "Countability"]),
        // A Numeric Noun Phrase is no first conjunct: a conjunct must fill
        // the coordination's function alone (CGEL, Ch. 15 §3.1, p. 1323,
        // rule [1]), and a number fills no Noun Phrase Complement slot, so
        // never *is dealt [3] or [more damage]*. Numbers alone are an Amount
        // coordination (*2 or 3*). An admission gate
        // (`docs/decisions/english-v4.md` §4.5).
        Coordination(category: "NounPhrase", coordinators: "Alternative", unshared: ["DeterminativeDistribution", "FirstConjunctNumber"], resolve: [("Determination", "Bare")], equations: [ExcludeTogether([("first.Determination", "Overt"), ("last.Determination", "Bare"), ("last.Countability", "Mass")]), Exclude("first.NounKind", "Numeric"), Exclude("first.NounKind", "Quantity"), Exclude("last.NounKind", "Quantity")], proximate: ["Number", "Person", "Case", "NounKind", "Countability"]),
        Coordination(category: "Nominal", coordinators: "And", unshared: ["ObliqueNumber", "ObliqueNounKind", "ConjunctNumber", "CompoundPart"], equations: [Exclude("first.CompoundPart", "Base"), Require("$.Number", "Plural"), Agree("$.ConjunctNumber", "first.Number")], proximate: ["NounDistribution"]),
        Coordination(category: "Nominal", coordinators: "Disjunctive", unshared: ["ObliqueNumber", "ObliqueNounKind", "ConjunctNumber", "CompoundPart"], equations: [Exclude("first.CompoundPart", "Base"), Agree("$.ConjunctNumber", "$.Number")], proximate: ["NounDistribution"]),
        Coordination(category: "GenitiveNominals", conjunct: Some("GenitiveNominal"), coordinators: "Coordinator", proximate: ["Number", "Countability", "NounKind"]),
        Coordination(category: "PossessorNominals", conjunct: Some("BareNominal"), coordinators: "Coordinator", proximate: ["Number", "Countability", "NounKind"]),
        // Relative clauses coordinate, each with its relative word (*tokens
        // that are copies of it and that are tapped and attacking*; CGEL, Ch.
        // 15 §2.1, p. 1292).
        Coordination(category: "RelativeClause", coordinators: "Coordinator", equations: [Require("last.ClauseMarking", "Relative")]),
        Coordination(category: "RelativeClause", coordinators: "But", equations: []),
        // Bare adverbial relatives coordinate under one temporal head (*any
        // time [you could mulligan and this card is in your hand]*; CGEL, Ch.
        // 15 §2.1, p. 1292), each conjunct bearing the head's Adjunct Gap. The
        // coordination is its own Category, so that RelativeAdjunctGap states
        // the Gap once per conjunct and never again over their coordination
        // (`docs/decisions/english-lexical-analysis.md` §2).
        Coordination(category: "SubjectInitialCoordination", conjunct: Some("SubjectInitialClause"), coordinators: "Coordinator", unshared: ["Inflection"]),
        // Interrogative clauses coordinate (*which creatures block and how
        // those creatures block*; CGEL, Ch. 5 §18.4, p. 508).
        Coordination(category: "InterrogativeClause", coordinators: "Coordinator"),
        Coordination(category: "NounPremodifier", conjunct: Some("NounPremodifierConjunct"), coordinators: "Coordinator", unshared: ["Polarity"]),
        // Every Conjunct but the last is a first base alone.
        Coordination(category: "CompoundCoordination", conjunct: Some("CompoundConjunct"), coordinators: "Coordinator", unshared: ["CompoundPart"],
            equations: [Require("first.CompoundPart", "Base"), Require("last.CompoundPart", "Whole")], proximate: ["Number", "Countability", "NounKind", "NounDistribution"]),
        Coordination(category: "Participle", coordinators: "Coordinator", unshared: ["Inflection", "Polarity"]),
        Coordination(category: "AdjectivePhrase", coordinators: "Coordinator", unshared: ["Grade", "Polarity"]),
        Coordination(category: "PrepositionPhrase", coordinators: "Coordinator", unshared: ["DeterminativeDistribution"], proximate: ["ComplementKind", "Number", "Determination", "Case", "NounKind", "Countability"]),
        Coordination(category: "AdverbPhrase", coordinators: "Coordinator"),
        Coordination(category: "DepictiveCoordination", conjunct: Some("Depictive"), coordinators: "Coordinator", unshared: ["ComplementKind"], unlike: Some("ComplementKind")),
        // Unlike premodifiers coordinate serially too (*attacking, blocking,
        // or tapped creature*; *the basic, Sphere, and Locus lands*).
        Coordination(category: "Attributes", conjunct: Some("Attribute"), coordinators: "Coordinator", unshared: ["ComplementKind"], unlike: Some("ComplementKind"), serial: Some(true)),
        Coordination(category: "PostmodifierCoordination", conjunct: Some("PostmodifierConjunct"), coordinators: "Coordinator", unshared: ["ComplementKind"], unlike: Some("ComplementKind")),
        // A slash measure names a counter kind only beside keyword phrases
        // naming keyword counters' kinds [CR#122.1a,122.1b]: never beside a
        // Noun Phrase or a quoted ability, where it is no Object.
        Coordination(category: "ObjectCoordination", conjunct: Some("ObjectConjunct"), coordinators: "And", unshared: ["ComplementKind"], unlike: Some("ComplementKind"), serial: Some(true),
            equations: [ExcludeTogether([("first.ComplementKind", "NP"), ("last.ComplementKind", "MeasureNP")]), ExcludeTogether([("first.ComplementKind", "MeasureNP"), ("last.ComplementKind", "NP")]), ExcludeTogether([("first.ComplementKind", "QuotedAbility"), ("last.ComplementKind", "MeasureNP")]), ExcludeTogether([("first.ComplementKind", "MeasureNP"), ("last.ComplementKind", "QuotedAbility")])]),
        // A comma may set off a binary coordination's second Cluster, which is
        // likelier before long and complex coordinates (*deals half X damage,
        // rounded down, to any target, and half X damage, rounded up, to
        // you*; CGEL, Ch. 20 §3.2.1, pp. 1739–1740;
        // `docs/oracle-style-guide.md` §3, Commas and the serial comma).
        Coordination(category: "ClusterCoordination", conjunct: Some("ComplementCluster"), coordinators: "Coordinator", delimiter: Some(',')),
        Coordination(category: "ContrastCoordination", conjunct: Some("ContrastConjunct"), coordinators: "But", unshared: ["Polarity"], equations: [Require("first.Polarity", "Affirmative"), Require("last.Polarity", "Negative")], delimiter: Some(','), serial: Some(false)),
        Coordination(category: "ContrastPrepositionCoordination", conjunct: Some("ContrastPrepositionConjunct"), coordinators: "But", unshared: ["Polarity", "DeterminativeDistribution"], equations: [Require("first.Polarity", "Affirmative"), Require("last.Polarity", "Negative")], proximate: ["ComplementKind", "Number", "Determination", "Case", "NounKind", "Countability"], delimiter: Some(','), serial: Some(false)),
        // Unlike predicate Adjuncts coordinate serially too, not all alike
        // (*only during the declare blockers step, only if ...,
        // and only once each turn*).
        Coordination(category: "AdjunctCoordination", conjunct: Some("PredicateAdjunct"), coordinators: "Coordinator", unshared: ["ComplementKind"], unlike: Some("ComplementKind"), serial: Some(true)),
        Coordination(category: "AmountOrNounPhrase", conjunct: Some("AmountOrNounConjunct"), coordinators: "Coordinator", unshared: ["ComplementKind"], unlike: Some("ComplementKind")),
        Coordination(category: "MeasureNounPhrase", coordinators: "Coordinator"),
        Coordination(category: "Amount", coordinators: "Coordinator", proximate: ["QuantityNumber", "Sign"]),
        Coordination(category: "SymbolCosts", coordinators: "Coordinator"),
        // A coordination of quantifiers determines as its last one does (*one
        // or more cards*, *one or more of them*; CGEL, Ch. 15 §3.3, p. 1330).
        Coordination(category: "DeterminerPhrase", coordinators: "Coordinator", proximate: ["Number", "Countability", "DeterminativeDistribution", "NounKind"]),
        // Numbers alone are an Amount coordination (*X is 2 or 3*), never also
        // a fused quantity over them (`docs/decisions/english-lexical-analysis.md`
        // §2).
        Coordination(category: "FusedQuantity", conjunct: Some("FusableDeterminer"), coordinators: "Disjunctive", equations: [ExcludeTogether([("first.NounKind", "Numeric"), ("last.NounKind", "Numeric")])], proximate: ["Number", "Countability", "NounKind"]),
    ],
    correlatives: [("Both", "And"), ("Either", "Or"), ("Neither", "Nor")],
)
