// The Oracle English grammar data file. It names Categories, features,
// Schemas and core closed-class lexemes only: every other word, and every
// Subcategorization Frame, comes from the lexical environment it is bound to.
(
    root: "Document",
    features: {
        // A keyword mention may omit parameters; a Keyword Line supplies them.
        "KeywordForm": ["Bare", "Parametric"],
        "Parameterization": ["Supplied", "Omitted"],
        "Number": ["Singular", "Plural"],
        // The Number of a head's *of* oblique.
        "ObliqueNumber": ["Singular", "Plural"],
        // What a grammaticised preposition marks: an oblique (*of*) or a
        // comparative Complement (*than*).
        "PrepositionMarking": ["Oblique", "Comparative"],
        // An adjective's inflectional grade.
        "Grade": ["Plain", "Comparative", "Superlative", "Equative"],
        // Internal numeral–noun agreement survives external group respecification.
        "QuantityNumber": ["Singular", "Plural"],
        "Person": ["First", "Second", "Third"],
        "VerbForm": ["Plain", "Finite", "GerundParticiple", "PastParticiple"],
        // A to-infinitival Clause is marked by its subordinator; a relative
        // clause by *that* or a relative phrase.
        "ClauseMarking": ["Unmarked", "To", "Relative"],
        "Voice": ["Active", "Passive"],
        // A verb whose Adjectival Passive is a declared Adjective (*tapped*).
        "AdjectivalPassive": ["Derived", "Lexical"],
        // Auxiliary verbs (CGEL's NICE verbs) and the rest.
        "VerbKind": ["Lexical", "Auxiliary"],
        // The Slot Kind of a Preposition Phrase's Complement.
        "ComplementKind": ["NP", "PP", "AdjP", "AdvP", "Nominal", "Amount", "FiniteClause", "VerblessClause", "InterrogativeClause", "ToInf", "Gerund", "BareInf", "KeywordPhrase", "QuotedAbility", "Intransitive"],
        // The Slot Kind of a determinative's Preposition Phrase's Complement.
        "ObliqueKind": ["NP", "PP", "AdjP", "AdvP", "Nominal", "Amount", "FiniteClause", "VerblessClause", "InterrogativeClause", "ToInf", "Gerund", "BareInf", "KeywordPhrase", "QuotedAbility", "Intransitive"],
        "NounDistribution": ["Ordinary", "Quantity", "BareSingular", "DirectMeasure", "HeadOnly", "Serial"],
        "NounKind": ["Ordinary", "Temporal", "Manner", "Locative", "Numeric"],
        // The NounKind of a head's *of* oblique.
        "ObliqueNounKind": ["Ordinary", "Temporal", "Manner", "Locative", "Numeric"],
        "Determination": ["Bare", "Overt"],
        // The Determination of a determinative's *than* Complement.
        "ObliqueDetermination": ["Bare", "Overt"],
        "AdjectivePosition": ["Attributive", "Predicative"],
        "Sign": ["Negative", "Zero", "Positive"],
        "PronounKind": ["Personal", "Existential", "Relative"],
        "DeterminativeDistribution": ["Dependent", "Independent", "Numerical", "IndefiniteArticle", "Distributive", "Deictic", "SingularOrQuantified", "FreeChoice", "Multiplier"],
        "Case": ["Plain", "Nominative", "Accusative", "Genitive"],
        "Countability": ["Count", "Mass"],
        "AdjunctPosition": ["Front", "Central", "End", "Phrasal", "Bounding"],
        "Inflection": ["Invariant", "IndependentGenitive", "Singular", "Plural", "Plain", "Present", "Preterite", "Irrealis", "GerundParticiple", "PastParticiple"],
    },
    categories: {
        "Document": (),
        "Paragraphs": (),
        "ModalHeader": (),
        "ModalAbility": (),
        "SymbolCosts": (),
        "ActivationCost": (),
        "NonManaCost": (),
        "Mode": (),
        "ModeEffect": (),
        "Effect": (),
        "Pawprints": (),
        "TypeModifier": (),
        "Modes": (),
        "Ability": (),
        "TypeLine": (),
        "CardTypes": (),
        "Subtypes": (),
        "KeywordList": (),
        "Quality": (),
        "Name": (),
        "Condition": (),
        "Measure": (),
        "Symbols": (),
        // An Arabic numeral named as a noun, without the numeral's Number.
        "NumeralName": (),
        // A bracketed loyalty symbol: a cost, or a counted noun (*an
        // additional [+1]*).
        "LoyaltySymbol": (),
        "Header": (),
        "RowHeader": (),
        "Chapters": (),
        "IndexedNominal": (features: ["Number"]),
        "NominalModifier": (),
        "ChoiceQuantity": (features: ["Number"]),
        "Sentence": (),
        "Sentences": (),
        // A Clause's Inflection is its finite verb's: an independent clause
        // excludes the irrealis *were* (CGEL, Ch. 3 §1.5, pp. 85–88).
        "Clause": (features: ["VerbForm", "ClauseMarking", "Inflection"], gap: true),
        // A subject relative agrees with its antecedent in number; an
        // adverbial relative modifies a temporal nominal.
        "RelativeClause": (features: ["Number", "NounKind", "ClauseMarking"]),
        // A finite clause whose Subject is its Gap (CGEL, Ch. 12 §3.3(a), p. 1044).
        "SubjectGapClause": (category: Some("Clause"), features: ["Number", "Person", "VerbForm", "Inflection"], gap: true),
        // A finite clause with an extracted Adjunct.
        "AdjunctGapClause": (category: Some("Clause"), features: ["VerbForm"], gap: true),
        // A participle premodifying a nominal (*attacking creature*).
        "Participle": (category: Some("VerbPhrase"), features: ["Inflection"]),
        "VerbPhrase": (features: ["Number", "Person", "VerbForm", "Voice", "VerbKind", "Inflection", "AdjectivalPassive"], gap: true),
        // Existential *there* and the predicate it is subject of (CGEL, Ch. 16
        // §6.1, p. 1391).
        "DummyPronoun": (category: Some("NounPhrase"), features: ["Number", "Person"]),
        "ExistentialPredicate": (category: Some("VerbPhrase"), features: ["Number", "Person", "VerbForm", "Inflection"]),
        "FusedNounPhrase": (category: Some("NounPhrase"), features: ["Number", "Person", "Case", "Determination", "NounKind", "Countability"]),
        // A compound locative determinative, which a Preposition Phrase may
        // postmodify (*anywhere else*).
        // A symbol sequence as a Noun Phrase, which a Preposition Phrase may
        // postmodify (*{X} in its mana cost*).
        "SymbolHead": (category: Some("NounPhrase"), features: ["Number", "Person", "Case", "Determination", "NounKind", "Countability"]),
        // A determinative with its partitive oblique, which a relative clause
        // may postmodify (*each of those cards that has suspend*).
        "PartitiveNounPhrase": (category: Some("NounPhrase"), features: ["Number", "Person", "Case", "Determination", "NounKind", "Countability"]),
        // A quantity with its partitive oblique, which a Preposition Phrase may
        // postmodify (*one of them of their choice*).
        "PartitiveHead": (category: Some("NounPhrase"), features: ["Number", "Person", "Case", "Determination", "NounKind", "Countability"]),
        "LocativeHead": (category: Some("NounPhrase"), features: ["Number", "Person", "Case", "Determination", "NounKind", "Countability"]),
        "LocativeNounPhrase": (category: Some("NounPhrase"), features: ["Number", "Person", "Case", "Determination", "NounKind", "Countability"]),
        "NounPhrase": (features: ["Number", "Person", "Case", "Determination", "NounKind", "Countability"], gap: true),
        // A temporal Noun Phrase Adjunct: of location (*this turn*; CGEL, Ch. 8
        // §6.3, p. 698) or of frequency (*three times*; Ch. 8 §9, pp. 713–716).
        "TemporalNounPhrase": (category: Some("NounPhrase"), features: ["Number", "Person", "Case", "Determination", "NounKind", "Countability"]),
        "ComplementNounPhrase": (category: Some("NounPhrase"), features: ["Number", "Person", "Case", "Determination", "NounKind", "Countability"], gap: true),
        // A nominal's ComplementKind and ObliqueNumber are its head noun's
        // Complement's.
        "Nominal": (features: ["Number", "Countability", "NounKind", "Determination", "NounDistribution", "ComplementKind", "ObliqueNumber", "ObliqueNounKind"], gap: true),
        "QuantifiedNominal": (category: Some("Nominal"), features: ["QuantityNumber", "NounKind", "Determination", "NounDistribution"]),
        "ModifiedQuantifiedNominal": (category: Some("Nominal"), features: ["QuantityNumber", "NounKind", "Determination", "NounDistribution"]),
        // A temporal nominal bounded by a relative clause (*next time you cast a spell*).
        "RelativeTemporalNominal": (category: Some("Nominal"), features: ["Number", "Countability", "NounKind", "Determination", "NounDistribution"]),
        "BareNominal": (category: Some("Nominal"), features: ["Number", "Countability", "NounKind", "Determination", "NounDistribution", "ComplementKind", "ObliqueNumber", "ObliqueKind", "ObliqueNounKind"], gap: true),
        "NounPremodifier": (category: Some("Nominal")),
        "PrepositionalNominal": (category: Some("Nominal"), features: ["Number", "Countability", "NounDistribution"]),
        "BareNominalComplement": (category: Some("Nominal")),
        "Possessor": (category: Some("NounPhrase"), features: ["Number", "Person", "Case"]),
        "NumericalDeterminer": (category: Some("DeterminerPhrase"), features: ["Number", "Countability"]),
        // A determinative's partitive oblique has a Number of its own (*each of
        // them*; CGEL, Ch. 5 §9.3, pp. 408–410).
        "DeterminerPhrase": (features: ["Number", "Countability", "DeterminativeDistribution", "NounKind", "ComplementKind", "ObliqueNumber", "ObliqueKind", "PrepositionMarking", "ObliqueDetermination"]),
        // A Preposition Phrase's Number and Determination are its Complement's
        // (*up to two*, a determiner; *of them*, a partitive oblique).
        "PrepositionPhrase": (features: ["ComplementKind", "Number", "Determination", "Case", "PrepositionMarking", "NounKind", "Countability"], gap: true),
        // An Adjectival Passive is Passive; it is a predicative Complement
        // only, never a depictive Adjunct or a premodifier.
        "AdjectivePhrase": (features: ["Determination", "AdjectivePosition", "Voice", "ComplementKind", "Grade"], gap: true),
        "AdverbPhrase": (features: ["AdjunctPosition"]),
        // The predicative Complement function; its head bears it too.
        "Predicative": (function: true),
        // An adverbial Complement: an Adverb Phrase or a Noun Phrase of
        // frequency (*more than twice*, *more than three times*).
        "Adverbial": (function: true),
        // The Adjunct function before a selected Complement or shifted Object.
        "Interleaved": (function: true),
        // The Modifier function after a nominal head: a relative clause or a
        // participial clause.
        "Postmodifier": (function: true, features: ["Number", "NounKind"]),
        // A relative phrase with genitive *whose* (CGEL, Ch. 12 §3.2.5, p. 1043).
        "RelativeNounPhrase": (category: Some("NounPhrase"), features: ["Number"]),
        // A preposition and its relative pronoun, fronted (*for which*).
        "RelativePrepositionPhrase": (category: Some("PrepositionPhrase")),
        "KeywordPhrase": (features: ["Parameterization", "KeywordForm"]),
        "KeywordLineItem": (features: ["KeywordForm"]),
        "KeywordParameters": (features: ["KeywordForm"]),
        "BoundKeyword": (features: ["KeywordForm"]),
        // An Amount's QuantityNumber agrees with a counted noun (*two cards*);
        // as a Noun Phrase it is singular (*X can't be 0*).
        "Amount": (features: ["QuantityNumber", "Sign"]),
        "SignedAmount": (),
        "Cost": (),
        "FiniteClause": (category: Some("Clause")),
        "VerblessClause": (category: Some("Clause")),
        // Subjectless non-finite complements: a to-infinitival is a Clause,
        // a bare infinitival or gerund-participial its Verb Phrase.
        "ToInf": (category: Some("Clause"), gap: true),
        // Its object Gap is filled by the Subject of the verb selecting it.
        "HollowInf": (category: Some("Clause")),
        "BareInf": (category: Some("VerbPhrase"), features: ["Number", "Person", "VerbForm", "Voice"], gap: true),
        "Gerund": (category: Some("VerbPhrase"), features: ["Number", "Person", "VerbForm", "Voice"], gap: true),
        // A gerund-participial Clause with its Subject, which Oracle uses as
        // a Subject only (CGEL, Ch. 14 §2.1, p. 1188).
        "GerundClause": (category: Some("Clause")),
        "QuotedAbility": (),
        // An interrogative content clause (CGEL, Ch. 11 §5.1, pp. 972–973).
        "InterrogativeClause": (category: Some("Clause")),
        // An interrogative phrase with *which* (*which creatures*).
        "InterrogativePhrase": (category: Some("NounPhrase"), features: ["Number", "Person"]),
    },
    closed_words: {
        "By": "prep:by",
        "Up": "prep:up",
        "Of": "prep:of",
        "Than": "prep:than",
        "As": "prep:as",
        "Plus": "prep:plus",
        "Minus": "prep:minus",
        "The": "det:the",
        "Genitive": "clitic:genitive",
        "That": "det:that",
        "Any": "det:any",
        "Or": "coord:or",
        "And": "coord:and",
        "Nor": "coord:nor",
        "But": "coord:but",
        "Both": "det:both",
        "Either": "det:either",
        "Neither": "det:neither",
        "To": "sub:to",
        "Each": "det:each",
        "All": "det:all",
        "Whichever": "det:whichever",
        "Which": "det:which",
        "Whether": "sub:whether",
    },
    lexical_classes: {
        "Predeterminer": ["det:all", "det:both"],
        "LocativeQuantifier": ["det:anywhere"],
        "DegreeQuantifier": ["det:many", "det:much"],
        "Coordinator": ["coord:and", "coord:or", "coord:and/or", "coord:nor"],
        "Disjunctive": ["coord:or", "coord:and/or", "coord:nor"],
        "Additive": ["coord:and", "coord:and/or"],
        "Alternative": ["coord:or", "coord:nor"],
        // *Be* and its contracted and negative forms.
        "BeVerb": ["verb:be", "verb:'re", "verb:aren't"],
        // Perfect *have* and its contracted and negative forms.
        "HaveVerb": ["verb:have", "verb:'ve", "verb:haven't"],
        // Comparative determinatives a measure phrase modifies (*{1} less*).
        "ComparativeQuantifier": ["det:more", "det:less", "det:fewer"],
        "SuperlativeQuantifier": ["det:most", "det:least", "det:fewest"],
        "FusedQuantifier": ["det:both", "det:more", "det:everything", "det:this", "det:none"],
        // Subordinator *that* and the relative pronouns (CGEL, Ch. 12 §3.5).
        "RelativeMarker": ["sub:that", "pronoun:which", "pronoun:who"],
    },
    typed_classes: ["DegreeAdverb", "CopularVerb", "FusedHeadAdjective", "PhrasalAdverb", "BoundingAdverb", "FrontAdverb", "CentralAdverb", "EndAdverb", "CardType", "Supertype", "Subtype", "ParameterizedKeyword", "AbilityWord", "AnchorWord", "BracedSymbol", "Variable", "RangeMarker", "Pawprint", "InterrogativeAdverb"],
    slot_categories: {
        TypeModifier: "TypeModifier",
        NonManaCost: "NonManaCost",
        Quality: "Quality", Name: "Name", Ability: "Ability", Condition: "Condition", Measure: "Measure",
        NP: "ComplementNounPhrase",
        PP: "PrepositionPhrase",
        Pred: "Predicative",
        AdjP: "AdjectivePhrase",
        AdvP: "Adverbial",
        LocativeNP: "LocativeNounPhrase",
        KeywordPhrase: "KeywordPhrase",
        Nominal: "BareNominalComplement",
        Amount: "Amount",
        Cost: "Cost",
        FiniteClause: "FiniteClause",
        VerblessClause: "VerblessClause",
        InterrogativeClause: "InterrogativeClause",
        ToInf: "ToInf",
        HollowToInf: "HollowInf",
        BareInf: "BareInf",
        Gerund: "Gerund",
        QuotedAbility: "QuotedAbility",
    },
    productions: [
        (name: "TextMode", lhs: "Document", rhs: [Cat("head", "Mode")]),
        (name: "TextModalHeader", lhs: "Document", rhs: [Cat("head", "ModalHeader")]),
        (name: "ModalAbility", lhs: "ModalAbility", rhs: [Cat("header", "ModalHeader"), Mark('\n', Bound), Cat("modes", "Modes")]),
        (name: "ModalTextAbility", lhs: "Ability", rhs: [Cat("head", "ModalAbility")]),
        (name: "ModalEffect", lhs: "Effect", rhs: [Cat("head", "ModalAbility")]),
        (name: "ActivatedModalHeader", lhs: "Document", rhs: [Cat("cost", "ActivationCost"), Punct(':'), Cat("head", "ModalHeader")]),
        (name: "ActivationPayment", lhs: "ActivationCost", rhs: [Cat("head", "Cost")]),
        (name: "SingleMode", lhs: "Modes", rhs: [Cat("head", "Mode")]),
        (name: "ModeSequence", lhs: "Modes", rhs: [Cat("first", "Mode"), Mark('\n', Bound), Cat("rest", "Modes")]),
        (name: "AbilityParagraph", lhs: "Paragraphs", rhs: [Cat("head", "Ability")]),
        (name: "HeaderParagraph", lhs: "Paragraphs", rhs: [Cat("head", "Header")]),
        (name: "AbilityParagraphSequence", lhs: "Paragraphs", rhs: [Cat("first", "Ability"), Mark('\n', Bound), Cat("rest", "Paragraphs")]),
        (name: "HeaderParagraphSequence", lhs: "Paragraphs", rhs: [Cat("first", "Header"), Mark('\n', Bound), Cat("rest", "Paragraphs")]),

        (name: "CardTypeModifier", lhs: "TypeModifier", rhs: [Class("head", "CardType")], equations: [Require("head.Number", "Singular")]),
        (name: "SupertypeModifier", lhs: "TypeModifier", rhs: [Class("head", "Supertype")]),
        (name: "NegativeTypeModifier", lhs: "TypeModifier", rhs: [Lex("prefix", Affix), Cat("head", "TypeModifier")]),
        (name: "IndexedCostHeader", lhs: "Header", rhs: [Cat("cost", "Cost"), Punct(':'), Cat("head", "IndexedNominal")], equations: [Require("head.Number", "Singular")]),
        (name: "KeywordPremodifier", lhs: "BareNominal", rhs: [Cat("modifier", "KeywordPhrase"), Cat("head", "BareNominal")]),

        (name: "TextSymbols", lhs: "Document", rhs: [Cat("head", "Symbols")]),
        // A symbol sequence is also a noun under a determiner (*each {B} in a
        // cost*, *an additional {G}*, *six {E}*, *that much {R}*).
        (name: "SymbolNominal", lhs: "BareNominal", rhs: [Cat("head", "Symbols")], equations: [Require("$.Determination", "Overt"), Require("$.NounKind", "Ordinary"), Require("$.NounDistribution", "Ordinary")]),
        // An Arabic numeral is a singular count noun under a determiner (*a
        // natural 20*; CGEL, Ch. 5 §7.1, p. 386).
        (name: "ArabicNumeralName", lhs: "NumeralName", rhs: [Numeral("head", Arabic(false))]),
        (name: "NumeralNominal", lhs: "BareNominal", rhs: [Cat("head", "NumeralName")], equations: [Require("$.Determination", "Overt"), Require("$.Number", "Singular"), Require("$.Countability", "Count"), Require("$.NounKind", "Ordinary"), Require("$.NounDistribution", "Ordinary")]),
        (name: "GroupedNumericAmount", lhs: "Amount", rhs: [Numeral("head", Arabic(true))], equations: [Agree("$.QuantityNumber", "head.Number")]),
        // A multiplying or bounding adverb modifies a quantity (*up to
        // twice X target cards*).
        (name: "AdverbModifiedAmount", lhs: "Amount", rhs: [Cat("modifier", "AdverbPhrase"), Cat("head", "Amount")], equations: [Exclude("modifier.AdjunctPosition", "Front"), Exclude("modifier.AdjunctPosition", "Central"), Exclude("modifier.AdjunctPosition", "End")]),
        (name: "UnsignedMeasureAmount", lhs: "SignedAmount", rhs: [Cat("head", "Amount")], equations: [Exclude("head.Sign", "Negative")]),
        (name: "PositiveMeasureAmount", lhs: "SignedAmount", rhs: [Mark('+', Prefix), Cat("head", "Amount")], equations: [Exclude("head.Sign", "Negative")]),
        (name: "NegativeMeasureAmount", lhs: "SignedAmount", rhs: [Mark('-', Prefix), Cat("head", "Amount")], equations: [Exclude("head.Sign", "Negative")]),

        (name: "BoundKeywordItem", lhs: "KeywordParameters", rhs: [Cat("head", "BoundKeyword")]),
        (name: "NumericNounPhrase", lhs: "NounPhrase", rhs: [Cat("head", "Amount")], equations: [Require("$.NounKind", "Numeric"), Require("$.Number", "Singular"), Require("$.Determination", "Bare"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        (name: "NonNumericComplement", lhs: "ComplementNounPhrase", rhs: [Cat("head", "NounPhrase")], equations: [Exclude("head.NounKind", "Numeric"), Exclude("head.NounKind", "Manner"), Exclude("head.Case", "Nominative"), Exclude("head.Case", "Genitive")], transparent: ["head"]),
        (name: "NumeralNominalPhrase", lhs: "FusedNounPhrase", rhs: [Cat("head", "ChoiceQuantity")], equations: [Require("$.NounKind", "Ordinary"), Require("$.Determination", "Bare"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        (name: "CardinalChoice", lhs: "ChoiceQuantity", rhs: [Numeral("head", Cardinal)]),
        (name: "FusedQuantifierNominalPhrase", lhs: "NounPhrase", rhs: [Class("head", "FusedQuantifier")], equations: [Require("$.NounKind", "Ordinary"), Require("$.Determination", "Bare"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        (name: "CardinalDeterminer", lhs: "NumericalDeterminer", rhs: [Numeral("head", Cardinal)], equations: [Require("$.Countability", "Count")]),
        (name: "VariableDeterminer", lhs: "NumericalDeterminer", rhs: [Class("head", "Variable")], equations: [Require("$.Countability", "Count")]),
        (name: "ArabicDeterminer", lhs: "NumericalDeterminer", rhs: [Numeral("head", Arabic(false))], equations: [Require("$.Countability", "Count")]),
        (name: "GroupedArabicDeterminer", lhs: "NumericalDeterminer", rhs: [Numeral("head", Arabic(true))], equations: [Require("$.Countability", "Count")]),
        (name: "NegativeAdjective", lhs: "AdjectivePhrase", rhs: [Lex("prefix", Affix), Cat("head", "AdjectivePhrase")]),
        // A modal header labelled by an ability word, as a unit of its own.
        (name: "LabelledModalHeader", lhs: "Document", rhs: [Class("label", "AbilityWord"), Mark('—', Free), Cat("head", "ModalHeader")]),
        (name: "ChapterModalHeader", lhs: "Document", rhs: [Cat("chapters", "Chapters"), Mark('—', Free), Cat("head", "ModalHeader")]),

        (name: "CompleteKeywordPhrase", lhs: "KeywordPhrase", rhs: [Cat("head", "KeywordParameters")], equations: [Require("$.Parameterization", "Supplied")]),
        (name: "CompleteKeywordItem", lhs: "KeywordLineItem", rhs: [Cat("head", "KeywordPhrase")], equations: [Require("head.Parameterization", "Supplied")]),
        (name: "BareKeywordMention", lhs: "KeywordPhrase", rhs: [Class("head", "ParameterizedKeyword")], equations: [Require("$.Parameterization", "Omitted")]),
        (name: "TextAbility", lhs: "Document", rhs: [Cat("head", "Ability")]),
        (name: "TextTypeLine", lhs: "Document", rhs: [Cat("head", "TypeLine")]),
        (name: "TextHeader", lhs: "Document", rhs: [Cat("head", "Header")]),
        (name: "HeaderSequence", lhs: "Document", rhs: [Cat("first", "Header"), Mark('\n', Bound), Cat("rest", "Paragraphs")]),
        (name: "TextSequence", lhs: "Document", rhs: [Cat("first", "Ability"), Mark('\n', Bound), Cat("rest", "Paragraphs")]),
        (name: "SentenceAbility", lhs: "Ability", rhs: [Cat("head", "Sentences")]),
        (name: "KeywordAbilityList", lhs: "Ability", rhs: [Cat("head", "KeywordList")]),
        (name: "SingleKeyword", lhs: "KeywordList", rhs: [Cat("head", "KeywordLineItem")]),
        (name: "CommaKeywords", lhs: "KeywordList", rhs: [Cat("first", "KeywordLineItem"), Punct(','), Cat("rest", "KeywordList")]),
        (name: "SemicolonKeywords", lhs: "KeywordList", rhs: [Cat("first", "KeywordLineItem"), Punct(';'), Cat("rest", "KeywordList")]),
        (name: "TypesOnly", lhs: "TypeLine", rhs: [Cat("head", "CardTypes")]),
        (name: "TypesWithSubtypes", lhs: "TypeLine", rhs: [Cat("head", "CardTypes"), Mark('—', Free), Cat("subtypes", "Subtypes")]),
        (name: "SupertypePrefix", lhs: "TypeLine", rhs: [Class("modifier", "Supertype"), Cat("head", "TypeLine")]),
        (name: "SingleCardType", lhs: "CardTypes", rhs: [Class("head", "CardType")], equations: [Require("head.Number", "Singular")]),
        (name: "MultipleCardTypes", lhs: "CardTypes", rhs: [Class("first", "CardType"), Cat("rest", "CardTypes")], equations: [Require("first.Number", "Singular")]),
        (name: "SingleSubtype", lhs: "Subtypes", rhs: [Class("head", "Subtype")], equations: [Require("head.Number", "Singular")]),
        (name: "MultipleSubtypes", lhs: "Subtypes", rhs: [Class("first", "Subtype"), Cat("rest", "Subtypes")], equations: [Require("first.Number", "Singular")]),
        (name: "NumericAmount", lhs: "Amount", rhs: [Numeral("head", Arabic(false))], equations: [Agree("$.QuantityNumber", "head.Number")]),
        (name: "VariableAmount", lhs: "Amount", rhs: [Class("head", "Variable")], equations: [Agree("$.QuantityNumber", "head.Number")]),
        (name: "SingleSymbol", lhs: "Symbols", rhs: [Class("head", "BracedSymbol")]),
        (name: "SymbolSequence", lhs: "Symbols", rhs: [Class("first", "BracedSymbol"), Attached("rest", "Symbols", Suffix)]),
        (name: "SymbolCost", lhs: "Cost", rhs: [Cat("head", "SymbolCosts")]),
        (name: "SingleSymbolCost", lhs: "SymbolCosts", rhs: [Cat("head", "Symbols")]),
        (name: "CostSequence", lhs: "SymbolCosts", rhs: [Cat("first", "Symbols"), Punct(','), Cat("rest", "SymbolCosts")]),
        (name: "NegativeLoyaltySymbolCost", lhs: "ActivationCost", rhs: [Mark('−', Prefix), Cat("amount", "Amount")]),
        (name: "PositiveLoyaltySymbolCost", lhs: "ActivationCost", rhs: [Mark('+', Prefix), Cat("amount", "Amount")]),
        (name: "ZeroLoyaltySymbolCost", lhs: "ActivationCost", rhs: [Cat("amount", "Amount")]),
        (name: "LoyaltySymbol", lhs: "LoyaltySymbol", rhs: [Mark('[', Prefix), Cat("amount", "Amount"), Punct(']')]),
        (name: "UnicodeNegativeLoyaltySymbol", lhs: "LoyaltySymbol", rhs: [Mark('[', Prefix), Mark('−', Bound), Cat("amount", "Amount"), Punct(']')]),
        (name: "PositiveLoyaltySymbol", lhs: "LoyaltySymbol", rhs: [Mark('[', Prefix), Mark('+', Bound), Cat("amount", "Amount"), Punct(']')]),
        (name: "LoyaltyCost", lhs: "ActivationCost", rhs: [Cat("head", "LoyaltySymbol")]),
        (name: "LoyaltyNominal", lhs: "BareNominal", rhs: [Cat("head", "LoyaltySymbol")], equations: [Require("$.Number", "Singular"), Require("$.Countability", "Count")]),
        (name: "VerbalCost", lhs: "NonManaCost", rhs: [Cat("head", "VerbPhrase")], equations: [Require("head.VerbForm", "Plain")]),
        (name: "CompositeNonManaCost", lhs: "NonManaCost", rhs: [Cat("first", "Symbols"), Punct(','), Cat("rest", "NonManaCost")]),
        (name: "NonManaCost", lhs: "Cost", rhs: [Cat("head", "NonManaCost")]),
        (name: "ActivatedAbility", lhs: "Ability", rhs: [Cat("cost", "ActivationCost"), Punct(':'), Cat("effect", "Effect")]),
        (name: "LabelledAbility", lhs: "Ability", rhs: [Class("label", "AbilityWord"), Mark('—', Free), Cat("head", "Ability")]),
        // A mode labelled by an Anchor Word [CR#614.12c]: *• Khans — ...*.
        (name: "AnchoredAbility", lhs: "Ability", rhs: [Class("label", "AnchorWord"), Mark('—', Free), Cat("head", "Ability")]),
        (name: "FlavorLabelledAbility", lhs: "Ability", rhs: [Lex("label", FlavorWord), Cat("head", "Ability")]),
        (name: "NominalMode", lhs: "Mode", rhs: [Mark('•', Free), Cat("head", "Nominal"), Punct('.')], equations: [Require("head.Determination", "Bare")]),
        (name: "NounPhraseMode", lhs: "Mode", rhs: [Mark('•', Free), Cat("head", "NounPhrase"), Punct('.')]),
        (name: "KeywordFollowedBySentences", lhs: "Ability", rhs: [Cat("first", "KeywordList"), Cat("rest", "Sentences")]),
        (name: "NamePremodifier", lhs: "BareNominal", rhs: [Cat("modifier", "Name"), Cat("head", "BareNominal")]),
        (name: "ModeBullet", lhs: "Mode", rhs: [Mark('•', Free), Cat("head", "Ability")]),
        (name: "CostedModeBullet", lhs: "Mode", rhs: [Mark('•', Free), Cat("cost", "Cost"), Mark('—', Free), Cat("head", "ModeEffect")]),
        (name: "PlusCostedMode", lhs: "Mode", rhs: [Mark('+', Free), Cat("cost", "Cost"), Mark('—', Free), Cat("head", "ModeEffect")]),
        (name: "LabelledCostedMode", lhs: "Mode", rhs: [Mark('•', Free), Lex("label", FlavorWord), Cat("cost", "Cost"), Mark('—', Free), Cat("head", "ModeEffect")]),
        (name: "PawprintMode", lhs: "Mode", rhs: [Cat("quantity", "Pawprints"), Mark('—', Free), Cat("head", "ModeEffect")]),
        (name: "SinglePawprint", lhs: "Pawprints", rhs: [Class("head", "Pawprint")]),
        (name: "PawprintSequence", lhs: "Pawprints", rhs: [Class("first", "Pawprint"), Attached("rest", "Pawprints", Suffix)]),
        (name: "SingleSentence", lhs: "Sentences", rhs: [Cat("head", "Sentence")]),
        (name: "SentenceSequence", lhs: "Sentences", rhs: [Cat("first", "Sentence"), Cat("rest", "Sentences")]),
        (name: "SentenceEffect", lhs: "Effect", rhs: [Cat("head", "Sentences")]),
        (name: "ModeInstruction", lhs: "ModeEffect", rhs: [Cat("head", "Effect")]),
        (name: "ModeMeasure", lhs: "ModeEffect", rhs: [Cat("head", "Measure"), Punct('.')]),
        (name: "SingularNominalQuality", lhs: "Quality", rhs: [Cat("head", "Nominal")], equations: [Require("head.Number", "Singular")]),
        (name: "NominalPhraseQuality", lhs: "Quality", rhs: [Cat("head", "NounPhrase")]),
        (name: "AdjectivalQuality", lhs: "Quality", rhs: [Cat("head", "AdjectivePhrase")]),
        (name: "NamedParameter", lhs: "Name", rhs: [Lex("head", Catalog)]),
        (name: "SlashMeasure", lhs: "Measure", rhs: [Cat("first", "SignedAmount"), Mark('/', Bound), Cat("second", "SignedAmount")]),
        (name: "MeasureHeader", lhs: "Header", rhs: [Cat("head", "Measure")]),
        (name: "RangeHeader", lhs: "Header", rhs: [Class("marker", "RangeMarker"), Cat("lower", "Amount"), Mark('-', Bound), Cat("upper", "Amount")]),
        (name: "OpenRangeHeader", lhs: "Header", rhs: [Class("marker", "RangeMarker"), Cat("lower", "Amount"), Punct('+')]),
        (name: "SingleChapter", lhs: "Chapters", rhs: [Numeral("head", Roman)]),
        (name: "ChapterSequence", lhs: "Chapters", rhs: [Numeral("first", Roman), Punct(','), Cat("rest", "Chapters")]),
        (name: "ChapterAbility", lhs: "Ability", rhs: [Cat("chapters", "Chapters"), Mark('—', Free), Cat("head", "Ability")]),
        // An imperative or declarative Clause, with any preposed adjunct
        // (*When this creature enters, choose one —*).
        (name: "ChoiceHeader", lhs: "ModalHeader", rhs: [Cat("head", "Clause"), Mark('—', Free)], equations: [Require("head.ClauseMarking", "Unmarked"), Exclude("head.Inflection", "Irrealis")]),

        // Sentences: a bare imperative or a declarative clause.
        (name: "Imperative", lhs: "Clause", rhs: [Cat("head", "VerbPhrase")], uncoordinated: ["head"],
            equations: [Require("head.VerbForm", "Plain"), Require("$.ClauseMarking", "Unmarked")]),
        (name: "ClauseFragment", lhs: "Document", rhs: [Cat("head", "Clause")]),
        (name: "Declarative", lhs: "Sentence", rhs: [Cat("clause", "Clause"), Punct('.')], equations: [Require("clause.ClauseMarking", "Unmarked"), Exclude("clause.Inflection", "Irrealis")]),
        (name: "SubjectPredicate", lhs: "Clause",
            rhs: [Cat("subject", "NounPhrase"), Free("head", "VerbPhrase")],
            equations: [
                Agree("subject.Number", "head.Number"),
                Agree("subject.Person", "head.Person"),
                Require("head.VerbForm", "Finite"),
                Exclude("subject.Case", "Accusative"),
                Exclude("subject.NounKind", "Manner"),
                Require("$.ClauseMarking", "Unmarked"),
            ],
            transparent: ["head"]),
        // A bound auxiliary clitic (*'s*, *'re*, *'ve*, *'m*) has a
        // nominative pronoun host (*it's*, *you're*, *they've*).
        (name: "CliticSubjectPredicate", lhs: "Clause",
            rhs: [Cat("subject", "NounPhrase"), Attached("head", "VerbPhrase", Suffix)],
            equations: [
                Agree("subject.Number", "head.Number"),
                Agree("subject.Person", "head.Person"),
                Require("head.VerbForm", "Finite"),
                Require("subject.Case", "Nominative"),
                Require("$.ClauseMarking", "Unmarked"),
            ],
            transparent: ["head"]),

        // A gerund-participial Clause as Subject (*turning a face-down permanent
        // face up causes ...*; CGEL, Ch. 14 §7.1(c), p. 1254).
        (name: "GerundSubject", lhs: "Clause", rhs: [Cat("subject", "Gerund"), Cat("head", "VerbPhrase")],
            equations: [Require("head.VerbForm", "Finite"), Require("head.Number", "Singular"), Require("head.Person", "Third"), Require("$.ClauseMarking", "Unmarked")],
            transparent: ["head"]),

        // A gerund-participial clause with its Subject (*a creature you
        // control attacking causes ...*; CGEL, Ch. 14 §2.1, p. 1188).
        (name: "SubjectGerund", lhs: "GerundClause", rhs: [Cat("subject", "NounPhrase"), Cat("head", "VerbPhrase")],
            equations: [Require("head.VerbForm", "GerundParticiple"), Exclude("subject.Case", "Nominative"), Exclude("subject.Case", "Genitive")], cost: 2),
        (name: "GerundClauseSubject", lhs: "Clause", rhs: [Cat("subject", "GerundClause"), Cat("head", "VerbPhrase")],
            equations: [Require("head.VerbForm", "Finite"), Require("head.Number", "Singular"), Require("head.Person", "Third"), Require("$.ClauseMarking", "Unmarked")],
            transparent: ["head"]),

        // An existential clause: dummy *there*, the copula agreeing with the
        // displaced subject, and an optional locative complement.
        (name: "Existential", lhs: "Clause", rhs: [Cat("subject", "DummyPronoun"), Cat("head", "ExistentialPredicate")],
            equations: [Agree("subject.Number", "head.Number"), Agree("subject.Person", "head.Person"),
                Require("head.VerbForm", "Finite"), Require("$.ClauseMarking", "Unmarked")]),
        (name: "ExistentialThere", lhs: "DummyPronoun", rhs: [Lex("head", Pronoun)],
            equations: [Require("head.PronounKind", "Existential")]),
        (name: "ExistentialBe", lhs: "ExistentialPredicate", rhs: [Class("head", "BeVerb"), Cat("displaced_subject", "NounPhrase")],
            equations: [Agree("$.Number", "displaced_subject.Number"), Exclude("displaced_subject.Case", "Accusative")]),
        (name: "LocatedExistentialBe", lhs: "ExistentialPredicate", rhs: [Class("head", "BeVerb"), Cat("displaced_subject", "NounPhrase"), Cat("complement", "PrepositionPhrase")],
            equations: [Agree("$.Number", "displaced_subject.Number"), Exclude("displaced_subject.Case", "Accusative")]),

        (name: "EndAdverb", lhs: "AdverbPhrase", rhs: [Class("head", "EndAdverb")],
            equations: [Require("$.AdjunctPosition", "End")]),
        (name: "CentralAdverb", lhs: "AdverbPhrase", rhs: [Class("head", "CentralAdverb")],
            equations: [Require("$.AdjunctPosition", "Central")]),
        (name: "FrontAdverb", lhs: "AdverbPhrase", rhs: [Class("head", "FrontAdverb")],
            equations: [Require("$.AdjunctPosition", "Front")]),
        // A front adverbial set off by a comma (*Once each turn, ...*).
        (name: "FrontAdverbial", lhs: "Clause", rhs: [Cat("adjunct", "AdverbPhrase"), Punct(','), Cat("head", "Clause")],
            equations: [Require("adjunct.AdjunctPosition", "Front")], transparent: ["head"], cost: 2),
        // A comma-set passive participial Supplement (*there is an additional
        // combat phase after this phase, followed by an additional main
        // phase*; CGEL, Ch. 14 §9.1, p. 1265; Ch. 15 §5.1, p. 1350).
        (name: "ParticipialSupplement", lhs: "Clause", rhs: [Cat("head", "Clause"), Punct(','), Cat("supplement", "VerbPhrase")],
            equations: [Require("supplement.VerbForm", "PastParticiple"), Require("supplement.Voice", "Passive")], transparent: ["head"], heavy: ["supplement"], cost: 3),
        (name: "EndAdverbial", lhs: "VerbPhrase", rhs: [Cat("head", "VerbPhrase"), Cat("adjunct", "AdverbPhrase")],
            equations: [Require("adjunct.AdjunctPosition", "End")], transparent: ["head"]),
        (name: "CentralAdverbial", lhs: "VerbPhrase", rhs: [Cat("adjunct", "AdverbPhrase"), Cat("head", "VerbPhrase")],
            equations: [Require("adjunct.AdjunctPosition", "Central")], transparent: ["head"]),

        // Auxiliaries take a verb phrase complement through which a Gap passes.
        (name: "Progressive", lhs: "VerbPhrase", rhs: [Class("head", "BeVerb"), Cat("complement", "VerbPhrase")],
            equations: [Require("complement.VerbForm", "GerundParticiple"), Agree("$.Voice", "complement.Voice")],
            transparent: ["complement"]),
        // The perfect takes an active participle phrase or a passive one
        // headed by *been*.
        (name: "Perfect", lhs: "VerbPhrase", rhs: [Class("head", "HaveVerb"), Cat("complement", "VerbPhrase")],
            equations: [Require("complement.VerbForm", "PastParticiple"), Require("complement.Voice", "Active"),
                Require("$.Voice", "Active")],
            transparent: ["complement"]),
        (name: "PassivePerfect", lhs: "VerbPhrase", rhs: [Class("head", "HaveVerb"), Cat("complement", "VerbPhrase")],
            equations: [Require("complement.VerbForm", "PastParticiple"), Require("complement.Voice", "Passive"),
                Require("complement.VerbKind", "Auxiliary"), Require("$.Voice", "Passive")],
            transparent: ["complement"]),
        // The passive auxiliary takes a lexical verb's passive participle phrase.
        (name: "Passive", lhs: "VerbPhrase", rhs: [Class("head", "BeVerb"), Cat("complement", "VerbPhrase")],
            equations: [Require("complement.VerbForm", "PastParticiple"), Require("complement.Voice", "Passive"),
                Exclude("complement.VerbKind", "Auxiliary"), Require("$.Voice", "Passive")],
            transparent: ["complement"]),

        // Non-finite complements.
        (name: "ToInfinitival", lhs: "Clause", rhs: [Word("marker", "To"), Cat("head", "VerbPhrase")],
            equations: [Require("head.VerbForm", "Plain"), Require("$.ClauseMarking", "To")], transparent: ["head"]),
        (name: "ModifiedInfinitival", lhs: "Clause", rhs: [Cat("adjunct", "AdverbPhrase"), Cat("head", "Clause")],
            equations: [Require("adjunct.AdjunctPosition", "Phrasal"), Require("head.ClauseMarking", "To")], transparent: ["head"]),
        (name: "InfinitivalComplement", lhs: "ToInf", rhs: [Cat("head", "Clause")],
            equations: [Require("head.ClauseMarking", "To")], transparent: ["head"]),
        (name: "BareInfinitival", lhs: "BareInf", rhs: [Cat("head", "VerbPhrase")],
            equations: [Require("head.VerbForm", "Plain")], transparent: ["head"]),
        (name: "GerundParticipial", lhs: "Gerund", rhs: [Cat("head", "VerbPhrase")],
            equations: [Require("head.VerbForm", "GerundParticiple")], transparent: ["head"]),
        // A hollow *to*-infinitival (*this spell costs {1} to cast*; CGEL,
        // Ch. 14 §6.3(c), p. 1250).
        (name: "HollowInfinitival", lhs: "HollowInf", rhs: [Word("marker", "To"), Cat("head", "VerbPhrase")],
            equations: [Require("head.VerbForm", "Plain"), Require("head.Gap", "NP")]),
        // A purpose adjunct whose object Gap a relative clause binds (*the
        // first spell that mana from a Treasure was spent to cast*).
        (name: "GappedPurpose", lhs: "VerbPhrase", rhs: [Cat("head", "VerbPhrase"), Cat("adjunct", "ToInf")],
            equations: [Require("adjunct.Gap", "NP")], transparent: ["adjunct"]),
        // A central adverb before a copular verb's predicative Complement
        // (*is no longer snow*, *become no longer suspected*).
        (name: "PostCopularAdverbial", lhs: "VerbPhrase", rhs: [Class("head", "CopularVerb"), Cat("adjunct", "AdverbPhrase"), Cat("predicative_complement", "Predicative")],
            equations: [Require("adjunct.AdjunctPosition", "Central")]),

        (name: "PrepositionFragment", lhs: "Document", rhs: [Cat("head", "PrepositionPhrase")]),
        (name: "MeasurePremodifier", lhs: "BareNominal", rhs: [Cat("modifier", "Measure"), Cat("head", "BareNominal")]),
        // *its {1}{G} kicker*.
        // *five {P} worth of modes*.
        (name: "PawprintPremodifier", lhs: "BareNominal", rhs: [Cat("modifier", "Pawprints"), Cat("head", "BareNominal")]),
        (name: "SymbolPremodifier", lhs: "BareNominal", rhs: [Cat("modifier", "Symbols"), Cat("head", "BareNominal")]),
        (name: "MeasureNominal", lhs: "BareNominal", rhs: [Cat("head", "Measure")], equations: [Require("$.Number", "Singular"), Require("$.Countability", "Count")]),
        (name: "OrdinalAdjective", lhs: "AdjectivePhrase", rhs: [Numeral("head", Ordinal)]),
        (name: "InterleavedPreposition", lhs: "Interleaved", rhs: [Cat("head", "PrepositionPhrase")], cost: 0),
        (name: "InterleavedTemporal", lhs: "Interleaved", rhs: [Cat("head", "TemporalNounPhrase")], cost: 0),
        // An end adverb before a later selected Complement (*divided evenly
        // among*, *dealt to you so far this turn by artifacts*), or a
        // comma-set passive participial Supplement there (*divided evenly,
        // rounded down, among*; *deals half X damage, rounded down, to any
        // target*).
        (name: "InterleavedAdverb", lhs: "Interleaved", rhs: [Cat("head", "AdverbPhrase")], equations: [Require("head.AdjunctPosition", "End")], cost: 0),
        (name: "InterleavedSupplement", lhs: "Interleaved", rhs: [Punct(','), Cat("supplement", "VerbPhrase"), Punct(',')],
            equations: [Require("supplement.VerbForm", "PastParticiple"), Require("supplement.Voice", "Passive")], heavy: ["supplement"], cost: 3),
        (name: "InterleavedDepictive", lhs: "Interleaved", rhs: [Cat("head", "AdjectivePhrase")], equations: [Require("head.ComplementKind", "Intransitive"), Exclude("head.Voice", "Passive"), Exclude("head.Grade", "Comparative"), Exclude("head.Determination", "Overt"), Exclude("head.AdjectivePosition", "Attributive")], cost: 0),
        (name: "DepictiveAdjective", lhs: "VerbPhrase", rhs: [Cat("head", "VerbPhrase"), Cat("adjunct", "AdjectivePhrase")], equations: [Exclude("adjunct.Voice", "Passive"), Exclude("adjunct.Grade", "Comparative"), Exclude("adjunct.Determination", "Overt"), Exclude("adjunct.AdjectivePosition", "Attributive")], transparent: ["head"], cost: 2),

        (name: "PhrasalAdverb", lhs: "AdverbPhrase", rhs: [Class("head", "PhrasalAdverb")], equations: [Require("$.AdjunctPosition", "Phrasal")]),
        (name: "BoundingAdverb", lhs: "AdverbPhrase", rhs: [Class("head", "BoundingAdverb")], equations: [Require("$.AdjunctPosition", "Bounding")]),
        (name: "DegreeDeterminer", lhs: "DeterminerPhrase", rhs: [Word("modifier", "That"), Class("head", "DegreeQuantifier")], equations: [Require("$.ComplementKind", "Intransitive")]),
        // A modified degree determinative as a fused head (*that many*).
        (name: "FusedDegreeDeterminer", lhs: "FusedNounPhrase", rhs: [Cat("head", "DeterminerPhrase")], uncoordinated: ["head"], equations: [Require("head.ComplementKind", "Intransitive"), Require("head.DeterminativeDistribution", "Dependent"), Require("$.NounKind", "Ordinary"), Require("$.Determination", "Bare"), Require("$.Case", "Plain"), Require("$.Person", "Third")], heavy: ["head"]),
        // A focusing or multiplying adverb modifies a Noun Phrase (*only one
        // target*, *twice X life*); a bounding one, its quantity (*at least
        // one creature*).
        (name: "AdverbModifiedNounPhrase", lhs: "NounPhrase", rhs: [Cat("modifier", "AdverbPhrase"), Cat("head", "NounPhrase")], equations: [Require("modifier.AdjunctPosition", "Phrasal"), Exclude("head.NounKind", "Numeric")]),
        (name: "AdverbModifiedPrepositionPhrase", lhs: "PrepositionPhrase", rhs: [Cat("modifier", "AdverbPhrase"), Cat("head", "PrepositionPhrase")], equations: [Require("modifier.AdjunctPosition", "Phrasal")]),
        (name: "AdverbModifiedDeterminerPhrase", lhs: "DeterminerPhrase", rhs: [Cat("modifier", "AdverbPhrase"), Cat("head", "DeterminerPhrase")], equations: [Require("modifier.AdjunctPosition", "Bounding"), Require("head.DeterminativeDistribution", "Numerical")]),
        // A focused predicative adjective (*attack only alone*).
        (name: "AdverbModifiedAdjectivePhrase", lhs: "AdjectivePhrase", rhs: [Cat("modifier", "AdverbPhrase"), Cat("head", "AdjectivePhrase")], equations: [Require("modifier.AdjunctPosition", "Phrasal"), Require("head.AdjectivePosition", "Predicative"), Require("$.AdjectivePosition", "Predicative")]),
        // A phrasal adverb modifies a single adverb, inside any frequency
        // interval (*[so far] this turn*, *[only once] each turn*).
        (name: "AdverbModifiedAdverbPhrase", lhs: "AdverbPhrase", rhs: [Cat("modifier", "AdverbPhrase"), Cat("head", "AdverbPhrase")], equations: [Require("modifier.AdjunctPosition", "Phrasal")], light: ["head"]),
        (name: "PredeterminerCount", lhs: "NounPhrase", rhs: [Class("determiner", "Predeterminer"), Cat("head", "NounPhrase")], equations: [Require("head.Determination", "Overt"), Require("head.Number", "Plural"), Agree("determiner.Number", "head.Number"), Agree("determiner.Countability", "head.Countability")]),
        (name: "PredeterminerMass", lhs: "NounPhrase", rhs: [Class("determiner", "Predeterminer"), Cat("head", "NounPhrase")], equations: [Require("head.Determination", "Overt"), Require("head.Countability", "Mass"), Require("head.Number", "Singular"), Agree("determiner.Number", "head.Number"), Agree("determiner.Countability", "head.Countability")]),
        (name: "SingularQuantifier", lhs: "DeterminerPhrase", rhs: [Word("head", "Any"), Numeral("modifier", Cardinal)], equations: [Require("modifier.Number", "Singular"), Require("$.Number", "Singular"), Require("$.ComplementKind", "Intransitive")]),
        // A temporal Noun Phrase Adjunct: a period noun with a deictic or
        // distributive determinative (*this turn*, *each combat*), never with
        // an article or genitive (*the turn*), and without postmodifiers;
        // serial *time* with any determinative (*any time*, *an additional
        // time*, *three times*); or a temporal nominal bounded by a relative
        // clause (*the next time you cast a spell*; CGEL, Ch. 8 §6.3, p. 698).
        (name: "TemporalLocation", lhs: "TemporalNounPhrase", rhs: [Cat("determiner", "DeterminerPhrase"), Cat("head", "BareNominal")],
            equations: [Require("head.NounKind", "Temporal"), Exclude("head.NounDistribution", "Serial"), Exclude("determiner.DeterminativeDistribution", "Dependent"), Exclude("determiner.DeterminativeDistribution", "FreeChoice"), Exclude("determiner.DeterminativeDistribution", "Independent"), Exclude("determiner.DeterminativeDistribution", "Numerical"), Exclude("determiner.DeterminativeDistribution", "IndefiniteArticle"), Exclude("determiner.DeterminativeDistribution", "SingularOrQuantified"),
                Agree("determiner.NounKind", "head.NounKind"), Agree("determiner.Countability", "head.Countability"), Agree("determiner.Number", "head.Number"), Require("$.Determination", "Overt"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        (name: "SerialTemporal", lhs: "TemporalNounPhrase", rhs: [Cat("determiner", "DeterminerPhrase"), Cat("head", "BareNominal")],
            equations: [Require("head.NounDistribution", "Serial"), Exclude("determiner.DeterminativeDistribution", "Independent"), Agree("determiner.NounKind", "head.NounKind"), Agree("determiner.Countability", "head.Countability"), Agree("determiner.Number", "head.Number"), Require("$.Determination", "Overt"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        // A focused temporal adjunct (*only any time they could cast a sorcery*).
        (name: "AdverbModifiedTemporal", lhs: "TemporalNounPhrase", rhs: [Cat("modifier", "AdverbPhrase"), Cat("head", "TemporalNounPhrase")], equations: [Require("modifier.AdjunctPosition", "Phrasal")]),
        (name: "RelativeTemporalLocation", lhs: "TemporalNounPhrase", rhs: [Cat("determiner", "DeterminerPhrase"), Cat("head", "RelativeTemporalNominal")],
            equations: [Exclude("determiner.DeterminativeDistribution", "Independent"), Agree("determiner.NounKind", "head.NounKind"), Agree("determiner.Countability", "head.Countability"), Agree("determiner.Number", "head.Number"), Require("$.Determination", "Overt"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        (name: "RelativeTime", lhs: "RelativeTemporalNominal", rhs: [Cat("head", "Nominal"), Cat("modifier", "RelativeClause")],
            equations: [Require("head.NounKind", "Temporal"), Agree("head.Number", "modifier.Number"), Agree("head.NounKind", "modifier.NounKind")]),
        (name: "RelativeTimePostmodifier", lhs: "RelativeTemporalNominal", rhs: [Cat("head", "RelativeTemporalNominal"), Cat("modifier", "TemporalNounPhrase")], cost: 2),
        // A preposed temporal Noun Phrase (*This turn, ...*; *The next time ..., ...*).
        (name: "PreposedTemporalAdjunct", lhs: "Clause", rhs: [Cat("adjunct", "TemporalNounPhrase"), Punct(','), Cat("head", "Clause")], transparent: ["head"]),
        // A preposed Preposition Phrase and temporal Noun Phrase set off by
        // one comma (*For one spell this turn, ...*).
        (name: "PreposedPrepositionAndTemporal", lhs: "Clause", rhs: [Hosted("adjunct", "PrepositionPhrase", Predicate), Cat("adjunct", "TemporalNounPhrase"), Punct(','), Cat("head", "Clause")], transparent: ["head"], cost: 2),
        // *the first time each turn*: a temporal Noun Phrase modifies a
        // temporal nominal.
        (name: "TemporalPostmodifier", lhs: "Nominal", rhs: [Cat("head", "Nominal"), Cat("modifier", "TemporalNounPhrase")],
            equations: [Require("head.NounKind", "Temporal")], cost: 2),
        (name: "TemporalAdjunct", lhs: "VerbPhrase", rhs: [Cat("head", "VerbPhrase"), Cat("adjunct", "TemporalNounPhrase")], transparent: ["head"], cost: 2),
        (name: "MannerAdjunct", lhs: "VerbPhrase", rhs: [Cat("head", "VerbPhrase"), Cat("adjunct", "NounPhrase")], equations: [Require("adjunct.NounKind", "Manner")], transparent: ["head"], cost: 2),
        (name: "FrequencyInterval", lhs: "AdverbPhrase", rhs: [Cat("head", "AdverbPhrase"), Cat("adjunct", "TemporalNounPhrase")], equations: [Exclude("head.AdjunctPosition", "Central"), Exclude("head.AdjunctPosition", "Phrasal")]),
        (name: "NumericCountPremodifier", lhs: "QuantifiedNominal", rhs: [Cat("modifier", "Amount"), Cat("head", "BareNominal")], equations: [Agree("$.QuantityNumber", "head.Number"), Require("head.Countability", "Count"), Agree("modifier.QuantityNumber", "head.Number")]),
        (name: "NumericMassPremodifier", lhs: "QuantifiedNominal", rhs: [Cat("modifier", "Amount"), Cat("head", "BareNominal")], equations: [Agree("$.QuantityNumber", "head.Number"), Require("head.Countability", "Mass"), Require("head.NounDistribution", "DirectMeasure")]),
        (name: "CardinalCountPremodifier", lhs: "QuantifiedNominal", rhs: [Numeral("modifier", Cardinal), Cat("head", "BareNominal")], equations: [Agree("$.QuantityNumber", "head.Number"), Require("head.Countability", "Count"), Agree("modifier.Number", "head.Number")]),
        (name: "CardinalMassPremodifier", lhs: "QuantifiedNominal", rhs: [Numeral("modifier", Cardinal), Cat("head", "BareNominal")], equations: [Agree("$.QuantityNumber", "head.Number"), Require("head.Countability", "Mass"), Require("head.NounDistribution", "DirectMeasure")]),
        (name: "ModifiedQuantity", lhs: "ModifiedQuantifiedNominal", rhs: [Cat("modifier", "AdjectivePhrase"), Cat("head", "QuantifiedNominal")], equations: [Require("modifier.ComplementKind", "Intransitive"), Exclude("modifier.Voice", "Passive"), Exclude("modifier.AdjectivePosition", "Predicative")]),
        (name: "DeterminedQuantity", lhs: "NounPhrase", rhs: [Cat("determiner", "DeterminerPhrase"), Cat("head", "QuantifiedNominal")], equations: [Agree("determiner.Number", "head.QuantityNumber"), Exclude("determiner.DeterminativeDistribution", "SingularOrQuantified"), Exclude("determiner.DeterminativeDistribution", "Independent"), Exclude("determiner.DeterminativeDistribution", "Distributive"), Exclude("determiner.DeterminativeDistribution", "IndefiniteArticle"), Agree("$.Number", "head.QuantityNumber"), Require("determiner.Countability", "Count"), Agree("determiner.NounKind", "head.NounKind"), Require("$.Countability", "Count"), Require("$.Case", "Plain"), Require("$.Person", "Third"), Require("$.Determination", "Overt")]),
        (name: "SingularOrQuantifiedDetermination", lhs: "NounPhrase", rhs: [Cat("determiner", "DeterminerPhrase"), Cat("head", "QuantifiedNominal")], equations: [Require("determiner.DeterminativeDistribution", "SingularOrQuantified"), Agree("$.Number", "head.QuantityNumber"), Require("determiner.Countability", "Count"), Agree("determiner.NounKind", "head.NounKind"), Require("$.Countability", "Count"), Require("$.Case", "Plain"), Require("$.Person", "Third"), Require("$.Determination", "Overt")]),
        (name: "DistributiveQuantity", lhs: "NounPhrase", rhs: [Cat("determiner", "DeterminerPhrase"), Cat("head", "QuantifiedNominal")], equations: [Require("determiner.DeterminativeDistribution", "Distributive"), Agree("$.Number", "determiner.Number"), Require("determiner.Countability", "Count"), Agree("determiner.NounKind", "head.NounKind"), Require("$.Countability", "Count"), Require("$.Case", "Plain"), Require("$.Person", "Third"), Require("$.Determination", "Overt")]),
        (name: "DeterminedModifiedQuantity", lhs: "NounPhrase", rhs: [Cat("determiner", "DeterminerPhrase"), Cat("head", "ModifiedQuantifiedNominal")], equations: [Exclude("determiner.DeterminativeDistribution", "Dependent"), Exclude("determiner.DeterminativeDistribution", "FreeChoice"), Exclude("determiner.DeterminativeDistribution", "Deictic"), Exclude("determiner.DeterminativeDistribution", "Numerical"), Exclude("determiner.DeterminativeDistribution", "Independent"), Exclude("determiner.DeterminativeDistribution", "Distributive"), Agree("$.Number", "head.QuantityNumber"), Require("determiner.Countability", "Count"), Agree("determiner.NounKind", "head.NounKind"), Require("$.Countability", "Count"), Require("$.Case", "Plain"), Require("$.Person", "Third"), Require("$.Determination", "Overt")]),
        (name: "AgreeingModifiedQuantity", lhs: "NounPhrase", rhs: [Cat("determiner", "DeterminerPhrase"), Cat("head", "ModifiedQuantifiedNominal")], equations: [Agree("determiner.Number", "head.QuantityNumber"), Exclude("determiner.DeterminativeDistribution", "SingularOrQuantified"), Exclude("determiner.DeterminativeDistribution", "IndefiniteArticle"), Exclude("determiner.DeterminativeDistribution", "Independent"), Exclude("determiner.DeterminativeDistribution", "Distributive"), Agree("$.Number", "head.QuantityNumber"), Require("determiner.Countability", "Count"), Agree("determiner.NounKind", "head.NounKind"), Require("$.Countability", "Count"), Require("$.Case", "Plain"), Require("$.Person", "Third"), Require("$.Determination", "Overt")]),
        (name: "DistributiveModifiedQuantity", lhs: "NounPhrase", rhs: [Cat("determiner", "DeterminerPhrase"), Cat("head", "ModifiedQuantifiedNominal")], equations: [Require("determiner.DeterminativeDistribution", "Distributive"), Agree("$.Number", "determiner.Number"), Require("determiner.Countability", "Count"), Agree("determiner.NounKind", "head.NounKind"), Require("$.Countability", "Count"), Require("$.Case", "Plain"), Require("$.Person", "Third"), Require("$.Determination", "Overt")]),
        // A maximum quantity: a Preposition Phrase in Determiner function (*up
        // to two target creatures*; CGEL, Ch. 5 §7.1, p. 357), or the fused
        // head of its Noun Phrase (*choose up to one*). Its Complement is a
        // bare quantity, never a determined Noun Phrase.
        (name: "MaximumDetermination", lhs: "NounPhrase", rhs: [Selected("determiner", "PrepositionPhrase", ["Up"]), Cat("head", "Nominal")],
            equations: [Require("determiner.ComplementKind", "PP"), Require("determiner.Determination", "Bare"), Agree("determiner.Number", "head.Number"), Require("head.Countability", "Count"), Require("$.Determination", "Overt"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        // A maximum measure of a mass noun (*up to five {P} worth of modes*;
        // [CR#700.2i]).
        (name: "MaximumMeasuredMass", lhs: "NounPhrase", rhs: [Selected("determiner", "PrepositionPhrase", ["Up"]), Cat("head", "Nominal")],
            equations: [Require("determiner.ComplementKind", "PP"), Require("determiner.Determination", "Bare"), Exclude("determiner.Countability", "Count"), Require("head.NounDistribution", "DirectMeasure"), Require("head.Countability", "Mass"), Require("head.Number", "Singular"), Require("$.Determination", "Overt"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        (name: "FusedMaximum", lhs: "NounPhrase", rhs: [Selected("head", "PrepositionPhrase", ["Up"])],
            equations: [Require("head.ComplementKind", "PP"), Require("head.Determination", "Bare"), Require("$.NounKind", "Ordinary"), Require("$.Countability", "Count"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        // A comparative determinative fused head modified by a measure phrase
        // (*costs {1} less to cast*; CGEL, Ch. 13 §4.4, pp. 1125–1126).
        (name: "MeasuredComparativeHead", lhs: "NounPhrase", rhs: [Cat("modifier", "NounPhrase"), Class("head", "ComparativeQuantifier")],
            equations: [Require("modifier.Case", "Plain"), Exclude("modifier.Countability", "Count"), Require("$.NounKind", "Ordinary"), Require("$.Number", "Singular"), Require("$.Determination", "Bare"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        // Partitive Noun Phrases: a determinative fused head with its selected
        // *of* oblique (CGEL, Ch. 5 §9.3, pp. 408–410). The Noun Phrase takes
        // its Number from the oblique, a distributive head's singular from the
        // head, and *any* may be singular with a plural oblique (*if any of
        // those cards shares a card type*).
        (name: "Partitive", lhs: "PartitiveNounPhrase", rhs: [Cat("head", "DeterminerPhrase")], uncoordinated: ["head"],
            equations: [Require("head.ComplementKind", "PP"), Require("head.PrepositionMarking", "Oblique"), Exclude("head.DeterminativeDistribution", "Distributive"), Exclude("head.DeterminativeDistribution", "SingularOrQuantified"), Agree("$.Number", "head.ObliqueNumber"), Require("$.NounKind", "Ordinary"), Require("$.Determination", "Overt"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        (name: "DistributivePartitive", lhs: "PartitiveNounPhrase", rhs: [Cat("head", "DeterminerPhrase")], uncoordinated: ["head"],
            equations: [Require("head.ComplementKind", "PP"), Require("head.PrepositionMarking", "Oblique"), Require("head.ObliqueNumber", "Plural"), Exclude("head.DeterminativeDistribution", "Dependent"), Exclude("head.DeterminativeDistribution", "FreeChoice"), Exclude("head.DeterminativeDistribution", "Independent"), Exclude("head.DeterminativeDistribution", "Numerical"), Exclude("head.DeterminativeDistribution", "IndefiniteArticle"), Exclude("head.DeterminativeDistribution", "Deictic"), Require("$.NounKind", "Ordinary"), Require("$.Determination", "Overt"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        // Distributive *each* with a plural oblique takes plural agreement
        // by synesis (*Each of X target creatures you control connive*;
        // CGEL, Ch. 5 §18.2, p. 504); its Number is the oblique's, not the
        // singular quantifier's.
        (name: "SynesisDistributivePartitive", lhs: "PartitiveNounPhrase", rhs: [Word("quantifier", "Each"), Selected("complement", "PrepositionPhrase", ["Of"])],
            equations: [Require("complement.ComplementKind", "NP"), Require("complement.Number", "Plural"), Require("complement.Case", "Plain"), Require("$.Number", "Plural"), Require("$.NounKind", "Ordinary"), Require("$.Determination", "Overt"), Require("$.Case", "Nominative"), Require("$.Person", "Third")], cost: 3),
        // *Any* with a plural oblique leaves the Noun Phrase's Number open.
        (name: "AnyPartitive", lhs: "PartitiveNounPhrase", rhs: [Word("head", "Any"), Selected("complement", "PrepositionPhrase", ["Of"])],
            equations: [Require("complement.ComplementKind", "NP"), Require("complement.Number", "Plural"), Require("$.NounKind", "Ordinary"), Require("$.Determination", "Overt"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        (name: "AnyMassPartitive", lhs: "PartitiveNounPhrase", rhs: [Word("head", "Any"), Selected("complement", "PrepositionPhrase", ["Of"])],
            equations: [Require("complement.ComplementKind", "NP"), Require("complement.Number", "Singular"), Require("$.Number", "Singular"), Require("$.NounKind", "Ordinary"), Require("$.Determination", "Overt"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        // A quantity with a partitive oblique (*up to two of them*, *that many
        // of those tokens*, *1 of that damage*).
        (name: "MaximumPartitive", lhs: "PartitiveNounPhrase", rhs: [Selected("head", "PrepositionPhrase", ["Up"]), Selected("complement", "PrepositionPhrase", ["Of"])],
            equations: [Require("head.ComplementKind", "PP"), Require("head.Determination", "Bare"), Require("complement.ComplementKind", "NP"), Require("$.NounKind", "Ordinary"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        (name: "QuantityPartitive", lhs: "PartitiveHead", rhs: [Cat("head", "DeterminerPhrase"), Selected("complement", "PrepositionPhrase", ["Of"])],
            equations: [Require("head.ComplementKind", "Intransitive"), Require("head.DeterminativeDistribution", "Numerical"),
                Require("complement.ComplementKind", "NP"), Require("$.NounKind", "Ordinary"), Require("$.Determination", "Overt"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        // A modified degree determinative (*that many of those tokens*); a
        // bare one selects its oblique.
        (name: "DegreePartitive", lhs: "PartitiveHead", rhs: [Cat("head", "DeterminerPhrase"), Selected("complement", "PrepositionPhrase", ["Of"])],
            equations: [Require("head.ComplementKind", "Intransitive"), Require("head.DeterminativeDistribution", "Dependent"),
                Require("complement.ComplementKind", "NP"), Require("$.NounKind", "Ordinary"), Require("$.Determination", "Overt"), Require("$.Case", "Plain"), Require("$.Person", "Third")], heavy: ["head"]),
        (name: "PostpositiveAdjective", lhs: "Nominal", rhs: [Cat("head", "Nominal"), Cat("modifier", "AdjectivePhrase")],
            equations: [Require("modifier.ComplementKind", "PP"), Exclude("modifier.Voice", "Passive")], heavy: ["modifier"]),
        // An amount or a comparative adjective with that amount its
        // understood standard (*power 3 or greater*, *X is 2 or less*).
        (name: "ScalarAlternative", lhs: "Amount", rhs: [Cat("head", "Amount"), Word("coordinator", "Or"), Cat("last", "AdjectivePhrase")],
            equations: [Require("last.Grade", "Comparative"), Require("last.ComplementKind", "Intransitive")]),
        // A postpositive comparative quantity (*for each card fewer than
        // three in their hand*).
        (name: "PostpositiveComparative", lhs: "Nominal", rhs: [Cat("head", "Nominal"), Cat("modifier", "DeterminerPhrase")],
            equations: [Require("head.Number", "Singular"), Require("modifier.ComplementKind", "PP"), Require("modifier.PrepositionMarking", "Comparative"), Require("modifier.Number", "Plural"), Exclude("modifier.ObliqueKind", "AdvP")], heavy: ["modifier"], cost: 2),
        (name: "PostpositiveLocativeAdjective", lhs: "LocativeHead", rhs: [Cat("head", "LocativeHead"), Cat("modifier", "AdjectivePhrase")],
            equations: [Require("modifier.ComplementKind", "PP"), Exclude("modifier.Voice", "Passive")], heavy: ["modifier"]),
        // A comparative adjective modified by a measure phrase (*2 greater*;
        // CGEL, Ch. 13 §4.4, pp. 1125–1126).
        (name: "MeasuredComparative", lhs: "AdjectivePhrase", rhs: [Cat("modifier", "NounPhrase"), Cat("head", "AdjectivePhrase")],
            equations: [Require("head.Grade", "Comparative"), Require("head.ComplementKind", "Intransitive"), Require("modifier.Determination", "Bare"), Require("modifier.Case", "Plain"), Exclude("head.AdjectivePosition", "Attributive")]),
        // A superlative quantifier under the definite article (*the most
        // creatures*, *the least life*; CGEL, Ch. 5 §6.1, p. 393), with a
        // plural count or a mass head.
        (name: "SuperlativeCountDeterminer", lhs: "DeterminerPhrase", rhs: [Word("marker", "The"), Class("head", "SuperlativeQuantifier")],
            equations: [Require("$.Number", "Plural"), Require("$.Countability", "Count"), Require("$.ComplementKind", "Intransitive")]),
        (name: "SuperlativeMassDeterminer", lhs: "DeterminerPhrase", rhs: [Word("marker", "The"), Class("head", "SuperlativeQuantifier")],
            equations: [Require("$.Number", "Singular"), Require("$.Countability", "Mass"), Require("$.ComplementKind", "Intransitive")]),
        // A comparative determinative with its *than* Complement after the
        // head (*more lands than you*, *less life than an opponent*; CGEL,
        // Ch. 13 §2.1, p. 1104), of a plural count or a mass head.
        (name: "ComparativeCountDetermined", lhs: "NounPhrase", rhs: [Class("determiner", "ComparativeQuantifier"), Cat("head", "Nominal"), Selected("complement", "PrepositionPhrase", ["Than"])],
            equations: [Require("head.Number", "Plural"), Require("head.Countability", "Count"), Agree("determiner.Number", "head.Number"), Agree("determiner.Countability", "head.Countability"), Require("$.Determination", "Overt"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        (name: "ComparativeMassDetermined", lhs: "NounPhrase", rhs: [Class("determiner", "ComparativeQuantifier"), Cat("head", "Nominal"), Selected("complement", "PrepositionPhrase", ["Than"])],
            equations: [Require("head.Number", "Singular"), Require("head.Countability", "Mass"), Agree("determiner.Number", "head.Number"), Agree("determiner.Countability", "head.Countability"), Require("$.Determination", "Overt"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        // A determinative modifying a comparative (*no more than one*, *many
        // more than two*; CGEL, Ch. 13 §4.4, p. 1126).
        (name: "ModifiedComparativeDeterminer", lhs: "DeterminerPhrase", rhs: [Lex("modifier", Determinative), Cat("head", "DeterminerPhrase")],
            equations: [Require("head.ComplementKind", "PP"), Require("head.PrepositionMarking", "Comparative"), Exclude("modifier.DeterminativeDistribution", "Independent"), Exclude("modifier.DeterminativeDistribution", "Numerical"), Exclude("modifier.DeterminativeDistribution", "IndefiniteArticle"), Exclude("modifier.DeterminativeDistribution", "Distributive"), Exclude("modifier.DeterminativeDistribution", "Deictic"), Exclude("modifier.DeterminativeDistribution", "SingularOrQuantified")]),
        // Arithmetic: *plus* and *minus* head Preposition Phrases modifying a
        // quantity (*2 plus the number of ...*, *X plus 3 life*, *that many plus
        // one*).
        (name: "AmountArithmetic", lhs: "Amount", rhs: [Cat("head", "Amount"), Selected("modifier", "PrepositionPhrase", ["Plus", "Minus"])],
            equations: [Require("modifier.ComplementKind", "Amount")]),
        // *X minus one*: a bare quantity operand.
        (name: "AmountQuantityArithmetic", lhs: "Amount", rhs: [Cat("head", "Amount"), Selected("modifier", "PrepositionPhrase", ["Plus", "Minus"])],
            equations: [Require("modifier.ComplementKind", "NP"), Require("modifier.Determination", "Bare")]),
        // *X minus one 2/2 ... tokens*: an arithmetic determiner.
        (name: "ArithmeticDeterminer", lhs: "NumericalDeterminer", rhs: [Cat("head", "NumericalDeterminer"), Selected("modifier", "PrepositionPhrase", ["Plus", "Minus"])],
            equations: [Require("modifier.ComplementKind", "NP"), Require("modifier.Determination", "Bare"), Exclude("modifier.Case", "Genitive")]),
        // *three times X*: a multiplied amount, or determiner (*three times X
        // cards*).
        (name: "MultipliedDeterminer", lhs: "NumericalDeterminer", rhs: [Numeral("factor", Cardinal), Cat("multiplier", "BareNominal"), Cat("head", "NumericalDeterminer")],
            equations: [Require("multiplier.NounDistribution", "Serial"), Require("multiplier.Number", "Plural")]),
        // *three times this creature's power*.
        (name: "MultipliedNounPhrase", lhs: "NounPhrase", rhs: [Numeral("factor", Cardinal), Cat("multiplier", "BareNominal"), Cat("head", "NounPhrase")],
            equations: [Require("multiplier.NounDistribution", "Serial"), Require("multiplier.Number", "Plural"), Require("head.Determination", "Overt")]),
        (name: "MultipliedAmount", lhs: "Amount", rhs: [Numeral("factor", Cardinal), Cat("multiplier", "BareNominal"), Cat("head", "Amount")],
            equations: [Require("multiplier.NounDistribution", "Serial"), Require("multiplier.Number", "Plural")]),
        (name: "NumericArithmetic", lhs: "NounPhrase", rhs: [Cat("head", "Amount"), Selected("modifier", "PrepositionPhrase", ["Plus", "Minus"])],
            equations: [Require("modifier.ComplementKind", "NP"), Require("modifier.Determination", "Overt"), Require("$.NounKind", "Ordinary"), Require("$.Number", "Singular"), Require("$.Determination", "Bare"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        (name: "NounPhraseArithmetic", lhs: "NounPhrase", rhs: [Cat("head", "NounPhrase"), Selected("modifier", "PrepositionPhrase", ["Plus", "Minus"])],
            equations: [Exclude("head.NounKind", "Numeric"), Exclude("head.Case", "Genitive"), Exclude("head.Case", "Nominative"), Exclude("head.Case", "Accusative")]),
        (name: "DegreeArithmetic", lhs: "DeterminerPhrase", rhs: [Cat("head", "DeterminerPhrase"), Selected("modifier", "PrepositionPhrase", ["Plus", "Minus"])],
            equations: [Require("head.ComplementKind", "Intransitive"), Require("head.DeterminativeDistribution", "Dependent")], heavy: ["head"]),
        // A fraction or multiplier before a determined Noun Phrase (*half their
        // life*, *double that damage*).
        (name: "MultiplierPredetermination", lhs: "NounPhrase", rhs: [Cat("determiner", "DeterminerPhrase"), Cat("head", "NounPhrase")],
            equations: [Require("determiner.DeterminativeDistribution", "Multiplier"), Require("determiner.ComplementKind", "Intransitive"), Require("head.Determination", "Overt")]),
        (name: "AdverbAdverbial", lhs: "Adverbial", rhs: [Cat("head", "AdverbPhrase")], equations: [Require("head.AdjunctPosition", "End")]),
        (name: "FrequencyAdverbial", lhs: "Adverbial", rhs: [Cat("head", "TemporalNounPhrase")]),
        // A comparative determinative and its *than* Complement as a degree
        // Adjunct (*choose the same mode more than once*; CGEL, Ch. 13 §4.4).
        (name: "ComparativeAdverb", lhs: "AdverbPhrase", rhs: [Cat("head", "DeterminerPhrase")],
            equations: [Require("head.ComplementKind", "PP"), Require("head.PrepositionMarking", "Comparative"), Require("head.ObliqueKind", "AdvP"), Require("$.AdjunctPosition", "End")]),
        // A comparative adjective premodifier with its *than* Complement after
        // the head, an indirect Complement (*greater power than this
        // creature*; CGEL, Ch. 13 §2.1, p. 1104; Ch. 5 §16.1, p. 445).
        (name: "ComparativeIndirectComplement", lhs: "Nominal", rhs: [Cat("modifier", "AdjectivePhrase"), Cat("head", "Nominal"), Selected("complement", "PrepositionPhrase", ["Than"])],
            equations: [Require("modifier.Grade", "Comparative"), Require("modifier.ComplementKind", "Intransitive"), Exclude("modifier.Voice", "Passive"), Exclude("modifier.AdjectivePosition", "Predicative"), Agree("modifier.Determination", "$.Determination")]),
        (name: "EquativeIndirectComplement", lhs: "Nominal", rhs: [Cat("modifier", "AdjectivePhrase"), Cat("head", "Nominal"), Selected("complement", "PrepositionPhrase", ["As"])],
            equations: [Require("modifier.Grade", "Equative"), Require("modifier.ComplementKind", "Intransitive"), Require("complement.ComplementKind", "NP"), Agree("modifier.Determination", "$.Determination")]),
        // An analytic superlative (*your most recent turn*, *most recently
        // cast*; CGEL, Ch. 13 §4.3, p. 1122).
        (name: "DegreeModifiedAdjective", lhs: "AdjectivePhrase", rhs: [Class("modifier", "DegreeAdverb"), Cat("head", "AdjectivePhrase")],
            equations: [Require("head.Grade", "Plain"), Require("head.ComplementKind", "Intransitive"), Require("$.AdjectivePosition", "Attributive")]),
        (name: "DegreeModifiedAdverb", lhs: "AdverbPhrase", rhs: [Class("modifier", "DegreeAdverb"), Cat("head", "AdverbPhrase")],
            equations: [Require("head.AdjunctPosition", "Central")]),
        // A comparative determinative and its *than* Complement as a fused
        // head (*by more than {5}*, *more than two*), with a bare standard;
        // scalar *less than* is the adjective's.
        (name: "ComparativeFusedHead", lhs: "NounPhrase", rhs: [Cat("head", "DeterminerPhrase")],
            equations: [Require("head.ComplementKind", "PP"), Require("head.PrepositionMarking", "Comparative"), Exclude("head.ObliqueKind", "AdvP"), Exclude("head.ObliqueKind", "FiniteClause"), Require("head.ObliqueDetermination", "Bare"), Exclude("head.Countability", "Mass"), Agree("$.Number", "head.ObliqueNumber"), Require("$.NounKind", "Ordinary"), Require("$.Determination", "Overt"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        // A fraction with its partitive oblique (*a third of their life*).
        (name: "FractionPartitive", lhs: "PartitiveHead", rhs: [Cat("determiner", "DeterminerPhrase"), Numeral("head", Ordinal), Selected("complement", "PrepositionPhrase", ["Of"])],
            equations: [Require("determiner.DeterminativeDistribution", "IndefiniteArticle"), Require("complement.ComplementKind", "NP"), Require("$.Number", "Singular"), Require("$.NounKind", "Ordinary"), Require("$.Determination", "Overt"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        // A measure phrase on a comparative determinative with its *than*
        // Complement (*at least 7 life more than your starting life total*;
        // *at least four more creatures than you*).
        (name: "MeasuredComparativeStandard", lhs: "NounPhrase", rhs: [Cat("modifier", "NounPhrase"), Class("head", "ComparativeQuantifier"), Selected("complement", "PrepositionPhrase", ["Than"])],
            equations: [Require("modifier.Case", "Plain"), Exclude("complement.ComplementKind", "AdvP"), Require("$.NounKind", "Ordinary"), Require("$.Number", "Singular"), Require("$.Determination", "Bare"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        (name: "MeasuredComparativeDetermined", lhs: "NounPhrase", rhs: [Cat("modifier", "DeterminerPhrase"), Class("determiner", "ComparativeQuantifier"), Cat("head", "Nominal"), Selected("complement", "PrepositionPhrase", ["Than"])],
            equations: [Require("modifier.DeterminativeDistribution", "Numerical"), Require("head.Number", "Plural"), Require("head.Countability", "Count"), Require("$.Determination", "Overt"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        // A measured comparative determinative takes the measure's Number
        // (*one more spell*, *one fewer revival counter*).
        (name: "MeasuredComparativeDeterminer", lhs: "DeterminerPhrase", rhs: [Cat("modifier", "DeterminerPhrase"), Class("quantifier", "ComparativeQuantifier")],
            equations: [Require("modifier.DeterminativeDistribution", "Numerical"), Require("modifier.ComplementKind", "Intransitive"), Agree("$.Number", "modifier.Number"), Require("$.Countability", "Count"), Require("$.DeterminativeDistribution", "Numerical"), Require("$.ComplementKind", "Intransitive")]),
        // Floated *each* before a predicative adjective (*are each equal to
        // ...*, *power and toughness each equal to ...*; CGEL, Ch. 5 §10.1.1,
        // p. 428).
        (name: "FloatedEachAdjective", lhs: "AdjectivePhrase", rhs: [Word("adjunct", "Each"), Cat("head", "AdjectivePhrase")], equations: [Require("head.ComplementKind", "PP")]),
        // Floated *each* after an auxiliary (*any number of target players may
        // each search ...*; CGEL, Ch. 5 §10.1.1, p. 428).
        (name: "AuxiliaryFloatedEach", lhs: "VerbPhrase", rhs: [Word("adjunct", "Each"), Cat("head", "VerbPhrase")],
            equations: [Require("head.VerbForm", "Plain")], transparent: ["head"], cost: 2),
        // A preposed adverb and Preposition Phrase set off by one comma (*Once
        // during each of your turns, ...*).
        (name: "PreposedAdverbAndPreposition", lhs: "Clause", rhs: [Cat("adjunct", "AdverbPhrase"), Hosted("adjunct", "PrepositionPhrase", Predicate), Punct(','), Cat("head", "Clause")],
            equations: [Require("adjunct.AdjunctPosition", "Front")], transparent: ["head"], cost: 2),
        // A verbal cost with a passive participial Supplement (*Pay half your
        // life, rounded up:*).
        (name: "SupplementedVerbalCost", lhs: "NonManaCost", rhs: [Cat("head", "VerbPhrase"), Punct(','), Cat("supplement", "VerbPhrase")],
            equations: [Require("head.VerbForm", "Plain"), Require("supplement.VerbForm", "PastParticiple"), Require("supplement.Voice", "Passive")], heavy: ["supplement"], cost: 3),
        (name: "NominalInstruction", lhs: "Sentence", rhs: [Cat("head", "IndexedNominal"), Punct('.')]),
        // *When this Class becomes level 2*.
        (name: "IndexedNounPhrase", lhs: "NounPhrase", rhs: [Cat("head", "IndexedNominal")], equations: [Require("head.Number", "Singular"), Require("$.NounKind", "Ordinary"), Require("$.Determination", "Bare"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        // The count-noun pro-form *one* (*this one*, *a different one of
        // those creatures*, *the first one they draw*; CGEL, Ch. 5 §7.1,
        // pp. 386–388; Ch. 17 §5.1, p. 1511).
        (name: "CardinalNominal", lhs: "BareNominal", rhs: [Numeral("head", Cardinal)],
            equations: [Require("$.Determination", "Overt"), Require("$.Number", "Singular"), Require("$.Countability", "Count"), Require("$.NounKind", "Ordinary"), Require("$.NounDistribution", "Ordinary")]),
        // *for each target beyond the first*.
        (name: "FusedOrdinalHead", lhs: "NounPhrase", rhs: [Cat("determiner", "DeterminerPhrase"), Numeral("head", Ordinal)], equations: [Exclude("determiner.DeterminativeDistribution", "Independent"), Require("determiner.Countability", "Count"), Require("determiner.Number", "Singular"), Require("$.Number", "Singular"), Require("$.Case", "Plain"), Require("$.NounKind", "Ordinary"), Require("$.Countability", "Count"), Require("$.Determination", "Overt"), Require("$.Person", "Third")]),
        // A determinerless plural after *other* whose nominal the Targeting
        // Marker determines (*any number of other target creatures*).
        (name: "OtherTargetedPlural", lhs: "NounPhrase", rhs: [Class("modifier", "FusedHeadAdjective"), Cat("head", "Nominal")],
            equations: [Carry("head.Determination", "Overt"), Require("head.Number", "Plural"), Require("$.Determination", "Overt"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        (name: "FusedAdjectiveHead", lhs: "NounPhrase", rhs: [Cat("determiner", "DeterminerPhrase"), Class("head", "FusedHeadAdjective")], equations: [Require("$.Case", "Plain"), Require("$.Person", "Third"), Require("$.Determination", "Overt"), Require("$.Countability", "Count"), Require("$.NounKind", "Ordinary")]),
        (name: "SingleRowHeader", lhs: "RowHeader", rhs: [Cat("head", "Amount")]),
        (name: "OpenRowHeader", lhs: "RowHeader", rhs: [Cat("head", "Amount"), Punct('+')]),
        (name: "HyphenRowHeader", lhs: "RowHeader", rhs: [Cat("lower", "Amount"), Mark('-', Bound), Cat("upper", "Amount")]),
        (name: "UnicodeRangeRowHeader", lhs: "RowHeader", rhs: [Cat("lower", "Amount"), Mark('—', Bound), Cat("upper", "Amount")]),
        (name: "TableRow", lhs: "Ability", rhs: [Cat("header", "RowHeader"), Mark('|', Free), Cat("head", "Ability")]),
        (name: "SequentialVerbalCosts", lhs: "NonManaCost", rhs: [Cat("first", "VerbPhrase"), Punct(','), Cat("rest", "Cost")], equations: [Require("first.VerbForm", "Plain")]),
        (name: "DeclarativeCost", lhs: "NonManaCost", rhs: [Cat("head", "Clause")], equations: [Require("head.VerbForm", "Finite"), Exclude("head.Inflection", "Irrealis")]),
        (name: "ClauseCondition", lhs: "Condition", rhs: [Cat("head", "Clause")]),
        (name: "KeywordInstruction", lhs: "Sentence", rhs: [Cat("head", "KeywordLineItem"), Punct('.')], equations: [Require("head.KeywordForm", "Parametric")]),
        (name: "FloatedEach", lhs: "Clause", rhs: [Cat("subject", "NounPhrase"), Word("adjunct", "Each"), Cat("head", "VerbPhrase")], equations: [Require("subject.Number", "Plural"), Exclude("subject.Case", "Accusative"), Agree("subject.Number", "head.Number"), Agree("subject.Person", "head.Person"), Require("head.VerbForm", "Finite"), Require("$.ClauseMarking", "Unmarked")], transparent: ["head"]),
        // Floated *all* after a personal pronoun Subject (*they all share a
        // color*; CGEL, Ch. 5 §10.1.1, p. 428).
        (name: "FloatedAll", lhs: "Clause", rhs: [Cat("subject", "NounPhrase"), Word("adjunct", "All"), Cat("head", "VerbPhrase")], equations: [Require("subject.Number", "Plural"), Require("subject.Case", "Nominative"), Agree("subject.Number", "head.Number"), Agree("subject.Person", "head.Person"), Require("head.VerbForm", "Finite"), Require("$.ClauseMarking", "Unmarked")], transparent: ["head"]),
        (name: "NumericalDetermination", lhs: "DeterminerPhrase", rhs: [Cat("head", "NumericalDeterminer")], equations: [Require("$.DeterminativeDistribution", "Numerical"), Require("$.ComplementKind", "Intransitive")]),
        (name: "MeasuredMass", lhs: "NounPhrase", rhs: [Cat("determiner", "DeterminerPhrase"), Cat("head", "Nominal")], equations: [Require("determiner.DeterminativeDistribution", "Numerical"), Require("head.NounDistribution", "DirectMeasure"), Require("head.Countability", "Mass"), Require("head.Number", "Singular"), Require("$.Case", "Plain"), Require("$.Determination", "Overt"), Require("$.Person", "Third")]),
        // A measure noun counted unit by unit (*for each mana spent*).
        (name: "DistributiveMeasure", lhs: "NounPhrase", rhs: [Cat("determiner", "DeterminerPhrase"), Cat("head", "Nominal")], equations: [Require("determiner.DeterminativeDistribution", "Distributive"), Require("head.NounDistribution", "DirectMeasure"), Require("head.Countability", "Mass"), Require("head.Number", "Singular"), Agree("determiner.NounKind", "head.NounKind"), Require("$.Case", "Plain"), Require("$.Person", "Third"), Require("$.Determination", "Overt")]),
        (name: "BareSingularTerm", lhs: "NounPhrase", rhs: [Cat("head", "Nominal")], equations: [Require("head.NounDistribution", "BareSingular"), Require("head.Number", "Singular"), Require("$.Case", "Plain"), Require("$.Determination", "Bare"), Require("$.Person", "Third")]),
        (name: "FusedPhrase", lhs: "NounPhrase", rhs: [Cat("head", "FusedNounPhrase")]),
        (name: "LocativePhrase", lhs: "LocativeNounPhrase", rhs: [Cat("head", "FusedNounPhrase")], equations: [Require("head.NounKind", "Locative")]),
        (name: "LocativeFusedHead", lhs: "FusedNounPhrase", rhs: [Cat("head", "LocativeHead")]),
        (name: "PartitiveFusedHead", lhs: "FusedNounPhrase", rhs: [Cat("head", "PartitiveHead")]),
        (name: "DeterminativePartitiveHead", lhs: "FusedNounPhrase", rhs: [Cat("head", "PartitiveNounPhrase")]),
        (name: "FusedLocative", lhs: "LocativeHead", rhs: [Class("head", "LocativeQuantifier")], equations: [Require("$.NounKind", "Locative"), Require("$.Determination", "Bare"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        (name: "AttributiveNoun", lhs: "NounPremodifier", rhs: [FreeLex("head", Noun)], equations: [Require("head.Inflection", "Singular"), Exclude("head.NounDistribution", "HeadOnly")]),
        (name: "PrefixedNounPremodifier", lhs: "NounPremodifier", rhs: [Lex("prefix", Affix), Cat("head", "NounPremodifier")]),
        // A noun premodifier sits inside determinative and adjectival ones,
        // never outside them or on a determined symbol (*amount {G}*).
        (name: "NominalPremodifier", lhs: "BareNominal", rhs: [Cat("modifier", "NounPremodifier"), Cat("head", "BareNominal")], equations: [Exclude("head.Determination", "Overt")]),
        (name: "QuantifiedNominalPremodifier", lhs: "QuantifiedNominal", rhs: [Cat("modifier", "NounPremodifier"), Cat("head", "QuantifiedNominal")]),
        (name: "BarePrepositionalNominal", lhs: "BareNominalComplement", rhs: [Cat("head", "PrepositionalNominal")], equations: [Require("head.Number", "Singular"), Require("head.Countability", "Count"), Exclude("head.NounDistribution", "BareSingular")]),
        // Noun phrases.
        (name: "BareMass", lhs: "NounPhrase", rhs: [Cat("head", "Nominal")],
            equations: [Require("$.Determination", "Bare"), Require("$.Case", "Plain"), Require("head.Countability", "Mass"), Require("head.Number", "Singular"), Require("$.Person", "Third")],
            transparent: ["head"]),
        (name: "SymbolFusedHead", lhs: "FusedNounPhrase", rhs: [Cat("head", "SymbolHead")]),
        (name: "SymbolNominalPhrase", lhs: "SymbolHead", rhs: [Cat("head", "Symbols")], equations: [Require("$.NounKind", "Ordinary"), Require("$.Determination", "Bare"), Require("$.Case", "Plain"), Require("$.Number", "Singular"), Require("$.Person", "Third")]),
        (name: "ProperName", lhs: "NounPhrase", rhs: [Cat("head", "Name")],
            equations: [Require("$.NounKind", "Ordinary"), Require("$.Determination", "Bare"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        (name: "Determined", lhs: "NounPhrase", rhs: [Cat("determiner", "DeterminerPhrase"), Cat("head", "Nominal")],
            equations: [Require("$.Determination", "Overt"), Require("$.Case", "Plain"), Require("$.Person", "Third"), Exclude("determiner.DeterminativeDistribution", "Independent"), Exclude("determiner.DeterminativeDistribution", "FreeChoice"), Exclude("determiner.DeterminativeDistribution", "Multiplier"), Exclude("determiner.ComplementKind", "PP"), Agree("determiner.NounKind", "head.NounKind"), Agree("determiner.Countability", "head.Countability"), Agree("determiner.Number", "head.Number")]),
        // A comparative quantity determines a count head that agrees with its
        // *than* Complement (*more than one creature*), or a mass head (*less
        // than three mana*).
        (name: "ComparativeQuantityCountDetermined", lhs: "NounPhrase", rhs: [Cat("determiner", "DeterminerPhrase"), Cat("head", "Nominal")],
            equations: [Require("determiner.ComplementKind", "PP"), Require("determiner.PrepositionMarking", "Comparative"), Exclude("determiner.ObliqueKind", "FiniteClause"), Require("head.Countability", "Count"), Agree("determiner.ObliqueNumber", "head.Number"), Agree("determiner.NounKind", "head.NounKind"), Agree("determiner.Countability", "head.Countability"), Agree("determiner.Number", "head.Number"), Require("$.Determination", "Overt"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        (name: "ComparativeQuantityMassDetermined", lhs: "NounPhrase", rhs: [Cat("determiner", "DeterminerPhrase"), Cat("head", "Nominal")],
            equations: [Require("determiner.ComplementKind", "PP"), Require("determiner.PrepositionMarking", "Comparative"), Exclude("determiner.ObliqueKind", "FiniteClause"), Require("head.Countability", "Mass"), Require("head.Number", "Singular"), Agree("determiner.NounKind", "head.NounKind"), Agree("determiner.Countability", "head.Countability"), Agree("determiner.Number", "head.Number"), Require("$.Determination", "Overt"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        // Free-choice *any* determines a nominal, but a quantificational noun
        // only without its oblique: with one, the Noun Phrase takes the
        // oblique's Number (*any number of target creatures become ...*).
        (name: "FreeChoiceDetermined", lhs: "NounPhrase", rhs: [Cat("determiner", "DeterminerPhrase"), Cat("head", "Nominal")],
            equations: [Require("determiner.DeterminativeDistribution", "FreeChoice"), Exclude("head.NounDistribution", "Quantity"), Require("$.Determination", "Overt"), Require("$.Case", "Plain"), Require("$.Person", "Third"), Agree("determiner.NounKind", "head.NounKind"), Agree("determiner.Countability", "head.Countability"), Agree("determiner.Number", "head.Number")]),
        (name: "FreeChoiceQuantity", lhs: "NounPhrase", rhs: [Cat("determiner", "DeterminerPhrase"), Cat("head", "Nominal")],
            equations: [Require("determiner.DeterminativeDistribution", "FreeChoice"), Require("head.NounDistribution", "Quantity"), Require("head.ComplementKind", "Intransitive"), Require("$.Determination", "Overt"), Require("$.Case", "Plain"), Require("$.Person", "Third"), Agree("determiner.NounKind", "head.NounKind"), Agree("determiner.Countability", "head.Countability"), Agree("determiner.Number", "head.Number")]),
        (name: "TransparentQuantity", lhs: "NounPhrase", rhs: [Cat("determiner", "DeterminerPhrase"), Cat("quantity", "Nominal")],
            equations: [Require("determiner.DeterminativeDistribution", "FreeChoice"), Require("quantity.NounDistribution", "Quantity"), Require("quantity.ComplementKind", "PP"), Require("quantity.ObliqueNumber", "Plural"), Agree("$.Number", "quantity.ObliqueNumber"), Agree("$.NounKind", "quantity.ObliqueNounKind"), Require("$.Determination", "Overt"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        // A free-choice quantity of serial *times* is a frequency Adjunct
        // (*pay {1}{G} any number of times*).
        (name: "TemporalQuantity", lhs: "TemporalNounPhrase", rhs: [Cat("determiner", "DeterminerPhrase"), Cat("quantity", "Nominal")],
            equations: [Require("determiner.DeterminativeDistribution", "FreeChoice"), Require("quantity.NounDistribution", "Quantity"), Require("quantity.ComplementKind", "PP"), Require("quantity.ObliqueNumber", "Plural"), Require("quantity.ObliqueNounKind", "Temporal"), Agree("$.Number", "quantity.ObliqueNumber"), Require("$.NounKind", "Temporal"), Require("$.Determination", "Overt"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        (name: "BarePlural", lhs: "NounPhrase", rhs: [Cat("head", "Nominal")],
            equations: [Require("$.Determination", "Bare"), Require("$.Case", "Plain"), Require("head.Number", "Plural"), Require("$.Person", "Third")]),
        (name: "Pronoun", lhs: "NounPhrase", rhs: [Lex("head", Pronoun)],
            equations: [Require("$.NounKind", "Ordinary"), Require("$.Determination", "Bare"), Exclude("head.Case", "Genitive"), Exclude("head.PronounKind", "Existential"), Exclude("head.PronounKind", "Relative"), Require("head.Inflection", "Invariant")]),
        (name: "IndependentGenitive", lhs: "NounPhrase", rhs: [Lex("pronoun", Pronoun)],
            equations: [Require("$.NounKind", "Ordinary"), Require("$.Determination", "Bare"), Require("$.Case", "Plain"), Require("pronoun.Inflection", "IndependentGenitive"), Require("$.Person", "Third")]),
        (name: "PossessiveDeterminer", lhs: "DeterminerPhrase", rhs: [Lex("possessor", Pronoun)],
            equations: [Require("$.DeterminativeDistribution", "Dependent"), Require("$.ComplementKind", "Intransitive"), Require("possessor.Case", "Genitive"), Require("possessor.Inflection", "Invariant"), Exclude("possessor.PronounKind", "Relative")]),
        (name: "GenitivePossessor", lhs: "NounPhrase", rhs: [Cat("possessor", "Possessor"), Word("marker", "Genitive")],
            equations: [Require("$.Determination", "Bare"), Require("$.Case", "Genitive"), Exclude("possessor.Case", "Nominative"), Exclude("possessor.Case", "Accusative"), Exclude("possessor.Case", "Genitive"), Agree("$.Number", "possessor.Number"), Agree("$.Person", "possessor.Person")]),
        // An independent genitive is a fused-head Noun Phrase (*power less
        // than Mirko's*; CGEL, Ch. 5 §16.5, p. 471).
        (name: "IndependentGenitivePhrase", lhs: "NounPhrase", rhs: [Cat("possessor", "Possessor"), Word("marker", "Genitive")],
            equations: [Require("$.NounKind", "Ordinary"), Require("$.Determination", "Overt"), Require("$.Case", "Plain"), Exclude("possessor.Case", "Nominative"), Exclude("possessor.Case", "Accusative"), Exclude("possessor.Case", "Genitive"), Require("$.Person", "Third")]),
        (name: "GenitiveDetermined", lhs: "NounPhrase", rhs: [Cat("determiner", "NounPhrase"), Cat("head", "Nominal")],
            equations: [Require("$.Determination", "Overt"), Require("$.Case", "Plain"), Require("determiner.Case", "Genitive"), Require("$.Person", "Third")]),
        // *its controller's next two untap steps*.
        (name: "GenitiveModifiedQuantity", lhs: "NounPhrase", rhs: [Cat("determiner", "NounPhrase"), Cat("head", "ModifiedQuantifiedNominal")],
            equations: [Require("determiner.Case", "Genitive"), Agree("$.Number", "head.QuantityNumber"), Require("$.Countability", "Count"), Require("$.Determination", "Overt"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        // A noun's *of* Complement is a Noun Phrase, never a gerund-participial
        // (*the number of attacking creatures*).
        (name: "Unmodified", lhs: "Nominal", rhs: [Cat("head", "BareNominal")], equations: [Exclude("head.ObliqueKind", "Gerund")], transparent: ["head"]),
        (name: "Premodifier", lhs: "BareNominal", rhs: [Cat("modifier", "AdjectivePhrase"), Cat("head", "BareNominal")], equations: [Require("modifier.ComplementKind", "Intransitive"), Exclude("modifier.Voice", "Passive"), Agree("modifier.Determination", "$.Determination"), Exclude("modifier.AdjectivePosition", "Predicative")]),
        (name: "DeterminedPossessor", lhs: "Possessor", rhs: [Cat("determiner", "DeterminerPhrase"), Cat("head", "BareNominal")],
            equations: [Require("$.Case", "Plain"), Require("$.Person", "Third"), Exclude("determiner.DeterminativeDistribution", "Independent"), Agree("determiner.NounKind", "head.NounKind"), Agree("determiner.Countability", "head.Countability"), Agree("determiner.Number", "head.Number")]),
        (name: "GenitiveDeterminedPossessor", lhs: "Possessor", rhs: [Cat("determiner", "NounPhrase"), Cat("head", "BareNominal")], equations: [Require("determiner.Case", "Genitive"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        // *up to one target player's life total*.
        (name: "MaximumPossessor", lhs: "Possessor", rhs: [Selected("determiner", "PrepositionPhrase", ["Up"]), Cat("head", "BareNominal")],
            equations: [Require("determiner.ComplementKind", "PP"), Require("determiner.Determination", "Bare"), Agree("determiner.Number", "head.Number"), Require("head.Countability", "Count"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        (name: "PluralPossessor", lhs: "Possessor", rhs: [Cat("head", "BareNominal")],
            equations: [Require("$.Case", "Plain"), Require("head.Number", "Plural"), Require("$.Person", "Third")]),
        (name: "ProperPossessor", lhs: "Possessor", rhs: [Cat("head", "Name")], equations: [Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        (name: "BareSingularPossessor", lhs: "Possessor", rhs: [Cat("head", "BareNominal")],
            equations: [Require("head.NounDistribution", "BareSingular"), Require("head.Number", "Singular"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        (name: "NominalPostmodifier", lhs: "Nominal", rhs: [Cat("head", "Nominal"), Cat("modifier", "Postmodifier")],
            equations: [Agree("head.Number", "modifier.Number"), Agree("head.NounKind", "modifier.NounKind")]),
        // A Postmodifier follows a quantity's premodifiers (*the next 3 damage
        // that would be dealt*).
        (name: "QuantifiedPostmodifier", lhs: "ModifiedQuantifiedNominal", rhs: [Cat("head", "QuantifiedNominal"), Cat("modifier", "Postmodifier")],
            equations: [Agree("head.QuantityNumber", "modifier.Number"), Agree("head.NounKind", "modifier.NounKind")]),
        (name: "ModifiedQuantifiedPostmodifier", lhs: "ModifiedQuantifiedNominal", rhs: [Cat("head", "ModifiedQuantifiedNominal"), Cat("modifier", "Postmodifier")],
            equations: [Agree("head.QuantityNumber", "modifier.Number"), Agree("head.NounKind", "modifier.NounKind")]),
        // In Oracle English only a marked relative follows a fused head (*one
        // that hasn't been chosen*).
        (name: "FusedPostmodifier", lhs: "FusedNounPhrase", rhs: [Cat("head", "FusedNounPhrase"), Cat("modifier", "RelativeClause")],
            equations: [Require("modifier.ClauseMarking", "Relative"), Agree("head.Number", "modifier.Number"), Agree("head.NounKind", "modifier.NounKind")]),
        (name: "RelativePostmodifier", lhs: "Postmodifier", rhs: [Cat("head", "RelativeClause")]),
        // A participial clause with dependents (*each creature tapped this
        // way*, *a card exiled with ...*). A single postpositive participle
        // ranks behind it (CGEL, Ch. 5 §14.2, p. 445), and is never one whose
        // Adjectival Passive is a declared Adjective: bare *tapped* is that
        // Adjective.
        (name: "ParticipialPostmodifier", lhs: "Postmodifier", rhs: [Cat("head", "VerbPhrase")],
            equations: [Require("head.VerbForm", "PastParticiple"), Require("head.Voice", "Passive")], heavy: ["head"], cost: 1),
        (name: "GerundParticipialPostmodifier", lhs: "Postmodifier", rhs: [Cat("head", "VerbPhrase")],
            equations: [Require("head.VerbForm", "GerundParticiple")], heavy: ["head"], cost: 1),
        // A single participle postmodifies the bare nominal, outside its
        // premodifiers and inside any relative clause (*creatures entering*,
        // *a creature dying*).
        (name: "SingleParticipialPostmodifier", lhs: "Nominal", rhs: [Cat("head", "BareNominal"), Cat("modifier", "VerbPhrase")],
            equations: [Require("modifier.VerbForm", "PastParticiple"), Require("modifier.Voice", "Passive"), Exclude("modifier.AdjectivalPassive", "Lexical")], light: ["modifier"], cost: 3),
        (name: "SingleGerundParticipialPostmodifier", lhs: "Nominal", rhs: [Cat("head", "BareNominal"), Cat("modifier", "VerbPhrase")],
            equations: [Require("modifier.VerbForm", "GerundParticiple")], light: ["modifier"], cost: 3),
        // Relative clauses (CGEL, Ch. 12 §3). A bare relative is a finite
        // clause with an object Gap; *that* or a relative pronoun may also
        // introduce a subject Gap, which agrees with the antecedent.
        (name: "BareRelative", lhs: "RelativeClause", rhs: [Cat("clause", "Clause")],
            equations: [Require("$.ClauseMarking", "Unmarked"), Require("clause.Gap", "NP"), Require("clause.VerbForm", "Finite")]),
        // A bare relative whose Gap is a subjective predicative (*the
        // permanent it becomes*, *a color the other isn't*, *the number of
        // colors that spell is*; CGEL, Ch. 12 §3.3(c), p. 1045; §3.5.4(g),
        // p. 1054), of an ordinary head.
        (name: "BarePredicativeRelative", lhs: "RelativeClause", rhs: [Cat("clause", "Clause")],
            equations: [Require("$.ClauseMarking", "Unmarked"), Require("$.NounKind", "Ordinary"), Require("clause.Gap", "Pred"), Require("clause.VerbForm", "Finite")], cost: 3),
        (name: "MarkedRelative", lhs: "RelativeClause", rhs: [Class("marker", "RelativeMarker"), Cat("clause", "Clause")],
            equations: [Require("$.ClauseMarking", "Relative"), Require("clause.Gap", "NP"), Require("clause.VerbForm", "Finite"), Exclude("marker.Case", "Nominative"), Exclude("marker.Case", "Genitive")]),
        (name: "SubjectRelative", lhs: "RelativeClause", rhs: [Class("marker", "RelativeMarker"), Cat("clause", "SubjectGapClause")],
            equations: [Require("$.ClauseMarking", "Relative"), Require("clause.Gap", "NP"), Agree("$.Number", "clause.Number"), Exclude("marker.Case", "Accusative"), Exclude("marker.Case", "Genitive")]),
        (name: "SubjectGap", lhs: "SubjectGapClause", rhs: [Cat("head", "VerbPhrase")],
            equations: [Require("head.VerbForm", "Finite"), Require("head.Person", "Third"), Exclude("head.Inflection", "Irrealis"), Require("$.Gap", "NP")]),
        (name: "FloatedEachSubjectGap", lhs: "SubjectGapClause", rhs: [Word("adjunct", "Each"), Cat("head", "VerbPhrase")],
            equations: [Require("head.VerbForm", "Finite"), Require("head.Number", "Plural"), Require("head.Person", "Third"), Require("$.Gap", "NP")]),
        // *whose*: the relative phrase is the Subject or fills an object Gap.
        (name: "GenitiveRelativePhrase", lhs: "RelativeNounPhrase", rhs: [Lex("determiner", Pronoun), Cat("head", "Nominal")],
            equations: [Require("determiner.PronounKind", "Relative"), Require("determiner.Case", "Genitive")]),
        (name: "GenitiveSubjectRelative", lhs: "RelativeClause", rhs: [Cat("marker", "RelativeNounPhrase"), Cat("clause", "SubjectGapClause")],
            equations: [Require("$.ClauseMarking", "Relative"), Require("clause.Gap", "NP"), Agree("marker.Number", "clause.Number")]),
        (name: "GenitiveRelative", lhs: "RelativeClause", rhs: [Cat("marker", "RelativeNounPhrase"), Cat("clause", "Clause")],
            equations: [Require("$.ClauseMarking", "Relative"), Require("clause.Gap", "NP"), Require("clause.VerbForm", "Finite")]),
        (name: "GenitivePredicativeRelative", lhs: "RelativeClause", rhs: [Cat("marker", "RelativeNounPhrase"), Cat("clause", "Clause")],
            equations: [Require("$.ClauseMarking", "Relative"), Require("clause.Gap", "Pred"), Require("clause.VerbForm", "Finite")]),
        // A relative phrase may be a Preposition Phrase fronted with its
        // relative pronoun (*for which*; CGEL, Ch. 12 §3.2.1, p. 1040).
        (name: "PrepositionRelativePhrase", lhs: "RelativePrepositionPhrase", rhs: [Lex("head", Preposition), Lex("complement", Pronoun)],
            equations: [Require("complement.PronounKind", "Relative"), Exclude("complement.Case", "Nominative"), Exclude("complement.Case", "Genitive")]),
        (name: "PrepositionalRelative", lhs: "RelativeClause", rhs: [Cat("marker", "RelativePrepositionPhrase"), Cat("clause", "AdjunctGapClause")],
            equations: [Require("$.ClauseMarking", "Relative"), Require("clause.Gap", "Adjunct")]),
        // A fused relative is a Noun Phrase (CGEL, Ch. 12 §6, p. 1068).
        (name: "FusedSubjectRelative", lhs: "NounPhrase", rhs: [Word("head", "Whichever"), Cat("clause", "SubjectGapClause")],
            equations: [Require("clause.Gap", "NP"), Require("$.NounKind", "Ordinary"), Require("$.Determination", "Bare"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        (name: "FusedRelative", lhs: "NounPhrase", rhs: [Word("head", "Whichever"), Cat("clause", "Clause")],
            equations: [Require("clause.Gap", "NP"), Require("clause.VerbForm", "Finite"), Require("$.NounKind", "Ordinary"), Require("$.Determination", "Bare"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        // An adverbial relative: its Gap is a temporal Adjunct (*the next time
        // you cast a spell*; CGEL, Ch. 12 §3.3(e), p. 1045).
        (name: "AdverbialRelative", lhs: "RelativeClause", rhs: [Cat("clause", "AdjunctGapClause")],
            equations: [Require("$.ClauseMarking", "Unmarked"), Require("clause.Gap", "Adjunct"), Require("$.NounKind", "Temporal")]),
        (name: "AdjunctGap", lhs: "AdjunctGapClause", rhs: [Cat("head", "Clause")],
            equations: [Require("head.VerbForm", "Finite"), Require("head.ClauseMarking", "Unmarked"), Require("$.Gap", "Adjunct")]),
        // A marked relative clause postposed past a predicate adjunct, at the
        // end of the clause containing its Antecedent, the Object that fills
        // the head's Gap (*Choose a card at random that was exiled with ...*;
        // CGEL, Ch. 12 §4, p. 1066). It ranks behind the relative clause in
        // place.
        (name: "PostposedRelative", lhs: "VerbPhrase", rhs: [Cat("head", "VerbPhrase"), Cat("object", "ComplementNounPhrase"), Hosted("adjunct", "PrepositionPhrase", Predicate), Cat("modifier", "RelativeClause")],
            equations: [Require("head.Gap", "NP"), Require("modifier.ClauseMarking", "Relative"), Agree("object.Number", "modifier.Number")], cost: 5),
        // A bare relative postposes only past an adjectival Complement (*at
        // random*), which has no noun of its own to modify in place.
        (name: "PostposedBareRelative", lhs: "VerbPhrase", rhs: [Cat("head", "VerbPhrase"), Cat("object", "ComplementNounPhrase"), Hosted("adjunct", "PrepositionPhrase", Predicate), Cat("modifier", "RelativeClause")],
            equations: [Require("head.Gap", "NP"), Require("adjunct.ComplementKind", "AdjP"), Require("modifier.ClauseMarking", "Unmarked"), Agree("object.Number", "modifier.Number")], heavy: ["modifier"], cost: 2),

        // Clause Complements of a Preposition (CGEL, Ch. 7 §1, pp. 599–600):
        // a finite Clause (*when this creature enters*), or a reducible
        // verbless Clause without its Subject (*if able*; Ch. 14 §10(b), p. 1267).
        (name: "FiniteComplementClause", lhs: "FiniteClause", rhs: [Cat("head", "Clause")],
            equations: [Require("head.VerbForm", "Finite"), Require("head.ClauseMarking", "Unmarked")]),
        (name: "VerblessComplementClause", lhs: "VerblessClause", rhs: [Cat("head", "Predicative")]),

        // Interrogative content clauses: closed (*whether ...*), with an
        // interrogative phrase as Subject (*which creatures attack*) or filling
        // a Gap (*which number you chose*), or with an interrogative adverb
        // (*how each player votes*; CGEL, Ch. 11 §5.1, pp. 972–973).
        (name: "ClosedInterrogative", lhs: "InterrogativeClause", rhs: [Word("marker", "Whether"), Cat("clause", "Clause")],
            equations: [Require("clause.VerbForm", "Finite"), Require("clause.ClauseMarking", "Unmarked")]),
        (name: "ClosedInfinitivalInterrogative", lhs: "InterrogativeClause", rhs: [Word("marker", "Whether"), Cat("clause", "Clause")],
            equations: [Require("clause.ClauseMarking", "To")]),
        (name: "InterrogativeDeterminer", lhs: "InterrogativePhrase", rhs: [Word("determiner", "Which"), Cat("head", "Nominal")],
            equations: [Require("$.Person", "Third")]),
        (name: "SubjectInterrogative", lhs: "InterrogativeClause", rhs: [Cat("subject", "InterrogativePhrase"), Cat("head", "VerbPhrase")],
            equations: [Agree("subject.Number", "head.Number"), Agree("subject.Person", "head.Person"), Require("head.VerbForm", "Finite")]),
        (name: "GapInterrogative", lhs: "InterrogativeClause", rhs: [Cat("marker", "InterrogativePhrase"), Cat("clause", "Clause")],
            equations: [Require("clause.Gap", "NP"), Require("clause.VerbForm", "Finite"), Require("clause.ClauseMarking", "Unmarked")]),
        (name: "AdverbialInterrogative", lhs: "InterrogativeClause", rhs: [Class("marker", "InterrogativeAdverb"), Cat("clause", "AdjunctGapClause")],
            equations: [Require("clause.Gap", "Adjunct")]),

        (name: "NominalPredicative", lhs: "Predicative", rhs: [Cat("head", "NounPhrase")]),
        // A predicative Preposition Phrase could also modify a nominal.
        (name: "PrepositionalPredicative", lhs: "Predicative", rhs: [Hosted("head", "PrepositionPhrase", Nominal)]),
        (name: "AdjectivalPredicative", lhs: "Predicative", rhs: [Cat("head", "AdjectivePhrase")], equations: [Exclude("head.AdjectivePosition", "Attributive")]),

    ],
    schemas: [
        Premodification(head: Verb, modifier: "Participle", host: "BareNominal", forms: [GerundParticiple, PastParticiple], prefix: true),
        Parameters(head: Noun, phrase: "IndexedNominal"),
        Parameters(head: Keyword, phrase: "KeywordParameters", binding: Some(Free), coordinators: Some("Coordinator")),
        Parameters(head: Keyword, phrase: "BoundKeyword", binding: Some(Suffix)),
        Valence(head: Verb, phrase: "VerbPhrase", passive: Some("By"), adjectival: Some("AdjectivePhrase"), interleaved: Some("Interleaved"), heavy_shift: true),
        Valence(head: Preposition, phrase: "PrepositionPhrase", agree: [("Number", "Number"), ("Number", "QuantityNumber"), ("Determination", "Determination"), ("Case", "Case"), ("NounKind", "NounKind"), ("Countability", "Countability")]),
        Valence(head: Noun, phrase: "BareNominal", agree: [("ObliqueNumber", "Number"), ("ObliqueKind", "ComplementKind"), ("ObliqueNounKind", "NounKind")]),
        Valence(head: Noun, phrase: "PrepositionalNominal"),
        Valence(head: Adjective, phrase: "AdjectivePhrase"),
        Valence(head: Determinative, phrase: "DeterminerPhrase", agree: [("ObliqueNumber", "Number"), ("ObliqueKind", "ComplementKind"), ("PrepositionMarking", "PrepositionMarking"), ("ObliqueDetermination", "Determination")]),
        // A complement costs nothing; a nominal postmodifier ranks before a
        // predicate adjunct.
        Adjunct(host: "QuantifiedNominal", adjunct: "PrepositionPhrase", side: After, host_kind: Nominal, cost: 1),
        Adjunct(host: "LocativeHead", adjunct: "PrepositionPhrase", side: After, host_kind: Nominal, cost: 1),
        Adjunct(host: "PartitiveHead", adjunct: "PrepositionPhrase", side: After, host_kind: Nominal, cost: 1),
        Adjunct(host: "SymbolHead", adjunct: "PrepositionPhrase", side: After, host_kind: Nominal, cost: 1),
        // A keyword mentioned without its parameter takes a modifier
        // (*landwalk of the chosen type*); a supplied parameter ends it.
        Adjunct(host: "KeywordPhrase", adjunct: "PrepositionPhrase", side: After, host_kind: Nominal, cost: 1, equations: [Exclude("head.KeywordForm", "Parametric")]),
        Adjunct(host: "Nominal", adjunct: "PrepositionPhrase", side: After, host_kind: Nominal, cost: 1),
        Adjunct(host: "VerbPhrase", adjunct: "PrepositionPhrase", side: After, host_kind: Predicate, cost: 2),
        Adjunct(host: "ExistentialPredicate", adjunct: "PrepositionPhrase", side: After, host_kind: Predicate, cost: 2),
        Adjunct(host: "VerbPhrase", adjunct: "PrepositionPhrase", side: After, host_kind: Predicate, delimiter: Some(','), cost: 2),
        Adjunct(host: "Clause", adjunct: "PrepositionPhrase", side: Before, host_kind: Predicate, delimiter: Some(','), cost: 2),
        // A comma-set Supplement to a Clause, a keyword or an indexed
        // instruction (*, where X is its power*).
        Adjunct(host: "Clause", adjunct: "PrepositionPhrase", side: After, host_kind: Supplement, delimiter: Some(','), cost: 2),
        Adjunct(host: "KeywordPhrase", adjunct: "PrepositionPhrase", side: After, host_kind: Supplement, delimiter: Some(','), cost: 2),
        Adjunct(host: "IndexedNominal", adjunct: "PrepositionPhrase", side: After, host_kind: Supplement, delimiter: Some(','), cost: 2),
        // A preposed gerund-participial adjunct (*Starting with you, ...*).
        Adjunct(host: "Clause", adjunct: "Gerund", side: Before, host_kind: Predicate, delimiter: Some(','), cost: 2),
        // A depictive gerund-participial adjunct (*put it onto the battlefield
        // attacking*), of a lexical verb: after an auxiliary, a
        // gerund-participial is the progressive's (*the player it is
        // attacking*).
        Adjunct(host: "VerbPhrase", adjunct: "Gerund", side: After, host_kind: Predicate, cost: 2, equations: [Exclude("head.VerbKind", "Auxiliary")]),
        // A purpose *to*-infinitival, unless the head's frame selects one.
        Adjunct(host: "VerbPhrase", adjunct: "ToInf", side: After, host_kind: Predicate, cost: 2),
        Coordination(category: "VerbPhrase", coordinators: "Coordinator", unshared: ["VerbKind", "Voice", "Inflection", "AdjectivalPassive"]),
        // Contrastive *but* joins predicates (*you control but don't own*).
        Coordination(category: "VerbPhrase", coordinators: "But", unshared: ["VerbKind", "Voice", "Inflection", "AdjectivalPassive"]),
        Coordination(category: "KeywordPhrase", coordinators: "Coordinator", unshared: ["KeywordForm"]),
        Coordination(category: "Clause", coordinators: "Coordinator", unshared: ["Inflection"], delimiter: Some(',')),
        // Imperatives and then a declarative (*tap that creature and it
        // doesn't untap ...*).
        Coordination(category: "Clause", coordinators: "Coordinator", unshared: ["Inflection", "VerbForm"], equations: [Require("first.VerbForm", "Plain"), Require("last.VerbForm", "Finite"), Require("$.VerbForm", "Finite")], delimiter: Some(',')),
        // An *and*-coordination of Noun Phrases or nominals is plural; an
        // *or*-coordination has its conjuncts' Number (CGEL, Ch. 5 §18.4,
        // pp. 507–509).
        Coordination(category: "NounPhrase", coordinators: "Additive", unshared: ["Number", "Person", "Determination", "Countability"], equations: [Require("$.Number", "Plural"), Require("$.Person", "Third")], proximate: ["Case"]),
        Coordination(category: "NounPhrase", coordinators: "Alternative", unshared: ["Determination", "Countability"], proximate: ["Number", "Person", "Case", "NounKind"]),
        Coordination(category: "Nominal", coordinators: "And", unshared: ["NounDistribution", "ComplementKind", "ObliqueNumber", "ObliqueNounKind"], equations: [Require("$.Number", "Plural")]),
        Coordination(category: "Nominal", coordinators: "Disjunctive", unshared: ["NounDistribution", "ComplementKind", "ObliqueNumber", "ObliqueNounKind"]),
        Coordination(category: "NounPremodifier", coordinators: "Coordinator"),
        Coordination(category: "Participle", coordinators: "Coordinator", unshared: ["Inflection"]),
        Coordination(category: "AdjectivePhrase", coordinators: "Coordinator", unshared: ["Grade"]),
        Coordination(category: "PrepositionPhrase", coordinators: "Coordinator", proximate: ["ComplementKind", "Number", "Determination", "Case", "NounKind", "Countability"]),
        Coordination(category: "AdverbPhrase", coordinators: "Coordinator"),
        Coordination(category: "SymbolCosts", coordinators: "Coordinator"),
        // A coordination of quantifiers determines as its last one does (*one
        // or more cards*, *one or more of them*; CGEL, Ch. 15 §3.3, p. 1330).
        Coordination(category: "DeterminerPhrase", coordinators: "Coordinator", proximate: ["Number", "Countability", "DeterminativeDistribution", "NounKind", "ComplementKind", "ObliqueNumber", "ObliqueKind", "PrepositionMarking", "ObliqueDetermination"]),
    ],
    correlatives: [("Both", "And"), ("Either", "Or"), ("Neither", "Nor")],
)
