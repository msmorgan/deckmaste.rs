// The Oracle English grammar data file. It names Categories, features,
// Schemas and core closed-class lexemes only: every other word, and every
// Subcategorization Frame, comes from the lexical environment it is bound to.
(
    root: "Document",
    features: {
        // A keyword mention may omit parameters; a Keyword Line supplies them.
        "KeywordForm": ["Bare", "Parametric"],
        "Parameterization": ["Supplied", "Omitted"],
        "Number": ["Singular", "Plural"],
        // Internal numeral–noun agreement survives external group respecification.
        "QuantityNumber": ["Singular", "Plural"],
        "Person": ["First", "Second", "Third"],
        "VerbForm": ["Plain", "Finite", "GerundParticiple", "PastParticiple"],
        // A to-infinitival Clause is marked by its subordinator; a relative
        // clause by *that* or a relative phrase.
        "ClauseMarking": ["Unmarked", "To", "Relative"],
        "Voice": ["Active", "Passive"],
        // A verb whose Adjectival Passive is a declared Adjective (*tapped*).
        "AdjectivalPassive": ["Derived", "Lexical"],
        // Auxiliary verbs (CGEL's NICE verbs) and the rest.
        "VerbKind": ["Lexical", "Auxiliary"],
        "NounDistribution": ["Ordinary", "BareSingular", "DirectMeasure", "HeadOnly", "Serial"],
        "NounKind": ["Ordinary", "Temporal", "Manner", "Locative", "Numeric"],
        "Determination": ["Bare", "Overt"],
        "AdjectivePosition": ["Attributive", "Predicative"],
        "Sign": ["Negative", "Zero", "Positive"],
        "PronounKind": ["Personal", "Existential", "Relative"],
        "DeterminativeDistribution": ["Dependent", "Independent", "Numerical", "IndefiniteArticle", "Distributive", "Deictic", "SingularOrQuantified"],
        "Case": ["Plain", "Nominative", "Accusative", "Genitive"],
        "Countability": ["Count", "Mass"],
        "AdjunctPosition": ["Central", "End", "Phrasal"],
        "Inflection": ["Invariant", "IndependentGenitive", "Singular", "Plural", "Plain", "Present", "Preterite", "Irrealis", "GerundParticiple", "PastParticiple"],
    },
    categories: {
        "Document": (),
        "Paragraphs": (),
        "ModalHeader": (),
        "ModalAbility": (),
        "SymbolCosts": (),
        "ActivationCost": (),
        "NonManaCost": (),
        "Mode": (),
        "ModeEffect": (),
        "Effect": (),
        "Pawprints": (),
        "TypeModifier": (),
        "Modes": (),
        "Ability": (),
        "TypeLine": (),
        "CardTypes": (),
        "Subtypes": (),
        "KeywordList": (),
        "Quality": (),
        "Name": (),
        "Condition": (),
        "Measure": (),
        "Symbols": (),
        // A bracketed loyalty symbol: a cost, or a counted noun (*an
        // additional [+1]*).
        "LoyaltySymbol": (),
        // A symbol sequence with a postmodifier (*{G}{G} spent to cast it*).
        "SymbolNominal": (category: Some("Nominal")),
        "Header": (),
        "RowHeader": (),
        "Chapters": (),
        "IndexedNominal": (features: ["Number"]),
        "NominalModifier": (),
        "ChoiceQuantity": (),
        "Sentence": (),
        "Sentences": (),
        // A Clause's Inflection is its finite verb's: an independent clause
        // excludes the irrealis *were* (CGEL, Ch. 3 §1.5, pp. 85–88).
        "Clause": (features: ["VerbForm", "ClauseMarking", "Inflection"], gap: true),
        // A subject relative agrees with its antecedent in number; an
        // adverbial relative modifies a temporal nominal.
        "RelativeClause": (features: ["Number", "NounKind", "ClauseMarking"]),
        // A finite clause whose Subject is its Gap (CGEL, Ch. 12 §3.3(a), p. 1044).
        "SubjectGapClause": (category: Some("Clause"), features: ["Number", "Person", "VerbForm", "Inflection"], gap: true),
        // A finite clause with an extracted Adjunct.
        "AdjunctGapClause": (category: Some("Clause"), features: ["VerbForm"], gap: true),
        "VerbPhrase": (features: ["Number", "Person", "VerbForm", "Voice", "VerbKind", "Inflection", "AdjectivalPassive"], gap: true),
        // Existential *there* and the predicate it is subject of (CGEL, Ch. 16
        // §6.1, p. 1391).
        "DummyPronoun": (category: Some("NounPhrase"), features: ["Number", "Person"]),
        "ExistentialPredicate": (category: Some("VerbPhrase"), features: ["Number", "Person", "VerbForm", "Inflection"]),
        "FusedNounPhrase": (category: Some("NounPhrase"), features: ["Number", "Person", "Case", "Determination", "NounKind", "Countability"]),
        "LocativeNounPhrase": (category: Some("NounPhrase"), features: ["Number", "Person", "Case", "Determination", "NounKind", "Countability"]),
        "NounPhrase": (features: ["Number", "Person", "Case", "Determination", "NounKind", "Countability"]),
        // A temporal Noun Phrase Adjunct: of location (*this turn*; CGEL, Ch. 8
        // §6.3, p. 698) or of frequency (*three times*; Ch. 8 §9, pp. 713–716).
        "TemporalNounPhrase": (category: Some("NounPhrase"), features: ["Number", "Person", "Case", "Determination", "NounKind", "Countability"]),
        "ComplementNounPhrase": (category: Some("NounPhrase"), features: ["Number", "Person", "Case", "Determination", "NounKind", "Countability"]),
        "Nominal": (features: ["Number", "Countability", "NounKind", "Determination", "NounDistribution"]),
        "QuantifiedNominal": (category: Some("Nominal"), features: ["QuantityNumber", "NounKind", "Determination", "NounDistribution"]),
        "ModifiedQuantifiedNominal": (category: Some("Nominal"), features: ["QuantityNumber", "NounKind", "Determination", "NounDistribution"]),
        // A temporal nominal bounded by a relative clause (*next time you cast a spell*).
        "RelativeTemporalNominal": (category: Some("Nominal"), features: ["Number", "Countability", "NounKind", "Determination", "NounDistribution"]),
        "BareNominal": (category: Some("Nominal"), features: ["Number", "Countability", "NounKind", "Determination", "NounDistribution"]),
        "NounPremodifier": (category: Some("Nominal")),
        "PrepositionalNominal": (category: Some("Nominal"), features: ["Number", "Countability", "NounDistribution"]),
        "BareNominalComplement": (category: Some("Nominal")),
        "Possessor": (category: Some("NounPhrase"), features: ["Number", "Person", "Case"]),
        "NumericalDeterminer": (category: Some("DeterminerPhrase"), features: ["Number", "Countability"]),
        "DeterminerPhrase": (features: ["Number", "Countability", "DeterminativeDistribution", "NounKind"]),
        "PrepositionPhrase": (gap: true),
        // An Adjectival Passive is Passive; it is a predicative Complement
        // only, never a depictive Adjunct or a premodifier.
        "AdjectivePhrase": (features: ["Determination", "AdjectivePosition", "Voice"]),
        "AdverbPhrase": (features: ["AdjunctPosition"]),
        // The predicative Complement function; its head bears it too.
        "Predicative": (function: true),
        // The Adjunct function before a selected Complement or shifted Object.
        "Interleaved": (function: true),
        // The Modifier function after a nominal head: a relative clause or a
        // participial clause.
        "Postmodifier": (function: true, features: ["Number", "NounKind"]),
        // A relative phrase with genitive *whose* (CGEL, Ch. 12 §3.2.5, p. 1043).
        "RelativeNounPhrase": (category: Some("NounPhrase"), features: ["Number"]),
        // A preposition and its relative pronoun, fronted (*for which*).
        "RelativePrepositionPhrase": (category: Some("PrepositionPhrase")),
        "KeywordPhrase": (features: ["Parameterization", "KeywordForm"]),
        "KeywordLineItem": (features: ["KeywordForm"]),
        "KeywordParameters": (features: ["KeywordForm"]),
        "BoundKeyword": (features: ["KeywordForm"]),
        // An Amount's QuantityNumber agrees with a counted noun (*two cards*);
        // as a Noun Phrase it is singular (*X can't be 0*).
        "Amount": (features: ["QuantityNumber", "Sign"]),
        "SignedAmount": (),
        "Cost": (),
        "FiniteClause": (),
        "VerblessClause": (),
        // Subjectless non-finite complements: a to-infinitival is a Clause,
        // a bare infinitival or gerund-participial its Verb Phrase.
        "ToInf": (category: Some("Clause"), gap: true),
        // Its object Gap is filled by the Subject of the verb selecting it.
        "HollowInf": (category: Some("Clause")),
        "BareInf": (category: Some("VerbPhrase"), features: ["Number", "Person", "VerbForm", "Voice"], gap: true),
        "Gerund": (category: Some("VerbPhrase"), features: ["Number", "Person", "VerbForm", "Voice"], gap: true),
        "QuotedAbility": (),
    },
    closed_words: {
        "By": "prep:by",
        "Genitive": "clitic:genitive",
        "That": "det:that",
        "Any": "det:any",
        "Each": "det:each",
        "Or": "coord:or",
        "To": "sub:to",
        "Whichever": "det:whichever",
    },
    lexical_classes: {
        "Predeterminer": ["det:all", "det:both"],
        "LocativeQuantifier": ["det:anywhere"],
        "DegreeQuantifier": ["det:many", "det:much"],
        "Coordinator": ["coord:and", "coord:or"],
        // *Be* and its contracted and negative forms.
        "BeVerb": ["verb:be", "verb:'re", "verb:aren't"],
        // Perfect *have* and its contracted and negative forms.
        "HaveVerb": ["verb:have", "verb:'ve", "verb:haven't"],
        "AlternativeQuantifier": ["det:both", "det:more"],
        "FusedQuantifier": ["det:both", "det:more", "det:everything", "det:this", "det:none"],
        // Subordinator *that* and the relative pronouns (CGEL, Ch. 12 §3.5).
        "RelativeMarker": ["sub:that", "pronoun:which", "pronoun:who"],
    },
    typed_classes: ["CopularVerb", "FusedHeadAdjective", "PhrasalAdverb", "CentralAdverb", "EndAdverb", "CardType", "Supertype", "Subtype", "ParameterizedKeyword", "AbilityWord", "AnchorWord", "BracedSymbol", "Variable", "RangeMarker", "Pawprint"],
    slot_categories: {
        TypeModifier: "TypeModifier",
        NonManaCost: "NonManaCost",
        Quality: "Quality", Name: "Name", Ability: "Ability", Condition: "Condition", Measure: "Measure",
        NP: "ComplementNounPhrase",
        PP: "PrepositionPhrase",
        Pred: "Predicative",
        AdjP: "AdjectivePhrase",
        LocativeNP: "LocativeNounPhrase",
        KeywordPhrase: "KeywordPhrase",
        Nominal: "BareNominalComplement",
        Amount: "Amount",
        Cost: "Cost",
        FiniteClause: "FiniteClause",
        VerblessClause: "VerblessClause",
        ToInf: "ToInf",
        HollowToInf: "HollowInf",
        BareInf: "BareInf",
        Gerund: "Gerund",
        QuotedAbility: "QuotedAbility",
    },
    productions: [
        (name: "TextMode", lhs: "Document", rhs: [Cat("head", "Mode")]),
        (name: "TextModalHeader", lhs: "Document", rhs: [Cat("head", "ModalHeader")]),
        (name: "ModalAbility", lhs: "ModalAbility", rhs: [Cat("header", "ModalHeader"), Mark('\n', Bound), Cat("modes", "Modes")]),
        (name: "ModalTextAbility", lhs: "Ability", rhs: [Cat("head", "ModalAbility")]),
        (name: "ModalEffect", lhs: "Effect", rhs: [Cat("head", "ModalAbility")]),
        (name: "ActivatedModalHeader", lhs: "Document", rhs: [Cat("cost", "ActivationCost"), Punct(':'), Cat("head", "ModalHeader")]),
        (name: "ActivationPayment", lhs: "ActivationCost", rhs: [Cat("head", "Cost")]),
        (name: "SingleMode", lhs: "Modes", rhs: [Cat("head", "Mode")]),
        (name: "ModeSequence", lhs: "Modes", rhs: [Cat("first", "Mode"), Mark('\n', Bound), Cat("rest", "Modes")]),
        (name: "AbilityParagraph", lhs: "Paragraphs", rhs: [Cat("head", "Ability")]),
        (name: "HeaderParagraph", lhs: "Paragraphs", rhs: [Cat("head", "Header")]),
        (name: "AbilityParagraphSequence", lhs: "Paragraphs", rhs: [Cat("first", "Ability"), Mark('\n', Bound), Cat("rest", "Paragraphs")]),
        (name: "HeaderParagraphSequence", lhs: "Paragraphs", rhs: [Cat("first", "Header"), Mark('\n', Bound), Cat("rest", "Paragraphs")]),

        (name: "CardTypeModifier", lhs: "TypeModifier", rhs: [Class("head", "CardType")], equations: [Require("head.Number", "Singular")]),
        (name: "SupertypeModifier", lhs: "TypeModifier", rhs: [Class("head", "Supertype")]),
        (name: "NegativeTypeModifier", lhs: "TypeModifier", rhs: [Lex("prefix", Affix), Cat("head", "TypeModifier")]),
        (name: "IndexedCostHeader", lhs: "Header", rhs: [Cat("cost", "Cost"), Punct(':'), Cat("head", "IndexedNominal")], equations: [Require("head.Number", "Singular")]),
        (name: "KeywordPremodifier", lhs: "BareNominal", rhs: [Cat("modifier", "KeywordPhrase"), Cat("head", "BareNominal")]),

        (name: "TextSymbols", lhs: "Document", rhs: [Cat("head", "Symbols")]),
        (name: "QuantifiedSymbols", lhs: "NounPhrase", rhs: [Cat("quantity", "DeterminerPhrase"), Cat("head", "Symbols")], equations: [Require("$.NounKind", "Ordinary"), Require("$.Determination", "Overt"), Require("$.Case", "Plain")]),
        (name: "QuantifiedSymbolNominal", lhs: "NounPhrase", rhs: [Cat("quantity", "DeterminerPhrase"), Cat("head", "SymbolNominal")], equations: [Require("$.NounKind", "Ordinary"), Require("$.Determination", "Overt"), Require("$.Case", "Plain")]),
        (name: "SymbolPostmodifier", lhs: "SymbolNominal", rhs: [Cat("head", "Symbols"), Cat("modifier", "Postmodifier")]),
        (name: "GroupedNumericAmount", lhs: "Amount", rhs: [Numeral("head", Arabic(true))], equations: [Agree("$.QuantityNumber", "head.Number")]),
        (name: "UnsignedMeasureAmount", lhs: "SignedAmount", rhs: [Cat("head", "Amount")], equations: [Exclude("head.Sign", "Negative")]),
        (name: "PositiveMeasureAmount", lhs: "SignedAmount", rhs: [Mark('+', Prefix), Cat("head", "Amount")], equations: [Exclude("head.Sign", "Negative")]),
        (name: "NegativeMeasureAmount", lhs: "SignedAmount", rhs: [Mark('-', Prefix), Cat("head", "Amount")], equations: [Exclude("head.Sign", "Negative")]),

        (name: "BoundKeywordItem", lhs: "KeywordParameters", rhs: [Cat("head", "BoundKeyword")]),
        (name: "NumericNounPhrase", lhs: "NounPhrase", rhs: [Cat("head", "Amount")], equations: [Require("$.NounKind", "Numeric"), Require("$.Number", "Singular"), Require("$.Determination", "Bare"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        (name: "NonNumericComplement", lhs: "ComplementNounPhrase", rhs: [Cat("head", "NounPhrase")], equations: [Exclude("head.NounKind", "Numeric")]),
        (name: "NumeralNominalPhrase", lhs: "FusedNounPhrase", rhs: [Cat("head", "ChoiceQuantity")], equations: [Require("$.NounKind", "Ordinary"), Require("$.Determination", "Bare"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        (name: "CardinalChoice", lhs: "ChoiceQuantity", rhs: [Numeral("head", Cardinal)]),
        (name: "FusedQuantifierNominalPhrase", lhs: "FusedNounPhrase", rhs: [Class("head", "FusedQuantifier")], equations: [Require("$.NounKind", "Ordinary"), Require("$.Determination", "Bare"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        (name: "AlternativeChoice", lhs: "ChoiceQuantity", rhs: [Numeral("first", Cardinal), Word("coordinator", "Or"), Class("second", "AlternativeQuantifier")]),
        (name: "CardinalDeterminer", lhs: "NumericalDeterminer", rhs: [Numeral("head", Cardinal)], equations: [Require("$.Countability", "Count")]),
        (name: "VariableDeterminer", lhs: "NumericalDeterminer", rhs: [Class("head", "Variable")], equations: [Require("$.Countability", "Count")]),
        (name: "ArabicDeterminer", lhs: "NumericalDeterminer", rhs: [Numeral("head", Arabic(false))], equations: [Require("$.Countability", "Count")]),
        (name: "GroupedArabicDeterminer", lhs: "NumericalDeterminer", rhs: [Numeral("head", Arabic(true))], equations: [Require("$.Countability", "Count")]),
        (name: "NegativeAdjective", lhs: "AdjectivePhrase", rhs: [Lex("prefix", Affix), Cat("head", "AdjectivePhrase")]),
        (name: "ChapterModalHeader", lhs: "Document", rhs: [Cat("chapters", "Chapters"), Mark('—', Free), Cat("head", "ModalHeader")]),

        (name: "CompleteKeywordPhrase", lhs: "KeywordPhrase", rhs: [Cat("head", "KeywordParameters")], equations: [Require("$.Parameterization", "Supplied")]),
        (name: "CompleteKeywordItem", lhs: "KeywordLineItem", rhs: [Cat("head", "KeywordPhrase")], equations: [Require("head.Parameterization", "Supplied")]),
        (name: "BareKeywordMention", lhs: "KeywordPhrase", rhs: [Class("head", "ParameterizedKeyword")], equations: [Require("$.Parameterization", "Omitted")]),
        (name: "TextAbility", lhs: "Document", rhs: [Cat("head", "Ability")]),
        (name: "TextTypeLine", lhs: "Document", rhs: [Cat("head", "TypeLine")]),
        (name: "TextHeader", lhs: "Document", rhs: [Cat("head", "Header")]),
        (name: "HeaderSequence", lhs: "Document", rhs: [Cat("first", "Header"), Mark('\n', Bound), Cat("rest", "Paragraphs")]),
        (name: "TextSequence", lhs: "Document", rhs: [Cat("first", "Ability"), Mark('\n', Bound), Cat("rest", "Paragraphs")]),
        (name: "SentenceAbility", lhs: "Ability", rhs: [Cat("head", "Sentences")]),
        (name: "KeywordAbilityList", lhs: "Ability", rhs: [Cat("head", "KeywordList")]),
        (name: "SingleKeyword", lhs: "KeywordList", rhs: [Cat("head", "KeywordLineItem")]),
        (name: "CommaKeywords", lhs: "KeywordList", rhs: [Cat("first", "KeywordLineItem"), Punct(','), Cat("rest", "KeywordList")]),
        (name: "SemicolonKeywords", lhs: "KeywordList", rhs: [Cat("first", "KeywordLineItem"), Punct(';'), Cat("rest", "KeywordList")]),
        (name: "TypesOnly", lhs: "TypeLine", rhs: [Cat("head", "CardTypes")]),
        (name: "TypesWithSubtypes", lhs: "TypeLine", rhs: [Cat("head", "CardTypes"), Mark('—', Free), Cat("subtypes", "Subtypes")]),
        (name: "SupertypePrefix", lhs: "TypeLine", rhs: [Class("modifier", "Supertype"), Cat("head", "TypeLine")]),
        (name: "SingleCardType", lhs: "CardTypes", rhs: [Class("head", "CardType")], equations: [Require("head.Number", "Singular")]),
        (name: "MultipleCardTypes", lhs: "CardTypes", rhs: [Class("first", "CardType"), Cat("rest", "CardTypes")], equations: [Require("first.Number", "Singular")]),
        (name: "SingleSubtype", lhs: "Subtypes", rhs: [Class("head", "Subtype")], equations: [Require("head.Number", "Singular")]),
        (name: "MultipleSubtypes", lhs: "Subtypes", rhs: [Class("first", "Subtype"), Cat("rest", "Subtypes")], equations: [Require("first.Number", "Singular")]),
        (name: "NumericAmount", lhs: "Amount", rhs: [Numeral("head", Arabic(false))], equations: [Agree("$.QuantityNumber", "head.Number")]),
        (name: "VariableAmount", lhs: "Amount", rhs: [Class("head", "Variable")], equations: [Agree("$.QuantityNumber", "head.Number")]),
        (name: "SingleSymbol", lhs: "Symbols", rhs: [Class("head", "BracedSymbol")]),
        (name: "SymbolSequence", lhs: "Symbols", rhs: [Class("first", "BracedSymbol"), Attached("rest", "Symbols", Suffix)]),
        (name: "SymbolCost", lhs: "Cost", rhs: [Cat("head", "SymbolCosts")]),
        (name: "SingleSymbolCost", lhs: "SymbolCosts", rhs: [Cat("head", "Symbols")]),
        (name: "CostSequence", lhs: "SymbolCosts", rhs: [Cat("first", "Symbols"), Punct(','), Cat("rest", "SymbolCosts")]),
        (name: "NegativeLoyaltySymbolCost", lhs: "ActivationCost", rhs: [Mark('−', Prefix), Cat("amount", "Amount")]),
        (name: "PositiveLoyaltySymbolCost", lhs: "ActivationCost", rhs: [Mark('+', Prefix), Cat("amount", "Amount")]),
        (name: "ZeroLoyaltySymbolCost", lhs: "ActivationCost", rhs: [Cat("amount", "Amount")]),
        (name: "LoyaltySymbol", lhs: "LoyaltySymbol", rhs: [Mark('[', Prefix), Cat("amount", "Amount"), Punct(']')]),
        (name: "UnicodeNegativeLoyaltySymbol", lhs: "LoyaltySymbol", rhs: [Mark('[', Prefix), Mark('−', Bound), Cat("amount", "Amount"), Punct(']')]),
        (name: "PositiveLoyaltySymbol", lhs: "LoyaltySymbol", rhs: [Mark('[', Prefix), Mark('+', Bound), Cat("amount", "Amount"), Punct(']')]),
        (name: "LoyaltyCost", lhs: "ActivationCost", rhs: [Cat("head", "LoyaltySymbol")]),
        (name: "LoyaltyNominal", lhs: "BareNominal", rhs: [Cat("head", "LoyaltySymbol")], equations: [Require("$.Number", "Singular"), Require("$.Countability", "Count")]),
        (name: "VerbalCost", lhs: "NonManaCost", rhs: [Cat("head", "VerbPhrase")], equations: [Require("head.VerbForm", "Plain")]),
        (name: "CompositeNonManaCost", lhs: "NonManaCost", rhs: [Cat("first", "Symbols"), Punct(','), Cat("rest", "NonManaCost")]),
        (name: "NonManaCost", lhs: "Cost", rhs: [Cat("head", "NonManaCost")]),
        (name: "ActivatedAbility", lhs: "Ability", rhs: [Cat("cost", "ActivationCost"), Punct(':'), Cat("effect", "Effect")]),
        (name: "LabelledAbility", lhs: "Ability", rhs: [Class("label", "AbilityWord"), Mark('—', Free), Cat("head", "Ability")]),
        // A mode labelled by an Anchor Word [CR#614.12c]: *• Khans — ...*.
        (name: "AnchoredAbility", lhs: "Ability", rhs: [Class("label", "AnchorWord"), Mark('—', Free), Cat("head", "Ability")]),
        (name: "FlavorLabelledAbility", lhs: "Ability", rhs: [Lex("label", FlavorWord), Cat("head", "Ability")]),
        (name: "NominalMode", lhs: "Mode", rhs: [Mark('•', Free), Cat("head", "Nominal"), Punct('.')], equations: [Require("head.Determination", "Bare")]),
        (name: "NounPhraseMode", lhs: "Mode", rhs: [Mark('•', Free), Cat("head", "NounPhrase"), Punct('.')]),
        (name: "KeywordFollowedBySentences", lhs: "Ability", rhs: [Cat("first", "KeywordList"), Cat("rest", "Sentences")]),
        (name: "NamePremodifier", lhs: "BareNominal", rhs: [Cat("modifier", "Name"), Cat("head", "BareNominal")]),
        (name: "ModeBullet", lhs: "Mode", rhs: [Mark('•', Free), Cat("head", "Ability")]),
        (name: "CostedModeBullet", lhs: "Mode", rhs: [Mark('•', Free), Cat("cost", "Cost"), Mark('—', Free), Cat("head", "ModeEffect")]),
        (name: "PlusCostedMode", lhs: "Mode", rhs: [Mark('+', Free), Cat("cost", "Cost"), Mark('—', Free), Cat("head", "ModeEffect")]),
        (name: "LabelledCostedMode", lhs: "Mode", rhs: [Mark('•', Free), Lex("label", FlavorWord), Cat("cost", "Cost"), Mark('—', Free), Cat("head", "ModeEffect")]),
        (name: "PawprintMode", lhs: "Mode", rhs: [Cat("quantity", "Pawprints"), Mark('—', Free), Cat("head", "ModeEffect")]),
        (name: "SinglePawprint", lhs: "Pawprints", rhs: [Class("head", "Pawprint")]),
        (name: "PawprintSequence", lhs: "Pawprints", rhs: [Class("first", "Pawprint"), Attached("rest", "Pawprints", Suffix)]),
        (name: "SingleSentence", lhs: "Sentences", rhs: [Cat("head", "Sentence")]),
        (name: "SentenceSequence", lhs: "Sentences", rhs: [Cat("first", "Sentence"), Cat("rest", "Sentences")]),
        (name: "SentenceEffect", lhs: "Effect", rhs: [Cat("head", "Sentences")]),
        (name: "ModeInstruction", lhs: "ModeEffect", rhs: [Cat("head", "Effect")]),
        (name: "ModeMeasure", lhs: "ModeEffect", rhs: [Cat("head", "Measure"), Punct('.')]),
        (name: "SingularNominalQuality", lhs: "Quality", rhs: [Cat("head", "Nominal")], equations: [Require("head.Number", "Singular")]),
        (name: "NominalPhraseQuality", lhs: "Quality", rhs: [Cat("head", "NounPhrase")]),
        (name: "AdjectivalQuality", lhs: "Quality", rhs: [Cat("head", "AdjectivePhrase")]),
        (name: "NamedParameter", lhs: "Name", rhs: [Lex("head", Catalog)]),
        (name: "SlashMeasure", lhs: "Measure", rhs: [Cat("first", "SignedAmount"), Mark('/', Bound), Cat("second", "SignedAmount")]),
        (name: "MeasureHeader", lhs: "Header", rhs: [Cat("head", "Measure")]),
        (name: "RangeHeader", lhs: "Header", rhs: [Class("marker", "RangeMarker"), Cat("lower", "Amount"), Mark('-', Bound), Cat("upper", "Amount")]),
        (name: "OpenRangeHeader", lhs: "Header", rhs: [Class("marker", "RangeMarker"), Cat("lower", "Amount"), Punct('+')]),
        (name: "SingleChapter", lhs: "Chapters", rhs: [Numeral("head", Roman)]),
        (name: "ChapterSequence", lhs: "Chapters", rhs: [Numeral("first", Roman), Punct(','), Cat("rest", "Chapters")]),
        (name: "ChapterAbility", lhs: "Ability", rhs: [Cat("chapters", "Chapters"), Mark('—', Free), Cat("head", "Ability")]),
        (name: "ChoiceHeader", lhs: "ModalHeader", rhs: [Cat("head", "VerbPhrase"), Mark('—', Free)], equations: [Require("head.VerbForm", "Plain")]),

        // Sentences: a bare imperative or a declarative clause.
        (name: "Imperative", lhs: "Clause", rhs: [Cat("head", "VerbPhrase")],
            equations: [Require("head.VerbForm", "Plain"), Require("$.ClauseMarking", "Unmarked")]),
        (name: "ClauseFragment", lhs: "Document", rhs: [Cat("head", "Clause")]),
        (name: "Declarative", lhs: "Sentence", rhs: [Cat("clause", "Clause"), Punct('.')], equations: [Require("clause.ClauseMarking", "Unmarked"), Exclude("clause.Inflection", "Irrealis")]),
        (name: "SubjectPredicate", lhs: "Clause",
            rhs: [Cat("subject", "NounPhrase"), Cat("head", "VerbPhrase")],
            equations: [
                Agree("subject.Number", "head.Number"),
                Agree("subject.Person", "head.Person"),
                Require("head.VerbForm", "Finite"),
                Exclude("subject.Case", "Accusative"),
                Require("$.ClauseMarking", "Unmarked"),
            ],
            transparent: ["head"]),

        // An existential clause: dummy *there*, the copula agreeing with the
        // displaced subject, and an optional locative complement.
        (name: "Existential", lhs: "Clause", rhs: [Cat("subject", "DummyPronoun"), Cat("head", "ExistentialPredicate")],
            equations: [Agree("subject.Number", "head.Number"), Agree("subject.Person", "head.Person"),
                Require("head.VerbForm", "Finite"), Require("$.ClauseMarking", "Unmarked")]),
        (name: "ExistentialThere", lhs: "DummyPronoun", rhs: [Lex("head", Pronoun)],
            equations: [Require("head.PronounKind", "Existential")]),
        (name: "ExistentialBe", lhs: "ExistentialPredicate", rhs: [Class("head", "BeVerb"), Cat("displaced_subject", "NounPhrase")],
            equations: [Agree("$.Number", "displaced_subject.Number"), Exclude("displaced_subject.Case", "Accusative")]),
        (name: "LocatedExistentialBe", lhs: "ExistentialPredicate", rhs: [Class("head", "BeVerb"), Cat("displaced_subject", "NounPhrase"), Cat("complement", "PrepositionPhrase")],
            equations: [Agree("$.Number", "displaced_subject.Number"), Exclude("displaced_subject.Case", "Accusative")]),

        (name: "EndAdverb", lhs: "AdverbPhrase", rhs: [Class("head", "EndAdverb")],
            equations: [Require("$.AdjunctPosition", "End")]),
        (name: "CentralAdverb", lhs: "AdverbPhrase", rhs: [Class("head", "CentralAdverb")],
            equations: [Require("$.AdjunctPosition", "Central")]),
        (name: "EndAdverbial", lhs: "VerbPhrase", rhs: [Cat("head", "VerbPhrase"), Cat("adjunct", "AdverbPhrase")],
            equations: [Require("adjunct.AdjunctPosition", "End")], transparent: ["head"]),
        (name: "CentralAdverbial", lhs: "VerbPhrase", rhs: [Cat("adjunct", "AdverbPhrase"), Cat("head", "VerbPhrase")],
            equations: [Require("adjunct.AdjunctPosition", "Central")], transparent: ["head"]),

        // Auxiliaries take a verb phrase complement through which a Gap passes.
        (name: "Progressive", lhs: "VerbPhrase", rhs: [Class("head", "BeVerb"), Cat("complement", "VerbPhrase")],
            equations: [Require("complement.VerbForm", "GerundParticiple"), Agree("$.Voice", "complement.Voice")],
            transparent: ["complement"]),
        // The perfect takes an active participle phrase or a passive one
        // headed by *been*.
        (name: "Perfect", lhs: "VerbPhrase", rhs: [Class("head", "HaveVerb"), Cat("complement", "VerbPhrase")],
            equations: [Require("complement.VerbForm", "PastParticiple"), Require("complement.Voice", "Active"),
                Require("$.Voice", "Active")],
            transparent: ["complement"]),
        (name: "PassivePerfect", lhs: "VerbPhrase", rhs: [Class("head", "HaveVerb"), Cat("complement", "VerbPhrase")],
            equations: [Require("complement.VerbForm", "PastParticiple"), Require("complement.Voice", "Passive"),
                Require("complement.VerbKind", "Auxiliary"), Require("$.Voice", "Passive")],
            transparent: ["complement"]),
        // The passive auxiliary takes a lexical verb's passive participle phrase.
        (name: "Passive", lhs: "VerbPhrase", rhs: [Class("head", "BeVerb"), Cat("complement", "VerbPhrase")],
            equations: [Require("complement.VerbForm", "PastParticiple"), Require("complement.Voice", "Passive"),
                Exclude("complement.VerbKind", "Auxiliary"), Require("$.Voice", "Passive")],
            transparent: ["complement"]),

        // Non-finite complements.
        (name: "ToInfinitival", lhs: "Clause", rhs: [Word("marker", "To"), Cat("head", "VerbPhrase")],
            equations: [Require("head.VerbForm", "Plain"), Require("$.ClauseMarking", "To")], transparent: ["head"]),
        (name: "ModifiedInfinitival", lhs: "Clause", rhs: [Cat("adjunct", "AdverbPhrase"), Cat("head", "Clause")],
            equations: [Require("adjunct.AdjunctPosition", "Phrasal"), Require("head.ClauseMarking", "To")], transparent: ["head"]),
        (name: "InfinitivalComplement", lhs: "ToInf", rhs: [Cat("head", "Clause")],
            equations: [Require("head.ClauseMarking", "To")], transparent: ["head"]),
        (name: "BareInfinitival", lhs: "BareInf", rhs: [Cat("head", "VerbPhrase")],
            equations: [Require("head.VerbForm", "Plain")], transparent: ["head"]),
        (name: "GerundParticipial", lhs: "Gerund", rhs: [Cat("head", "VerbPhrase")],
            equations: [Require("head.VerbForm", "GerundParticiple")], transparent: ["head"]),
        // A hollow *to*-infinitival (*this spell costs {1} to cast*; CGEL,
        // Ch. 14 §6.3(c), p. 1250).
        (name: "HollowInfinitival", lhs: "HollowInf", rhs: [Word("marker", "To"), Cat("head", "VerbPhrase")],
            equations: [Require("head.VerbForm", "Plain"), Require("head.Gap", "NP")]),
        // A purpose adjunct whose object Gap a relative clause binds (*the
        // first spell that mana from a Treasure was spent to cast*).
        (name: "GappedPurpose", lhs: "VerbPhrase", rhs: [Cat("head", "VerbPhrase"), Cat("adjunct", "ToInf")],
            equations: [Require("adjunct.Gap", "NP")], transparent: ["adjunct"]),
        // A central adverb before a copular verb's predicative Complement
        // (*is no longer snow*, *become no longer suspected*).
        (name: "PostCopularAdverbial", lhs: "VerbPhrase", rhs: [Class("head", "CopularVerb"), Cat("adjunct", "AdverbPhrase"), Cat("predicative_complement", "Predicative")],
            equations: [Require("adjunct.AdjunctPosition", "Central")]),

        (name: "PrepositionFragment", lhs: "Document", rhs: [Cat("head", "PrepositionPhrase")]),
        (name: "MeasurePremodifier", lhs: "BareNominal", rhs: [Cat("modifier", "Measure"), Cat("head", "BareNominal")]),
        (name: "MeasureNominal", lhs: "BareNominal", rhs: [Cat("head", "Measure")], equations: [Require("$.Number", "Singular"), Require("$.Countability", "Count")]),
        (name: "OrdinalAdjective", lhs: "AdjectivePhrase", rhs: [Numeral("head", Ordinal)]),
        (name: "InterleavedPreposition", lhs: "Interleaved", rhs: [Cat("head", "PrepositionPhrase")], cost: 0),
        (name: "InterleavedTemporal", lhs: "Interleaved", rhs: [Cat("head", "TemporalNounPhrase")], cost: 0),
        (name: "InterleavedDepictive", lhs: "Interleaved", rhs: [Cat("head", "AdjectivePhrase")], equations: [Exclude("head.Voice", "Passive"), Exclude("head.Determination", "Overt"), Exclude("head.AdjectivePosition", "Attributive")], cost: 0),
        (name: "DepictiveAdjective", lhs: "VerbPhrase", rhs: [Cat("head", "VerbPhrase"), Cat("adjunct", "AdjectivePhrase")], equations: [Exclude("adjunct.Voice", "Passive"), Exclude("adjunct.Determination", "Overt"), Exclude("adjunct.AdjectivePosition", "Attributive")], transparent: ["head"], cost: 0),

        (name: "PhrasalAdverb", lhs: "AdverbPhrase", rhs: [Class("head", "PhrasalAdverb")], equations: [Require("$.AdjunctPosition", "Phrasal")]),
        (name: "DegreeDeterminer", lhs: "DeterminerPhrase", rhs: [Word("modifier", "That"), Class("head", "DegreeQuantifier")]),
        (name: "FusedDegreeDeterminer", lhs: "NounPhrase", rhs: [Word("modifier", "That"), Class("head", "DegreeQuantifier")], equations: [Require("$.NounKind", "Ordinary"), Require("$.Determination", "Bare"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        (name: "AdverbModifiedNounPhrase", lhs: "NounPhrase", rhs: [Cat("modifier", "AdverbPhrase"), Cat("head", "NounPhrase")], equations: [Require("modifier.AdjunctPosition", "Phrasal")]),
        (name: "AdverbModifiedPrepositionPhrase", lhs: "PrepositionPhrase", rhs: [Cat("modifier", "AdverbPhrase"), Cat("head", "PrepositionPhrase")], equations: [Require("modifier.AdjunctPosition", "Phrasal")]),
        (name: "AdverbModifiedDeterminerPhrase", lhs: "DeterminerPhrase", rhs: [Cat("modifier", "AdverbPhrase"), Cat("head", "DeterminerPhrase")], equations: [Require("modifier.AdjunctPosition", "Phrasal"), Require("head.DeterminativeDistribution", "Numerical")]),
        // A focused predicative adjective (*attack only alone*).
        (name: "AdverbModifiedAdjectivePhrase", lhs: "AdjectivePhrase", rhs: [Cat("modifier", "AdverbPhrase"), Cat("head", "AdjectivePhrase")], equations: [Require("modifier.AdjunctPosition", "Phrasal"), Require("head.AdjectivePosition", "Predicative"), Require("$.AdjectivePosition", "Predicative")]),
        (name: "AdverbModifiedAdverbPhrase", lhs: "AdverbPhrase", rhs: [Cat("modifier", "AdverbPhrase"), Cat("head", "AdverbPhrase")], equations: [Require("modifier.AdjunctPosition", "Phrasal")]),
        (name: "PredeterminerCount", lhs: "NounPhrase", rhs: [Class("determiner", "Predeterminer"), Cat("head", "NounPhrase")], equations: [Require("head.Determination", "Overt"), Require("head.Number", "Plural"), Agree("determiner.Number", "head.Number"), Agree("determiner.Countability", "head.Countability")]),
        (name: "PredeterminerMass", lhs: "NounPhrase", rhs: [Class("determiner", "Predeterminer"), Cat("head", "NounPhrase")], equations: [Require("head.Determination", "Overt"), Require("head.Countability", "Mass"), Require("head.Number", "Singular"), Agree("determiner.Number", "head.Number"), Agree("determiner.Countability", "head.Countability")]),
        (name: "SingularQuantifier", lhs: "DeterminerPhrase", rhs: [Word("head", "Any"), Numeral("modifier", Cardinal)], equations: [Require("modifier.Number", "Singular"), Require("$.Number", "Singular")]),
        // A temporal Noun Phrase Adjunct: a period noun with a deictic or
        // distributive determinative (*this turn*, *each combat*), never with
        // an article or genitive (*the turn*), and without postmodifiers;
        // serial *time* with any determinative (*any time*, *an additional
        // time*, *three times*); or a temporal nominal bounded by a relative
        // clause (*the next time you cast a spell*; CGEL, Ch. 8 §6.3, p. 698).
        (name: "TemporalLocation", lhs: "TemporalNounPhrase", rhs: [Cat("determiner", "DeterminerPhrase"), Cat("head", "BareNominal")],
            equations: [Require("head.NounKind", "Temporal"), Exclude("head.NounDistribution", "Serial"), Exclude("determiner.DeterminativeDistribution", "Dependent"), Exclude("determiner.DeterminativeDistribution", "Independent"), Exclude("determiner.DeterminativeDistribution", "Numerical"), Exclude("determiner.DeterminativeDistribution", "IndefiniteArticle"), Exclude("determiner.DeterminativeDistribution", "SingularOrQuantified"),
                Agree("determiner.NounKind", "head.NounKind"), Agree("determiner.Countability", "head.Countability"), Agree("determiner.Number", "head.Number"), Require("$.Determination", "Overt"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        (name: "SerialTemporal", lhs: "TemporalNounPhrase", rhs: [Cat("determiner", "DeterminerPhrase"), Cat("head", "BareNominal")],
            equations: [Require("head.NounDistribution", "Serial"), Exclude("determiner.DeterminativeDistribution", "Independent"), Agree("determiner.NounKind", "head.NounKind"), Agree("determiner.Countability", "head.Countability"), Agree("determiner.Number", "head.Number"), Require("$.Determination", "Overt"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        // A focused temporal adjunct (*only any time they could cast a sorcery*).
        (name: "AdverbModifiedTemporal", lhs: "TemporalNounPhrase", rhs: [Cat("modifier", "AdverbPhrase"), Cat("head", "TemporalNounPhrase")], equations: [Require("modifier.AdjunctPosition", "Phrasal")]),
        (name: "RelativeTemporalLocation", lhs: "TemporalNounPhrase", rhs: [Cat("determiner", "DeterminerPhrase"), Cat("head", "RelativeTemporalNominal")],
            equations: [Exclude("determiner.DeterminativeDistribution", "Independent"), Agree("determiner.NounKind", "head.NounKind"), Agree("determiner.Countability", "head.Countability"), Agree("determiner.Number", "head.Number"), Require("$.Determination", "Overt"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        (name: "RelativeTime", lhs: "RelativeTemporalNominal", rhs: [Cat("head", "Nominal"), Cat("modifier", "RelativeClause")],
            equations: [Require("head.NounKind", "Temporal"), Agree("head.Number", "modifier.Number"), Agree("head.NounKind", "modifier.NounKind")]),
        (name: "RelativeTimePostmodifier", lhs: "RelativeTemporalNominal", rhs: [Cat("head", "RelativeTemporalNominal"), Cat("modifier", "TemporalNounPhrase")], cost: 2),
        // A preposed temporal Noun Phrase (*This turn, ...*; *The next time ..., ...*).
        (name: "PreposedTemporalAdjunct", lhs: "Clause", rhs: [Cat("adjunct", "TemporalNounPhrase"), Punct(','), Cat("head", "Clause")], transparent: ["head"]),
        // *the first time each turn*: a temporal Noun Phrase modifies a
        // temporal nominal.
        (name: "TemporalPostmodifier", lhs: "Nominal", rhs: [Cat("head", "Nominal"), Cat("modifier", "TemporalNounPhrase")],
            equations: [Require("head.NounKind", "Temporal")], cost: 2),
        (name: "TemporalAdjunct", lhs: "VerbPhrase", rhs: [Cat("head", "VerbPhrase"), Cat("adjunct", "TemporalNounPhrase")], transparent: ["head"], cost: 2),
        (name: "MannerAdjunct", lhs: "VerbPhrase", rhs: [Cat("head", "VerbPhrase"), Cat("adjunct", "NounPhrase")], equations: [Require("adjunct.NounKind", "Manner")], transparent: ["head"], cost: 2),
        (name: "FrequencyInterval", lhs: "AdverbPhrase", rhs: [Cat("head", "AdverbPhrase"), Cat("adjunct", "TemporalNounPhrase")], equations: [Require("head.AdjunctPosition", "End")]),
        (name: "NumericCountPremodifier", lhs: "QuantifiedNominal", rhs: [Cat("modifier", "Amount"), Cat("head", "BareNominal")], equations: [Agree("$.QuantityNumber", "head.Number"), Require("head.Countability", "Count"), Agree("modifier.QuantityNumber", "head.Number")]),
        (name: "NumericMassPremodifier", lhs: "QuantifiedNominal", rhs: [Cat("modifier", "Amount"), Cat("head", "BareNominal")], equations: [Agree("$.QuantityNumber", "head.Number"), Require("head.Countability", "Mass"), Require("head.NounDistribution", "DirectMeasure")]),
        (name: "CardinalCountPremodifier", lhs: "QuantifiedNominal", rhs: [Numeral("modifier", Cardinal), Cat("head", "BareNominal")], equations: [Agree("$.QuantityNumber", "head.Number"), Require("head.Countability", "Count"), Agree("modifier.Number", "head.Number")]),
        (name: "CardinalMassPremodifier", lhs: "QuantifiedNominal", rhs: [Numeral("modifier", Cardinal), Cat("head", "BareNominal")], equations: [Agree("$.QuantityNumber", "head.Number"), Require("head.Countability", "Mass"), Require("head.NounDistribution", "DirectMeasure")]),
        (name: "ModifiedQuantity", lhs: "ModifiedQuantifiedNominal", rhs: [Cat("modifier", "AdjectivePhrase"), Cat("head", "QuantifiedNominal")], equations: [Exclude("modifier.Voice", "Passive"), Exclude("modifier.AdjectivePosition", "Predicative")]),
        (name: "DeterminedQuantity", lhs: "NounPhrase", rhs: [Cat("determiner", "DeterminerPhrase"), Cat("head", "QuantifiedNominal")], equations: [Agree("determiner.Number", "head.QuantityNumber"), Exclude("determiner.DeterminativeDistribution", "SingularOrQuantified"), Exclude("determiner.DeterminativeDistribution", "Independent"), Exclude("determiner.DeterminativeDistribution", "Distributive"), Exclude("determiner.DeterminativeDistribution", "IndefiniteArticle"), Agree("$.Number", "head.QuantityNumber"), Require("determiner.Countability", "Count"), Agree("determiner.NounKind", "head.NounKind"), Require("$.Countability", "Count"), Require("$.Case", "Plain"), Require("$.Person", "Third"), Require("$.Determination", "Overt")]),
        (name: "SingularOrQuantifiedDetermination", lhs: "NounPhrase", rhs: [Cat("determiner", "DeterminerPhrase"), Cat("head", "QuantifiedNominal")], equations: [Require("determiner.DeterminativeDistribution", "SingularOrQuantified"), Agree("$.Number", "head.QuantityNumber"), Require("determiner.Countability", "Count"), Agree("determiner.NounKind", "head.NounKind"), Require("$.Countability", "Count"), Require("$.Case", "Plain"), Require("$.Person", "Third"), Require("$.Determination", "Overt")]),
        (name: "DistributiveQuantity", lhs: "NounPhrase", rhs: [Cat("determiner", "DeterminerPhrase"), Cat("head", "QuantifiedNominal")], equations: [Require("determiner.DeterminativeDistribution", "Distributive"), Agree("$.Number", "determiner.Number"), Require("determiner.Countability", "Count"), Agree("determiner.NounKind", "head.NounKind"), Require("$.Countability", "Count"), Require("$.Case", "Plain"), Require("$.Person", "Third"), Require("$.Determination", "Overt")]),
        (name: "DeterminedModifiedQuantity", lhs: "NounPhrase", rhs: [Cat("determiner", "DeterminerPhrase"), Cat("head", "ModifiedQuantifiedNominal")], equations: [Exclude("determiner.DeterminativeDistribution", "Dependent"), Exclude("determiner.DeterminativeDistribution", "Deictic"), Exclude("determiner.DeterminativeDistribution", "Numerical"), Exclude("determiner.DeterminativeDistribution", "Independent"), Exclude("determiner.DeterminativeDistribution", "Distributive"), Agree("$.Number", "head.QuantityNumber"), Require("determiner.Countability", "Count"), Agree("determiner.NounKind", "head.NounKind"), Require("$.Countability", "Count"), Require("$.Case", "Plain"), Require("$.Person", "Third"), Require("$.Determination", "Overt")]),
        (name: "AgreeingModifiedQuantity", lhs: "NounPhrase", rhs: [Cat("determiner", "DeterminerPhrase"), Cat("head", "ModifiedQuantifiedNominal")], equations: [Agree("determiner.Number", "head.QuantityNumber"), Exclude("determiner.DeterminativeDistribution", "SingularOrQuantified"), Exclude("determiner.DeterminativeDistribution", "IndefiniteArticle"), Exclude("determiner.DeterminativeDistribution", "Independent"), Exclude("determiner.DeterminativeDistribution", "Distributive"), Agree("$.Number", "head.QuantityNumber"), Require("determiner.Countability", "Count"), Agree("determiner.NounKind", "head.NounKind"), Require("$.Countability", "Count"), Require("$.Case", "Plain"), Require("$.Person", "Third"), Require("$.Determination", "Overt")]),
        (name: "DistributiveModifiedQuantity", lhs: "NounPhrase", rhs: [Cat("determiner", "DeterminerPhrase"), Cat("head", "ModifiedQuantifiedNominal")], equations: [Require("determiner.DeterminativeDistribution", "Distributive"), Agree("$.Number", "determiner.Number"), Require("determiner.Countability", "Count"), Agree("determiner.NounKind", "head.NounKind"), Require("$.Countability", "Count"), Require("$.Case", "Plain"), Require("$.Person", "Third"), Require("$.Determination", "Overt")]),
        (name: "NominalInstruction", lhs: "Sentence", rhs: [Cat("head", "IndexedNominal"), Punct('.')]),
        (name: "FusedCardinalHead", lhs: "NounPhrase", rhs: [Cat("determiner", "DeterminerPhrase"), Numeral("head", Cardinal)], equations: [Exclude("determiner.DeterminativeDistribution", "Independent"), Require("determiner.Countability", "Count"), Require("$.Case", "Plain"), Require("$.NounKind", "Ordinary"), Require("$.Countability", "Count"), Require("$.Determination", "Overt"), Require("$.Person", "Third"), Agree("determiner.Number", "head.Number")]),
        (name: "FusedAdjectiveHead", lhs: "NounPhrase", rhs: [Cat("determiner", "DeterminerPhrase"), Class("head", "FusedHeadAdjective")], equations: [Require("$.Case", "Plain"), Require("$.Person", "Third"), Require("$.Determination", "Overt"), Require("$.Countability", "Count"), Require("$.NounKind", "Ordinary")]),
        (name: "SingleRowHeader", lhs: "RowHeader", rhs: [Cat("head", "Amount")]),
        (name: "OpenRowHeader", lhs: "RowHeader", rhs: [Cat("head", "Amount"), Punct('+')]),
        (name: "HyphenRowHeader", lhs: "RowHeader", rhs: [Cat("lower", "Amount"), Mark('-', Bound), Cat("upper", "Amount")]),
        (name: "UnicodeRangeRowHeader", lhs: "RowHeader", rhs: [Cat("lower", "Amount"), Mark('—', Bound), Cat("upper", "Amount")]),
        (name: "TableRow", lhs: "Ability", rhs: [Cat("header", "RowHeader"), Mark('|', Free), Cat("head", "Ability")]),
        (name: "SequentialVerbalCosts", lhs: "NonManaCost", rhs: [Cat("first", "VerbPhrase"), Punct(','), Cat("rest", "Cost")], equations: [Require("first.VerbForm", "Plain")]),
        (name: "DeclarativeCost", lhs: "NonManaCost", rhs: [Cat("head", "Clause")], equations: [Require("head.VerbForm", "Finite"), Exclude("head.Inflection", "Irrealis")]),
        (name: "DeclarativeChoiceHeader", lhs: "ModalHeader", rhs: [Cat("head", "Clause"), Mark('—', Free)], equations: [Require("head.VerbForm", "Finite"), Exclude("head.Inflection", "Irrealis")]),
        (name: "ClauseCondition", lhs: "Condition", rhs: [Cat("head", "Clause")]),
        (name: "KeywordInstruction", lhs: "Sentence", rhs: [Cat("head", "KeywordLineItem"), Punct('.')], equations: [Require("head.KeywordForm", "Parametric")]),
        (name: "FloatedEach", lhs: "Clause", rhs: [Cat("subject", "NounPhrase"), Word("adjunct", "Each"), Cat("head", "VerbPhrase")], equations: [Require("subject.Number", "Plural"), Exclude("subject.Case", "Accusative"), Agree("subject.Number", "head.Number"), Agree("subject.Person", "head.Person"), Require("head.VerbForm", "Finite"), Require("$.ClauseMarking", "Unmarked")], transparent: ["head"]),
        (name: "NumericalDetermination", lhs: "DeterminerPhrase", rhs: [Cat("head", "NumericalDeterminer")], equations: [Require("$.DeterminativeDistribution", "Numerical")]),
        (name: "MeasuredMass", lhs: "NounPhrase", rhs: [Cat("determiner", "DeterminerPhrase"), Cat("head", "Nominal")], equations: [Require("determiner.DeterminativeDistribution", "Numerical"), Require("head.NounDistribution", "DirectMeasure"), Require("head.Countability", "Mass"), Require("head.Number", "Singular"), Require("$.Case", "Plain"), Require("$.Determination", "Overt"), Require("$.Person", "Third")]),
        // A measure noun counted unit by unit (*for each mana spent*).
        (name: "DistributiveMeasure", lhs: "NounPhrase", rhs: [Cat("determiner", "DeterminerPhrase"), Cat("head", "Nominal")], equations: [Require("determiner.DeterminativeDistribution", "Distributive"), Require("head.NounDistribution", "DirectMeasure"), Require("head.Countability", "Mass"), Require("head.Number", "Singular"), Agree("determiner.NounKind", "head.NounKind"), Require("$.Case", "Plain"), Require("$.Person", "Third"), Require("$.Determination", "Overt")]),
        (name: "BareSingularTerm", lhs: "NounPhrase", rhs: [Cat("head", "Nominal")], equations: [Require("head.NounDistribution", "BareSingular"), Require("head.Number", "Singular"), Require("$.Case", "Plain"), Require("$.Determination", "Bare"), Require("$.Person", "Third")]),
        (name: "FusedPhrase", lhs: "NounPhrase", rhs: [Cat("head", "FusedNounPhrase")]),
        (name: "LocativePhrase", lhs: "LocativeNounPhrase", rhs: [Cat("head", "FusedNounPhrase")], equations: [Require("head.NounKind", "Locative")]),
        (name: "FusedLocative", lhs: "FusedNounPhrase", rhs: [Class("head", "LocativeQuantifier")], equations: [Require("$.NounKind", "Locative"), Require("$.Determination", "Bare"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        (name: "AttributiveNoun", lhs: "NounPremodifier", rhs: [FreeLex("head", Noun)], equations: [Require("head.Inflection", "Singular"), Exclude("head.NounDistribution", "HeadOnly")]),
        (name: "PrefixedNounPremodifier", lhs: "NounPremodifier", rhs: [Lex("prefix", Affix), Cat("head", "NounPremodifier")]),
        (name: "NominalPremodifier", lhs: "BareNominal", rhs: [Cat("modifier", "NounPremodifier"), Cat("head", "BareNominal")]),
        (name: "QuantifiedNominalPremodifier", lhs: "QuantifiedNominal", rhs: [Cat("modifier", "NounPremodifier"), Cat("head", "QuantifiedNominal")]),
        (name: "BarePrepositionalNominal", lhs: "BareNominalComplement", rhs: [Cat("head", "PrepositionalNominal")], equations: [Require("head.Number", "Singular"), Require("head.Countability", "Count"), Exclude("head.NounDistribution", "BareSingular")]),
        // Noun phrases.
        (name: "BareMass", lhs: "NounPhrase", rhs: [Cat("head", "Nominal")],
            equations: [Require("$.Determination", "Bare"), Require("$.Case", "Plain"), Require("head.Countability", "Mass"), Require("head.Number", "Singular"), Require("$.Person", "Third")]),
        (name: "SymbolNominalPhrase", lhs: "FusedNounPhrase", rhs: [Cat("head", "Symbols")], equations: [Require("$.NounKind", "Ordinary"), Require("$.Determination", "Bare"), Require("$.Case", "Plain"), Require("$.Number", "Singular"), Require("$.Person", "Third")]),
        (name: "ProperName", lhs: "NounPhrase", rhs: [Cat("head", "Name")],
            equations: [Require("$.NounKind", "Ordinary"), Require("$.Determination", "Bare"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        (name: "Determined", lhs: "NounPhrase", rhs: [Cat("determiner", "DeterminerPhrase"), Cat("head", "Nominal")],
            equations: [Require("$.Determination", "Overt"), Require("$.Case", "Plain"), Require("$.Person", "Third"), Exclude("determiner.DeterminativeDistribution", "Independent"), Agree("determiner.NounKind", "head.NounKind"), Agree("determiner.Countability", "head.Countability"), Agree("determiner.Number", "head.Number")]),
        (name: "BarePlural", lhs: "NounPhrase", rhs: [Cat("head", "Nominal")],
            equations: [Require("$.Determination", "Bare"), Require("$.Case", "Plain"), Require("head.Number", "Plural"), Require("$.Person", "Third")]),
        (name: "Pronoun", lhs: "NounPhrase", rhs: [Lex("head", Pronoun)],
            equations: [Require("$.NounKind", "Ordinary"), Require("$.Determination", "Bare"), Exclude("head.Case", "Genitive"), Exclude("head.PronounKind", "Existential"), Exclude("head.PronounKind", "Relative"), Require("head.Inflection", "Invariant")]),
        (name: "IndependentGenitive", lhs: "NounPhrase", rhs: [Lex("pronoun", Pronoun)],
            equations: [Require("$.NounKind", "Ordinary"), Require("$.Determination", "Bare"), Require("$.Case", "Plain"), Require("pronoun.Inflection", "IndependentGenitive"), Require("$.Person", "Third")]),
        (name: "PossessiveDeterminer", lhs: "DeterminerPhrase", rhs: [Lex("possessor", Pronoun)],
            equations: [Require("$.DeterminativeDistribution", "Dependent"), Require("possessor.Case", "Genitive"), Require("possessor.Inflection", "Invariant"), Exclude("possessor.PronounKind", "Relative")]),
        (name: "GenitivePossessor", lhs: "NounPhrase", rhs: [Cat("possessor", "Possessor"), Word("marker", "Genitive")],
            equations: [Require("$.Determination", "Bare"), Require("$.Case", "Genitive"), Exclude("possessor.Case", "Nominative"), Exclude("possessor.Case", "Accusative"), Exclude("possessor.Case", "Genitive"), Agree("$.Number", "possessor.Number"), Agree("$.Person", "possessor.Person")]),
        (name: "GenitiveDetermined", lhs: "NounPhrase", rhs: [Cat("determiner", "NounPhrase"), Cat("head", "Nominal")],
            equations: [Require("$.Determination", "Overt"), Require("$.Case", "Plain"), Require("determiner.Case", "Genitive"), Require("$.Person", "Third")]),
        // *its controller's next two untap steps*.
        (name: "GenitiveModifiedQuantity", lhs: "NounPhrase", rhs: [Cat("determiner", "NounPhrase"), Cat("head", "ModifiedQuantifiedNominal")],
            equations: [Require("determiner.Case", "Genitive"), Agree("$.Number", "head.QuantityNumber"), Require("$.Countability", "Count"), Require("$.Determination", "Overt"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        (name: "Unmodified", lhs: "Nominal", rhs: [Cat("head", "BareNominal")]),
        (name: "Premodifier", lhs: "BareNominal", rhs: [Cat("modifier", "AdjectivePhrase"), Cat("head", "BareNominal")], equations: [Exclude("modifier.Voice", "Passive"), Agree("modifier.Determination", "$.Determination"), Exclude("modifier.AdjectivePosition", "Predicative")]),
        (name: "DeterminedPossessor", lhs: "Possessor", rhs: [Cat("determiner", "DeterminerPhrase"), Cat("head", "BareNominal")],
            equations: [Require("$.Case", "Plain"), Require("$.Person", "Third"), Exclude("determiner.DeterminativeDistribution", "Independent"), Agree("determiner.NounKind", "head.NounKind"), Agree("determiner.Countability", "head.Countability"), Agree("determiner.Number", "head.Number")]),
        (name: "GenitiveDeterminedPossessor", lhs: "Possessor", rhs: [Cat("determiner", "NounPhrase"), Cat("head", "BareNominal")], equations: [Require("determiner.Case", "Genitive"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        (name: "PluralPossessor", lhs: "Possessor", rhs: [Cat("head", "BareNominal")],
            equations: [Require("$.Case", "Plain"), Require("head.Number", "Plural"), Require("$.Person", "Third")]),
        (name: "ProperPossessor", lhs: "Possessor", rhs: [Cat("head", "Name")], equations: [Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        (name: "NominalPostmodifier", lhs: "Nominal", rhs: [Cat("head", "Nominal"), Cat("modifier", "Postmodifier")],
            equations: [Agree("head.Number", "modifier.Number"), Agree("head.NounKind", "modifier.NounKind")]),
        // A Postmodifier follows a quantity's premodifiers (*the next 3 damage
        // that would be dealt*).
        (name: "QuantifiedPostmodifier", lhs: "ModifiedQuantifiedNominal", rhs: [Cat("head", "QuantifiedNominal"), Cat("modifier", "Postmodifier")],
            equations: [Agree("head.QuantityNumber", "modifier.Number"), Agree("head.NounKind", "modifier.NounKind")]),
        (name: "ModifiedQuantifiedPostmodifier", lhs: "ModifiedQuantifiedNominal", rhs: [Cat("head", "ModifiedQuantifiedNominal"), Cat("modifier", "Postmodifier")],
            equations: [Agree("head.QuantityNumber", "modifier.Number"), Agree("head.NounKind", "modifier.NounKind")]),
        // In Oracle English only a marked relative follows a fused head (*one
        // that hasn't been chosen*).
        (name: "FusedPostmodifier", lhs: "FusedNounPhrase", rhs: [Cat("head", "FusedNounPhrase"), Cat("modifier", "RelativeClause")],
            equations: [Require("modifier.ClauseMarking", "Relative"), Agree("head.Number", "modifier.Number"), Agree("head.NounKind", "modifier.NounKind")]),
        (name: "RelativePostmodifier", lhs: "Postmodifier", rhs: [Cat("head", "RelativeClause")]),
        // A participial clause with dependents (*each creature tapped this
        // way*, *a card exiled with ...*). A single postpositive participle
        // ranks behind it (CGEL, Ch. 5 §14.2, p. 445), and is never one whose
        // Adjectival Passive is a declared Adjective: bare *tapped* is that
        // Adjective.
        (name: "ParticipialPostmodifier", lhs: "Postmodifier", rhs: [Cat("head", "VerbPhrase")],
            equations: [Require("head.VerbForm", "PastParticiple"), Require("head.Voice", "Passive")], heavy: ["head"], cost: 1),
        (name: "SingleParticipialPostmodifier", lhs: "Postmodifier", rhs: [Cat("head", "VerbPhrase")],
            equations: [Require("head.VerbForm", "PastParticiple"), Require("head.Voice", "Passive"), Exclude("head.AdjectivalPassive", "Lexical")], light: ["head"], cost: 3),
        (name: "GerundParticipialPostmodifier", lhs: "Postmodifier", rhs: [Cat("head", "VerbPhrase")],
            equations: [Require("head.VerbForm", "GerundParticiple")], cost: 1),
        // Relative clauses (CGEL, Ch. 12 §3). A bare relative is a finite
        // clause with an object Gap; *that* or a relative pronoun may also
        // introduce a subject Gap, which agrees with the antecedent.
        (name: "BareRelative", lhs: "RelativeClause", rhs: [Cat("clause", "Clause")],
            equations: [Require("$.ClauseMarking", "Unmarked"), Require("clause.Gap", "NP"), Require("clause.VerbForm", "Finite")]),
        (name: "MarkedRelative", lhs: "RelativeClause", rhs: [Class("marker", "RelativeMarker"), Cat("clause", "Clause")],
            equations: [Require("$.ClauseMarking", "Relative"), Require("clause.Gap", "NP"), Require("clause.VerbForm", "Finite"), Exclude("marker.Case", "Nominative"), Exclude("marker.Case", "Genitive")]),
        (name: "SubjectRelative", lhs: "RelativeClause", rhs: [Class("marker", "RelativeMarker"), Cat("clause", "SubjectGapClause")],
            equations: [Require("$.ClauseMarking", "Relative"), Require("clause.Gap", "NP"), Agree("$.Number", "clause.Number"), Exclude("marker.Case", "Accusative"), Exclude("marker.Case", "Genitive")]),
        (name: "SubjectGap", lhs: "SubjectGapClause", rhs: [Cat("head", "VerbPhrase")],
            equations: [Require("head.VerbForm", "Finite"), Require("head.Person", "Third"), Exclude("head.Inflection", "Irrealis"), Require("$.Gap", "NP")]),
        (name: "FloatedEachSubjectGap", lhs: "SubjectGapClause", rhs: [Word("adjunct", "Each"), Cat("head", "VerbPhrase")],
            equations: [Require("head.VerbForm", "Finite"), Require("head.Number", "Plural"), Require("head.Person", "Third"), Require("$.Gap", "NP")]),
        // *whose*: the relative phrase is the Subject or fills an object Gap.
        (name: "GenitiveRelativePhrase", lhs: "RelativeNounPhrase", rhs: [Lex("determiner", Pronoun), Cat("head", "Nominal")],
            equations: [Require("determiner.PronounKind", "Relative"), Require("determiner.Case", "Genitive")]),
        (name: "GenitiveSubjectRelative", lhs: "RelativeClause", rhs: [Cat("marker", "RelativeNounPhrase"), Cat("clause", "SubjectGapClause")],
            equations: [Require("$.ClauseMarking", "Relative"), Require("clause.Gap", "NP"), Agree("marker.Number", "clause.Number")]),
        (name: "GenitiveRelative", lhs: "RelativeClause", rhs: [Cat("marker", "RelativeNounPhrase"), Cat("clause", "Clause")],
            equations: [Require("$.ClauseMarking", "Relative"), Require("clause.Gap", "NP"), Require("clause.VerbForm", "Finite")]),
        (name: "GenitivePredicativeRelative", lhs: "RelativeClause", rhs: [Cat("marker", "RelativeNounPhrase"), Cat("clause", "Clause")],
            equations: [Require("$.ClauseMarking", "Relative"), Require("clause.Gap", "Pred"), Require("clause.VerbForm", "Finite")]),
        // A relative phrase may be a Preposition Phrase fronted with its
        // relative pronoun (*for which*; CGEL, Ch. 12 §3.2.1, p. 1040).
        (name: "PrepositionRelativePhrase", lhs: "RelativePrepositionPhrase", rhs: [Lex("head", Preposition), Lex("complement", Pronoun)],
            equations: [Require("complement.PronounKind", "Relative"), Exclude("complement.Case", "Nominative"), Exclude("complement.Case", "Genitive")]),
        (name: "PrepositionalRelative", lhs: "RelativeClause", rhs: [Cat("marker", "RelativePrepositionPhrase"), Cat("clause", "AdjunctGapClause")],
            equations: [Require("$.ClauseMarking", "Relative"), Require("clause.Gap", "Adjunct")]),
        // A fused relative is a Noun Phrase (CGEL, Ch. 12 §6, p. 1068).
        (name: "FusedSubjectRelative", lhs: "NounPhrase", rhs: [Word("head", "Whichever"), Cat("clause", "SubjectGapClause")],
            equations: [Require("clause.Gap", "NP"), Require("$.NounKind", "Ordinary"), Require("$.Determination", "Bare"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        (name: "FusedRelative", lhs: "NounPhrase", rhs: [Word("head", "Whichever"), Cat("clause", "Clause")],
            equations: [Require("clause.Gap", "NP"), Require("clause.VerbForm", "Finite"), Require("$.NounKind", "Ordinary"), Require("$.Determination", "Bare"), Require("$.Case", "Plain"), Require("$.Person", "Third")]),
        // An adverbial relative: its Gap is a temporal Adjunct (*the next time
        // you cast a spell*; CGEL, Ch. 12 §3.3(e), p. 1045).
        (name: "AdverbialRelative", lhs: "RelativeClause", rhs: [Cat("clause", "AdjunctGapClause")],
            equations: [Require("$.ClauseMarking", "Unmarked"), Require("clause.Gap", "Adjunct"), Require("$.NounKind", "Temporal")]),
        (name: "AdjunctGap", lhs: "AdjunctGapClause", rhs: [Cat("head", "Clause")],
            equations: [Require("head.VerbForm", "Finite"), Require("head.ClauseMarking", "Unmarked"), Require("$.Gap", "Adjunct")]),
        // A marked relative clause postposed past a predicate adjunct, at the
        // end of the clause containing its Antecedent, the Object that fills
        // the head's Gap (*Choose a card at random that was exiled with ...*;
        // CGEL, Ch. 12 §4, p. 1066). It ranks behind the relative clause in
        // place.
        (name: "PostposedRelative", lhs: "VerbPhrase", rhs: [Cat("head", "VerbPhrase"), Cat("object", "ComplementNounPhrase"), Hosted("adjunct", "PrepositionPhrase", Predicate), Cat("modifier", "RelativeClause")],
            equations: [Require("head.Gap", "NP"), Require("modifier.ClauseMarking", "Relative"), Agree("object.Number", "modifier.Number")], cost: 5),

        (name: "NominalPredicative", lhs: "Predicative", rhs: [Cat("head", "NounPhrase")]),
        // A predicative Preposition Phrase could also modify a nominal.
        (name: "PrepositionalPredicative", lhs: "Predicative", rhs: [Hosted("head", "PrepositionPhrase", Nominal)]),
        (name: "AdjectivalPredicative", lhs: "Predicative", rhs: [Cat("head", "AdjectivePhrase")], equations: [Exclude("head.AdjectivePosition", "Attributive")]),

    ],
    schemas: [
        Premodification(head: Verb, modifier: "VerbPhrase", host: "BareNominal", forms: [GerundParticiple, PastParticiple], prefix: true),
        Parameters(head: Noun, phrase: "IndexedNominal"),
        Parameters(head: Keyword, phrase: "KeywordParameters", binding: Some(Free)),
        Parameters(head: Keyword, phrase: "BoundKeyword", binding: Some(Suffix)),
        Valence(head: Verb, phrase: "VerbPhrase", passive: Some("By"), adjectival: Some("AdjectivePhrase"), interleaved: Some("Interleaved"), heavy_shift: true),
        Valence(head: Preposition, phrase: "PrepositionPhrase"),
        Valence(head: Noun, phrase: "BareNominal"),
        Valence(head: Noun, phrase: "PrepositionalNominal"),
        Valence(head: Adjective, phrase: "AdjectivePhrase"),
        Valence(head: Determinative, phrase: "DeterminerPhrase"),
        // A complement costs nothing; a nominal postmodifier ranks before a
        // predicate adjunct.
        Adjunct(host: "QuantifiedNominal", adjunct: "PrepositionPhrase", side: After, host_kind: Nominal, cost: 1),
        Adjunct(host: "FusedNounPhrase", adjunct: "PrepositionPhrase", side: After, host_kind: Nominal, cost: 1),
        Adjunct(host: "KeywordPhrase", adjunct: "PrepositionPhrase", side: After, host_kind: Nominal, cost: 1),
        Adjunct(host: "Nominal", adjunct: "PrepositionPhrase", side: After, host_kind: Nominal, cost: 1),
        Adjunct(host: "VerbPhrase", adjunct: "PrepositionPhrase", side: After, host_kind: Predicate, cost: 2),
        Adjunct(host: "ExistentialPredicate", adjunct: "PrepositionPhrase", side: After, host_kind: Predicate, cost: 2),
        Adjunct(host: "VerbPhrase", adjunct: "PrepositionPhrase", side: After, host_kind: Predicate, delimiter: Some(','), cost: 2),
        Adjunct(host: "Clause", adjunct: "PrepositionPhrase", side: Before, host_kind: Predicate, delimiter: Some(','), cost: 2),
        // A preposed gerund-participial adjunct (*Starting with you, ...*).
        Adjunct(host: "Clause", adjunct: "Gerund", side: Before, host_kind: Predicate, delimiter: Some(','), cost: 2),
        // A depictive gerund-participial adjunct (*put it onto the battlefield attacking*).
        Adjunct(host: "VerbPhrase", adjunct: "Gerund", side: After, host_kind: Predicate, cost: 2),
        // A purpose *to*-infinitival, unless the head's frame selects one.
        Adjunct(host: "VerbPhrase", adjunct: "ToInf", side: After, host_kind: Predicate, cost: 2),
        Coordination(category: "VerbPhrase", coordinators: "Coordinator"),
    ],
)
