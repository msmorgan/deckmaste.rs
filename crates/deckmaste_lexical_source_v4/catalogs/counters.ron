    (kind: "fade", rule: "[CR#702.32a]"),
    (kind: "finality", rule: "[CR#122.1h]"),
    (kind: "first strike", rule: "[CR#122.1b]"),
    (kind: "flying", rule: "[CR#122.1b]"),
    (kind: "haste", rule: "[CR#122.1b]"),
    (kind: "hexproof", rule: "[CR#122.1b]"),
    (kind: "hone", rule: "[CR#122.1j]"),
    (kind: "indestructible", rule: "[CR#122.1b]"),
    (kind: "level", rule: "[CR#702.87a]"),
    (kind: "lifelink", rule: "[CR#122.1b]"),
    (kind: "lore", rule: "[CR#107.15a]"),
