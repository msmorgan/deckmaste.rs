// Counter kinds: every kind printed on Vintage-legal cards, plus every kind named by
// [CR#122.1a..122.1j]. `rule` is set where the CR names the kind. Each kind becomes the
// compound noun `<kind> counter`. The remaining kinds are named only by cards.
[
    // Power/toughness counters [CR#122.1a].
    (kind: "+0/+1", rule: "[CR#122.1a]"),
    (kind: "+0/+2", rule: "[CR#122.1a]"),
    (kind: "+1/+0", rule: "[CR#122.1a]"),
    (kind: "+1/+1", rule: "[CR#122.1a]"),
    (kind: "+1/+2", rule: "[CR#122.1a]"),
    (kind: "+2/+2", rule: "[CR#122.1a]"),
    (kind: "-0/-1", rule: "[CR#122.1a]"),
    (kind: "-0/-2", rule: "[CR#122.1a]"),
    (kind: "-1/-0", rule: "[CR#122.1a]"),
    (kind: "-1/-1", rule: "[CR#122.1a]"),
    (kind: "-2/-1", rule: "[CR#122.1a]"),
    (kind: "-2/-2", rule: "[CR#122.1a]"),

    // Kinds the CR names: keyword counters [CR#122.1b], [CR#122.1c..122.1j], and keyword rules.
    (kind: "age", rule: "[CR#702.24a]"),
    (kind: "charge", rule: "[CR#702.44a]"),
    (kind: "deathtouch", rule: "[CR#122.1b]"),
    (kind: "decayed", rule: "[CR#122.1b]"),
    (kind: "defense", rule: "[CR#122.1g]"),
    (kind: "double strike", rule: "[CR#122.1b]"),
