// Keyword abilities [CR#702.1], their parameters on a keyword line, the variants each rule
// defines, and the verbs each rule defines, in CR order.
//
// Left out: Hidden Agenda [CR#702.106] (Conspiracy cards only), Space Sculptor [CR#702.158] and
// Visit [CR#702.159] (Un-set cards only).
[
    (rule: "[CR#702.2]", name: "Deathtouch", lemma: "deathtouch"),
    (rule: "[CR#702.3]", name: "Defender", lemma: "defender"),
    (rule: "[CR#702.4]", name: "Double Strike", lemma: "double strike"),
    (rule: "[CR#702.5]", name: "Enchant", lemma: "enchant", parameters: [[Quality(None)]],
        determinatives: [(lemma: "enchanted")],
        verbs: [
            (lemma: "enchant", frames: [Monotransitive]),
        ],
    ),
    // "Equip legendary creature {1}", "Equip—Discard a card."
    (rule: "[CR#702.6]", name: "Equip", lemma: "equip", parameters: [[Cost], [Quality(None), Cost], [DashNonManaCost]],
        determinatives: [(lemma: "equipped")],
        verbs: [
            (lemma: "equip", past: "equipped", gerund: "equipping", frames: [Monotransitive]),
        ],
    ),
    (rule: "[CR#702.7]", name: "First Strike", lemma: "first strike"),
    (rule: "[CR#702.8]", name: "Flash", lemma: "flash"),
    (rule: "[CR#702.9]", name: "Flying", lemma: "flying"),
    (rule: "[CR#702.10]", name: "Haste", lemma: "haste"),
    // [CR#702.11d]
    (rule: "[CR#702.11]", name: "Hexproof", lemma: "hexproof", parameters: [[], [Quality(Some("from"))]]),
    (rule: "[CR#702.12]", name: "Indestructible", lemma: "indestructible"),
    (rule: "[CR#702.13]", name: "Intimidate", lemma: "intimidate"),
    // "islandwalk", and "land" in "nonbasic landwalk" [CR#702.14a,702.14c]
    (rule: "[CR#702.14]", name: "Landwalk", lemma: "landwalk", bound: (surface: "walk", stems: [LandType, CardType])),
    (rule: "[CR#702.15]", name: "Lifelink", lemma: "lifelink"),
    (rule: "[CR#702.16]", name: "Protection", lemma: "protection", parameters: [[Quality(Some("from"))]]),
    (rule: "[CR#702.17]", name: "Reach", lemma: "reach"),
    (rule: "[CR#702.18]", name: "Shroud", lemma: "shroud"),
    // "trample over planeswalkers" [CR#702.19c]
    (rule: "[CR#702.19]", name: "Trample", lemma: "trample", parameters: [[], [Quality(Some("over"))]]),
    (rule: "[CR#702.20]", name: "Vigilance", lemma: "vigilance"),
    (rule: "[CR#702.21]", name: "Ward", lemma: "ward", parameters: [[Cost], [DashNonManaCost]]),
    (rule: "[CR#702.22]", name: "Banding", lemma: "banding",
        variants: [
            // [CR#702.22b]
            (lemma: "bands with other", parameters: [[Quality(None)]]),
        ],
        verbs: [
            // *creatures banded with this creature*
            (lemma: "band", frames: [TransitiveWithPP(["with"])]),
        ],
    ),
    (rule: "[CR#702.23]", name: "Rampage", lemma: "rampage", parameters: [[Amount]]),
    // "doesn't pay this enchantment's cumulative upkeep"
    (rule: "[CR#702.24]", name: "Cumulative Upkeep", lemma: "cumulative upkeep", parameters: [[Cost], [DashNonManaCost]],
        nouns: [(lemma: "cumulative upkeep", countability: [Mass])]),
    (rule: "[CR#702.25]", name: "Flanking", lemma: "flanking"),
    (rule: "[CR#702.26]", name: "Phasing", lemma: "phasing"),
    (rule: "[CR#702.27]", name: "Buyback", lemma: "buyback", parameters: [[Cost], [DashNonManaCost]]),
    (rule: "[CR#702.28]", name: "Shadow", lemma: "shadow"),
    // Typecycling: "mountaincycling", "basic landcycling" [CR#702.29e]
    (rule: "[CR#702.29]", name: "Cycling", lemma: "cycling", parameters: [[Cost], [DashNonManaCost]], bound: (surface: "cycling", stems: [Subtype, CardType, Supertype]),
        verbs: [
            (lemma: "cycle", frames: [Monotransitive]),
        ],
    ),
    (rule: "[CR#702.30]", name: "Echo", lemma: "echo", parameters: [[Cost], [DashNonManaCost]]),
    (rule: "[CR#702.31]", name: "Horsemanship", lemma: "horsemanship"),
    (rule: "[CR#702.32]", name: "Fading", lemma: "fading", parameters: [[Amount]]),
    // "if it was kicked with its [A] kicker" [CR#702.33f]
    (rule: "[CR#702.33]", name: "Kicker", lemma: "kicker", parameters: [[Cost], [DashNonManaCost]],
        nouns: ["kicker"],
        variants: [
            // [CR#702.33c]
            (lemma: "multikicker", parameters: [[Cost]]),
        ],
        verbs: [
            (lemma: "kick", frames: [Monotransitive]),
        ],
    ),
    (rule: "[CR#702.34]", name: "Flashback", lemma: "flashback", parameters: [[Cost], [DashNonManaCost]]),
    (rule: "[CR#702.35]", name: "Madness", lemma: "madness", parameters: [[Cost], [DashNonManaCost]]),
    (rule: "[CR#702.36]", name: "Fear", lemma: "fear"),
    (rule: "[CR#702.37]", name: "Morph", lemma: "morph", parameters: [[Cost], [DashNonManaCost]],
        variants: [
            // [CR#702.37b]
            (lemma: "megamorph", parameters: [[Cost]]),
        ],
    ),
    (rule: "[CR#702.38]", name: "Amplify", lemma: "amplify", parameters: [[Amount]]),
    (rule: "[CR#702.39]", name: "Provoke", lemma: "provoke"),
    (rule: "[CR#702.40]", name: "Storm", lemma: "storm"),
    (rule: "[CR#702.41]", name: "Affinity", lemma: "affinity", parameters: [[Quality(Some("for"))]]),
    (rule: "[CR#702.42]", name: "Entwine", lemma: "entwine", parameters: [[Cost], [DashNonManaCost]]),
    // "Modular—Sunburst"
    (rule: "[CR#702.43]", name: "Modular", lemma: "modular", parameters: [[Amount], [DashKeyword]]),
    (rule: "[CR#702.44]", name: "Sunburst", lemma: "sunburst"),
    (rule: "[CR#702.45]", name: "Bushido", lemma: "bushido", parameters: [[Amount]]),
    (rule: "[CR#702.46]", name: "Soulshift", lemma: "soulshift", parameters: [[Amount]]),
    (rule: "[CR#702.47]", name: "Splice", lemma: "splice", parameters: [[Quality(Some("onto")), Cost], [Quality(Some("onto")), DashNonManaCost]],
        verbs: [
            (lemma: "splice", frames: [TransitiveWithPP(["onto"])]),
        ],
    ),
    // "Goblin offering"
    (rule: "[CR#702.48]", name: "Offering", lemma: "offering", parameters: [[QualityBefore]]),
    (rule: "[CR#702.49]", name: "Ninjutsu", lemma: "ninjutsu", parameters: [[Cost]],
        variants: [
            // [CR#702.49d]
            (lemma: "commander ninjutsu", parameters: [[Cost]]),
        ],
    ),
    (rule: "[CR#702.50]", name: "Epic", lemma: "epic"),
    (rule: "[CR#702.51]", name: "Convoke", lemma: "convoke",
        verbs: [
            (lemma: "convoke", frames: [Monotransitive]),
        ],
    ),
    (rule: "[CR#702.52]", name: "Dredge", lemma: "dredge", parameters: [[Amount]]),
    (rule: "[CR#702.53]", name: "Transmute", lemma: "transmute", parameters: [[Cost]]),
    (rule: "[CR#702.54]", name: "Bloodthirst", lemma: "bloodthirst", parameters: [[Amount]]),
    (rule: "[CR#702.55]", name: "Haunt", lemma: "haunt",
        verbs: [
            (lemma: "haunt", frames: [Monotransitive]),
        ],
    ),
    (rule: "[CR#702.56]", name: "Replicate", lemma: "replicate", parameters: [[Cost], [DashNonManaCost]]),
    // "Forecast — {1}{U}, Reveal this card from your hand: …"
    (rule: "[CR#702.57]", name: "Forecast", lemma: "forecast", parameters: [[DashAbility]]),
    (rule: "[CR#702.58]", name: "Graft", lemma: "graft", parameters: [[Amount]]),
    (rule: "[CR#702.59]", name: "Recover", lemma: "recover", parameters: [[Cost], [DashNonManaCost]]),
    (rule: "[CR#702.60]", name: "Ripple", lemma: "ripple", parameters: [[Amount]]),
    (rule: "[CR#702.61]", name: "Split Second", lemma: "split second"),
    // "Suspend 3—{0}"
    (rule: "[CR#702.62]", name: "Suspend", lemma: "suspend", parameters: [[Amount, DashCost]],
        verbs: [
            (lemma: "suspend", frames: [Monotransitive]),
        ],
    ),
    (rule: "[CR#702.63]", name: "Vanishing", lemma: "vanishing", parameters: [[], [Amount]]),
    (rule: "[CR#702.64]", name: "Absorb", lemma: "absorb", parameters: [[Amount]]),
    (rule: "[CR#702.65]", name: "Aura Swap", lemma: "Aura swap", parameters: [[Cost]]),
    (rule: "[CR#702.66]", name: "Delve", lemma: "delve"),
    (rule: "[CR#702.67]", name: "Fortify", lemma: "fortify", determinatives: [(lemma: "fortified")], parameters: [[Cost]],
        verbs: [
            (lemma: "fortify", frames: [Monotransitive]),
        ],
    ),
    (rule: "[CR#702.68]", name: "Frenzy", lemma: "frenzy", parameters: [[Amount]]),
    (rule: "[CR#702.69]", name: "Gravestorm", lemma: "gravestorm"),
    (rule: "[CR#702.70]", name: "Poisonous", lemma: "poisonous", parameters: [[Amount]]),
    (rule: "[CR#702.71]", name: "Transfigure", lemma: "transfigure", parameters: [[Cost]]),
    // "Champion a Faerie"
    (rule: "[CR#702.72]", name: "Champion", lemma: "champion", parameters: [[Quality(None)]],
        verbs: [
            (lemma: "champion", frames: [Monotransitive]),
        ],
    ),
    (rule: "[CR#702.73]", name: "Changeling", lemma: "changeling"),
    (rule: "[CR#702.74]", name: "Evoke", lemma: "evoke", parameters: [[Cost], [DashNonManaCost]]),
    (rule: "[CR#702.75]", name: "Hideaway", lemma: "hideaway", parameters: [[Amount]]),
    (rule: "[CR#702.76]", name: "Prowl", lemma: "prowl", parameters: [[Cost]]),
    // "Reinforce 1—{1}{R}"
    (rule: "[CR#702.77]", name: "Reinforce", lemma: "reinforce", parameters: [[Amount, DashCost]]),
    (rule: "[CR#702.78]", name: "Conspire", lemma: "conspire"),
    (rule: "[CR#702.79]", name: "Persist", lemma: "persist"),
    (rule: "[CR#702.80]", name: "Wither", lemma: "wither"),
    (rule: "[CR#702.81]", name: "Retrace", lemma: "retrace"),
    // "Devour artifact 1"
    (rule: "[CR#702.82]", name: "Devour", lemma: "devour", parameters: [[Amount], [Quality(None), Amount]],
        verbs: [
            (lemma: "devour", frames: [Monotransitive]),
        ],
    ),
    (rule: "[CR#702.83]", name: "Exalted", lemma: "exalted"),
    (rule: "[CR#702.84]", name: "Unearth", lemma: "unearth", parameters: [[Cost], [DashNonManaCost]]),
    // "as you cascade" [CR#702.85b]
    (rule: "[CR#702.85]", name: "Cascade", lemma: "cascade",
        verbs: [
            (lemma: "cascade", frames: [Intransitive]),
        ],
    ),
    (rule: "[CR#702.86]", name: "Annihilator", lemma: "annihilator", parameters: [[Amount]]),
    (rule: "[CR#702.87]", name: "Level Up", lemma: "level up", parameters: [[Cost]]),
    (rule: "[CR#702.88]", name: "Rebound", lemma: "rebound"),
    (rule: "[CR#702.89]", name: "Umbra Armor", lemma: "umbra armor"),
    (rule: "[CR#702.90]", name: "Infect", lemma: "infect"),
    (rule: "[CR#702.91]", name: "Battle Cry", lemma: "battle cry"),
    (rule: "[CR#702.92]", name: "Living Weapon", lemma: "living weapon"),
    (rule: "[CR#702.93]", name: "Undying", lemma: "undying"),
    (rule: "[CR#702.94]", name: "Miracle", lemma: "miracle", parameters: [[Cost]]),
    (rule: "[CR#702.95]", name: "Soulbond", lemma: "soulbond"),
    (rule: "[CR#702.96]", name: "Overload", lemma: "overload", parameters: [[Cost]]),
    (rule: "[CR#702.97]", name: "Scavenge", lemma: "scavenge", parameters: [[Cost]]),
    (rule: "[CR#702.98]", name: "Unleash", lemma: "unleash"),
    (rule: "[CR#702.99]", name: "Cipher", lemma: "cipher"),
    (rule: "[CR#702.100]", name: "Evolve", lemma: "evolve",
        verbs: [
            (lemma: "evolve", frames: [Intransitive]),
        ],
    ),
    (rule: "[CR#702.101]", name: "Extort", lemma: "extort"),
    (rule: "[CR#702.102]", name: "Fuse", lemma: "fuse"),
    (rule: "[CR#702.103]", name: "Bestow", lemma: "bestow", parameters: [[Cost], [DashNonManaCost]]),
    // "if tribute wasn't paid" [CR#702.104b]
    (rule: "[CR#702.104]", name: "Tribute", lemma: "tribute", parameters: [[Amount]],
        nouns: [(lemma: "tribute", countability: [Mass])]),
    (rule: "[CR#702.105]", name: "Dethrone", lemma: "dethrone"),
    (rule: "[CR#702.107]", name: "Outlast", lemma: "outlast", parameters: [[Cost]]),
    (rule: "[CR#702.108]", name: "Prowess", lemma: "prowess"),
    (rule: "[CR#702.109]", name: "Dash", lemma: "dash", parameters: [[Cost]]),
    (rule: "[CR#702.110]", name: "Exploit", lemma: "exploit",
        verbs: [
            (lemma: "exploit", frames: [Monotransitive]),
        ],
    ),
    (rule: "[CR#702.111]", name: "Menace", lemma: "menace"),
    (rule: "[CR#702.112]", name: "Renown", lemma: "renown", parameters: [[Amount]]),
    // "Awaken 4—{4}{W}"
    (rule: "[CR#702.113]", name: "Awaken", lemma: "awaken", parameters: [[Amount, DashCost]]),
    (rule: "[CR#702.114]", name: "Devoid", lemma: "devoid"),
    (rule: "[CR#702.115]", name: "Ingest", lemma: "ingest"),
    (rule: "[CR#702.116]", name: "Myriad", lemma: "myriad"),
    (rule: "[CR#702.117]", name: "Surge", lemma: "surge", parameters: [[Cost]]),
    (rule: "[CR#702.118]", name: "Skulk", lemma: "skulk"),
    // "Emerge from artifact {5}{B}{B}"
    (rule: "[CR#702.119]", name: "Emerge", lemma: "emerge", parameters: [[Cost], [Quality(Some("from")), Cost]]),
    (rule: "[CR#702.120]", name: "Escalate", lemma: "escalate", parameters: [[Cost], [DashNonManaCost]]),
    (rule: "[CR#702.121]", name: "Melee", lemma: "melee"),
    (rule: "[CR#702.122]", name: "Crew", lemma: "crew", parameters: [[Amount]],
        verbs: [
            (lemma: "crew", frames: [Monotransitive]),
        ],
    ),
    (rule: "[CR#702.123]", name: "Fabricate", lemma: "fabricate", parameters: [[Amount]]),
    // "Partner with Trynn, Champion of Freedom"
    (rule: "[CR#702.124]", name: "Partner", lemma: "partner", parameters: [[], [Name(Some("with"))]],
        variants: [
            // [CR#702.124i]
            (lemma: "partner—Character select"),
            (lemma: "partner—Father & son"),
            (lemma: "partner—Friends forever"),
            (lemma: "partner—Survivors"),
            // [CR#702.124k,702.124m]
            (lemma: "choose a Background"),
            (lemma: "doctor's companion"),
        ],
    ),
    (rule: "[CR#702.125]", name: "Undaunted", lemma: "undaunted"),
    (rule: "[CR#702.126]", name: "Improvise", lemma: "improvise"),
    (rule: "[CR#702.127]", name: "Aftermath", lemma: "aftermath"),
    (rule: "[CR#702.128]", name: "Embalm", lemma: "embalm", parameters: [[Cost]],
        verbs: [
            (lemma: "embalm", frames: [Monotransitive]),
        ],
    ),
    (rule: "[CR#702.129]", name: "Eternalize", lemma: "eternalize", parameters: [[Cost], [DashNonManaCost]]),
    (rule: "[CR#702.130]", name: "Afflict", lemma: "afflict", parameters: [[Amount]]),
    (rule: "[CR#702.131]", name: "Ascend", lemma: "ascend"),
    (rule: "[CR#702.132]", name: "Assist", lemma: "assist"),
    (rule: "[CR#702.133]", name: "Jump-Start", lemma: "jump-start"),
    (rule: "[CR#702.134]", name: "Mentor", lemma: "mentor",
        verbs: [
            (lemma: "mentor", frames: [Monotransitive]),
        ],
    ),
    (rule: "[CR#702.135]", name: "Afterlife", lemma: "afterlife", parameters: [[Amount]]),
    (rule: "[CR#702.136]", name: "Riot", lemma: "riot"),
    (rule: "[CR#702.137]", name: "Spectacle", lemma: "spectacle", parameters: [[Cost]]),
    (rule: "[CR#702.138]", name: "Escape", lemma: "escape", parameters: [[DashNonManaCost]],
        verbs: [
            (lemma: "escape", frames: [Intransitive]),
        ],
    ),
    (rule: "[CR#702.139]", name: "Companion", lemma: "companion", parameters: [[DashCondition]]),
    (rule: "[CR#702.140]", name: "Mutate", lemma: "mutate", parameters: [[Cost]],
        verbs: [
            (lemma: "mutate", frames: [Intransitive]),
        ],
    ),
    (rule: "[CR#702.141]", name: "Encore", lemma: "encore", parameters: [[Cost]]),
    (rule: "[CR#702.142]", name: "Boast", lemma: "boast", parameters: [[DashAbility]]),
    (rule: "[CR#702.143]", name: "Foretell", lemma: "foretell", parameters: [[Cost]],
        verbs: [
            (lemma: "foretell", past: "foretold", frames: [Monotransitive]),
        ],
    ),
    (rule: "[CR#702.144]", name: "Demonstrate", lemma: "demonstrate"),
    (rule: "[CR#702.145]", name: "Daybound and Nightbound", lemma: "daybound",
