    (rule: "[CR#702.160]", name: "Prototype", lemma: "prototype", parameters: [[Cost, DashPowerToughness]]),
    (rule: "[CR#702.161]", name: "Living Metal", lemma: "living metal"),
    // Oracle prints it in title case.
    (rule: "[CR#702.162]", name: "More Than Meets the Eye", lemma: "More Than Meets the Eye", parameters: [[Cost]]),
