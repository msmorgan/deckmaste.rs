// Core common nouns. Catalog items (card types, subtypes, counter kinds,
// designations, phases and steps, tokens, keywords) live in catalogs/.
// A `PP(["of"])` frame marks an of-phrase that expresses a semantic argument of
// a relational noun (CGEL, Ch. 5, §14.1, pp. 439–441); an of-phrase that only
// describes ("a creature of your choice") is a modifier and gets no frame.
[
    (lemma: "bidding", countability: [Mass]),
    // Game nouns.
    (lemma: "ability", frames: [Complement(PP(["of"]))]),
    "activation",
    (lemma: "amount", distribution: HeadOnly, frames: [Complement(PP(["of"]))]),
    "attacker",
    // Pre-head dependent in "base power and toughness"; a noun, so that it
    // scopes over the coordination.
    "base",
    "battlefield",
    (lemma: "beginning", frames: [Complement(PP(["of"]))]),
    (lemma: "bid", frames: [Complement(PP(["of"]))]),
    "bidder",
    "blocker",
    "booster",
    "box",
    // *on the bottom of*; prenominal *bottom* is the adjective.
    (lemma: "bottom", distribution: HeadOnly, frames: [Complement(PP(["of"]))]),
    "card",
    "chapter",
    "characteristic",
    (lemma: "choice", frames: [Complement(PP(["of"]))]),
    "coin",
    "color",
    // "until end of combat" (mass); "attacks each combat" (count).
    // *each combat*
    (lemma: "combat", kind: Temporal, countability: [Count, Mass]),
    (lemma: "combination", frames: [Complement(PP(["of"]))]),
    (lemma: "control", countability: [Mass], frames: [Complement(PP(["of"]))]),
    (lemma: "controller", frames: [Complement(PP(["of"]))]),
    (lemma: "copy", frames: [Complement(PP(["of"]))]),
    // "an additional cost to cast this spell"; "the mana cost for Rune spells".
    (lemma: "cost", frames: [Complement(PP(["for", "of"])), Complement(ToInf)]),
    // A counter on an object; Oracle never uses it attributively (*Counter
    // target spell* is the verb), unlike a counter kind (*+1/+1 counter*).
    (lemma: "counter", distribution: HeadOnly),
    "crime",
    (lemma: "d4", plural: "d4"),
    (lemma: "d6", plural: "d6"),
    (lemma: "d8", plural: "d8"),
    (lemma: "d10", plural: "d10"),
    (lemma: "d12", plural: "d12"),
    (lemma: "d20", plural: "d20"),
    (lemma: "damage", distribution: DirectMeasure, countability: [Mass]),
    "deck",
    (lemma: "devotion", countability: [Mass], frames: [Complement(PP(["to"]))]),
    (lemma: "die", plural: "dice"),
    (lemma: "difference", frames: [Complement(PP(["between"]))]),
    "direction",
    (lemma: "door", frames: [Complement(PP(["of"]))]),
    "draft",
    // "the game is a draw".
    (lemma: "draw", distribution: HeadOnly),
    "effect",
    "emblem",
    (lemma: "end", frames: [Complement(PP(["of"]))]),
    // "in excess of the number you control"; prenominal *excess* is the adjective.
    // The amount over a limit is a count noun (*the excess*). It is bare only as
    // the noun of the fossilised *in excess of* (CGEL, Ch. 7 §3.1, p. 618; §5.3,
    // p. 646), a bare count nominal after *in*; it is never a bare Noun Phrase
    // (Ch. 2 §5, p. 57), so it cannot head one across *excess damage*.
    (lemma: "excess", distribution: HeadOnly, frames: [Complement(PP(["of"]))]),
    "exchange",
    // The zone; the verb is a keyword action [CR#701.13].
    (lemma: "exile", countability: [Mass]),
    "expansion",
    "face",
    "flip",
    "foe",
    "friend",
    (lemma: "game", kind: Temporal),
    "graveyard",
    (lemma: "half", plural: "halves", frames: [Complement(PP(["of"]))]),
    "hand",
    // The faces of a coin (*comes up heads*).
    (lemma: "heads", countability: [Mass]),
    (lemma: "tails", countability: [Mass]),
    (lemma: "instance", frames: [Complement(PP(["of"]))]),
    "item",
    (lemma: "kind", frames: [Complement(PP(["of"]))]),
    "label",
    "left",
    "legend",
    "library",
    (lemma: "life", distribution: DirectMeasure, countability: [Mass]),
    (lemma: "loyalty", distribution: DirectMeasure, countability: [Mass]),
    (lemma: "mana", distribution: DirectMeasure, countability: [Mass]),
    // *to a maximum of 10*; the attributive *maximum* is the adjective's.
    (lemma: "maximum", distribution: HeadOnly, frames: [Complement(PP(["of"]))]),
    "mode",
    "name",
    (lemma: "number", distribution: Quantity, frames: [Complement(PP(["of"]))]),
    "offer",
    "opponent",
    (lemma: "order", countability: [Count, Mass]),
    "outlaw",
    (lemma: "owner", frames: [Complement(PP(["of"]))]),
    "pack",
    (lemma: "pair", frames: [Complement(PP(["of"]))]),
    (lemma: "part", frames: [Complement(PP(["of"]))]),
    "party",
    "permanent",
    (lemma: "phase", kind: Temporal),
    "pile",
    // *the player to your right*
    (lemma: "player", frames: [Complement(PP(["to"]))]),
    // "each point of bushido it has".
    (lemma: "point", frames: [Complement(PP(["of"]))]),
    "pool",
    // A bare *power* or *toughness* is never a Noun Phrase by itself (*[its
    // power] and [toughness]*), only with a value (*power 3 or less*) or a
    // postmodifier (*power equal to …*).
    (lemma: "power", countability: [Count, Mass], frames: [Complement(PP(["of"])), Complement(Amount)]),
    "process",
    "quality",
    (lemma: "radiation", countability: [Mass]),
    // Quantificational "the rest (of …)" has no plural.
    (lemma: "rest", countability: [Mass], frames: [Complement(PP(["of"]))]),
    (lemma: "result", frames: [Complement(PP(["of"]))]),
    "right",
    "round",
    "rule",
    "size",
    "source",
    "speed",
    "spell",
    "stack",
    "stake",
    (lemma: "step", kind: Temporal),
    "symbol",
    // Not the Targeting Marker of "target creature", which has a Determinative Lexeme.
    (lemma: "target", distribution: HeadOnly),
    "team",
    "teammate",
    (lemma: "text", countability: [Mass], frames: [Complement(PP(["of"]))]),
    "tie",
    (lemma: "time", kind: Temporal, distribution: Serial, countability: [Count, Mass]),
    "token",
    // *on top of*; prenominal *top* is the adjective. Bare after a
    // preposition it may omit *of X*, as *in front* does (*put that card on
    // top*; CGEL, Ch. 7 §3.1, p. 620), unlike *end* or *excess*.
    (lemma: "top", distribution: HeadOnly, frames: [Complement(PP(["of"])), Intransitive]),
    (lemma: "toughness", countability: [Count, Mass], frames: [Complement(PP(["of"])), Complement(Amount)]),
    (lemma: "turn", kind: Temporal),
    "type",
    // "for the same value", "double the value of X".
    (lemma: "value", frames: [Complement(PP(["of"]))]),
    // *the total of those results*; the attributive word is the adjective.
    (lemma: "total", distribution: HeadOnly, frames: [Complement(PP(["of"]))]),
    "vote",
    "voter",
    (lemma: "way", kind: Manner),
    "word",
    "zone",

    // The five colors as nouns: "devotion to blue", "a color other than white".
    // Prenominal *green* is the adjective.
    (lemma: "black", countability: [Mass], distribution: HeadOnly),
    (lemma: "blue", countability: [Mass], distribution: HeadOnly),
    (lemma: "green", countability: [Mass], distribution: HeadOnly),
    (lemma: "red", countability: [Mass], distribution: HeadOnly),
    (lemma: "white", countability: [Mass], distribution: HeadOnly),

    // Multiword rules terms, each one Lexeme.
    (lemma: "color identity", frames: [Complement(PP(["of"]))]),
    (lemma: "combat damage", distribution: DirectMeasure, countability: [Mass]),
    // A zone name [CR#408.1]; `command` occurs in no other sense.
    "command zone",
    // [CR#506.2]; no verb `defend` stands behind `defending`.
    (lemma: "defending player", distribution: BareSingular),
    // [CR#506.2]
    (lemma: "attacking player", distribution: BareSingular),
    "life total",
    (lemma: "mana cost", frames: [Complement(PP(["for", "of"]))]),
    (lemma: "mana value", countability: [Count, Mass], frames: [Complement(Amount)]),
    // [CR#103.6]; `opening` occurs in no other sense.
    "opening hand",
    // The mana cost of a locked half, paid to unlock it [CR#709.5e].
    "unlock cost",

    // Ordinary nouns that cards name as vote or choice options.
    (lemma: "aid", countability: [Mass]),
    (lemma: "bribery", countability: [Mass]),
    (lemma: "carnage", countability: [Mass]),
    (lemma: "chaos", countability: [Mass]),
    (lemma: "condemnation", countability: [Mass]),
    "consequence",
    (lemma: "death", countability: [Count, Mass]),
    (lemma: "denial", countability: [Mass]),
    (lemma: "dominion", countability: [Mass]),
    (lemma: "duplication", countability: [Mass]),
    (lemma: "evidence", countability: [Mass]),
    (lemma: "fame", countability: [Mass]),
    "feather",
    (lemma: "fellowship", countability: [Mass]),
    (lemma: "fortune", countability: [Count, Mass]),
    (lemma: "grace", countability: [Mass]),
    (lemma: "guidance", countability: [Mass]),
    "harvest",
    (lemma: "homage", countability: [Mass]),
    (lemma: "knowledge", countability: [Mass]),
    (lemma: "money", countability: [Mass]),
    "past",
    (lemma: "peace", countability: [Mass]),
    "present",
    (lemma: "profit", countability: [Count, Mass]),
    (lemma: "psychosis", plural: "psychoses"),
    "quill",
    "return",
    "secret",
    (lemma: "security", countability: [Mass]),
    (lemma: "sickness", countability: [Mass]),
    (lemma: "silence", countability: [Mass]),
    "snitch",
    "sprout",
    (lemma: "strength", countability: [Mass]),
    "tax",
    (lemma: "torture", countability: [Mass]),
    (lemma: "truth", countability: [Mass]),
    (lemma: "war", countability: [Count, Mass]),
    // A measure noun: *five {P} worth of modes* (CGEL Ch. 5, p. 470).
    (lemma: "worth", distribution: DirectMeasure, countability: [Mass], frames: [Complement(PP(["of"]))]),
]
