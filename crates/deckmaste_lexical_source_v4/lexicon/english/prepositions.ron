// Prepositions with their complement frames and, per frame, the Host
// Categories an unselected phrase may modify in Oracle English.
//
// CGEL's prepositions include the traditional "subordinating conjunctions"
// that head clauses (if, unless, when, ...; Ch. 11 §8.1, pp. 1011-1012) and
// the intransitive ones (back, there, phase *out*; Ch. 7 §2.4, pp. 612-615).
// *Out of*, *instead of*, *up to* and *from among* are a preposition with a PP
// complement, not complex prepositions (pp. 616, 624-625).
//
// A Nominal complement is a bare singular count nominal: *until end of turn*,
// *on top of*. A Pred complement is CGEL's preposition + adjective idiom:
// *at random*, *in common* (p. 626).
//
// A FiniteClause complement is a finite Clause of either tense. Oracle states
// a repeated trigger event, a state or an endpoint in the simple present
// (*whenever you cast a spell*; oracle-style-guide §1, "Voice and tense"), and
// a condition on past events in the preterite (*if an opponent cast a spell
// this turn*, *the life you lost when it entered*). A preterite Complement of
// *whenever* is well-formed English too, so the syncretic *cast* there has a
// preterite Reading beside the present one, and semantics chooses
// (docs/decisions/english-v4.md §4.4, principle 1).
[
    // *a creature card directly above it*
    (lemma: "above", frames: [(complement: NP, hosts: Nominal)]),
    // *an additional combat phase after this phase*; *After this main phase, ...*
    (lemma: "after", frames: [
        (complement: NP, hosts: NominalAndPredicate),
        (complement: FiniteClause, hosts: Predicate),
    ]),
    // *the greatest power among creatures you control*
    // *from among flying, first strike, and lifelink*
    (lemma: "among", frames: [(complement: NP, hosts: Nominal), (complement: KeywordPhrase, hosts: Nominal)]),
    // *Activate only as a sorcery*; *as it enters*; *as part of casting a spell*
    (lemma: "as", frames: [
        (complement: NP, hosts: Predicate, relation: PredicativeComplement),
        (complement: FiniteClause, hosts: Predicate),
        (complement: Nominal, hosts: Predicate),
    ]),
    // Prepositional idiom licensing a content clause (CGEL p. 971).
    (lemma: "as long as", frames: [(complement: FiniteClause, hosts: Predicate)]),
    // Compound preposition (CGEL pp. 1151-1152): *as though it had flash*.
    (lemma: "as though", frames: [(complement: FiniteClause, hosts: Predicate)]),
    // *at the beginning of*; *at end of combat*; *discard a card at random*
    (lemma: "at", frames: [
        (complement: Amount, hosts: Predicate),
        (complement: NP, hosts: Predicate),
        (complement: Nominal, hosts: Predicate),
        (complement: AdjP, hosts: Predicate),
    ]),
    // *put them back*; *put it back on top of your library*
    (lemma: "back", frames: [
        (complement: Intransitive, hosts: ComplementOnly),
        (complement: PP(["on"]), hosts: ComplementOnly),
    ]),
    // *Cast this spell only before attackers are declared*; Nominal:
    // *the player's life total before the damage was dealt* (Soul Burn).
    (lemma: "before", frames: [
        (complement: NP, hosts: Predicate),
        (complement: FiniteClause, hosts: NominalAndPredicate),
    ]),
    // *the colors below* (Cryptic Spires); *reduce their speed below 1*
    (lemma: "below", frames: [
        (complement: Amount, hosts: ComplementOnly),
        (complement: NP, hosts: ComplementOnly),
        (complement: Intransitive, hosts: Nominal),
    ]),
    // *into its owner's library just beneath the top X cards*
    (lemma: "beneath", frames: [(complement: NP, hosts: Predicate)]),
    // *choose a number between 0 and 5*
    (lemma: "between", frames: [(complement: NP, hosts: Nominal), (complement: Amount, hosts: Nominal)]),
    // *for each target beyond the first*
    (lemma: "beyond", frames: [(complement: NP, hosts: Nominal)]),
    // Exception: *all but the bottom card of each opponent's library*.
    (lemma: "but", frames: [(complement: NP, hosts: Nominal), (complement: Amount, hosts: Nominal)]),
    // The passive agent is the grammar's; *reduce that opponent's speed by 1*.
    (lemma: "by", frames: [
        (complement: Amount, hosts: ComplementOnly),
        (complement: NP, hosts: ComplementOnly),
        (complement: Gerund, hosts: Predicate),
    ]),
    // *rounded down*; *exile it face down*
    (lemma: "down", frames: [(complement: Intransitive, hosts: ComplementOnly)]),
    // *during that combat phase*
    (lemma: "during", frames: [(complement: NP, hosts: Predicate)]),
    // Postmodifies compound determinatives (CGEL p. 615 n. 5): *anywhere else*.
    (lemma: "else", frames: [(complement: Intransitive, hosts: Nominal)]),
    // *all abilities except mana abilities*; *except it's a 4/4 black Zombie*;
    // *can't be blocked except by Spirits*; *except for basic lands*
    (lemma: "except", frames: [
        (complement: NP, hosts: Nominal),
        (complement: FiniteClause, hosts: Predicate),
        (complement: PP(["by", "during", "for"]), hosts: NominalAndPredicate),
    ]),
    // *don't lose the game for having 0 or less life*; *Do the same for
    // flying, first strike, ...*; *for as long as you control this creature*
    (lemma: "for", frames: [
        (complement: NP, hosts: Predicate),
        (complement: Gerund, hosts: Predicate),
        (complement: KeywordPhrase, hosts: Predicate),
        (complement: PP(["as long as"]), hosts: Predicate),
        // Selected only: *tied for most common*.
        (complement: AdjP, hosts: ComplementOnly),
    ]),
    // *cast spells ... from the top of your library*; *a card you own from
    // outside the game*; *from among them*
    (lemma: "from", frames: [
        (complement: NP, hosts: NominalAndPredicate),
        (complement: PP(["among", "outside"]), hosts: NominalAndPredicate),
    ]),
    // *If you do, ...*; *attacks each combat if able*
    (lemma: "if", frames: [
        (complement: FiniteClause, hosts: Predicate),
        (complement: VerblessClause, hosts: Predicate),
    ]),
    // *cards in your graveyard*; *Put the rest ... in a random order*;
    // *cards in hand*; *have a creature type in common*; *phases in*
    (lemma: "in", frames: [
        (complement: NP, hosts: NominalAndPredicate),
        (complement: Nominal, hosts: NominalAndPredicate),
        (complement: AdjP, hosts: Predicate),
        (complement: Intransitive, hosts: ComplementOnly),
    ]),
    // *In addition* licenses the *to* phrase as a unit, CGEL's layered head
    // (Ch. 7 §3.1, pp. 622-623): *addition* never takes a *to* complement
    // elsewhere in Oracle text, and a layered head is a compound preposition
    // like *instead*, only composite. Oracle uses it only to keep types or
    // costs, so it modifies a predicate, never a nominal: *is a Ninja in
    // addition to its other types*; *by paying 3 life in addition to paying
    // their other costs* (oracle-style-guide §7, "Type changes and
    // retention"; §12, "Colors and types").
    (lemma: "in addition", frames: [
        (complement: PP(["to"]), hosts: Predicate),
        (complement: Intransitive, hosts: Predicate),
    ]),
    // *cards you've drafted this draft round, including this card*
    // Oracle sets it off by a comma: a Supplement (*note how many cards
    // you've drafted this draft round, including this card*; CGEL, Ch. 15
    // §2.9, p. 1318).
    (lemma: "including", frames: [(complement: NP, hosts: Supplement)]),
    // Compound preposition (CGEL p. 622): *exile it instead*;
    // *instead of putting it into your graveyard*.
    (lemma: "instead", frames: [
        (complement: Intransitive, hosts: Predicate),
        (complement: PP(["of"]), hosts: Predicate),
    ]),
    (lemma: "into", frames: [(complement: NP, hosts: ComplementOnly)]),
    // *5 minus X damage*
    (lemma: "minus", frames: [(complement: Amount, hosts: ComplementOnly), (complement: NP, hosts: ComplementOnly)]),
    // Temporal intransitive preposition (CGEL p. 615): *Those creatures are now
    // attacking that player.*
    (lemma: "now", frames: [(complement: Intransitive, hosts: Predicate)]),
    // *a creature of the chosen type*; *end of turn*; *instead of putting*;
    // *your choice of flying, first strike, or trample*
    (lemma: "of", frames: [
        (complement: NP, hosts: Nominal),
        // *the value of X*
        (complement: Amount, hosts: ComplementOnly),
        (complement: Nominal, hosts: ComplementOnly),
        (complement: Gerund, hosts: ComplementOnly),
        (complement: KeywordPhrase, hosts: ComplementOnly),
        // *your choice of 5/1 or 1/5*
        (complement: MeasureNP, hosts: ComplementOnly),
    ]),
    // *put it on top of its owner's library*; a locative *on*-phrase is a
    // Nominal postmodifier or a Predicate Adjunct (*second from the top or on
    // the bottom*).
    (lemma: "on", frames: [
        (complement: Amount, hosts: Nominal),
        (complement: NP, hosts: NominalAndPredicate),
        (complement: Nominal, hosts: ComplementOnly),
    ]),
    (lemma: "onto", frames: [(complement: NP, hosts: ComplementOnly)]),
    // *phase out*
    (lemma: "out", frames: [(complement: Intransitive, hosts: ComplementOnly)]),
    // *cards you own outside the game*
    (lemma: "outside", frames: [(complement: NP, hosts: NominalAndPredicate)]),
    // *trample over planeswalkers*
    (lemma: "over", frames: [(complement: NP, hosts: ComplementOnly)]),
    // *the number of Elves you control plus the number of Elf cards*
    // *the card's mana cost plus exile three other cards from your graveyard*
    (lemma: "plus", frames: [(complement: Amount, hosts: ComplementOnly), (complement: NP, hosts: ComplementOnly), (complement: BareInf, hosts: ComplementOnly)]),
    // Not coordinative, since it can be fronted (CGEL p. 1317): *If you control
    // a Forest, rather than pay this spell's mana cost, you may ...*;
    // *its toughness rather than its power*; *by paying {X} rather than paying*.
    (lemma: "rather than", frames: [
        // *Rather than the attacking player, you assign ...*
        (complement: NP, hosts: NominalAndPredicate),
        (complement: BareInf, hosts: Predicate),
        (complement: Gerund, hosts: Predicate),
        // *twice each turn rather than only once*
        (complement: AdvP, hosts: Predicate),
    ]),
    // *controlled continuously since the beginning of the turn*
    (lemma: "since", frames: [(complement: NP, hosts: Predicate)]),
    // Selected by comparatives: *greater than 2*; *more lands than you*;
    // *more than twice*.
    (lemma: "than", frames: [
        (complement: Amount, hosts: ComplementOnly),
        (complement: NP, hosts: ComplementOnly),
        (complement: AdvP, hosts: ComplementOnly),
        // A comparative clause: *more creatures than you do* (CGEL Ch. 13
        // §2.1, p. 1108).
        (complement: FiniteClause, hosts: ComplementOnly),
    ]),
    // *was put there from anywhere*
    (lemma: "there", frames: [(complement: Intransitive, hosts: ComplementOnly)]),
    // Selected goals only; *the player to your right* is `player`'s.
    (lemma: "to", frames: [
        (complement: Amount, hosts: ComplementOnly),
        // *, to a maximum of 10*
        (complement: NP, hosts: Supplement),
        (complement: Gerund, hosts: ComplementOnly),
    ]),
    // *enters under an opponent's control*; *a noncreature permanent under
    // your control* (Cobra Trap)
    (lemma: "under", frames: [(complement: NP, hosts: NominalAndPredicate)]),
    (lemma: "unless", frames: [(complement: FiniteClause, hosts: Predicate)]),
    // *until your next turn*; *until end of turn*; *until you reveal a land card*
    (lemma: "until", frames: [
        (complement: NP, hosts: Predicate),
        (complement: Nominal, hosts: Predicate),
        (complement: FiniteClause, hosts: Predicate),
    ]),
    // *rounded up*; *up to two target creatures* is a determiner-function PP
    // (CGEL p. 357), not a modifier.
    (lemma: "up", frames: [
        (complement: Intransitive, hosts: ComplementOnly),
        (complement: PP(["to"]), hosts: ComplementOnly),
    ]),
    (lemma: "when", frames: [(complement: FiniteClause, hosts: Predicate)]),
    (lemma: "whenever", frames: [(complement: FiniteClause, hosts: Predicate)]),
    // *, where X is the number of ...* (CGEL p. 971)
    (lemma: "where", frames: [(complement: FiniteClause, hosts: Supplement)]),
    // *while you control*; *attacks while saddled*; *while scrying*
    (lemma: "while", frames: [
        (complement: FiniteClause, hosts: Predicate),
        (complement: VerblessClause, hosts: Predicate),
        (complement: Gerund, hosts: Predicate),
    ]),
    (lemma: "with", frames: [
        (complement: KeywordPhrase, hosts: Nominal),
        (complement: NP, hosts: NominalAndPredicate),
        (complement: QuotedAbility, hosts: Nominal),
    ]),
    // *each creature without a +1/+1 counter on it*; *creatures without
    // flying*; *cast it without paying its mana cost*
    (lemma: "without", frames: [
        (complement: NP, hosts: Nominal),
        (complement: KeywordPhrase, hosts: Nominal),
        (complement: Gerund, hosts: Predicate),
    ]),
]
