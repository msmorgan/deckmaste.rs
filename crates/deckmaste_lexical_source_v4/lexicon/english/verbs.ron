// Core verbs and their active Subcategorization Frames. Keyword actions
// [CR#701.1] live in catalogs/keyword_actions.ron; auxiliaries and modals in
// closed_class.ron. Verbs formed from keyword abilities (*cycle*, *crew*,
// *equip*, …) are ordinary verbs of Category Verb and live here.
[
    (lemma: "accept", frames: [Monotransitive]),
    // *add a booster pack to the draft*
    (lemma: "add", frames: [Monotransitive, TransitiveWithPP(["to"])]),
    (lemma: "affect", frames: [Monotransitive]),
    (lemma: "apply", frames: [Intransitive, Prepositional(["to"])]),
    (lemma: "assign", frames: [Monotransitive, TransitiveWithPP(["to"])]),
    // *you attack with three or more creatures*; *each creature you attacked
    // with this turn* strands the preposition, so `with` is selected.
    (lemma: "attack", frames: [Intransitive, Monotransitive, Prepositional(["with"])]),
    (lemma: "become", preterite: "became", past_participle: "become", frames: [Copular]),
    (lemma: "begin", preterite: "began", past_participle: "begun", gerund: "beginning",
        frames: [Intransitive, Monotransitive]),
    (lemma: "bid", past: "bid", gerund: "bidding", frames: [Monotransitive]),
    (lemma: "block", frames: [Intransitive, Monotransitive]),
    (lemma: "break", preterite: "broke", past_participle: "broken", frames: [Monotransitive]),
    // *can't cause you to sacrifice or exile creature tokens*
    (lemma: "cause", frames: [ComplexCatenative(ToInf)]),
    (lemma: "change", frames: [Intransitive, Monotransitive, TransitiveWithPP(["to"])]),
    (lemma: "choose", preterite: "chose", past_participle: "chosen",
        // *choose first strike, vigilance, or lifelink*
        frames: [Intransitive, Monotransitive, Transitive(KeywordPhrase), Amount, Catenative(ToInf), ContentClause]),
    (lemma: "circle", frames: [Monotransitive]),
    // *whichever comes first*; *come under your control*; *coins come up heads*
    (lemma: "come", preterite: "came", past_participle: "come",
        // Phrasal-copular *come up heads* (CGEL, Ch. 4 §6.3, p. 288).
        frames: [Intransitive, Prepositional(["under", "up"]), Idiom([Prep("up"), Pred])]),
    (lemma: "commit", past: "committed", gerund: "committing", frames: [Monotransitive]),
    (lemma: "complete", frames: [Monotransitive]),
    (lemma: "contain", frames: [Monotransitive]),
    (lemma: "continue", frames: [Intransitive]),
    (lemma: "control", past: "controlled", gerund: "controlling", frames: [Monotransitive]),
    (lemma: "copy", frames: [Monotransitive]),
    // A hollow *to*-infinitival Complement (CGEL, Ch. 14 §6.3(c), p. 1250).
    // Restricted to active voice (CGEL, Ch. 16 §10.1.2, p. 1432, [17]).
    (lemma: "cost", past: "cost", frames: [Monotransitive, TransitiveWithComplement(HollowToInf)], active_only: true),
    (lemma: "count", frames: [Monotransitive]),
    // Ditransitive for the recipient passive *this creature is dealt damage*.
    (lemma: "deal", past: "dealt",
        frames: [Monotransitive, Ditransitive, TransitiveWithPP(["to"])]),
    // *you decide whether to flip again*
    (lemma: "decide", frames: [ContentClause]),
    // The pro-form *do so* (CGEL, Ch. 17 §7.5, pp. 1529–1532), inflected on
    // *do*: *all creatures able to block it do so*, *if a player does so*.
    (lemma: "do so", third_singular: "does so", preterite: "did so", past_participle: "done so", gerund: "doing so", frames: [Intransitive]),
    (lemma: "declare", frames: [Monotransitive, TransitiveWithPP(["as"])]),
    // The attributive participle of *the defending player*, *each defending
    // player* [CR#506.2], beside the determinative *defending* that heads a
    // bare *defending player* (closed_class.ron), as the verb *enchant*
    // stands beside the determinative *enchanted*.
    (lemma: "defend", frames: [Intransitive]),
    (lemma: "descend", frames: [Intransitive]),
    (lemma: "determine", frames: [Monotransitive]),
    (lemma: "die", frames: [Intransitive]),
    (lemma: "distribute", frames: [Monotransitive, TransitiveWithPP(["among"])]),
    (lemma: "divide", frames: [Monotransitive, TransitiveWithPP(["among", "into"])]),
    // *Draft this card face up.*
    (lemma: "draft", frames: [Monotransitive, ComplexTransitive]),
    (lemma: "draw", preterite: "drew", past_participle: "drawn", frames: [Monotransitive]),
    (lemma: "end", frames: [Intransitive, Monotransitive]),
    (lemma: "ensue", frames: [Intransitive]),
    (lemma: "enter", frames: [Intransitive, Monotransitive]),
    (lemma: "expend", frames: [Amount]),
    (lemma: "find", past: "found", frames: [Monotransitive, TransitiveWithPP(["among"])]),
    (lemma: "finish", frames: [Catenative(Gerund)]),
    (lemma: "flip", past: "flipped", gerund: "flipping", frames: [Monotransitive]),
    (lemma: "follow", frames: [Monotransitive]),
    // *Gain* and *have* grant an ability ([CR#113.1a]), a keyword or a quoted
    // one; *lose* takes away either.
    (lemma: "gain", frames: [Monotransitive, Transitive(KeywordPhrase), Transitive(QuotedAbility)]),
    // Oracle *get* takes only an object: *gets +2/+2*, *get an emblem*.
    // *gets +2/+2*: a slash measure is a Noun Phrase only where selected.
    (lemma: "get", preterite: "got", past_participle: "gotten", gerund: "getting",
        frames: [Monotransitive, Transitive(MeasureNP)]),
    (lemma: "give", preterite: "gave", past_participle: "given",
        frames: [Monotransitive, Ditransitive]),
    (lemma: "group", frames: [TransitiveWithPP(["into"])]),
    (lemma: "guess", frames: [Intransitive, Monotransitive, ContentClause]),
    (lemma: "hide", preterite: "hid", past_participle: "hidden", frames: [Monotransitive]),
    (lemma: "ignore", frames: [Monotransitive]),
    (lemma: "include", frames: [Monotransitive]),
    (lemma: "increase", frames: [Monotransitive, TransitiveWithPP(["by"])]),
    // *Restart the game, leaving in exile all non-Aura permanent cards …*
    (lemma: "leave", past: "left", frames: [Monotransitive, TransitiveWithPP(["in"])]),
    (lemma: "lock", frames: [Monotransitive]),
    (lemma: "look", frames: [Prepositional(["at"])]),
    (lemma: "lose", past: "lost", frames: [Monotransitive, Transitive(KeywordPhrase), Transitive(QuotedAbility)]),
    (lemma: "make", past: "made", frames: [Monotransitive]),
    // *damage marked on it*
    (lemma: "mark", frames: [TransitiveWithPP(["on"])]),
    (lemma: "match", frames: [Intransitive]),
    (lemma: "modify", frames: [Monotransitive]),
    // The source `from` PP is an adjunct, as with *put*.
    (lemma: "move", frames: [Monotransitive, Prepositional(["to"]), TransitiveWithPP(["onto"])]),
    (lemma: "mulligan", frames: [Intransitive]),
    // Only the passive is printed: *cards named CARDNAME*.
    (lemma: "name", frames: [ComplexTransitive]),
    (lemma: "note", frames: [Monotransitive, ContentClause]),
    (lemma: "offer", frames: [Ditransitive]),
    (lemma: "own", frames: [Monotransitive]),
    (lemma: "pair", frames: [TransitiveWithPP(["with"])]),
    (lemma: "pass", frames: [Monotransitive, TransitiveWithPP(["to"])]),
    // *tapped to pay for its abilities*
    (lemma: "pay", past: "paid", frames: [Monotransitive, Prepositional(["for"])]),
    (lemma: "phase", frames: [Prepositional(["in", "out"])]),
    (lemma: "prevent", frames: [Monotransitive]),
    (lemma: "print", frames: [Monotransitive]),
    (lemma: "proceed", frames: [Intransitive]),
    (lemma: "produce", frames: [Monotransitive]),
    (lemma: "promise", frames: [Monotransitive]),
    (lemma: "protect", frames: [Monotransitive]),
    (lemma: "put", past: "put", gerund: "putting", frames: [TransitiveWithComplement(LocativeNP), TransitiveWithPP(["into", "in", "on", "onto", "back", "there"])]),
    (lemma: "receive", frames: [Monotransitive]),
    (lemma: "redistribute", frames: [Monotransitive]),
    (lemma: "reduce", frames: [Monotransitive, TransitiveWithPP(["by", "to"])]),
    (lemma: "remain", frames: [Copular, Prepositional(["in", "on", "under", "outside", "among"])]),
    (lemma: "remove", frames: [Monotransitive, TransitiveWithPP(["from"])]),
    (lemma: "reorder", frames: [Monotransitive]),
    (lemma: "repeat", frames: [Monotransitive]),
    (lemma: "replace", frames: [TransitiveWithPP(["with"])]),
    (lemma: "reselect", frames: [Monotransitive, ContentClause]),
    (lemma: "resolve", frames: [Intransitive]),
    (lemma: "restart", frames: [Monotransitive]),
    (lemma: "return", frames: [Monotransitive, TransitiveWithPP(["to"])]),
    (lemma: "reverse", frames: [Monotransitive]),
    // A die, not the Attraction keyword action [CR#701.52]: *roll a d20*.
    (lemma: "roll", frames: [Intransitive, Monotransitive, Amount]),
    // *Round up each time.*; *half their life, rounded up*
    (lemma: "round", frames: [Prepositional(["down", "up"]), TransitiveWithPP(["down", "up"])]),
    (lemma: "separate", frames: [TransitiveWithPP(["into"])]),
    (lemma: "share", frames: [Monotransitive, TransitiveWithPP(["with"])]),
    // *skip your next turn*; *that player skips that turn instead*.
    (lemma: "skip", past: "skipped", gerund: "skipping", frames: [Monotransitive]),
    (lemma: "solve", frames: [Monotransitive]),
    (lemma: "spend", past: "spent", frames: [Monotransitive, TransitiveWithPP(["on"])]),
    (lemma: "stand", past: "stood", frames: [Intransitive]),
    // *Starting with you, each player …*
    (lemma: "start", frames: [Monotransitive, Prepositional(["with"])]),
    (lemma: "stop", past: "stopped", gerund: "stopping", frames: [Catenative(Gerund)]),
    (lemma: "subtract", frames: [Monotransitive]),
    (lemma: "switch", frames: [Monotransitive]),
    (lemma: "take", preterite: "took", past_participle: "taken", frames: [Monotransitive]),
    (lemma: "target", frames: [Monotransitive]),
    (lemma: "top", past: "topped", gerund: "topping", frames: [Monotransitive]),
    // *turn it face up*
    (lemma: "turn", frames: [ComplexTransitive]),
    (lemma: "trigger", frames: [Intransitive, Monotransitive]),
    (lemma: "unlock", frames: [Monotransitive]),
    // *cast using teamwork*
    (lemma: "use", frames: [Monotransitive, Transitive(KeywordPhrase)]),
    (lemma: "win", past: "won", gerund: "winning", frames: [Intransitive, Monotransitive]),
]
