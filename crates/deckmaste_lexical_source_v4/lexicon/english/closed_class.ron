// Core closed-class vocabulary: the only words a grammar may name.
(
    // CGEL's determinatives (Ch. 5 §4, p. 356) as Oracle uses them. Number
    // (this/those) and grade (many/more/most) are not features of a
    // determinative here, so each attested form is its own lemma.
    determinatives: [
        (lemma: "last", distribution: Deictic, noun_kind: Some(Temporal)),
        (lemma: "next", distribution: Deictic, noun_kind: Some(Temporal)),
        (lemma: "a", distribution: IndefiniteArticle, number: Singular, countability: Count, spellings: ["a", "an"], article_onsets: {"a": Consonant, "an": Vowel}),
        (lemma: "all", frames: [Complement(PP(["of"])), Complement(PP(["but"]))]),
        (number: Singular, countability: Count, lemma: "another", distribution: SingularOrQuantified, frames: [Complement(PP(["of"]))]),
        // Its partitive is the grammar's: with a plural oblique the Noun
        // Phrase may be singular or plural (*if any of those cards shares ...*).
        (lemma: "any", distribution: FreeChoice),
        // Compound determinatives (CGEL p. 423): *from anywhere*, *protection from everything*.
        (lemma: "anywhere", distribution: Independent, noun_kind: Some(Locative)),
        (number: Plural, countability: Count, lemma: "both", frames: [Complement(PP(["of"]))]),
        (number: Singular, countability: Count, lemma: "each", distribution: Distributive, frames: [Complement(PP(["of"]))]),
        (number: Singular, countability: Count, lemma: "either", distribution: Distributive, frames: [Complement(PP(["of"]))]),
        (number: Singular, countability: Count, lemma: "every", distribution: Distributive),
        (lemma: "everything"),
        (number: Plural, countability: Count, lemma: "fewer", frames: [Complement(PP(["of"])), Complement(PP(["than"]))]),
        (number: Plural, countability: Count, lemma: "fewest"),
        // Fraction and multiplier predeterminers (*half their life*, *double
        // that damage*; CGEL, Ch. 5 §7.3, p. 434); the verb is a keyword action.
        (lemma: "half", distribution: Multiplier),
        (lemma: "double", distribution: Multiplier),
        (number: Singular, countability: Mass, lemma: "least"),
        (number: Singular, countability: Mass, lemma: "less", frames: [Complement(PP(["of"])), Complement(PP(["than"]))]),
        (number: Plural, countability: Count, lemma: "many", frames: [Complement(PP(["of"]))]),
        (lemma: "more", frames: [Complement(PP(["of"])), Complement(PP(["than"]))]),
        (lemma: "most", frames: [Complement(PP(["of"]))]),
        (number: Singular, countability: Mass, lemma: "much", frames: [Complement(PP(["of"]))]),
        (number: Singular, countability: Count, lemma: "neither", distribution: Distributive, frames: [Complement(PP(["of"]))]),
        (lemma: "no"),
        // The independent form of *no* (CGEL p. 356).
        (lemma: "none", distribution: Independent, frames: [Complement(PP(["of"]))]),
        (lemma: "some", frames: [Complement(PP(["of"]))]),
        // Oracle determiner use; other lexical categories remain independent.
        (lemma: "target"),
        (number: Singular, lemma: "that", distribution: Deictic),
        (lemma: "the"),
        (number: Singular, lemma: "this", distribution: Deictic),
        (number: Plural, countability: Count, lemma: "those"),
        // Only interrogative and fused relative: never a plain determiner.
        (lemma: "which", distribution: Independent),
        (lemma: "whichever", distribution: Independent),
    ],
    // Reflexives are Lexemes of their own: the schema has no reflexive Word
    // Form. They fill only non-subject positions, hence Accusative.
    pronouns: [
        (lemma: "I", forms: [
            (person: First, number: Singular, case: Nominative, surfaces: "I"),
            (person: First, number: Singular, case: Accusative, surfaces: "me"),
            (person: First, number: Singular, case: Genitive, surfaces: "my"),
            (form: IndependentGenitive, person: First, number: Singular, case: Genitive, surfaces: "mine"),
        ]),
        (lemma: "he", forms: [
            (person: Third, number: Singular, case: Nominative, surfaces: "he"),
            (person: Third, number: Singular, case: Accusative, surfaces: "him"),
            (person: Third, number: Singular, case: Genitive, surfaces: "his"),
            (form: IndependentGenitive, person: Third, number: Singular, case: Genitive, surfaces: "his"),
        ]),
        (lemma: "himself", forms: [
            (person: Third, number: Singular, case: Accusative, surfaces: "himself"),
        ]),
        (lemma: "it", forms: [
            (person: Third, number: Singular, case: Nominative, surfaces: "it"),
            (person: Third, number: Singular, case: Accusative, surfaces: "it"),
            (person: Third, number: Singular, case: Genitive, surfaces: "its"),
        ]),
        (lemma: "itself", forms: [
            (person: Third, number: Singular, case: Accusative, surfaces: "itself"),
        ]),
        (lemma: "she", forms: [
            (person: Third, number: Singular, case: Nominative, surfaces: "she"),
            (person: Third, number: Singular, case: Accusative, surfaces: "her"),
            (person: Third, number: Singular, case: Genitive, surfaces: "her"),
            (form: IndependentGenitive, person: Third, number: Singular, case: Genitive, surfaces: "hers"),
        ]),
        // Existential dummy *there*; it agrees with the displaced subject.
        (lemma: "there", kind: Existential, forms: [
            (person: Third, number: Singular, case: Nominative, surfaces: "there"),
            (person: Third, number: Plural, case: Nominative, surfaces: "there"),
        ]),
        // Oracle *they* refers to one player or to several objects, but as the
        // source of agreement it is plural in every case (CGEL p. 494):
        // *each player sacrifices a creature they control*.
        (lemma: "they", forms: [
            (person: Third, number: Plural, case: Nominative, surfaces: "they"),
            (person: Third, number: Plural, case: Accusative, surfaces: "them"),
            (person: Third, number: Plural, case: Genitive, surfaces: "their"),
            (form: IndependentGenitive, person: Third, number: Plural, case: Genitive, surfaces: "theirs"),
        ]),
        // Relative *which* does not inflect for case.
        (lemma: "which", kind: Relative, forms: [
            (person: Third, number: Singular, surfaces: "which"),
            (person: Third, number: Plural, surfaces: "which"),
        ]),
        // *Whose* is the genitive of relative *who* and *which* alike (CGEL p. 1050).
        // Only subject *who* agrees with a verb, so only it varies in number.
        (lemma: "who", kind: Relative, forms: [
            (person: Third, number: Singular, case: Nominative, surfaces: "who"),
            (person: Third, number: Plural, case: Nominative, surfaces: "who"),
            (person: Third, number: Singular, case: Accusative, surfaces: "whom"),
            (person: Third, number: Singular, case: Genitive, surfaces: "whose"),
        ]),
        // Oracle "you" is always one player.
        (lemma: "you", forms: [
            (person: Second, number: Singular, case: Nominative, surfaces: "you"),
            (person: Second, number: Singular, case: Accusative, surfaces: "you"),
            (person: Second, number: Singular, case: Genitive, surfaces: "your"),
            (form: IndependentGenitive, person: Second, number: Singular, case: Genitive, surfaces: "yours"),
        ]),
        (lemma: "yourself", forms: [
            (person: Second, number: Singular, case: Accusative, surfaces: "yourself"),
        ]),
    ],
    coordinators: ["and", "and/or", "but", "nor", "or"],
    // CGEL's subordinators (Ch. 11 §8.1, p. 1011) plus infinitival *to*; the
    // other traditional "subordinating conjunctions" are prepositions.
    subordinators: ["that", "to", "whether"],
    // Negative auxiliaries are named by their plain-person present form. The
    // modals have no -s form: their third singular is spelled like the rest
    // of the present.
    auxiliaries: [
        (lemma: "be", third_singular: "is", preterite: "were", past_participle: "been",
            gerund: "being", irrealis: "were",
            forms: [
                (form: Present, person: First, number: Singular, surfaces: "am"),
                (form: Present, person: Second, surfaces: "are"),
                (form: Present, number: Plural, surfaces: "are"),
                (form: Preterite, person: First, number: Singular, surfaces: "was"),
                (form: Preterite, person: Third, number: Singular, surfaces: "was"),
            ],
            // A predicative or a locative Complement (CGEL Ch. 4 §5.2, p. 257).
            frames: [Copular, Prepositional(["in", "on", "under", "outside", "among"])]),
        (lemma: "aren't", form_of: Some("be"), third_singular: "isn't", preterite: "weren't", irrealis: "weren't",
            forms: [
                (form: Preterite, person: First, number: Singular, surfaces: "wasn't"),
                (form: Preterite, person: Third, number: Singular, surfaces: "wasn't"),
            ],
            finite_only: true, negative: true, frames: [Copular, Prepositional(["in", "on", "under", "outside", "among"])]),
        (lemma: "can", third_singular: "can", preterite: "could", finite_only: true, frames: [Catenative(BareInf)]),
        (lemma: "can't", form_of: Some("can"), third_singular: "can't", preterite: "couldn't", finite_only: true, negative: true,
            frames: [Catenative(BareInf)]),
        // Pro-form *if you do*; *do this only once each turn*.
        (lemma: "do", third_singular: "does", preterite: "did", past_participle: "done",
            frames: [Intransitive, Monotransitive]),
        (lemma: "don't", form_of: Some("do"), third_singular: "doesn't", preterite: "didn't", finite_only: true,
            negative: true, frames: [Catenative(BareInf), Intransitive]),
        // *you may have target player reveal their hand*
        (lemma: "have", third_singular: "has", past: "had",
            frames: [Monotransitive, Transitive(KeywordPhrase), Catenative(ToInf), ComplexCatenative(BareInf)]),
        // Only the perfect auxiliary (*hasn't been chosen*), which the grammar
        // names; no frame selects a past participle.
        (lemma: "haven't", form_of: Some("have"), third_singular: "hasn't", preterite: "hadn't",
            finite_only: true, negative: true),
        // Contracted auxiliaries are bound to their host (CGEL Ch. 18 §6.2,
        // pp. 1613–1616): *you've*, *you're*, *it's*.
        (lemma: "'ve", form_of: Some("have"), third_singular: ["'s", "’s"], finite_only: true, binding: Suffix,
            forms: [
                (form: Present, person: First, surfaces: ["'ve", "’ve"]),
                (form: Present, person: Second, surfaces: ["'ve", "’ve"]),
                (form: Present, person: Third, number: Plural, surfaces: ["'ve", "’ve"]),
            ]),
        (lemma: "'re", form_of: Some("be"), third_singular: ["'s", "’s"], finite_only: true, binding: Suffix,
            forms: [
                (form: Present, person: First, number: Singular, surfaces: ["'m", "’m"]),
                (form: Present, person: First, number: Plural, surfaces: ["'re", "’re"]),
                (form: Present, person: Second, surfaces: ["'re", "’re"]),
                (form: Present, person: Third, number: Plural, surfaces: ["'re", "’re"]),
            ],
            frames: [Copular, Prepositional(["in", "on", "under", "outside", "among"])]),
        (lemma: "may", third_singular: "may", preterite: "might", finite_only: true, frames: [Catenative(BareInf)]),
        (lemma: "must", third_singular: "must", finite_only: true, frames: [Catenative(BareInf)]),
        (lemma: "will", third_singular: "will", preterite: "would", finite_only: true, frames: [Catenative(BareInf)]),
    ],
    affixes: [(name: "non", spellings: ["non", "non-"], binding: Prefix)],
    // The plural genitive is the same clitic, spelled with the apostrophe alone.
    clitics: [(name: "genitive", spellings: ["'s", "’s", "'", "’"], binding: Suffix)],
    // [CR#107.4,107.5,107.6,107.14,107.18]; numerical symbols as printed on
    // in-scope cards. Planechase {CHAOS} and {PW} and Un-set symbols are out of scope.
    symbols: [
        (surface: "{T}", classes: ["BracedSymbol"]), (surface: "{Q}", classes: ["BracedSymbol"]), (surface: "{E}", classes: ["BracedSymbol"]), (surface: "{S}", classes: ["BracedSymbol"]), (surface: "{X}", classes: ["BracedSymbol"]),
        (surface: "{W}", classes: ["BracedSymbol"]), (surface: "{U}", classes: ["BracedSymbol"]), (surface: "{B}", classes: ["BracedSymbol"]), (surface: "{R}", classes: ["BracedSymbol"]), (surface: "{G}", classes: ["BracedSymbol"]), (surface: "{C}", classes: ["BracedSymbol"]),
        (surface: "{0}", classes: ["BracedSymbol"]), (surface: "{1}", classes: ["BracedSymbol"]), (surface: "{2}", classes: ["BracedSymbol"]), (surface: "{3}", classes: ["BracedSymbol"]), (surface: "{4}", classes: ["BracedSymbol"]), (surface: "{5}", classes: ["BracedSymbol"]), (surface: "{6}", classes: ["BracedSymbol"]), (surface: "{7}", classes: ["BracedSymbol"]), (surface: "{8}", classes: ["BracedSymbol"]), (surface: "{9}", classes: ["BracedSymbol"]), (surface: "{10}", classes: ["BracedSymbol"]),
        (surface: "{11}", classes: ["BracedSymbol"]), (surface: "{12}", classes: ["BracedSymbol"]), (surface: "{13}", classes: ["BracedSymbol"]), (surface: "{14}", classes: ["BracedSymbol"]), (surface: "{15}", classes: ["BracedSymbol"]), (surface: "{16}", classes: ["BracedSymbol"]), (surface: "{20}", classes: ["BracedSymbol"]),
        (surface: "{W/U}", classes: ["BracedSymbol"]), (surface: "{W/B}", classes: ["BracedSymbol"]), (surface: "{U/B}", classes: ["BracedSymbol"]), (surface: "{U/R}", classes: ["BracedSymbol"]), (surface: "{B/R}", classes: ["BracedSymbol"]), (surface: "{B/G}", classes: ["BracedSymbol"]), (surface: "{R/G}", classes: ["BracedSymbol"]), (surface: "{R/W}", classes: ["BracedSymbol"]), (surface: "{G/W}", classes: ["BracedSymbol"]), (surface: "{G/U}", classes: ["BracedSymbol"]),
        (surface: "{2/W}", classes: ["BracedSymbol"]), (surface: "{2/U}", classes: ["BracedSymbol"]), (surface: "{2/B}", classes: ["BracedSymbol"]), (surface: "{2/R}", classes: ["BracedSymbol"]), (surface: "{2/G}", classes: ["BracedSymbol"]),
        (surface: "{C/W}", classes: ["BracedSymbol"]), (surface: "{C/U}", classes: ["BracedSymbol"]), (surface: "{C/B}", classes: ["BracedSymbol"]), (surface: "{C/R}", classes: ["BracedSymbol"]), (surface: "{C/G}", classes: ["BracedSymbol"]),
        (surface: "{W/P}", classes: ["BracedSymbol"]), (surface: "{U/P}", classes: ["BracedSymbol"]), (surface: "{B/P}", classes: ["BracedSymbol"]), (surface: "{R/P}", classes: ["BracedSymbol"]), (surface: "{G/P}", classes: ["BracedSymbol"]),
        (surface: "{W/U/P}", classes: ["BracedSymbol"]), (surface: "{W/B/P}", classes: ["BracedSymbol"]), (surface: "{U/B/P}", classes: ["BracedSymbol"]), (surface: "{U/R/P}", classes: ["BracedSymbol"]), (surface: "{B/R/P}", classes: ["BracedSymbol"]),
        (surface: "{B/G/P}", classes: ["BracedSymbol"]), (surface: "{R/G/P}", classes: ["BracedSymbol"]), (surface: "{R/W/P}", classes: ["BracedSymbol"]), (surface: "{G/W/P}", classes: ["BracedSymbol"]), (surface: "{G/U/P}", classes: ["BracedSymbol"]),
        // Any Phyrexian mana symbol, in rules text [CR#107.4g].
        (surface: "{H}", classes: ["BracedSymbol"]),
        // The pawprint symbol [CR#107.18].
        (surface: "{P}", classes: ["Pawprint"]),
        // Placeholder letters for numbers [CR#107.3,107.3p].
        (surface: "X", classes: ["Variable"]), (surface: "Y", classes: ["Variable"]),
        // The marker of a level symbol, printed `LEVEL 1-3` or `LEVEL 4+`
        // [CR#107.8,711.2a,711.2b]; its range is numeral notation.
        (surface: "LEVEL", classes: ["RangeMarker"]),
    ],
)
