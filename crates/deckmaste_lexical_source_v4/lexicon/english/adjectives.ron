// Core adjectives. Participles of declared verbs (tapped, attacking, modified,
// exiled) come from the verb; supertypes and designations live in catalogs/.
// Grades are declared only where English inflects them.
[
    // Defined predicate [CR#700.9].
    "modified",
    (lemma: "able", frames: [Complement(ToInf)]),
    "active",
    (lemma: "additional", position: Some(Attributive)),
    "alone",
    // *becomes attached to a creature*: the Adjectival Passive of *attach*,
    // with its Complement.
    (lemma: "attached", position: Some(Predicative), frames: [Complement(PP(["to"]))]),
    "bottom",
    "colored",
    "common",
    "different",
    "double-faced",
    (lemma: "equal", frames: [Complement(PP(["to"]))]),
    "even",
    "excess",
    (lemma: "extra", position: Some(Attributive)),
    "face-down",
    "face-up",
    "final",
    "four-sided",
    "free",
    "full",
    "generic",
    (lemma: "great", comparative: "greater", superlative: "greatest"),
    "guilty",
    (lemma: "high", comparative: "higher", superlative: "highest"),
    "historic",
    "illegal",
    "innocent",
    "last",
    "following",
    // Directional *the left half*; predicative *left* is the participle of *leave*.
    (lemma: "left", position: Some(Attributive)),
    "legal",
    (lemma: "lesser", grade: Some(Comparative), frames: [Complement(PP(["than"]))]),
    // Scalar *less* (CGEL, Ch. 13 §4.1.1, p. 1126): *power less than X*; the
    // determinative is *less mana*.
    (lemma: "less", position: Some(Predicative), grade: Some(Comparative), frames: [Complement(PP(["than"]))]),
    "lethal",
    (lemma: "long", comparative: "longer", superlative: "longest"),
    (lemma: "low", comparative: "lower", superlative: "lowest"),
    "maximum",
    "minimum",
    "modal",
    // *a natural 20*
    (lemma: "natural", position: Some(Attributive)),
    (lemma: "near", comparative: "nearer", superlative: "nearest"),
    "negative",
    (lemma: "new", comparative: "newer", superlative: "newest"),
    "next",
    "odd",
    // Attributive-only "the only creature card" (CGEL, Ch. 6, §4.1, p. 553).
    (lemma: "only", position: Some(Attributive), determination: Some(Overt)),
    "original",
    (lemma: "other", position: Some(Attributive), fused_head: true, frames: [Complement(PP(["than"]))]),
    // Attributive-only (CGEL, Ch. 6, §4.1, p. 553); the verb `own` is separate.
    (lemma: "own", position: Some(Attributive)),
    "planar",
    // A state [CR#122.1f]; Oracle has no verb `poison`.
    "poisoned",
    "positive",
    "previous",
    // "a prime number of lands".
    "prime",
    "random",
    "recent",
    "right",
    (lemma: "same", grade: Some(Equative), frames: [Complement(PP(["as"]))]),
    "single",
    "six-sided",
    (lemma: "small", comparative: "smaller", superlative: "smallest"),
    // The Targeting Marker of "another target creature", "two target
    // creatures": attributive-only and invariant, distinct from the count noun.
    (lemma: "target", position: Some(Attributive), determination: Some(Overt)),
    "top",
    "total",
    (lemma: "true", frames: [Complement(PP(["for"]))]),
    // [CR#509.1h]; there is no verb `unblock`.
    "unblocked",
    "unchanged",
    "unopened",
    "unspent",
    // "faces a villainous choice" [CR#701.55a]; the verb `face` is the keyword action.
    "villainous",
    "wild",
    "worthy",
    "wrong",

    // Color Words [CR#105.1,105.2a..105.2c].
    "black",
    "blue",
    "colorless",
    "green",
    "monocolored",
    "multicolored",
    "red",
    "white",

    // Predicative *first* (*whichever comes first*); an attributive ordinal
    // is the grammar's numeral (*the second spell*).
    (lemma: "first", position: Some(Predicative)),
    // Multipliers in attributive use (*double damage*; CGEL Ch. 5 §7.3, p. 434);
    // the verbs are keyword actions [CR#701.10,701.11].
    "double",
    "triple",
    // No verb *tie* in Oracle: *the vote is tied*, *tied for most common*.
    (lemma: "tied", frames: [Complement(PP(["for"]))]),
]
