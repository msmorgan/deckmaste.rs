// Adverbs and the clause positions Oracle text puts them in.
[
    // *it explores, then it explores again*
    (lemma: "again", positions: [End]),
    // *Also put a +1/+1 counter on that creature*; *it also gains trample*
    (lemma: "also", positions: [Front, Central]),
    (lemma: "already", positions: [Central]),
    // Bounding idioms on a quantity (CGEL p. 1129): *at least two creatures*.
    (lemma: "at least", positions: [Bounding]),
    (lemma: "at most", positions: [Bounding]),
    (lemma: "continuously", positions: [End]),
    (lemma: "correctly", positions: [End]),
    // A manner adverb (CGEL, Ch. 17 §8, p. 1547), also before an attributive
    // participle: *differently named lands*.
    (lemma: "differently", positions: [End]),
    // *a creature card directly above it*
    (lemma: "directly", positions: [Phrasal]),
    (lemma: "evenly", positions: [End]),
    (lemma: "exactly", positions: [Bounding]),
    // *so far this turn*
    (lemma: "far", positions: [End]),
    (lemma: "fully", positions: [Central]),
    // *Immediately after the draft*
    (lemma: "immediately", positions: [Phrasal]),
    // *just beneath the top X cards*
    (lemma: "just", positions: [Phrasal]),
    (lemma: "likewise", positions: [Central]),
    // *it's not legendary*; *cards not named ...*
    (lemma: "not", positions: [Central, Phrasal]),
    // *Once each turn, you may ...*; *Activate only once each turn*
    (lemma: "once", positions: [Front, End]),
    // *If they guessed wrong*
    (lemma: "wrong", positions: [End]),
    // *can only*; *Activate only as a sorcery*; *Only creatures ... can block*
    (lemma: "next", positions: [Central]),
    // *is no longer snow*
    (lemma: "no longer", positions: [Central]),
    (lemma: "only", positions: [Central, Phrasal]),
    (lemma: "originally", positions: [Central]),
    (lemma: "otherwise", positions: [Front]),
    // *+1/+1 if it has flying, +1/+1 if it has first strike, and so on for
    // double strike, ...* (CGEL, Ch. 17 §7.7.3(e), p. 1540).
    (lemma: "so on", positions: [Coordinate]),
    (lemma: "previously", positions: [Central]),
    // *most recently cast*
    (lemma: "recently", positions: [Central]),
    // Front before a bare imperative (*secretly choose an opponent*), where
    // front and central positions coincide and the grammar reads the front
    // one; central after a Subject (*each player secretly chooses*).
    (lemma: "secretly", positions: [Front, Central]),
    // *that player simultaneously untaps*; *reveal them simultaneously*;
    // front before a bare imperative (*Simultaneously untap ...*), as
    // *secretly* is.
    (lemma: "simultaneously", positions: [Front, Central, End]),
    // *so far this turn*: Oracle's only adverbial *so*, a fixed phrase; the
    // pro-form *do so* is a verb of its own.
    (lemma: "so far", positions: [End]),
    (lemma: "still", positions: [Central]),
    // Connective *then* (CGEL, Ch. 8 §19, p. 778 [9ii]): front (*Then draw
    // a card*), central (*you may then put*), and the sole marker of a
    // Linked Coordination (*Draw a card, then discard a card*; Ch. 15
    // §2.10, pp. 1319–1320).
    (lemma: "then", positions: [Front, Central, Linking]),
    // *copy that spell twice*; *deals twice that much damage*
    (lemma: "twice", positions: [End, Multiplying]),
    (lemma: "yet", positions: [End]),
]
