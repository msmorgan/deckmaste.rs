// WC99 Mono-G Stompy (Linde) — greedy data-driven play policy.
//
// Phase 1 of the Strategy-seam migration: pure greedy, no lookahead. The
// rule-walk applies the first rule whose `prefer` is a legal play at the
// current decision. The two `Activate` rules float mana (the data evaluator
// does not float on its own — it only casts when the pool already funds the
// cost); Llanowar Elves is tapped before lands so the `nonland_taps` probe
// keeps firing.
(
    name: "WC99 Mono-G Stompy",
    rules: [
        // Develop: play a land whenever able.
        (when: And([]), prefer: Play(what: (pick: First, by: Literal(1)))),
        // Deploy the biggest creature the pool can already fund (never a land,
        // which can surface as a zero-cost CastSpell).
        (when: And([]), prefer: Cast(what: (pick: Max, by: StatOf(Reg(0), ManaValue), among: Not(Characteristic(Type((name: "Land", permanent_type: true))))))),
        // Ramp toward the next cast: tap lands first so creatures stay untapped
        // to attack; fall back to a mana dork only when lands are exhausted
        // (which still fires the nonland-tap probe when the seat floods).
        (when: And([]), prefer: Activate(what: (pick: First, by: Literal(1), among: Characteristic(Type((name: "Land", permanent_type: true)))))),
        (when: And([]), prefer: Activate(what: (pick: First, by: Literal(1), among: Characteristic(Named("Llanowar Elves"))))),
        // Swing with everything that can legally attack.
        (when: And([]), prefer: Attack(what: (pick: First, by: Literal(1), among: Any))),
        // Hold the ground.
        (when: And([]), prefer: Block(BlockAll)),
        (when: And([]), prefer: Pass),
    ],
)
