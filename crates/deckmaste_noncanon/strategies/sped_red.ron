// Mark Le Pine's Worlds 1999 Sped Red — greedy mono-red policy against Stompy.
(
    name: "Worlds 1999 Sped Red",
    rules: [
        (when: And([]), prefer: Play(what: (pick: First, by: Literal(1)))),
        (when: And([]), prefer: Cast(
            what: (pick: Min, by: StatOf(Reg(0), ManaValue), among: Not(Characteristic(Type((name: "Land", permanent: true))))),
            target: (pick: First, by: Literal(1), among: And([Kind(Player), Not(Ref(Reg(1)))])),
        )),
        (when: And([]), prefer: Activate(
            what: (pick: First, by: Literal(1), among: Characteristic(Type((name: "Land", permanent: true)))),
            target: (pick: First, by: Literal(1), among: Characteristic(Type((name: "Land", permanent: true)))),
        )),
        (when: And([]), prefer: Activate(
            what: (pick: First, by: Literal(1), among: Not(Characteristic(Type((name: "Land", permanent: true))))),
            target: (pick: First, by: Literal(1), among: And([Kind(Player), Not(Ref(Reg(1)))])),
        )),
        (when: And([]), prefer: Attack(what: (pick: First, by: Literal(1), among: Any))),
        (when: And([]), prefer: Block(BlockAll)),
        (when: And([]), prefer: Pass),
    ],
)
