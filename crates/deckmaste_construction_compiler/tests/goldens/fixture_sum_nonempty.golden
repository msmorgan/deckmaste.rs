    fn __erased_field_root_items(
        values: Vec<::deckmaste_construction_compiler::runtime::ErasedValue>,
    ) -> Result<
        ::deckmaste_construction_compiler::runtime::ErasedValue,
        ::deckmaste_construction_compiler::runtime::ErasedBuildError,
