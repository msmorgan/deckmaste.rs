mod __constructions_fixture_sum {
    #![allow(
        clippy::nonminimal_bool,
        reason = "the `if !(…)` wrapper negates arbitrary author predicates \
                          uniformly, including `matches!` and nested `&&`/`||` trees; \
                          a De Morgan pass would add a whole rewriting layer for zero \
                          semantic gain"
    )]
    #![allow(
        clippy::must_use_candidate,
        reason = "accessors are generated per declared field, not chosen"
    )]
    #![allow(
        clippy::missing_errors_doc,
        reason = "try_new's error conditions are the declaration's `require` \
                          clauses, which the author wrote and can read"
    )]
    #![allow(
        clippy::borrowed_box,
        reason = "bound-element destructurers preserve the declaration's exact payload type"
    )]
    #![allow(
        clippy::too_many_lines,
        reason = "a total generated linearizer grows with the number and size of declared forms"
    )]
    #![allow(
        clippy::needless_borrow,
        reason = "uniform generated field access composes direct, optional, and sequence-member references"
    )]
    use super::*;
    pub enum NodeVariantRef<'a> {
        Unit,
        Leaf(&'a String),
        Pair { left: &'a Box<Node>, right: &'a Box<Node> },
        Named { label: &'a String, child: &'a Box<Node> },
    }
    pub fn parts_node(value: &Node) -> NodeVariantRef<'_> {
        match value {
            Node::Unit => NodeVariantRef::Unit,
            Node::Leaf(payload) => NodeVariantRef::Leaf(payload),
            Node::Pair(left, right) => {
                NodeVariantRef::Pair {
                    left,
                    right,
                }
            }
            Node::Named { label, child } => {
                NodeVariantRef::Named {
                    label,
                    child,
                }
            }
        }
    }
    pub fn build_node_unit() -> Node {
        Node::Unit
    }
    pub fn build_node_leaf(payload: String) -> Node {
        Node::Leaf(payload)
    }
    pub fn build_node_pair(left: Box<Node>, right: Box<Node>) -> Node {
        Node::Pair(left, right)
    }
    pub fn build_node_named(label: String, child: Box<Node>) -> Node {
        Node::Named { label, child }
    }
    #[derive(Debug, PartialEq, Eq)]
    pub struct Item {
        pub value: String,
    }
    fn __parts_wrapped(value: &Wrapped) -> (&Node, &Box<ConcreteClause>, &bool, &Item) {
        let Wrapped { node, clause, marked, item } = value;
        (node, clause, marked, item)
    }
    const _: fn(&Wrapped) -> (&Node, &Box<ConcreteClause>, &bool, &Item) = __parts_wrapped;
    fn __linearize_sum_node_with<V>(
        value: &Node,
        role: &'static str,
        visitor: &mut V,
    ) -> Result<
        (),
        ::deckmaste_construction_compiler::runtime::LinearizationError<V::Error>,
    >
    where
        V: ::deckmaste_construction_compiler::runtime::LinearizationVisitor,
    {
        visitor
            .bound_value("node", value)
            .map_err(
                ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
            )?;
        match value {
            Node::Unit => {
                visitor
                    .begin_sum_variant(role, "node", "Unit")
                    .map_err(
                        ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
                    )?;
                visitor
                    .end_sum_variant(role)
                    .map_err(
                        ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
                    )?;
            }
            Node::Leaf(payload) => {
                visitor
                    .begin_sum_variant(role, "node", "Leaf")
                    .map_err(
                        ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
                    )?;
                visitor
                    .scalar("String", payload)
                    .map_err(
                        ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
                    )?;
                visitor
                    .projected_scalar(
                        "payload",
                        "String",
                        ::deckmaste_construction_compiler::runtime::projection_value(
                            payload,
                        ),
                    )
                    .map_err(
                        ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
                    )?;
                visitor
                    .end_sum_variant(role)
                    .map_err(
                        ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
                    )?;
            }
            Node::Pair(left, right) => {
                visitor
                    .begin_sum_variant(role, "node", "Pair")
                    .map_err(
                        ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
                    )?;
                __linearize_sum_node_with((left).as_ref(), "left", visitor)?;
                __linearize_sum_node_with((right).as_ref(), "right", visitor)?;
                visitor
                    .end_sum_variant(role)
                    .map_err(
                        ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
                    )?;
            }
            Node::Named { label, child } => {
                visitor
                    .begin_sum_variant(role, "node", "Named")
                    .map_err(
                        ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
                    )?;
                visitor
                    .scalar("String", label)
                    .map_err(
                        ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
                    )?;
                visitor
                    .projected_scalar(
                        "label",
                        "String",
                        ::deckmaste_construction_compiler::runtime::projection_value(
                            label,
                        ),
                    )
                    .map_err(
                        ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
                    )?;
                __linearize_sum_node_with((child).as_ref(), "child", visitor)?;
                visitor
                    .end_sum_variant(role)
                    .map_err(
                        ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
                    )?;
            }
        }
        Ok(())
    }
    fn __linearize_product_item_with<V>(
        value: &Item,
        role: &'static str,
        visitor: &mut V,
    ) -> Result<
        (),
        ::deckmaste_construction_compiler::runtime::LinearizationError<V::Error>,
    >
    where
        V: ::deckmaste_construction_compiler::runtime::LinearizationVisitor,
    {
        visitor
            .bound_value("item", value)
            .map_err(
                ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
            )?;
        visitor
            .begin_product(role, "item")
            .map_err(
                ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
            )?;
        let __product_value = &value.value;
        visitor
            .scalar("String", __product_value)
            .map_err(
                ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
            )?;
        visitor
            .projected_scalar(
                "value",
                "String",
                ::deckmaste_construction_compiler::runtime::projection_value(
                    __product_value,
                ),
            )
            .map_err(
                ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
            )?;
        visitor
            .end_product(role)
            .map_err(
                ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
            )?;
        Ok(())
    }
    fn __linearize_product_wrapped_with<V>(
        value: &Wrapped,
        role: &'static str,
        visitor: &mut V,
    ) -> Result<
        (),
        ::deckmaste_construction_compiler::runtime::LinearizationError<V::Error>,
    >
    where
        V: ::deckmaste_construction_compiler::runtime::LinearizationVisitor,
    {
        visitor
            .bound_value("wrapped", value)
            .map_err(
                ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
            )?;
        visitor
            .begin_product(role, "wrapped")
            .map_err(
                ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
            )?;
        let (__product_node, __product_clause, __product_marked, __product_item) = __parts_wrapped(
            value,
        );
        __linearize_sum_node_with(__product_node, "node", visitor)?;
        visitor
            .subtree("ClauseCategory", (__product_clause).as_ref())
            .map_err(
                ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
            )?;
        visitor
            .projected_subtree(
                "clause",
                "ClauseCategory",
                ::deckmaste_construction_compiler::runtime::projection_value(
                    (__product_clause).as_ref(),
                ),
            )
            .map_err(
                ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
            )?;
        visitor
            .scalar("bool", __product_marked)
            .map_err(
                ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
            )?;
        visitor
            .projected_scalar(
                "marked",
                "bool",
                ::deckmaste_construction_compiler::runtime::projection_value(
                    __product_marked,
                ),
            )
            .map_err(
                ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
            )?;
        __linearize_product_item_with(__product_item, "item", visitor)?;
        visitor
            .end_product(role)
            .map_err(
                ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
            )?;
        Ok(())
    }
    #[derive(Debug, PartialEq, Eq)]
    pub struct RootNode {
        node: Node,
        wrapped: Wrapped,
        boxed_wrapped: Box<Wrapped>,
        clause: ConcreteClause,
        boxed_clause: Box<ConcreteClause>,
        nodes: ::deckmaste_construction_compiler::runtime::NonEmpty<Node>,
        items: ::deckmaste_construction_compiler::runtime::SeparatedNonEmpty<
            Item,
            Separator,
        >,
    }
    impl RootNode {
        pub fn try_new(
            node: Node,
            wrapped: Wrapped,
            boxed_wrapped: Box<Wrapped>,
            clause: ConcreteClause,
            boxed_clause: Box<ConcreteClause>,
            nodes: ::deckmaste_construction_compiler::runtime::NonEmpty<Node>,
            items: ::deckmaste_construction_compiler::runtime::SeparatedNonEmpty<
                Item,
                Separator,
            >,
        ) -> Result<
            Self,
            ::deckmaste_construction_compiler::runtime::DeclarationViolation,
        > {
            Ok(Self {
                node,
                wrapped,
                boxed_wrapped,
                clause,
                boxed_clause,
                nodes,
                items,
            })
        }
        pub fn node(&self) -> &Node {
            &self.node
        }
        pub fn wrapped(&self) -> &Wrapped {
            &self.wrapped
        }
        pub fn boxed_wrapped(&self) -> &Box<Wrapped> {
            &self.boxed_wrapped
        }
        pub fn clause(&self) -> &ConcreteClause {
            &self.clause
        }
        pub fn boxed_clause(&self) -> &Box<ConcreteClause> {
            &self.boxed_clause
        }
        pub fn nodes(
            &self,
        ) -> &::deckmaste_construction_compiler::runtime::NonEmpty<Node> {
            &self.nodes
        }
        pub fn items(
            &self,
        ) -> &::deckmaste_construction_compiler::runtime::SeparatedNonEmpty<
            Item,
            Separator,
        > {
            &self.items
        }
    }
    pub fn selected_root_form(
        value: &RootNode,
    ) -> Result<
        &'static ::deckmaste_construction_compiler::runtime::FormData,
        ::deckmaste_construction_compiler::runtime::FormSelectionError,
    > {
        let RootNode {
            node,
            wrapped: _,
            boxed_wrapped: _,
            clause: _,
            boxed_clause: _,
            nodes: _,
            items: _,
        } = value;
        let mut selected_form: Option<(u16, usize)> = None;
        if matches!(node, Node::Unit) {
            if let Some((first, _)) = selected_form {
                return Err(::deckmaste_construction_compiler::runtime::FormSelectionError::MultipleMatchingForms {
                    construction: "root",
                    first,
                    second: 0,
                });
            }
            selected_form = Some((0, 0usize));
        }
        if selected_form.is_none() {
            selected_form = Some((1, 1usize));
        }
        let Some((_, selected_form)) = selected_form else {
            return Err(::deckmaste_construction_compiler::runtime::FormSelectionError::NoMatchingForm {
                construction: "root",
            });
        };
        Ok(&FIXTURE_SUM_DECLARATION.constructions[0usize].forms[selected_form])
    }
    pub fn linearize_root_with<V>(
        value: &RootNode,
        visitor: &mut V,
    ) -> Result<
        (),
        ::deckmaste_construction_compiler::runtime::LinearizationError<V::Error>,
    >
    where
        V: ::deckmaste_construction_compiler::runtime::LinearizationVisitor,
    {
        let selected_form = selected_root_form(value)
            .map_err(|error| match error {
                ::deckmaste_construction_compiler::runtime::FormSelectionError::NoMatchingForm {
                    construction,
                } => {
                    ::deckmaste_construction_compiler::runtime::LinearizationError::NoMatchingForm {
                        construction,
                    }
                }
                ::deckmaste_construction_compiler::runtime::FormSelectionError::MultipleMatchingForms {
                    construction,
                    first,
                    second,
                } => {
                    ::deckmaste_construction_compiler::runtime::LinearizationError::MultipleMatchingForms {
                        construction,
                        first,
                        second,
                    }
                }
            })?;
        linearize_root_form_with(value, selected_form.ordinal, visitor)
    }
    pub fn linearize_root_form_with<V>(
        value: &RootNode,
        selected_form: u16,
        visitor: &mut V,
    ) -> Result<
        (),
        ::deckmaste_construction_compiler::runtime::LinearizationError<V::Error>,
    >
    where
        V: ::deckmaste_construction_compiler::runtime::LinearizationVisitor,
    {
        let RootNode {
            node,
            wrapped,
            boxed_wrapped,
            clause,
            boxed_clause,
            nodes,
            items,
        } = value;
        match selected_form {
            0 if !(matches!(node, Node::Unit)) => {
                Err(::deckmaste_construction_compiler::runtime::LinearizationError::NoMatchingForm {
                    construction: "root",
                })
            }
            0 => {
                visitor
                    .begin_form("root", "unit", 0)
                    .map_err(
                        ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
                    )?;
                __linearize_sum_node_with(node, "node", visitor)?;
                __linearize_product_wrapped_with(wrapped, "wrapped", visitor)?;
                __linearize_product_wrapped_with(
                    (boxed_wrapped).as_ref(),
                    "boxed_wrapped",
                    visitor,
                )?;
                visitor
                    .subtree("ClauseCategory", clause)
                    .map_err(
                        ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
                    )?;
                visitor
                    .projected_subtree(
                        "clause",
                        "ClauseCategory",
                        ::deckmaste_construction_compiler::runtime::projection_value(
                            clause,
                        ),
                    )
                    .map_err(
                        ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
                    )?;
                visitor
                    .subtree("ClauseCategory", (boxed_clause).as_ref())
                    .map_err(
                        ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
                    )?;
                visitor
                    .projected_subtree(
                        "boxed_clause",
                        "ClauseCategory",
                        ::deckmaste_construction_compiler::runtime::projection_value(
                            (boxed_clause).as_ref(),
                        ),
                    )
                    .map_err(
                        ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
                    )?;
                visitor
                    .begin_sequence("nodes", (nodes).len())
                    .map_err(
                        ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
                    )?;
                for (index, member) in (nodes).iter().enumerate() {
                    visitor
                        .sequence_member("nodes", index)
                        .map_err(
                            ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
                        )?;
                    visitor
                        .bound_value("node", member)
                        .map_err(
                            ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
                        )?;
                    visitor
                        .projected_bound_value(
                            "node",
                            ::deckmaste_construction_compiler::runtime::projection_input(
                                member,
                            ),
                        )
                        .map_err(
                            ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
                        )?;
                    match member {
                        Node::Unit => {
                            visitor
                                .element_variant("node", "Unit")
                                .map_err(
                                    ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
                                )?;
                        }
                        Node::Leaf(payload) => {
                            visitor
                                .element_variant("node", "Leaf")
                                .map_err(
                                    ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
                                )?;
                            visitor
                                .scalar("String", payload)
                                .map_err(
                                    ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
                                )?;
                            visitor
                                .projected_scalar(
                                    "node.payload",
                                    "String",
                                    ::deckmaste_construction_compiler::runtime::projection_value(
                                        payload,
                                    ),
                                )
                                .map_err(
                                    ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
                                )?;
                        }
                        Node::Pair(left, right) => {
                            visitor
                                .element_variant("node", "Pair")
                                .map_err(
                                    ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
                                )?;
                            __linearize_sum_node_with(
                                (left).as_ref(),
                                "node.left",
                                visitor,
                            )?;
                            __linearize_sum_node_with(
                                (right).as_ref(),
                                "node.right",
                                visitor,
                            )?;
                        }
                        Node::Named { label, child } => {
                            visitor
                                .element_variant("node", "Named")
                                .map_err(
                                    ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
                                )?;
                            visitor
                                .scalar("String", label)
                                .map_err(
                                    ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
                                )?;
                            visitor
                                .projected_scalar(
                                    "node.label",
                                    "String",
                                    ::deckmaste_construction_compiler::runtime::projection_value(
                                        label,
                                    ),
                                )
                                .map_err(
                                    ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
                                )?;
                            __linearize_sum_node_with(
                                (child).as_ref(),
                                "node.child",
                                visitor,
                            )?;
                        }
                    }
                }
                visitor
                    .end_sequence("nodes")
                    .map_err(
                        ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
                    )?;
                visitor
                    .begin_sequence("items", (items).len())
                    .map_err(
                        ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
                    )?;
                visitor
                    .sequence_member("items", 0usize)
                    .map_err(
                        ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
                    )?;
                visitor
                    .bound_value("item", (items).first())
                    .map_err(
                        ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
                    )?;
                visitor
                    .projected_bound_value(
                        "item",
                        ::deckmaste_construction_compiler::runtime::projection_input(
                            (items).first(),
                        ),
                    )
                    .map_err(
                        ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
                    )?;
                visitor
                    .scalar("String", &(items).first().value)
                    .map_err(
                        ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
                    )?;
                visitor
                    .projected_scalar(
                        "item.value",
                        "String",
                        ::deckmaste_construction_compiler::runtime::projection_value(
                            &(items).first().value,
                        ),
                    )
                    .map_err(
                        ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
                    )?;
                for (offset, continuation) in (items).rest().iter().enumerate() {
                    let index = offset + 1;
                    visitor
                        .sequence_member("items", index)
                        .map_err(
                            ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
                        )?;
                    visitor
                        .scalar("Separator", continuation.separator())
                        .map_err(
                            ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
                        )?;
                    visitor
                        .projected_scalar(
                            "items.separator",
                            "Separator",
                            ::deckmaste_construction_compiler::runtime::projection_value(
                                continuation.separator(),
                            ),
                        )
                        .map_err(
                            ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
                        )?;
                    visitor
                        .bound_value("item", continuation.value())
                        .map_err(
                            ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
                        )?;
                    visitor
                        .projected_bound_value(
                            "item",
                            ::deckmaste_construction_compiler::runtime::projection_input(
                                continuation.value(),
                            ),
                        )
                        .map_err(
                            ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
                        )?;
                    visitor
                        .scalar("String", &continuation.value().value)
                        .map_err(
                            ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
                        )?;
                    visitor
                        .projected_scalar(
                            "item.value",
                            "String",
                            ::deckmaste_construction_compiler::runtime::projection_value(
                                &continuation.value().value,
                            ),
                        )
                        .map_err(
                            ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
                        )?;
                }
                visitor
                    .end_sequence("items")
                    .map_err(
                        ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
                    )?;
                visitor
                    .end_form("root")
                    .map_err(
                        ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
                    )?;
                Ok(())
            }
            1 => {
                visitor
                    .begin_form("root", "other", 1)
                    .map_err(
                        ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
                    )?;
                __linearize_sum_node_with(node, "node", visitor)?;
                __linearize_product_wrapped_with(wrapped, "wrapped", visitor)?;
                __linearize_product_wrapped_with(
                    (boxed_wrapped).as_ref(),
                    "boxed_wrapped",
                    visitor,
                )?;
                visitor
                    .subtree("ClauseCategory", clause)
                    .map_err(
                        ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
                    )?;
                visitor
                    .projected_subtree(
                        "clause",
                        "ClauseCategory",
                        ::deckmaste_construction_compiler::runtime::projection_value(
                            clause,
                        ),
                    )
                    .map_err(
                        ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
                    )?;
                visitor
                    .subtree("ClauseCategory", (boxed_clause).as_ref())
                    .map_err(
                        ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
                    )?;
                visitor
                    .projected_subtree(
                        "boxed_clause",
                        "ClauseCategory",
                        ::deckmaste_construction_compiler::runtime::projection_value(
                            (boxed_clause).as_ref(),
                        ),
                    )
                    .map_err(
                        ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
                    )?;
                visitor
                    .begin_sequence("nodes", (nodes).len())
                    .map_err(
                        ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
                    )?;
                for (index, member) in (nodes).iter().enumerate() {
                    visitor
                        .sequence_member("nodes", index)
                        .map_err(
                            ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
                        )?;
                    visitor
                        .bound_value("node", member)
                        .map_err(
                            ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
                        )?;
                    visitor
                        .projected_bound_value(
                            "node",
                            ::deckmaste_construction_compiler::runtime::projection_input(
                                member,
                            ),
                        )
                        .map_err(
                            ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
                        )?;
                    match member {
                        Node::Unit => {
                            visitor
                                .element_variant("node", "Unit")
                                .map_err(
                                    ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
                                )?;
                        }
                        Node::Leaf(payload) => {
                            visitor
                                .element_variant("node", "Leaf")
                                .map_err(
                                    ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
                                )?;
                            visitor
                                .scalar("String", payload)
                                .map_err(
                                    ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
                                )?;
                            visitor
                                .projected_scalar(
                                    "node.payload",
                                    "String",
                                    ::deckmaste_construction_compiler::runtime::projection_value(
                                        payload,
                                    ),
                                )
                                .map_err(
                                    ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
                                )?;
                        }
                        Node::Pair(left, right) => {
                            visitor
                                .element_variant("node", "Pair")
                                .map_err(
                                    ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
                                )?;
                            __linearize_sum_node_with(
                                (left).as_ref(),
                                "node.left",
                                visitor,
                            )?;
                            __linearize_sum_node_with(
                                (right).as_ref(),
                                "node.right",
                                visitor,
                            )?;
                        }
                        Node::Named { label, child } => {
                            visitor
                                .element_variant("node", "Named")
                                .map_err(
                                    ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
                                )?;
                            visitor
                                .scalar("String", label)
                                .map_err(
                                    ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
                                )?;
                            visitor
                                .projected_scalar(
                                    "node.label",
                                    "String",
                                    ::deckmaste_construction_compiler::runtime::projection_value(
                                        label,
                                    ),
                                )
                                .map_err(
                                    ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
                                )?;
                            __linearize_sum_node_with(
                                (child).as_ref(),
                                "node.child",
                                visitor,
                            )?;
                        }
                    }
                }
                visitor
                    .end_sequence("nodes")
                    .map_err(
                        ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
                    )?;
                visitor
                    .begin_sequence("items", (items).len())
                    .map_err(
                        ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
                    )?;
                visitor
                    .sequence_member("items", 0usize)
                    .map_err(
                        ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
                    )?;
                visitor
                    .bound_value("item", (items).first())
                    .map_err(
                        ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
                    )?;
                visitor
                    .projected_bound_value(
                        "item",
                        ::deckmaste_construction_compiler::runtime::projection_input(
                            (items).first(),
                        ),
                    )
                    .map_err(
                        ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
                    )?;
                visitor
                    .scalar("String", &(items).first().value)
                    .map_err(
                        ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
                    )?;
                visitor
                    .projected_scalar(
                        "item.value",
                        "String",
                        ::deckmaste_construction_compiler::runtime::projection_value(
                            &(items).first().value,
                        ),
                    )
                    .map_err(
                        ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
                    )?;
                for (offset, continuation) in (items).rest().iter().enumerate() {
                    let index = offset + 1;
                    visitor
                        .sequence_member("items", index)
                        .map_err(
                            ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
                        )?;
                    visitor
                        .scalar("Separator", continuation.separator())
                        .map_err(
                            ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
                        )?;
                    visitor
                        .projected_scalar(
                            "items.separator",
                            "Separator",
                            ::deckmaste_construction_compiler::runtime::projection_value(
                                continuation.separator(),
                            ),
                        )
                        .map_err(
                            ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
                        )?;
                    visitor
                        .bound_value("item", continuation.value())
                        .map_err(
                            ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
                        )?;
                    visitor
                        .projected_bound_value(
                            "item",
                            ::deckmaste_construction_compiler::runtime::projection_input(
                                continuation.value(),
                            ),
                        )
                        .map_err(
                            ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
                        )?;
                    visitor
                        .scalar("String", &continuation.value().value)
                        .map_err(
                            ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
                        )?;
                    visitor
                        .projected_scalar(
                            "item.value",
                            "String",
                            ::deckmaste_construction_compiler::runtime::projection_value(
                                &continuation.value().value,
                            ),
                        )
                        .map_err(
                            ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
                        )?;
                }
                visitor
                    .end_sequence("items")
                    .map_err(
                        ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
                    )?;
                visitor
                    .end_form("root")
                    .map_err(
                        ::deckmaste_construction_compiler::runtime::LinearizationError::Visitor,
                    )?;
                Ok(())
            }
            _ => {
                Err(::deckmaste_construction_compiler::runtime::LinearizationError::NoMatchingForm {
                    construction: "root",
                })
            }
        }
    }
    fn __erased_field_root_nodes(
