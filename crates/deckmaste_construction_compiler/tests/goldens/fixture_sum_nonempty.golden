                })?;
            let value: Item = ::deckmaste_construction_compiler::runtime::take_erased(
                &mut values,
                "root",
                "items",
                stringify!(Item),
            )?;
            rest.push(
                ::deckmaste_construction_compiler::runtime::Separated::new(
                    separator,
                    value,
                ),
            );
        }
        Ok(
            Box::new(
