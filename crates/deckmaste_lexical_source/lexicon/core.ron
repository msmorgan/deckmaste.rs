// V3 lexical declarations. Lexemes follow the supported-corpus pruning rule;
// surviving forms and frames remain declared linguistic data.
(
    // Attested adjective hosts share joined negative-prefix formation.
    // World has an ordinary adjective declaration without a negative Lexeme.
    // Legendary keeps its existing adjective owner and Catalog entry.
    adjective_classes: [(
        negative_prefix_join: Joined,
        members: [
            "vocab:Supertype/Basic", "vocab:PredicativeAdjective/Legendary",
            "vocab:Supertype/Snow",
            "vocab:ColorWord/Black", "vocab:ColorWord/Red", "vocab:ColorWord/White",
            "vocab:ColorWord/Green", "vocab:ColorWord/Blue",
        ],
    )],
    // Attested common nouns declare their own negative formation.
    negative_noun_formations: {"lexeme:CommonNoun/Token": Joined},
    participial_adjective_classes: [(
        features: {"AdjectiveOrigin": "Participial"},
        form: PastParticiple,
        members: ["lexeme:keyword_action/tap", "lexeme:keyword_action/untap", "core-verb:Block"],
    )],
    // Oracle compound nouns use declared noun-head recipes.
    compound_noun_classes: [(
        head: "lexeme:CommonNoun/Ability", stem_structure: Word,
        members: [(owner: "lexeme:CommonNoun/ManaAbility", stem: "mana")],
    ), (
        head: "lexeme:CommonNoun/Size", stem_structure: Word,
        members: [(owner: "lexeme:CommonNoun/HandSize", stem: "hand")],
    ), (
        head: "lexeme:CommonNoun/Counter", stem_structure: Word,
        members: [(owner: "lexeme:CommonNoun/NecrodermisCounter", stem: "necrodermis")],
    ), (
        head: "lexeme:CommonNoun/Counter",
        stem_structure: Measure,
        stem_onset: Some(Consonant),
        members: [
            (owner: "lexeme:counter_kind_numeric/P1P0", stem: "+1/+0"),
            (owner: "lexeme:counter_kind_numeric/P2P2", stem: "+2/+2"),
            (owner: "lexeme:counter_kind_numeric/M0M1", stem: "-0/-1"),
            (owner: "lexeme:counter_kind_numeric/P0P1", stem: "+0/+1"),
            (owner: "lexeme:counter_kind_numeric/M0M2", stem: "-0/-2"),
            (owner: "lexeme:counter_kind_numeric/M2M2", stem: "-2/-2"),
            (owner: "lexeme:counter_kind_numeric/P0P2", stem: "+0/+2"),
            (owner: "lexeme:counter_kind_numeric/P1P2", stem: "+1/+2"),
            (owner: "lexeme:counter_kind_numeric/M2M1", stem: "-2/-1"),
            (owner: "lexeme:counter_kind_numeric/M1M0", stem: "-1/-0"),
        ],
    )],
    category_feature_defaults: {
        Keyword: {"KeywordMarker": "None", "KeywordSeparator": "Space", "KeywordParameterSeparator": "Space", "KeywordQualityNumber": "Any", "KeywordPayloadOrder": "AfterHead", "BoundKeyword": "No"},
        Noun: {"NominalBareClass": "None", "NominalAdjunctClass": "None"},
        Preposition: {"KeywordMarker": "None", "NominalBareClass": "None"},
        Determinative: {"NominalAdjunctDependent": "None"},
        Adjective: {"BareSingularUse": "No"},
        Pronoun: {"RelativeUse": "No"},
    },
    feature_additions: {
        // GC1–GC2: each Object + goal tail selects a complete declared frame.
        "core-verb:Put": {"SelectedTailLicence": "DeclaredFrames"},
        "lexeme:keyword_ability/exploit/verb": {"PastParticipialPremodifier": "Yes"},
        "core-verb:Lock": {"PastParticipialPremodifier": "Yes"},
        "lexeme:designation/commander": {"NounPremodifier": "Yes"},
        "lexeme:keyword_action/goad": {"PastParticipialPremodifier": "Yes"},
        "lexeme:keyword_action/suspect": {"PastParticipialPremodifier": "Yes"},
        // Corpus agreement: the full-name Subject takes “enter or attack”.
        "catalog:card-names.txt/Aang and Katara": {"NameNumber": "Plural"},
        // Project analysis: declared exception distributions in Oracle English.
        "lexeme:keyword_action/create": {"MatrixComplementLicence": "Content"},
        "core-verb:Copy": {"MatrixComplementLicence": "Content"},
        "core-verb:Become": {"MatrixComplementLicence": "Content"},
        "core-verb:Enter": {"MatrixComplementLicence": "Content"},
        "lexeme:keyword_action/sacrifice": {"MatrixComplementLicence": "Nominal", "PastParticipialPremodifier": "Yes"},
        "lexeme:keyword_action/destroy": {"MatrixComplementLicence": "Nominal"},
        "core-verb:Return": {"MatrixComplementLicence": "Nominal"},
        "core-verb:Deal": {"MatrixComplementLicence": "Nominal"},
        "core-verb:Have": {"PurposeAdjunctLicence": "No"},
        // Oracle-register stative exclusion: orchestrator ruling 2026-10-08.
        "core-verb:Be": {"PurposeAdjunctLicence": "No", "AuxiliaryUse": "Yes", "CentralAdjunctPosition": "PostCopula"},
        "core-verb:BeNegative": {"PurposeAdjunctLicence": "No", "CentralAdjunctPosition": "PostCopula"},
        "core-verb:BeContracted": {"PurposeAdjunctLicence": "No", "CentralAdjunctPosition": "PostCopula"},
        "core-verb:Remain": {"PurposeAdjunctLicence": "No"},
        "core-verb:Control": {"PurposeAdjunctLicence": "No"},
        "core-verb:Own": {"PurposeAdjunctLicence": "No"},
        "core-verb:Share": {"PurposeAdjunctLicence": "No"},
        // Project analysis: cost-scalar-complement requires its hollow Complement.
        "core-verb:Cost": {"PurposeAdjunctLicence": "No"},
