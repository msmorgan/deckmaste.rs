// V3 lexical declarations. Lexemes follow the supported-corpus pruning rule;
// surviving forms and frames remain declared linguistic data.
(
    // Attested adjective hosts share joined negative-prefix formation.
    // World has an ordinary adjective declaration without a negative Lexeme.
    // Legendary keeps its existing adjective owner and Catalog entry.
    adjective_classes: [(
        negative_prefix_join: Joined,
        members: [
            "vocab:Supertype/Basic", "vocab:PredicativeAdjective/Legendary",
            "vocab:Supertype/Snow",
            "vocab:ColorWord/Black", "vocab:ColorWord/Red", "vocab:ColorWord/White",
            "vocab:ColorWord/Green", "vocab:ColorWord/Blue",
        ],
    )],
    participial_adjective_classes: [(
        form: PastParticiple,
        members: ["lexeme:keyword_action/tap", "lexeme:keyword_action/untap", "core-verb:Block"],
    )],
    // Oracle compound nouns use declared noun-head recipes.
    compound_noun_classes: [(
        head: "lexeme:CommonNoun/Size", stem_structure: Word,
        members: [(owner: "lexeme:CommonNoun/HandSize", stem: "hand")],
    ), (
        head: "lexeme:CommonNoun/Counter", stem_structure: Word,
        members: [(owner: "lexeme:CommonNoun/NecrodermisCounter", stem: "necrodermis")],
    ), (
        head: "lexeme:CommonNoun/Counter",
        stem_structure: Measure,
        stem_onset: Some(Consonant),
        members: [
            (owner: "lexeme:counter_kind_numeric/P1P0", stem: "+1/+0"),
            (owner: "lexeme:counter_kind_numeric/P2P2", stem: "+2/+2"),
            (owner: "lexeme:counter_kind_numeric/M0M1", stem: "-0/-1"),
            (owner: "lexeme:counter_kind_numeric/P0P1", stem: "+0/+1"),
            (owner: "lexeme:counter_kind_numeric/M0M2", stem: "-0/-2"),
            (owner: "lexeme:counter_kind_numeric/M2M2", stem: "-2/-2"),
            (owner: "lexeme:counter_kind_numeric/P0P2", stem: "+0/+2"),
            (owner: "lexeme:counter_kind_numeric/P1P2", stem: "+1/+2"),
            (owner: "lexeme:counter_kind_numeric/M2M1", stem: "-2/-1"),
            (owner: "lexeme:counter_kind_numeric/M1M0", stem: "-1/-0"),
        ],
    )],
    category_feature_defaults: {
        Keyword: {"KeywordMarker": "None", "KeywordSeparator": "Space", "KeywordParameterSeparator": "Space", "KeywordQualityNumber": "Any", "KeywordPayloadOrder": "AfterHead", "BoundKeyword": "No"},
        Noun: {"NominalBareClass": "None", "NominalAdjunctClass": "None"},
        Preposition: {"KeywordMarker": "None", "NominalBareClass": "None"},
        Determinative: {"NominalAdjunctDeterminer": "None"},
        Adjective: {"BareSingularUse": "No"},
        Pronoun: {"RelativeUse": "No"},
    },
    feature_additions: {
        "vocab:AttributiveAdjective/Other": {"TargetingPremodifierUse": "Yes"},
        "core-verb:Do": {"AuxiliaryEllipsisLicence": "Yes"},
