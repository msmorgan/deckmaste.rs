// Twin of Spec.idr `tBadModalEmptyModes`: a modal effect must offer a mode
// [CR#700.2]. (`up_to` keeps the count floor out of the way: this fixture
// pins the emptiness rule alone.)
Normal(
  name: "Reject Empty Modal",
  types: [Sorcery],
  abilities: [
    Spell(effect: Modal(
      choose: (count: Exactly(1), up_to: true),
      modes: [],
    )),
  ],
)
