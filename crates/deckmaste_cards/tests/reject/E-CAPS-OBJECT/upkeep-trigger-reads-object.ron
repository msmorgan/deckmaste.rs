// Twin of Spec.idr `tBadEventObjectNoObject`: "that card" in a step-begin
// body — a BeginningOf event supplies no object [CR#603.2e,608.2k].
Normal(
  name: "Reject Upkeep Object",
  types: [Enchantment],
  abilities: [
    Triggered(
      event: BeginningOf(Beginning(Upkeep), Your),
      effect: Move(EventObject, Exile),
    ),
  ],
)
