// Twin of Spec.idr `tBadEventActorMultiKind`: a multi-pattern event guarantees
// only the MEET — Cast supplies an actor, Destroy doesn't, so the disjunction
// supplies none [CR#603.2c,608.2k].
Normal(
  name: "Reject Multikind Actor",
  types: [Enchantment],
  abilities: [
    Triggered(
      event: OneOf([Performed(verb: "Cast"), Performed(verb: "Destroy")]),
      effect: By(EventActor, LoseLife(1)),
    ),
  ],
)
