// Two announce slots sharing one `As` name [CR#608.2d] — the labeled read
// `The("target")` would be a guess between them, so the duplicate is refused
// at the announce list itself (cards-fidelity-target-sunset's announce-list
// labeling story keeps labeled reads never-a-guess by construction).
Normal(
  name: "Reject Duplicate Announce Label",
  types: [Sorcery],
  abilities: [
    Spell(effect: Targeted(
      targets: [
        As("target", TargetOne(Creature)),
        As("target", TargetOne(Creature)),
      ],
      effect: Fight(The("target"), The("target")),
    )),
  ],
)
