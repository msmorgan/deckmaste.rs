// Phasing deltas ([CR#702.26b]) have no fact shape yet (P0.W6). KEPT cap
// under engine-one-evaluator: nothing emits the transition, so a pattern
// watching it could only silently never fire.
Normal(
  name: "Reject Bridge Phased",
  types: [Enchantment],
  abilities: [
    Triggered(
      event: StateBecame(of: Ref(This), becomes: Phased(Out)),
      effect: GainLife(1),
    ),
  ],
)
