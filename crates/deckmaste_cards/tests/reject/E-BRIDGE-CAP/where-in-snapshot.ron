// `Filter::Where` on the spine of a snapshot-evaluated slot
// (`ZoneChange.what` — the moved object is matched by LKI, [CR#603.10a]):
// load-capped until engine-one-evaluator.
Normal(
  name: "Reject Bridge Where Snapshot",
  types: [Enchantment],
  abilities: [
    Triggered(
      event: ZoneChange(
        what: AllOf([Type(Creature), Where(YourTurn)]),
        from: Battlefield,
        to: Graveyard,
      ),
      effect: GainLife(1),
    ),
  ],
)
