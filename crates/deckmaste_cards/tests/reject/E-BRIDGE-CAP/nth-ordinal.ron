// `Nth` (the Erayo-family ordinal, [CR#603.2g]) is beyond the bridge
// matchers: load-capped until engine-one-evaluator.
Normal(
  name: "Reject Bridge Nth",
  types: [Enchantment],
  abilities: [
    Triggered(
      event: Nth(n: 2, of: Cast(who: Ref(You)), within: ThisTurn),
      effect: Draw(1),
    ),
  ],
)
