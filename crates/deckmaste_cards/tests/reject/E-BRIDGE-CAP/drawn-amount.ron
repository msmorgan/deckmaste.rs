// Cards are drawn one at a time ([CR#121.2]) — a multi-draw is N facts,
// so a per-fact amount bound has nothing to compare against. KEPT cap
// under engine-one-evaluator (CR-grounded granularity): a multi-card draw
// view is batch/aggregation semantics, not a per-fact bound.
Normal(
  name: "Reject Bridge Drawn Amount",
  types: [Enchantment],
  abilities: [
    Triggered(
      event: Drawn(who: Ref(You), amount: AtLeast(2)),
      effect: GainLife(1),
    ),
  ],
)
