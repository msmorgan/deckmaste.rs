// The `SinceYourLastUpkeep` family ([CR#603.2b,608.2i]) needs a
// watcher-relative window derivation over the recorded step markers. KEPT
// cap under engine-one-evaluator (engine-history-windows): `StepBegan`
// facts are in the log now, but no window derivation consumes them yet.
Normal(
  name: "Reject Bridge Since Your",
  types: [Enchantment],
  abilities: [
    Triggered(
      event: ThisEnters,
      condition: Happened(
        event: Used(of: This),
        within: SinceYour(Beginning(Upkeep)),
      ),
      effect: GainLife(1),
    ),
  ],
)
