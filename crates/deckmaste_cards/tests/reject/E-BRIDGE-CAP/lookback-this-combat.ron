// Sub-turn history windows ([CR#506.1,608.2i]) need a window derivation
// over the recorded step markers. KEPT cap under engine-one-evaluator
// (engine-history-windows): `StepBegan` facts are in the log now, but no
// window derivation consumes them yet.
Normal(
  name: "Reject Bridge This Combat",
  types: [Enchantment],
  abilities: [
    Triggered(
      event: ThisEnters,
      condition: Happened(event: AttackDeclared(by: Type(Creature)), within: ThisCombat),
      effect: GainLife(1),
    ),
  ],
)
