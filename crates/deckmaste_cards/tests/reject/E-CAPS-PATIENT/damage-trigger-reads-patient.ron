// The `Facet.Patient` free-kind hole, not inherited: every emitted caps row
// carries the patient kind the event actually FIXES — DealDamage fixes none,
// so an `EventPatient` read under it is refused [CR#120.3,608.2k].
Normal(
  name: "Reject Damage Patient",
  types: [Enchantment],
  abilities: [
    Triggered(
      event: Performed(verb: "DealDamage"),
      effect: Destroy(EventPatient),
    ),
  ],
)
