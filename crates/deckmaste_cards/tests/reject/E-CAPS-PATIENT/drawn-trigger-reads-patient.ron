// The `Facet.Patient` free-kind hole, not inherited: every emitted caps row
// carries the patient kind the event actually FIXES — a draw acts on no
// patient, so an `EventPatient` read under it is refused [CR#120.3,608.2k].
Normal(
  name: "Reject Drawn Patient",
  types: [Enchantment],
  abilities: [
    Triggered(
      event: Drawn(who: Ref(You)),
      effect: Destroy(EventPatient),
    ),
  ],
)
