// A `SeparatePiles` with an EMPTY label list separates into nothing — the
// pile-shape floor ([CR#700.3]; piles themselves may be empty, [CR#700.3d],
// but the label list may not be).
Normal(
  name: "Reject No Pile Labels",
  types: [Sorcery],
  abilities: [
    Spell(effect: SeparatePiles(
      group: TopOfLibrary(count: 5),
      into: [],
      by: Opponent,
    )),
  ],
)
