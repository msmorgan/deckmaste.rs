// A `ChoosePile` with an EMPTY label list has nothing to choose from — the
// same pile-shape floor `SeparatePiles`'s empty-label twin pins
// ([CR#700.3]; `reject/E-FLOOR-PILES/no-pile-labels.ron`).
Normal(
  name: "Reject Choose Pile No Labels",
  types: [Sorcery],
  abilities: [
    Spell(effect: ChoosePile(
      from: Labels([]),
      then: Sequence([]),
    )),
  ],
)
