// The entailment table as a consistency check: Sacrifice entails
// from: Battlefield [CR#701.21a], so a from: Library pattern narrowed by it
// can never match [CR#603.2g].
Normal(
  name: "Reject Entailment Contradiction",
  types: [Enchantment],
  abilities: [
    Triggered(
      event: ZoneChange(what: Any, from: Library, cause: Cause(verb: Sacrifice)),
      effect: GainLife(1),
    ),
  ],
)
