// `Within` is a history refinement — vacuous against the live fact a
// trigger matches, so the live lanes refuse it [CR#603.2].
Normal(
  name: "Reject Trigger Within",
  types: [Enchantment],
  abilities: [
    Triggered(
      event: Within(ThisEnters, ThisTurn),
      effect: GainLife(1),
    ),
  ],
)
