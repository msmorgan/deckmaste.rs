// The stack is never a Move destination: objects reach it only by being cast,
// activated, or triggering ([CR#405.1]) — `Move(This, Stack)` is refused with
// E-FLOOR-DESTINATION.
Normal(
  name: "Reject Stack Destination",
  types: [Sorcery],
  abilities: [
    Spell(effect: Move(This, Stack)),
  ],
)
