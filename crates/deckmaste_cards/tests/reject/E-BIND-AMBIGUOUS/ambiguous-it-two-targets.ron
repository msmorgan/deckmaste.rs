Normal(
  name: "Reject Ambiguous It",
  types: [Sorcery],
  abilities: [
    Spell(effect: Targeted(
      targets: [TargetOne(Creature), TargetOne(Type(Artifact))],
      effect: Destroy(It),
    )),
  ],
)
