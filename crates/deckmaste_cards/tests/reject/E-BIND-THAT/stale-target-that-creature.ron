// The signature fixture's pinned load-error twin ([CR#603.7c]): the
// `Delayed` body drops the announced target, and the exile clause's product
// answers to "card" (it sits in exile), NOT "creature" — `That(Creature)`
// has no compatible antecedent. Twin of Spec.idr's `tBadDelayedTarget`
// failing block.
Normal(
  name: "Reject Stale Target That Creature",
  types: [Instant],
  abilities: [
    Spell(effect: Targeted(
      targets: [TargetOne(Creature)],
      effect: Sequence([
        Move(It, Exile),
        Delayed(
          event: StepBegins(at: Ending(End), whose: EachPlayers),
          effect: Move(That(Creature), Battlefield),
        ),
      ]),
    )),
  ],
)
