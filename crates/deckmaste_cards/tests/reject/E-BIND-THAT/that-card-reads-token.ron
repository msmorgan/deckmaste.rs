// Twin of Spec.idr `tBadTokenIsNotCard`: tokens aren't cards ([CR#108.2b]) —
// "that card" never reaches a token antecedent, the compat table's most
// load-bearing closed pair.
Normal(
  name: "Reject That Card Reads Token",
  types: [Sorcery],
  abilities: [
    Spell(effect: Sequence([
      Create(1, Token(types: [Creature])),
      Move(That(Card), Exile),
    ])),
  ],
)
