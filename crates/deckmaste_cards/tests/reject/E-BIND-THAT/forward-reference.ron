// R3 (no forward references): resolution is strictly leftward — a clause
// cannot read the product of a clause to its RIGHT ([CR#608.2d]; the
// telescope threads introductions left-to-right only).
Normal(
  name: "Reject Forward Reference",
  types: [Sorcery],
  abilities: [
    Spell(effect: Sequence([
      Move(That(Card), Battlefield),
      Move(This, Exile),
    ])),
  ],
)
