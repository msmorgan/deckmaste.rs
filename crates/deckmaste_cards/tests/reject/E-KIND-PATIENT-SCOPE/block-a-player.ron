// A Block deed whose PATIENT is a player: a blocked thing is an attacking
// CREATURE ([CR#509.1a]) — the emitted `patientScope` row fixes the Block
// patient at Object, so a player-kinded `on` can never match.
Normal(
  name: "Reject Block A Player",
  types: [Creature],
  abilities: [
    Static(Cant(Block(by: Ref(This), on: Kind(Player)))),
  ],
  power: 1,
  toughness: 1,
)
