// Dividing 1 among at least 2 recipients — each element must receive >= 1
// [CR#601.2d].
Normal(
  name: "Reject Divide Short",
  types: [Sorcery],
  abilities: [
    Spell(effect: DivideAmong(
      amount: 1,
      binder: Choose(quantity: Exactly(2), filter: Creature),
      body: DealDamage(It, Allotment),
    )),
  ],
)
