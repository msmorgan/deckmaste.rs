// Kind-pass rule (a): Not's OPERAND must itself bottom out in master forms —
// a double negation never does [CR#603.2]. The AllOf carries a real anchor,
// so only the operand rule trips.
Normal(
  name: "Reject Double Negation",
  types: [Enchantment],
  abilities: [
    Triggered(
      event: AllOf([ThisEnters, Not(Not(ThisEnters))]),
      effect: GainLife(1),
    ),
  ],
)
