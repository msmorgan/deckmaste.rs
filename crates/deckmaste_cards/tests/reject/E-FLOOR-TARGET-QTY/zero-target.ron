// Twin of Spec.idr `tBadZeroTarget`: a target slot can't target ZERO things
// [CR#115.1].
Normal(
  name: "Reject Zero Target",
  types: [Sorcery],
  abilities: [
    Spell(effect: Targeted(
      targets: [Target(Exactly(0), Creature)],
      effect: Each(binder: Existing(They), effect: Destroy(It)),
    )),
  ],
)
