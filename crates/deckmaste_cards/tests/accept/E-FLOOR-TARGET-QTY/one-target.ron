// Accept twin of reject/E-FLOOR-TARGET-QTY/zero-target.ron: a target slot
// that can target at least one thing [CR#115.1].
Normal(
  name: "Accept Nonzero Target",
  types: [Sorcery],
  abilities: [
    Spell(effect: Targeted(
      targets: [Target(Exactly(1), Creature)],
      effect: Destroy(Target(0)),
    )),
  ],
)
