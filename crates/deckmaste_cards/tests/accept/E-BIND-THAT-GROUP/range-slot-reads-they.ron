// The Forked-Bolt shape ([CR#601.2d]): a range target slot pushes a MANY
// antecedent — `They` reads the group, `DivideAmong` iterates it with the
// per-element `It` + `Allotment` share.
Normal(
  name: "Accept Range Slot Reads They",
  types: [Sorcery],
  abilities: [
    Spell(effect: Targeted(
      targets: [Target(Between(1, 2), AnyTarget)],
      effect: DivideAmong(
        amount: 2,
        binder: Existing(They),
        body: DealDamage(It, Allotment),
      ),
    )),
  ],
)
