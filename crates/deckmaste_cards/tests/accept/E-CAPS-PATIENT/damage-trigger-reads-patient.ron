// Accept twin of reject/E-CAPS-PATIENT/drawn-trigger-reads-patient.ron:
// `EventPatient` off an event that DOES fix a patient — the Damage master
// form's recipient, kind-poly ([CR#120.3] "a player or permanent").
Normal(
  name: "Accept Damage Patient",
  types: [Enchantment],
  abilities: [
    Triggered(
      event: Damage(source: Ref(This)),
      effect: Destroy(EventPatient),
    ),
  ],
)
