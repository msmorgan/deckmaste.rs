// Accept twin of reject/E-KIND-DESIGNATION-SCOPE/monstrous-on-player.ron:
// `GetDesignation` always targets the acting player — Monarch (unlike
// Monstrous) IS a player designation [CR#109.3,701.37b].
Normal(
  name: "Accept Monarch Player",
  types: [Sorcery],
  abilities: [
    Spell(effect: GetDesignation("Monarch")),
  ],
)
