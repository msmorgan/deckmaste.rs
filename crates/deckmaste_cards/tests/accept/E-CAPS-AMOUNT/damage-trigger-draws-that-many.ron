// Accept twin of reject/E-CAPS-AMOUNT/enters-trigger-draws-that-many.ron:
// "draw that many" off an event that DOES carry a numeric amount — dealt
// damage [CR#107.3,608.2i].
Normal(
  name: "Accept Damage That Many",
  types: [Enchantment],
  abilities: [
    Triggered(
      event: Damage(),
      effect: Draw(ThatMuch),
    ),
  ],
)
