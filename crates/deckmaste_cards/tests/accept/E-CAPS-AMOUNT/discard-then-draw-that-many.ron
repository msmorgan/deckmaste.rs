// The telescope's amount antecedent ([CR#608.2i]): the discard clause fixes
// the card count, and the next clause's `ThatMany` reads it — "discards
// …, then draws that many cards" in sentence order.
Normal(
  name: "Accept Discard Then Draw That Many",
  types: [Sorcery],
  abilities: [
    Spell(effect: Sequence([
      Discard(count: 2),
      Draw(ThatMany),
    ])),
  ],
)
