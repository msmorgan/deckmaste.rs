// Accept twin of reject/E-FLOOR-DESTINATION/*: an ordered-zone placement
// spelled the legal way — `Library(Anchor)` — and the group-arrangement
// acceptance shape: Brainstorm's "put two cards from your hand on top of your
// library in any order" = `MoveGroup(group: They, arrangement: AnyOrder,
// to: Library(FromTop(0)))` ([CR#401.4,401.7]).
Normal(
  name: "Accept Group Arrangement",
  types: [Instant],
  abilities: [
    Spell(effect: Sequence([
      Draw(3),
      With(
        binder: Choose(quantity: Exactly(2), filter: AllOf([InZone(Hand), Owner(Ref(You))])),
        body: MoveGroup(group: They, arrangement: AnyOrder, to: Library(FromTop(0))),
      ),
    ])),
  ],
)
