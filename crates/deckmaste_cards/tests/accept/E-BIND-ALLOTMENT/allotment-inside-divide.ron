// Accept twin of reject/E-BIND-ALLOTMENT/allotment-outside-divide.ron:
// `Allotment` read INSIDE a `DivideAmong` body resolves to the per-recipient
// share [CR#601.2d]. Also doubles as E-FLOOR-DIVIDE's accept twin: 2 divided
// among exactly 2 recipients meets the minimum.
Normal(
  name: "Accept Allotment Bound",
  types: [Sorcery],
  abilities: [
    Spell(effect: DivideAmong(
      amount: 2,
      binder: Choose(quantity: Exactly(2), filter: Creature),
      body: DealDamage(It, Allotment),
    )),
  ],
)
