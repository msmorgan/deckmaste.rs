// The Lightning-Bolt shape: with no loop binder in scope, `It` is the
// wildcard singular anaphor — slot 0's antecedent is the unique candidate
// ([CR#115.3]; the one spelling since the Target(n) sunset).
Normal(
  name: "Accept Bolt It Reads Target",
  types: [Instant],
  abilities: [
    Spell(effect: Targeted(
      targets: [TargetOne(Creature)],
      effect: DealDamage(It, 3),
    )),
  ],
)
