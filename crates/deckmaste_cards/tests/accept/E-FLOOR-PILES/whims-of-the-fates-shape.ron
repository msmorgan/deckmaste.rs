// The all-players-pile-then-all-players-sacrifice shape (Whims of the
// Fates, [CR#700.3]): per-player piles persist as NOTED groups keyed by
// (note, label, divider) — every player separates before any player
// sacrifices (the oracle's "Then" = the two loops), and loop 2 reads loop
// 1's piles back via `Noted { note, of }` + the chosen pile as
// `Them(Pile)`.
Normal(
  name: "Accept Whims Of The Fates Shape",
  types: [Sorcery],
  abilities: [
    Spell(effect: Sequence([
      Each(
        binder: Existing(SelectAll(Kind(Player))),
        effect: SeparatePiles(
          group: SelectAll(AllOf([InZone(Battlefield), ControlledBy(Ref(It))])),
          into: ["a", "b", "c"],
          by: It,
          note: "whims",
        ),
      ),
      Each(
        binder: Existing(SelectAll(Kind(Player))),
        effect: ChoosePile(
          from: Noted(note: "whims", of: It),
          by: It,
          random: true,
          then: Each(binder: Existing(Them(Pile)), effect: Sacrifice(It)),
        ),
      ),
    ])),
  ],
)
