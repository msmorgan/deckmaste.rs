// Accept twin of reject/E-FLOOR-DIVIDE/divide-one-among-two.ron: dividing 2
// among at least 2 recipients meets the minimum [CR#601.2d].
Normal(
  name: "Accept Divide Enough",
  types: [Sorcery],
  abilities: [
    Spell(effect: DivideAmong(
      amount: 2,
      binder: Choose(quantity: Exactly(2), filter: Creature),
      body: DealDamage(It, Allotment),
    )),
  ],
)
