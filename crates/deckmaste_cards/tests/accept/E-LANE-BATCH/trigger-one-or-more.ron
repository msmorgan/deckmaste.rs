// Accept twin of reject/E-LANE-BATCH/happened-one-or-more.ron: `OneOrMore`
// in a TRIGGER lane — "whenever one or more creatures die" fires once per
// batch [CR#603.2c]; the operand's caps pass through (kind-pass rule (b)),
// so the event object still binds.
Normal(
  name: "Accept Batch Trigger",
  types: [Enchantment],
  abilities: [
    Triggered(
      event: OneOrMore(Dies(Creature)),
      effect: Move(EventObject, Exile),
    ),
  ],
)
