// Accept twin of reject/E-CAPS-DEFENDER/enters-trigger-reads-defender.ron:
// `DefendingPlayer` off a combat onset that DOES supply one — becoming
// blocked [CR#506.2,508.5], the same event shape as
// plugins/canon/cards/Deepwood Tantiv.ron.
Normal(
  name: "Accept Blocked Defender",
  types: [Enchantment],
  abilities: [
    Triggered(
      event: BlockDeclared(of: Ref(This)),
      effect: By(DefendingPlayer, LoseLife(1)),
    ),
  ],
)
