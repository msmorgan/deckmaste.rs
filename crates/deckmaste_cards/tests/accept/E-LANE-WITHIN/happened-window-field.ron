// Accept twin of reject/E-LANE-WITHIN/trigger-within.ron: history counting
// under a HISTORY lane — `Happened` scans the log with its required window
// FIELD [CR#608.2i]. (The pattern-level `Within` refinement is
// bridge-capped — E-BRIDGE-CAP — until engine-one-evaluator; the window
// field is the admitted spelling.) The trigger's own event supplies the
// object binding.
Normal(
  name: "Accept Happened Window",
  types: [Enchantment],
  abilities: [
    Triggered(
      event: ThisEnters,
      condition: Happened(
        event: LifeGained(who: Ref(You)),
        within: ThisTurn,
      ),
      effect: Move(EventObject, Exile),
    ),
  ],
)
