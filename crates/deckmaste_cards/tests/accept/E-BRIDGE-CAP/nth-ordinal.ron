// Formerly reject/E-BRIDGE-CAP/nth-ordinal.ron: `Nth` (the Erayo-family
// ordinal, [CR#603.2g]) was beyond the bridge matchers.
// engine-one-evaluator counts the ordinal off the history log (the fact is
// recorded before the scan runs), so the row lifted and the fixture
// flipped to the admitted side.
Normal(
  name: "Accept Bridge Nth",
  types: [Enchantment],
  abilities: [
    Triggered(
      event: Nth(n: 2, of: Cast(who: Ref(You)), within: ThisTurn),
      effect: Draw(1),
    ),
  ],
)
