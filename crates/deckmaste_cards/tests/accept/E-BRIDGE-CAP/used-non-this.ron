// Formerly reject/E-BRIDGE-CAP/used-non-this.ron: the bridge resolved
// `Used.of` only through the watching object (the self-scoped `This`).
// engine-one-evaluator resolves bound references through the consumer's
// frame ([CR#400.7,608.2i]; E-BIND guarantees the binder), so the row
// lifted and the fixture flipped to the admitted side.
Normal(
  name: "Accept Bridge Used Ref",
  types: [Sorcery],
  abilities: [
    Spell(effect: With(
      binder: ChooseOne(filter: Creature, by: You),
      body: Delayed(
        event: Used(of: That(Permanent)),
        effect: GainLife(1),
      ),
    )),
  ],
)
