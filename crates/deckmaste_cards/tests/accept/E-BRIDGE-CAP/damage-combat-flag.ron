// Formerly reject/E-BRIDGE-CAP/damage-combat-flag.ron: the `combat:` narrow
// ([CR#510.1]) was load-capped while `DamageDealt` carried no combat flag.
// engine-fact-record-batch grew the fact-record flag and the matcher arms
// (live/would/history), so the row lifted and the fixture flipped to the
// admitted side.
Normal(
  name: "Accept Bridge Combat",
  types: [Enchantment],
  abilities: [
    Triggered(
      event: Damage(combat: true),
      effect: GainLife(1),
    ),
  ],
)
