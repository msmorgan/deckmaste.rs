// Formerly reject/E-BRIDGE-CAP/when-condition.ron: `When` (the
// pattern-level game-state refinement, [CR#603.4]) was beyond the bridge
// matchers. engine-one-evaluator evaluates the condition as the event
// occurs, in a frame anchored on the watcher's live carrier, so the row
// lifted and the fixture flipped to the admitted side.
Normal(
  name: "Accept Bridge When",
  types: [Enchantment],
  abilities: [
    Triggered(
      event: When(StepBegins(at: Ending(End), whose: EachPlayers), YourTurn),
      effect: GainLife(1),
    ),
  ],
)
