// Formerly reject/E-BRIDGE-CAP/would-cause-agent.ron: the would-matcher's
// lifted cause carried no AGENT coordinate. engine-one-evaluator's
// would-facts keep the raw engine cause triple ([CR#603.2] over verb,
// agency, agent), so the agent filter evaluates against the live causing
// object and the fixture flipped to the admitted side.
Normal(
  name: "Accept Bridge Would Agent",
  types: [Enchantment],
  abilities: [
    Static(Replacement(Instead(
      would: ZoneChange(what: Ref(This), from: Battlefield, to: Graveyard,
                        cause: Cause(agent: Type(Instant))),
      instead: GainLife(1),
    ))),
  ],
)
