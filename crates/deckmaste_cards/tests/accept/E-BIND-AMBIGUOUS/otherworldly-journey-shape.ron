// The SIGNATURE acceptance fixture (the Otherworldly-Journey shape): slot 0
// is pushed; `Move(It, Exile)` reads it ([CR#115.3]) and pushes a `Card`
// product with expected zone Exile ([CR#400.7j]); `Delayed` drops the
// target antecedent and keeps the product ([CR#603.7c]); `That(Card)`
// resolves to the exiled card — uniquely, so the R2 gate stays silent.
// (`That(Creature)` there is the pinned load-error twin,
// reject/E-BIND-THAT/stale-target-that-creature.ron.)
Normal(
  name: "Accept Otherworldly Journey Shape",
  types: [Instant],
  abilities: [
    Spell(effect: Targeted(
      targets: [TargetOne(Creature)],
      effect: Sequence([
        Move(It, Exile),
        Delayed(
          event: StepBegins(at: Ending(End), whose: EachPlayers),
          effect: Move(That(Card), Battlefield, [
            UnderOwnersControl,
            WithCounters(P1P1Counter, 1),
          ]),
        ),
      ]),
    )),
  ],
)
