-- mtg-dev.ipkg: fast inner loop for iterating on Experimental.* modules.
--
-- Same module set as mtg.ipkg (same sourcedir, same options), minus the
-- Experimental.Proofs pin modules: deliberately-failing elaborations that
-- dominate build time and only need checking once per round.
--
-- Iterate on dev, gate on full:
--   idris2 --build mtg-dev.ipkg      -- fast inner loop (no Proofs checked)
--   ./scripts/build                  -- full gate (mtg.ipkg): every module
--                                        built, 0 errors, 0 warnings
--
-- Both ipkgs share this directory's build/ (same sourcedir "src", no
-- package-name-sensitive options), so a full build after a dev build only
-- re-elaborates the Proofs modules plus whatever else you touched.

package mtg-dev

depends = base

modules = Semantics
        , Macros
        , Cards
        , Spec
        , Experimental.KeywordShapes
        , Experimental.FactsGen
        , Experimental.Words
        , Experimental.Events
        , Experimental.Phrase
        , Experimental.Triggers
        , Experimental.Effect
        , Experimental.Card
        , Experimental
        , Experimental.Macros
        , Experimental.Cards
        , Experimental.Cards.Description
        , Experimental.Cards.Anaphora
        , Experimental.Cards.Trigger
        , Experimental.Cards.Damage
        , Experimental.Cards.Keyword
        , Experimental.Cards.Counters
        , Experimental.Cards.Mana
        , Experimental.Cards.Deontic
        , Experimental.Cards.Choice
        , Experimental.Cards.Static
        , Experimental.Cards.Cost
        , Experimental.Cards.Faces
        , Experimental.Cards.Turn
        , Experimental.Cards.Copy
        , Experimental.Cards.Piles
        , Experimental.Unspellable
        , EmitTables

sourcedir = "src"
