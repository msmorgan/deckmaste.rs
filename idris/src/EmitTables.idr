costRow : (action : String) -> EventCaps -> (cite : String) -> String
costRow action (MkEventCaps o a m p d) cite =
  "        (action: " ++ quoted action
  ++ ", object: " ++ bool o
  ++ ", actor: " ++ bool a
  ++ ", amount: " ++ bool m
  ++ ", patient: " ++ optKind p
  ++ ", defender: " ++ bool d
  ++ ", cite: " ++ quoted cite ++ "),\n"

-- Explicit row per cost-eligible player verb ([CR#118.3,601.2b]) — a verb
-- with NO row is not cost-eligible; there is no catch-all. The first three
-- ride `actionEventCaps` (the rows Core.idr defines); the rest are the
-- catch-all's victims, given their true caps via the matching event kind.
costActionRows : List String
costActionRows =
  [ costRow "Sacrifice" (actionEventCaps (the (Action Base) (Sacrifice (SameAs This)))) "[CR#701.21a]"
  , costRow "Discard" (actionEventCaps (the (Action Base) (Discard (Literal 1)))) "[CR#701.9a]"
  , costRow "Move" (actionEventCaps (the (Action Base) (Move This (ToZone Exile)))) "[CR#701.13]"
  , costRow "Tap" (eventKindCaps (Becomes Tapped)) "[CR#701.26a]"
  , costRow "Untap" (eventKindCaps (Becomes Untapped)) "[CR#701.26b]"
  , costRow "LoseLife" (eventKindCaps LoseLife) "[CR#119.3]"
  , costRow "RemoveCounters" (eventKindCaps RemoveCounters) "[CR#122.1]"
    -- Reveal has no event kind in the model; it binds nothing ([CR#701.20a]).
  , costRow "Reveal" NoCaps "[CR#701.20a]"
  ]

costActionTable : String
costActionTable =
  header "Cost-eligible player verbs ([CR#118.3,601.2b]) + the caps their payment event supplies an AdditionalCost body ([CR#601.2f])."
  ++ "(\n    rows: [\n" ++ concat costActionRows ++ "    ],\n)\n"

