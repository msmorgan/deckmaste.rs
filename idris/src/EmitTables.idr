  , bridgeRow "Lookback:ThisTurn" False False True "[CR#608.2i]"
  , bridgeRow "Lookback:ThisGame" False False True "[CR#608.2i]"
  , bridgeRow "Lookback:LastTurn" False False True "[CR#608.2i]"
