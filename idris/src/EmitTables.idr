-- --------------------------------------------------------------------------
-- entry point
-- --------------------------------------------------------------------------

outDir : String
outDir = "../crates/deckmaste_cards/tables/"

emit : (file : String) -> String -> IO ()
emit file contents = do
  Right () <- writeFile (outDir ++ file) contents
    | Left err => do
        putStrLn ("emit-tables: failed to write " ++ file ++ ": " ++ show err)
        exitFailure
  putStrLn ("wrote " ++ outDir ++ file)

export
emitTables : IO ()
emitTables = do
  emit "event-caps.ron" eventCapsTable
  emit "entailments.ron" entailmentTable
  emit "event-lanes.ron" laneTable
  emit "bridge-caps.ron" bridgeTable
  emit "cost-actions.ron" costActionTable
  emit "scopes.ron" scopesTable
  emit "kind-lattice.ron" latticeTable
  emit "bind-rules.ron" bindTable
  emit "checker-rules.ron" rulesTable

-- `--exec main` convenience: the same entry.
main : IO ()
main = emitTables
