-- kind lattice: the RefKind join ([CR#115.4] — "any target" is the top)
-- --------------------------------------------------------------------------

allKinds : List RefKind
allKinds = [Empty, AnObject, APlayer, Anything]

joinRow : (RefKind, RefKind) -> String
joinRow (a, b) =
  "        (left: " ++ kindName a
  ++ ", right: " ++ kindName b
  ++ ", join: " ++ kindName ((\/) a b) ++ "),\n"

