// "DestroyNoRegen" — destroy plus the instruction-scoped "It can't be
// regenerated." rider ([CR#701.19c]: a can't-be-regenerated effect causes
// regeneration SHIELDS not to be applied to that destruction — activating
// or casting shield-creators stays legal). The rider is the deontic
// `Cant(Regenerate(on: <it>))` row (the Idris `cant (Enact Regenerate …)`
// spelling) scoped by `Duration::ForThisEvent` — in force only while this
// instruction's destroy event executes, exactly the [CR#701.19c] window.
//
// SEAM — engine enforcement: the replacement pipeline does not yet consult
// deontic `Cant(Regenerate)` rows when a regeneration `Instead` offers to
// apply, so a shield still saves the permanent in engine play. Graduation
// (parse-only) and rendering are unaffected. Usage: DestroyNoRegen(It) in
// a `Targeted` shell.
(
    name: "DestroyNoRegen",
    // The rider's pronoun is a PRONOMINAL re-mention of the destroyed thing
    // (`${0:pro}`), number-aware: a single target renders "It", a plural/mass
    // one "They" ([CR#608.2d]). It opens a new sentence, so the filler
    // capitalizes it — the pronoun is not hardcoded here.
    template: "destroy ${0}. ${0:pro} can't be regenerated",
    kinds: [OneShotEffect],
    params: [Reference],
    body: Sequentially([
        // Destroy inlined as its `Composite` (the body IS the Battlefield →
        // Graveyard `Move`) rather than a nested `Destroy` macro invocation.
        Composite(name: Destroy, body: Move(Param(0), Graveyard)),
        Until(ForThisEvent, [Cant(Regenerate(on: Ref(Param(0))))]),
    ]),
)
