// Protection = the DEBT bundle over the stated quality
// (`Protection(ColorIs(Red))`), four rows:
//   Damaged   — damage from matching sources is prevented ([CR#702.16e]);
//   Enchanted/Equipped — can't have matching attachments
//               ([CR#702.16c..702.16d]; existing illegal ones are the
//               [CR#704.5m..704.5n] sweeps' business);
//   Blocked   — can't be blocked by matching creatures ([CR#702.16f]);
//   Targeted  — can't be targeted by matching spells, or abilities from
//               matching sources ([CR#702.16b]) — one row through the deed
//               agent's source arm (a spell is itself a source [CR#609.7a];
//               an ability's source is its generator [CR#113.7]).
(
    name: "Protection",
    template: "protection from ${0}",
    kinds: [KeywordAbility],
    params: [Predicate],
    // `CatalogAtom.spelling` preserves the matched text's own case, so a
    // frame citing lowercase "protection" would not match a capitalized
    // solo keyword line. `spelling` is a `unify::surface_only_fields`
    // exclusion, so this single frame matches regardless of case. No canon
    // card in the corpus currently exercises this frame.
    frames: ["protection from <Param(0)>"],
    body: Composite(
        name: "Protection",
        abilities: [
            Static(Prevention(PreventAll(from: Param(0), to: Ref(This)))),
            Static(Cant(Attach(what: Param(0), to: Ref(This)))),
            Static(Cant(Block(on: Ref(This), by: Param(0)))),
            Static(Cant(Target(on: Ref(This), by: (source: Param(0))))),
        ],
    ),
)
