// Echo = a triggered ability [CR#702.30a]: "Echo [cost]" means "At the
// beginning of your upkeep, if this permanent came under your control since
// the beginning of your last upkeep, sacrifice it unless you pay [cost]." The
// printed [cost] is the macro's `Cost` param, spliced straight into the
// resolution `MustPay` toll ([CR#118.12a] — the English "unless" order is
// the `Unless` macro over the same node) with the sacrifice as the unpaid
// branch; the parser emits the same cost-list shape (`Echo([Mana(...)])`).
//
// The intervening-if ([CR#603.4]) is the "came under your control since the
// beginning of your last upkeep" recheck. "Came under" includes both entering
// the battlefield under your control and changing control in place; the
// history query therefore joins `Enters` ([CR#603.6a]) with `ControlChanged`
// ([CR#603.2e]) under the upkeep-anchored `SinceYour` window.
(
    name: "Echo",
    template: "echo ${0}",
    kinds: [KeywordAbility],
    params: [Cost],
    body: Composite(
        name: "Echo",
        abilities: [Triggered(
            event: StepBegins(at: Beginning(Upkeep), whose: Your),
            condition: Happened(
                event: OneOf([
                    Enters(And([Ref(This), ControlledBy(Ref(You))])),
                    ControlChanged(of: Ref(This), to: Ref(You)),
                ]),
                within: SinceYour(Beginning(Upkeep)),
            ),
            effect: MustPay(
                cost: [Splice(Param(0))],
                or_else: Sacrifice(This),
            ),
        )],
    ),
)
