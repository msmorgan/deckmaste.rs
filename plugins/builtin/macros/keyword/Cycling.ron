// Cycling = an activated ability that functions only while the card is in a
// player's HAND [CR#702.29a]: "Cycling [cost]" means "[Cost], Discard this
// card: Draw a card." The printed [cost] is the macro's list param; the
// generic `Splice(Param(0))` list-splice inlines its components ahead of the
// fixed discard-self at read time, yielding one flat cost list.
// The discard is of THIS card (the bound `DiscardThis` cost macro — the
// single-move discard composite), not a free-choice discard. `from: Hand` is the zone-of-function seam [CR#702.29b]. Typecycling
// [CR#702.29e] (the library-search variant) is out of scope — base cycling
// only (the parser declines a multi-component cycling cost).
(
    name: "Cycling",
    template: "cycling ${0}",
    kinds: [KeywordAbility],
    params: [Cost],
    body: Composite(
        name: "Cycling",
        abilities: [Activated(
            from: Hand,
            cost: [Splice(Param(0)), DiscardThis],
            effect: Draw(1),
        )],
    ),
)
