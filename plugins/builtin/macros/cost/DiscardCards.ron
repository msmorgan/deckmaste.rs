// "Discard a card," / "Discard N cards," as a COST ([CR#701.9,601.2b]) —
// the chosen-from-hand discard paid by the ability's activator (Blood
// token's "{1}, {T}, Discard a card, Sacrifice this token: Draw a card.",
// [CR#111.10g]). Same `Composite` the effect-position `Discard` macro
// builds — a `With(Choose(..InHand(You)..), ..)` decision — wrapped in
// `Do(..)` so the cost-payment lane runs it through the ordinary
// `WorkItem::RunEffect{Act(..)}` path ([CR#601.2h] — needs at least N
// cards in hand to be payable; partial payment forbidden).
(
    name: "DiscardCards",
    template: "Discard ${0:card|cards}",
    kinds: [CostComponent],
    params: [Count],
    body: Do(Composite(
        name: Discard,
        body: With(
            binder: Choose(quantity: Exactly(Param(0)), filter: InHand(You)),
            body: Each(
                binder: Existing(They),
                effect: Composite(name: Discard, body: Move(It, Graveyard)),
            ),
        ),
    )),
)
