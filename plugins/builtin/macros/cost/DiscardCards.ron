// "Discard a card," / "Discard N cards," as a COST ([CR#701.9,601.2b]) —
// the chosen-from-hand discard paid by the ability's activator (Blood
// token's "{1}, {T}, Discard a card, Sacrifice this token: Draw a card.",
// [CR#111.10g]). Same `Composite` the effect-position `Discard` macro
// builds; needs at least N cards in hand to be payable ([CR#601.2h] —
// partial payment forbidden).
(
    name: "DiscardCards",
    template: "Discard ${0:card|cards}",
    kinds: [CostComponent],
    params: [Count],
    body: Do(Composite(
        Discard(You, Param(0)),
        Each(binder: Existing(FromHand(count: Param(0))), effect: Move(It, Graveyard)),
    )),
)
