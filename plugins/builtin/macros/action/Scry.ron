// "Scry N" [CR#701.22a]: look at the top N cards of your library, then put
// any number of them on the bottom of your library and the rest on top in any
// order. N=0 is a no-op [CR#701.22b]. The north-star shape (`Macros.idr`
// `scry`): a per-card top/bottom pick as a 1-of-2 `Modal`, distributed by a
// simultaneous `Each` over the peeked top-N; the within-pile "any order" is the
// [CR#401.4] arrange of each ordered-library pile, surfaced after the picks.
(
    name: "Scry",
    template: "scry ${0}",
    kinds: [Effect],
    params: [Count],
    body: Composite(
        name: "Scry",
        body: Each(
            binder: Existing(TopOfLibrary(count: Param(0))),
            effect: Modal(
                choose: (count: Range(Literal(1), Literal(1))),
                modes: [
                    (effect: Move(It, Library(FromTop(0)))),
                    (effect: Move(It, Library(FromBottom(0)))),
                ],
            ),
        ),
    ),
)
