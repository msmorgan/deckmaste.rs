// "Fateseal N" [CR#701.29a]: look at the top N cards of an opponent's library,
// then put any number of them on the bottom of that library and the rest on top
// in any order. Scry over an OPPONENT's library (`TopOfLibrary(of: Opponent)`,
// the `FromTop`/`FromBottom` anchors on that library); the fatesealing player
// makes the arrange choice over the opponent's library.
(
    name: "Fateseal",
    template: "fateseal ${0}",
    kinds: [OneShotEffect],
    params: [Count],
    body: Composite(
        name: "Fateseal",
        body: Each(
            binder: Existing(TopOfLibrary(count: Param(0), of: Opponent)),
            effect: Modal(
                choose: (count: Range(Literal(1), Literal(1))),
                modes: [
                    (effect: Move(It, Library(FromTop(0)))),
                    (effect: Move(It, Library(FromBottom(0)))),
                ],
            ),
        ),
    ),
)
