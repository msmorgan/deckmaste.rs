// "[subject] discards N cards at random" ([CR#701.9b]) — the
// declarative-subject at-random discard (Hymn to Tourach's "Target player
// discards two cards at random."). `DiscardAtRandom`'s subject-carrying
// twin, exactly as `Discards` is `Discard`'s: `who` (Param(0)) rides both
// the atom and the `Random` selection's `InHand` filter — no `by` chooser
// (there is no choice; the engine samples uniformly).
//
// Usage: DiscardsAtRandom(It, 2) (the announced player target).
(
    name: "DiscardsAtRandom",
    template: "${0} discards ${1:card|cards} at random",
    kinds: [OneShotEffect, KeywordAction],
    params: [Reference, Count],
    body: Composite(
        name: Discard,
        body: With(
            binder: Existing(Random(Exactly(Param(1)), InHand(Param(0)))),
            body: Each(
                binder: Existing(They),
                effect: Composite(name: Discard, body: Move(It, Graveyard)),
            ),
        ),
    ),
)
