// "loses N life" — the third-person life-loss verb phrase ([CR#119.3]).
// A parse/render template over the core `LoseLife` player action for the
// declarative-subject production ("Each opponent loses 2 life", "Target
// player loses 1 life"); expands in place to `LoseLife(n)`.
(
    name: "LosesLife",
    template: "loses ${0} life",
    kinds: [PlayerAction],
    params: [Count],
    body: LoseLife(Param(0)),
)
