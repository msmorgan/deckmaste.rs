// "Discard N cards at random" ([CR#701.9b] — the affected player does NOT
// choose): the imperative YOU-form at-random discard. Same `Composite` as
// the chosen-form `Discard` macro, but the binder is `Existing(Random(..))`
// instead of `Choose` — the at-random detail is the BINDER's, not the
// atom's; the engine samples uniformly from the seeded rng (no decision
// surfaces) then realizes the same per-card `Act(Discard)` events (madness
// still bites per card, [CR#702.35a]).
//
// Usage: DiscardAtRandom(1) -> "Discard a card at random."
(
    name: "DiscardAtRandom",
    template: "discard ${0:card|cards} at random",
    kinds: [OneShotEffect, KeywordAction],
    params: [Count],
    body: Composite(
        name: Discard,
        body: With(
            binder: Existing(Random(Exactly(Param(0)), InHand(You))),
            body: Each(
                binder: Existing(They),
                effect: Composite(name: Discard, body: Move(It, Graveyard)),
            ),
        ),
    ),
)
