// CardsInAnyGraveyard = "each card in a graveyard" — the graveyard-wide
// distribution set (no owner/controller restriction; every graveyard, not
// just yours). A Selection-kind macro: the whole `SelectAll(...)` IS the
// macro body, so a card spells it as `Each(CardsInAnyGraveyard, ...)`
// directly.
(
    name: "CardsInAnyGraveyard",
    template: "each card in a graveyard",
    kinds: [Selection],
    body: SelectAll(And([Card, InZone(Graveyard)])),
)
