// "you control a Plains" — a board census over the basic land subtype. A
// `Condition`-kind macro for an `ActivatedAbility`'s "Activate only if …"
// rider.
(
    name: "YouControlAPlains",
    template: "you control a Plains",
    kinds: [Condition],
    body: Exists(And([InZone(Battlefield), Subtype(Plains), ControlledBy(Ref(You))])),
)
