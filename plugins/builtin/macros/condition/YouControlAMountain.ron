// "you control a Mountain" — a board census over the basic land subtype. A
// `Condition`-kind macro for an `ActivatedAbility`'s "Activate only if …"
// rider.
(
    name: "YouControlAMountain",
    template: "you control a Mountain",
    kinds: [Condition],
    body: Exists(And([InZone(Battlefield), Subtype("Mountain"), ControlledBy(Ref(You))])),
)
