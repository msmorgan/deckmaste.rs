// [CR#704.5v..704.5w,310.7..310.8] split defense-zero battles by subtype:
// Sieges wait while their triggered ability is pending; non-Sieges do not.
// This generic rule implements the shared move and is exact for non-Sieges.
// SEAM: subtype-aware suppression of the move for a pending Siege trigger is
// deferred to engine-battles.
[
    SbaRule(
        scope: Type(Battle),
        when: Compare(StatOf(This, Defense), Eq, 0),
        then: Move(This, Graveyard),
    ),
]
