// [CR#111.10h,106.6]: the spend restriction is encoded as the negation of
// "spell and not artifact."
Token(
    types: [Artifact],
    subtypes: [Powerstone],
    abilities: [
        Activated(
            cost: [Tap],
            effect: AddMana(1, WithRiders(
                mana: Colorless,
                riders: [SpendOnly(Not(And([Kind(Spell), Not(Type(Artifact))])))],
            )),
        ),
    ],
)
