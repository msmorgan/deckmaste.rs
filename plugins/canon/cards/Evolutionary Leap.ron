// [CR#702.85,701.57]: `RevealUntil` binds the found card as `It` and the
// passed-over prefix as `They`. Resolution is currently a no-op because
// `Action::Reveal` / `GameEvent::Revealed` is not implemented.
Normal(
  name: "Evolutionary Leap",
  mana_cost: [
    Generic(1),
    Green,
  ],
  types: [
    Enchantment,
  ],
  abilities: [
    Activated(
      cost: [
        Mana([Green]),
        With(binder: ChooseOne(filter: Type(Creature)), body: [Do(Sacrifice(You, That(Creature)))]),
      ],
      effect: RevealUntil(
        whose: You,
        matches: Type(Creature),
        body: Sequentially([
          Move(It, Hand),
          MoveGroup(group: They, arrangement: RandomOrder, to: Library(FromBottom(0))),
        ]),
      ),
    ),
  ],
)
