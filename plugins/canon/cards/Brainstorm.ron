Normal(
  name: "Brainstorm",
  mana_cost: [
    Blue,
  ],
  types: [
    Instant,
  ],
  abilities: [
    Spell(
      effect: Sequence([
        Draw(3),
        // "put two cards from your hand on top of your library in any order"
        // ([CR#401.4]). A many-binder `Choose` binds the two cards; `MoveGroup`
        // relocates the whole group as one simultaneous batch and surfaces the
        // "any order" arrange over the resulting top-of-library pile — the same
        // ordered-landing surface scry uses, generalized to a hand→library
        // group move.
        With(
          binder: Choose(quantity: Exactly(2), filter: AllOf([InZone(Hand), Owner(Ref(You))])),
          body: MoveGroup(group: They, arrangement: AnyOrder, to: Library(FromTop(0))),
        ),
      ])
    ),
  ],
)
