// Fling — "As an additional cost to cast this spell, sacrifice a creature.
// Fling deals damage equal to the sacrificed creature's power to any
// target." The printed additional cost ([CR#601.2f,118.8]): `body` reads
// the sacrificed creature back through the event reference `EventObject`
// (the SAME anaphor a trigger uses), exactly like an `AdditionalCost`
// body's Idris mirror.
Normal(
  name: "Fling",
  mana_cost: [
    Generic(1),
    Red,
  ],
  types: [
    Instant,
  ],
  abilities: [
    Spell(
      effect: Targeted(
        targets: [As("target", AnyTarget)],
        effect: AdditionalCost(
          pay: [Do(Sacrifice(A(filter: Type(Creature))))],
          body: DealDamage(The("target"), StatOf(EventObject, Power)),
        ),
      ),
    ),
  ],
)
