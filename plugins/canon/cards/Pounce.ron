// Pounce — "Target creature you control fights target creature you don't
// control." Fight ([CR#701.14a]) is the single `Fight` primitive: each
// creature deals damage equal to its power to the other, simultaneously —
// the earlier two-`DealDamage` `Sequence` desugar lost the simultaneity and
// the printed "fights" verb (caught by the fidelity gate). Hand-written: the
// fight clause is beyond the effect parser today.
Normal(
  name: "Pounce",
  mana_cost: [
    Generic(1),
    Green,
  ],
  types: [
    Instant,
  ],
  abilities: [
    Spell(
      effect: Targeted(
        targets: [
          As("first", TargetOne(AllOf([Creature, ControlledBy(Ref(You))]))),
          As("second", TargetOne(AllOf([Creature, Not(ControlledBy(Ref(You)))]))),
        ],
        effect: Fight(The("first"), The("second")),
      ),
    ),
  ],
)
