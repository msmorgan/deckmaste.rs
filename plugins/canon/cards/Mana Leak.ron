// Hand-written canon entry (see docs/card-data.md): exercises the collapsed
// `May(Pay(cost))` MustPay shape (`if_did` absent) over the full `Cost`
// algebra — "counter target spell unless its controller pays {3}"
// ([CR#118.12a]). The migrations parser has no production for a non-`You`
// payer over this node yet, so this body is authored directly rather than
// through the `Unless` macro sugar.
Normal(
  name: "Mana Leak",
  mana_cost: [
    Generic(1),
    Blue,
  ],
  types: [
    Instant,
  ],
  abilities: [
    Spell(
      effect: Targeted(
        targets: [TargetOne(Spell)],
        effect: May(
          who: ControllerOf(Target(0)),
          effect: Pay([Mana([Generic(3)])]),
          if_not: Counter(Target(0)),
        ),
      ),
    ),
  ],
)
