// Cursed Scroll's choose-name/random-reveal sequence is deliberately authored
// in canon: it is a singularly awkward Oracle template, not a useful general
// migration-parser production.
// waiver: render deferred — the renderer has no arms for the choose-a-name /
// random hand-reveal / conditional-damage clause (ChooseValue, Random, hand
// Reveal, If); the engine encoding is complete, render skipped at graduation
// pending those arms (noncanon-wc99 follow-up).
Normal(
    name: "Cursed Scroll",
    mana_cost: [Generic(1)],
    types: [Artifact],
    abilities: [
        Activated(
            cost: [Mana([Generic(3)]), Tap],
            effect: Targeted(
                targets: [AnyTarget],
                effect: Sequentially([
                    ChooseValue(You, CardName, "CursedScrollName"),
                    Each(
                        binder: Existing(Random(
                            Exactly(1),
                            And([Kind(Card), InZone(Hand), Owner(Ref(You))]),
                        )),
                        effect: Sequentially([
                            Reveal(what: It),
                            If(
                                condition: Matches(It, Named("CursedScrollName")),
                                then: DealDamage(This, 2, Target(0)),
                            ),
                        ]),
                    ),
                ]),
            ),
        ),
    ],
)
