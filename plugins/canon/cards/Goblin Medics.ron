// Hand-written ability ("Whenever ~ becomes tapped, it deals 1 damage to
// any target."). The triggered-ability parser now covers this becomes-tapped
// event shape too (`BecomesTapped`/`ThisBecomesTapped` macros,
// misc-event-trigger wave) — this card just hasn't been re-migrated through
// it.
Normal(
  name: "Goblin Medics",
  mana_cost: [
    Generic(2),
    Red,
  ],
  types: [
    Creature,
  ],
  subtypes: [
    Goblin,
    Shaman,
  ],
  abilities: [
    Triggered(
      event: StateBecame(of: Ref(This), becomes: Tapped),
      effect: Targeted(targets: [AnyTarget], effect: DealDamage(This, 1, Target(0))),
    ),
  ],
  power: 1,
  toughness: 1,
)
