// Exponential Growth — "Until end of turn, double target creature's power X
// times." ([CR#107.1] `Count::Pow` — exponential-growth effects). The
// official ruling (2021-04-16): "If an effect instructs you to 'double' a
// creature's power, that creature gets +X/+0, where X is its power as that
// effect begins to apply" — doubling X times multiplies power by 2^X in one
// shot, spelled `Up(Minus(Times(StatOf(Target(0), Power), Pow(2, X)),
// StatOf(Target(0), Power)))` (current power times 2^X, minus current power
// = the "+X/+0"
// delta that reaches the doubled value).
Normal(
  name: "Exponential Growth",
  mana_cost: [
    Variable,
    Variable,
    Green,
    Green,
  ],
  types: [
    Sorcery,
  ],
  abilities: [
    Spell(
      effect: Targeted(
        targets: [TargetOne(Creature)],
        effect: Until(FixedUntil(EndOfTurn), [
          Modify(Target(0), Power(Up(Minus(Times(StatOf(Target(0), Power), Pow(2, X)), StatOf(Target(0), Power))))),
        ]),
      ),
    ),
  ],
)
