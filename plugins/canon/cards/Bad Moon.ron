// Hand-written ability: static prose is beyond the parsers today
// ("Black creatures get +1/+1.").
Normal(
  name: "Bad Moon",
  mana_cost: [
    Generic(1),
    Black,
  ],
  types: [
    Enchantment,
  ],
  abilities: [
    Static(Each(SelectAll(AllOf([Creature, ColorIs(Black)])), Modify(It, Several([Power(Up(1)), Toughness(Up(1))])))),
  ],
)
