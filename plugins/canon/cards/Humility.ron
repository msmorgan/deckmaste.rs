// Hand-written ability: static prose is beyond the parsers today
// ("All creatures lose all abilities and have base power and toughness 1/1.").
Normal(
  name: "Humility",
  mana_cost: [
    Generic(2),
    White,
    White,
  ],
  types: [
    Enchantment,
  ],
  abilities: [
    Static(Each(SelectAll(Creature), Modify(It, Several([LoseAllAbilities, Power(Set(1)), Toughness(Set(1))])))),
  ],
)
