// Embiggen — "Until end of turn, target non-Brushwagg creature gets +1/+1
// for each supertype, card type, and subtype it has." ([CR#105.2]
// `Countable::Singleton` — the per-object twin of `Objects`, letting
// `CountDistinct` read a characteristic off ONE object rather than a
// filtered many). The pump is `AddPowerToughness(n, n)` where `n` sums three
// `CountDistinct(<axis>, Singleton(It))` reads, one per axis the oracle
// text names (supertypes, card types, subtypes).
Normal(
  name: "Embiggen",
  mana_cost: [
    Green,
  ],
  types: [
    Instant,
  ],
  abilities: [
    Spell(
      effect: Targeted(
        targets: [TargetOne(AllOf([Creature, Not(Subtype("Brushwagg"))]))],
        effect: Until(FixedUntil(EndOfTurn), [
          Modify(It, AddPowerToughness(
            Plus(Plus(CountDistinct(Supertypes, Singleton(It)), CountDistinct(Types, Singleton(It))), CountDistinct(Subtypes, Singleton(It))),
            Plus(Plus(CountDistinct(Supertypes, Singleton(It)), CountDistinct(Types, Singleton(It))), CountDistinct(Subtypes, Singleton(It))),
          )),
        ]),
      ),
    ),
  ],
)
