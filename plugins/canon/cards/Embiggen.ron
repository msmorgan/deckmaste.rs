// Embiggen — "Until end of turn, target non-Brushwagg creature gets +1/+1
// for each supertype, card type, and subtype it has." ([CR#105.2]
// `Countable::Singleton` — the per-object twin of `Objects`, letting
// `CountDistinct` read a characteristic off ONE object rather than a
// filtered many). The pump is `PowerAndToughnessUp(n, n)` where `n` sums three
// `CountDistinct(<axis>, Singleton(Target(0)))` reads, one per axis the oracle
// text names (supertypes, card types, subtypes).
Normal(
  name: "Embiggen",
  mana_cost: [
    Green,
  ],
  types: [
    Instant,
  ],
  abilities: [
    Spell(
      effect: Targeted(
        targets: [TargetOne(And([Creature, Not(Subtype(Brushwagg))]))],
        effect: Until(FixedUntil(EndOfTurn), [
          Modify(Target(0), PowerAndToughnessUp(
            Plus(Plus(CountDistinct(Supertypes, Singleton(Target(0))), CountDistinct(Types, Singleton(Target(0)))), CountDistinct(Subtypes, Singleton(Target(0)))),
            Plus(Plus(CountDistinct(Supertypes, Singleton(Target(0))), CountDistinct(Types, Singleton(Target(0)))), CountDistinct(Subtypes, Singleton(Target(0)))),
          )),
        ]),
      ),
    ),
  ],
)
