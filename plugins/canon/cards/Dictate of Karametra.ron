// [CR#106.12,106.12a]: `TapForMana` supplies the event whose produced mana
// type is read by `ProducedByEvent`.
Normal(
    name: "Dictate of Karametra",
    mana_cost: [Generic(3), Green, Green],
    types: [Enchantment],
    abilities: [
        Keyword(Flash),
        Triggered(
            event: TapForMana(),
            effect: AddMana(EventActor, 1, ProducedByEvent),
        ),
    ],
)
