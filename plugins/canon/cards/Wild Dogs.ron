// waiver: render deferred — the renderer has no arms for the "player with the
// most life gains control" upkeep clause (Compare/CountOf over players,
// GainControl); the engine encoding is complete, render skipped at graduation
// pending those arms (noncanon-wc99 follow-up).
Normal(
    name: "Wild Dogs",
    mana_cost: [Green],
    types: [Creature],
    subtypes: [Dog],
    abilities: [
        Triggered(
            event: StepBegins(at: Beginning(Upkeep), whose: Your),
            condition: Compare(
                CountOf(Players(Where(Compare(
                    PlayerStatOf(It, Life),
                    Eq,
                    Aggregate(MaxOf, (
                        of: Players(Player),
                        by: PlayerStatOf(It, Life),
                    )),
                )))),
                Eq,
                1,
            ),
            effect: GainControl(
                This,
                Single(SelectAll(Where(Compare(
                    PlayerStatOf(It, Life),
                    Eq,
                    Aggregate(MaxOf, (
                        of: Players(Player),
                        by: PlayerStatOf(It, Life),
                    )),
                )))),
            ),
        ),
        Keyword(Cycling([Mana([Generic(2)])])),
    ],
    power: 2,
    toughness: 1,
)
