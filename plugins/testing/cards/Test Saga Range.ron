// [CR#714.2c]: one `Chapter` atom carries multiple literal thresholds so the
// shared effect renders with each chapter marker.
Normal(
    name: "Test Saga Range",
    mana_cost: [Generic(2), White],
    types: [Enchantment],
    subtypes: [Saga],
    abilities: [
        Chapter(n: [1], effect: ChangeLife(You, Up(1))),
        Chapter(n: [2, 3], effect: ChangeLife(You, Up(2))),
    ],
)
