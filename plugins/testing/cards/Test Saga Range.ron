// A Saga ([CR#714]) whose second chapter is a RANGE ([CR#714.2c]:
// "{rN1}, {rN2}—[Effect]" fires the same effect at each listed chapter) —
// exercises the multi-threshold `Chapter` atom and its "II, III —" render.
// Made-up card (no oracle entry), like `Test Saga`.
Normal(
    name: "Test Saga Range",
    mana_cost: [Generic(2), White],
    types: [Enchantment],
    subtypes: [Saga],
    abilities: [
        Chapter(n: [1], effect: GainLife(1)),
        Chapter(n: [2, 3], effect: GainLife(2)),
        // [CR#714.4]: sacrifice once the lore total reaches the final chapter
        // number (3 here, [CR#714.2d]).
        Static(Sba(
            when: Compare(CounterCount(This, LoreCounter), AtLeast, 3),
            then: Sacrifice(This),
        )),
    ],
)
