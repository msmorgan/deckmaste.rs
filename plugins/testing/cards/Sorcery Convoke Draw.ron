// [CR#202.3,702.51a]: direct `PayPips` rows isolate Convoke's distinct generic
// and green creature-payment paths without changing mana value.
Normal(
    name: "Sorcery Convoke Draw",
    mana_cost: [Generic(1), Green],
    types: [Sorcery],
    abilities: [
        Spell(effect: Draw(1)),
        Static(PayPips(Generic, TapToPay(And([Creature, ControlledBy(Ref(You))])))),
        Static(PayPips(Colored(Green), TapToPay(And([Creature, ColorIs(Green), ControlledBy(Ref(You))])))),
    ],
)
