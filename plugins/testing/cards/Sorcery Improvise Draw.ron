// [CR#202.3,702.126a]: a direct `PayPips` row isolates Improvise's
// artifact-tap payment path without changing mana value.
Normal(
    name: "Sorcery Improvise Draw",
    mana_cost: [Generic(2)],
    types: [Sorcery],
    abilities: [
        Spell(effect: Draw(1)),
        Static(PayPips(Generic, TapToPay(And([Type(Artifact), ControlledBy(Ref(You))])))),
    ],
)
