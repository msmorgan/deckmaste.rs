// [CR#202.3,702.66a]: a direct `PayPips` row isolates Delve's graveyard-exile
// payment path without changing mana value.
Normal(
    name: "Sorcery Delve Draw",
    mana_cost: [Generic(2)],
    types: [Sorcery],
    abilities: [
        Spell(effect: Draw(1)),
        Static(PayPips(Generic, ExileToPay(And([InZone(Graveyard), Owner(Ref(You))])))),
    ],
)
