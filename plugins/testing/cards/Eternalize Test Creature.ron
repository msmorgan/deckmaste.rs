Normal(
    name: "Eternalize Test Creature",
    mana_cost: [Generic(3), Black],
    types: [Creature],
    power: 2,
    toughness: 2,
    abilities: [
        Keyword(Eternalize([Mana([Generic(4), Black])])),
    ],
)
