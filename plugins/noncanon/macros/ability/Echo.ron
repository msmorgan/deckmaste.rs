// Unsupported-keyword proxy: stays a Keyword so name paths (HasAbility/
// LoseAbility) and keyword filters see it; carries no behavior. The echo
// cost param is preserved in card invocations for the real macro later.
(
    name: "Echo",
    template: "Echo",
    kinds: [Ability],
    params: [Any],
    body: Keyword(Composite(name: "Echo", abilities: [])),
)
