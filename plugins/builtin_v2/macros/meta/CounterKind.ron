(
    name: "CounterKind",
    kinds: [Macro],
    params: {
        "name": String,
        "params": Elidable(Any),
        "spelling": String,
        "grammar": Elidable(Any),
        "body": Default(Any, ()),
    },
    body: (
        name: Param(name),
        kinds: [CounterKind],
        params: Param(params),
        metadata: (
