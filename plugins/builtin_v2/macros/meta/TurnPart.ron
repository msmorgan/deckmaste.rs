(
    name: "TurnPart",
    kinds: [Macro],
    params: {
        "name": String,
        "params": Elidable(Any),
        "spelling": String,
        "grammar": Elidable(Any),
        "body": Default(Any, ()),
    },
    body: (
        name: Param(name),
        kinds: [TurnPart],
        params: Param(params),
        metadata: (
            spelling: Param(spelling),
            grammar: Param(grammar),
            noun_class: (
                locative_temporal_license: TemporalLicensed,
                relationality: Relational,
            ),
        ),
        body: Param(body),
    ),
)
