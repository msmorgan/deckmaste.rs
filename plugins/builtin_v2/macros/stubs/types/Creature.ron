// Creature ([CR#300.1]) — combat capability ([CR#508.1a,509.1a]) and
// summoning sickness ([CR#302.6], gated on lacking haste [CR#702.10b]) are
// qualities of a creature, not abilities of it ([CR#113.12]), so they are
// conferred ability-free: a creature that loses all abilities can still
// attack.
Type(
    name: "Creature",
    spelling: "creature",
    grammar: Noun(singular: "creature"),
    params: [],
    body: TypeDef(
        name: "Creature",
        permanent_type: true,
        confers: [
            Static(May(Attack(by: Ref(This)))),
            Static(May(Block(by: Ref(This)))),
            Static(Conditionally(
                And([
                    Matches(This, SummoningSick),
                    Not(Matches(This, Has(Haste))),
                ]),
                Cant(Attack(by: Ref(This))),
            )),
            Static(Conditionally(
                And([
                    Matches(This, SummoningSick),
                    Not(Matches(This, Has(Haste))),
                ]),
                Cant(Activate(what: Ref(This), cost: IncludesTapSymbol)),
            )),
        ],
    ),
)
