// A menace counter ([CR#122.1b]): its bearer gains menace at layer 6
// ([CR#613.1f]) — the FlyingCounter pattern with a different keyword.
CounterKind(
    name: "MenaceCounter",
    params: [],
    spelling: "menace",
    grammar: FixedTerm(surface: "menace"),
    body: Counter(
        name: "MenaceCounter",
        confers: [
            Continuous(This, GainAbility(Keyword(Menace))),
        ],
    ),
)
