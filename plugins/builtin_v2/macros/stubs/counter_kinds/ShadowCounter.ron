// A shadow counter ([CR#122.1b]): its bearer gains shadow at layer 6
// ([CR#613.1f]) — the FlyingCounter pattern with a different keyword.
CounterKind(
    name: "ShadowCounter",
    params: [],
    spelling: "shadow",
    grammar: FixedTerm(surface: "shadow"),
    body: Counter(
        name: "ShadowCounter",
        confers: [
            Continuous(This, GainAbility(Keyword(Shadow))),
        ],
    ),
)
