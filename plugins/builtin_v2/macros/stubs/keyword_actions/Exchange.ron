KeywordAction(
    name: "Exchange",
    spelling: "exchange",
    grammar: Verb(
        bare: "exchange",
        frame_set: Custom(
            frames: [
                [ObjectNounPhrase],
                [ObjectNounPhrase, Literal("with"), ObjectNounPhrase],
                [ObjectNounPhrase, Lex("Preposition", "For"), ObjectNounPhrase],
            ],
        ),
    ),
)
