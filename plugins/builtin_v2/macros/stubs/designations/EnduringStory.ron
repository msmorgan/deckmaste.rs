Designation(
    name: "EnduringStory",
    params: [],
    spelling: "an enduring story",
    grammar: FixedTerm(surface: "an enduring story"),
    body: DesignationDecl(name: "EnduringStory", conferrers: [KeywordAbility("Storied")], definition: Stored(scope: Player, shape: Flag, uniqueness: PerPlayer, persistence: Permanently)),
)
